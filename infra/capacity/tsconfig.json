    "../../scripts/capacity/**/*.ts",
    "../../scripts/converact-capacity-controller.ts",
    "../../scripts/converact-capacity-dispatcher.ts",
    "../../scripts/converact-capacity-finalizer.ts",
    "../../scripts/converact-capacity-scaling-finalizer.ts",
    "../../scripts/converact-capacity-platform-finalizer.ts",
    "../../scripts/converact-capacity-worker.ts",
    "../../scripts/converact-capacity-tinode-worker.ts",
    "../../scripts/converact-capacity-tinode-composite.ts",
    "../../scripts/converact-capacity-tinode-provision.ts",
    "../../scripts/converact-capacity-tinode-staircase.ts",
    "../../scripts/converact-capacity-sip-kamailio-staircase.ts",
    "../../scripts/converact-cell-admission.ts",
    "../../scripts/converact-cell-capacity-projector.ts",
    "../../scripts/converact-component-node-admission.ts",
    "../../scripts/converact-rustdesk-owner-binding.ts",
    "../../src/converact-component-node-admission.ts",
    "../../src/converact-placement-snapshot-projector.ts"
  ]
}
