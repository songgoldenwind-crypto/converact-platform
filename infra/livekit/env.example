# Copy to infra/livekit/.env and replace every placeholder before rendering.
NODE_ENV=production
OPC_LIVEKIT_DEPLOYMENT_MODE=standalone-vm
OPC_LIVEKIT_EDGE_CONFIG_DIR=../../.runtime/livekit-edge

LIVEKIT_SIGNAL_DOMAIN=livekit.example.com
LIVEKIT_TURN_DOMAIN=turn.example.com
LIVEKIT_ACME_EMAIL=ops@example.com
IVEKIT_API_DOMAIN=
TINODE_PUBLIC_DOMAIN=
IVEKIT_API_HTTP_PORT=8300
TINODE_HTTP_PORT=6060
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://livekit.example.com

LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.3@sha256:483b8b7b5b0654f91f1e8bdc7b46fcd37fd9911612ecf627f97e3185a89825bd
LIVEKIT_SERVER_IMAGE_TAG=v1.13.3
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.13.0@sha256:980ff439431df2c773573721ab6da19e15bdc1f049ab7cb80e87470bf174c12f
LIVEKIT_EGRESS_IMAGE_TAG=v1.13.0
LIVEKIT_CADDYL4_IMAGE=livekit/caddyl4:v2.11.3@sha256:9dd090159a6042a907dbff0ce9dda27a21d2a559dc7b03b60a8e6b1b60b8348e
LIVEKIT_CADDYL4_IMAGE_TAG=v2.11.3
LIVEKIT_REDIS_IMAGE=redis:7.4.9@sha256:a8f08480e1f88f2647fed492d1178c06abb0d0c1fbf02c682a61e2f483fb3954
LIVEKIT_REDIS_IMAGE_TAG=7.4.9
LIVEKIT_MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
LIVEKIT_MINIO_IMAGE_DIGEST=sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
LIVEKIT_MINIO_MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z
LIVEKIT_MINIO_MC_IMAGE_DIGEST=sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

OPC_MEDIA_CONFIG_LIVEKIT_URL=ws://127.0.0.1:7880
OPC_MEDIA_CONFIG_REDIS_ADDRESS=127.0.0.1:6379
OPC_MEDIA_CONFIG_WEBHOOK_URL=https://opc.example.com/api/media/webhooks/livekit
OPC_MEDIA_CONFIG_RTC_TCP_PORT=7881
OPC_LIVEKIT_EDGE_RTC_PORT_RANGE_START=50000
OPC_LIVEKIT_EDGE_RTC_PORT_RANGE_END=60000
OPC_LIVEKIT_EDGE_TURN_TLS_PORT=5349
OPC_LIVEKIT_EDGE_TURN_UDP_PORT=3478
OPC_MEDIA_CONFIG_EGRESS_HEALTH_PORT=8091
OPC_MEDIA_EGRESS_ENABLED=1
OPC_LIVEKIT_TIME_SYNC_STATUS=
OPC_LIVEKIT_TIME_SYNC_OFFSET_MS=
OPC_LIVEKIT_TIME_SYNC_MAX_SKEW_MS=5000

# Optional server-side evidence output. The full acceptance bundle also needs OPC app/smoke values.
OPC_LIVEKIT_SERVER_EVIDENCE_FILE=
OPC_LIVEKIT_SERVER_EVIDENCE_SIGNAL_TLS_PORT=443
OPC_LIVEKIT_SERVER_EVIDENCE_TURN_TLS_PORT=443
OPC_LIVEKIT_SERVER_EVIDENCE_RTC_TCP_PORT=7881
OPC_LIVEKIT_SERVER_EVIDENCE_TURN_UDP_PORT=3478
OPC_LIVEKIT_SERVER_EVIDENCE_RTC_UDP_PORTS=50000,55000,60000
OPC_LIVEKIT_SERVER_EVIDENCE_TIMEOUT_MS=1500
OPC_LIVEKIT_SERVER_EVIDENCE_MIN_CERT_VALIDITY_DAYS=7
OPC_LIVEKIT_ACCEPTANCE_RUN_ID=
OPC_LIVEKIT_ACCEPTANCE_STARTED_AT=
OPC_LIVEKIT_ACCEPTANCE_ENVIRONMENT_ID=
OPC_LIVEKIT_ACCEPTANCE_DEPLOYED_COMMIT=
OPC_LIVEKIT_ACCEPTANCE_DEPLOYMENT_FINGERPRINT=
OPC_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FILE=
OPC_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FINGERPRINT=

# External S3-compatible object storage reachable from the Linux media host.
MINIO_ENDPOINT=https://storage.example.com
MINIO_BUCKET=recordings
MINIO_ROOT_ACCESS_KEY=replace_with_private_minio_root_access_key
MINIO_ROOT_SECRET_KEY=replace_with_private_minio_root_secret_key
MINIO_ACCESS_KEY=replace_with_object_storage_access_key
MINIO_SECRET_KEY=replace_with_object_storage_secret_key
