# Optional server-side evidence output. The full acceptance bundle also needs Converact Platform app/smoke values.
CONVERACT_LIVEKIT_SERVER_EVIDENCE_FILE=
CONVERACT_LIVEKIT_SERVER_EVIDENCE_SIGNAL_TLS_PORT=443
CONVERACT_LIVEKIT_SERVER_EVIDENCE_TURN_TLS_PORT=443
CONVERACT_LIVEKIT_SERVER_EVIDENCE_RTC_TCP_PORT=7881
CONVERACT_LIVEKIT_SERVER_EVIDENCE_TURN_UDP_PORT=3478
CONVERACT_LIVEKIT_SERVER_EVIDENCE_RTC_UDP_PORTS=50000,55000,60000
