CONVERACT_LIVEKIT_ACCEPTANCE_DEPLOYMENT_FINGERPRINT=
CONVERACT_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FILE=
CONVERACT_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FINGERPRINT=

# External S3-compatible object storage reachable from the Linux media host.
MINIO_ENDPOINT=https://storage.example.com
MINIO_BUCKET=recordings
MINIO_ROOT_ACCESS_KEY=replace_with_private_minio_root_access_key
MINIO_ROOT_SECRET_KEY=replace_with_private_minio_root_secret_key
MINIO_ACCESS_KEY=replace_with_object_storage_access_key
MINIO_SECRET_KEY=replace_with_object_storage_secret_key
