+#[derive(Debug, thiserror::Error)]
+pub enum MediaControlClientError {
+    #[error("{0}")]
+    Configuration(&'static str),
+    #[error("{0}")]
+    InvalidCommand(&'static str),
+    #[error("{code}")]
+    RejectedBeforeTransport { code: &'static str },
+    #[error("{error_code}")]
+    Rejected {
+        status: u16,
+        error_code: String,
+        retryable: bool,
+    },
+    #[error("{code}")]
+    UnknownAfterTransport { code: &'static str },
+}
