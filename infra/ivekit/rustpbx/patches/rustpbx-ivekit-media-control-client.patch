+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct MediaSessionSnapshot {
+    pub media_reservation_id: String,
+    pub call_id: String,
+    pub owner_epoch: String,
+    pub last_sequence: u32,
+    pub state: String,
+    pub transport_session_id: String,
+    pub effective_sdp: String,
+    pub expires_at: String,
+    pub updated_at: String,
+}
+
+impl MediaSessionSnapshot {
+    fn validate(&self) -> Result<(), MediaControlClientError> {
+        valid_identifier(&self.media_reservation_id, "media_reservation_id")?;
+        valid_identifier(&self.call_id, "call_id")?;
+        self.owner_epoch.parse::<u64>().map_err(|_| {
+            MediaControlClientError::UnknownAfterTransport {
+                code: "media_control_response_invalid",
+            }
+        })?;
+        if self.last_sequence == 0
+            || !matches!(
+                self.state.as_str(),
+                "prepared" | "committed" | "cancelled" | "closed" | "expired"
+            )
+        {
+            return Err(MediaControlClientError::UnknownAfterTransport {
+                code: "media_control_response_invalid",
+            });
+        }
+        valid_identifier(&self.transport_session_id, "transport_session_id")
+    }
+}
