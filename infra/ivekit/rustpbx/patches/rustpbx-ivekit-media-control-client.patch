+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "result_class", rename_all = "snake_case")]
+pub enum MediaControlResult {
+    Committed {
+        protocol_version: String,
+        command_id: String,
+        session: MediaSessionSnapshot,
+    },
+    Replayed {
+        protocol_version: String,
+        command_id: String,
+        session: MediaSessionSnapshot,
+    },
+    RejectedCapacity {
+        protocol_version: String,
+        command_id: String,
+        error_code: String,
+        retryable: bool,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        session: Option<MediaSessionSnapshot>,
+    },
+    RejectedEpoch {
+        protocol_version: String,
+        command_id: String,
+        error_code: String,
+        retryable: bool,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        session: Option<MediaSessionSnapshot>,
+    },
+    TerminalError {
+        protocol_version: String,
+        command_id: String,
+        error_code: String,
+        retryable: bool,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        session: Option<MediaSessionSnapshot>,
+    },
+    Unknown {
+        protocol_version: String,
+        command_id: String,
+        error_code: String,
+        retryable: bool,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        session: Option<MediaSessionSnapshot>,
+    },
+}
+
+impl MediaControlResult {
+    pub fn command_id(&self) -> &str {
+        match self {
+            Self::Committed { command_id, .. }
+            | Self::Replayed { command_id, .. }
+            | Self::RejectedCapacity { command_id, .. }
+            | Self::RejectedEpoch { command_id, .. }
+            | Self::TerminalError { command_id, .. }
+            | Self::Unknown { command_id, .. } => command_id,
+        }
+    }
+
+    fn validate(&self) -> Result<(), MediaControlClientError> {
+        let (protocol, command_id) = match self {
+            Self::Committed {
+                protocol_version,
+                command_id,
+                session,
+            }
+            | Self::Replayed {
+                protocol_version,
+                command_id,
+                session,
+            } => {
+                session.validate()?;
+                (protocol_version, command_id)
+            }
+            Self::RejectedCapacity {
+                protocol_version,
+                command_id,
+                ..
+            }
+            | Self::RejectedEpoch {
+                protocol_version,
+                command_id,
+                ..
+            }
+            | Self::TerminalError {
+                protocol_version,
+                command_id,
+                ..
+            }
+            | Self::Unknown {
+                protocol_version,
+                command_id,
+                retryable: true,
+                ..
+            } => (protocol_version, command_id),
+            Self::Unknown {
+                retryable: false, ..
+            } => {
+                return Err(MediaControlClientError::UnknownAfterTransport {
+                    code: "media_control_response_invalid",
+                });
+            }
+        };
+        if protocol != MEDIA_CONTROL_PROTOCOL_VERSION {
+            return Err(MediaControlClientError::UnknownAfterTransport {
+                code: "media_control_response_invalid",
+            });
+        }
+        valid_identifier(command_id, "command_id")
+    }
+}
