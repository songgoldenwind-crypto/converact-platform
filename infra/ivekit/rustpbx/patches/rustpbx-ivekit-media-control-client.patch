+}
+
+impl MediaControlReconcileInput {
+    fn validate(&self) -> Result<(), MediaControlClientError> {
+        if self.protocol_version != MEDIA_CONTROL_PROTOCOL_VERSION || self.action != "reconcile" {
+            return Err(MediaControlClientError::InvalidCommand(
+                "media_control_protocol_unsupported",
+            ));
+        }
+        self.command.validate()
+    }
+}
