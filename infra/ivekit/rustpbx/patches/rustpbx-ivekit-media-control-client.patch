+}
+
+pub fn payload_hash(payload: &Map<String, Value>) -> Result<String, MediaControlClientError> {
+    let canonical = canonical_json(&Value::Object(payload.clone()))?;
+    Ok(hex_sha256(canonical.as_bytes()))
+}
+
+pub fn command_id_for(command: &MediaControlCommand) -> Result<String, MediaControlClientError> {
+    let facts = serde_json::json!({
+        "action": command.action,
+        "call_id": command.call_id,
+        "command_sequence": command.command_sequence,
+        "leg_id": command.leg_id,
+        "owner_epoch": command.owner_epoch,
+        "payload_hash": command.payload_hash,
+        "tenant_id": command.tenant_id,
+    });
+    let canonical = canonical_json(&facts)?;
+    Ok(format!("cmd-{}", hex_sha256(canonical.as_bytes())))
+}
+
+pub fn canonical_json(value: &Value) -> Result<String, MediaControlClientError> {
+    fn sorted(value: &Value) -> Value {
+        match value {
+            Value::Array(values) => Value::Array(values.iter().map(sorted).collect()),
+            Value::Object(values) => {
+                let mut keys = values.keys().collect::<Vec<_>>();
+                keys.sort_unstable();
+                let mut result = Map::new();
+                for key in keys {
+                    result.insert(key.clone(), sorted(&values[key]));
+                }
+                Value::Object(result)
+            }
+            scalar => scalar.clone(),
+        }
+    }
+    serde_json::to_string(&sorted(value))
+        .map_err(|_| MediaControlClientError::InvalidCommand("canonical_json_invalid"))
+}
+
+fn unknown_after_transport_failure(command_id: String, code: &'static str) -> MediaControlResult {
+    MediaControlResult::Unknown {
+        protocol_version: MEDIA_CONTROL_PROTOCOL_VERSION.to_string(),
+        command_id,
+        error_code: code.to_string(),
+        retryable: true,
+        session: None,
+    }
+}
+
+fn rejected_before_transport() -> MediaControlClientError {
+    MediaControlClientError::RejectedBeforeTransport {
+        code: "media_control_inflight_exhausted",
+    }
+}
+
+fn project_rejection(status: StatusCode, body: &[u8]) -> MediaControlClientError {
+    match serde_json::from_slice::<ErrorEnvelope>(body) {
+        Ok(envelope) if valid_error_code(&envelope.error.code) => {
+            MediaControlClientError::Rejected {
+                status: status.as_u16(),
+                error_code: envelope.error.code,
+                retryable: envelope.error.retryable,
+            }
+        }
+        _ => MediaControlClientError::UnknownAfterTransport {
+            code: "media_control_response_invalid",
+        },
+    }
+}
+
+fn projected_error_code(body: &[u8]) -> Option<&'static str> {
+    serde_json::from_slice::<ErrorEnvelope>(body)
+        .ok()
+        .and_then(|envelope| match envelope.error.code.as_str() {
+            "media_control_unavailable" => Some("media_control_unavailable"),
+            "internal_error" => Some("media_control_internal_error"),
+            _ => None,
+        })
+}
+
+fn append_bounded(
+    destination: &mut Vec<u8>,
+    chunk: &[u8],
+    maximum: usize,
+) -> Result<(), &'static str> {
+    if destination.len().saturating_add(chunk.len()) > maximum {
+        return Err("response_too_large");
+    }
+    destination.extend_from_slice(chunk);
+    Ok(())
+}
+
+fn read_bounded_file(
+    path: &Path,
+    maximum: usize,
+    secret: bool,
+    error_code: &'static str,
+) -> Result<Vec<u8>, MediaControlClientError> {
+    reject_symlink(path, error_code)?;
+    let metadata =
+        fs::metadata(path).map_err(|_| MediaControlClientError::Configuration(error_code))?;
+    if !metadata.is_file() || metadata.len() > maximum as u64 {
+        return Err(MediaControlClientError::Configuration(error_code));
+    }
+    #[cfg(unix)]
+    if secret {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o077 != 0 {
+            return Err(MediaControlClientError::Configuration(error_code));
+        }
+    }
+    fs::read(path).map_err(|_| MediaControlClientError::Configuration(error_code))
+}
+
+fn reject_symlink(path: &Path, error_code: &'static str) -> Result<(), MediaControlClientError> {
+    let metadata = fs::symlink_metadata(path)
+        .map_err(|_| MediaControlClientError::Configuration(error_code))?;
+    if metadata.file_type().is_symlink() {
+        return Err(MediaControlClientError::Configuration(error_code));
+    }
+    Ok(())
+}
+
+fn valid_identifier(value: &str, error_code: &'static str) -> Result<(), MediaControlClientError> {
+    if value.is_empty()
+        || value.len() > 256
+        || !value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'@' | b'/' | b'-')
+        })
+    {
+        return Err(MediaControlClientError::InvalidCommand(error_code));
+    }
+    Ok(())
+}
+
+fn valid_error_code(value: &str) -> bool {
+    valid_identifier(value, "error_code").is_ok()
+}
+
+fn with_trailing_slash(mut url: Url) -> Url {
+    if !url.path().ends_with('/') {
+        let path = format!("{}/", url.path());
+        url.set_path(&path);
+    }
+    url
+}
+
+fn hex_sha256(value: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let digest = Sha256::digest(value);
+    let mut encoded = String::with_capacity(digest.len() * 2);
+    for byte in digest {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
