+use futures::StreamExt;
+use reqwest::{Certificate, Client, Identity, Method, StatusCode, Url};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+use sha2::{Digest, Sha256};
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::time::Duration;
+use tokio::sync::{OwnedSemaphorePermit, Semaphore};
+
+pub const MEDIA_CONTROL_PROTOCOL_VERSION: &str = "ivekit.media-control.v1";
+const MAX_REQUEST_BYTES: usize = 128 * 1024;
+const MAX_SECRET_BYTES: usize = 64 * 1024;
+const MAX_CA_BYTES: usize = 1024 * 1024;
+
+#[derive(Clone)]
+pub struct MediaControlClientConfig {
+    pub endpoint: Url,
+    pub service_token_file: PathBuf,
+    pub tls_identity_file: Option<PathBuf>,
+    pub tls_ca_file: Option<PathBuf>,
+    pub production: bool,
+    pub max_inflight: usize,
+    pub request_timeout: Duration,
+    pub max_response_bytes: usize,
+}
+
+impl MediaControlClientConfig {
+    pub fn validate(&self) -> Result<(), MediaControlClientError> {
+        if !matches!(self.endpoint.scheme(), "http" | "https")
+            || !self.endpoint.username().is_empty()
+            || self.endpoint.password().is_some()
+            || self.endpoint.query().is_some()
+            || self.endpoint.fragment().is_some()
+        {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_endpoint_invalid",
+            ));
+        }
+        if self.production && self.endpoint.scheme() != "https" {
+            return Err(MediaControlClientError::Configuration(
+                "production_requires_https",
+            ));
+        }
+        if self.production && (self.tls_identity_file.is_none() || self.tls_ca_file.is_none()) {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_production_mtls_required",
+            ));
+        }
+        if self.tls_identity_file.is_some() && self.endpoint.scheme() != "https" {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_tls_requires_https",
+            ));
+        }
+        if !(1..=1_000_000).contains(&self.max_inflight) {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_max_inflight_invalid",
+            ));
+        }
+        if !(50..=30_000).contains(&self.request_timeout.as_millis()) {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_request_timeout_invalid",
+            ));
+        }
+        if !(1_024..=1_048_576).contains(&self.max_response_bytes) {
+            return Err(MediaControlClientError::Configuration(
+                "media_control_max_response_invalid",
+            ));
+        }
+        Ok(())
+    }
+}
+
+pub struct MediaControlClient {
+    client: Client,
+    endpoint: Url,
+    service_token: String,
+    inflight: Arc<Semaphore>,
+    request_timeout: Duration,
+    max_response_bytes: usize,
+}
+
+impl MediaControlClient {
+    pub fn new(config: MediaControlClientConfig) -> Result<Self, MediaControlClientError> {
+        config.validate()?;
+        let token_bytes = read_bounded_file(
+            &config.service_token_file,
+            MAX_SECRET_BYTES,
+            true,
+            "service_token_file",
+        )?;
+        let service_token = String::from_utf8(token_bytes)
+            .map_err(|_| MediaControlClientError::Configuration("service_token_file_invalid"))?;
+        let service_token = service_token.trim_end_matches(['\r', '\n']).to_string();
+        if service_token.len() < 24
+            || service_token.len() > 512
+            || service_token.contains(['\0', '\r', '\n'])
+        {
+            return Err(MediaControlClientError::Configuration(
+                "service_token_file_invalid",
+            ));
+        }
+
+        let mut builder = Client::builder()
+            .no_gzip()
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(config.request_timeout)
+            .tcp_keepalive(Duration::from_secs(60))
+            .pool_idle_timeout(Duration::from_secs(90))
+            .pool_max_idle_per_host(config.max_inflight.min(256));
+        if let Some(path) = &config.tls_identity_file {
+            let pem = read_bounded_file(path, MAX_SECRET_BYTES, true, "tls_identity_file")?;
+            let identity = Identity::from_pem(&pem)
+                .map_err(|_| MediaControlClientError::Configuration("tls_identity_file_invalid"))?;
+            builder = builder.identity(identity);
+        }
+        if let Some(path) = &config.tls_ca_file {
+            let pem = read_bounded_file(path, MAX_CA_BYTES, false, "tls_ca_file")?;
+            let certificate = Certificate::from_pem(&pem)
+                .map_err(|_| MediaControlClientError::Configuration("tls_ca_file_invalid"))?;
+            builder = builder.add_root_certificate(certificate);
+        }
+        let client = builder
+            .build()
+            .map_err(|_| MediaControlClientError::Configuration("media_control_client_invalid"))?;
+        Ok(Self {
+            client,
+            endpoint: with_trailing_slash(config.endpoint),
+            service_token,
+            inflight: Arc::new(Semaphore::new(config.max_inflight)),
+            request_timeout: config.request_timeout,
+            max_response_bytes: config.max_response_bytes,
+        })
+    }
+
+    pub async fn execute(
+        &self,
+        command: &MediaControlCommand,
+    ) -> Result<MediaControlResult, MediaControlClientError> {
+        command.validate()?;
+        let command_id = command.command_id.clone();
+        let body = serde_json::to_vec(command)
+            .map_err(|_| MediaControlClientError::InvalidCommand("command_json_invalid"))?;
+        if body.len() > MAX_REQUEST_BYTES {
+            return Err(MediaControlClientError::InvalidCommand(
+                "command_json_too_large",
+            ));
+        }
+        let _permit = self.acquire_before_transport()?;
+        let url = self.endpoint.join("v1/commands").map_err(|_| {
+            MediaControlClientError::Configuration("media_control_endpoint_invalid")
+        })?;
+        self.command_request(url, body, command_id).await
+    }
+
+    pub async fn reconcile(
+        &self,
+        input: &MediaControlReconcileInput,
+    ) -> Result<MediaControlResult, MediaControlClientError> {
+        input.validate()?;
+        let command_id = input.command.command_id.clone();
+        let body = serde_json::to_vec(input)
+            .map_err(|_| MediaControlClientError::InvalidCommand("reconcile_json_invalid"))?;
+        if body.len() > MAX_REQUEST_BYTES {
+            return Err(MediaControlClientError::InvalidCommand(
+                "reconcile_json_too_large",
+            ));
+        }
+        let _permit = self.acquire_before_transport()?;
+        let url = self.endpoint.join("v1/reconcile").map_err(|_| {
+            MediaControlClientError::Configuration("media_control_endpoint_invalid")
+        })?;
+        self.command_request(url, body, command_id).await
+    }
+
+    pub async fn session(
+        &self,
+        media_reservation_id: &str,
+    ) -> Result<MediaSessionSnapshot, MediaControlClientError> {
+        valid_identifier(media_reservation_id, "media_reservation_id")?;
+        let _permit = self.acquire_before_transport()?;
+        let encoded = urlencoding::encode(media_reservation_id);
+        let url = self
+            .endpoint
+            .join(&format!("v1/sessions/{encoded}"))
+            .map_err(|_| {
+                MediaControlClientError::Configuration("media_control_endpoint_invalid")
+            })?;
+        let response = self
+            .send(Method::GET, url, None)
+            .await
+            .map_err(|code| MediaControlClientError::UnknownAfterTransport { code })?;
+        if !response.status.is_success() {
+            return Err(project_rejection(response.status, &response.body));
+        }
+        let envelope: SessionEnvelope = serde_json::from_slice(&response.body).map_err(|_| {
+            MediaControlClientError::UnknownAfterTransport {
+                code: "media_control_response_invalid",
+            }
+        })?;
+        envelope.data.validate()?;
+        Ok(envelope.data)
+    }
+
+    fn acquire_before_transport(&self) -> Result<OwnedSemaphorePermit, MediaControlClientError> {
+        self.inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| rejected_before_transport())
+    }
+
+    async fn command_request(
+        &self,
+        url: Url,
+        body: Vec<u8>,
+        command_id: String,
+    ) -> Result<MediaControlResult, MediaControlClientError> {
+        let response = match self.send(Method::POST, url, Some(body)).await {
+            Ok(response) => response,
+            Err(code) => return Ok(unknown_after_transport_failure(command_id, code)),
+        };
+        if response.status.is_server_error() {
+            let code = projected_error_code(&response.body)
+                .unwrap_or("media_control_upstream_unavailable");
+            return Ok(unknown_after_transport_failure(command_id, code));
+        }
+        if !response.status.is_success() {
+            let error = project_rejection(response.status, &response.body);
+            return match error {
+                MediaControlClientError::UnknownAfterTransport { code } => {
+                    Ok(unknown_after_transport_failure(command_id, code))
+                }
+                deterministic => Err(deterministic),
+            };
+        }
+        let envelope: ResultEnvelope = match serde_json::from_slice(&response.body) {
+            Ok(envelope) => envelope,
+            Err(_) => {
+                return Ok(unknown_after_transport_failure(
+                    command_id,
+                    "media_control_response_invalid",
+                ));
+            }
+        };
+        if envelope.data.validate().is_err() || envelope.data.command_id() != command_id {
+            return Ok(unknown_after_transport_failure(
+                command_id,
+                "media_control_response_invalid",
+            ));
+        }
+        Ok(envelope.data)
+    }
+
+    async fn send(
+        &self,
+        method: Method,
+        url: Url,
+        body: Option<Vec<u8>>,
+    ) -> Result<BoundedResponse, &'static str> {
+        let mut request = self
+            .client
+            .request(method, url)
+            .bearer_auth(&self.service_token)
+            .header(reqwest::header::ACCEPT, "application/json");
+        if let Some(body) = body {
+            request = request
+                .header(reqwest::header::CONTENT_TYPE, "application/json")
+                .body(body);
+        }
+        tokio::time::timeout(self.request_timeout, async {
+            let response = request
+                .send()
+                .await
+                .map_err(|_| "media_control_unavailable")?;
+            if response
+                .content_length()
+                .is_some_and(|length| length > self.max_response_bytes as u64)
+            {
+                return Err("response_too_large");
+            }
+            let status = response.status();
+            let mut stream = response.bytes_stream();
+            let mut body = Vec::new();
+            while let Some(chunk) = stream.next().await {
+                let chunk = chunk.map_err(|_| "media_control_unavailable")?;
+                append_bounded(&mut body, &chunk, self.max_response_bytes)?;
+            }
+            Ok(BoundedResponse { status, body })
+        })
+        .await
+        .map_err(|_| "media_control_timeout")?
+    }
+}
+
+pub struct CallMediaSequenceAllocator {
+    next_sequence: AtomicU32,
+}
+
+impl CallMediaSequenceAllocator {
+    pub fn new(first_sequence: u32) -> Result<Self, MediaControlClientError> {
+        if first_sequence == 0 {
+            return Err(MediaControlClientError::InvalidCommand(
+                "command_sequence_invalid",
+            ));
+        }
+        Ok(Self {
+            next_sequence: AtomicU32::new(first_sequence),
+        })
+    }
+
+    pub fn next(&self) -> Result<u32, MediaControlClientError> {
+        self.next_sequence
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1).filter(|next| *next != 0)
+            })
+            .map_err(|_| MediaControlClientError::InvalidCommand("command_sequence_exhausted"))
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct MediaControlCommand {
+    pub protocol_version: String,
+    pub action: MediaControlAction,
+    pub command_id: String,
+    pub tenant_id: String,
+    pub call_id: String,
+    pub leg_id: String,
+    pub cell_id: String,
+    pub owner_node_id: String,
+    pub owner_epoch: String,
+    pub media_reservation_id: String,
+    pub command_sequence: u32,
+    pub idempotency_key: String,
+    pub expires_at: String,
+    pub payload: Map<String, Value>,
+    pub payload_hash: String,
+}
+
+impl MediaControlCommand {
+    pub fn validate(&self) -> Result<(), MediaControlClientError> {
+        if self.protocol_version != MEDIA_CONTROL_PROTOCOL_VERSION {
+            return Err(MediaControlClientError::InvalidCommand(
+                "media_control_protocol_unsupported",
+            ));
+        }
+        for (name, value) in [
+            ("command_id", self.command_id.as_str()),
+            ("tenant_id", self.tenant_id.as_str()),
+            ("call_id", self.call_id.as_str()),
+            ("leg_id", self.leg_id.as_str()),
+            ("cell_id", self.cell_id.as_str()),
+            ("owner_node_id", self.owner_node_id.as_str()),
+            ("media_reservation_id", self.media_reservation_id.as_str()),
+            ("idempotency_key", self.idempotency_key.as_str()),
+        ] {
+            valid_identifier(value, name)?;
+        }
+        self.owner_epoch
+            .parse::<u64>()
+            .map_err(|_| MediaControlClientError::InvalidCommand("owner_epoch_invalid"))?;
+        if self.command_sequence == 0 {
+            return Err(MediaControlClientError::InvalidCommand(
+                "command_sequence_invalid",
+            ));
+        }
+        let expires_at = chrono::DateTime::parse_from_rfc3339(&self.expires_at)
+            .map_err(|_| MediaControlClientError::InvalidCommand("expires_at_invalid"))?;
+        if expires_at.to_rfc3339_opts(chrono::SecondsFormat::Millis, true) != self.expires_at {
+            return Err(MediaControlClientError::InvalidCommand(
+                "expires_at_invalid",
+            ));
+        }
+        let payload_hash = payload_hash(&self.payload)?;
+        if self.payload_hash != payload_hash {
+            return Err(MediaControlClientError::InvalidCommand(
+                "payload_hash_invalid",
+            ));
+        }
+        if self.command_id != command_id_for(self)? {
+            return Err(MediaControlClientError::InvalidCommand(
+                "command_id_invalid",
+            ));
+        }
+        Ok(())
+    }
+}
