+async fn close_rwi_originate_media_best_effort(
+    call_id: &str,
+    runtime: &mut crate::ivekit_media_lifecycle::IveKitMediaRuntime,
+) {
+    let cleanup = async {
+        let mut last_error = None;
+        for _ in 0..3 {
+            match crate::ivekit_media_lifecycle::close_rwi_originate_media(runtime).await {
+                Ok(outcome) => return Ok(outcome),
+                Err(error) => {
+                    last_error = Some(error);
+                    tokio::task::yield_now().await;
+                }
+            }
+        }
+        Err(last_error.expect("bounded cleanup attempted at least once"))
+    };
+    match tokio::time::timeout(RWI_MEDIA_CLEANUP_ATTEMPT_TIMEOUT, cleanup).await {
+        Ok(Ok(_)) => return,
+        Ok(Err(error)) => {
+            tracing::warn!(
+                %call_id,
+                error = %error,
+                "RWI originate media cleanup handed off for reconciliation"
+            );
+        }
+        Err(_) => {
+            tracing::warn!(
+                %call_id,
+                "RWI originate media cleanup timed out and was handed off"
+            );
+        }
+    }
+    let owned_runtime = std::mem::replace(
+        runtime,
+        crate::ivekit_media_lifecycle::IveKitMediaRuntime::Disabled,
+    );
+    handoff_rwi_media_cleanup(call_id, owned_runtime);
+}
+
+fn rwi_media_cleanups() -> &'static dashmap::DashMap<String, Arc<PendingRwiMediaCleanup>> {
+    RWI_MEDIA_CLEANUPS.get_or_init(dashmap::DashMap::new)
+}
+
+fn handoff_rwi_media_cleanup(
+    call_id: &str,
+    runtime: crate::ivekit_media_lifecycle::IveKitMediaRuntime,
+) {
+    let cleanups = rwi_media_cleanups();
+    match cleanups.entry(call_id.to_string()) {
+        dashmap::mapref::entry::Entry::Occupied(_) => {
+            tracing::warn!(
+                %call_id,
+                "RWI media cleanup handoff already exists"
+            );
+            return;
+        }
+        dashmap::mapref::entry::Entry::Vacant(vacant) => {
+            vacant.insert(Arc::new(PendingRwiMediaCleanup {
+                runtime: tokio::sync::Mutex::new(runtime),
+            }));
+        }
+    }
+    start_rwi_media_cleanup_worker();
+}
+
+fn start_rwi_media_cleanup_worker() {
+    if RWI_MEDIA_CLEANUP_WORKER_RUNNING.swap(true, std::sync::atomic::Ordering::AcqRel) {
+        return;
+    }
+    tokio::spawn(run_rwi_media_cleanup_worker());
+}
+
+async fn run_rwi_media_cleanup_worker() {
+    let mut retry_delay = RWI_MEDIA_CLEANUP_RETRY_MIN;
+    loop {
+        let cleanup_count = rwi_media_cleanups().len();
+        let start = if cleanup_count == 0 {
+            0
+        } else {
+            RWI_MEDIA_CLEANUP_CURSOR.fetch_add(
+                RWI_MEDIA_CLEANUP_BATCH_SIZE,
+                std::sync::atomic::Ordering::Relaxed,
+            ) % cleanup_count
+        };
+        let mut batch = rwi_media_cleanups()
+            .iter()
+            .skip(start)
+            .take(RWI_MEDIA_CLEANUP_BATCH_SIZE)
+            .map(|entry| (entry.key().clone(), Arc::clone(entry.value())))
+            .collect::<Vec<_>>();
+        if batch.len() < RWI_MEDIA_CLEANUP_BATCH_SIZE && batch.len() < cleanup_count {
+            let remaining =
+                (RWI_MEDIA_CLEANUP_BATCH_SIZE - batch.len()).min(cleanup_count - batch.len());
+            batch.extend(
+                rwi_media_cleanups()
+                    .iter()
+                    .take(remaining)
+                    .map(|entry| (entry.key().clone(), Arc::clone(entry.value()))),
+            );
+        }
+        if batch.is_empty() {
+            RWI_MEDIA_CLEANUP_WORKER_RUNNING.store(false, std::sync::atomic::Ordering::Release);
+            if rwi_media_cleanups().is_empty() {
+                return;
+            }
+            if RWI_MEDIA_CLEANUP_WORKER_RUNNING
+                .compare_exchange(
+                    false,
+                    true,
+                    std::sync::atomic::Ordering::AcqRel,
+                    std::sync::atomic::Ordering::Acquire,
+                )
+                .is_err()
+            {
+                return;
+            }
+            continue;
+        }
+
+        let outcomes = futures::stream::iter(batch)
+            .map(|(call_id, cleanup)| async move {
+                let confirmed = {
+                    let mut runtime = cleanup.runtime.lock().await;
+                    matches!(
+                        tokio::time::timeout(
+                            RWI_MEDIA_CLEANUP_ATTEMPT_TIMEOUT,
+                            crate::ivekit_media_lifecycle::close_rwi_originate_media(&mut runtime,),
+                        )
+                        .await,
+                        Ok(Ok(_))
+                    )
+                };
+                (call_id, cleanup, confirmed)
+            })
+            .buffer_unordered(RWI_MEDIA_CLEANUP_CONCURRENCY)
+            .collect::<Vec<_>>()
+            .await;
+        let mut completed = 0usize;
+        for (call_id, cleanup, confirmed) in outcomes {
+            if !confirmed {
+                continue;
+            }
+            let current_matches = rwi_media_cleanups()
+                .get(&call_id)
+                .is_some_and(|current| Arc::ptr_eq(current.value(), &cleanup));
+            if current_matches {
+                rwi_media_cleanups().remove(&call_id);
+                completed += 1;
+            }
+        }
+        retry_delay = if completed > 0 {
+            RWI_MEDIA_CLEANUP_RETRY_MIN
+        } else {
+            retry_delay
+                .checked_mul(2)
+                .unwrap_or(RWI_MEDIA_CLEANUP_RETRY_MAX)
+                .min(RWI_MEDIA_CLEANUP_RETRY_MAX)
+        };
+        tokio::time::sleep(retry_delay).await;
+    }
+}
+
+#[cfg(test)]
+fn pending_rwi_media_cleanup(call_id: &str) -> bool {
+    rwi_media_cleanups().contains_key(call_id)
+}
+
+#[cfg(test)]
+fn remove_pending_rwi_media_cleanup(call_id: &str) {
+    rwi_media_cleanups().remove(call_id);
+}
+
+#[cfg(test)]
+mod ivekit_media_cleanup_handoff_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn unresolved_rwi_media_cleanup_is_retained_for_retry() {
+        let call_id = "ivekit-cleanup-handoff-a";
+        let mut runtime = crate::ivekit_media_lifecycle::IveKitMediaRuntime::FailClosed {
+            error_code: "media_control_unavailable",
+        };
+
+        close_rwi_originate_media_best_effort(call_id, &mut runtime).await;
+
+        assert!(pending_rwi_media_cleanup(call_id));
+        remove_pending_rwi_media_cleanup(call_id);
+    }
+}
