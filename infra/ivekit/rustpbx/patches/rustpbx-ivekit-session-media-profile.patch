+            (MediaCodec::Pcmu | MediaCodec::Pcma, MediaCodec::Opus)
+                | (MediaCodec::Opus, MediaCodec::Pcmu | MediaCodec::Pcma)
+        );
+        if !codec_pair_is_valid
+            || *packetization_ms != 20
+            || !valid_payload_type(*leg_a_codec, *leg_a_payload_type)
+            || !valid_payload_type(*leg_b_codec, *leg_b_payload_type)
