+                serde_json::Value::String(leg_b_codec.as_str().to_string()),
+            );
+            payload.insert(
+                "leg_a_payload_type".to_string(),
+                serde_json::Value::from(*leg_a_payload_type),
+            );
+            payload.insert(
+                "leg_b_payload_type".to_string(),
+                serde_json::Value::from(*leg_b_payload_type),
+            );
+            payload.insert(
+                "packetization_ms".to_string(),
+                serde_json::Value::from(*packetization_ms),
+            );
+        }
+        payload
+    }
+}
+
+fn valid_payload_type(codec: MediaCodec, payload_type: u8) -> bool {
+    match codec {
+        MediaCodec::Pcmu => payload_type == 0,
+        MediaCodec::Pcma => payload_type == 8,
+        MediaCodec::Opus => (96..=127).contains(&payload_type),
+    }
+}
