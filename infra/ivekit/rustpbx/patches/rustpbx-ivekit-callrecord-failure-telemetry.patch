 const CALL_RECORD_HTTP_TIMEOUT: Duration = Duration::from_secs(10);
 const CALL_RECORD_HTTP_CONNECT_TIMEOUT: Duration = Duration::from_secs(3);
+const CALL_RECORD_SINK_WARNING_INTERVAL_SECS: u64 = 5;
+static LAST_CALL_RECORD_SINK_WARNING_EPOCH_SECS: AtomicU64 = AtomicU64::new(0);
+
+fn try_claim_sink_warning(last_warning: &AtomicU64, now_secs: u64) -> bool {
+    let previous = last_warning.load(Ordering::Relaxed);
+    now_secs.saturating_sub(previous) >= CALL_RECORD_SINK_WARNING_INTERVAL_SECS
+        && last_warning
+            .compare_exchange(previous, now_secs, Ordering::Relaxed, Ordering::Relaxed)
+            .is_ok()
+}
+
+fn report_sink_failure(stage: &'static str, error: &dyn std::fmt::Display) {
+    metrics::counter!(
+        "rustpbx_call_record_sink_failures_total",
+        "stage" => stage
+    )
+    .increment(1);
+
+    let now_secs = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs();
+    if try_claim_sink_warning(&LAST_CALL_RECORD_SINK_WARNING_EPOCH_SECS, now_secs) {
+        warn!(stage, error = %error, "call record sink failure; further warnings are rate limited");
+    }
+}
 
