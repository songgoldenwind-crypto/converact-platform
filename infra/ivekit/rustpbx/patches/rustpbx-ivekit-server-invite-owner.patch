+#[cfg(test)]
+mod invite_owner_tests {
+    use super::SipServer;
+    use crate::proxy::tests::common::{create_test_request, create_transaction};
+    use rsipstack::sip::{Method, StatusCode};
+    use std::time::Duration;
+    use tokio::time::timeout;
+    use tokio_util::sync::CancellationToken;
+
+    #[tokio::test]
+    async fn ivekit_server_invite_owner_survives_module_return_until_cancelled() {
+        let request = create_test_request(Method::Invite, "alice", None, "rustpbx.test", None);
+        let (mut transaction, endpoint) = create_transaction(request).await;
+        transaction
+            .reply(StatusCode::ServiceUnavailable)
+            .await
+            .expect("final response");
+        let token = CancellationToken::new();
+        let owner_token = token.clone();
+        let owner = tokio::spawn(async move {
+            SipServer::retain_server_invite_owner(&owner_token, &mut transaction).await;
+            transaction
+        });
+
+        tokio::task::yield_now().await;
+        assert!(
+            !owner.is_finished(),
+            "owner dropped before protocol terminal"
+        );
+        assert_eq!(endpoint.get_stats().running_transactions, 1);
+
+        token.cancel();
+        let transaction = timeout(Duration::from_secs(1), owner)
+            .await
+            .expect("owner cancellation timeout")
+            .expect("owner task panicked");
+        drop(transaction);
+        assert_eq!(endpoint.get_stats().running_transactions, 0);
     }
+
+    #[tokio::test]
+    async fn ivekit_max_concurrency_rejection_retains_owner_until_cancelled() {
+        let request = create_test_request(Method::Invite, "alice", None, "rustpbx.test", None);
+        let (transaction, endpoint) = create_transaction(request).await;
+        let token = CancellationToken::new();
+        let owner_token = token.clone();
+        let owner = tokio::spawn(async move {
+            SipServer::reject_max_concurrency_and_retain(owner_token, transaction).await;
+        });
+
+        tokio::task::yield_now().await;
+        assert!(
+            !owner.is_finished(),
+            "503 owner dropped before protocol terminal"
+        );
+        assert_eq!(endpoint.get_stats().running_transactions, 1);
+
+        token.cancel();
+        timeout(Duration::from_secs(1), owner)
+            .await
+            .expect("owner cancellation timeout")
+            .expect("owner task panicked");
+        assert_eq!(endpoint.get_stats().running_transactions, 0);
+    }
