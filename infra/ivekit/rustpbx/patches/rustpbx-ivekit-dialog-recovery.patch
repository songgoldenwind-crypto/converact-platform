+#[derive(Clone)]
+struct RecoveredShadowPairContext {
+    tenant_id: String,
+    cell_id: String,
+    owner_node_id: String,
+    owner_fault_domain: String,
+    owner_epoch: u64,
+    takeover_id: String,
+    call_session_ref: String,
+    auth_context_ref: String,
+}
+
+const RECOVERED_DIALOG_REQUEST_TIMEOUT: Duration = Duration::from_secs(32);
+const RECOVERED_DIALOG_TERMINATION_TIMEOUT: Duration = Duration::from_secs(2);
+const RECOVERED_DIALOG_GLARE_RETRIES: usize = 2;
+const RECOVERED_DIALOG_EVENT_CAPACITY: usize = 64;
+const RECOVERED_DIALOG_TERMINAL_ENQUEUE_TIMEOUT: Duration = Duration::from_millis(100);
+
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+enum RecoveredDialogSide {
+    Caller,
+    Callee,
+}
+
+impl RecoveredDialogSide {
+    fn from_leg(value: &str) -> Result<Self, DialogShadowError> {
+        match value {
+            "caller" => Ok(Self::Caller),
+            "callee" => Ok(Self::Callee),
+            _ => Err(DialogShadowError::InvalidRecord),
+        }
+    }
+
+    fn peer(self) -> Self {
+        match self {
+            Self::Caller => Self::Callee,
+            Self::Callee => Self::Caller,
+        }
+    }
+
+    fn media_side(self) -> crate::ivekit_media_lifecycle::MediaDialogSide {
+        match self {
+            Self::Caller => crate::ivekit_media_lifecycle::MediaDialogSide::Caller,
+            Self::Callee => crate::ivekit_media_lifecycle::MediaDialogSide::Callee,
+        }
+    }
+}
+
+struct RecoveredDialogEvent {
+    side: RecoveredDialogSide,
+    state: rsipstack::dialog::dialog::DialogState,
+}
+
+enum RecoveredControllerFlow {
+    Continue,
+    Stop,
+}
+
+struct RecoveredDialogController {
+    dialog_layer: Arc<rsipstack::dialog::dialog_layer::DialogLayer>,
+    caller_dialog_id: rsipstack::dialog::DialogId,
+    callee_dialog_id: rsipstack::dialog::DialogId,
+    payloads: Vec<DialogRecoveryCapsulePayload>,
+    media: crate::ivekit_media_lifecycle::IveKitMediaLifecycle,
+    sequence: u32,
+    context: RecoveredShadowPairContext,
+    executor: Arc<dyn DialogShadowCommitExecutor>,
+    codec: Arc<DialogRecoveryCapsuleCodec>,
+    frozen: bool,
+}
+
+#[allow(clippy::too_many_arguments)]
+fn spawn_recovered_dialog_controller(
+    dialog_layer: Arc<rsipstack::dialog::dialog_layer::DialogLayer>,
+    receivers: Vec<(
+        RecoveredDialogSide,
+        rsipstack::dialog::DialogId,
+        rsipstack::dialog::dialog::DialogStateReceiver,
+    )>,
+    payloads: Vec<DialogRecoveryCapsulePayload>,
+    media: crate::ivekit_media_lifecycle::IveKitMediaLifecycle,
+    active_records: [DialogShadowRecord; 2],
+    context: RecoveredShadowPairContext,
+    executor: Arc<dyn DialogShadowCommitExecutor>,
+    codec: Arc<DialogRecoveryCapsuleCodec>,
+) -> Result<(), DialogShadowError> {
+    validate_shadow_pair(&active_records)?;
+    if receivers.len() != 2
+        || active_records[0].sequence == 0
+        || active_records[0].sequence != active_records[1].sequence
+        || active_records
+            .iter()
+            .any(|record| record.owner_epoch != context.owner_epoch)
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let mut caller_dialog_id = None;
+    let mut callee_dialog_id = None;
+    for (side, dialog_id, _) in &receivers {
+        let target = match side {
+            RecoveredDialogSide::Caller => &mut caller_dialog_id,
+            RecoveredDialogSide::Callee => &mut callee_dialog_id,
+        };
+        if target.is_some() {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        let payload = payloads
+            .iter()
+            .find(|payload| RecoveredDialogSide::from_leg(&payload.leg).ok() == Some(*side))
+            .ok_or(DialogShadowError::InvalidRecord)?;
+        if stable_dialog_shadow_id(
+            &dialog_id.call_id,
+            &dialog_id.local_tag,
+            &dialog_id.remote_tag,
+        ) != payload.dialog_id
+        {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        *target = Some(dialog_id.clone());
+    }
+    let controller = RecoveredDialogController {
+        dialog_layer,
+        caller_dialog_id: caller_dialog_id.ok_or(DialogShadowError::InvalidRecord)?,
+        callee_dialog_id: callee_dialog_id.ok_or(DialogShadowError::InvalidRecord)?,
+        payloads,
+        media,
+        sequence: active_records[0].sequence,
+        context,
+        executor,
+        codec,
+        frozen: false,
+    };
+    let (event_sender, event_receiver) =
+        tokio::sync::mpsc::channel(RECOVERED_DIALOG_EVENT_CAPACITY);
+    for (side, _, mut receiver) in receivers {
+        let sender = event_sender.clone();
+        tokio::spawn(async move {
+            while let Some(state) = receiver.recv().await {
+                let event = RecoveredDialogEvent { side, state };
+                match sender.try_send(event) {
+                    Ok(()) => {}
+                    Err(tokio::sync::mpsc::error::TrySendError::Full(event)) => {
+                        if matches!(
+                            &event.state,
+                            rsipstack::dialog::dialog::DialogState::Terminated(_, _)
+                        ) {
+                            if !matches!(
+                                tokio::time::timeout(
+                                    RECOVERED_DIALOG_TERMINAL_ENQUEUE_TIMEOUT,
+                                    sender.send(event),
+                                )
+                                .await,
+                                Ok(Ok(()))
+                            ) {
+                                break;
+                            }
+                        } else {
+                            reject_recovered_dialog_event(event).await;
+                        }
+                    }
+                    Err(tokio::sync::mpsc::error::TrySendError::Closed(_)) => break,
+                }
+            }
+        });
+    }
+    drop(event_sender);
+    tokio::spawn(controller.run(event_receiver));
+    Ok(())
+}
+
+impl RecoveredDialogController {
+    async fn run(mut self, mut receiver: tokio::sync::mpsc::Receiver<RecoveredDialogEvent>) {
+        while let Some(event) = receiver.recv().await {
+            match self.handle_event(event).await {
+                Ok(RecoveredControllerFlow::Continue) => {}
+                Ok(RecoveredControllerFlow::Stop) => return,
+                Err(
+                    error @ (DialogShadowError::OutcomeUnknown
+                    | DialogShadowError::ReconcileRequired),
+                ) => {
+                    self.frozen = true;
+                    tracing::warn!(
+                        call_session_ref = %self.context.call_session_ref,
+                        owner_epoch = self.context.owner_epoch,
+                        error = %error,
+                        "recovered dialog controller froze mutations while preserving media"
+                    );
+                }
+                Err(error) => {
+                    tracing::warn!(
+                        call_session_ref = %self.context.call_session_ref,
+                        owner_epoch = self.context.owner_epoch,
+                        error = %error,
+                        "recovered dialog controller failed closed"
+                    );
+                    self.terminate_all("controller_failure").await;
+                    return;
+                }
+            }
+        }
+        self.terminate_all("dialog_state_channel_closed").await;
+    }
+
+    async fn handle_event(
+        &mut self,
+        event: RecoveredDialogEvent,
+    ) -> Result<RecoveredControllerFlow, DialogShadowError> {
+        use rsipstack::dialog::dialog::DialogState;
+
+        if self.frozen {
+            return match event.state {
+                DialogState::Terminated(id, _) => {
+                    self.require_dialog_id(event.side, &id)?;
+                    self.terminate_all("frozen_dialog_terminated").await;
+                    Ok(RecoveredControllerFlow::Stop)
+                }
+                state => {
+                    reject_recovered_dialog_event(RecoveredDialogEvent {
+                        side: event.side,
+                        state,
+                    })
+                    .await;
+                    Ok(RecoveredControllerFlow::Continue)
+                }
+            };
+        }
+
+        match event.state {
+            DialogState::Updated(id, request, handle) => {
+                self.require_dialog_id(event.side, &id)?;
+                self.handle_updated(event.side, request, handle).await
+            }
+            DialogState::Info(id, request, handle)
+            | DialogState::Options(id, request, handle)
+            | DialogState::Notify(id, request, handle)
+            | DialogState::Refer(id, request, handle)
+            | DialogState::Message(id, request, handle)
+            | DialogState::Publish(id, request, handle) => {
+                self.require_dialog_id(event.side, &id)?;
+                self.handle_signaling_request(event.side, request, handle)
+                    .await
+            }
+            DialogState::Terminated(id, _) => {
+                self.require_dialog_id(event.side, &id)?;
+                self.terminate_all("dialog_terminated").await;
+                Ok(RecoveredControllerFlow::Stop)
+            }
+            _ => Ok(RecoveredControllerFlow::Continue),
+        }
+    }
+
+    async fn handle_signaling_request(
+        &mut self,
+        side: RecoveredDialogSide,
+        request: rsipstack::sip::Request,
+        handle: rsipstack::dialog::dialog::TransactionHandle,
+    ) -> Result<RecoveredControllerFlow, DialogShadowError> {
+        let method = request.method;
+        let response = self
+            .request_peer(
+                side,
+                method,
+                relay_headers(&request.headers.0),
+                request.body,
+            )
+            .await;
+        let (status, headers, body) = match response {
+            Some(response) => (
+                response.status_code,
+                relay_headers(&response.headers.0),
+                response.body,
+            ),
+            None => (
+                rsipstack::sip::StatusCode::ServiceUnavailable,
+                Vec::new(),
+                Vec::new(),
+            ),
+        };
+        let final_response_identity = format!("{} {}", status.code(), method);
+        if let Err(error) = self
+            .refresh_and_commit(
+                DialogShadowState::Confirmed,
+                Some(&final_response_identity),
+                None,
+                None,
+            )
+            .await
+        {
+            let _ = handle
+                .reply(rsipstack::sip::StatusCode::ServiceUnavailable)
+                .await;
+            return Err(error);
+        }
+        handle
+            .respond(
+                status,
+                (!headers.is_empty()).then_some(headers),
+                (!body.is_empty()).then_some(body),
+            )
+            .await
+            .map_err(|_| DialogShadowError::Unavailable)?;
+        Ok(RecoveredControllerFlow::Continue)
+    }
+
+    async fn handle_updated(
+        &mut self,
+        side: RecoveredDialogSide,
+        request: rsipstack::sip::Request,
+        handle: rsipstack::dialog::dialog::TransactionHandle,
+    ) -> Result<RecoveredControllerFlow, DialogShadowError> {
+        use rsipstack::sip::StatusCodeKind;
+
+        if !matches!(
+            request.method,
+            rsipstack::sip::Method::Invite | rsipstack::sip::Method::Update
+        ) {
+            let _ = handle.reply(rsipstack::sip::StatusCode::BadRequest).await;
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        if request.body.is_empty() {
+            return self.handle_signaling_request(side, request, handle).await;
+        }
+        let logical_offer = match std::str::from_utf8(&request.body) {
+            Ok(value) if !value.trim().is_empty() => value.to_string(),
+            _ => {
+                let _ = handle
+                    .reply(rsipstack::sip::StatusCode::NotAcceptableHere)
+                    .await;
+                return Ok(RecoveredControllerFlow::Continue);
+            }
+        };
+        let method = request.method;
+        let headers = relay_headers(&request.headers.0);
+        let mut glare_retries = 0usize;
+        let response = loop {
+            let effective_offer = match self
+                .media
+                .prepare_mid_dialog_offer(side.media_side(), &logical_offer)
+                .await
+            {
+                Ok(value) => value,
+                Err(error) => {
+                    let status = match error {
+                        crate::ivekit_media_lifecycle::MediaLifecycleError::InvalidSdp
+                        | crate::ivekit_media_lifecycle::MediaLifecycleError::ControlRejected => {
+                            rsipstack::sip::StatusCode::NotAcceptableHere
+                        }
+                        _ => rsipstack::sip::StatusCode::ServiceUnavailable,
+                    };
+                    let final_response_identity = format!("{} {}", status.code(), method);
+                    if self
+                        .refresh_and_commit(
+                            DialogShadowState::Updating,
+                            Some(&final_response_identity),
+                            Some(&logical_offer),
+                            None,
+                        )
+                        .await
+                        .is_err()
+                    {
+                        let _ = handle
+                            .reply(rsipstack::sip::StatusCode::ServiceUnavailable)
+                            .await;
+                        return Err(DialogShadowError::OutcomeUnknown);
+                    }
+                    let _ = handle.reply(status).await;
+                    return if matches!(
+                        error,
+                        crate::ivekit_media_lifecycle::MediaLifecycleError::InvalidSdp
+                            | crate::ivekit_media_lifecycle::MediaLifecycleError::ControlRejected
+                    ) {
+                        Ok(RecoveredControllerFlow::Continue)
+                    } else {
+                        Err(DialogShadowError::OutcomeUnknown)
+                    };
+                }
+            };
+            let response = self
+                .request_peer(side, method, headers.clone(), effective_offer.into_bytes())
+                .await;
+            if response.as_ref().is_some_and(|value| {
+                value.status_code == rsipstack::sip::StatusCode::RequestPending
+            }) && glare_retries < RECOVERED_DIALOG_GLARE_RETRIES
+            {
+                tokio::time::sleep(Duration::from_millis(250 * (glare_retries as u64 + 1))).await;
+                glare_retries += 1;
+                continue;
+            }
+            break response;
+        };
+        let Some(response) = response else {
+            let status = rsipstack::sip::StatusCode::ServiceUnavailable;
+            let final_response_identity = format!("{} {}", status.code(), method);
+            self.refresh_and_commit(
+                DialogShadowState::Updating,
+                Some(&final_response_identity),
+                Some(&logical_offer),
+                None,
+            )
+            .await?;
+            handle
+                .reply(status)
+                .await
+                .map_err(|_| DialogShadowError::Unavailable)?;
+            return Ok(RecoveredControllerFlow::Continue);
+        };
+        if response.status_code.kind() != StatusCodeKind::Successful {
+            let status = response.status_code;
+            let response_headers = relay_headers(&response.headers.0);
+            let response_body = response.body;
+            let final_response_identity = format!("{} {}", status.code(), method);
+            self.refresh_and_commit(
+                DialogShadowState::Updating,
+                Some(&final_response_identity),
+                Some(&logical_offer),
+                None,
+            )
+            .await?;
+            handle
+                .respond(
+                    status,
+                    (!response_headers.is_empty()).then_some(response_headers),
+                    (!response_body.is_empty()).then_some(response_body),
+                )
+                .await
+                .map_err(|_| DialogShadowError::Unavailable)?;
+            return Ok(RecoveredControllerFlow::Continue);
+        }
+        let logical_answer = match std::str::from_utf8(&response.body) {
+            Ok(value) if !value.trim().is_empty() => value.to_string(),
+            _ => {
+                let _ = handle.reply(rsipstack::sip::StatusCode::BadGateway).await;
+                return Err(DialogShadowError::OutcomeUnknown);
+            }
+        };
+        let effective_answer = match self
+            .media
+            .commit_mid_dialog_answer(side.media_side(), &logical_answer)
+            .await
+        {
+            Ok(value) => value,
+            Err(_) => {
+                let _ = handle
+                    .reply(rsipstack::sip::StatusCode::ServiceUnavailable)
+                    .await;
+                return Err(DialogShadowError::OutcomeUnknown);
+            }
+        };
+        let status = response.status_code;
+        let mut response_headers = relay_headers(&response.headers.0);
+        if !response_headers
+            .iter()
+            .any(|header| header.name().eq_ignore_ascii_case("content-type"))
+        {
+            response_headers.push(rsipstack::sip::Header::ContentType(
+                rsipstack::sip::headers::ContentType::from("application/sdp"),
+            ));
+        }
+        let final_response_identity = format!("{} {}", status.code(), method);
+        if let Err(error) = self
+            .refresh_and_commit(
+                DialogShadowState::Updating,
+                Some(&final_response_identity),
+                Some(&logical_offer),
+                Some(&effective_answer),
+            )
+            .await
+        {
+            let _ = handle
+                .reply(rsipstack::sip::StatusCode::ServiceUnavailable)
+                .await;
+            return Err(error);
+        }
+        handle
+            .respond(
+                status,
+                Some(response_headers),
+                Some(effective_answer.into_bytes()),
+            )
+            .await
+            .map_err(|_| DialogShadowError::Unavailable)?;
+        Ok(RecoveredControllerFlow::Continue)
+    }
+
+    async fn request_peer(
+        &self,
+        source: RecoveredDialogSide,
+        method: rsipstack::sip::Method,
+        headers: Vec<rsipstack::sip::Header>,
+        body: Vec<u8>,
+    ) -> Option<rsipstack::sip::Response> {
+        let dialog = self.dialog(source.peer()).ok()?;
+        match tokio::time::timeout(
+            RECOVERED_DIALOG_REQUEST_TIMEOUT,
+            dialog.request(
+                method,
+                (!headers.is_empty()).then_some(headers),
+                (!body.is_empty()).then_some(body),
+            ),
+        )
+        .await
+        {
+            Ok(Ok(response)) => response,
+            Ok(Err(error)) => {
+                tracing::warn!(
+                    call_session_ref = %self.context.call_session_ref,
+                    %method,
+                    error = %error,
+                    "recovered peer dialog request failed"
+                );
+                None
+            }
+            Err(_) => {
+                tracing::warn!(
+                    call_session_ref = %self.context.call_session_ref,
+                    %method,
+                    "recovered peer dialog request timed out"
+                );
+                None
+            }
+        }
+    }
+
+    async fn refresh_and_commit(
+        &mut self,
+        state: DialogShadowState,
+        final_response_identity: Option<&str>,
+        logical_offer_sdp: Option<&str>,
+        logical_answer_sdp: Option<&str>,
+    ) -> Result<(), DialogShadowError> {
+        let payloads = self.refreshed_payloads()?;
+        let sequence = self
+            .sequence
+            .checked_add(1)
+            .ok_or(DialogShadowError::SequenceExhausted)?;
+        let request = recovered_shadow_pair_request(
+            &self.context,
+            &self.codec,
+            &payloads,
+            state,
+            sequence,
+            final_response_identity,
+            logical_offer_sdp,
+            logical_answer_sdp,
+        )?;
+        self.executor.commit_pair(&request).await?;
+        self.sequence = sequence;
+        self.payloads = payloads;
+        Ok(())
+    }
+
+    fn refreshed_payloads(&self) -> Result<Vec<DialogRecoveryCapsulePayload>, DialogShadowError> {
+        let caller = self.dialog(RecoveredDialogSide::Caller)?;
+        let callee = self.dialog(RecoveredDialogSide::Callee)?;
+        let caller_snapshot = caller.snapshot();
+        let callee_snapshot = callee.snapshot();
+        let previous_caller = self.payload(RecoveredDialogSide::Caller)?;
+        let previous_callee = self.payload(RecoveredDialogSide::Callee)?;
+        let caller_payload = recovery_payload_from_dialog_snapshots(
+            &self.context.call_session_ref,
+            &previous_caller.interaction_id,
+            &previous_caller.media_reservation_id,
+            previous_caller.cdr_sequence,
+            &caller_snapshot,
+            &callee_snapshot,
+        )?;
+        let callee_payload = recovery_payload_from_dialog_snapshots(
+            &self.context.call_session_ref,
+            &previous_callee.interaction_id,
+            &previous_callee.media_reservation_id,
+            previous_callee.cdr_sequence,
+            &callee_snapshot,
+            &caller_snapshot,
+        )?;
+        if caller_payload.dialog_id != previous_caller.dialog_id
+            || callee_payload.dialog_id != previous_callee.dialog_id
+        {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        Ok(vec![caller_payload, callee_payload])
+    }
+
+    async fn terminate_all(&mut self, reason: &str) {
+        for side in [RecoveredDialogSide::Caller, RecoveredDialogSide::Callee] {
+            if let Ok(dialog) = self.dialog(side) {
+                let _ = tokio::time::timeout(RECOVERED_DIALOG_TERMINATION_TIMEOUT, dialog.hangup())
+                    .await;
+            }
+        }
+        if let Err(error) = self.media.close_media().await {
+            tracing::warn!(
+                call_session_ref = %self.context.call_session_ref,
+                error = %error,
+                "recovered media close failed"
+            );
+        }
+        if let Some(sequence) = self.sequence.checked_add(1) {
+            match recovered_shadow_pair_request(
+                &self.context,
+                &self.codec,
+                &self.payloads,
+                DialogShadowState::Terminated,
+                sequence,
+                Some(reason),
+                None,
+                None,
+            ) {
+                Ok(request) => {
+                    if let Err(error) = self.executor.commit_pair(&request).await {
+                        tracing::warn!(
+                            call_session_ref = %self.context.call_session_ref,
+                            error = %error,
+                            "recovered terminal dialog shadow commit failed"
+                        );
+                    }
+                }
+                Err(error) => {
+                    tracing::warn!(
+                        call_session_ref = %self.context.call_session_ref,
+                        error = %error,
+                        "recovered terminal dialog shadow build failed"
+                    );
+                }
+            }
+        }
+        self.dialog_layer.remove_dialog(&self.caller_dialog_id);
+        self.dialog_layer.remove_dialog(&self.callee_dialog_id);
+        crate::ivekit_owner::close_owner(&self.context.call_session_ref).await;
+    }
+
+    fn payload(
+        &self,
+        side: RecoveredDialogSide,
+    ) -> Result<&DialogRecoveryCapsulePayload, DialogShadowError> {
+        self.payloads
+            .iter()
+            .find(|payload| RecoveredDialogSide::from_leg(&payload.leg).ok() == Some(side))
+            .ok_or(DialogShadowError::InvalidRecord)
+    }
+
+    fn dialog(
+        &self,
+        side: RecoveredDialogSide,
+    ) -> Result<rsipstack::dialog::dialog::Dialog, DialogShadowError> {
+        self.dialog_layer
+            .get_dialog(self.dialog_id(side))
+            .ok_or(DialogShadowError::Unavailable)
+    }
+
+    fn require_dialog_id(
+        &self,
+        side: RecoveredDialogSide,
+        dialog_id: &rsipstack::dialog::DialogId,
+    ) -> Result<(), DialogShadowError> {
+        if self.dialog_id(side) == dialog_id {
+            Ok(())
+        } else {
+            Err(DialogShadowError::InvalidRecord)
+        }
+    }
+
+    fn dialog_id(&self, side: RecoveredDialogSide) -> &rsipstack::dialog::DialogId {
+        match side {
+            RecoveredDialogSide::Caller => &self.caller_dialog_id,
+            RecoveredDialogSide::Callee => &self.callee_dialog_id,
+        }
+    }
+}
+
+async fn reject_recovered_dialog_event(event: RecoveredDialogEvent) {
+    use rsipstack::dialog::dialog::DialogState;
+
+    match event.state {
+        DialogState::Updated(_, _, handle)
+        | DialogState::Info(_, _, handle)
+        | DialogState::Options(_, _, handle)
+        | DialogState::Notify(_, _, handle)
+        | DialogState::Refer(_, _, handle)
+        | DialogState::Message(_, _, handle)
+        | DialogState::Publish(_, _, handle) => {
+            let _ = handle
+                .reply(rsipstack::sip::StatusCode::ServiceUnavailable)
+                .await;
+        }
+        _ => {}
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn recovered_shadow_pair_request(
+    context: &RecoveredShadowPairContext,
+    codec: &DialogRecoveryCapsuleCodec,
+    payloads: &[DialogRecoveryCapsulePayload],
+    state: DialogShadowState,
+    sequence: u32,
+    final_response_identity: Option<&str>,
+    logical_offer_sdp: Option<&str>,
+    logical_answer_sdp: Option<&str>,
+) -> Result<DialogShadowCommitPairRequest, DialogShadowError> {
+    if payloads.len() != 2
+        || sequence == 0
+        || context.owner_epoch == 0
+        || context.owner_epoch > u32::MAX as u64
+        || !valid_identifier(&context.tenant_id)
+        || !valid_identifier(&context.cell_id)
+        || !valid_identifier(&context.owner_node_id)
+        || !valid_identifier(&context.owner_fault_domain)
+        || !valid_identifier(&context.takeover_id)
+        || !valid_identifier(&context.call_session_ref)
+        || !valid_identifier(&context.auth_context_ref)
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let caller = payloads
+        .iter()
+        .find(|payload| payload.leg == "caller")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let callee = payloads
+        .iter()
+        .find(|payload| payload.leg == "callee")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    if caller.dialog_role != "uas"
+        || callee.dialog_role != "uac"
+        || caller.peer_dialog_id != callee.dialog_id
+        || callee.peer_dialog_id != caller.dialog_id
+        || caller.call_session_ref != context.call_session_ref
+        || callee.call_session_ref != context.call_session_ref
+        || caller.interaction_id != callee.interaction_id
+        || caller.media_reservation_id != callee.media_reservation_id
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let terminal = state == DialogShadowState::Terminated;
+    let recorded_at = chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+    let mut records = payloads
+        .iter()
+        .map(|payload| {
+            validate_recovery_payload(payload)?;
+            let recovery_capsule = codec.seal(
+                payload,
+                &DialogRecoveryCapsuleBinding {
+                    tenant_id: context.tenant_id.clone(),
+                    cell_id: context.cell_id.clone(),
+                    dialog_id: payload.dialog_id.clone(),
+                    owner_epoch: context.owner_epoch,
+                    sequence,
+                },
+            )?;
+            let record = DialogShadowRecord {
+                schema_version: 2,
+                tenant_id: context.tenant_id.clone(),
+                cell_id: context.cell_id.clone(),
+                dialog_id: payload.dialog_id.clone(),
+                call_id_hash: sha256(&payload.raw_call_id),
+                owner_node_id: context.owner_node_id.clone(),
+                owner_fault_domain: context.owner_fault_domain.clone(),
+                owner_epoch: context.owner_epoch,
+                sequence,
+                state,
+                local_tag: payload.local_tag.clone(),
+                remote_tag: Some(payload.remote_tag.clone()),
+                route_set: payload.route_set.clone(),
+                local_cseq: payload.local_cseq,
+                remote_cseq: payload.remote_cseq,
+                branch_hash: sha256(&format!(
+                    "{}\0{}\0{}",
+                    payload.raw_call_id, payload.local_tag, payload.remote_tag
+                )),
+                final_response_hash: final_response_identity.map(sha256),
+                auth_context_ref: context.auth_context_ref.clone(),
+                logical_offer_hash: logical_offer_sdp.map(sha256),
+                logical_answer_hash: logical_answer_sdp.map(sha256),
+                media_reservation_id: Some(payload.media_reservation_id.clone()),
+                provider_session_ref: Some(context.call_session_ref.clone()),
+                cdr_sequence: payload.cdr_sequence,
+                recorded_at: recorded_at.clone(),
+                terminal,
+                recovery_capsule: Some(recovery_capsule),
+                takeover_id: Some(context.takeover_id.clone()),
+            };
+            if serde_json::to_vec(&record)
+                .map_err(|_| DialogShadowError::InvalidRecord)?
+                .len()
+                > MAX_RECORD_BYTES
+            {
+                return Err(DialogShadowError::InvalidRecord);
+            }
+            Ok(record)
+        })
+        .collect::<Result<Vec<_>, DialogShadowError>>()?;
+    records.sort_by(|left, right| left.dialog_id.cmp(&right.dialog_id));
+    let request = DialogShadowCommitPairRequest {
+        profile: PROFILE_T1.to_string(),
+        records: records
+            .try_into()
+            .map_err(|_| DialogShadowError::InvalidRecord)?,
+    };
+    validate_shadow_pair(&request.records)?;
+    Ok(request)
+}
+
+fn relay_headers(headers: &[rsipstack::sip::Header]) -> Vec<rsipstack::sip::Header> {
+    const HOP_OR_DIALOG_HEADERS: &[&str] = &[
+        "authentication-info",
+        "authorization",
+        "call-id",
+        "contact",
+        "content-length",
+        "cseq",
+        "from",
+        "max-forwards",
+        "path",
+        "proxy-authenticate",
+        "proxy-authorization",
+        "record-route",
+        "route",
+        "to",
+        "via",
+        "www-authenticate",
+        "x-ivekit-recovery",
+    ];
+    headers
+        .iter()
+        .filter(|header| {
+            let name = header.name();
+            !HOP_OR_DIALOG_HEADERS
+                .iter()
+                .any(|blocked| name.eq_ignore_ascii_case(blocked))
+        })
+        .cloned()
+        .collect()
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn commit_recovered_shadow_pair(
+    config: &DialogShadowRuntimeConfig,
+    tenant_id: &str,
+    cell_id: &str,
+    owner_node_id: &str,
+    owner_fault_domain: &str,
+    owner_epoch: u64,
+    takeover_id: &str,
+    call_session_ref: &str,
+    auth_context_ref: &str,
+    payloads: &[DialogRecoveryCapsulePayload],
+) -> Result<[DialogShadowRecord; 2], DialogShadowError> {
+    let request = recovered_shadow_pair_request(
+        &RecoveredShadowPairContext {
+            tenant_id: tenant_id.to_string(),
+            cell_id: cell_id.to_string(),
+            owner_node_id: owner_node_id.to_string(),
+            owner_fault_domain: owner_fault_domain.to_string(),
+            owner_epoch,
+            takeover_id: takeover_id.to_string(),
+            call_session_ref: call_session_ref.to_string(),
+            auth_context_ref: auth_context_ref.to_string(),
+        },
+        &config.recovery_codec,
+        payloads,
+        DialogShadowState::Confirmed,
+        1,
+        None,
+        None,
+        None,
+    )?;
+    let records = request.records.clone();
+    config.executor.commit_pair(&request).await.map(|_| records)
+}
