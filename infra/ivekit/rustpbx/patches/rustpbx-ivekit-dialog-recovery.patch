+    async fn refresh_owner_lease(&self, force: bool) -> Result<(), DialogShadowError> {
+        let Some(identity) = self.owner_identity.as_ref() else {
+            return Ok(());
+        };
+        if !force && self.owner_lease_is_fresh() {
+            return Ok(());
+        }
