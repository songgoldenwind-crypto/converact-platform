+#[derive(Clone)]
+pub struct DialogRecoveryCapsuleCodec {
+    current_key_id: String,
+    keys: HashMap<String, [u8; 32]>,
+}
+
+impl DialogRecoveryCapsuleCodec {
+    pub fn new(
+        current: DialogRecoveryCapsuleKey,
+        previous: Option<DialogRecoveryCapsuleKey>,
+    ) -> Result<Self, DialogShadowError> {
+        if previous
+            .as_ref()
+            .is_some_and(|value| value.key_id == current.key_id)
+        {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+        let current_key_id = current.key_id.clone();
+        let mut keys = HashMap::from([(current.key_id, current.key)]);
+        if let Some(previous) = previous {
+            keys.insert(previous.key_id, previous.key);
+        }
+        Ok(Self {
+            current_key_id,
+            keys,
+        })
+    }
+
+    pub fn seal(
+        &self,
+        value: &DialogRecoveryCapsulePayload,
+        binding: &DialogRecoveryCapsuleBinding,
+    ) -> Result<DialogRecoveryCapsuleEnvelope, DialogShadowError> {
+        validate_recovery_payload(value)?;
+        validate_recovery_binding(binding)?;
+        let plaintext = canonical_json(value)?;
+        if plaintext.len() > MAX_RECOVERY_PLAINTEXT_BYTES {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        let nonce: [u8; RECOVERY_NONCE_BYTES] = rand::random();
+        let key = self
+            .keys
+            .get(&self.current_key_id)
+            .ok_or(DialogShadowError::InvalidBinding)?;
+        let ciphertext_with_tag = Aes256Gcm::new_from_slice(key)
+            .map_err(|_| DialogShadowError::InvalidBinding)?
+            .encrypt(
+                Nonce::from_slice(&nonce),
+                Payload {
+                    msg: plaintext.as_bytes(),
+                    aad: &recovery_aad(binding)?,
+                },
+            )
+            .map_err(|_| DialogShadowError::RecoveryAuthenticationFailed)?;
+        let split = ciphertext_with_tag
+            .len()
+            .checked_sub(RECOVERY_TAG_BYTES)
+            .ok_or(DialogShadowError::InvalidRecord)?;
+        Ok(DialogRecoveryCapsuleEnvelope {
+            schema_version: 1,
+            algorithm: "A256GCM".to_string(),
+            key_id: self.current_key_id.clone(),
+            nonce: URL_SAFE_NO_PAD.encode(nonce),
+            ciphertext: URL_SAFE_NO_PAD.encode(&ciphertext_with_tag[..split]),
+            auth_tag: URL_SAFE_NO_PAD.encode(&ciphertext_with_tag[split..]),
+        })
+    }
+
+    pub fn open(
+        &self,
+        value: &DialogRecoveryCapsuleEnvelope,
+        binding: &DialogRecoveryCapsuleBinding,
+    ) -> Result<DialogRecoveryCapsulePayload, DialogShadowError> {
+        validate_recovery_binding(binding)?;
+        if value.schema_version != 1
+            || value.algorithm != "A256GCM"
+            || !valid_identifier(&value.key_id)
+        {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        let key = self
+            .keys
+            .get(&value.key_id)
+            .ok_or(DialogShadowError::InvalidBinding)?;
+        let nonce = decode_base64url(&value.nonce, Some(RECOVERY_NONCE_BYTES))?;
+        let mut ciphertext = decode_base64url(&value.ciphertext, None)?;
+        let tag = decode_base64url(&value.auth_tag, Some(RECOVERY_TAG_BYTES))?;
+        if ciphertext.len() < 2 || ciphertext.len() > MAX_RECOVERY_PLAINTEXT_BYTES {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        ciphertext.extend_from_slice(&tag);
+        let plaintext = Aes256Gcm::new_from_slice(key)
+            .map_err(|_| DialogShadowError::InvalidBinding)?
+            .decrypt(
+                Nonce::from_slice(&nonce),
+                Payload {
+                    msg: &ciphertext,
+                    aad: &recovery_aad(binding)?,
+                },
+            )
+            .map_err(|_| DialogShadowError::RecoveryAuthenticationFailed)?;
+        if plaintext.len() > MAX_RECOVERY_PLAINTEXT_BYTES {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        let text = std::str::from_utf8(&plaintext).map_err(|_| DialogShadowError::InvalidRecord)?;
+        let payload: DialogRecoveryCapsulePayload =
+            serde_json::from_str(text).map_err(|_| DialogShadowError::InvalidRecord)?;
+        validate_recovery_payload(&payload)?;
+        if canonical_json(&payload)? != text {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        Ok(payload)
+    }
+}
