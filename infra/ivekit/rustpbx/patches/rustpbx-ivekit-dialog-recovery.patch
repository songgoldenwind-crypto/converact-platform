+fn recovery_records() -> Vec<rustpbx::ivekit_dialog_shadow::DialogShadowRecord> {
+    let codec = Arc::new(
+        DialogRecoveryCapsuleCodec::new(
+            DialogRecoveryCapsuleKey::new("recovery-2026-07", &[0x55; 32]).unwrap(),
+            None,
+        )
+        .unwrap(),
+    );
+    [
+        ("dialog-a", "dialog-b", "caller", "uas"),
+        ("dialog-b", "dialog-a", "callee", "uac"),
+    ]
+    .into_iter()
+    .map(|(dialog_id, peer_dialog_id, leg, role)| {
+        let executor = Arc::new(ScriptedExecutor::default());
+        let mut lifecycle =
+            DialogShadowLifecycle::new_with_recovery_codec(binding(), executor, codec.clone());
+        let mut value = event(DialogShadowState::Confirmed);
+        value.dialog_id = dialog_id.into();
+        value.provider_session_ref = Some("call-session-a".into());
+        let mut payload = recovery_payload();
+        payload.dialog_id = dialog_id.into();
+        payload.peer_dialog_id = peer_dialog_id.into();
+        payload.leg = leg.into();
+        payload.dialog_role = role.into();
+        value.recovery_payload = Some(payload);
+        lifecycle.preview_request(&value).unwrap().record
+    })
+    .collect()
+}
