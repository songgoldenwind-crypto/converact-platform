+fn remove_restored_dialogs(
+    dialog_layer: &rsipstack::dialog::dialog_layer::DialogLayer,
+    ids: &[rsipstack::dialog::DialogId],
+) {
+    for id in ids {
+        dialog_layer.remove_dialog(id);
+    }
+}
