+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MediaRecoveryTakeoverInput {
+    pub tenant_id: String,
+    pub cell_id: String,
+    pub owner_node_id: String,
+    pub previous_owner_epoch: u64,
+    pub owner_epoch: u64,
+    pub media_reservation_id: String,
+    pub from_tag: String,
+    pub to_tag: String,
+    pub winning_branch: String,
+}
+
+pub async fn takeover_recovered_media(
+    input: &MediaRecoveryTakeoverInput,
+) -> Result<IveKitMediaLifecycle, MediaLifecycleError> {
+    let config = media_control_runtime_config()
+        .map_err(|_| MediaLifecycleError::ConfigurationInvalid)?
+        .ok_or(MediaLifecycleError::ConfigurationInvalid)?;
+    takeover_recovered_media_with_executor(
+        input,
+        config.executor.clone(),
+        &required_env("IVEKIT_RUSTPBX_MEDIA_PROFILE_ID")
+            .ok_or(MediaLifecycleError::ConfigurationInvalid)?,
+    )
+    .await
+}
+
+async fn takeover_recovered_media_with_executor<T>(
+    input: &MediaRecoveryTakeoverInput,
+    executor: Arc<T>,
+    media_profile_id: &str,
+) -> Result<IveKitMediaLifecycle, MediaLifecycleError>
+where
+    T: RecoveryMediaControlExecutor + 'static,
+{
+    let existing = recovery_session(executor.as_ref(), &input.media_reservation_id).await?;
+    if existing.owner_epoch == input.owner_epoch.to_string() {
+        return restore_recovered_media(input, executor, media_profile_id, existing);
+    }
+    require_previous_media_owner(input, &existing)?;
+    let command =
+        build_recovered_media_takeover_command(input, &existing.call_id, &existing.effective_sdp)?;
+
+    for attempt in 0..2 {
+        let result = MediaControlExecutor::execute(executor.as_ref(), &command).await;
+        match result {
+            Ok(
+                MediaControlResult::Committed {
+                    command_id,
+                    session,
+                    ..
+                }
+                | MediaControlResult::Replayed {
+                    command_id,
+                    session,
+                    ..
+                },
+            ) => {
+                if command_id != command.command_id {
+                    return Err(MediaLifecycleError::OutcomeUnknown);
+                }
+                return restore_recovered_media(input, executor, media_profile_id, session);
+            }
+            Ok(MediaControlResult::RejectedCapacity { .. })
+            | Ok(MediaControlResult::TerminalError { .. })
+            | Err(MediaControlClientError::Configuration(_))
+            | Err(MediaControlClientError::InvalidCommand(_))
+            | Err(MediaControlClientError::RejectedBeforeTransport { .. })
+            | Err(MediaControlClientError::Rejected { .. }) => {
+                return Err(MediaLifecycleError::ControlRejected);
+            }
+            Ok(MediaControlResult::RejectedEpoch { .. })
+            | Ok(MediaControlResult::Unknown { .. })
+            | Err(MediaControlClientError::UnknownAfterTransport { .. }) => {}
+        }
+
+        let observed = recovery_session(executor.as_ref(), &input.media_reservation_id).await?;
+        if observed.owner_epoch == input.owner_epoch.to_string() {
+            return restore_recovered_media(input, executor, media_profile_id, observed);
+        }
+        require_previous_media_owner(input, &observed)?;
+        if attempt == 1 {
+            return Err(MediaLifecycleError::ReconcileRequired);
+        }
+    }
+    Err(MediaLifecycleError::ReconcileRequired)
+}
+
+async fn recovery_session(
+    executor: &dyn RecoveryMediaControlExecutor,
+    media_reservation_id: &str,
+) -> Result<MediaSessionSnapshot, MediaLifecycleError> {
+    executor
+        .session(media_reservation_id)
+        .await
+        .map_err(|error| match error {
+            MediaControlClientError::UnknownAfterTransport { .. } => {
+                MediaLifecycleError::ReconcileRequired
+            }
+            _ => MediaLifecycleError::ControlRejected,
+        })
+}
+
+fn require_previous_media_owner(
+    input: &MediaRecoveryTakeoverInput,
+    session: &MediaSessionSnapshot,
+) -> Result<(), MediaLifecycleError> {
+    if session.media_reservation_id != input.media_reservation_id
+        || session.owner_epoch != input.previous_owner_epoch.to_string()
+        || !matches!(session.state.as_str(), "prepared" | "committed")
+    {
+        return Err(MediaLifecycleError::ControlRejected);
+    }
+    Ok(())
+}
+
+fn restore_recovered_media<T>(
+    input: &MediaRecoveryTakeoverInput,
+    executor: Arc<T>,
+    media_profile_id: &str,
+    session: MediaSessionSnapshot,
+) -> Result<IveKitMediaLifecycle, MediaLifecycleError>
+where
+    T: MediaControlExecutor + 'static,
+{
+    if session.media_reservation_id != input.media_reservation_id
+        || session.owner_epoch != input.owner_epoch.to_string()
+        || session.last_sequence != 1
+        || !matches!(session.state.as_str(), "prepared" | "committed")
+    {
+        return Err(MediaLifecycleError::OutcomeUnknown);
+    }
+    let admission_reservation_id = input
+        .media_reservation_id
+        .strip_suffix("/callee")
+        .ok_or(MediaLifecycleError::InvalidBinding("media_reservation_id"))?;
+    let binding = MediaAdmissionBinding::new(
+        &input.tenant_id,
+        &session.call_id,
+        &input.cell_id,
+        &input.owner_node_id,
+        &input.owner_epoch.to_string(),
+        admission_reservation_id,
+        media_profile_id,
+    )?;
+    let lifecycle_executor: Arc<dyn MediaControlExecutor> = executor;
+    IveKitMediaLifecycle::restore_committed(
+        binding,
+        lifecycle_executor,
+        &input.from_tag,
+        &input.to_tag,
+        &input.winning_branch,
+        &session.effective_sdp,
+        session.last_sequence,
+    )
+}
+
+fn build_recovered_media_takeover_command(
+    input: &MediaRecoveryTakeoverInput,
+    call_id: &str,
+    effective_sdp: &str,
+) -> Result<MediaControlCommand, MediaLifecycleError> {
+    if !valid_identifier(&input.tenant_id)
+        || !valid_identifier(&input.cell_id)
+        || !valid_identifier(&input.owner_node_id)
+        || !valid_identifier(&input.media_reservation_id)
+        || !valid_identifier(&input.winning_branch)
+        || !valid_identifier(call_id)
+        || !valid_sip_tag(&input.from_tag)
+        || !valid_sip_tag(&input.to_tag)
+        || input.previous_owner_epoch == 0
+        || input.owner_epoch <= input.previous_owner_epoch
+    {
+        return Err(MediaLifecycleError::InvalidBinding("media_takeover"));
+    }
+    let admission_reservation_id = input
+        .media_reservation_id
+        .strip_suffix("/callee")
+        .ok_or(MediaLifecycleError::InvalidBinding("media_reservation_id"))?;
+    checked_sdp(effective_sdp)?;
+    let payload = serde_json::json!({
+        "from_tag": input.from_tag,
+        "negotiation_role": "offer",
+        "owner_takeover": true,
+        "previous_owner_epoch": input.previous_owner_epoch.to_string(),
+        "sdp": effective_sdp,
+        "to_tag": input.to_tag,
+    });
+    let payload = match payload {
+        Value::Object(payload) => payload,
+        _ => return Err(MediaLifecycleError::CommandInvalid),
+    };
+    let payload_hash = payload_hash(&payload).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+    let mut command = MediaControlCommand {
+        protocol_version: MEDIA_CONTROL_PROTOCOL_VERSION.to_string(),
+        action: MediaControlAction::Update,
+        command_id: "pending".to_string(),
+        tenant_id: input.tenant_id.clone(),
+        call_id: call_id.to_string(),
+        leg_id: "callee".to_string(),
+        cell_id: input.cell_id.clone(),
+        owner_node_id: input.owner_node_id.clone(),
+        owner_epoch: input.owner_epoch.to_string(),
+        media_reservation_id: input.media_reservation_id.clone(),
+        admission_reservation_id: admission_reservation_id.to_string(),
+        command_sequence: 1,
+        idempotency_key: format!(
+            "rustpbx/{}/{}/callee/{}/1",
+            input.cell_id, call_id, input.owner_epoch
+        ),
+        expires_at: (chrono::Utc::now() + chrono::Duration::seconds(30))
+            .to_rfc3339_opts(chrono::SecondsFormat::Millis, true),
+        payload,
+        payload_hash,
+    };
+    command.command_id =
+        command_id_for(&command).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+    command
+        .validate()
+        .map_err(|_| MediaLifecycleError::CommandInvalid)?;
+    Ok(command)
+}
