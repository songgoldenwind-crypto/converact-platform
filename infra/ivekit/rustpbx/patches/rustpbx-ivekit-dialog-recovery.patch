+pub async fn recover_dialog_pair(
+    dialog_layer: &Arc<rsipstack::dialog::dialog_layer::DialogLayer>,
+    requested_dialog_id: &str,
+) -> Result<rsipstack::dialog::DialogId, DialogShadowError> {
+    let config = dialog_shadow_runtime_config()
+        .map_err(|_| DialogShadowError::Unavailable)?
+        .ok_or(DialogShadowError::Unavailable)?;
+    let tenant_id =
+        required_env("IVEKIT_RUSTPBX_ROUTE_TENANT_ID").ok_or(DialogShadowError::InvalidBinding)?;
+    let cell_id =
+        required_env("IVEKIT_RUSTPBX_CELL_ID").ok_or(DialogShadowError::InvalidBinding)?;
+    let owner_node_id =
+        required_env("IVEKIT_RUSTPBX_OWNER_NODE_ID").ok_or(DialogShadowError::InvalidBinding)?;
+    let owner_fault_domain =
+        required_env("IVEKIT_RUSTPBX_FAULT_DOMAIN").ok_or(DialogShadowError::InvalidBinding)?;
+    let claim = config
+        .executor
+        .claim_takeover(
+            &DialogOwnerTakeoverClaimRequest {
+                profile: PROFILE_T1.to_string(),
+                tenant_id: tenant_id.clone(),
+                cell_id: cell_id.clone(),
+                dialog_id: requested_dialog_id.to_string(),
+                idempotency_key: format!(
+                    "recovery-{}",
+                    sha256(&format!(
+                        "{tenant_id}\0{cell_id}\0{requested_dialog_id}\0{owner_node_id}"
+                    ))
+                ),
+                reason: "owner_route_recovery".to_string(),
+            },
+            &owner_node_id,
+        )
+        .await?;
+    let auth_context_ref = claim
+        .shadow_records
+        .first()
+        .map(|record| record.auth_context_ref.clone())
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let payloads = open_recovery_pair(&config.recovery_codec, &claim.shadow_records)?;
+    let requested_payload = payloads
+        .iter()
+        .find(|payload| payload.dialog_id == requested_dialog_id)
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let call_session_ref = requested_payload.call_session_ref.clone();
+    let interaction_id = requested_payload.interaction_id.clone();
+    let previous_owner_epoch = claim.shadow_records[0].owner_epoch;
+    let callee = payloads
+        .iter()
+        .find(|payload| payload.leg == "callee")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let snapshots = payloads
+        .iter()
+        .map(recovery_payload_to_dialog_snapshot)
+        .collect::<Result<Vec<_>, _>>()?;
+    let requested_rsip_dialog_id = snapshots
+        .iter()
+        .find(|snapshot| {
+            stable_dialog_shadow_id(
+                &snapshot.id.call_id,
+                &snapshot.id.local_tag,
+                &snapshot.id.remote_tag,
+            ) == requested_dialog_id
+        })
+        .map(|snapshot| snapshot.id.clone())
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let mut restored_ids = Vec::with_capacity(snapshots.len());
+    let mut restored_receivers = Vec::with_capacity(snapshots.len());
+    for (payload, snapshot) in payloads.iter().zip(snapshots) {
+        if dialog_layer.get_dialog(&snapshot.id).is_some() {
+            remove_restored_dialogs(dialog_layer, &restored_ids);
+            return Err(DialogShadowError::Unavailable);
+        }
+        let snapshot_id = snapshot.id.clone();
+        let (state_sender, state_receiver) = dialog_layer.new_dialog_state_channel();
+        let restored = dialog_layer
+            .restore_from_snapshot(snapshot, state_sender)
+            .map_err(|_| DialogShadowError::Unavailable)?;
+        if !restored {
+            remove_restored_dialogs(dialog_layer, &restored_ids);
+            return Err(DialogShadowError::Unavailable);
+        }
+        restored_ids.push(snapshot_id.clone());
+        restored_receivers.push((
+            RecoveredDialogSide::from_leg(&payload.leg)?,
+            snapshot_id,
+            state_receiver,
+        ));
+    }
+    let active_records = match commit_recovered_shadow_pair(
+        config,
+        &tenant_id,
+        &cell_id,
+        &owner_node_id,
+        &owner_fault_domain,
+        claim.owner_epoch,
+        &claim.takeover_id,
+        &call_session_ref,
+        &auth_context_ref,
+        &payloads,
+    )
+    .await
+    {
+        Ok(records) => records,
+        Err(error) => {
+            remove_restored_dialogs(dialog_layer, &restored_ids);
+            return Err(error);
+        }
+    };
+    let takeover = crate::ivekit_media_lifecycle::takeover_recovered_media(
+        &crate::ivekit_media_lifecycle::MediaRecoveryTakeoverInput {
+            tenant_id: tenant_id.clone(),
+            cell_id: cell_id.clone(),
+            owner_node_id: owner_node_id.clone(),
+            previous_owner_epoch,
+            owner_epoch: claim.owner_epoch,
+            media_reservation_id: callee.media_reservation_id.clone(),
+            from_tag: payloads
+                .iter()
+                .find(|payload| payload.leg == "caller")
+                .ok_or(DialogShadowError::InvalidRecord)?
+                .remote_tag
+                .clone(),
+            to_tag: callee.remote_tag.clone(),
+            winning_branch: crate::ivekit_media_lifecycle::stable_dialog_branch_id(
+                &callee.raw_call_id,
+                &callee.local_tag,
+                &callee.remote_tag,
+            ),
+        },
+    )
+    .await;
+    let recovered_media = takeover.map_err(|error| {
+        remove_restored_dialogs(dialog_layer, &restored_ids);
+        match error {
+            crate::ivekit_media_lifecycle::MediaLifecycleError::OutcomeUnknown
+            | crate::ivekit_media_lifecycle::MediaLifecycleError::ReconcileRequired => {
+                DialogShadowError::ReconcileRequired
+            }
+            _ => DialogShadowError::Unavailable,
+        }
+    })?;
+    let consume_request = DialogOwnerTakeoverConsumeRequest {
+        tenant_id: tenant_id.clone(),
+        cell_id: cell_id.clone(),
+        call_session_ref: call_session_ref.clone(),
+        takeover_id: claim.takeover_id.clone(),
+        owner_epoch: claim.owner_epoch,
+        takeover_token: claim.takeover_token,
+    };
+    let consumed = config
+        .executor
+        .consume_takeover(&consume_request, &owner_node_id)
+        .await;
+    let authority_active = if consumed.is_ok() {
+        true
+    } else {
+        config
+            .executor
+            .check_authority(
+                &DialogOwnerAuthorityRequest {
+                    tenant_id: tenant_id.clone(),
+                    cell_id: cell_id.clone(),
+                    call_session_ref: call_session_ref.clone(),
+                    owner_epoch: claim.owner_epoch,
+                },
+                &owner_node_id,
+            )
+            .await
+            .is_ok_and(|authority| authority.status == "active")
+    };
+    if !authority_active {
+        remove_restored_dialogs(dialog_layer, &restored_ids);
+        return Err(DialogShadowError::OutcomeUnknown);
+    }
+    let reservation_id = callee
+        .media_reservation_id
+        .strip_suffix("/callee")
+        .ok_or(DialogShadowError::InvalidRecord)?
+        .to_string();
+    if crate::ivekit_owner::ensure_owner(
+        &call_session_ref,
+        crate::ivekit_owner::OwnerContract {
+            reservation_id,
+            interaction_id,
+            owner_epoch: claim.owner_epoch.to_string(),
+            availability_profile: PROFILE_T1.to_string(),
+            auth_context_ref: Some(auth_context_ref.clone()),
+        },
+    )
+    .await
+    .is_err()
+    {
+        remove_restored_dialogs(dialog_layer, &restored_ids);
+        return Err(DialogShadowError::Unavailable);
+    }
+    spawn_recovered_dialog_controller(
+        dialog_layer.clone(),
+        restored_receivers,
+        payloads,
+        recovered_media,
+        active_records,
+        RecoveredShadowPairContext {
+            tenant_id,
+            cell_id,
+            owner_node_id,
+            owner_fault_domain,
+            owner_epoch: claim.owner_epoch,
+            takeover_id: claim.takeover_id,
+            call_session_ref,
+            auth_context_ref,
+        },
+        config.executor.clone(),
+        config.recovery_codec.clone(),
+    )?;
+    Ok(requested_rsip_dialog_id)
+}
