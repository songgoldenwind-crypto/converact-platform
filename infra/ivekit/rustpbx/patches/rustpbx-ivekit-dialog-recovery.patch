+pub fn open_recovery_pair(
+    codec: &DialogRecoveryCapsuleCodec,
+    records: &[DialogShadowRecord],
+) -> Result<Vec<DialogRecoveryCapsulePayload>, DialogShadowError> {
+    if records.len() != 2 {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let mut records = records.to_vec();
+    records.sort_by(|left, right| left.dialog_id.cmp(&right.dialog_id));
+    let first = &records[0];
+    let second = &records[1];
+    if first.dialog_id == second.dialog_id
+        || first.tenant_id != second.tenant_id
+        || first.cell_id != second.cell_id
+        || first.owner_node_id != second.owner_node_id
+        || first.owner_fault_domain != second.owner_fault_domain
+        || first.owner_epoch != second.owner_epoch
+        || first.provider_session_ref != second.provider_session_ref
+        || records.iter().any(|record| {
+            record.schema_version != 2
+                || record.recovery_capsule.is_none()
+                || record.terminal
+                || !matches!(
+                    record.state,
+                    DialogShadowState::Confirmed | DialogShadowState::Updating
+                )
+                || record.remote_tag.is_none()
+                || record.media_reservation_id.is_none()
+                || record.provider_session_ref.is_none()
+        })
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let payloads = records
+        .iter()
+        .map(|record| {
+            let payload = codec
+                .open(
+                    record
+                        .recovery_capsule
+                        .as_ref()
+                        .ok_or(DialogShadowError::InvalidRecord)?,
+                    &DialogRecoveryCapsuleBinding {
+                        tenant_id: record.tenant_id.clone(),
+                        cell_id: record.cell_id.clone(),
+                        dialog_id: record.dialog_id.clone(),
+                        owner_epoch: record.owner_epoch,
+                        sequence: record.sequence,
+                    },
+                )
+                .map_err(|_| DialogShadowError::InvalidRecord)?;
+            if payload.dialog_id != record.dialog_id
+                || payload.call_session_ref
+                    != record
+                        .provider_session_ref
+                        .as_deref()
+                        .ok_or(DialogShadowError::InvalidRecord)?
+                || payload.local_tag != record.local_tag
+                || Some(payload.remote_tag.as_str()) != record.remote_tag.as_deref()
+                || payload.local_cseq != record.local_cseq
+                || payload.remote_cseq != record.remote_cseq
+                || Some(payload.media_reservation_id.as_str())
+                    != record.media_reservation_id.as_deref()
+                || payload.cdr_sequence != record.cdr_sequence
+                || sha256(&payload.raw_call_id) != record.call_id_hash
+            {
+                return Err(DialogShadowError::InvalidRecord);
+            }
+            Ok(payload)
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let caller = payloads
+        .iter()
+        .find(|payload| payload.leg == "caller")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let callee = payloads
+        .iter()
+        .find(|payload| payload.leg == "callee")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    if caller.dialog_role != "uas"
+        || callee.dialog_role != "uac"
+        || caller.peer_dialog_id != callee.dialog_id
+        || callee.peer_dialog_id != caller.dialog_id
+        || caller.call_session_ref != callee.call_session_ref
+        || caller.interaction_id != callee.interaction_id
+        || caller.media_reservation_id != callee.media_reservation_id
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    Ok(payloads)
+}
