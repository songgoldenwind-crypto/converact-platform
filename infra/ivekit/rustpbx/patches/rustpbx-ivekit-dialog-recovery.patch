+fn dialog_shadow_http_client(
+    address: std::net::SocketAddr,
+    token_path: &PathBuf,
+    max_response_bytes: usize,
+) -> DialogShadowHttpClient {
+    DialogShadowHttpClient::new(DialogShadowHttpClientConfig {
+        endpoint: format!("http://{address}").parse().unwrap(),
+        service_token_file: token_path.clone(),
+        tls_identity_file: None,
+        tls_ca_file: None,
+        production: false,
+        max_inflight: 8,
+        request_timeout: Duration::from_millis(500),
+        max_response_bytes,
+        owner_identity: None,
+        owner_heartbeat_interval: Duration::from_secs(1),
+    })
+    .unwrap()
+}
