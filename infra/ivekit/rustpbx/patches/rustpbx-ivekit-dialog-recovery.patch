+async fn read_json_request(stream: &mut tokio::net::TcpStream) -> (String, serde_json::Value) {
+    let mut received = Vec::new();
+    let mut buffer = [0_u8; 4096];
+    loop {
+        let read = stream.read(&mut buffer).await.unwrap();
+        assert!(read > 0);
+        received.extend_from_slice(&buffer[..read]);
+        let Some(header_end) = received.windows(4).position(|part| part == b"\r\n\r\n") else {
+            continue;
+        };
+        let headers = String::from_utf8_lossy(&received[..header_end]);
+        let content_length = headers
+            .lines()
+            .find_map(|line| {
+                line.to_ascii_lowercase()
+                    .strip_prefix("content-length:")
+                    .map(str::trim)
+                    .and_then(|value| value.parse::<usize>().ok())
+            })
+            .unwrap();
+        if received.len() < header_end + 4 + content_length {
+            continue;
+        }
+        let path = headers
+            .lines()
+            .next()
+            .unwrap()
+            .split_whitespace()
+            .nth(1)
+            .unwrap()
+            .to_string();
+        let body =
+            serde_json::from_slice(&received[header_end + 4..header_end + 4 + content_length])
+                .unwrap();
+        return (path, body);
+    }
+}
+
+async fn write_json_response(stream: &mut tokio::net::TcpStream, value: &serde_json::Value) {
+    let body = serde_json::to_vec(value).unwrap();
+    let response = format!(
+        "HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n",
+        body.len()
+    );
+    stream.write_all(response.as_bytes()).await.unwrap();
+    stream.write_all(&body).await.unwrap();
+    stream.shutdown().await.unwrap();
+}
