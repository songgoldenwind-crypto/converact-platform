+fn canonical_json_value(value: &serde_json::Value) -> Result<String, DialogShadowError> {
+    match value {
+        serde_json::Value::Null => Ok("null".to_string()),
+        serde_json::Value::Bool(value) => Ok(value.to_string()),
+        serde_json::Value::Number(value) => Ok(value.to_string()),
+        serde_json::Value::String(value) => {
+            serde_json::to_string(value).map_err(|_| DialogShadowError::InvalidRecord)
+        }
+        serde_json::Value::Array(values) => {
+            let values = values
+                .iter()
+                .map(canonical_json_value)
+                .collect::<Result<Vec<_>, _>>()?;
+            Ok(format!("[{}]", values.join(",")))
+        }
+        serde_json::Value::Object(values) => {
+            let mut keys = values.keys().collect::<Vec<_>>();
+            keys.sort();
+            let fields = keys
+                .into_iter()
+                .map(|key| {
+                    Ok(format!(
+                        "{}:{}",
+                        serde_json::to_string(key).map_err(|_| DialogShadowError::InvalidRecord)?,
+                        canonical_json_value(&values[key])?
+                    ))
+                })
+                .collect::<Result<Vec<_>, DialogShadowError>>()?;
+            Ok(format!("{{{}}}", fields.join(",")))
+        }
+    }
