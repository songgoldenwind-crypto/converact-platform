+#[test]
+fn recovery_key_file_is_canonical_bounded_and_permission_checked_in_production() {
+    let directory = std::env::temp_dir().join(format!(
+        "ivekit-dialog-recovery-key-{}-{}",
+        std::process::id(),
+        rand::random::<u64>()
+    ));
+    std::fs::create_dir(&directory).unwrap();
+    let path = directory.join("recovery.key");
+    std::fs::write(&path, "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU=\n").unwrap();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+    }
+    DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &path, true).unwrap();
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        use std::os::unix::fs::symlink;
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o440)).unwrap();
+        DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &path, true).unwrap();
+
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o460)).unwrap();
+        assert_eq!(
+            DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &path, true,)
+                .unwrap_err(),
+            DialogShadowError::InvalidBinding
+        );
+
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o404)).unwrap();
+        assert_eq!(
+            DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &path, true,)
+                .unwrap_err(),
+            DialogShadowError::InvalidBinding
+        );
+
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o4440)).unwrap();
+        assert_eq!(
+            DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &path, true,)
+                .unwrap_err(),
+            DialogShadowError::InvalidBinding
+        );
+
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o440)).unwrap();
+        let projected = directory.join("projected.key");
+        symlink("recovery.key", &projected).unwrap();
+        DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &projected, true).unwrap();
+
+        let escaped_target = std::env::temp_dir().join(format!(
+            "ivekit-dialog-recovery-escaped-{}-{}",
+            std::process::id(),
+            rand::random::<u64>()
+        ));
+        std::fs::write(
+            &escaped_target,
+            "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVU=\n",
+        )
+        .unwrap();
+        std::fs::set_permissions(&escaped_target, std::fs::Permissions::from_mode(0o400)).unwrap();
+        let escaped = directory.join("escaped.key");
+        symlink(&escaped_target, &escaped).unwrap();
+        assert_eq!(
+            DialogRecoveryCapsuleKey::from_base64_file("recovery-2026-07", &escaped, true,)
+                .unwrap_err(),
+            DialogShadowError::InvalidBinding
+        );
+        std::fs::remove_file(escaped).unwrap();
+        std::fs::remove_file(escaped_target).unwrap();
+        std::fs::remove_file(projected).unwrap();
+    }
+    std::fs::remove_file(path).unwrap();
+    std::fs::remove_dir(directory).unwrap();
+}
