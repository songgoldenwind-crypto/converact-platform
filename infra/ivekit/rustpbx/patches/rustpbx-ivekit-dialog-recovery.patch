+
+fn secret_file_metadata(
+    path: &std::path::Path,
+    maximum_bytes: u64,
+) -> Result<std::fs::Metadata, DialogShadowError> {
+    let link_metadata =
+        std::fs::symlink_metadata(path).map_err(|_| DialogShadowError::InvalidBinding)?;
+    let metadata = std::fs::metadata(path).map_err(|_| DialogShadowError::InvalidBinding)?;
+    if !metadata.file_type().is_file() || metadata.len() > maximum_bytes {
+        return Err(DialogShadowError::InvalidBinding);
+    }
+    if link_metadata.file_type().is_symlink() {
+        let parent = path.parent().ok_or(DialogShadowError::InvalidBinding)?;
+        let canonical_parent =
+            std::fs::canonicalize(parent).map_err(|_| DialogShadowError::InvalidBinding)?;
+        let canonical_target =
+            std::fs::canonicalize(path).map_err(|_| DialogShadowError::InvalidBinding)?;
+        if !canonical_target.starts_with(canonical_parent) {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+    } else if !link_metadata.file_type().is_file() {
+        return Err(DialogShadowError::InvalidBinding);
+    }
+    Ok(metadata)
+}
 
