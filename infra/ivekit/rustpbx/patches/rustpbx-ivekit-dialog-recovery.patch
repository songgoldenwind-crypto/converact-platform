+            .post_json_raw::<_, DialogOwnerHeartbeatResponse>(
+                "/internal/ivekit/v1/dialog-owner/heartbeat",
+                &DialogOwnerHeartbeatRequest::default(),
+            )
+            .await?;
+        if response.cell_id != identity.cell_id
+            || response.node_id != identity.node_id
+            || response.fault_domain != identity.fault_domain
+            || !response.spiffe_id.starts_with("spiffe://")
+            || response.revision == 0
+        {
+            return Err(DialogShadowError::Unavailable);
+        }
+        let heartbeat = chrono::DateTime::parse_from_rfc3339(&response.heartbeat_at)
+            .map_err(|_| DialogShadowError::OutcomeUnknown)?;
+        let expiry = chrono::DateTime::parse_from_rfc3339(&response.lease_expires_at)
+            .map_err(|_| DialogShadowError::OutcomeUnknown)?;
+        let ttl_ms = (expiry - heartbeat).num_milliseconds();
+        if ttl_ms <= 0 || ttl_ms > 30_000 {
+            return Err(DialogShadowError::OutcomeUnknown);
+        }
+        let fresh_for_ms = ttl_ms.saturating_mul(2).saturating_div(3).max(1);
+        self.owner_lease_fresh_until_ms.store(
+            chrono::Utc::now()
+                .timestamp_millis()
+                .saturating_add(fresh_for_ms),
+            Ordering::Release,
+        );
+        Ok(())
+    }
