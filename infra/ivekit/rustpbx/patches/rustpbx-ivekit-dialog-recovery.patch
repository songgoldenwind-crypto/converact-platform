+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DialogRecoveryCapsuleKey {
+    key_id: String,
+    key: [u8; 32],
+}
+
+impl DialogRecoveryCapsuleKey {
+    pub fn new(key_id: &str, key: &[u8]) -> Result<Self, DialogShadowError> {
+        if !valid_identifier(key_id) || key.len() != 32 {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+        let mut checked = [0_u8; 32];
+        checked.copy_from_slice(key);
+        Ok(Self {
+            key_id: key_id.to_string(),
+            key: checked,
+        })
+    }
+
+    pub fn from_base64_file(
+        key_id: &str,
+        path: &std::path::Path,
+        production: bool,
+    ) -> Result<Self, DialogShadowError> {
+        let metadata = secret_file_metadata(path, 256)?;
+        if production {
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                if !production_secret_mode_is_safe(metadata.permissions().mode()) {
+                    return Err(DialogShadowError::InvalidBinding);
+                }
+            }
+        }
+        let raw = std::fs::read_to_string(path).map_err(|_| DialogShadowError::InvalidBinding)?;
+        let encoded = raw.trim_end_matches(['\r', '\n']);
+        if encoded.is_empty() || encoded.trim() != encoded {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+        let decoded = STANDARD
+            .decode(encoded)
+            .map_err(|_| DialogShadowError::InvalidBinding)?;
+        if STANDARD.encode(&decoded) != encoded {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+        Self::new(key_id, &decoded)
+    }
+}
