+pub fn recovery_payload_from_dialog_snapshots(
+    call_session_ref: &str,
+    interaction_id: &str,
+    media_reservation_id: &str,
+    cdr_sequence: u64,
+    snapshot: &rsipstack::dialog::dialog::DialogSnapshot,
+    peer: &rsipstack::dialog::dialog::DialogSnapshot,
+) -> Result<DialogRecoveryCapsulePayload, DialogShadowError> {
+    use rsipstack::dialog::dialog::DialogSnapshotState;
+    use rsipstack::transaction::key::TransactionRole;
+
+    if !valid_identifier(call_session_ref)
+        || !valid_identifier(interaction_id)
+        || !valid_media_reservation_id(media_reservation_id)
+        || snapshot.state != DialogSnapshotState::Confirmed
+        || peer.state != DialogSnapshotState::Confirmed
+        || snapshot.role == peer.role
+        || snapshot.id.remote_tag.is_empty()
+        || peer.id.remote_tag.is_empty()
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    let dialog_id = stable_dialog_shadow_id(
+        &snapshot.id.call_id,
+        &snapshot.id.local_tag,
+        &snapshot.id.remote_tag,
+    );
+    let peer_dialog_id =
+        stable_dialog_shadow_id(&peer.id.call_id, &peer.id.local_tag, &peer.id.remote_tag);
+    let (leg, dialog_role) = match snapshot.role {
+        TransactionRole::Server => ("caller", "uas"),
+        TransactionRole::Client => ("callee", "uac"),
+    };
+    let payload = DialogRecoveryCapsulePayload {
+        schema_version: 1,
+        call_session_ref: call_session_ref.to_string(),
+        interaction_id: interaction_id.to_string(),
+        dialog_id,
+        peer_dialog_id,
+        leg: leg.to_string(),
+        dialog_role: dialog_role.to_string(),
+        raw_call_id: snapshot.id.call_id.clone(),
+        local_tag: snapshot.id.local_tag.clone(),
+        remote_tag: snapshot.id.remote_tag.clone(),
+        from_uri: snapshot.from.uri.to_string(),
+        to_uri: snapshot.to.uri.to_string(),
+        local_contact_uri: snapshot
+            .local_contact
+            .as_ref()
+            .ok_or(DialogShadowError::InvalidRecord)?
+            .to_string(),
+        remote_uri: snapshot.remote_uri.to_string(),
+        remote_contact_uri: snapshot
+            .remote_contact
+            .as_ref()
+            .map(|contact| contact.value().to_string()),
+        route_set: snapshot
+            .route_set
+            .iter()
+            .map(|route| route.value().to_string())
+            .collect(),
+        local_cseq: snapshot.local_cseq,
+        remote_cseq: snapshot.remote_cseq,
+        supports_100rel: snapshot.supports_100rel,
+        media_reservation_id: media_reservation_id.to_string(),
+        cdr_sequence,
+    };
+    validate_recovery_payload(&payload)?;
+    Ok(payload)
+}
+
+pub fn recovery_payload_to_dialog_snapshot(
+    value: &DialogRecoveryCapsulePayload,
+) -> Result<rsipstack::dialog::dialog::DialogSnapshot, DialogShadowError> {
+    use rsipstack::dialog::dialog::{DialogSnapshot, DialogSnapshotState};
+    use rsipstack::sip::headers::{typed, untyped};
+    use rsipstack::sip::uri::Tag;
+    use rsipstack::transaction::key::TransactionRole;
+
+    validate_recovery_payload(value)?;
+    let role = match value.dialog_role.as_str() {
+        "uac" => TransactionRole::Client,
+        "uas" => TransactionRole::Server,
+        _ => return Err(DialogShadowError::InvalidRecord),
+    };
+    let parse_uri = |raw: &str| {
+        rsipstack::sip::Uri::try_from(raw).map_err(|_| DialogShadowError::InvalidRecord)
+    };
+    let from_tag = if role == TransactionRole::Client {
+        &value.local_tag
+    } else {
+        &value.remote_tag
+    };
+    let to_tag = if role == TransactionRole::Client {
+        &value.remote_tag
+    } else {
+        &value.local_tag
+    };
+    let from = typed::From::from(parse_uri(&value.from_uri)?).with_tag(Tag::from(from_tag.clone()));
+    let to = typed::To::from(parse_uri(&value.to_uri)?).with_tag(Tag::from(to_tag.clone()));
+    let route_set = value
+        .route_set
+        .iter()
+        .map(|route| untyped::Route::new(route.clone()))
+        .collect();
+    Ok(DialogSnapshot {
+        state: DialogSnapshotState::Confirmed,
+        role,
+        id: rsipstack::dialog::DialogId {
+            call_id: value.raw_call_id.clone(),
+            local_tag: value.local_tag.clone(),
+            remote_tag: value.remote_tag.clone(),
+        },
+        from,
+        to,
+        local_cseq: value.local_cseq,
+        remote_cseq: value.remote_cseq,
+        local_contact: Some(parse_uri(&value.local_contact_uri)?),
