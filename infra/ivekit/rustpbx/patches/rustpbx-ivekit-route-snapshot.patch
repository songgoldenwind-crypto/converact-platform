+#[derive(Clone)]
+struct HttpRouteSnapshotConfig {
+    path: String,
+    encoded_hmac_key: String,
+    encoded_lookup_hmac_root: String,
+    tenant_id: String,
+    profile_id: String,
+    refresh_ms: u64,
+}
+
+fn route_snapshot_config_from_env() -> Option<HttpRouteSnapshotConfig> {
+    let path = std::env::var("IVEKIT_RUSTPBX_ROUTE_SNAPSHOT_FILE")
+        .ok()
+        .filter(|value| !value.trim().is_empty())?;
+    let encoded_hmac_key =
+        std::env::var("IVEKIT_RUSTPBX_ROUTE_SNAPSHOT_HMAC_KEY").unwrap_or_default();
+    let encoded_lookup_hmac_root =
+        std::env::var("IVEKIT_RUSTPBX_ROUTE_LOOKUP_HMAC_ROOT_KEY").unwrap_or_default();
+    let tenant_id = std::env::var("IVEKIT_RUSTPBX_ROUTE_TENANT_ID").unwrap_or_default();
+    let profile_id = std::env::var("IVEKIT_RUSTPBX_ROUTE_PROFILE_ID").unwrap_or_default();
+    let refresh_ms = std::env::var("IVEKIT_RUSTPBX_ROUTE_SNAPSHOT_REFRESH_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(1000)
+        .clamp(100, 60_000);
+    Some(HttpRouteSnapshotConfig {
+        path,
+        encoded_hmac_key,
+        encoded_lookup_hmac_root,
+        tenant_id,
+        profile_id,
+        refresh_ms,
+    })
+}
+
+#[derive(Deserialize)]
+struct HttpRouteSnapshotBody {
+    schema_version: String,
+    sequence: u64,
+    source_revision: u64,
+    tenant_id: String,
+    profile_id: String,
+    generated_at: String,
+    expires_at: String,
+    routes: HashMap<String, HttpResponsePayload>,
+    #[serde(skip)]
+    lookup_hmac_key: Vec<u8>,
+}
+
+fn refresh_snapshot(
+    config: &HttpRouteSnapshotConfig,
+    target: &Arc<ArcSwapOption<HttpRouteSnapshotBody>>,
+    observation: &mut Option<String>,
+) {
+    let signature = match snapshot_wire_signature(&config.path) {
+        Ok(signature) => signature,
+        Err(error) => {
+            let marker = format!("io:{:?}", error.kind());
+            if observation.as_ref() != Some(&marker) {
+                if error.kind() == std::io::ErrorKind::NotFound {
+                    trace!(path = %config.path, "route snapshot is not published yet");
+                } else {
+                    warn!(path = %config.path, "route snapshot header read failed: {}", error);
+                }
+                *observation = Some(marker);
+            }
+            return;
+        }
+    };
+    let marker = format!("signature:{signature}");
+    if observation.as_ref() == Some(&marker) {
+        return;
+    }
+    *observation = Some(marker);
+    match load_snapshot(config) {
+        Ok(snapshot) => {
+            let current_sequence = target
+                .load_full()
+                .map(|current| current.sequence)
+                .unwrap_or_default();
+            if snapshot.sequence > current_sequence {
+                trace!(
+                    path = %config.path,
+                    sequence = snapshot.sequence,
+                    source_revision = snapshot.source_revision,
+                    generated_at = %snapshot.generated_at,
+                    routes = snapshot.routes.len(),
+                    "loaded route snapshot"
+                );
+                target.store(Some(Arc::new(snapshot)));
+            }
+        }
+        Err(error) => {
+            warn!(path = %config.path, "route snapshot refresh failed: {}", error);
+        }
+    }
+}
+
+fn snapshot_wire_signature(path: &str) -> std::io::Result<String> {
+    let mut file = std::fs::File::open(path)?;
+    let mut bytes = [0_u8; 128];
+    let count = file.read(&mut bytes)?;
+    let newline = bytes[..count]
+        .iter()
+        .position(|byte| *byte == b'\n')
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "route snapshot wire header is invalid",
+            )
+        })?;
+    let header = std::str::from_utf8(&bytes[..newline])
+        .map_err(|error| std::io::Error::new(std::io::ErrorKind::InvalidData, error))?;
+    let signature = header
+        .strip_prefix("ivekit-route-snapshot-v1.")
+        .filter(|value| value.len() == 43)
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "route snapshot wire header is invalid",
+            )
+        })?;
+    Ok(signature.to_string())
+}
+
+fn load_snapshot(config: &HttpRouteSnapshotConfig) -> Result<HttpRouteSnapshotBody> {
+    let key = STANDARD
+        .decode(&config.encoded_hmac_key)
+        .map_err(|_| anyhow!("route snapshot HMAC key is invalid"))?;
+    if key.len() != 32 {
+        return Err(anyhow!("route snapshot HMAC key must decode to 32 bytes"));
+    }
+    let lookup_hmac_root = STANDARD
+        .decode(&config.encoded_lookup_hmac_root)
+        .map_err(|_| anyhow!("route snapshot lookup HMAC root key is invalid"))?;
+    if lookup_hmac_root.len() != 32 {
+        return Err(anyhow!(
+            "route snapshot lookup HMAC root key must decode to 32 bytes"
+        ));
+    }
+    if !valid_snapshot_identifier(&config.tenant_id)
+        || !valid_snapshot_identifier(&config.profile_id)
+    {
+        return Err(anyhow!("route snapshot identity is invalid"));
+    }
+    let bytes = std::fs::read(&config.path)?;
+    if bytes.len() > 64 * 1024 * 1024 {
+        return Err(anyhow!("route snapshot exceeds 64 MiB"));
+    }
+    let newline = bytes
+        .iter()
+        .position(|byte| *byte == b'\n')
+        .ok_or_else(|| anyhow!("route snapshot wire header is invalid"))?;
+    let header = std::str::from_utf8(&bytes[..newline])?;
+    let signature = header
+        .strip_prefix("ivekit-route-snapshot-v1.")
+        .filter(|value| value.len() == 43)
+        .ok_or_else(|| anyhow!("route snapshot wire header is invalid"))?;
+    let body = bytes
+        .get(newline + 1..)
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| anyhow!("route snapshot body is missing"))?;
+    let signature = URL_SAFE_NO_PAD
+        .decode(signature)
+        .map_err(|_| anyhow!("route snapshot signature is invalid"))?;
+    let mut mac = Hmac::<Sha256>::new_from_slice(&key)
+        .map_err(|_| anyhow!("route snapshot HMAC key is invalid"))?;
+    mac.update(body);
+    mac.verify_slice(&signature)
+        .map_err(|_| anyhow!("route snapshot signature mismatch"))?;
+    let mut snapshot: HttpRouteSnapshotBody = serde_json::from_slice(body)?;
+    if snapshot.schema_version != "1.0.0" || snapshot.sequence == 0 || snapshot.source_revision == 0
+    {
+        return Err(anyhow!("route snapshot schema or sequence is invalid"));
+    }
+    if snapshot.tenant_id != config.tenant_id || snapshot.profile_id != config.profile_id {
+        return Err(anyhow!("route snapshot identity mismatch"));
+    }
+    let generated_at = DateTime::parse_from_rfc3339(&snapshot.generated_at)?;
+    let expires_at = DateTime::parse_from_rfc3339(&snapshot.expires_at)?;
+    if expires_at <= generated_at || expires_at.with_timezone(&Utc) <= Utc::now() {
+        return Err(anyhow!("route snapshot is expired"));
+    }
+    if snapshot.routes.len() > 100_000
+        || snapshot
+            .routes
+            .keys()
+            .any(|key| !is_voice_address_hmac(key))
+    {
+        return Err(anyhow!("route snapshot routes are invalid"));
+    }
+    snapshot.lookup_hmac_key =
+        derive_voice_address_lookup_key(&lookup_hmac_root, &snapshot.tenant_id)?;
+    Ok(snapshot)
+}
+
+fn derive_voice_address_lookup_key(root: &[u8], tenant_id: &str) -> Result<Vec<u8>> {
+    if root.len() != 32 || !valid_snapshot_identifier(tenant_id) {
+        return Err(anyhow!("voice address lookup key input is invalid"));
+    }
+    let mut extract = Hmac::<Sha256>::new_from_slice(b"ivekit-voice-address-v1")
+        .map_err(|_| anyhow!("voice address HKDF salt is invalid"))?;
+    extract.update(root);
+    let prk = extract.finalize().into_bytes();
+    let mut expand = Hmac::<Sha256>::new_from_slice(&prk)
+        .map_err(|_| anyhow!("voice address HKDF extract is invalid"))?;
+    expand.update(format!("hmac:{tenant_id}").as_bytes());
+    expand.update(&[1]);
+    Ok(expand.finalize().into_bytes().to_vec())
+}
+
+fn voice_address_lookup_hmac(lookup_key: &[u8], normalized: &str) -> Result<String> {
+    if lookup_key.len() != 32 || !is_e164(normalized) {
+        return Err(anyhow!("voice address lookup input is invalid"));
+    }
+    let mut mac = Hmac::<Sha256>::new_from_slice(lookup_key)
+        .map_err(|_| anyhow!("voice address lookup key is invalid"))?;
+    mac.update(b"e164\0");
+    mac.update(normalized.as_bytes());
+    Ok(lower_hex(&mac.finalize().into_bytes()))
+}
+
+fn lower_hex(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut result = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        result.push(HEX[(byte >> 4) as usize] as char);
+        result.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    result
+}
+
+fn is_voice_address_hmac(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn valid_snapshot_identifier(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 256 && !value.bytes().any(|byte| byte.is_ascii_control())
+}
+
+fn destination_e164(value: &str) -> Option<String> {
+    let trimmed = value.trim();
+    let candidate = trimmed
+        .strip_prefix("sip:")
+        .or_else(|| trimmed.strip_prefix("sips:"))
+        .unwrap_or(trimmed);
+    let user = candidate
+        .split(['@', ';', '>'])
+        .next()?
+        .trim_start_matches('<');
+    is_e164(user).then(|| user.to_string())
+}
+
+fn is_e164(value: &str) -> bool {
+    let digits = value.strip_prefix('+').unwrap_or_default();
+    (7..=15).contains(&digits.len())
+        && !digits.starts_with('0')
+        && digits.bytes().all(|value| value.is_ascii_digit())
+}
