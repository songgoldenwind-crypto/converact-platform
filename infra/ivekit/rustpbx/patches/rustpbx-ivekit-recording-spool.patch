+++ b/src/ivekit_recording.rs
@@ -0,0 +1,589 @@
+use anyhow::{anyhow, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use crate::ivekit_owner::OwnerContract;
+
+const DEFAULT_SEGMENT_SECONDS: u64 = 60;
+const DEFAULT_SEGMENT_BYTES: u64 = 64 * 1024 * 1024;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RecordingSpoolConfig {
+    pub root: PathBuf,
+    pub recording_id: String,
+    pub interaction_id: String,
+    pub reservation_id: String,
+    pub owner_epoch: String,
+    pub region_id: String,
+    pub zone_id: String,
+    pub cell_id: String,
+    pub recorder_node_id: String,
+    pub segment_duration_secs: u64,
+    pub segment_max_bytes: u64,
+}
+
+impl RecordingSpoolConfig {
+    pub fn from_env(contract: &OwnerContract) -> Result<Option<Self>> {
+        if !env_enabled("IVEKIT_RUSTPBX_RECORDING_SPOOL_ENABLED")? {
+            return Ok(None);
+        }
+        let root = PathBuf::from(required_env("IVEKIT_RUSTPBX_RECORDING_SPOOL_DIR")?);
+        if !root.is_absolute() {
+            return Err(anyhow!("recording spool directory must be absolute"));
+        }
+        let region_id = required_identifier_env("IVEKIT_REGION_ID")?;
+        let zone_id = required_identifier_env("IVEKIT_ZONE_ID")?;
+        let cell_id = required_identifier_env("IVEKIT_RUSTPBX_CELL_ID")?;
+        let recorder_node_id = required_identifier_env("IVEKIT_RUSTPBX_OWNER_NODE_ID")?;
+        let segment_duration_secs = env_u64(
+            "IVEKIT_RUSTPBX_RECORDING_SEGMENT_SECONDS",
+            DEFAULT_SEGMENT_SECONDS,
+            5,
+            600,
+        )?;
+        let segment_max_bytes = env_u64(
+            "IVEKIT_RUSTPBX_RECORDING_SEGMENT_MAX_BYTES",
+            DEFAULT_SEGMENT_BYTES,
+            1024 * 1024,
+            1024 * 1024 * 1024,
+        )?;
+        let recording_id = format!(
+            "vrec_{}",
+            hex_lower(Sha256::digest(
+                format!(
+                    "{}\0{}\0{}",
+                    contract.interaction_id, contract.reservation_id, contract.owner_epoch
+                )
+                .as_bytes()
+            ))
+        );
+        Ok(Some(Self {
+            root,
+            recording_id,
+            interaction_id: valid_identifier(&contract.interaction_id)?,
+            reservation_id: valid_identifier(&contract.reservation_id)?,
+            owner_epoch: valid_owner_epoch(&contract.owner_epoch)?,
+            region_id,
+            zone_id,
+            cell_id,
+            recorder_node_id,
+            segment_duration_secs,
+            segment_max_bytes,
+        }))
+    }
+
+    pub fn recording_directory(&self) -> PathBuf {
+        self.root.join(&self.recording_id)
+    }
+
+    pub fn first_segment_path(&self) -> PathBuf {
+        self.segment_final_path(1)
+    }
+
+    fn segment_partial_path(&self, sequence: u64) -> PathBuf {
+        self.recording_directory()
+            .join(format!("segment-{sequence:06}.wav.partial"))
+    }
+
+    fn segment_final_path(&self, sequence: u64) -> PathBuf {
+        self.recording_directory()
+            .join(format!("segment-{sequence:06}.wav"))
+    }
+
+    fn segment_manifest_path(&self, sequence: u64) -> PathBuf {
+        self.recording_directory()
+            .join(format!("segment-{sequence:06}.json"))
+    }
+
+    fn completion_path(&self) -> PathBuf {
+        self.recording_directory().join("recording-completed.json")
+    }
+}
+
+pub struct RecordingSpoolState {
+    config: RecordingSpoolConfig,
+    sequence: u64,
+    event_sequence: u64,
+    segment_started_at: SystemTime,
+    segment_started: Instant,
+    payload_hasher: Sha256,
+    current_closed: bool,
+    last_segment_ended_at: Option<SystemTime>,
+    finalized: bool,
+}
+
+impl RecordingSpoolState {
+    pub fn new(config: RecordingSpoolConfig) -> Result<Self> {
+        let directory = config.recording_directory();
+        std::fs::create_dir_all(&directory)?;
+        sync_directory(&directory)?;
+        Ok(Self {
+            config,
+            sequence: 1,
+            event_sequence: 0,
+            segment_started_at: SystemTime::now(),
+            segment_started: Instant::now(),
+            payload_hasher: Sha256::new(),
+            current_closed: false,
+            last_segment_ended_at: None,
+            finalized: false,
+        })
+    }
+
+    pub fn config(&self) -> &RecordingSpoolConfig {
+        &self.config
+    }
+
+    pub fn current_partial_path(&self) -> PathBuf {
+        self.config.segment_partial_path(self.sequence)
+    }
+
+    pub fn current_final_path(&self) -> PathBuf {
+        self.config.segment_final_path(self.sequence)
+    }
+
+    pub fn observe_payload(&mut self, bytes: &[u8]) {
+        self.payload_hasher.update(bytes);
+    }
+
+    pub fn should_rotate(&self, payload_bytes: u64) -> bool {
+        !self.finalized
+            && (payload_bytes >= self.config.segment_max_bytes
+                || self.segment_started.elapsed()
+                    >= Duration::from_secs(self.config.segment_duration_secs))
+    }
+
+    pub fn close_current(
+        &mut self,
+        payload_bytes: u64,
+        written_samples: u64,
+        sample_rate_hz: u32,
+        channels: u16,
+        codec: &str,
+    ) -> Result<PathBuf> {
+        if self.finalized || self.current_closed {
+            return Ok(self.current_final_path());
+        }
+        if payload_bytes == 0 || written_samples == 0 {
+            return Err(anyhow!(
+                "recording segment cannot be closed without encoded media"
+            ));
+        }
+        let partial_path = self.current_partial_path();
+        let final_path = self.current_final_path();
+        File::open(&partial_path)?.sync_all()?;
+        std::fs::rename(&partial_path, &final_path)?;
+        sync_directory(&self.config.recording_directory())?;
+        let size_bytes = std::fs::metadata(&final_path)?.len();
+        let payload_sha256 = hex_lower(self.payload_hasher.finalize_reset());
+        let ended_at = SystemTime::now();
+        let segment_id = segment_id(&self.config.recording_id, self.sequence);
+        let manifest = SegmentManifest {
+            schema_version: 1,
+            recording_id: &self.config.recording_id,
+            segment_id: &segment_id,
+            interaction_id: &self.config.interaction_id,
+            reservation_id: &self.config.reservation_id,
+            owner_epoch: &self.config.owner_epoch,
+            region_id: &self.config.region_id,
+            zone_id: &self.config.zone_id,
+            cell_id: &self.config.cell_id,
+            recorder_node_id: &self.config.recorder_node_id,
+            sequence: self.sequence,
+            track_id: "mixed",
+            payload_filename: final_path
+                .file_name()
+                .and_then(|value| value.to_str())
+                .ok_or_else(|| anyhow!("recording segment filename is invalid"))?,
+            container: "wav",
+            codec,
+            channels,
+            sample_rate_hz,
+            size_bytes,
+            encoded_payload_bytes: payload_bytes,
+            encoded_payload_sha256: &payload_sha256,
+            checksum_scope: "encoded_payload",
+            written_samples,
+            started_at: unix_millis(self.segment_started_at)?,
+            ended_at: unix_millis(ended_at)?,
+        };
+        let serialized = serde_json::to_vec(&manifest)?;
+        write_atomic(
+            &self.config.segment_manifest_path(self.sequence),
+            &serialized,
+        )?;
+        append_durable(
+            &self.config.recording_directory().join("segments.ndjson"),
+            &serialized,
+        )?;
+        self.current_closed = true;
+        self.last_segment_ended_at = Some(ended_at);
+        Ok(final_path)
+    }
+
+    pub fn advance(&mut self) {
+        self.sequence += 1;
+        self.segment_started_at = SystemTime::now();
+        self.segment_started = Instant::now();
+        self.current_closed = false;
+    }
+
+    pub fn discard_empty_current(&mut self) -> Result<bool> {
+        if self.finalized || self.current_closed {
+            return Ok(false);
+        }
+        if self.sequence <= 1 || self.last_segment_ended_at.is_none() {
+            return Ok(false);
+        }
+        let partial_path = self.current_partial_path();
+        match std::fs::remove_file(&partial_path) {
+            Ok(()) => sync_directory(&self.config.recording_directory())?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+        self.sequence -= 1;
+        self.current_closed = true;
+        self.payload_hasher = Sha256::new();
+        Ok(true)
+    }
+
+    pub fn finalize(&mut self) -> Result<()> {
+        if self.finalized {
+            return Ok(());
+        }
+        if !self.current_closed {
+            return Err(anyhow!(
+                "recording segment must be closed before completion"
+            ));
+        }
+        let completion = RecordingCompletion {
+            schema_version: 1,
+            recording_id: &self.config.recording_id,
+            interaction_id: &self.config.interaction_id,
+            reservation_id: &self.config.reservation_id,
+            owner_epoch: &self.config.owner_epoch,
+            region_id: &self.config.region_id,
+            zone_id: &self.config.zone_id,
+            cell_id: &self.config.cell_id,
+            recorder_node_id: &self.config.recorder_node_id,
+            segment_count: self.sequence,
+            last_segment_sequence: self.sequence,
+            ended_at: unix_millis(
+                self.last_segment_ended_at
+                    .ok_or_else(|| anyhow!("recording completion time is missing"))?,
+            )?,
+        };
+        write_atomic(
+            &self.config.completion_path(),
+            &serde_json::to_vec(&completion)?,
+        )?;
+        self.finalized = true;
+        Ok(())
+    }
+
+    pub fn is_finalized(&self) -> bool {
+        self.finalized
+    }
+
+    pub fn record_control_event(&mut self, event_type: &'static str) -> Result<()> {
+        self.record_event(event_type, None)
+    }
+
+    pub fn record_sample_dropped(&mut self, dropped_samples: u64) -> Result<()> {
+        if dropped_samples == 0 {
+            return Ok(());
+        }
+        self.record_event("sample_dropped", Some(dropped_samples))
+    }
+
+    fn record_event(
+        &mut self,
+        event_type: &'static str,
+        dropped_samples: Option<u64>,
+    ) -> Result<()> {
+        if self.finalized {
+            return Ok(());
+        }
+        self.event_sequence += 1;
+        let segment_id = segment_id(&self.config.recording_id, self.sequence);
+        let event = SegmentEvent {
+            schema_version: 1,
+            recording_id: &self.config.recording_id,
+            segment_id: &segment_id,
+            interaction_id: &self.config.interaction_id,
+            reservation_id: &self.config.reservation_id,
+            owner_epoch: &self.config.owner_epoch,
+            event_sequence: self.event_sequence,
+            event_type,
+            dropped_samples,
+            occurred_at: unix_millis(SystemTime::now())?,
+        };
+        let serialized = serde_json::to_vec(&event)?;
+        let path = self
+            .config
+            .recording_directory()
+            .join(format!("event-{:06}.json", self.event_sequence));
+        write_atomic(&path, &serialized)?;
+        append_durable(
+            &self.config.recording_directory().join("events.ndjson"),
+            &serialized,
+        )
+    }
+}
+
+#[derive(Serialize)]
+struct SegmentManifest<'a> {
+    schema_version: u8,
+    recording_id: &'a str,
+    segment_id: &'a str,
+    interaction_id: &'a str,
+    reservation_id: &'a str,
+    owner_epoch: &'a str,
+    region_id: &'a str,
+    zone_id: &'a str,
+    cell_id: &'a str,
+    recorder_node_id: &'a str,
+    sequence: u64,
+    track_id: &'static str,
+    payload_filename: &'a str,
+    container: &'static str,
+    codec: &'a str,
+    channels: u16,
+    sample_rate_hz: u32,
+    size_bytes: u64,
+    encoded_payload_bytes: u64,
+    encoded_payload_sha256: &'a str,
+    checksum_scope: &'static str,
+    written_samples: u64,
+    started_at: u64,
+    ended_at: u64,
+}
+
+#[derive(Serialize)]
+struct SegmentEvent<'a> {
+    schema_version: u8,
+    recording_id: &'a str,
+    segment_id: &'a str,
+    interaction_id: &'a str,
+    reservation_id: &'a str,
+    owner_epoch: &'a str,
+    event_sequence: u64,
+    event_type: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    dropped_samples: Option<u64>,
+    occurred_at: u64,
+}
+
+#[derive(Serialize)]
+struct RecordingCompletion<'a> {
+    schema_version: u8,
+    recording_id: &'a str,
+    interaction_id: &'a str,
+    reservation_id: &'a str,
+    owner_epoch: &'a str,
+    region_id: &'a str,
+    zone_id: &'a str,
+    cell_id: &'a str,
+    recorder_node_id: &'a str,
+    segment_count: u64,
+    last_segment_sequence: u64,
+    ended_at: u64,
+}
+
+fn segment_id(recording_id: &str, sequence: u64) -> String {
+    format!(
+        "vseg_{}",
+        hex_lower(Sha256::digest(
+            format!("{recording_id}\0mixed\0{sequence}").as_bytes()
+        ))
+    )
+}
+
+fn hex_lower(bytes: impl AsRef<[u8]>) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let bytes = bytes.as_ref();
+    let mut value = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        value.push(HEX[(byte >> 4) as usize] as char);
+        value.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    value
+}
+
+fn write_atomic(path: &Path, bytes: &[u8]) -> Result<()> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| anyhow!("recording manifest parent is missing"))?;
+    let temporary = parent.join(format!(
+        ".{}.tmp-{}-{}",
+        path.file_name()
+            .and_then(|value| value.to_str())
+            .unwrap_or("manifest"),
+        std::process::id(),
+        uuid::Uuid::new_v4()
+    ));
+    let mut file = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(&temporary)?;
+    file.write_all(bytes)?;
+    file.write_all(b"\n")?;
+    file.sync_all()?;
+    std::fs::rename(&temporary, path)?;
+    sync_directory(parent)
+}
+
+fn append_durable(path: &Path, bytes: &[u8]) -> Result<()> {
+    let mut file = OpenOptions::new().create(true).append(true).open(path)?;
+    file.write_all(bytes)?;
+    file.write_all(b"\n")?;
+    file.sync_all()
+}
+
+fn sync_directory(path: &Path) -> Result<()> {
+    File::open(path)?.sync_all()?;
+    Ok(())
+}
+
+fn unix_millis(value: SystemTime) -> Result<u64> {
+    Ok(value.duration_since(UNIX_EPOCH)?.as_millis() as u64)
+}
+
+fn required_env(name: &str) -> Result<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|value| !value.trim().is_empty())
+        .ok_or_else(|| anyhow!("{name} is required"))
+}
+
+fn required_identifier_env(name: &str) -> Result<String> {
+    valid_identifier(&required_env(name)?)
+}
+
+fn valid_identifier(value: &str) -> Result<String> {
+    let valid = !value.is_empty()
+        && value.len() <= 255
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'-'));
+    valid
+        .then(|| value.to_string())
+        .ok_or_else(|| anyhow!("recording identifier is invalid"))
+}
+
+fn valid_owner_epoch(value: &str) -> Result<String> {
+    if value.len() <= 20 && value.bytes().all(|byte| byte.is_ascii_digit()) {
+        Ok(value.to_string())
+    } else {
+        Err(anyhow!("recording owner epoch is invalid"))
+    }
+}
+
+fn env_enabled(name: &str) -> Result<bool> {
+    match std::env::var(name) {
+        Ok(value) if matches!(value.as_str(), "1" | "true") => Ok(true),
+        Ok(value) if matches!(value.as_str(), "0" | "false") => Ok(false),
+        Ok(_) => Err(anyhow!("{name} is invalid")),
+        Err(_) => Ok(false),
+    }
+}
+
+fn env_u64(name: &str, default: u64, min: u64, max: u64) -> Result<u64> {
+    let value = std::env::var(name)
+        .ok()
+        .map(|value| value.parse::<u64>())
+        .transpose()
+        .map_err(|_| anyhow!("{name} is invalid"))?
+        .unwrap_or(default);
+    if value < min || value > max {
+        return Err(anyhow!("{name} is outside the supported range"));
+    }
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spool_publishes_opaque_segment_manifest_and_durable_index() {
+        let root = tempfile::tempdir().unwrap();
+        let config = RecordingSpoolConfig {
+            root: root.path().to_path_buf(),
+            recording_id: "vrec_test".to_string(),
+            interaction_id: "call-a".to_string(),
+            reservation_id: "reservation-a".to_string(),
+            owner_epoch: "7".to_string(),
+            region_id: "region-a".to_string(),
+            zone_id: "zone-a".to_string(),
+            cell_id: "cell-a".to_string(),
+            recorder_node_id: "rustpbx-a".to_string(),
+            segment_duration_secs: 60,
+            segment_max_bytes: 1024 * 1024,
+        };
+        let mut spool = RecordingSpoolState::new(config).unwrap();
+        std::fs::write(spool.current_partial_path(), b"wav").unwrap();
+        spool.observe_payload(b"encoded");
+        let final_path = spool.close_current(7, 160, 8000, 2, "PCMU").unwrap();
+        spool.finalize().unwrap();
+        assert!(final_path.exists());
+        let manifest =
+            std::fs::read_to_string(root.path().join("vrec_test/segment-000001.json")).unwrap();
+        assert!(manifest.contains("\"checksum_scope\":\"encoded_payload\""));
+        assert!(!manifest.contains("phone"));
+        assert!(
+            std::fs::read_to_string(root.path().join("vrec_test/segments.ndjson"))
+                .unwrap()
+                .contains("\"segment_id\":\"vseg_")
+        );
+        let completion =
+            std::fs::read_to_string(root.path().join("vrec_test/recording-completed.json"))
+                .unwrap();
+        assert!(completion.contains("\"segment_count\":1"));
+        assert!(completion.contains("\"last_segment_sequence\":1"));
+    }
+
+    #[test]
+    fn spool_discards_empty_segment_created_after_rotation() {
+        let root = tempfile::tempdir().unwrap();
+        let config = RecordingSpoolConfig {
+            root: root.path().to_path_buf(),
+            recording_id: "vrec_rotated".to_string(),
+            interaction_id: "call-b".to_string(),
+            reservation_id: "reservation-b".to_string(),
+            owner_epoch: "8".to_string(),
+            region_id: "region-a".to_string(),
+            zone_id: "zone-a".to_string(),
+            cell_id: "cell-a".to_string(),
+            recorder_node_id: "rustpbx-a".to_string(),
+            segment_duration_secs: 60,
+            segment_max_bytes: 1024 * 1024,
+        };
+        let mut spool = RecordingSpoolState::new(config).unwrap();
+        std::fs::write(spool.current_partial_path(), b"wav-one").unwrap();
+        spool.observe_payload(b"encoded");
+        spool.close_current(7, 160, 8000, 2, "PCMU").unwrap();
+        spool.advance();
+        let empty_path = spool.current_partial_path();
+        std::fs::write(&empty_path, b"wav-header-only").unwrap();
+
+        assert!(spool.discard_empty_current().unwrap());
+        spool.record_sample_dropped(3).unwrap();
+        spool.finalize().unwrap();
+
+        assert!(!empty_path.exists());
+        let completion =
+            std::fs::read_to_string(root.path().join("vrec_rotated/recording-completed.json"))
+                .unwrap();
+        assert!(completion.contains("\"segment_count\":1"));
+        assert!(completion.contains("\"last_segment_sequence\":1"));
+        let event =
+            std::fs::read_to_string(root.path().join("vrec_rotated/event-000001.json")).unwrap();
+        assert!(event.contains("\"segment_id\":\"vseg_"));
+        assert!(event.contains("\"dropped_samples\":3"));
+    }
+}
