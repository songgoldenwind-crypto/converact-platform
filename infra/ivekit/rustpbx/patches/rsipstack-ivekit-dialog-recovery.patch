+    fn refresh_remote_target_from_response(
+        &self,
+        method: &Method,
+        response: &Response,
+    ) -> Result<()> {
+        if !matches!(method, Method::Invite | Method::Update)
+            || response.status_code.kind() != StatusCodeKind::Successful
+        {
+            return Ok(());
+        }
+        let mut contacts = response.typed_contact_headers()?;
+        if contacts.is_empty() {
+            return Ok(());
+        }
+        if contacts.len() != 1 {
+            return Err(crate::Error::Error(
+                "target refresh response must contain one Contact".to_string(),
+            ));
+        }
+        let contact = contacts.remove(0);
+        let remote_uri = contact.uri.clone();
+        self.set_remote_target(remote_uri, Some(contact.into()));
+        Ok(())
+    }
