+fn parsed_ratio_env(name: &str, default: f64) -> Result<f64, &'static str> {
+    let value = match required_env(name) {
+        Some(value) => value
+            .parse::<f64>()
+            .map_err(|_| "media_control_ratio_invalid")?,
+        None => default,
+    };
+    if !value.is_finite() || !(0.0..=1.0).contains(&value) {
+        return Err("media_control_ratio_invalid");
+    }
+    Ok(value)
+}
