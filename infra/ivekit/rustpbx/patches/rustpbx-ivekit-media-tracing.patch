+fn media_control_traceparent(command: &MediaControlCommand, sample_ratio: f64) -> String {
+    let trace_digest = Sha256::digest(
+        [
+            b"ivekit-media-trace\0".as_slice(),
+            command.call_id.as_bytes(),
+        ]
+        .concat(),
+    );
+    let span_digest = Sha256::digest(
+        [
+            b"ivekit-media-span\0".as_slice(),
+            command.command_id.as_bytes(),
+        ]
+        .concat(),
+    );
+    let sample_value = u64::from_be_bytes(
+        trace_digest[..8]
+            .try_into()
+            .expect("SHA-256 trace sample prefix"),
+    );
+    let sampled = sample_ratio >= 1.0
+        || (sample_ratio > 0.0 && (sample_value as f64 / u64::MAX as f64) < sample_ratio);
+    format!(
+        "00-{}-{}-{}",
+        nonzero_lower_hex(&trace_digest[..16]),
+        nonzero_lower_hex(&span_digest[..8]),
+        if sampled { "01" } else { "00" }
+    )
+}
+
+fn nonzero_lower_hex(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut encoded = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    if bytes.iter().all(|byte| *byte == 0) {
+        encoded.replace_range(encoded.len() - 1.., "1");
+    }
+    encoded
+}
