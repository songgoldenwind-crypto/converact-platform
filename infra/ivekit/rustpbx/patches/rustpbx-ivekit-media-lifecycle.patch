+pub fn stable_dialog_branch_id(call_id: &str, local_tag: &str, remote_tag: &str) -> String {
+    let mut digest = Sha256::new();
+    for value in [call_id, local_tag, remote_tag] {
+        digest.update((value.len() as u64).to_be_bytes());
+        digest.update(value.as_bytes());
+    }
+    let digest = digest.finalize();
+    let mut encoded = String::with_capacity(55);
+    encoded.push_str("branch-");
+    for byte in digest.iter().take(24) {
+        use std::fmt::Write;
+        write!(&mut encoded, "{byte:02x}").expect("writing to String cannot fail");
+    }
+    encoded
+}
