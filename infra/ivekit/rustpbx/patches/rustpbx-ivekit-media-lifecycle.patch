+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NegotiationState {
+    Unallocated,
+    OfferlessInvite,
+    Preparing,
+    Prepared,
+    Updating,
+    EarlyMedia,
+    Committed,
+    AwaitingAckAnswer,
+    Unknown,
+    Closed,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BranchDisposition {
+    Early,
+    Winner,
+    Deleted,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MediaMutationKind {
+    Offer,
+    EarlyAnswer,
+    FinalAnswer,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MediaMutation {
+    pub sequence: u32,
+    pub branch_id: String,
+    pub kind: MediaMutationKind,
+}
+
+#[derive(Clone, Debug)]
+struct MediaBranch {
+    disposition: BranchDisposition,
+}
+
+#[derive(Clone, Debug)]
+pub struct PerLegMediaState {
+    leg_id: String,
+    logical_sdp: Option<String>,
+    effective_sdp: Option<String>,
+    state: NegotiationState,
+    next_sequence: u32,
+    pending_previous_state: Option<NegotiationState>,
+    pending_kind: Option<MediaMutationKind>,
+    pending_branch: Option<String>,
+    unknown_command_id: Option<String>,
+    branches: HashMap<String, MediaBranch>,
+    winning_branch: Option<String>,
+    sent_487: bool,
+}
+
+impl PerLegMediaState {
+    pub fn new(leg_id: &str, logical_offer: Option<&str>) -> Result<Self, MediaLifecycleError> {
+        if !valid_identifier(leg_id) {
+            return Err(MediaLifecycleError::InvalidLeg);
+        }
+        if logical_offer.is_some_and(|sdp| sdp.len() > MAX_SDP_BYTES || sdp.contains('\0')) {
+            return Err(MediaLifecycleError::InvalidSdp);
+        }
+        Ok(Self {
+            leg_id: leg_id.to_string(),
+            logical_sdp: logical_offer.map(ToString::to_string),
+            effective_sdp: None,
+            state: if logical_offer.is_some() {
+                NegotiationState::Unallocated
+            } else {
+                NegotiationState::OfferlessInvite
+            },
+            next_sequence: 1,
+            pending_previous_state: None,
+            pending_kind: None,
+            pending_branch: None,
+            unknown_command_id: None,
+            branches: HashMap::new(),
+            winning_branch: None,
+            sent_487: false,
+        })
+    }
+
+    pub fn state(&self) -> NegotiationState {
+        self.state
+    }
+
+    pub fn next_sequence(&self) -> u32 {
+        self.next_sequence
+    }
+
+    pub fn effective_sdp(&self) -> Option<&str> {
+        self.effective_sdp.as_deref()
+    }
+
+    pub fn logical_sdp(&self) -> Option<&str> {
+        self.logical_sdp.as_deref()
+    }
+
+    pub fn leg_id(&self) -> &str {
+        &self.leg_id
+    }
+
+    pub fn reconcile_required(&self) -> bool {
+        self.state == NegotiationState::Unknown
+    }
+
+    pub fn winning_branch(&self) -> Option<&str> {
+        self.winning_branch.as_deref()
+    }
+
+    pub fn begin_offer(&mut self, branch_id: &str) -> Result<MediaMutation, MediaLifecycleError> {
+        if self.state != NegotiationState::Unallocated || self.logical_sdp.is_none() {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::Offer,
+            branch_id,
+            NegotiationState::Preparing,
+        )
+    }
+
+    pub fn commit_offer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::Offer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Prepared,
+        )
+    }
+
+    pub fn begin_early_media(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if !matches!(
+            self.state,
+            NegotiationState::Prepared | NegotiationState::EarlyMedia
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::EarlyAnswer,
+            branch_id,
+            NegotiationState::Updating,
+        )
+    }
+
+    pub fn commit_early_media(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::EarlyAnswer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::EarlyMedia,
+        )
+    }
+
+    pub fn begin_final_answer(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if !matches!(
+            self.state,
+            NegotiationState::Prepared | NegotiationState::EarlyMedia
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::FinalAnswer,
+            branch_id,
+            NegotiationState::Updating,
+        )
+    }
+
+    pub fn commit_final_answer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::FinalAnswer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Committed,
+        )?;
+        self.select_winning_branch(branch_id)
+    }
+
+    pub fn note_late_offer(
+        &mut self,
+        branch_id: &str,
+        offer_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.state != NegotiationState::OfferlessInvite {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(offer_sdp)?;
+        self.register_early_branch(branch_id)?;
+        self.logical_sdp = Some(offer_sdp.to_string());
+        self.state = NegotiationState::AwaitingAckAnswer;
+        Ok(())
+    }
+
+    pub fn register_early_branch(&mut self, branch_id: &str) -> Result<(), MediaLifecycleError> {
+        if !valid_identifier(branch_id) {
+            return Err(MediaLifecycleError::InvalidBranch);
+        }
+        if self.branches.contains_key(branch_id) {
+            return Ok(());
+        }
+        if self.branches.len() >= MAX_MEDIA_BRANCHES {
+            return Err(MediaLifecycleError::BranchCapacity);
+        }
+        self.branches.insert(
+            branch_id.to_string(),
+            MediaBranch {
+                disposition: BranchDisposition::Early,
+            },
+        );
+        Ok(())
+    }
+
+    pub fn select_winning_branch(&mut self, branch_id: &str) -> Result<(), MediaLifecycleError> {
+        if self
+            .winning_branch
+            .as_deref()
+            .is_some_and(|winner| winner != branch_id)
+        {
+            return Err(MediaLifecycleError::WinnerConflict);
+        }
+        let branch = self
+            .branches
+            .get_mut(branch_id)
+            .ok_or(MediaLifecycleError::InvalidBranch)?;
+        if branch.disposition == BranchDisposition::Deleted {
+            return Err(MediaLifecycleError::InvalidBranch);
+        }
+        branch.disposition = BranchDisposition::Winner;
+        self.winning_branch = Some(branch_id.to_string());
+        Ok(())
+    }
+
+    pub fn delete_losing_branch(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<BranchDisposition, MediaLifecycleError> {
+        if self.winning_branch.as_deref() == Some(branch_id) {
+            return Err(MediaLifecycleError::WinnerConflict);
+        }
+        let branch = self
+            .branches
+            .get_mut(branch_id)
+            .ok_or(MediaLifecycleError::InvalidBranch)?;
+        branch.disposition = BranchDisposition::Deleted;
+        Ok(branch.disposition)
+    }
+
+    pub fn mark_unknown(&mut self, command_id: &str) -> Result<(), MediaLifecycleError> {
+        if self.pending_kind.is_none() || !valid_identifier(command_id) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.unknown_command_id = Some(command_id.to_string());
+        self.state = NegotiationState::Unknown;
+        Ok(())
+    }
+
+    pub fn reconcile_committed(
+        &mut self,
+        command_id: &str,
+        recovered_state: NegotiationState,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.state != NegotiationState::Unknown
+            || self.unknown_command_id.as_deref() != Some(command_id)
+            || !matches!(
+                recovered_state,
+                NegotiationState::Prepared
+                    | NegotiationState::EarlyMedia
+                    | NegotiationState::Committed
+                    | NegotiationState::Closed
+            )
+        {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(effective_sdp)?;
+        self.state = recovered_state;
+        self.effective_sdp = Some(effective_sdp.to_string());
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.pending_previous_state = None;
+        self.unknown_command_id = None;
+        Ok(())
+    }
+
+    pub fn cancel_before_answer(&mut self) -> Result<(), MediaLifecycleError> {
+        if matches!(
+            self.state,
+            NegotiationState::Committed | NegotiationState::Closed
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.state = NegotiationState::Closed;
+        Ok(())
+    }
+
+    pub fn send_487_once(&mut self) -> bool {
+        if self.sent_487 {
+            return false;
+        }
+        self.sent_487 = true;
+        true
+    }
+
+    fn begin_mutation(
+        &mut self,
+        kind: MediaMutationKind,
+        branch_id: &str,
+        transient_state: NegotiationState,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if self.reconcile_required() || self.pending_kind.is_some() {
+            return Err(MediaLifecycleError::ReconcileRequired);
+        }
+        let sequence = self.next_sequence;
+        self.next_sequence = self
+            .next_sequence
+            .checked_add(1)
+            .ok_or(MediaLifecycleError::SequenceExhausted)?;
+        self.pending_previous_state = Some(self.state);
+        self.pending_kind = Some(kind);
+        self.pending_branch = Some(branch_id.to_string());
+        self.state = transient_state;
+        Ok(MediaMutation {
+            sequence,
+            branch_id: branch_id.to_string(),
+            kind,
+        })
+    }
+
+    fn commit_mutation(
+        &mut self,
+        kind: MediaMutationKind,
+        branch_id: &str,
+        effective_sdp: &str,
+        committed_state: NegotiationState,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.pending_kind != Some(kind) || self.pending_branch.as_deref() != Some(branch_id) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(effective_sdp)?;
+        self.effective_sdp = Some(effective_sdp.to_string());
+        self.pending_previous_state = None;
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.state = committed_state;
+        Ok(())
+    }
+
+    fn reject_pending(&mut self) -> Result<(), MediaLifecycleError> {
+        let previous = self
+            .pending_previous_state
+            .take()
+            .ok_or(MediaLifecycleError::InvalidTransition)?;
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.state = previous;
+        Ok(())
+    }
+}
