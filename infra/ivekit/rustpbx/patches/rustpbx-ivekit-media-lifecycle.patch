+#[derive(Clone, Debug)]
+pub struct PerLegMediaState {
+    leg_id: String,
+    logical_sdp: Option<String>,
+    effective_sdp: Option<String>,
+    state: NegotiationState,
+    next_sequence: u32,
+    pending_previous_state: Option<NegotiationState>,
+    pending_kind: Option<MediaMutationKind>,
+    pending_branch: Option<String>,
+    unknown_command_id: Option<String>,
+    branches: HashMap<String, MediaBranch>,
+    winning_branch: Option<String>,
+    sent_487: bool,
+}
+
+impl PerLegMediaState {
+    pub fn new(leg_id: &str, logical_offer: Option<&str>) -> Result<Self, MediaLifecycleError> {
+        if !valid_identifier(leg_id) {
+            return Err(MediaLifecycleError::InvalidLeg);
+        }
+        if logical_offer.is_some_and(|sdp| sdp.len() > MAX_SDP_BYTES || sdp.contains('\0')) {
+            return Err(MediaLifecycleError::InvalidSdp);
+        }
+        Ok(Self {
+            leg_id: leg_id.to_string(),
+            logical_sdp: logical_offer.map(ToString::to_string),
+            effective_sdp: None,
+            state: if logical_offer.is_some() {
+                NegotiationState::Unallocated
+            } else {
+                NegotiationState::OfferlessInvite
+            },
+            next_sequence: 1,
+            pending_previous_state: None,
+            pending_kind: None,
+            pending_branch: None,
+            unknown_command_id: None,
+            branches: HashMap::new(),
+            winning_branch: None,
+            sent_487: false,
+        })
+    }
+
+    pub fn state(&self) -> NegotiationState {
+        self.state
+    }
+
+    pub fn next_sequence(&self) -> u32 {
+        self.next_sequence
+    }
+
+    pub fn effective_sdp(&self) -> Option<&str> {
+        self.effective_sdp.as_deref()
+    }
+
+    pub fn logical_sdp(&self) -> Option<&str> {
+        self.logical_sdp.as_deref()
+    }
+
+    pub fn leg_id(&self) -> &str {
+        &self.leg_id
+    }
+
+    pub fn reconcile_required(&self) -> bool {
+        self.state == NegotiationState::Unknown
+    }
+
+    pub fn winning_branch(&self) -> Option<&str> {
+        self.winning_branch.as_deref()
+    }
+
+    pub fn begin_offer(&mut self, branch_id: &str) -> Result<MediaMutation, MediaLifecycleError> {
+        if self.state != NegotiationState::Unallocated || self.logical_sdp.is_none() {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::Offer,
+            branch_id,
+            NegotiationState::Preparing,
+        )
+    }
+
+    pub fn commit_offer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::Offer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Prepared,
+        )
+    }
+
+    pub fn begin_early_media(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if !matches!(
+            self.state,
+            NegotiationState::Prepared | NegotiationState::EarlyMedia
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::EarlyAnswer,
+            branch_id,
+            NegotiationState::Updating,
+        )
+    }
+
+    pub fn commit_early_media(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::EarlyAnswer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::EarlyMedia,
+        )
+    }
+
+    pub fn begin_final_answer(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if !matches!(
+            self.state,
+            NegotiationState::Prepared | NegotiationState::EarlyMedia
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.register_early_branch(branch_id)?;
+        self.begin_mutation(
+            MediaMutationKind::FinalAnswer,
+            branch_id,
+            NegotiationState::Updating,
+        )
+    }
+
+    pub fn commit_final_answer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::FinalAnswer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Committed,
+        )?;
+        self.select_winning_branch(branch_id)
+    }
+
+    pub fn begin_mid_dialog_offer(&mut self) -> Result<MediaMutation, MediaLifecycleError> {
+        self.begin_committed_mutation(MediaMutationKind::MidDialogOffer)
+    }
+
+    pub fn commit_mid_dialog_offer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::MidDialogOffer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Committed,
+        )
+    }
+
+    pub fn begin_mid_dialog_answer(&mut self) -> Result<MediaMutation, MediaLifecycleError> {
+        self.begin_committed_mutation(MediaMutationKind::MidDialogAnswer)
+    }
+
+    pub fn commit_mid_dialog_answer(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::MidDialogAnswer,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Committed,
+        )
+    }
+
+    pub fn begin_dtmf(&mut self) -> Result<MediaMutation, MediaLifecycleError> {
+        self.begin_committed_mutation(MediaMutationKind::Dtmf)
+    }
+
+    pub fn commit_dtmf(
+        &mut self,
+        branch_id: &str,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        self.commit_mutation(
+            MediaMutationKind::Dtmf,
+            branch_id,
+            effective_sdp,
+            NegotiationState::Committed,
+        )
+    }
+
+    pub fn note_late_offer(
+        &mut self,
+        branch_id: &str,
+        offer_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.state != NegotiationState::OfferlessInvite {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(offer_sdp)?;
+        self.register_early_branch(branch_id)?;
+        self.logical_sdp = Some(offer_sdp.to_string());
+        self.state = NegotiationState::AwaitingAckAnswer;
+        Ok(())
+    }
+
+    pub fn register_early_branch(&mut self, branch_id: &str) -> Result<(), MediaLifecycleError> {
+        if !valid_identifier(branch_id) {
+            return Err(MediaLifecycleError::InvalidBranch);
+        }
+        if self.branches.contains_key(branch_id) {
+            return Ok(());
+        }
+        if self.branches.len() >= MAX_MEDIA_BRANCHES {
+            return Err(MediaLifecycleError::BranchCapacity);
+        }
+        self.branches.insert(
+            branch_id.to_string(),
+            MediaBranch {
+                disposition: BranchDisposition::Early,
+            },
+        );
+        Ok(())
+    }
+
+    pub fn select_winning_branch(&mut self, branch_id: &str) -> Result<(), MediaLifecycleError> {
+        if self
+            .winning_branch
+            .as_deref()
+            .is_some_and(|winner| winner != branch_id)
+        {
+            return Err(MediaLifecycleError::WinnerConflict);
+        }
+        let branch = self
+            .branches
+            .get_mut(branch_id)
+            .ok_or(MediaLifecycleError::InvalidBranch)?;
+        if branch.disposition == BranchDisposition::Deleted {
+            return Err(MediaLifecycleError::InvalidBranch);
+        }
+        branch.disposition = BranchDisposition::Winner;
+        self.winning_branch = Some(branch_id.to_string());
+        Ok(())
+    }
+
+    pub fn delete_losing_branch(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<BranchDisposition, MediaLifecycleError> {
+        if self.winning_branch.as_deref() == Some(branch_id) {
+            return Err(MediaLifecycleError::WinnerConflict);
+        }
+        let branch = self
+            .branches
+            .get_mut(branch_id)
+            .ok_or(MediaLifecycleError::InvalidBranch)?;
+        branch.disposition = BranchDisposition::Deleted;
+        Ok(branch.disposition)
+    }
+
+    pub fn mark_unknown(&mut self, command_id: &str) -> Result<(), MediaLifecycleError> {
+        if self.pending_kind.is_none() || !valid_identifier(command_id) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.unknown_command_id = Some(command_id.to_string());
+        self.state = NegotiationState::Unknown;
+        Ok(())
+    }
+
+    pub fn reconcile_committed(
+        &mut self,
+        command_id: &str,
+        recovered_state: NegotiationState,
+        effective_sdp: &str,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.state != NegotiationState::Unknown
+            || self.unknown_command_id.as_deref() != Some(command_id)
+            || !matches!(
+                recovered_state,
+                NegotiationState::Prepared
+                    | NegotiationState::EarlyMedia
+                    | NegotiationState::Committed
+                    | NegotiationState::Closed
+            )
+        {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(effective_sdp)?;
+        self.state = recovered_state;
+        self.effective_sdp = Some(effective_sdp.to_string());
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.pending_previous_state = None;
+        self.unknown_command_id = None;
+        Ok(())
+    }
+
+    pub fn cancel_before_answer(&mut self) -> Result<(), MediaLifecycleError> {
+        if matches!(
+            self.state,
+            NegotiationState::Committed | NegotiationState::Closed
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.state = NegotiationState::Closed;
+        Ok(())
+    }
+
+    fn reserve_close_sequence(&mut self) -> Result<u32, MediaLifecycleError> {
+        if self.reconcile_required() || self.pending_kind.is_some() {
+            return Err(MediaLifecycleError::ReconcileRequired);
+        }
+        if matches!(
+            self.state,
+            NegotiationState::Unallocated
+                | NegotiationState::OfferlessInvite
+                | NegotiationState::Closed
+        ) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        let sequence = self.next_sequence;
+        self.next_sequence = self
+            .next_sequence
+            .checked_add(1)
+            .ok_or(MediaLifecycleError::SequenceExhausted)?;
+        Ok(sequence)
+    }
+
+    fn mark_close_unknown(&mut self, command_id: &str) -> Result<(), MediaLifecycleError> {
+        if !valid_identifier(command_id) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        self.unknown_command_id = Some(command_id.to_string());
+        self.state = NegotiationState::Unknown;
+        Ok(())
+    }
+
+    fn commit_close(&mut self) {
+        self.pending_previous_state = None;
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.unknown_command_id = None;
+        self.state = NegotiationState::Closed;
+    }
+
+    pub fn send_487_once(&mut self) -> bool {
+        if self.sent_487 {
+            return false;
+        }
+        self.sent_487 = true;
+        true
+    }
+
+    fn begin_mutation(
+        &mut self,
+        kind: MediaMutationKind,
+        branch_id: &str,
+        transient_state: NegotiationState,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if self.reconcile_required() || self.pending_kind.is_some() {
+            return Err(MediaLifecycleError::ReconcileRequired);
+        }
+        let sequence = self.next_sequence;
+        self.next_sequence = self
+            .next_sequence
+            .checked_add(1)
+            .ok_or(MediaLifecycleError::SequenceExhausted)?;
+        self.pending_previous_state = Some(self.state);
+        self.pending_kind = Some(kind);
+        self.pending_branch = Some(branch_id.to_string());
+        self.state = transient_state;
+        Ok(MediaMutation {
+            sequence,
+            branch_id: branch_id.to_string(),
+            kind,
+        })
+    }
+
+    fn begin_committed_mutation(
+        &mut self,
+        kind: MediaMutationKind,
+    ) -> Result<MediaMutation, MediaLifecycleError> {
+        if self.state != NegotiationState::Committed {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        let branch_id = self
+            .winning_branch
+            .clone()
+            .ok_or(MediaLifecycleError::InvalidBranch)?;
+        self.begin_mutation(kind, &branch_id, NegotiationState::Updating)
+    }
+
+    fn commit_mutation(
+        &mut self,
+        kind: MediaMutationKind,
+        branch_id: &str,
+        effective_sdp: &str,
+        committed_state: NegotiationState,
+    ) -> Result<(), MediaLifecycleError> {
+        if self.pending_kind != Some(kind) || self.pending_branch.as_deref() != Some(branch_id) {
+            return Err(MediaLifecycleError::InvalidTransition);
+        }
+        checked_sdp(effective_sdp)?;
+        self.effective_sdp = Some(effective_sdp.to_string());
+        self.pending_previous_state = None;
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.state = committed_state;
+        Ok(())
+    }
+
+    fn reject_pending(&mut self) -> Result<(), MediaLifecycleError> {
+        let previous = self
+            .pending_previous_state
+            .take()
+            .ok_or(MediaLifecycleError::InvalidTransition)?;
+        self.pending_kind = None;
+        self.pending_branch = None;
+        self.state = previous;
+        Ok(())
+    }
+}
+
+#[async_trait::async_trait]
+pub trait MediaControlExecutor: Send + Sync {
+    async fn execute(
+        &self,
+        command: &MediaControlCommand,
+    ) -> Result<MediaControlResult, MediaControlClientError>;
+}
+
+#[async_trait::async_trait]
+impl MediaControlExecutor for MediaControlClient {
+    async fn execute(
+        &self,
+        command: &MediaControlCommand,
+    ) -> Result<MediaControlResult, MediaControlClientError> {
+        MediaControlClient::execute(self, command).await
+    }
+}
+
+pub struct IveKitMediaLifecycle {
+    binding: MediaAdmissionBinding,
+    executor: Arc<dyn MediaControlExecutor>,
+    from_tag: String,
+    to_tag: Option<String>,
+    callee: PerLegMediaState,
+    close_command: Option<MediaControlCommand>,
+    close_confirmed: bool,
+}
+
+impl IveKitMediaLifecycle {
+    pub fn new(
+        binding: MediaAdmissionBinding,
+        executor: Arc<dyn MediaControlExecutor>,
+        from_tag: &str,
+        caller_offer: Option<&str>,
+    ) -> Result<Self, MediaLifecycleError> {
+        if !valid_sip_tag(from_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("from_tag"));
+        }
+        Ok(Self {
+            binding,
+            executor,
+            from_tag: from_tag.to_string(),
+            to_tag: None,
+            callee: PerLegMediaState::new("callee", caller_offer)?,
+            close_command: None,
+            close_confirmed: false,
+        })
+    }
+
+    pub fn state(&self) -> NegotiationState {
+        self.callee.state()
+    }
+
+    pub fn reconcile_required(&self) -> bool {
+        self.callee.reconcile_required()
+    }
+
+    pub async fn prepare_ordinary_relay_offer(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        let mutation = self.callee.begin_offer(branch_id)?;
+        let offer_sdp = self
+            .callee
+            .logical_sdp()
+            .ok_or(MediaLifecycleError::InvalidTransition)?
+            .to_string();
+        let payload = serde_json::json!({
+            "from_tag": self.from_tag,
+            "media_profile_id": self.binding.media_profile_id(),
+            "offer_sdp": offer_sdp,
+        });
+        let command = self.build_command(MediaControlAction::Offer, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["prepared"])?;
+        self.callee
+            .commit_offer(branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn commit_early_media(
+        &mut self,
+        branch_id: &str,
+        to_tag: &str,
+        callee_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(callee_sdp)?;
+        if !valid_sip_tag(to_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("to_tag"));
+        }
+        let mutation = self.callee.begin_early_media(branch_id)?;
+        let payload = serde_json::json!({
+            "from_tag": self.from_tag,
+            "negotiation_role": "answer",
+            "sdp": callee_sdp,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Update, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["prepared", "committed"])?;
+        self.callee
+            .commit_early_media(branch_id, &session.effective_sdp)?;
+        self.to_tag = Some(to_tag.to_string());
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn commit_final_answer(
+        &mut self,
+        branch_id: &str,
+        to_tag: &str,
+        callee_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(callee_sdp)?;
+        if !valid_sip_tag(to_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("to_tag"));
+        }
+        let mutation = self.callee.begin_final_answer(branch_id)?;
+        let payload = serde_json::json!({
+            "answer_sdp": callee_sdp,
+            "from_tag": self.from_tag,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Answer, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["committed"])?;
+        self.callee
+            .commit_final_answer(branch_id, &session.effective_sdp)?;
+        self.to_tag = Some(to_tag.to_string());
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn prepare_mid_dialog_offer(
+        &mut self,
+        side: MediaDialogSide,
+        offer_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(offer_sdp)?;
+        let (from_tag, to_tag) = self.dialog_tags(side)?;
+        let mutation = self.callee.begin_mid_dialog_offer()?;
+        let payload = serde_json::json!({
+            "from_tag": from_tag,
+            "negotiation_role": "offer",
+            "sdp": offer_sdp,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Update, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["committed"])?;
+        self.callee
+            .commit_mid_dialog_offer(&mutation.branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn commit_mid_dialog_answer(
+        &mut self,
+        side: MediaDialogSide,
+        answer_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(answer_sdp)?;
+        let (from_tag, to_tag) = self.dialog_tags(side)?;
+        let mutation = self.callee.begin_mid_dialog_answer()?;
+        // RTPengine keeps the offerer's tag orientation for its matching answer.
+        let payload = serde_json::json!({
+            "from_tag": from_tag,
+            "negotiation_role": "answer",
+            "sdp": answer_sdp,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Update, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["committed"])?;
+        self.callee
+            .commit_mid_dialog_answer(&mutation.branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn inject_rtp_dtmf(
+        &mut self,
+        side: MediaDialogSide,
+        digit: &str,
+        duration: u16,
+        volume: u8,
+        pause: u16,
+    ) -> Result<(), MediaLifecycleError> {
+        if !matches!(
+            digit.as_bytes(),
+            [b'0'..=b'9'] | [b'*'] | [b'#'] | [b'A'..=b'D']
+        ) || !(100..=5_000).contains(&duration)
+            || volume > 63
+            || !(100..=5_000).contains(&pause)
+        {
+            return Err(MediaLifecycleError::InvalidDtmf);
+        }
+        let (from_tag, to_tag) = self.dialog_tags(side)?;
+        let mutation = self.callee.begin_dtmf()?;
+        let payload = serde_json::json!({
+            "digit": digit,
+            "duration": duration,
+            "from_tag": from_tag,
+            "pause": pause,
+            "to_tag": to_tag,
+            "volume": volume,
+        });
+        let command =
+            self.build_command(MediaControlAction::InjectDtmf, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["committed"])?;
+        self.callee
+            .commit_dtmf(&mutation.branch_id, &session.effective_sdp)
+    }
+
+    pub async fn close_media(&mut self) -> Result<MediaCloseOutcome, MediaLifecycleError> {
+        if self.close_confirmed {
+            return Ok(MediaCloseOutcome::AlreadyClosed);
+        }
+        if self.close_command.is_none() {
+            if matches!(
+                self.callee.state(),
+                NegotiationState::Unallocated | NegotiationState::OfferlessInvite
+            ) {
+                self.callee.cancel_before_answer()?;
+                self.close_confirmed = true;
+                return Ok(MediaCloseOutcome::NotAllocated);
+            }
+            if self.callee.state() == NegotiationState::Closed {
+                self.close_confirmed = true;
+                return Ok(MediaCloseOutcome::AlreadyClosed);
+            }
+            let sequence = self.callee.reserve_close_sequence()?;
+            let mut payload = serde_json::Map::new();
+            payload.insert("from_tag".to_string(), Value::String(self.from_tag.clone()));
+            if let Some(to_tag) = &self.to_tag {
+                payload.insert("to_tag".to_string(), Value::String(to_tag.clone()));
+            }
+            self.close_command = Some(self.build_command(
+                MediaControlAction::Delete,
+                sequence,
+                Value::Object(payload),
+            )?);
+        }
+        let command = self
+            .close_command
+            .clone()
+            .ok_or(MediaLifecycleError::CommandInvalid)?;
+        match self.executor.execute(&command).await {
+            Ok(MediaControlResult::Committed {
+                command_id,
+                session,
+                ..
+            })
+            | Ok(MediaControlResult::Replayed {
+                command_id,
+                session,
+                ..
+            }) if command_id == command.command_id => {
+                if require_close_session(&self.binding, &command, &session).is_err() {
+                    self.callee.mark_close_unknown(&command.command_id)?;
+                    return Err(MediaLifecycleError::OutcomeUnknown);
+                }
+                self.callee.commit_close();
+                self.close_confirmed = true;
+                Ok(MediaCloseOutcome::Closed)
+            }
+            Ok(MediaControlResult::Unknown { command_id, .. })
+                if command_id == command.command_id =>
+            {
+                self.callee.mark_close_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Ok(MediaControlResult::RejectedCapacity { error_code, .. })
+            | Ok(MediaControlResult::RejectedEpoch { error_code, .. })
+            | Ok(MediaControlResult::TerminalError { error_code, .. }) => {
+                Err(MediaLifecycleError::ControlRejected { code: error_code })
+            }
+            Ok(_) => {
+                self.callee.mark_close_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(MediaControlClientError::UnknownAfterTransport { .. }) => {
+                self.callee.mark_close_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(error) => Err(MediaLifecycleError::ControlRejected {
+                code: error.failure_code().to_string(),
+            }),
+        }
+    }
+
+    fn dialog_tags(&self, side: MediaDialogSide) -> Result<(String, String), MediaLifecycleError> {
+        let to_tag = self
+            .to_tag
+            .as_deref()
+            .ok_or(MediaLifecycleError::InvalidTransition)?;
+        Ok(match side {
+            MediaDialogSide::Caller => (self.from_tag.clone(), to_tag.to_string()),
+            MediaDialogSide::Callee => (to_tag.to_string(), self.from_tag.clone()),
+        })
+    }
+
+    #[cfg(test)]
+    fn preview_command_id(
+        &self,
+        action: MediaControlAction,
+        sequence: u32,
+        payload: Value,
+    ) -> Result<String, MediaLifecycleError> {
+        Ok(self.build_command(action, sequence, payload)?.command_id)
+    }
+
+    fn build_command(
+        &self,
+        action: MediaControlAction,
+        sequence: u32,
+        payload: Value,
+    ) -> Result<MediaControlCommand, MediaLifecycleError> {
+        let payload = match payload {
+            Value::Object(payload) => payload,
+            _ => return Err(MediaLifecycleError::CommandInvalid),
+        };
+        let payload_hash =
+            payload_hash(&payload).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+        let expires_at = (chrono::Utc::now() + chrono::Duration::seconds(30))
+            .to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+        let leg_id = self.callee.leg_id().to_string();
+        let media_reservation_id = self.binding.media_reservation_id(&leg_id)?;
+        let mut command = MediaControlCommand {
+            protocol_version: MEDIA_CONTROL_PROTOCOL_VERSION.to_string(),
+            action,
+            command_id: "pending".to_string(),
+            tenant_id: self.binding.tenant_id().to_string(),
+            call_id: self.binding.call_id().to_string(),
+            leg_id: leg_id.clone(),
+            cell_id: self.binding.cell_id().to_string(),
+            owner_node_id: self.binding.owner_node_id().to_string(),
+            owner_epoch: self.binding.owner_epoch().to_string(),
+            admission_reservation_id: self.binding.admission_reservation_id().to_string(),
+            media_reservation_id,
+            command_sequence: sequence,
+            idempotency_key: format!(
+                "rustpbx/{}/{}/{}/{}/{}",
+                self.binding.cell_id(),
+                self.binding.call_id(),
+                leg_id,
+                self.binding.owner_epoch(),
+                sequence
+            ),
+            expires_at,
+            payload,
+            payload_hash,
+        };
+        command.command_id =
+            command_id_for(&command).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+        Ok(command)
+    }
+
+    async fn execute_mutation(
+        &mut self,
+        command: &MediaControlCommand,
+    ) -> Result<MediaSessionSnapshot, MediaLifecycleError> {
+        match self.executor.execute(command).await {
+            Ok(MediaControlResult::Committed {
+                command_id,
+                session,
+                ..
+            })
+            | Ok(MediaControlResult::Replayed {
+                command_id,
+                session,
+                ..
+            }) if command_id == command.command_id => Ok(session),
+            Ok(MediaControlResult::Unknown { command_id, .. })
+                if command_id == command.command_id =>
+            {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Ok(MediaControlResult::RejectedCapacity { error_code, .. })
+            | Ok(MediaControlResult::RejectedEpoch { error_code, .. })
+            | Ok(MediaControlResult::TerminalError { error_code, .. }) => {
+                self.callee.reject_pending()?;
+                Err(MediaLifecycleError::ControlRejected { code: error_code })
+            }
+            Ok(_) => {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(MediaControlClientError::UnknownAfterTransport { .. }) => {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(error) => {
+                self.callee.reject_pending()?;
+                Err(MediaLifecycleError::ControlRejected {
+                    code: error.failure_code().to_string(),
+                })
+            }
+        }
+    }
+
+    fn require_committed_session(
+        &mut self,
+        command: &MediaControlCommand,
+        session: &MediaSessionSnapshot,
+        allowed_states: &[&str],
+    ) -> Result<(), MediaLifecycleError> {
+        if require_session_identity(&self.binding, command, session, allowed_states).is_err() {
+            self.callee.mark_unknown(&command.command_id)?;
+            return Err(MediaLifecycleError::OutcomeUnknown);
+        }
+        Ok(())
+    }
+}
+
+fn require_session_identity(
+    binding: &MediaAdmissionBinding,
+    command: &MediaControlCommand,
+    session: &MediaSessionSnapshot,
+    allowed_states: &[&str],
+) -> Result<(), MediaLifecycleError> {
+    if session.media_reservation_id != command.media_reservation_id
+        || session.call_id != binding.call_id()
+        || session.owner_epoch != binding.owner_epoch()
+        || session.last_sequence != command.command_sequence
+        || !allowed_states.contains(&session.state.as_str())
+        || session.effective_sdp.is_empty()
+        || session.effective_sdp.len() > MAX_SDP_BYTES
+        || session.effective_sdp.contains('\0')
+    {
+        return Err(MediaLifecycleError::OutcomeUnknown);
+    }
+    Ok(())
+}
+
+fn require_close_session(
+    binding: &MediaAdmissionBinding,
+    command: &MediaControlCommand,
+    session: &MediaSessionSnapshot,
+) -> Result<(), MediaLifecycleError> {
+    if session.media_reservation_id != command.media_reservation_id
+        || session.call_id != binding.call_id()
+        || session.owner_epoch != binding.owner_epoch()
+        || session.last_sequence != command.command_sequence
+        || session.state != "closed"
+    {
+        return Err(MediaLifecycleError::OutcomeUnknown);
+    }
+    Ok(())
+}
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum MediaLifecycleError {
+    #[error("media_binding_invalid:{0}")]
+    InvalidBinding(&'static str),
+    #[error("media_leg_invalid")]
+    InvalidLeg,
+    #[error("media_branch_invalid")]
+    InvalidBranch,
+    #[error("media_branch_capacity")]
+    BranchCapacity,
+    #[error("media_winner_conflict")]
+    WinnerConflict,
+    #[error("media_sdp_invalid")]
+    InvalidSdp,
+    #[error("media_dtmf_invalid")]
+    InvalidDtmf,
+    #[error("media_transition_invalid")]
+    InvalidTransition,
+    #[error("media_reconcile_required")]
+    ReconcileRequired,
+    #[error("media_sequence_exhausted")]
+    SequenceExhausted,
+    #[error("media_command_invalid")]
+    CommandInvalid,
+    #[error("media_control_rejected:{code}")]
+    ControlRejected { code: String },
+    #[error("media_control_outcome_unknown")]
+    OutcomeUnknown,
+    #[error("media_control_configuration_invalid")]
+    ConfigurationInvalid,
+}
+
+impl MediaLifecycleError {
+    pub fn failure_code(&self) -> &str {
+        match self {
+            Self::InvalidBinding(code) => code,
+            Self::InvalidLeg => "media_leg_invalid",
+            Self::InvalidBranch => "media_branch_invalid",
+            Self::BranchCapacity => "media_branch_capacity",
+            Self::WinnerConflict => "media_winner_conflict",
+            Self::InvalidSdp => "media_sdp_invalid",
+            Self::InvalidDtmf => "media_dtmf_invalid",
+            Self::InvalidTransition => "media_transition_invalid",
+            Self::ReconcileRequired => "media_reconcile_required",
+            Self::SequenceExhausted => "media_sequence_exhausted",
+            Self::CommandInvalid => "media_command_invalid",
+            Self::ControlRejected { code } => code,
+            Self::OutcomeUnknown => "media_control_outcome_unknown",
+            Self::ConfigurationInvalid => "media_control_configuration_invalid",
+        }
+    }
+}
+
+pub fn explicit_fallback_allowed(error: &MediaLifecycleError) -> bool {
+    matches!(error, MediaLifecycleError::ControlRejected { .. })
+}
+
+struct MediaControlRuntimeConfig {
+    executor: Arc<MediaControlClient>,
+    failure_policy: MediaControlFailurePolicy,
+}
+
+static MEDIA_CONTROL_RUNTIME: OnceLock<
+    Result<Option<Arc<MediaControlRuntimeConfig>>, &'static str>,
+> = OnceLock::new();
+
+pub enum IveKitMediaRuntime {
+    Disabled,
+    Ready {
+        lifecycle: IveKitMediaLifecycle,
+        failure_policy: MediaControlFailurePolicy,
+    },
+    FailClosed {
+        error_code: &'static str,
+    },
+}
+
+impl IveKitMediaRuntime {
+    pub fn bootstrap(session_id: &str, caller_from_tag: &str, caller_offer: Option<&str>) -> Self {
+        let config = match media_control_runtime_config() {
+            Ok(Some(config)) => config,
+            Ok(None) => return Self::Disabled,
+            Err(error_code) => return Self::FailClosed { error_code },
+        };
+        let Some(owner) = crate::ivekit_owner::owner_contract(session_id) else {
+            return Self::FailClosed {
+                error_code: "media_control_owner_binding_missing",
+            };
+        };
+        let binding = match MediaAdmissionBinding::new(
+            &required_env("IVEKIT_RUSTPBX_ROUTE_TENANT_ID").unwrap_or_default(),
+            &owner.interaction_id,
+            &required_env("IVEKIT_RUSTPBX_CELL_ID").unwrap_or_default(),
+            &required_env("IVEKIT_RUSTPBX_OWNER_NODE_ID").unwrap_or_default(),
+            &owner.owner_epoch,
+            &owner.reservation_id,
+            &required_env("IVEKIT_RUSTPBX_MEDIA_PROFILE_ID").unwrap_or_default(),
+        ) {
+            Ok(binding) => binding,
+            Err(_) => {
+                return Self::FailClosed {
+                    error_code: "media_control_admission_binding_invalid",
+                };
+            }
+        };
+        match IveKitMediaLifecycle::new(
+            binding,
+            config.executor.clone(),
+            caller_from_tag,
+            caller_offer,
+        ) {
+            Ok(lifecycle) => Self::Ready {
+                lifecycle,
+                failure_policy: config.failure_policy,
+            },
+            Err(_) => Self::FailClosed {
+                error_code: "media_control_session_binding_invalid",
+            },
+        }
+    }
+
+    pub fn is_ready(&self) -> bool {
+        matches!(self, Self::Ready { .. })
+    }
+
+    pub fn failure_policy(&self) -> MediaControlFailurePolicy {
+        match self {
+            Self::Ready { failure_policy, .. } => *failure_policy,
+            Self::Disabled | Self::FailClosed { .. } => MediaControlFailurePolicy::FailClosed,
+        }
+    }
+
+    pub fn lifecycle_mut(&mut self) -> Option<&mut IveKitMediaLifecycle> {
+        match self {
+            Self::Ready { lifecycle, .. } => Some(lifecycle),
+            Self::Disabled | Self::FailClosed { .. } => None,
+        }
+    }
+
+    pub fn failure_code(&self) -> Option<&'static str> {
+        match self {
+            Self::FailClosed { error_code } => Some(*error_code),
+            Self::Disabled | Self::Ready { .. } => None,
+        }
+    }
+}
+
+pub fn media_control_requested() -> bool {
+    required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_ENDPOINT").is_some()
+}
+
+pub fn spawn_media_control_event_listener(
+    registry: Arc<crate::proxy::active_call_registry::ActiveProxyCallRegistry>,
+    cancel: CancellationToken,
+) {
+    if !media_control_requested() {
+        return;
+    }
+    let config = match media_control_runtime_config() {
+        Ok(Some(config)) => config.clone(),
+        Ok(None) => return,
+        Err(error) => {
+            warn!(
+                error_code = error,
+                "iveKit media event listener is not configured"
+            );
+            return;
+        }
+    };
+    let Some(owner_node_id) = required_env("IVEKIT_RUSTPBX_OWNER_NODE_ID") else {
+        warn!("iveKit media event listener owner node is missing");
+        return;
+    };
+    info!(owner_node_id, "iveKit media event listener started");
+    tokio::spawn(async move {
+        let mut after_sequence = 0_u64;
+        let mut retry_delay = Duration::from_millis(100);
+        loop {
+            let before = after_sequence;
+            let result = tokio::select! {
+                _ = cancel.cancelled() => return,
+                result = config.executor.consume_events(
+                    &owner_node_id,
+                    &mut after_sequence,
+                    |event| {
+                        let registry = registry.clone();
+                        async move {
+                            let Some(handle) = registry.get_handle(&event.call_id) else {
+                                return Ok(());
+                            };
+                            if handle
+                                .send_command_async(crate::call::domain::CallCommand::InjectAppEvent {
+                                    event: crate::call::domain::AppEvent::Dtmf {
+                                        digit: event.digit,
+                                    },
+                                })
+                                .await
+                                .is_err()
+                            {
+                                return Ok(());
+                            }
+                            Ok(())
+                        }
+                    },
+                ) => result,
+            };
+            if cancel.is_cancelled() {
+                return;
+            }
+            if after_sequence > before {
+                retry_delay = Duration::from_millis(100);
+            }
+            warn!(
+                owner_node_id,
+                after_sequence,
+                error = %result.expect_err("media event stream is long-lived"),
+                "iveKit media event stream disconnected"
+            );
+            tokio::select! {
+                _ = cancel.cancelled() => return,
+                _ = tokio::time::sleep(retry_delay) => {}
+            }
+            retry_delay = (retry_delay * 2).min(Duration::from_secs(5));
+        }
+    });
+}
+
+fn media_control_runtime_config()
+-> Result<Option<&'static Arc<MediaControlRuntimeConfig>>, &'static str> {
+    match MEDIA_CONTROL_RUNTIME.get_or_init(build_media_control_runtime_config) {
+        Ok(Some(config)) => Ok(Some(config)),
+        Ok(None) => Ok(None),
+        Err(error) => Err(*error),
+    }
+}
+
+fn build_media_control_runtime_config()
+-> Result<Option<Arc<MediaControlRuntimeConfig>>, &'static str> {
+    let Some(endpoint) = required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_ENDPOINT") else {
+        return Ok(None);
+    };
+    MediaControlRuntimeMode::parse(required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_MODE").as_deref())
+        .map_err(|_| "media_control_mode_invalid")?;
+    let failure_policy = MediaControlFailurePolicy::parse(
+        required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_FAILURE_POLICY").as_deref(),
+    )
+    .map_err(|_| "media_control_failure_policy_invalid")?;
+    let endpoint = Url::parse(&endpoint).map_err(|_| "media_control_endpoint_invalid")?;
+    let service_token_file = required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TOKEN_FILE")
+        .ok_or("media_control_token_file_missing")?;
+    let production = parsed_bool_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_PRODUCTION", true)?;
+    let max_inflight = parsed_usize_env(
+        "IVEKIT_RUSTPBX_MEDIA_CONTROL_MAX_INFLIGHT",
+        2_048,
+        1,
+        1_000_000,
+    )?;
+    let request_timeout_ms =
+        parsed_u64_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TIMEOUT_MS", 500, 50, 30_000)?;
+    let max_response_bytes = parsed_usize_env(
+        "IVEKIT_RUSTPBX_MEDIA_CONTROL_MAX_RESPONSE_BYTES",
+        262_144,
+        1_024,
+        1_048_576,
+    )?;
+    for name in [
+        "IVEKIT_RUSTPBX_ROUTE_TENANT_ID",
+        "IVEKIT_RUSTPBX_CELL_ID",
+        "IVEKIT_RUSTPBX_OWNER_NODE_ID",
+        "IVEKIT_RUSTPBX_MEDIA_PROFILE_ID",
+    ] {
+        let value = required_env(name).ok_or("media_control_binding_config_missing")?;
+        if !valid_identifier(&value) {
+            return Err("media_control_binding_config_invalid");
+        }
+    }
+    let client = MediaControlClient::new(crate::ivekit_media_control::MediaControlClientConfig {
+        endpoint,
+        service_token_file: PathBuf::from(service_token_file),
+        tls_identity_file: required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TLS_IDENTITY_FILE")
+            .map(PathBuf::from),
+        tls_ca_file: required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TLS_CA_FILE").map(PathBuf::from),
+        production,
+        max_inflight,
+        request_timeout: Duration::from_millis(request_timeout_ms),
+        max_response_bytes,
+    })
+    .map_err(|_| "media_control_client_invalid")?;
+    Ok(Some(Arc::new(MediaControlRuntimeConfig {
+        executor: Arc::new(client),
+        failure_policy,
+    })))
+}
+
+fn required_env(name: &str) -> Option<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|value| !value.trim().is_empty() && value.trim() == value)
+}
+
+fn parsed_bool_env(name: &str, default: bool) -> Result<bool, &'static str> {
+    match required_env(name).as_deref() {
+        None => Ok(default),
+        Some("true") => Ok(true),
+        Some("false") => Ok(false),
+        Some(_) => Err("media_control_boolean_invalid"),
+    }
+}
+
+fn parsed_usize_env(
+    name: &str,
+    default: usize,
+    minimum: usize,
+    maximum: usize,
+) -> Result<usize, &'static str> {
+    let value = match required_env(name) {
+        Some(value) => value
+            .parse::<usize>()
+            .map_err(|_| "media_control_integer_invalid")?,
+        None => default,
+    };
+    if !(minimum..=maximum).contains(&value) {
+        return Err("media_control_integer_invalid");
+    }
+    Ok(value)
+}
+
+fn parsed_u64_env(
+    name: &str,
+    default: u64,
+    minimum: u64,
+    maximum: u64,
+) -> Result<u64, &'static str> {
+    let value = match required_env(name) {
+        Some(value) => value
+            .parse::<u64>()
+            .map_err(|_| "media_control_integer_invalid")?,
+        None => default,
+    };
+    if !(minimum..=maximum).contains(&value) {
+        return Err("media_control_integer_invalid");
+    }
+    Ok(value)
+}
+
+fn checked_sdp(value: &str) -> Result<(), MediaLifecycleError> {
+    if value.is_empty() || value.len() > MAX_SDP_BYTES || value.contains('\0') {
+        return Err(MediaLifecycleError::InvalidSdp);
+    }
+    Ok(())
+}
+
+fn valid_identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= MAX_IDENTIFIER_BYTES
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'@' | b'/' | b'-')
+        })
+}
+
+fn valid_sip_tag(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= MAX_IDENTIFIER_BYTES
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric()
+                || matches!(
+                    byte,
+                    b'-' | b'.' | b'!' | b'%' | b'*' | b'_' | b'+' | b'`' | b'\'' | b'~'
+                )
+        })
+}
