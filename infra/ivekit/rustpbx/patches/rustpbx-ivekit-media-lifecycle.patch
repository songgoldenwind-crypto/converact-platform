+async fn read_bounded_response(
+    response: reqwest::Response,
+    maximum_bytes: usize,
+) -> Result<Vec<u8>, MediaControlClientError> {
+    if response
+        .content_length()
+        .is_some_and(|length| length > maximum_bytes as u64)
+    {
+        return Err(MediaControlClientError::UnknownAfterTransport {
+            code: "response_too_large",
+        });
+    }
+    let mut stream = response.bytes_stream();
+    let mut body = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(|_| MediaControlClientError::UnknownAfterTransport {
+            code: "media_control_unavailable",
+        })?;
+        append_bounded(&mut body, &chunk, maximum_bytes)
+            .map_err(|code| MediaControlClientError::UnknownAfterTransport { code })?;
+    }
+    Ok(body)
+}
