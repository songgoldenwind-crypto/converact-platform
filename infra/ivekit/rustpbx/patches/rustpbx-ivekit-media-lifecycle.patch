+    #[tokio::test]
+    async fn ordinary_relay_uses_effective_offer_before_outbound_invite() {
+        let executor = executor_with_results(vec![committed(
+            "placeholder",
+            1,
+            "prepared",
+            "v=0\r\na=effective-offer\r\n",
+        )]);
+        let mut lifecycle = IveKitMediaLifecycle::new(
+            binding(),
+            executor.clone(),
+            "caller-tag",
+            Some("v=0\r\na=logical-offer\r\n"),
+        )
+        .unwrap();
+        executor.results.lock()[0] = Ok(committed(
+            &lifecycle
+                .preview_command_id(
+                    MediaControlAction::Offer,
+                    1,
+                    serde_json::json!({
+                        "from_tag": "caller-tag",
+                        "media_profile_id": "g711-relay-v1",
+                        "offer_sdp": "v=0\r\na=logical-offer\r\n"
+                    }),
+                )
+                .unwrap(),
+            1,
+            "prepared",
+            "v=0\r\na=effective-offer\r\n",
+        ));
+
+        let sdp = lifecycle
+            .prepare_ordinary_relay_offer("branch-a")
+            .await
+            .unwrap();
+
+        assert_eq!(sdp, "v=0\r\na=effective-offer\r\n");
+        let commands = executor.commands.lock();
+        assert_eq!(commands.len(), 1);
+        assert!(matches!(commands[0].action, MediaControlAction::Offer));
+        assert_eq!(commands[0].command_sequence, 1);
+        assert_eq!(
+            commands[0]
+                .payload
+                .get("offer_sdp")
+                .and_then(|v| v.as_str()),
+            Some("v=0\r\na=logical-offer\r\n")
+        );
+    }
+
+    #[tokio::test]
+    async fn early_and_final_answer_return_committed_effective_sdp() {
+        let executor = executor_with_results(Vec::new());
+        let mut lifecycle = IveKitMediaLifecycle::new(
+            binding(),
+            executor.clone(),
+            "caller-tag",
+            Some("v=0\r\na=logical-offer\r\n"),
+        )
+        .unwrap();
+        for (action, sequence, state, sdp) in [
+            (
+                MediaControlAction::Offer,
+                1,
+                "prepared",
+                "v=0\r\na=effective-offer\r\n",
+            ),
+            (
+                MediaControlAction::Update,
+                2,
+                "prepared",
+                "v=0\r\na=effective-early\r\n",
+            ),
+            (
+                MediaControlAction::Answer,
+                3,
+                "committed",
+                "v=0\r\na=effective-final\r\n",
+            ),
+        ] {
+            let payload = match action {
+                MediaControlAction::Offer => serde_json::json!({
+                    "from_tag": "caller-tag",
+                    "media_profile_id": "g711-relay-v1",
+                    "offer_sdp": "v=0\r\na=logical-offer\r\n"
+                }),
+                MediaControlAction::Update => serde_json::json!({
+                    "from_tag": "caller-tag",
+                    "negotiation_role": "answer",
+                    "sdp": "v=0\r\na=callee-early\r\n",
+                    "to_tag": "callee-tag"
+                }),
+                MediaControlAction::Answer => serde_json::json!({
+                    "answer_sdp": "v=0\r\na=callee-final\r\n",
+                    "from_tag": "caller-tag",
+                    "to_tag": "callee-tag"
+                }),
+                _ => unreachable!(),
+            };
+            let command_id = lifecycle
+                .preview_command_id(action, sequence, payload)
+                .unwrap();
+            executor
+                .results
+                .lock()
+                .push_back(Ok(committed(&command_id, sequence, state, sdp)));
+        }
+
+        lifecycle
+            .prepare_ordinary_relay_offer("branch-a")
+            .await
+            .unwrap();
+        assert_eq!(
+            lifecycle
+                .commit_early_media("branch-a", "callee-tag", "v=0\r\na=callee-early\r\n",)
+                .await
+                .unwrap(),
+            "v=0\r\na=effective-early\r\n"
+        );
+        assert_eq!(
+            lifecycle
+                .commit_final_answer("branch-a", "callee-tag", "v=0\r\na=callee-final\r\n",)
+                .await
+                .unwrap(),
+            "v=0\r\na=effective-final\r\n"
+        );
+        let commands = executor.commands.lock();
+        assert!(matches!(commands[1].action, MediaControlAction::Update));
+        assert!(matches!(commands[2].action, MediaControlAction::Answer));
+    }
+
+    #[tokio::test]
+    async fn mismatched_committed_snapshot_is_treated_as_unknown() {
+        let executor = executor_with_results(Vec::new());
+        let mut lifecycle = IveKitMediaLifecycle::new(
+            binding(),
+            executor.clone(),
+            "caller-tag",
+            Some("v=0\r\na=logical-offer\r\n"),
+        )
+        .unwrap();
+        let payload = serde_json::json!({
+            "from_tag": "caller-tag",
+            "media_profile_id": "g711-relay-v1",
+            "offer_sdp": "v=0\r\na=logical-offer\r\n"
+        });
+        let command_id = lifecycle
+            .preview_command_id(MediaControlAction::Offer, 1, payload)
+            .unwrap();
+        let mut result = committed(&command_id, 1, "prepared", "v=0\r\na=effective-offer\r\n");
+        if let MediaControlResult::Committed { session, .. } = &mut result {
+            session.owner_epoch = "4294967298".to_string();
+        }
+        executor.results.lock().push_back(Ok(result));
+
+        assert_eq!(
+            lifecycle.prepare_ordinary_relay_offer("branch-a").await,
+            Err(MediaLifecycleError::OutcomeUnknown)
+        );
+        assert!(lifecycle.reconcile_required());
+    }
