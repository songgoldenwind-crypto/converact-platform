+pub struct IveKitMediaLifecycle {
+    binding: MediaAdmissionBinding,
+    executor: Arc<dyn MediaControlExecutor>,
+    from_tag: String,
+    callee: PerLegMediaState,
+}
+
+impl IveKitMediaLifecycle {
+    pub fn new(
+        binding: MediaAdmissionBinding,
+        executor: Arc<dyn MediaControlExecutor>,
+        from_tag: &str,
+        caller_offer: Option<&str>,
+    ) -> Result<Self, MediaLifecycleError> {
+        if !valid_sip_tag(from_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("from_tag"));
+        }
+        Ok(Self {
+            binding,
+            executor,
+            from_tag: from_tag.to_string(),
+            callee: PerLegMediaState::new("callee", caller_offer)?,
+        })
+    }
+
+    pub fn state(&self) -> NegotiationState {
+        self.callee.state()
+    }
+
+    pub fn reconcile_required(&self) -> bool {
+        self.callee.reconcile_required()
+    }
+
+    pub async fn prepare_ordinary_relay_offer(
+        &mut self,
+        branch_id: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        let mutation = self.callee.begin_offer(branch_id)?;
+        let offer_sdp = self
+            .callee
+            .logical_sdp()
+            .ok_or(MediaLifecycleError::InvalidTransition)?
+            .to_string();
+        let payload = serde_json::json!({
+            "from_tag": self.from_tag,
+            "media_profile_id": self.binding.media_profile_id(),
+            "offer_sdp": offer_sdp,
+        });
+        let command = self.build_command(MediaControlAction::Offer, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["prepared"])?;
+        self.callee
+            .commit_offer(branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn commit_early_media(
+        &mut self,
+        branch_id: &str,
+        to_tag: &str,
+        callee_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(callee_sdp)?;
+        if !valid_sip_tag(to_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("to_tag"));
+        }
+        let mutation = self.callee.begin_early_media(branch_id)?;
+        let payload = serde_json::json!({
+            "from_tag": self.from_tag,
+            "negotiation_role": "answer",
+            "sdp": callee_sdp,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Update, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["prepared", "committed"])?;
+        self.callee
+            .commit_early_media(branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    pub async fn commit_final_answer(
+        &mut self,
+        branch_id: &str,
+        to_tag: &str,
+        callee_sdp: &str,
+    ) -> Result<String, MediaLifecycleError> {
+        checked_sdp(callee_sdp)?;
+        if !valid_sip_tag(to_tag) {
+            return Err(MediaLifecycleError::InvalidBinding("to_tag"));
+        }
+        let mutation = self.callee.begin_final_answer(branch_id)?;
+        let payload = serde_json::json!({
+            "answer_sdp": callee_sdp,
+            "from_tag": self.from_tag,
+            "to_tag": to_tag,
+        });
+        let command = self.build_command(MediaControlAction::Answer, mutation.sequence, payload)?;
+        let session = self.execute_mutation(&command).await?;
+        self.require_committed_session(&command, &session, &["committed"])?;
+        self.callee
+            .commit_final_answer(branch_id, &session.effective_sdp)?;
+        Ok(session.effective_sdp)
+    }
+
+    #[cfg(test)]
+    fn preview_command_id(
+        &self,
+        action: MediaControlAction,
+        sequence: u32,
+        payload: Value,
+    ) -> Result<String, MediaLifecycleError> {
+        Ok(self.build_command(action, sequence, payload)?.command_id)
+    }
+
+    fn build_command(
+        &self,
+        action: MediaControlAction,
+        sequence: u32,
+        payload: Value,
+    ) -> Result<MediaControlCommand, MediaLifecycleError> {
+        let payload = match payload {
+            Value::Object(payload) => payload,
+            _ => return Err(MediaLifecycleError::CommandInvalid),
+        };
+        let payload_hash =
+            payload_hash(&payload).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+        let expires_at = (chrono::Utc::now() + chrono::Duration::seconds(30))
+            .to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+        let leg_id = self.callee.leg_id().to_string();
+        let media_reservation_id = self.binding.media_reservation_id(&leg_id)?;
+        let mut command = MediaControlCommand {
+            protocol_version: MEDIA_CONTROL_PROTOCOL_VERSION.to_string(),
+            action,
+            command_id: "pending".to_string(),
+            tenant_id: self.binding.tenant_id().to_string(),
+            call_id: self.binding.call_id().to_string(),
+            leg_id: leg_id.clone(),
+            cell_id: self.binding.cell_id().to_string(),
+            owner_node_id: self.binding.owner_node_id().to_string(),
+            owner_epoch: self.binding.owner_epoch().to_string(),
+            media_reservation_id,
+            command_sequence: sequence,
+            idempotency_key: format!(
+                "rustpbx/{}/{}/{}/{}/{}",
+                self.binding.cell_id(),
+                self.binding.call_id(),
+                leg_id,
+                self.binding.owner_epoch(),
+                sequence
+            ),
+            expires_at,
+            payload,
+            payload_hash,
+        };
+        command.command_id =
+            command_id_for(&command).map_err(|_| MediaLifecycleError::CommandInvalid)?;
+        Ok(command)
+    }
+
+    async fn execute_mutation(
+        &mut self,
+        command: &MediaControlCommand,
+    ) -> Result<MediaSessionSnapshot, MediaLifecycleError> {
+        match self.executor.execute(command).await {
+            Ok(MediaControlResult::Committed {
+                command_id,
+                session,
+                ..
+            })
+            | Ok(MediaControlResult::Replayed {
+                command_id,
+                session,
+                ..
+            }) if command_id == command.command_id => Ok(session),
+            Ok(MediaControlResult::Unknown { command_id, .. })
+                if command_id == command.command_id =>
+            {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Ok(MediaControlResult::RejectedCapacity { .. })
+            | Ok(MediaControlResult::RejectedEpoch { .. })
+            | Ok(MediaControlResult::TerminalError { .. }) => {
+                self.callee.reject_pending()?;
+                Err(MediaLifecycleError::ControlRejected)
+            }
+            Ok(_) => {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(MediaControlClientError::UnknownAfterTransport { .. }) => {
+                self.callee.mark_unknown(&command.command_id)?;
+                Err(MediaLifecycleError::OutcomeUnknown)
+            }
+            Err(_) => {
+                self.callee.reject_pending()?;
+                Err(MediaLifecycleError::ControlRejected)
+            }
+        }
+    }
+
+    fn require_committed_session(
+        &mut self,
+        command: &MediaControlCommand,
+        session: &MediaSessionSnapshot,
+        allowed_states: &[&str],
+    ) -> Result<(), MediaLifecycleError> {
+        if require_session_identity(&self.binding, command, session, allowed_states).is_err() {
+            self.callee.mark_unknown(&command.command_id)?;
+            return Err(MediaLifecycleError::OutcomeUnknown);
+        }
+        Ok(())
+    }
+}
+
+fn require_session_identity(
+    binding: &MediaAdmissionBinding,
+    command: &MediaControlCommand,
+    session: &MediaSessionSnapshot,
+    allowed_states: &[&str],
+) -> Result<(), MediaLifecycleError> {
+    if session.media_reservation_id != command.media_reservation_id
+        || session.call_id != binding.call_id()
+        || session.owner_epoch != binding.owner_epoch()
+        || session.last_sequence != command.command_sequence
+        || !allowed_states.contains(&session.state.as_str())
+        || session.effective_sdp.is_empty()
+        || session.effective_sdp.len() > MAX_SDP_BYTES
+        || session.effective_sdp.contains('\0')
+    {
+        return Err(MediaLifecycleError::OutcomeUnknown);
+    }
+    Ok(())
+}
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum MediaLifecycleError {
+    #[error("media_binding_invalid:{0}")]
+    InvalidBinding(&'static str),
+    #[error("media_leg_invalid")]
+    InvalidLeg,
+    #[error("media_branch_invalid")]
+    InvalidBranch,
+    #[error("media_branch_capacity")]
+    BranchCapacity,
+    #[error("media_winner_conflict")]
+    WinnerConflict,
+    #[error("media_sdp_invalid")]
+    InvalidSdp,
+    #[error("media_transition_invalid")]
+    InvalidTransition,
+    #[error("media_reconcile_required")]
+    ReconcileRequired,
+    #[error("media_sequence_exhausted")]
+    SequenceExhausted,
+    #[error("media_command_invalid")]
+    CommandInvalid,
+    #[error("media_control_rejected")]
+    ControlRejected,
+    #[error("media_control_outcome_unknown")]
+    OutcomeUnknown,
+    #[error("media_control_configuration_invalid")]
+    ConfigurationInvalid,
+}
+
+pub fn explicit_fallback_allowed(error: &MediaLifecycleError) -> bool {
+    matches!(error, MediaLifecycleError::ControlRejected)
+}
+
+struct MediaControlRuntimeConfig {
+    executor: Arc<MediaControlClient>,
+    failure_policy: MediaControlFailurePolicy,
+}
+
+static MEDIA_CONTROL_RUNTIME: OnceLock<
+    Result<Option<Arc<MediaControlRuntimeConfig>>, &'static str>,
+> = OnceLock::new();
+
+pub enum IveKitMediaRuntime {
+    Disabled,
+    Ready {
+        lifecycle: IveKitMediaLifecycle,
+        failure_policy: MediaControlFailurePolicy,
+    },
+    FailClosed {
+        error_code: &'static str,
+    },
+}
+
+impl IveKitMediaRuntime {
+    pub fn bootstrap(session_id: &str, caller_from_tag: &str, caller_offer: Option<&str>) -> Self {
+        let config = match media_control_runtime_config() {
+            Ok(Some(config)) => config,
+            Ok(None) => return Self::Disabled,
+            Err(error_code) => return Self::FailClosed { error_code },
+        };
+        let Some(owner) = crate::ivekit_owner::owner_contract(session_id) else {
+            return Self::FailClosed {
+                error_code: "media_control_owner_binding_missing",
+            };
+        };
+        let binding = match MediaAdmissionBinding::new(
+            &required_env("IVEKIT_RUSTPBX_ROUTE_TENANT_ID").unwrap_or_default(),
+            &owner.interaction_id,
+            &required_env("IVEKIT_RUSTPBX_CELL_ID").unwrap_or_default(),
+            &required_env("IVEKIT_RUSTPBX_OWNER_NODE_ID").unwrap_or_default(),
+            &owner.owner_epoch,
+            &owner.reservation_id,
+            &required_env("IVEKIT_RUSTPBX_MEDIA_PROFILE_ID").unwrap_or_default(),
+        ) {
+            Ok(binding) => binding,
+            Err(_) => {
+                return Self::FailClosed {
+                    error_code: "media_control_admission_binding_invalid",
+                };
+            }
+        };
+        match IveKitMediaLifecycle::new(
+            binding,
+            config.executor.clone(),
+            caller_from_tag,
+            caller_offer,
+        ) {
+            Ok(lifecycle) => Self::Ready {
+                lifecycle,
+                failure_policy: config.failure_policy,
+            },
+            Err(_) => Self::FailClosed {
+                error_code: "media_control_session_binding_invalid",
+            },
+        }
+    }
+
+    pub fn is_ready(&self) -> bool {
+        matches!(self, Self::Ready { .. })
+    }
+
+    pub fn failure_policy(&self) -> MediaControlFailurePolicy {
+        match self {
+            Self::Ready { failure_policy, .. } => *failure_policy,
+            Self::Disabled | Self::FailClosed { .. } => MediaControlFailurePolicy::FailClosed,
+        }
+    }
+
+    pub fn lifecycle_mut(&mut self) -> Option<&mut IveKitMediaLifecycle> {
+        match self {
+            Self::Ready { lifecycle, .. } => Some(lifecycle),
+            Self::Disabled | Self::FailClosed { .. } => None,
+        }
+    }
+
+    pub fn failure_code(&self) -> Option<&'static str> {
+        match self {
+            Self::FailClosed { error_code } => Some(*error_code),
+            Self::Disabled | Self::Ready { .. } => None,
+        }
+    }
+}
+
+pub fn media_control_requested() -> bool {
+    required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_ENDPOINT").is_some()
+}
+
+fn media_control_runtime_config()
+-> Result<Option<&'static Arc<MediaControlRuntimeConfig>>, &'static str> {
+    match MEDIA_CONTROL_RUNTIME.get_or_init(build_media_control_runtime_config) {
+        Ok(Some(config)) => Ok(Some(config)),
+        Ok(None) => Ok(None),
+        Err(error) => Err(*error),
+    }
+}
+
+fn build_media_control_runtime_config()
+-> Result<Option<Arc<MediaControlRuntimeConfig>>, &'static str> {
+    let Some(endpoint) = required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_ENDPOINT") else {
+        return Ok(None);
+    };
+    MediaControlRuntimeMode::parse(required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_MODE").as_deref())
+        .map_err(|_| "media_control_mode_invalid")?;
+    let failure_policy = MediaControlFailurePolicy::parse(
+        required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_FAILURE_POLICY").as_deref(),
+    )
+    .map_err(|_| "media_control_failure_policy_invalid")?;
+    let endpoint = Url::parse(&endpoint).map_err(|_| "media_control_endpoint_invalid")?;
+    let service_token_file = required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TOKEN_FILE")
+        .ok_or("media_control_token_file_missing")?;
+    let production = parsed_bool_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_PRODUCTION", true)?;
+    let max_inflight = parsed_usize_env(
+        "IVEKIT_RUSTPBX_MEDIA_CONTROL_MAX_INFLIGHT",
+        2_048,
+        1,
+        1_000_000,
+    )?;
+    let request_timeout_ms =
+        parsed_u64_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TIMEOUT_MS", 500, 50, 30_000)?;
+    let max_response_bytes = parsed_usize_env(
+        "IVEKIT_RUSTPBX_MEDIA_CONTROL_MAX_RESPONSE_BYTES",
+        262_144,
+        1_024,
+        1_048_576,
+    )?;
+    for name in [
+        "IVEKIT_RUSTPBX_ROUTE_TENANT_ID",
+        "IVEKIT_RUSTPBX_CELL_ID",
+        "IVEKIT_RUSTPBX_OWNER_NODE_ID",
+        "IVEKIT_RUSTPBX_MEDIA_PROFILE_ID",
+    ] {
+        let value = required_env(name).ok_or("media_control_binding_config_missing")?;
+        if !valid_identifier(&value) {
+            return Err("media_control_binding_config_invalid");
+        }
+    }
+    let client = MediaControlClient::new(crate::ivekit_media_control::MediaControlClientConfig {
+        endpoint,
+        service_token_file: PathBuf::from(service_token_file),
+        tls_identity_file: required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TLS_IDENTITY_FILE")
+            .map(PathBuf::from),
+        tls_ca_file: required_env("IVEKIT_RUSTPBX_MEDIA_CONTROL_TLS_CA_FILE").map(PathBuf::from),
+        production,
+        max_inflight,
+        request_timeout: Duration::from_millis(request_timeout_ms),
+        max_response_bytes,
+    })
+    .map_err(|_| "media_control_client_invalid")?;
+    Ok(Some(Arc::new(MediaControlRuntimeConfig {
+        executor: Arc::new(client),
+        failure_policy,
+    })))
+}
+
+fn required_env(name: &str) -> Option<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|value| !value.trim().is_empty() && value.trim() == value)
+}
+
+fn parsed_bool_env(name: &str, default: bool) -> Result<bool, &'static str> {
+    match required_env(name).as_deref() {
+        None => Ok(default),
+        Some("true") => Ok(true),
+        Some("false") => Ok(false),
+        Some(_) => Err("media_control_boolean_invalid"),
+    }
+}
+
+fn parsed_usize_env(
+    name: &str,
+    default: usize,
+    minimum: usize,
+    maximum: usize,
+) -> Result<usize, &'static str> {
+    let value = match required_env(name) {
+        Some(value) => value
+            .parse::<usize>()
+            .map_err(|_| "media_control_integer_invalid")?,
+        None => default,
+    };
+    if !(minimum..=maximum).contains(&value) {
+        return Err("media_control_integer_invalid");
+    }
+    Ok(value)
+}
+
+fn parsed_u64_env(
+    name: &str,
+    default: u64,
+    minimum: u64,
+    maximum: u64,
+) -> Result<u64, &'static str> {
+    let value = match required_env(name) {
+        Some(value) => value
+            .parse::<u64>()
+            .map_err(|_| "media_control_integer_invalid")?,
+        None => default,
+    };
+    if !(minimum..=maximum).contains(&value) {
+        return Err("media_control_integer_invalid");
+    }
+    Ok(value)
+}
+
+fn checked_sdp(value: &str) -> Result<(), MediaLifecycleError> {
+    if value.is_empty() || value.len() > MAX_SDP_BYTES || value.contains('\0') {
+        return Err(MediaLifecycleError::InvalidSdp);
+    }
+    Ok(())
+}
+
+fn valid_identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= MAX_IDENTIFIER_BYTES
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'@' | b'/' | b'-')
+        })
+}
+
+fn valid_sip_tag(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= MAX_IDENTIFIER_BYTES
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric()
+                || matches!(
+                    byte,
+                    b'-' | b'.' | b'!' | b'%' | b'*' | b'_' | b'+' | b'`' | b'\'' | b'~'
+                )
+        })
+}
