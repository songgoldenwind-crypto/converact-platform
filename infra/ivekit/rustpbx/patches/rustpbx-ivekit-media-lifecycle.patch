+    async fn close_after_early_and_final_media_is_idempotent() {
+        let executor = executor_with_results(Vec::new());
+        let mut lifecycle = IveKitMediaLifecycle::new(
+            binding(),
+            executor.clone(),
+            "caller-tag",
+            Some("v=0\r\na=logical-offer\r\n"),
+        )
+        .unwrap();
+        for (action, sequence, state, payload, sdp) in [
+            (
+                MediaControlAction::Offer,
+                1,
+                "prepared",
+                serde_json::json!({
+                    "from_tag": "caller-tag",
+                    "media_profile_id": "g711-relay-v1",
+                    "offer_sdp": "v=0\r\na=logical-offer\r\n"
+                }),
+                "v=0\r\na=effective-offer\r\n",
+            ),
+            (
+                MediaControlAction::Update,
+                2,
+                "prepared",
+                serde_json::json!({
+                    "from_tag": "caller-tag",
+                    "negotiation_role": "answer",
+                    "sdp": "v=0\r\na=callee-early\r\n",
+                    "to_tag": "callee-tag"
+                }),
+                "v=0\r\na=effective-early\r\n",
+            ),
+            (
+                MediaControlAction::Answer,
+                3,
+                "committed",
+                serde_json::json!({
+                    "answer_sdp": "v=0\r\na=callee-final\r\n",
+                    "from_tag": "caller-tag",
+                    "to_tag": "callee-tag"
+                }),
+                "v=0\r\na=effective-final\r\n",
+            ),
+        ] {
+            let command_id = lifecycle
+                .preview_command_id(action, sequence, payload)
+                .unwrap();
+            executor
+                .results
+                .lock()
+                .push_back(Ok(committed(&command_id, sequence, state, sdp)));
+        }
+        lifecycle
+            .prepare_ordinary_relay_offer("branch-a")
+            .await
+            .unwrap();
+        lifecycle
+            .commit_early_media("branch-a", "callee-tag", "v=0\r\na=callee-early\r\n")
+            .await
+            .unwrap();
+        lifecycle
+            .commit_final_answer("branch-a", "callee-tag", "v=0\r\na=callee-final\r\n")
+            .await
+            .unwrap();
+        let delete_id = lifecycle
+            .preview_command_id(
+                MediaControlAction::Delete,
+                4,
+                serde_json::json!({
+                    "from_tag": "caller-tag",
+                    "to_tag": "callee-tag"
+                }),
+            )
+            .unwrap();
+        executor.results.lock().push_back(Ok(committed(
+            &delete_id,
+            4,
+            "closed",
+            "v=0\r\na=effective-final\r\n",
+        )));
+
+        assert_eq!(
+            lifecycle.close_media().await.unwrap(),
+            MediaCloseOutcome::Closed
+        );
+        assert_eq!(
+            lifecycle.close_media().await.unwrap(),
+            MediaCloseOutcome::AlreadyClosed
+        );
+        assert_eq!(executor.commands.lock().len(), 4);
+    }
+}
