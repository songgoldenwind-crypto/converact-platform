+    struct StubExecutor {
+        commands: Mutex<Vec<MediaControlCommand>>,
+        results: Mutex<VecDeque<Result<MediaControlResult, MediaControlClientError>>>,
+    }
+
+    #[async_trait::async_trait]
+    impl MediaControlExecutor for StubExecutor {
+        async fn execute(
+            &self,
+            command: &MediaControlCommand,
+        ) -> Result<MediaControlResult, MediaControlClientError> {
+            self.commands.lock().push(command.clone());
+            self.results
+                .lock()
+                .pop_front()
+                .expect("stub result is required")
+        }
+    }
+
+    fn committed(
+        command_id: &str,
+        sequence: u32,
+        state: &str,
+        effective_sdp: &str,
+    ) -> MediaControlResult {
+        MediaControlResult::Committed {
+            protocol_version: MEDIA_CONTROL_PROTOCOL_VERSION.to_string(),
+            command_id: command_id.to_string(),
+            session: MediaSessionSnapshot {
+                media_reservation_id: "admission-a/callee".to_string(),
+                call_id: "call-a".to_string(),
+                owner_epoch: "4294967297".to_string(),
+                last_sequence: sequence,
+                state: state.to_string(),
+                transport_session_id: "rtpengine-a".to_string(),
+                effective_sdp: effective_sdp.to_string(),
+                expires_at: "2026-07-26T12:00:30.000Z".to_string(),
+                updated_at: "2026-07-26T12:00:00.000Z".to_string(),
+            },
+        }
+    }
+
+    fn executor_with_results(results: Vec<MediaControlResult>) -> Arc<StubExecutor> {
+        Arc::new(StubExecutor {
+            commands: Mutex::new(Vec::new()),
+            results: Mutex::new(results.into_iter().map(Ok).collect()),
+        })
+    }
