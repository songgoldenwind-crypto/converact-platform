+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MediaAdmissionBinding {
+    tenant_id: String,
+    call_id: String,
+    cell_id: String,
+    owner_node_id: String,
+    owner_epoch: String,
+    admission_reservation_id: String,
+    media_profile_id: String,
+}
+
+impl MediaAdmissionBinding {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        tenant_id: &str,
+        call_id: &str,
+        cell_id: &str,
+        owner_node_id: &str,
+        owner_epoch: &str,
+        admission_reservation_id: &str,
+        media_profile_id: &str,
+    ) -> Result<Self, MediaLifecycleError> {
+        for (name, value) in [
+            ("tenant_id", tenant_id),
+            ("call_id", call_id),
+            ("cell_id", cell_id),
+            ("owner_node_id", owner_node_id),
+            ("admission_reservation_id", admission_reservation_id),
+            ("media_profile_id", media_profile_id),
+        ] {
+            valid_identifier(value)
+                .then_some(())
+                .ok_or(MediaLifecycleError::InvalidBinding(name))?;
+        }
+        owner_epoch
+            .parse::<u64>()
+            .ok()
+            .filter(|value| *value > 0)
+            .ok_or(MediaLifecycleError::InvalidBinding("owner_epoch"))?;
+        Ok(Self {
+            tenant_id: tenant_id.to_string(),
+            call_id: call_id.to_string(),
+            cell_id: cell_id.to_string(),
+            owner_node_id: owner_node_id.to_string(),
+            owner_epoch: owner_epoch.to_string(),
+            admission_reservation_id: admission_reservation_id.to_string(),
+            media_profile_id: media_profile_id.to_string(),
+        })
+    }
+
+    pub fn owner_epoch(&self) -> &str {
+        &self.owner_epoch
+    }
+
+    pub fn tenant_id(&self) -> &str {
+        &self.tenant_id
+    }
+
+    pub fn call_id(&self) -> &str {
+        &self.call_id
+    }
+
+    pub fn cell_id(&self) -> &str {
+        &self.cell_id
+    }
+
+    pub fn owner_node_id(&self) -> &str {
+        &self.owner_node_id
+    }
+
+    pub fn media_profile_id(&self) -> &str {
+        &self.media_profile_id
+    }
+
+    pub fn media_reservation_id(&self, leg_id: &str) -> Result<String, MediaLifecycleError> {
+        if !valid_identifier(leg_id) {
+            return Err(MediaLifecycleError::InvalidLeg);
+        }
+        let value = format!("{}/{leg_id}", self.admission_reservation_id);
+        if value.len() > MAX_IDENTIFIER_BYTES {
+            return Err(MediaLifecycleError::InvalidLeg);
+        }
+        Ok(value)
+    }
+}
