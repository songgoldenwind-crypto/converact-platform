+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MediaExecutionFacts {
+    pub media_control_enabled: bool,
+    pub media_proxy_enabled: bool,
+    pub explicit_bypass: bool,
+    pub application_flow: bool,
+    pub queue_flow: bool,
+    pub parallel_fork: bool,
+    pub recording: bool,
+    pub audio_tap: bool,
+    pub caller_webrtc: bool,
+    pub callee_webrtc: bool,
+    pub transcoding: bool,
+    pub offerless: bool,
+}
+
+impl MediaExecutionFacts {
+    pub fn ordinary() -> Self {
+        Self {
+            media_control_enabled: true,
+            media_proxy_enabled: true,
+            explicit_bypass: false,
+            application_flow: false,
+            queue_flow: false,
+            parallel_fork: false,
+            recording: false,
+            audio_tap: false,
+            caller_webrtc: false,
+            callee_webrtc: false,
+            transcoding: false,
+            offerless: false,
+        }
+    }
+
+    #[cfg(test)]
+    fn for_local_reason(reason: LocalMediaReason) -> Self {
+        let mut facts = Self::ordinary();
+        match reason {
+            LocalMediaReason::Ivr | LocalMediaReason::Conference => facts.application_flow = true,
+            LocalMediaReason::Queue => facts.queue_flow = true,
+            LocalMediaReason::Recording => facts.recording = true,
+            LocalMediaReason::AudioTap => facts.audio_tap = true,
+            LocalMediaReason::WebRtcBridge => facts.caller_webrtc = true,
+            LocalMediaReason::Transcoding => facts.transcoding = true,
+            LocalMediaReason::ParallelFork => facts.parallel_fork = true,
+            LocalMediaReason::Offerless => facts.offerless = true,
+            LocalMediaReason::MediaControlDisabled => facts.media_control_enabled = false,
+        }
+        facts
+    }
+}
+
+pub fn classify_media_execution(facts: &MediaExecutionFacts) -> MediaExecutionProfile {
+    if facts.explicit_bypass || !facts.media_proxy_enabled {
+        return MediaExecutionProfile::ExplicitBypass;
+    }
+    if !facts.media_control_enabled {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::MediaControlDisabled);
+    }
+    if facts.queue_flow {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::Queue);
+    }
+    if facts.application_flow {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::Ivr);
+    }
+    if facts.parallel_fork {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::ParallelFork);
+    }
+    if facts.recording {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::Recording);
+    }
+    if facts.audio_tap {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::AudioTap);
+    }
+    if facts.caller_webrtc || facts.callee_webrtc {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::WebRtcBridge);
+    }
+    if facts.transcoding {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::Transcoding);
+    }
+    if facts.offerless {
+        return MediaExecutionProfile::LocalMediaGraph(LocalMediaReason::Offerless);
+    }
+    MediaExecutionProfile::OrdinaryRelay
+}
