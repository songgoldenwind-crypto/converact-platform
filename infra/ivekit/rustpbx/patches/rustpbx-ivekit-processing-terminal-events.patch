+#[derive(Clone, Debug, Deserialize, PartialEq, Eq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct MediaControlTerminalEvent {
+    pub protocol_version: String,
+    pub event_sequence: u64,
+    pub event_type: String,
+    pub event_id: String,
+    pub source: String,
+    pub source_event_sequence: String,
+    pub tenant_id: String,
+    pub call_id: String,
+    pub cell_id: String,
+    pub owner_node_id: String,
+    pub owner_epoch: String,
+    pub media_reservation_id: String,
+    pub command_id: String,
+    pub occurred_at_ms: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub prompt_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub digits: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub reason: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub minimum_satisfied: Option<bool>,
+}
+
+impl MediaControlTerminalEvent {
+    pub fn validate_for_owner(&self, owner_node_id: &str) -> Result<(), &'static str> {
+        if self.protocol_version != MEDIA_CONTROL_EVENT_PROTOCOL_VERSION
+            || self.event_sequence == 0
+            || self.source != "processing"
+            || self.occurred_at_ms == 0
+            || !valid_identifier(&self.event_id, "event_id").is_ok()
+            || !valid_identifier(&self.tenant_id, "tenant_id").is_ok()
+            || !valid_identifier(&self.call_id, "call_id").is_ok()
+            || !valid_identifier(&self.cell_id, "cell_id").is_ok()
+            || !valid_identifier(&self.owner_node_id, "owner_node_id").is_ok()
+            || !valid_identifier(&self.media_reservation_id, "media_reservation_id").is_ok()
+            || !valid_identifier(&self.command_id, "command_id").is_ok()
+            || self
+                .source_event_sequence
+                .parse::<u64>()
+                .ok()
+                .filter(|value| *value > 0)
+                .is_none()
+            || self
+                .owner_epoch
+                .parse::<u64>()
+                .ok()
+                .filter(|value| *value > 0)
+                .is_none()
+            || !self.valid_variant()
+        {
+            return Err("media_event_invalid");
+        }
+        if self.owner_node_id != owner_node_id {
+            return Err("media_event_owner_mismatch");
+        }
+        Ok(())
+    }
+
+    fn valid_variant(&self) -> bool {
+        match self.event_type.as_str() {
+            "playback_completed" => {
+                self.prompt_id
+                    .as_deref()
+                    .is_some_and(|value| valid_identifier(value, "prompt_id").is_ok())
+                    && self.digits.is_none()
+                    && self.reason.is_none()
+                    && self.minimum_satisfied.is_none()
+            }
+            "playback_stopped" => {
+                self.prompt_id
+                    .as_deref()
+                    .is_some_and(|value| valid_identifier(value, "prompt_id").is_ok())
+                    && self.reason.as_deref().is_some_and(|value| {
+                        matches!(value, "explicit" | "barge_in" | "session_removed")
+                    })
+                    && self.digits.is_none()
+                    && self.minimum_satisfied.is_none()
+            }
+            "gather_completed" => {
+                self.prompt_id.is_none()
+                    && self.digits.as_deref().is_some_and(valid_gather_digits)
+                    && self.reason.as_deref().is_some_and(|value| {
+                        matches!(
+                            value,
+                            "maximum_digits"
+                                | "terminator"
+                                | "timeout"
+                                | "explicit_stop"
+                                | "session_removed"
+                        )
+                    })
+                    && self.minimum_satisfied.is_some()
+            }
+            _ => false,
+        }
+    }
+}
+
+fn valid_gather_digits(value: &str) -> bool {
+    value.len() <= 1_024
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || matches!(byte, b'*' | b'#' | b'A'..=b'D'))
+}
+
+pub struct MediaControlTerminalEventDecoder {
+    line: Vec<u8>,
+    max_line_bytes: usize,
+}
+
+impl MediaControlTerminalEventDecoder {
+    pub fn new(max_line_bytes: usize) -> Result<Self, &'static str> {
+        if !(256..=1_048_576).contains(&max_line_bytes) {
+            return Err("media_event_line_limit_invalid");
+        }
+        Ok(Self {
+            line: Vec::with_capacity(max_line_bytes.min(8_192)),
+            max_line_bytes,
+        })
+    }
+
+    pub fn push(&mut self, chunk: &[u8]) -> Result<Vec<MediaControlTerminalEvent>, &'static str> {
+        let mut events = Vec::new();
+        for byte in chunk {
+            if *byte != b'\n' {
+                if self.line.len() >= self.max_line_bytes {
+                    return Err("media_event_line_too_large");
+                }
+                self.line.push(*byte);
+                continue;
+            }
+            if self.line.last() == Some(&b'\r') {
+                self.line.pop();
+            }
+            if self.line.is_empty() {
+                continue;
+            }
+            let event: MediaControlTerminalEvent =
+                serde_json::from_slice(&self.line).map_err(|_| "media_event_invalid")?;
+            event
+                .validate_for_owner(&event.owner_node_id)
+                .map_err(|_| "media_event_invalid")?;
+            events.push(event);
+            self.line.clear();
+        }
+        Ok(events)
+    }
+}
