+/// An outbound INVITE whose dialog identity exists but whose request has not
+/// been sent. This permits an external media controller to transform the SDP
+/// after the real local dialog tag is known and before any signaling is visible.
+pub struct PreparedClientInvite {
+    dialog_layer_inner: DialogLayerInnerRef,
+    dialog: ClientInviteDialog,
+    tx: Transaction,
+}
+
+impl PreparedClientInvite {
+    pub fn dialog_id(&self) -> DialogId {
+        self.dialog.id()
+    }
+
+    pub fn logical_offer(&self) -> &[u8] {
+        &self.tx.original.body
+    }
+
+    pub fn replace_uncommitted_invite_offer(&mut self, effective_offer: Vec<u8>) -> Result<()> {
+        if !matches!(self.dialog.state(), DialogState::Calling(_)) {
+            return Err(crate::Error::Error(
+                "prepared INVITE is no longer uncommitted".to_string(),
+            ));
+        }
+        let content_length = effective_offer.len() as u32;
+        self.tx.original.body = effective_offer.clone();
+        self.tx
+            .original
+            .headers
+            .unique_push(crate::sip::Header::ContentLength(content_length.into()));
+
+        let mut initial_request = self.dialog.inner.initial_request.lock();
+        initial_request.body = effective_offer;
+        initial_request
+            .headers
+            .unique_push(crate::sip::Header::ContentLength(content_length.into()));
+        Ok(())
+    }
+
+    pub async fn send(self) -> Result<(ClientInviteDialog, Option<Response>)> {
+        let id = self.dialog.id();
+        self.dialog_layer_inner
+            .dialogs
+            .insert(id.to_string(), Dialog::ClientInvite(self.dialog.clone()));
+
+        debug!(%id, "prepared client invite dialog created");
+        let mut guard = DialogGuardForUnconfirmed {
+            dialog_layer_inner: &self.dialog_layer_inner,
+            id: &id,
+            invite_tx: Some(self.tx),
+        };
+        let tx = guard
+            .invite_tx
+            .as_mut()
+            .expect("prepared INVITE transaction must be available");
+        let result = self.dialog.process_invite(tx).boxed().await;
+        self.dialog_layer_inner.dialogs.remove(&id.to_string());
+
+        match result {
+            Ok((new_dialog_id, response)) => {
+                if response.as_ref().is_some_and(|value| {
+                    value.status_code.kind() == crate::sip::StatusCodeKind::Successful
+                }) {
+                    debug!(
+                        "prepared client invite dialog confirmed: {} => {}",
+                        id, new_dialog_id
+                    );
+                    self.dialog_layer_inner.dialogs.insert(
+                        new_dialog_id.to_string(),
+                        Dialog::ClientInvite(self.dialog.clone()),
+                    );
+                }
+                Ok((self.dialog, response))
+            }
+            Err(error) => Err(error),
+        }
+    }
+}
+
 impl DialogLayer {
+    pub fn prepare_invite(
+        &self,
+        opt: InviteOption,
+        state_sender: DialogStateSender,
+    ) -> Result<PreparedClientInvite> {
+        let (dialog, tx) = self.create_client_invite_dialog(opt, state_sender)?;
+        Ok(PreparedClientInvite {
+            dialog_layer_inner: self.inner.clone(),
+            dialog,
+            tx,
+        })
+    }
