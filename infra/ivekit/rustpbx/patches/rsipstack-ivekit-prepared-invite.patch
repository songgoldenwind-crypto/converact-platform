+#[cfg(test)]
+mod prepared_invite_tests {
+    use super::*;
+    use crate::transport::{udp::UdpConnection, TransportLayer};
+    use crate::EndpointBuilder;
+    use tokio::sync::mpsc::unbounded_channel;
+    use tokio_util::sync::CancellationToken;
+
+    async fn prepared_invite(logical_offer: &[u8]) -> PreparedClientInvite {
+        let cancel_token = CancellationToken::new();
+        let transport = TransportLayer::new(cancel_token.child_token());
+        let udp = UdpConnection::create_connection(
+            "127.0.0.1:0".parse().unwrap(),
+            None,
+            Some(cancel_token.child_token()),
+        )
+        .await
+        .unwrap();
+        transport.add_transport(udp.into());
+        let endpoint = EndpointBuilder::new()
+            .with_user_agent("rsipstack-prepared-invite-test")
+            .with_transport_layer(transport)
+            .build();
+        let dialog_layer = DialogLayer::new(endpoint.inner.clone());
+        let (state_sender, _) = unbounded_channel();
+        dialog_layer
+            .prepare_invite(
+                InviteOption {
+                    caller: "sip:alice@example.com".try_into().unwrap(),
+                    callee: "sip:bob@example.com".try_into().unwrap(),
+                    contact: "sip:alice@127.0.0.1:5060".try_into().unwrap(),
+                    content_type: Some("application/sdp".to_string()),
+                    offer: Some(logical_offer.to_vec()),
+                    call_id: Some("prepared-invite-call".to_string()),
+                    ..Default::default()
+                },
+                state_sender,
+            )
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn prepared_invite_exposes_real_local_tag_before_send() {
+        let invite = prepared_invite(b"v=0\r\na=logical\r\n").await;
+        let id = invite.dialog_id();
+
+        assert_eq!(id.call_id, "prepared-invite-call");
+        assert!(!id.local_tag.is_empty());
+        assert!(id.remote_tag.is_empty());
+        assert_eq!(invite.logical_offer(), b"v=0\r\na=logical\r\n");
+    }
+
+    #[tokio::test]
+    async fn prepared_invite_sends_only_the_effective_offer() {
+        let mut invite = prepared_invite(b"v=0\r\na=logical\r\n").await;
+        let effective = b"v=0\r\na=effective\r\n".to_vec();
+
+        invite
+            .replace_uncommitted_invite_offer(effective.clone())
+            .unwrap();
+
+        assert_eq!(invite.tx.original.body, effective);
+        assert_eq!(
+            invite.dialog.inner.initial_request.lock().body,
+            b"v=0\r\na=effective\r\n"
+        );
+        let content_length = invite
+            .tx
+            .original
+            .headers
+            .iter()
+            .find_map(|header| match header {
+                crate::sip::Header::ContentLength(value) => Some(value.value().to_string()),
+                _ => None,
+            });
+        let expected_length = b"v=0\r\na=effective\r\n".len().to_string();
+        assert_eq!(content_length.as_deref(), Some(expected_length.as_str()));
+    }
+}
