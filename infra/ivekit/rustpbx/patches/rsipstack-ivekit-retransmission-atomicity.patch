+    fn publish_finished_transaction(&self, key: &TransactionKey, msg: SipMessage) {
+        match self.finished_transactions.entry(key.clone()) {
+            Entry::Occupied(mut entry) => {
+                entry.insert(Some(msg));
+            }
+            Entry::Vacant(entry) => {
+                if self.capacity.try_acquire_finished_transaction() {
+                    self.timers.timeout(
+                        self.option.t1x64,
+                        TransactionTimer::TimerCleanup(key.clone()), // maybe use TimerK ???
+                    );
                     entry.insert(Some(msg));
