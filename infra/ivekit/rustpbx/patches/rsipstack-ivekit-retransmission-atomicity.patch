     pub fn detach_transaction(&self, key: &TransactionKey, last_message: Option<SipMessage>) {
         trace!(%key, "detach transaction");
+        if let Some(msg) = last_message {
+            self.publish_finished_transaction(key, msg);
+        }
+
+        // The finished transaction is visible before active transaction release.
+        // A retransmission can therefore never observe an untracked key and be
+        // admitted as a second server transaction during this transition.
         if self.transactions.remove(key).is_some() {
             self.capacity.release_active_transaction();
         }
+    }

