+    #[tokio::test]
+    async fn test_recording_pending_start_rejects_duplicate() {
+        let (engine, mut event_rx) = setup_engine();
+        create_session(&engine, "rec-pending").await;
+        let _ = event_rx.recv().await;
+
+        let recording_start_pending = {
+            let sessions = engine.sessions.read();
+            Arc::clone(
+                &sessions
+                    .get("rec-pending")
+                    .expect("session must exist")
+                    .recording_start_pending,
+            )
+        };
+        recording_start_pending.store(true, Ordering::Release);
+
+        engine
+            .send(MediaCommand::StartRecording {
+                session_id: "rec-pending".into(),
+                config: RecordConfig {
+                    path: "/tmp/unused-recording.wav".into(),
+                    max_duration_secs: None,
+                    beep: false,
+                    format: None,
+                    ivekit_spool: None,
+                },
+                caller_profile: None,
+                callee_profile: None,
+                reply: None,
+            })
+            .unwrap();
+
+        let ev = tokio::time::timeout(Duration::from_secs(2), event_rx.recv())
+            .await
+            .expect("timeout")
+            .expect("channel closed");
+        assert!(
+            matches!(&ev, MediaEvent::Error { command, .. } if command == "start_recording"),
+            "expected Error for pending duplicate start, got {:?}",
+            ev
+        );
+        assert!(
+            recording_start_pending.load(Ordering::Acquire),
+            "duplicate start must not release the first request's reservation"
+        );
+        recording_start_pending.store(false, Ordering::Release);
+    }
