+struct CountingWireInspector {
+    calls: Arc<AtomicUsize>,
+}
+
+impl MessageInspector for CountingWireInspector {
+    fn before_send(
+        &self,
+        mut msg: crate::sip::SipMessage,
+        _dest: Option<&SipAddr>,
+    ) -> crate::sip::SipMessage {
+        let call = self.calls.fetch_add(1, Ordering::SeqCst) + 1;
+        if let crate::sip::SipMessage::Response(response) = &mut msg {
+            response.headers.push(crate::sip::Header::Other(
+                "X-Wire-Generation".into(),
+                call.to_string(),
+            ));
+        }
+        msg
+    }
+
+    fn after_received(
+        &self,
+        msg: crate::sip::SipMessage,
+        _from: Option<&SipAddr>,
+    ) -> crate::sip::SipMessage {
+        msg
+    }
+}
