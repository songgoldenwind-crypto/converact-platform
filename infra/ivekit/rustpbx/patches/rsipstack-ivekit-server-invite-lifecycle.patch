+    let replay = recv_udp_bytes(&peer).await;
+
+    assert_eq!(replay, initial, "replay must preserve exact wire bytes");
+    assert_eq!(
+        inspector_calls.load(Ordering::SeqCst),
+        1,
+        "wire inspector must run only for the initial response"
+    );
+    assert_eq!(transaction.state, TransactionState::Completed);
+}
