+fn invite_request(via_transport: &str, via_addr: &SipAddr, branch: &str) -> crate::sip::Request {
+    crate::sip::Request {
+        method: crate::sip::Method::Invite,
+        uri: crate::sip::Uri::try_from("sip:bob@example.test").expect("request URI"),
+        headers: vec![
+            Via::new(&format!(
