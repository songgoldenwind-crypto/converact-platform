+    let server = UdpConnection::create_connection(
+        "127.0.0.1:0".parse().expect("server address"),
+        None,
+        None,
+    )
+    .await
+    .expect("server UDP");
+    let peer =
+        UdpConnection::create_connection("127.0.0.1:0".parse().expect("peer address"), None, None)
+            .await
+            .expect("peer UDP");
+    let mut builder = EndpointBuilder::new();
+    builder
+        .with_user_agent("rsipstack-test")
+        .with_option(option);
+    if let Some(inspector) = inspector {
+        builder.with_inspector(inspector);
+    }
+    let endpoint = builder.build();
+    let request = invite_request("UDP", peer.get_addr(), "z9hG4bK-server-lifecycle");
+    let key = crate::transaction::TransactionKey::from_request(
+        &request,
+        crate::transaction::key::TransactionRole::Server,
+    )
+    .expect("transaction key");
+    let transaction = crate::transaction::transaction::Transaction::new_server(
+        key,
+        request,
+        endpoint.inner.clone(),
+        Some(server.into()),
+    );
+    (transaction, peer)
+}
