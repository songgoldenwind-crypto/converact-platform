+                via_addr.addr
+            ))
+            .into(),
+            CSeq::new("1 INVITE").into(),
+            From::new("Alice <sip:alice@example.test>;tag=server-lifecycle").into(),
+            To::new("Bob <sip:bob@example.test>").into(),
+            CallId::new(&format!("{branch}@example.test")).into(),
+        ]
+        .into(),
+        version: crate::sip::Version::V2,
+        body: Default::default(),
+    }
+}
