+        UdpConnection::create_connection("127.0.0.1:0".parse().expect("peer address"), None, None)
+            .await
+            .expect("peer UDP");
+    let endpoint = EndpointBuilder::new()
+        .with_user_agent("rsipstack-test")
+        .with_capacity_limits(EndpointCapacityLimits::try_new(1, 8, 8, 8).expect("capacity limits"))
+        .build();
+    let mut incoming = endpoint
+        .incoming_transactions()
+        .expect("incoming transactions");
+    let first = invite_request("UDP", peer.get_addr(), "z9hG4bK-capacity-first");
+    endpoint
+        .inner
+        .on_received_message(first.clone().into(), server.clone().into(), peer.get_addr())
+        .await
+        .expect("first INVITE");
+    let first_transaction = incoming.recv().await.expect("first transaction");
+    assert_eq!(endpoint.inner.get_stats().running_transactions, 1);
+
+    let second = invite_request("UDP", peer.get_addr(), "z9hG4bK-capacity-second");
+    endpoint
+        .inner
+        .on_received_message(second.into(), server.into(), peer.get_addr())
+        .await
+        .expect("capacity rejection");
+    let rejection = String::from_utf8(recv_udp_bytes(&peer).await).expect("UTF-8 SIP rejection");
+    assert!(rejection.starts_with("SIP/2.0 503"));
+    assert!(rejection.contains("Retry-After: 1"));
+    assert!(matches!(
+        incoming.try_recv(),
+        Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+    ));
+    let stats = endpoint.inner.get_stats();
+    assert_eq!(stats.running_transactions, 1);
+    assert_eq!(stats.active_limit_rejections_total, 1);
+
+    drop(first_transaction);
+    assert_eq!(endpoint.inner.get_stats().running_transactions, 0);
