+
+impl TransportCapacityState {
+    fn new(max_connections: usize) -> Result<Self> {
+        if max_connections == 0 {
+            return Err(crate::Error::EndpointError(
+                "SIP transport connection limit must be greater than zero".to_string(),
+            ));
+        }
+        Ok(Self {
+            active_connections: AtomicUsize::new(0),
+            max_connections: AtomicUsize::new(max_connections),
+            connection_limit_rejections_total: AtomicU64::new(0),
+        })
+    }
+
+    fn set_limit(&self, max_connections: usize) -> Result<()> {
+        if max_connections == 0 {
+            return Err(crate::Error::EndpointError(
+                "SIP transport connection limit must be greater than zero".to_string(),
+            ));
+        }
+        let active = self.active_connections.load(Ordering::Acquire);
+        if active > max_connections {
+            return Err(crate::Error::EndpointError(format!(
+                "SIP transport connection limit {max_connections} is below {active} active connections"
+            )));
+        }
+        self.max_connections
