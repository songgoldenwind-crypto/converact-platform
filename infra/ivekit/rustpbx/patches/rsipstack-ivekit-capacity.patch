+#[cfg(test)]
+mod capacity_tests {
+    use super::*;
+
+    #[test]
+    fn endpoint_capacity_limits_reject_zero_values() {
+        assert!(EndpointCapacityLimits::try_new(0, 1, 1, 1).is_err());
+        assert!(EndpointCapacityLimits::try_new(1, 0, 1, 1).is_err());
+        assert!(EndpointCapacityLimits::try_new(1, 1, 0, 1).is_err());
+        assert!(EndpointCapacityLimits::try_new(1, 1, 1, 0).is_err());
+    }
+
+    #[test]
+    fn active_transaction_reservations_are_strictly_bounded() {
+        let state = EndpointCapacityState::new(
+            EndpointCapacityLimits::try_new(2, 3, 4, 5).expect("valid limits"),
+        );
+
+        assert!(state.try_acquire_active_transaction());
+        assert!(state.try_acquire_active_transaction());
+        assert!(!state.try_acquire_active_transaction());
+        assert_eq!(state.snapshot(0, 0).running_transactions, 2);
+        assert_eq!(state.snapshot(0, 0).active_limit_rejections_total, 1);
+
+        state.release_active_transaction();
+        assert!(state.try_acquire_active_transaction());
+        assert_eq!(state.snapshot(0, 0).running_transactions, 2);
+    }
+
+    #[test]
+    fn finished_transaction_reservations_are_strictly_bounded() {
+        let state = EndpointCapacityState::new(
+            EndpointCapacityLimits::try_new(2, 1, 4, 5).expect("valid limits"),
+        );
+
+        assert!(state.try_acquire_finished_transaction());
+        assert!(!state.try_acquire_finished_transaction());
+        assert_eq!(state.snapshot(0, 0).finished_transactions, 1);
+        assert_eq!(state.snapshot(0, 0).finished_cache_drops_total, 1);
+
+        state.release_finished_transaction();
+        assert!(state.try_acquire_finished_transaction());
+    }
+
+    #[test]
+    fn queue_rejections_are_counted_without_high_cardinality_labels() {
+        let state = EndpointCapacityState::new(
+            EndpointCapacityLimits::try_new(2, 2, 4, 5).expect("valid limits"),
+        );
+        state.record_incoming_queue_rejection();
+        state.record_incoming_queue_rejection();
+
+        let stats = state.snapshot(3, 7);
+        assert_eq!(stats.incoming_queue_depth, 3);
+        assert_eq!(stats.timer_tasks, 7);
+        assert_eq!(stats.incoming_queue_rejections_total, 2);
+        assert_eq!(stats.max_transport_connections, 5);
+    }
+}
