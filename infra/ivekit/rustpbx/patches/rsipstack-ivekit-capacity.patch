+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct EndpointCapacityLimits {
+    pub max_active_transactions: usize,
+    pub max_finished_transactions: usize,
+    pub incoming_transaction_queue_capacity: usize,
+    pub max_transport_connections: usize,
+}
+
+impl EndpointCapacityLimits {
+    pub fn try_new(
+        max_active_transactions: usize,
+        max_finished_transactions: usize,
+        incoming_transaction_queue_capacity: usize,
+        max_transport_connections: usize,
+    ) -> Result<Self> {
+        if max_active_transactions == 0
+            || max_finished_transactions == 0
+            || incoming_transaction_queue_capacity == 0
+            || max_transport_connections == 0
+        {
+            return Err(Error::EndpointError(
+                "SIP capacity limits must be greater than zero".to_string(),
+            ));
+        }
+        Ok(Self {
+            max_active_transactions,
+            max_finished_transactions,
+            incoming_transaction_queue_capacity,
+            max_transport_connections,
+        })
+    }
+}
+
+impl Default for EndpointCapacityLimits {
+    fn default() -> Self {
+        Self {
+            max_active_transactions: usize::MAX,
+            max_finished_transactions: usize::MAX,
+            incoming_transaction_queue_capacity: 65_536,
+            max_transport_connections: usize::MAX,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub struct EndpointStats {
     pub running_transactions: usize,
     pub finished_transactions: usize,
     pub waiting_ack: usize,
+    pub timer_tasks: usize,
+    pub incoming_queue_depth: usize,
+    pub max_active_transactions: usize,
+    pub max_finished_transactions: usize,
+    pub incoming_transaction_queue_capacity: usize,
+    pub max_transport_connections: usize,
+    pub active_limit_rejections_total: u64,
+    pub incoming_queue_rejections_total: u64,
+    pub finished_cache_drops_total: u64,
+    pub active_transport_connections: usize,
+    pub transport_connection_limit_rejections_total: u64,
+}
+
+struct EndpointCapacityState {
+    limits: EndpointCapacityLimits,
+    active_transactions: AtomicUsize,
+    finished_transactions: AtomicUsize,
+    active_limit_rejections_total: AtomicU64,
+    incoming_queue_rejections_total: AtomicU64,
+    finished_cache_drops_total: AtomicU64,
+}
+
+impl EndpointCapacityState {
+    fn new(limits: EndpointCapacityLimits) -> Self {
+        Self {
+            limits,
+            active_transactions: AtomicUsize::new(0),
+            finished_transactions: AtomicUsize::new(0),
+            active_limit_rejections_total: AtomicU64::new(0),
+            incoming_queue_rejections_total: AtomicU64::new(0),
+            finished_cache_drops_total: AtomicU64::new(0),
+        }
+    }
+
+    fn try_acquire_active_transaction(&self) -> bool {
+        if try_acquire_bounded(
+            &self.active_transactions,
+            self.limits.max_active_transactions,
+        ) {
+            true
+        } else {
+            self.active_limit_rejections_total
+                .fetch_add(1, Ordering::Relaxed);
+            false
+        }
+    }
+
+    fn release_active_transaction(&self) {
+        release_bounded(&self.active_transactions);
+    }
+
+    fn try_acquire_finished_transaction(&self) -> bool {
+        if try_acquire_bounded(
+            &self.finished_transactions,
+            self.limits.max_finished_transactions,
+        ) {
+            true
+        } else {
+            self.finished_cache_drops_total
+                .fetch_add(1, Ordering::Relaxed);
+            false
+        }
+    }
+
+    fn release_finished_transaction(&self) {
+        release_bounded(&self.finished_transactions);
+    }
+
+    fn record_incoming_queue_rejection(&self) {
+        self.incoming_queue_rejections_total
+            .fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn snapshot(&self, incoming_queue_depth: usize, timer_tasks: usize) -> EndpointStats {
+        EndpointStats {
+            running_transactions: self.active_transactions.load(Ordering::Acquire),
+            finished_transactions: self.finished_transactions.load(Ordering::Acquire),
+            waiting_ack: 0,
+            timer_tasks,
+            incoming_queue_depth,
+            max_active_transactions: self.limits.max_active_transactions,
+            max_finished_transactions: self.limits.max_finished_transactions,
+            incoming_transaction_queue_capacity: self.limits.incoming_transaction_queue_capacity,
+            max_transport_connections: self.limits.max_transport_connections,
+            active_limit_rejections_total: self
+                .active_limit_rejections_total
+                .load(Ordering::Relaxed),
+            incoming_queue_rejections_total: self
+                .incoming_queue_rejections_total
+                .load(Ordering::Relaxed),
+            finished_cache_drops_total: self.finished_cache_drops_total.load(Ordering::Relaxed),
+            active_transport_connections: 0,
+            transport_connection_limit_rejections_total: 0,
+        }
+    }
+}
+
+fn try_acquire_bounded(counter: &AtomicUsize, limit: usize) -> bool {
+    let mut current = counter.load(Ordering::Acquire);
+    loop {
+        if current >= limit {
+            return false;
+        }
+        match counter.compare_exchange_weak(
+            current,
+            current + 1,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        ) {
+            Ok(_) => return true,
+            Err(actual) => current = actual,
+        }
+    }
+}
+
+fn release_bounded(counter: &AtomicUsize) {
+    let mut current = counter.load(Ordering::Acquire);
+    loop {
+        if current == 0 {
+            debug_assert!(false, "SIP capacity counter release underflow");
+            return;
+        }
+        match counter.compare_exchange_weak(
+            current,
+            current - 1,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        ) {
+            Ok(_) => return,
+            Err(actual) => current = actual,
+        }
+    }
 }
 
