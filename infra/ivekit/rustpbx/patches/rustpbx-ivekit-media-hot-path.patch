+const DEFAULT_RECORDING_WORKER_THREADS: usize = 4;
+const DEFAULT_RECORDING_WORKER_QUEUE_CAPACITY: usize = 4096;
+static RECORDING_EXECUTOR: OnceLock<RecordingExecutor> = OnceLock::new();
+static NEXT_RECORDING_WORKER: AtomicUsize = AtomicUsize::new(0);
+
+struct RecordingWorkItem {
+    state: Arc<RecorderCaptureState>,
+    leg: RecLeg,
+    sample: SharedMediaSample,
+    dtmf_payload_type: Option<u8>,
+    dtmf_clock_rate: Option<u32>,
+    codec_hint: Option<AudioCodecType>,
+}
+
+impl RecordingWorkItem {
+    fn write(&self) {
+        let mut guard = self.state.recorder.write();
+        if let Some(recorder) = guard.as_mut() {
+            recorder.add_drop_counter(Arc::clone(&self.state.dropped));
+            if let Err(error) = recorder.write_sample(
+                self.leg,
+                &self.sample,
+                self.dtmf_payload_type,
+                self.dtmf_clock_rate,
+                self.codec_hint,
+            ) {
+                warn!(error = %error, "recorder capture write failed");
+            }
+        }
+    }
+}
+
+impl Drop for RecordingWorkItem {
+    fn drop(&mut self) {
+        self.state.pending.fetch_sub(1, Ordering::Release);
+    }
+}
+
+struct RecorderCaptureState {
+    recorder: Arc<parking_lot::RwLock<Option<Recorder>>>,
+    dropped: Arc<AtomicU64>,
+    pending: AtomicUsize,
+    capacity: usize,
+}
+
+impl RecorderCaptureState {
+    fn try_reserve(&self) -> bool {
+        self.pending
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |pending| {
+                (pending < self.capacity).then_some(pending + 1)
+            })
+            .is_ok()
+    }
+
+    fn record_drop(&self, reason: &'static str) {
+        self.dropped.fetch_add(1, Ordering::Relaxed);
+        crate::metrics::media::recording_queue_dropped(reason, 1);
+    }
+}
+
+struct RecordingExecutor {
+    senders: Vec<crossbeam_channel::Sender<RecordingWorkItem>>,
+    worker_queue_capacity: usize,
+    _workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl RecordingExecutor {
+    fn new(worker_threads: usize, worker_queue_capacity: usize) -> Result<Self> {
+        let mut senders = Vec::with_capacity(worker_threads);
+        let mut workers = Vec::with_capacity(worker_threads);
+        for worker_index in 0..worker_threads {
+            let (tx, rx) = crossbeam_channel::bounded::<RecordingWorkItem>(worker_queue_capacity);
+            let worker = std::thread::Builder::new()
+                .name(format!("rustpbx-recording-{worker_index}"))
+                .spawn(move || {
+                    while let Ok(item) = rx.recv() {
+                        item.write();
+                    }
+                })
+                .map_err(|error| anyhow::anyhow!("failed to start recording worker: {error}"))?;
+            senders.push(tx);
+            workers.push(worker);
+        }
+        crate::metrics::media::set_recording_worker_capacity(worker_threads, worker_queue_capacity);
+        Ok(Self {
+            senders,
+            worker_queue_capacity,
+            _workers: workers,
+        })
+    }
+
+    fn matches(&self, worker_threads: usize, worker_queue_capacity: usize) -> bool {
+        self.senders.len() == worker_threads && self.worker_queue_capacity == worker_queue_capacity
+    }
+
+    fn sender(&self, worker_index: usize) -> &crossbeam_channel::Sender<RecordingWorkItem> {
+        &self.senders[worker_index % self.senders.len()]
+    }
+}
+
+pub(crate) fn configure_recording_executor(
+    worker_threads: usize,
+    worker_queue_capacity: usize,
+) -> Result<()> {
+    if worker_threads == 0 || worker_queue_capacity == 0 {
+        return Err(anyhow::anyhow!(
+            "recording executor workers and queue capacity must be positive"
+        ));
+    }
+    if let Some(executor) = RECORDING_EXECUTOR.get() {
+        if executor.matches(worker_threads, worker_queue_capacity) {
+            return Ok(());
+        }
+        return Err(anyhow::anyhow!(
+            "recording executor already initialized with {} workers and queue capacity {}",
+            executor.senders.len(),
+            executor.worker_queue_capacity
+        ));
+    }
+    let executor = RecordingExecutor::new(worker_threads, worker_queue_capacity)?;
+    if let Err(executor) = RECORDING_EXECUTOR.set(executor) {
+        if !RECORDING_EXECUTOR
+            .get()
+            .is_some_and(|active| active.matches(worker_threads, worker_queue_capacity))
+        {
+            return Err(anyhow::anyhow!(
+                "recording executor initialization raced with incompatible configuration"
+            ));
+        }
+        drop(executor);
+    }
+    Ok(())
+}
+
+fn recording_executor() -> &'static RecordingExecutor {
+    RECORDING_EXECUTOR.get_or_init(|| {
+        RecordingExecutor::new(
+            DEFAULT_RECORDING_WORKER_THREADS,
+            DEFAULT_RECORDING_WORKER_QUEUE_CAPACITY,
+        )
+        .expect("default recording executor must start")
+    })
+}
+
+#[derive(Clone)]
+pub(crate) struct RecorderCapture {
+    state: Arc<RecorderCaptureState>,
+    worker_index: usize,
+    recording_paused: Arc<AtomicBool>,
+}
+
+impl RecorderCapture {
+    pub(crate) fn new(
+        recorder: Arc<parking_lot::RwLock<Option<Recorder>>>,
+        recording_paused: Arc<AtomicBool>,
+        capacity: usize,
+    ) -> Self {
+        Self::new_with_drop_counter(
+            recorder,
+            recording_paused,
+            capacity,
+            Arc::new(AtomicU64::new(0)),
+        )
+    }
+
+    pub(crate) fn new_with_drop_counter(
+        recorder: Arc<parking_lot::RwLock<Option<Recorder>>>,
+        recording_paused: Arc<AtomicBool>,
+        capacity: usize,
+        dropped: Arc<AtomicU64>,
+    ) -> Self {
+        crate::metrics::media::set_recording_queue_capacity(capacity);
+        let worker_index = NEXT_RECORDING_WORKER.fetch_add(1, Ordering::Relaxed)
+            % recording_executor().senders.len();
+        Self {
+            state: Arc::new(RecorderCaptureState {
+                recorder,
+                dropped,
+                pending: AtomicUsize::new(0),
+                capacity,
+            }),
+            worker_index,
+            recording_paused,
+        }
+    }
+
+    pub(crate) fn try_capture(
+        &self,
+        leg: RecLeg,
+        sample: &MediaSample,
+        dtmf_payload_type: Option<u8>,
+        dtmf_clock_rate: Option<u32>,
+        codec_hint: Option<AudioCodecType>,
+    ) {
+        if self.recording_paused.load(Ordering::Relaxed) {
+            return;
+        }
+        if !self.state.try_reserve() {
+            self.state.record_drop("capture_full");
+            return;
+        }
+        let item = RecordingWorkItem {
+            state: Arc::clone(&self.state),
+            leg,
+            sample: Arc::new(sample.clone()),
+            dtmf_payload_type,
+            dtmf_clock_rate,
+            codec_hint,
+        };
+        match recording_executor()
+            .sender(self.worker_index)
+            .try_send(item)
+        {
+            Ok(()) => {}
+            Err(crossbeam_channel::TrySendError::Full(item)) => {
+                item.state.record_drop("worker_full");
+            }
+            Err(crossbeam_channel::TrySendError::Disconnected(item)) => {
+                item.state.record_drop("worker_closed");
+            }
+        }
+    }
+}
 
