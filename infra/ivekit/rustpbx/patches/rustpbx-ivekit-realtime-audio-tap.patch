+            sample: parking_lot::Mutex::new(Some(input.clone())),
+        });
+        let (output_tx, output_track, _) = sample_track(MediaKind::Audio, 10);
+        let sender = Arc::new(parking_lot::Mutex::new(Some(output_tx)));
+        let (tap_tx, _tap_rx) = mpsc::channel(1);
+        let capture = AudioTapCapture::from_sender(tap_tx);
+        capture.try_capture(EncodedAudioTapFrame {
+            leg: RecLeg::A,
+            sample: Arc::new(input),
+            received_at_micros: 1,
+            codec: CodecType::PCMU,
+            audio_payload_type: 0,
+        });
+        let cancel = CancellationToken::new();
+        let ctx = ForwardLoopContextBuilder::new(
+            "tap-full".to_string(),
+            mock_track,
+            Arc::downgrade(&sender),
+            Arc::new(AtomicU8::new(BRIDGE_OUTPUT_PEER)),
+            cancel.clone(),
+            ForwardPath::new(LegTransport::Caller, LegTransport::Callee),
+            LegStats::new(),
+        )
+        .with_recorder_capture(None, Some(RecLeg::A))
+        .with_audio_tap(
+            Some(capture.clone()),
+            Some(Arc::new(parking_lot::RwLock::new(Some(
+                AudioTapCodecProfile {
+                    codec: CodecType::PCMU,
+                    payload_type: 0,
+                },
+            )))),
+        )
+        .build();
+
+        let task = crate::utils::media_spawn(async move {
+            BridgePeer::run_forward_loop(ctx).await;
+        });
+        let forwarded = tokio::time::timeout(Duration::from_secs(1), output_track.recv())
+            .await
+            .expect("bridge forwarding must not wait on a full audio tap queue")
+            .expect("forwarded sample");
+        cancel.cancel();
+        let _ = task.await;
+
+        assert!(matches!(forwarded, MediaSample::Audio(_)));
+        assert_eq!(capture.dropped_frames(), 1);
+    }
