@@ -0,0 +1,483 @@
+use crate::media::engine::command::SharedMediaSample;
+use crate::media::recorder::Leg;
+use audio_codec::{CodecType, Decoder, Resampler, create_decoder};
+use base64::Engine as _;
+use rustrtc::media::frame::MediaSample;
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+use tokio::io::AsyncWriteExt;
+use tokio::net::UnixStream;
+use tokio::sync::mpsc;
+use tracing::debug;
+
+pub const AUDIO_TAP_TOKEN_HEADER: &str = "x-ivekit-audio-tap-token";
+pub const AUDIO_TAP_PROTOCOL: &str = "ivekit-rustpbx-audio-tap-v1";
+pub const AUDIO_TAP_SAMPLE_RATE: u32 = 16_000;
+const AUDIO_ENVELOPE_HEADER_BYTES: usize = 48;
+const AUDIO_ENVELOPE_MAGIC: &[u8; 4] = b"IAT1";
+const AUDIO_ENVELOPE_VERSION: u8 = 1;
+const AUDIO_ENVELOPE_KIND_PCM: u8 = 2;
+const MAX_TOKEN_BYTES: usize = 2_048;
+const MAX_CONTROL_BYTES: usize = 4_096;
+
+#[derive(Clone)]
+pub struct EncodedAudioTapFrame {
+    pub leg: Leg,
+    pub sample: SharedMediaSample,
+    pub received_at_micros: u64,
+    pub codec: CodecType,
+    pub audio_payload_type: u8,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AudioTapCodecProfile {
+    pub codec: CodecType,
+    pub payload_type: u8,
+}
+
+#[derive(Clone)]
+pub struct AudioTapCapture {
+    tx: mpsc::Sender<EncodedAudioTapFrame>,
+    dropped: Arc<AtomicU64>,
+}
+
+impl AudioTapCapture {
+    pub fn try_capture(&self, frame: EncodedAudioTapFrame) {
+        match self.tx.try_send(frame) {
+            Ok(()) => {
+                metrics::counter!(
+                    "rustpbx_realtime_audio_tap_capture_total",
+                    "result" => "accepted"
+                )
+                .increment(1);
+            }
+            Err(mpsc::error::TrySendError::Full(_)) => {
+                self.dropped.fetch_add(1, Ordering::Relaxed);
+                metrics::counter!(
+                    "rustpbx_realtime_audio_tap_capture_total",
+                    "result" => "dropped_full"
+                )
+                .increment(1);
+            }
+            Err(mpsc::error::TrySendError::Closed(_)) => {
+                self.dropped.fetch_add(1, Ordering::Relaxed);
+                metrics::counter!(
+                    "rustpbx_realtime_audio_tap_capture_total",
+                    "result" => "dropped_closed"
+                )
+                .increment(1);
+            }
+        }
+    }
+
+    pub fn dropped_frames(&self) -> u64 {
+        self.dropped.load(Ordering::Relaxed)
+    }
+
+    pub(crate) fn from_sender(tx: mpsc::Sender<EncodedAudioTapFrame>) -> Self {
+        Self {
+            tx,
+            dropped: Arc::new(AtomicU64::new(0)),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioTapAuthorization {
+    pub token: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AudioTapAuthorizationError {
+    Missing,
+    Invalid,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioTapRuntimeConfig {
+    pub socket_path: String,
+    pub channel_capacity: usize,
+    pub send_timeout: Duration,
+}
+
+#[derive(Serialize)]
+struct ControlEnvelope<'a> {
+    protocol: &'static str,
+    event: &'static str,
+    session_id: &'a str,
+    session_key: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    authorization: Option<&'a str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    reason: Option<&'a str>,
+}
+
+struct DecoderState {
+    codec: CodecType,
+    decoder: Box<dyn Decoder>,
+    resampler: Option<Resampler>,
+}
+
+impl DecoderState {
+    fn new(codec: CodecType) -> Self {
+        let decoder = create_decoder(codec);
+        let source_rate = decoder.sample_rate();
+        let resampler = (source_rate != AUDIO_TAP_SAMPLE_RATE)
+            .then(|| Resampler::new(source_rate as usize, AUDIO_TAP_SAMPLE_RATE as usize));
+        Self {
+            codec,
+            decoder,
+            resampler,
+        }
+    }
+
+    fn decode(&mut self, codec: CodecType, payload: &[u8]) -> Vec<i16> {
+        if self.codec != codec {
+            *self = Self::new(codec);
+        }
+        let decoded = self.decoder.decode(payload);
+        match self.resampler.as_mut() {
+            Some(resampler) => resampler.resample(&decoded),
+            None => decoded,
+        }
+    }
+}
+
+pub fn authorization_from_routed_headers(
+    headers: Option<&[rsipstack::sip::Header]>,
+) -> Result<AudioTapAuthorization, AudioTapAuthorizationError> {
+    let Some(raw) = headers
+        .and_then(|headers| {
+            headers
+                .iter()
+                .find(|header| header.name().eq_ignore_ascii_case(AUDIO_TAP_TOKEN_HEADER))
+        })
+        .map(|header| header.value().trim())
+    else {
+        metrics::counter!(
+            "rustpbx_realtime_audio_tap_authorization_total",
+            "result" => "missing"
+        )
+        .increment(1);
+        return Err(AudioTapAuthorizationError::Missing);
+    };
+    if raw.len() < 32
+        || raw.len() > MAX_TOKEN_BYTES
+        || !raw
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.' | b'~'))
+    {
+        metrics::counter!(
+            "rustpbx_realtime_audio_tap_authorization_total",
+            "result" => "invalid"
+        )
+        .increment(1);
+        return Err(AudioTapAuthorizationError::Invalid);
+    }
+    metrics::counter!(
+        "rustpbx_realtime_audio_tap_authorization_total",
+        "result" => "accepted"
+    )
+    .increment(1);
+    Ok(AudioTapAuthorization {
+        token: raw.to_string(),
+    })
+}
+
+pub fn spawn_audio_tap(
+    session_id: String,
+    authorization: AudioTapAuthorization,
+    config: AudioTapRuntimeConfig,
+) -> AudioTapCapture {
+    let (tx, rx) = mpsc::channel(config.channel_capacity);
+    let capture = AudioTapCapture::from_sender(tx);
+    metrics::gauge!("rustpbx_realtime_audio_tap_queue_capacity")
+        .set(config.channel_capacity as f64);
+    crate::utils::media_spawn(run_audio_tap(session_id, authorization, config, rx));
+    capture
+}
+
+async fn run_audio_tap(
+    session_id: String,
+    authorization: AudioTapAuthorization,
+    config: AudioTapRuntimeConfig,
+    mut rx: mpsc::Receiver<EncodedAudioTapFrame>,
+) {
+    let session_key = session_key(&session_id);
+    let mut socket = match tokio::time::timeout(
+        config.send_timeout,
+        UnixStream::connect(Path::new(&config.socket_path)),
+    )
+    .await
+    {
+        Ok(Ok(socket)) => socket,
+        Ok(Err(error)) => {
+            audio_tap_failure("socket_connect");
+            debug!(session_id = %session_id, error = %error, "Realtime audio tap sidecar unavailable");
+            return;
+        }
+        Err(_) => {
+            audio_tap_failure("connect_timeout");
+            return;
+        }
+    };
+    let Some(started) = control_envelope(
+        "start",
+        &session_id,
+        &session_key,
+        Some(&authorization.token),
+        None,
+    ) else {
+        audio_tap_failure("control_encode");
+        return;
+    };
+    if !send_frame(&mut socket, &started, config.send_timeout, "start").await {
+        return;
+    }
+    metrics::gauge!("rustpbx_realtime_audio_tap_sessions_active").increment(1.0);
+
+    let mut caller_decoder: Option<DecoderState> = None;
+    let mut callee_decoder: Option<DecoderState> = None;
+    let mut sequence = 0u64;
+    while let Some(input) = rx.recv().await {
+        let MediaSample::Audio(frame) = &*input.sample else {
+            continue;
+        };
+        if frame.payload_type != Some(input.audio_payload_type) {
+            continue;
+        }
+        let payload = frame
+            .raw_packet
+            .as_ref()
+            .map(|packet| packet.payload.as_ref())
+            .unwrap_or(frame.data.as_ref());
+        let state = match input.leg {
+            Leg::A => &mut caller_decoder,
+            Leg::B => &mut callee_decoder,
+        };
+        let pcm = state
+            .get_or_insert_with(|| DecoderState::new(input.codec))
+            .decode(input.codec, payload);
+        if pcm.is_empty() {
+            audio_tap_failure("decode_empty");
+            continue;
+        }
+        sequence = sequence.wrapping_add(1);
+        let envelope = pcm_envelope(
+            &session_key,
+            sequence,
+            input.received_at_micros,
+            input.leg,
+            &pcm,
+        );
+        if send_frame(&mut socket, &envelope, config.send_timeout, "pcm").await {
+            metrics::counter!(
+                "rustpbx_realtime_audio_tap_frames_total",
+                "result" => "sent"
+            )
+            .increment(1);
+        }
+    }
+
+    if let Some(ended) = control_envelope(
+        "end",
+        &session_id,
+        &session_key,
+        None,
+        Some("source_closed"),
+    ) {
+        let _ = send_frame(&mut socket, &ended, config.send_timeout, "end").await;
+    } else {
+        audio_tap_failure("control_encode");
+    }
+    metrics::gauge!("rustpbx_realtime_audio_tap_sessions_active").decrement(1.0);
+}
+
+async fn send_frame(
+    socket: &mut UnixStream,
+    payload: &[u8],
+    timeout: Duration,
+    stage: &'static str,
+) -> bool {
+    let Ok(payload_len) = u32::try_from(payload.len()) else {
+        audio_tap_failure("frame_too_large");
+        return false;
+    };
+    let header = payload_len.to_be_bytes();
+    match tokio::time::timeout(timeout, async {
+        socket.write_all(&header).await?;
+        socket.write_all(payload).await
+    })
+    .await
+    {
+        Ok(Ok(())) => true,
+        Ok(Err(_)) => {
+            audio_tap_failure(stage);
+            false
+        }
+        Err(_) => {
+            audio_tap_failure("send_timeout");
+            false
+        }
+    }
+}
+
+fn audio_tap_failure(reason: &'static str) {
+    metrics::counter!(
+        "rustpbx_realtime_audio_tap_failures_total",
+        "reason" => reason
+    )
+    .increment(1);
+}
+
+fn control_envelope(
+    event: &'static str,
+    session_id: &str,
+    session_key: &[u8; 16],
+    authorization: Option<&str>,
+    reason: Option<&str>,
+) -> Option<Vec<u8>> {
+    let envelope = ControlEnvelope {
+        protocol: AUDIO_TAP_PROTOCOL,
+        event,
+        session_id,
+        session_key: base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(session_key),
+        authorization,
+        reason,
+    };
+    let payload = serde_json::to_vec(&envelope).ok()?;
+    if payload.len() > MAX_CONTROL_BYTES {
+        return None;
+    }
+    let mut output = Vec::with_capacity(4 + payload.len());
+    output.extend_from_slice(b"IATJ");
+    output.extend_from_slice(&payload);
+    Some(output)
+}
+
+fn pcm_envelope(
+    session_key: &[u8; 16],
+    sequence: u64,
+    received_at_micros: u64,
+    leg: Leg,
+    pcm: &[i16],
+) -> Vec<u8> {
+    let payload = audio_codec::samples_to_bytes(pcm);
+    let mut output = Vec::with_capacity(AUDIO_ENVELOPE_HEADER_BYTES + payload.len());
+    output.extend_from_slice(AUDIO_ENVELOPE_MAGIC);
+    output.push(AUDIO_ENVELOPE_VERSION);
+    output.push(AUDIO_ENVELOPE_KIND_PCM);
+    output.push(match leg {
+        Leg::A => 0,
+        Leg::B => 1,
+    });
+    output.push(0);
+    output.extend_from_slice(session_key);
+    output.extend_from_slice(&sequence.to_be_bytes());
+    output.extend_from_slice(&received_at_micros.to_be_bytes());
+    output.extend_from_slice(&AUDIO_TAP_SAMPLE_RATE.to_be_bytes());
+    output.extend_from_slice(&(pcm.len() as u32).to_be_bytes());
+    output.extend_from_slice(&payload);
+    output
+}
+
+fn session_key(session_id: &str) -> [u8; 16] {
+    let digest = Sha256::digest(session_id.as_bytes());
+    let mut key = [0u8; 16];
+    key.copy_from_slice(&digest[..16]);
+    key
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rsipstack::sip::Header;
+
+    #[test]
+    fn authorization_accepts_only_explicit_routed_header() {
+        let token = format!("header.payload.{}", "s".repeat(32));
+        let headers = vec![Header::Other(
+            AUDIO_TAP_TOKEN_HEADER.to_string(),
+            token.clone(),
+        )];
+        assert_eq!(
+            authorization_from_routed_headers(Some(&headers)),
+            Ok(AudioTapAuthorization { token })
+        );
+        assert_eq!(
+            authorization_from_routed_headers(None),
+            Err(AudioTapAuthorizationError::Missing)
+        );
+        let invalid = vec![Header::Other(
+            AUDIO_TAP_TOKEN_HEADER.to_string(),
+            "invalid token with spaces".to_string(),
+        )];
+        assert_eq!(
+            authorization_from_routed_headers(Some(&invalid)),
+            Err(AudioTapAuthorizationError::Invalid)
+        );
+    }
+
+    #[test]
+    fn pcm_envelope_is_bounded_and_self_describing() {
+        let key = session_key("session-a");
+        let pcm = vec![1i16, -2, 3, -4];
+        let envelope = pcm_envelope(&key, 7, 9, Leg::B, &pcm);
+        assert_eq!(&envelope[..4], AUDIO_ENVELOPE_MAGIC);
+        assert_eq!(envelope[4], AUDIO_ENVELOPE_VERSION);
+        assert_eq!(envelope[5], AUDIO_ENVELOPE_KIND_PCM);
+        assert_eq!(envelope[6], 1);
+        assert_eq!(&envelope[8..24], &key);
+        assert_eq!(u64::from_be_bytes(envelope[24..32].try_into().unwrap()), 7);
+        assert_eq!(u64::from_be_bytes(envelope[32..40].try_into().unwrap()), 9);
+        assert_eq!(
+            u32::from_be_bytes(envelope[40..44].try_into().unwrap()),
+            16_000
+        );
+        assert_eq!(u32::from_be_bytes(envelope[44..48].try_into().unwrap()), 4);
+        assert_eq!(envelope.len(), AUDIO_ENVELOPE_HEADER_BYTES + pcm.len() * 2);
+    }
+
+    #[test]
+    fn stream_frame_prefix_is_big_endian_payload_length() {
+        assert_eq!(
+            u32::try_from(AUDIO_ENVELOPE_HEADER_BYTES)
+                .unwrap()
+                .to_be_bytes(),
+            [0, 0, 0, 48]
+        );
+    }
+
+    #[test]
+    fn pcmu_decoder_normalizes_to_pcm16_16khz() {
+        let mut state = DecoderState::new(CodecType::PCMU);
+        let pcm = state.decode(CodecType::PCMU, &[0xff; 160]);
+        assert_eq!(pcm.len(), 320);
+    }
+
+    #[test]
+    fn full_capture_queue_drops_without_waiting() {
+        let (tx, _rx) = mpsc::channel(1);
+        let capture = AudioTapCapture::from_sender(tx);
+        let frame = || EncodedAudioTapFrame {
+            leg: Leg::A,
+            sample: Arc::new(MediaSample::Audio(Default::default())),
+            received_at_micros: 1,
+            codec: CodecType::PCMU,
+            audio_payload_type: 0,
+        };
+        capture.try_capture(frame());
+        capture.try_capture(frame());
+        assert_eq!(capture.dropped_frames(), 1);
+    }
+
+    #[test]
+    fn oversized_control_envelope_is_rejected() {
+        let key = session_key("session-a");
+        assert!(control_envelope("start", &"s".repeat(4_096), &key, None, None).is_none());
+    }
+}
