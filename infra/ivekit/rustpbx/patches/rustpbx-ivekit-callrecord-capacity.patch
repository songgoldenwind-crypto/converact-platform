+fn warn_call_record_drop(reason: &'static str) {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    static LAST_WARNING_EPOCH_SECS: AtomicU64 = AtomicU64::new(0);
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs();
+    let previous = LAST_WARNING_EPOCH_SECS.load(Ordering::Relaxed);
+    if now.saturating_sub(previous) >= 5
+        && LAST_WARNING_EPOCH_SECS
+            .compare_exchange(previous, now, Ordering::Relaxed, Ordering::Relaxed)
+            .is_ok()
+    {
+        tracing::warn!(reason, "call record queue dropped records to bound memory");
+    }
+}
