+    for capacity in [0, MAX_CALL_RECORD_CHANNEL_CAPACITY + 1] {
+        let error = CallRecordManagerBuilder::new()
+            .with_channel_capacity(capacity)
+            .build()
+            .await
+            .err()
+            .unwrap();
+
+        assert!(
+            error
+                .to_string()
+                .contains("call record channel capacity must be between")
+        );
+    }
+}
