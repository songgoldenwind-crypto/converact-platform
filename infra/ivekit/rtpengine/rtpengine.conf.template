[rtpengine]
interface=__INTERFACE__
listen-ng=__LISTEN_NG__
listen-tcp-ng=__LISTEN_TCP_NG__
listen-http=__LISTEN_HTTP__
port-min=__PORT_MIN__
port-max=__PORT_MAX__
table=__TABLE__
foreground=true
log-stderr=true
delete-delay=0
recording-dir=__RECORDING_DIR__
recording-method=pcap
recording-format=eth
templates=ivekit-signalling-templates

[ivekit-signalling-templates]
g711-relay-v1=replace-origin replace-session-connection trust-address rtcp-mux=[accept offer] SDES=only-AES_CM_128_HMAC_SHA1_80
