 			ivekit_guard_entry_free);
 	atomic_init(&ivekit_guard_draining, false);
+	atomic_init(&ivekit_guard_initialized, false);
 	atomic_init(&ivekit_guard_active_calls, 0);
 	atomic_init(&ivekit_guard_accepted, 0);
 	atomic_init(&ivekit_guard_replayed, 0);
@@ -305,15 +322,21 @@ void ivekit_guard_init(void) {
 	atomic_init(&ivekit_guard_sequence_gap, 0);
 	atomic_init(&ivekit_guard_draining_rejections, 0);
 	atomic_init(&ivekit_guard_capacity_rejections, 0);
+	atomic_store_explicit(&ivekit_guard_initialized, true,
+			memory_order_release);
 	ilog(LOG_INFO, "iveKit RTPengine owner guard is %s "
-			"(active-call-limit=%" PRIu64 ", guard-entry-limit=%" PRIu64
+			"(runtime-mode=%s, active-call-limit=%" PRIu64
+			", guard-entry-limit=%" PRIu64
 			", tombstone-retention=%" PRIu64 " seconds)",
 			ivekit_guard_enabled ? "enabled" : "disabled",
+			ivekit_guard_runtime_mode,
 			ivekit_guard_active_call_limit, ivekit_guard_entry_limit,
