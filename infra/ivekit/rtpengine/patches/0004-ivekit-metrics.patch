+	snapshot->userspace_fallback = ivekit_guard_userspace_fallback;
 	snapshot->draining = atomic_load_explicit(&ivekit_guard_draining,
 			memory_order_relaxed);
 	mutex_lock(&ivekit_guard_entries_lock);
