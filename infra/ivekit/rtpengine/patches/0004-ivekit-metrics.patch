 	return parsed;
 }
 
+static void ivekit_guard_runtime_mode_init(void) {
+	const char *mode = g_getenv("IVEKIT_RTPENGINE_RUNTIME_MODE");
+	if (!mode || !*mode)
+		mode = "unconfigured";
+	if (strcmp(mode, "unconfigured") && strcmp(mode, "userspace")
+			&& strcmp(mode, "kernel"))
+		die("Invalid IVEKIT_RTPENGINE_RUNTIME_MODE: expected "
+				"unconfigured, userspace, or kernel");
+	g_strlcpy(ivekit_guard_runtime_mode, mode,
+			sizeof(ivekit_guard_runtime_mode));
+	ivekit_guard_userspace_fallback = ivekit_guard_env_bool(
+			"IVEKIT_RTPENGINE_USERSPACE_FALLBACK", false);
+	if (ivekit_guard_userspace_fallback && strcmp(mode, "userspace"))
+		die("IVEKIT_RTPENGINE_USERSPACE_FALLBACK requires userspace mode");
+}
+
 static bool ivekit_guard_is_mutation(const str *command) {
