 }
 
 void ivekit_guard_cleanup(void) {
+	atomic_store_explicit(&ivekit_guard_initialized, false,
+			memory_order_release);
 	if (ivekit_guard_entries) {
 		g_hash_table_destroy(ivekit_guard_entries);
 		ivekit_guard_entries = NULL;
@@ -516,6 +539,11 @@ void ivekit_guard_append_response(ng_command_ctx_t *ctx,
 
 void ivekit_guard_metrics_snapshot(ivekit_guard_metrics_t *snapshot) {
 	memset(snapshot, 0, sizeof(*snapshot));
+	g_strlcpy(snapshot->runtime_mode, ivekit_guard_runtime_mode,
+			sizeof(snapshot->runtime_mode));
+	if (!atomic_load_explicit(&ivekit_guard_initialized,
+				memory_order_acquire))
+		return;
 	snapshot->accepted = atomic_load_explicit(&ivekit_guard_accepted,
