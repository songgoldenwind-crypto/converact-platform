+func (s *Session) backgroundTimerChannel() <-chan time.Time {
+	if timer := s.bkgTimer.Load(); timer != nil {
+		return timer.C
+	}
+	return nil
+}
+
+func (s *Session) startBackgroundTimer() {
+	timer := time.NewTimer(deferredNotificationsTimeout)
+	if s.bkgTimer.CompareAndSwap(nil, timer) {
+		return
+	}
+	timer.Stop()
+	s.bkgTimer.Load().Reset(deferredNotificationsTimeout)
+}
+
+func (s *Session) stopBackgroundTimer() {
+	if timer := s.bkgTimer.Load(); timer != nil {
+		timer.Stop()
+	}
+}
