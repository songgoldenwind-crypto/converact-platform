diff --git a/server/ivekit_hot_path_test.go b/server/ivekit_hot_path_test.go
new file mode 100644
index 0000000..8b03bd5
--- /dev/null
+++ b/server/ivekit_hot_path_test.go
@@ -0,0 +1,95 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/tinode/chat/server/store/types"
+)
+
+var ivekitBroadcastBenchmarkSink *ServerComMessage
+
+func TestIvekitForegroundSessionDoesNotAllocateBackgroundTimer(t *testing.T) {
+	var sess Session
+	if sess.background.Load() {
+		t.Fatal("new session must start in the foreground")
+	}
+	if got := sess.backgroundTimerChannel(); got != nil {
+		t.Fatal("foreground session background timer channel must be nil")
+	}
+
+	sess.background.Store(true)
+	sess.startBackgroundTimer()
+	if !sess.background.CompareAndSwap(true, false) {
+		t.Fatal("background transition must be atomic")
+	}
+	if got := sess.backgroundTimerChannel(); got == nil {
+		t.Fatal("background session timer channel must be active")
+	}
+	sess.stopBackgroundTimer()
+}
+
+func TestIvekitGroupBroadcastSharesReadOnlyMessage(t *testing.T) {
+	topic := &Topic{cat: types.TopicCatGrp, xoriginal: "grp-test"}
+	sess := &Session{proto: WEBSOCK}
+	msg := &ServerComMessage{Data: &MsgServerData{Topic: "grp-test"}}
+
+	if got := topic.messageForSession(msg, sess, perSessionData{}); got != msg {
+		t.Fatal("ordinary local group broadcast must reuse the immutable message")
+	}
+}
+
+func TestIvekitPersonalizedAndClusterBroadcastsRemainIsolated(t *testing.T) {
+	msg := &ServerComMessage{
+		Data: &MsgServerData{Topic: "grp-test", From: "usr-sender"},
+	}
+	local := &Session{proto: WEBSOCK}
+
+	p2p := &Topic{cat: types.TopicCatP2P, xoriginal: "p2p-test"}
+	if got := p2p.messageForSession(msg, local, perSessionData{}); got == msg {
+		t.Fatal("P2P broadcast must retain a per-recipient copy")
+	}
+
+	channel := &Topic{cat: types.TopicCatGrp, isChan: true, xoriginal: "grp-test"}
+	if got := channel.messageForSession(
+		msg,
+		local,
+		perSessionData{isChanSub: true},
+	); got == msg || got.Data.From != "" {
+		t.Fatal("channel reader broadcast must retain its anonymous copy")
+	}
+
+	cluster := &Session{proto: MULTIPLEX}
+	group := &Topic{cat: types.TopicCatGrp, xoriginal: "grp-test"}
+	if got := group.messageForSession(msg, cluster, perSessionData{}); got == msg {
+		t.Fatal("cluster broadcast must retain a copy because routing mutates it")
+	}
+}
+
+func BenchmarkIvekitGroupBroadcastMessage(b *testing.B) {
+	topic := &Topic{cat: types.TopicCatGrp, xoriginal: "grp-test"}
+	sess := &Session{proto: WEBSOCK}
+	pssd := perSessionData{}
+	msg := &ServerComMessage{
+		Data: &MsgServerData{
+			Topic:   "grp-test",
+			From:    "usr-sender",
+			Content: map[string]any{"text": "hello"},
+		},
+	}
+
+	b.Run("deep-copy", func(b *testing.B) {
+		b.ReportAllocs()
+		for index := 0; index < b.N; index++ {
+			copied := msg.copy()
+			topic.prepareBroadcastableMessage(copied, pssd.uid, pssd.isChanSub)
+			ivekitBroadcastBenchmarkSink = copied
+		}
+	})
+
+	b.Run("shared-group", func(b *testing.B) {
+		b.ReportAllocs()
+		for index := 0; index < b.N; index++ {
+			ivekitBroadcastBenchmarkSink = topic.messageForSession(msg, sess, pssd)
+		}
+	})
+}
