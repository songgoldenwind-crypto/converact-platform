diff --git a/server/db/postgres/ivekit_bootstrap_test.go b/server/db/postgres/ivekit_bootstrap_test.go
new file mode 100644
index 0000000..f6cf606
--- /dev/null
+++ b/server/db/postgres/ivekit_bootstrap_test.go
@@ -0,0 +1,31 @@
+//go:build postgres
+// +build postgres
+
+package postgres
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+func TestIvekitMissingDatabaseClassification(t *testing.T) {
+	missing := &pgconn.PgError{Code: "3D000"}
+	if !isMissingDb(missing) {
+		t.Fatal("expected PostgreSQL missing-database SQLSTATE to be recognized")
+	}
+	if !isMissingDb(fmt.Errorf("wrapped: %w", missing)) {
+		t.Fatal("expected wrapped PostgreSQL missing-database error to be recognized")
+	}
+	if isMissingDb(errors.New("untrusted text with SQLSTATE 3D000")) {
+		t.Fatal("plain error text must not be treated as a PostgreSQL protocol error")
+	}
+	if isMissingDb(&pgconn.PgError{Code: "42P01"}) {
+		t.Fatal("undefined-table SQLSTATE must not be treated as a missing database")
+	}
+	if isMissingDb(nil) {
+		t.Fatal("nil must not be treated as a missing database")
+	}
+}
