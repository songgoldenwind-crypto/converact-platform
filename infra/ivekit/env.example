# Pinned standalone iveKit application image and dependency images
IVEKIT_POSTGRES_IMAGE_TAG=16.10-alpine3.22
IVEKIT_REDIS_IMAGE_TAG=7.4.9
TINODE_IMAGE_TAG=0.25.3
RUSTDESK_SERVER_IMAGE_TAG=1.1.15
OPC_RUSTDESK_CLIENT_ARTIFACTS_JSON=
OPC_RUSTDESK_CLIENT_VERSION=1.4.7
OPC_RUSTDESK_CLIENT_PROFILE_TTL_SECONDS=900
IVEKIT_OPC_IMAGE_NAME=ivekit-opc:local

# Local-only HTTP listeners; publish through the Media Core Caddy L4 ingress.
OPC_HTTP_PORT=8300
TINODE_HTTP_PORT=6060
OPC_MEDIA_DOCKER_NETWORK=ivekit-media_default

# PostgreSQL one-shot owner/migration password and separate runtime passwords.
POSTGRES_PASSWORD=replace_with_random_admin_password
OPC_RUNTIME_DB_PASSWORD=replace_with_different_random_runtime_password
TINODE_DB_PASSWORD=replace_with_different_random_tinode_db_password

# Optional RustPBX Voice profile. Load docker-compose.voice.yml with --profile voice.
RUSTPBX_IMAGE=ivekit/rustpbx:0.4.11-ivekit.6-6c49ee76
RUSTPBX_TENANT_ID=replace_with_tenant_id
RUSTPBX_PROFILE_ID=replace_with_voice_profile_id
RUSTPBX_CELL_ID=replace_with_cell_id
RUSTPBX_OWNER_NODE_ID=replace_with_rustpbx_node_id
RUSTPBX_REGION_ID=region-a
RUSTPBX_ZONE_ID=zone-a
RUSTPBX_INBOUND_ADMISSION_TIMEOUT_MS=250
RUSTPBX_COMPONENT_NODE_ENABLED=false
RUSTPBX_COMPONENT_NODE_REGION_ID=region-a
RUSTPBX_COMPONENT_NODE_ZONE_ID=zone-a
RUSTPBX_COMPONENT_NODE_PROFILE_IDS=cell-10k-v1
RUSTPBX_COMPONENT_NODE_DIMENSIONS_JSON={"voice.weighted_calls":{"unit":"calls","safe_capacity":2500,"used":0,"reserved":0},"voice.recording_slots":{"unit":"recordings","safe_capacity":1250,"used":0,"reserved":0},"data.local_spool_bytes":{"unit":"bytes","safe_capacity":48318382080,"used":0,"reserved":0}}
RUSTPBX_COMPONENT_NODE_TIMEOUT_MS=500
RUSTPBX_COMPONENT_NODE_REFRESH_MS=3000
RUSTPBX_COMPONENT_NODE_TERMINAL_RETENTION_MS=300000
RUSTPBX_COMPONENT_NODE_SWEEP_INTERVAL_MS=1000
