# Pinned standalone iveKit application image and dependency images
IVEKIT_POSTGRES_IMAGE_TAG=16.10-alpine3.22
IVEKIT_REDIS_IMAGE_TAG=7.4.9
TINODE_IMAGE_TAG=0.25.3
RUSTDESK_SERVER_IMAGE_TAG=1.1.15
OPC_RUSTDESK_CLIENT_ARTIFACTS_JSON=
OPC_RUSTDESK_CLIENT_VERSION=1.4.7
OPC_RUSTDESK_CLIENT_PROFILE_TTL_SECONDS=900
IVEKIT_OPC_IMAGE_NAME=ivekit-opc:local

# Local-only HTTP listeners; publish through the Media Core Caddy L4 ingress.
OPC_HTTP_PORT=8300
TINODE_HTTP_PORT=6060
OPC_MEDIA_DOCKER_NETWORK=ivekit-media_default

# PostgreSQL one-shot owner/migration password and separate runtime passwords.
POSTGRES_PASSWORD=replace_with_random_admin_password
OPC_RUNTIME_DB_PASSWORD=replace_with_different_random_runtime_password
TINODE_DB_PASSWORD=replace_with_different_random_tinode_db_password

# Optional RustPBX Voice profile. Load docker-compose.voice.yml with --profile voice.
RUSTPBX_IMAGE=ghcr.io/restsend/rustpbx:0.4.10
RUSTPBX_PROFILE_ID=replace_with_voice_profile_id
RUSTPBX_DB_PASSWORD=replace_with_different_random_rustpbx_db_password
RUSTPBX_RWI_TOKEN=replace_with_random_rwi_control_token
RUSTPBX_WEBHOOK_TOKEN=replace_with_random_webhook_service_key
RUSTPBX_BIND_ADDRESS=0.0.0.0
RUSTPBX_EXTERNAL_IP=
RUSTPBX_SIP_PORT=5060
RUSTPBX_RTP_START_PORT=20000
RUSTPBX_RTP_END_PORT=20100
OPC_IVEKIT_VOICE_ADDRESS_KEY=replace_with_32_byte_base64_address_key
OPC_IVEKIT_VOICE_ADDRESS_HMAC_KEY=replace_with_distinct_32_byte_base64_hmac_key

# LiveKit Media Core
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
OPC_MEDIA_API_TOKEN=replace_with_random_media_service_token
OPC_MEDIA_INVITE_SECRET=replace_with_random_invite_hmac_secret

# iveKit facade authentication (legacy OPC variable names remain stable)
OPC_API_KEY=replace_with_random_opc_api_key
OPC_JWT_SECRET=replace_with_random_jwt_secret
OPC_IVEKIT_ALLOWED_ORIGINS=https://led.example.com
OPC_IVEKIT_HTTP_BODY_MAX_BYTES=1048576
OPC_IVEKIT_EVENT_REPLAY_ENABLED=1
OPC_IVEKIT_EVENT_RETENTION_MS=86400000
OPC_IVEKIT_EVENT_MAX_PAYLOAD_BYTES=65536
OPC_IVEKIT_WS_REPLAY_MAX_EVENTS=500
OPC_IVEKIT_EVENT_RETENTION_WORKER_ENABLED=1
OPC_IVEKIT_EVENT_RETENTION_INTERVAL_MS=60000
OPC_IVEKIT_EVENT_RETENTION_TENANT_LIMIT=100
OPC_IVEKIT_EVENT_RETENTION_BATCH_SIZE=1000
OPC_MEDIA_CALL_TIMEOUT_WORKER_ENABLED=1
OPC_MEDIA_CALL_TIMEOUT_INTERVAL_MS=1000
OPC_MEDIA_CALL_TIMEOUT_BATCH_SIZE=50
OPC_MEDIA_CALL_TIMEOUT_TENANT_LIMIT=100
OPC_IVEKIT_CONTACT_CENTER_WORKER_ENABLED=0
OPC_IVEKIT_CONTACT_CENTER_INTERVAL_MS=1000
OPC_IVEKIT_CONTACT_CENTER_TENANT_LIMIT=100
OPC_IVEKIT_CONTACT_CENTER_BATCH_SIZE=100
OPC_IVEKIT_CONTACT_CENTER_OFFER_TTL_SECONDS=20
OPC_IVEKIT_CONTACT_CENTER_CALLBACK_RETRY_DELAY_MS=30000
OPC_RECORDING_EXPORT_MAX_BYTES=67108864

# Durable IVR actions require host-provided executor and reconciliation adapters.
OPC_IVEKIT_IVR_WORKERS_ENABLED=0
OPC_IVEKIT_IVR_ACTION_INTERVAL_MS=1000
OPC_IVEKIT_IVR_ACTION_BATCH_SIZE=25
OPC_IVEKIT_IVR_ACTION_LEASE_MS=30000
OPC_IVEKIT_IVR_ACTION_RETRY_BASE_MS=1000
OPC_IVEKIT_IVR_ACTION_RETRY_MAX_MS=60000
OPC_IVEKIT_IVR_RECONCILIATION_INTERVAL_MS=10000
OPC_IVEKIT_IVR_RECONCILIATION_LEASE_MS=30000
OPC_IVEKIT_IVR_RECONCILIATION_RETRY_MS=10000
OPC_IVEKIT_IVR_RECONCILIATION_MAX_ATTEMPTS=20
OPC_IVEKIT_IVR_TENANT_LIMIT=100

# Private Media Core object storage
MINIO_BUCKET=recordings
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key

# V3 intelligence provider profiles. token_env values in the JSON may reference only the token variables below.
OPC_IVEKIT_PROVIDER_PROFILES_JSON=[]
OPC_IVEKIT_OCR_TOKEN=
OPC_IVEKIT_ASR_TOKEN=
OPC_IVEKIT_QUALITY_TOKEN=
OPC_IVEKIT_TRANSLATION_TOKEN=
OPC_ATTACHMENT_PROCESSING_WORKER_ENABLED=0
OPC_ATTACHMENT_PROCESSING_INTERVAL_MS=5000
OPC_ATTACHMENT_PROCESSING_BATCH_SIZE=25
OPC_ATTACHMENT_PROCESSING_MAX_ATTEMPTS=3
OPC_ATTACHMENT_PROCESSING_CLAIM_LEASE_MS=120000
OPC_ATTACHMENT_PROCESSING_RETRY_DELAYS_MS=5000,30000
OPC_QUALITY_REVIEW_AUTO_ENQUEUE=0
OPC_QUALITY_REVIEW_WORKER_ENABLED=0
OPC_QUALITY_REVIEW_INTERVAL_MS=5000
OPC_QUALITY_REVIEW_BATCH_SIZE=25
OPC_QUALITY_REVIEW_MAX_ATTEMPTS=3
OPC_QUALITY_REVIEW_CLAIM_LEASE_MS=120000
OPC_QUALITY_REVIEW_RETRY_DELAYS_MS=5000,30000
OPC_TRANSLATION_WORKER_ENABLED=0
OPC_TRANSLATION_INTERVAL_MS=5000
OPC_TRANSLATION_BATCH_SIZE=25
OPC_TRANSLATION_MAX_ATTEMPTS=3
OPC_TRANSLATION_CLAIM_LEASE_MS=120000
OPC_TRANSLATION_RETRY_DELAYS_MS=5000,30000

# Optional controlled provider for the explicit Compose acceptance profile only.
OPC_IVEKIT_CONTROLLED_MODE=success
OPC_IVEKIT_CONTROLLED_TOKEN=replace_with_test_service_token
OPC_IVEKIT_CONTROL_TOKEN=replace_with_different_test_control_token

# Tinode. TINODE_API_KEY must be a key generated by the pinned Tinode image.
TINODE_API_KEY_SALT=replace_with_random_tinode_api_key_salt
TINODE_AUTH_TOKEN_KEY=replace_with_random_tinode_auth_token_key
TINODE_UID_ENCRYPTION_KEY=replace_with_random_tinode_uid_key
TINODE_API_KEY=replace_with_generated_tinode_api_key
TINODE_BASIC_USER=opc_service
TINODE_BASIC_PASSWORD=replace_with_random_service_password
TINODE_USER_PASSWORD_SECRET=replace_with_random_user_password_hmac_secret
TINODE_PUBLIC_BASE_URL=https://tinode.example.com
TINODE_PUBLIC_WS_URL=wss://tinode.example.com/v0/channels
TINODE_UPGRADE_DB=false

# RustDesk OSS data plane and iveKit control plane
RUSTDESK_ALWAYS_USE_RELAY=N
OPC_REMOTE_GATEWAY_API_TOKEN=replace_with_random_gateway_token
OPC_RUSTDESK_API_TOKEN=replace_with_random_rustdesk_control_token
OPC_RUSTDESK_ID_SERVER=rustdesk.example.com:21116
OPC_RUSTDESK_RELAY_SERVER=rustdesk.example.com:21117
OPC_RUSTDESK_LAUNCH_BASE_URL=https://opc.example.com
OPC_RUSTDESK_PROTOCOL_URL_TEMPLATE=rustdesk://connect/{rustdesk_id}?session={external_id}
OPC_RUSTDESK_LAUNCH_SECRET=replace_with_random_launch_hmac_secret
OPC_RUSTDESK_EDGE_TOKEN_SECRET=replace_with_random_edge_token_secret
