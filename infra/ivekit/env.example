RUSTPBX_MANAGEMENT_TOKEN=replace_with_random_management_api_token
OPC_IVEKIT_VOICE_SECRET_ENV_NAMES=RUSTPBX_MANAGEMENT_TOKEN,RUSTPBX_RWI_TOKEN
OPC_IVEKIT_VOICE_WEBHOOK_SECRET_ENV_NAMES=RUSTPBX_WEBHOOK_TOKEN
