CONVERACT_LIVEKIT_TIME_SYNC_MAX_SKEW_MS=5000
CONVERACT_LIVEKIT_PREFLIGHT_ENV_CHECKLIST_FILE=/tmp/livekit-env-checklist.md
CONVERACT_LIVEKIT_PREFLIGHT_REPORT_FILE=/tmp/livekit-preflight.json

# RustPBX / PSTN. The Compose workload is opt-in through the voice profile.
