+    pub(crate) async fn verify_runtime_contract(&self) -> Result<(), SipEffectStoreError> {
+        run_with_store_deadline(STARTUP_CONTRACT_WAIT, async {
+            let (_admission, mut transaction) = self
+                .begin_tenant_transaction("sip-foundation-startup-contract")
+                .await?;
+            sqlx::query("SET LOCAL statement_timeout = '2s'")
+                .execute(&mut *transaction)
+                .await
+                .map_err(map_sqlx_error)?;
+            let recovery_contract_ready = sqlx::query_scalar::<_, bool>(
+                r#"
+                SELECT
+                  to_regclass('public.ivekit_sip_effect_session_fences') IS NOT NULL AND
+                  to_regclass('public.ivekit_sip_capability_recovery_receipts') IS NOT NULL AND
+                  to_regprocedure(
+                    'public.ivekit_sip_effect_session_insert_fence_guard()'
+                  ) IS NOT NULL AND
+                  to_regprocedure(
+                    'public.ivekit_sip_effect_send_attempt_fence_guard()'
+                  ) IS NOT NULL AND
+                  to_regprocedure(
+                    'public.ivekit_sip_effect_session_fence_guard()'
+                  ) IS NOT NULL AND
+                  to_regprocedure(
+                    'public.ivekit_sip_capability_recovery_receipt_immutable()'
+                  ) IS NOT NULL AND
+                  NOT EXISTS (
+                    SELECT 1
+                    FROM (VALUES
+                      (
+                        'ivekit_sip_effect_session_insert_fence',
+                        'ivekit_sip_protocol_effects'
+                      ),
+                      (
+                        'ivekit_sip_effect_send_attempt_fence',
+                        'ivekit_sip_protocol_effects'
+                      ),
+                      (
+                        'ivekit_sip_effect_session_fence_transition',
+                        'ivekit_sip_effect_session_fences'
+                      ),
+                      (
+                        'ivekit_sip_capability_recovery_receipt_immutable',
+                        'ivekit_sip_capability_recovery_receipts'
+                      )
+                    ) AS expected(trigger_name, relation_name)
+                    WHERE NOT EXISTS (
+                      SELECT 1
+                      FROM pg_catalog.pg_trigger AS trigger
+                      JOIN pg_catalog.pg_class AS relation
+                        ON relation.oid = trigger.tgrelid
+                      JOIN pg_catalog.pg_namespace AS namespace
+                        ON namespace.oid = relation.relnamespace
+                      WHERE namespace.nspname = 'public'
+                        AND relation.relname = expected.relation_name
+                        AND trigger.tgname = expected.trigger_name
+                        AND trigger.tgenabled <> 'D'
+                    )
+                  ) AND
+                  COALESCE((
+                    SELECT relation.relrowsecurity AND relation.relforcerowsecurity
+                    FROM pg_catalog.pg_class AS relation
+                    JOIN pg_catalog.pg_namespace AS namespace
+                      ON namespace.oid = relation.relnamespace
+                    WHERE namespace.nspname = 'public'
+                      AND relation.relname = 'ivekit_sip_effect_session_fences'
+                  ), FALSE) AND
+                  COALESCE((
+                    SELECT relation.relrowsecurity AND relation.relforcerowsecurity
+                    FROM pg_catalog.pg_class AS relation
+                    JOIN pg_catalog.pg_namespace AS namespace
+                      ON namespace.oid = relation.relnamespace
+                    WHERE namespace.nspname = 'public'
+                      AND relation.relname = 'ivekit_sip_capability_recovery_receipts'
+                  ), FALSE) AND
+                  NOT EXISTS (
+                    SELECT 1
+                    FROM (VALUES
+                      ('ivekit_sip_effect_session_fences'),
+                      ('ivekit_sip_capability_recovery_receipts')
+                    ) AS expected(relation_name)
+                    WHERE NOT EXISTS (
+                      SELECT 1
+                      FROM pg_catalog.pg_policies AS policy
+                      WHERE policy.schemaname = 'public'
+                        AND policy.tablename = expected.relation_name
+                        AND policy.policyname = 'tenant_isolation'
+                        AND policy.cmd = 'ALL'
+                    )
+                  ) AND
+                  has_table_privilege(
+                    current_user,
+                    'public.ivekit_sip_effect_session_fences',
+                    'SELECT'
+                  ) AND
+                  has_table_privilege(
+                    current_user,
+                    'public.ivekit_sip_effect_session_fences',
+                    'INSERT'
+                  ) AND
+                  NOT EXISTS (
+                    SELECT 1
+                    FROM (VALUES
+                      ('owner_epoch_high_watermark'),
+                      ('generation_high_watermark'),
+                      ('revision_high_watermark'),
+                      ('last_recovery_request_sha256'),
+                      ('updated_at')
+                    ) AS expected(column_name)
+                    WHERE NOT has_column_privilege(
+                      current_user,
+                      'public.ivekit_sip_effect_session_fences',
+                      expected.column_name,
+                      'UPDATE'
+                    )
+                  ) AND
+                  has_table_privilege(
+                    current_user,
+                    'public.ivekit_sip_capability_recovery_receipts',
+                    'SELECT'
+                  ) AND
+                  has_table_privilege(
+                    current_user,
+                    'public.ivekit_sip_capability_recovery_receipts',
+                    'INSERT'
+                  )
+                "#,
+            )
+            .fetch_one(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+            if !recovery_contract_ready {
+                return Err(SipEffectStoreError::SchemaIncompatible);
+            }
+            transaction.rollback().await.map_err(map_sqlx_error)?;
+            Ok(())
+        })
+        .await
+    }
