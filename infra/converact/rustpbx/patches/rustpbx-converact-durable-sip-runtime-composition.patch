+            .expect("owned observation supervisor");
+        assert_eq!(
+            snapshot.configured_shards,
+            SipEffectGateOptions::default().observation_worker_shards
+        );
+
+        tokio::time::timeout(std::time::Duration::from_secs(1), async {
+            loop {
+                if runtime
+                    .observation_supervisor_snapshot()
+                    .is_some_and(|snapshot| snapshot.running_shards == snapshot.configured_shards)
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("all observer workers start while the runtime holder is alive");
+
+        parent_cancel.cancel();
+        tokio::time::timeout(std::time::Duration::from_secs(1), async {
+            loop {
+                if runtime
+                    .observation_supervisor_snapshot()
+                    .is_some_and(|snapshot| snapshot.running_shards == 0)
+                {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("observer workers stop with the parent lifecycle");
+    }
