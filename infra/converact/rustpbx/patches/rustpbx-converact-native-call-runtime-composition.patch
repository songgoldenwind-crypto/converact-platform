+        let registry = std::sync::Arc::new(ActiveProxyCallRegistry::with_limits(4, 16));
+        let first = native_identity("vcall_a", "provider-call-a");
+        let second = native_identity("vcall_a", "provider-call-b");
+        let call_id = first.call_id().clone();
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(3));
+        let workers: Vec<_> = [first, second]
+            .into_iter()
+            .map(|identity| {
+                let registry = registry.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    let provider = identity.provider_call_id().as_str().to_string();
+                    barrier.wait();
+                    registry.try_upsert_authoritative(
+                        make_entry(&provider),
+                        make_handle(&provider),
+                        identity,
+                    )
+                })
+            })
+            .collect();
+        barrier.wait();
+        for worker in workers {
+            assert!(worker.join().unwrap().is_ok());
+        }
+        assert_eq!(
+            registry
+                .native_call_snapshot(&call_id)
+                .unwrap()
+                .unwrap()
+                .legs
+                .len(),
+            2,
