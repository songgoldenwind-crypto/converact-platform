+fn native_leg_direction(value: &str) -> Result<NativeLegDirection, ActiveCallRegistryError> {
+    match value {
+        "inbound" => Ok(NativeLegDirection::Inbound),
+        "outbound" => Ok(NativeLegDirection::Outbound),
+        _ => Err(ActiveCallRegistryError::InvalidDirection),
+    }
+}
+
+fn map_native_leg_registration_error(error: NativeCallError) -> ActiveCallRegistryError {
+    match error {
+        NativeCallError::CapacityExhausted => ActiveCallRegistryError::LegCapacityExhausted,
+        NativeCallError::AuthorityConflict
+        | NativeCallError::StaleOwner
+        | NativeCallError::StaleGeneration => ActiveCallRegistryError::AuthorityConflict,
+        NativeCallError::LegConflict => ActiveCallRegistryError::ProviderAlreadyRegistered,
+        _ => ActiveCallRegistryError::NativeCallStateConflict,
+    }
+}
+
+fn bind_native_protocol_dialog(
+    binding: &NativeCallBinding,
+    protocol_dialog_id: &ProtocolDialogId,
+) -> Result<(), ActiveCallRegistryError> {
+    let mut state = binding
+        .cell
+        .state
+        .lock()
+        .map_err(|_| ActiveCallRegistryError::NativeCallUnavailable)?;
+    if state.closed {
+        return Err(ActiveCallRegistryError::NativeCallUnavailable);
+    }
+    let event_hash = sha256_lower_hex(protocol_dialog_id.as_str().as_bytes());
+    let event_id = format!("dialog-bind-{event_hash}");
+    let fence = state.call.fence();
+    state
+        .call
+        .bind_protocol_dialog(
+            &fence,
+            &binding.leg_id,
+            protocol_dialog_id.clone(),
+            &event_id,
+            &event_hash,
+        )
+        .map(|_| ())
+        .map_err(|error| match error {
+            NativeCallError::CapacityExhausted => ActiveCallRegistryError::DialogCapacityExhausted,
+            NativeCallError::DialogConflict => ActiveCallRegistryError::DialogAuthorityConflict,
+            NativeCallError::AuthorityConflict
+            | NativeCallError::StaleOwner
+            | NativeCallError::StaleGeneration => ActiveCallRegistryError::AuthorityConflict,
+            _ => ActiveCallRegistryError::NativeCallStateConflict,
+        })
+}
+
+fn sha256_lower_hex(value: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let digest = Sha256::digest(value);
+    let mut encoded = String::with_capacity(64);
+    for byte in digest {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
