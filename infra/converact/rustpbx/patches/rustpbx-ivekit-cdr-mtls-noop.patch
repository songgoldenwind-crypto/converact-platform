+fn cdr_tls_paths(
+    production: bool,
+    identity_file: Option<String>,
+    ca_file: Option<String>,
+) -> std::result::Result<Option<(PathBuf, PathBuf)>, String> {
+    match (identity_file, ca_file) {
+        (Some(identity), Some(ca)) if !identity.trim().is_empty() && !ca.trim().is_empty() => {
+            let identity = PathBuf::from(identity);
+            let ca = PathBuf::from(ca);
+            if !identity.is_absolute() || !ca.is_absolute() {
+                return Err("iveKit CDR TLS files must use absolute paths".to_string());
+            }
+            Ok(Some((identity, ca)))
+        }
+        (None, None) if !production => Ok(None),
+        (None, None) => Err(
+            "IVEKIT_RUSTPBX_CDR_TLS_IDENTITY_FILE and IVEKIT_RUSTPBX_CDR_TLS_CA_FILE are required in production"
+                .to_string(),
+        ),
+        _ => Err(
+            "IVEKIT_RUSTPBX_CDR_TLS_IDENTITY_FILE and IVEKIT_RUSTPBX_CDR_TLS_CA_FILE must be configured together"
+                .to_string(),
+        ),
+    }
 }
 
+fn read_tls_pem(path: &Path, secret: bool, kind: &str) -> std::result::Result<Vec<u8>, String> {
+    let link_metadata = std::fs::symlink_metadata(path)
+        .map_err(|_| format!("iveKit CDR TLS {kind} file is unavailable"))?;
+    let metadata = std::fs::metadata(path)
+        .map_err(|_| format!("iveKit CDR TLS {kind} file is unavailable"))?;
+    if !metadata.is_file() || metadata.len() == 0 || metadata.len() > MAX_TLS_PEM_BYTES as u64 {
+        return Err(format!("iveKit CDR TLS {kind} file is invalid"));
+    }
+    if link_metadata.file_type().is_symlink() {
+        let parent = path
+            .parent()
+            .ok_or_else(|| format!("iveKit CDR TLS {kind} file is invalid"))?;
+        let canonical_parent = std::fs::canonicalize(parent)
+            .map_err(|_| format!("iveKit CDR TLS {kind} file is invalid"))?;
+        let canonical_target = std::fs::canonicalize(path)
+            .map_err(|_| format!("iveKit CDR TLS {kind} file is invalid"))?;
+        if !canonical_target.starts_with(canonical_parent) {
+            return Err(format!("iveKit CDR TLS {kind} file is invalid"));
+        }
+    } else if !link_metadata.is_file() {
+        return Err(format!("iveKit CDR TLS {kind} file is invalid"));
+    }
+    #[cfg(unix)]
+    if secret {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o037 != 0 {
+            return Err(format!(
+                "iveKit CDR TLS {kind} file permissions are too broad"
+            ));
+        }
+    }
+    let mut value = Vec::with_capacity(metadata.len() as usize);
+    File::open(path)
+        .and_then(|file| {
+            file.take(MAX_TLS_PEM_BYTES as u64 + 1)
+                .read_to_end(&mut value)
+        })
+        .map_err(|_| format!("iveKit CDR TLS {kind} file cannot be read"))?;
+    if value.is_empty() || value.len() > MAX_TLS_PEM_BYTES {
+        return Err(format!("iveKit CDR TLS {kind} file is invalid"));
+    }
+    Ok(value)
+}
