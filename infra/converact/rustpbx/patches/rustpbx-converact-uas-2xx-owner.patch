+    async fn uas_core_ack_completion_resolves_the_deferred_2xx_permit() {
+        let registry = Arc::new(SipEffectIntentRegistry::try_new(8).unwrap());
+        let writer = Arc::new(InMemoryWriter::new());
+        let (gate, mut observer) = runtime(
+            registry.clone(),
+            writer.clone(),
+            SipEffectGateOptions::default(),
+        );
+        let (key, message) = invite_ok("call-uas-2xx@example.test", "z9hG4bK-uas-2xx");
+        let _intent_lease = registry
+            .register(&key, &message, intent("effect-uas-2xx", "session-uas-2xx"))
+            .unwrap();
+        let wire = message.to_bytes();
+
+        let permit = prepare_with_transport_binding(&gate, &key, &message, &wire)
+            .await
+            .expect("durable UAS 2xx permit");
+        let prepared = writer.prepared.lock().unwrap()[0].clone();
+        assert_eq!(
+            prepared.wire_attempt_facts["completion_scope"],
+            COMPLETION_SCOPE_UAS_CORE_DEFERRED
+        );
+
+        gate.observe_transport(permit.clone(), EgressEffectOutcome::TransportAccepted);
+        assert!(observer.persist_next().await.unwrap());
+        assert_eq!(
+            writer.state(&prepared).await,
+            SipEffectState::TransportAccepted
+        );
+
+        gate.observe_protocol(permit, EgressEffectProtocolObservation::Completed);
+        assert!(observer.persist_next().await.unwrap());
+        assert_eq!(
+            writer.state(&prepared).await,
+            SipEffectState::ProtocolObserved
+        );
+        assert_eq!(gate.snapshot().pending_observations, 0);
+    }
