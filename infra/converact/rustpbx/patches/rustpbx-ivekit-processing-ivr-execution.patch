+fn validate_action_payload(
+    action: MediaControlAction,
+    payload: &Map<String, Value>,
+) -> Result<(), MediaControlClientError> {
+    match action {
+        MediaControlAction::CommitSingleLeg => {
+            if !payload.is_empty() {
+                return Err(MediaControlClientError::InvalidCommand(
+                    "processing_single_leg_payload_invalid",
+                ));
+            }
+        }
+        MediaControlAction::PlayMedia
+            if ["prompt_id", "egress_leg", "barge_in"]
+                .iter()
+                .any(|key| payload.contains_key(*key)) =>
+        {
+            if !payload_has_exact_keys(payload, &["prompt_id", "egress_leg", "barge_in"])
+                || payload
+                    .get("prompt_id")
+                    .and_then(Value::as_str)
+                    .is_none_or(|value| valid_identifier(value, "prompt_id").is_err())
+                || !matches!(
+                    payload.get("egress_leg").and_then(Value::as_str),
+                    Some("a" | "b")
+                )
+                || payload.get("barge_in").and_then(Value::as_bool).is_none()
+            {
+                return Err(MediaControlClientError::InvalidCommand(
+                    "processing_play_payload_invalid",
+                ));
+            }
+        }
+        MediaControlAction::StopMedia if payload.contains_key("target_command_id") => {
+            validate_target_command_payload(payload)?;
+        }
+        MediaControlAction::StartGather => {
+            if !payload_has_exact_keys(
+                payload,
+                &[
+                    "minimum_digits",
+                    "maximum_digits",
+                    "terminator",
+                    "first_digit_timeout_ms",
+                    "inter_digit_timeout_ms",
+                ],
+            ) {
+                return Err(MediaControlClientError::InvalidCommand(
+                    "processing_gather_payload_invalid",
+                ));
+            }
+            let minimum = payload.get("minimum_digits").and_then(Value::as_u64);
+            let maximum = payload.get("maximum_digits").and_then(Value::as_u64);
+            let terminator = payload.get("terminator");
+            let first_timeout = payload
+                .get("first_digit_timeout_ms")
+                .and_then(Value::as_u64);
+            let inter_timeout = payload
+                .get("inter_digit_timeout_ms")
+                .and_then(Value::as_u64);
+            let valid_terminator = matches!(terminator, Some(Value::Null))
+                || terminator
+                    .and_then(Value::as_str)
+                    .is_some_and(valid_dtmf_digit);
+            if minimum.is_none_or(|value| value > 1_024)
+                || maximum.is_none_or(|value| !(1..=1_024).contains(&value))
+                || minimum
+                    .zip(maximum)
+                    .is_none_or(|(minimum, maximum)| minimum > maximum)
+                || !valid_terminator
+                || first_timeout.is_none_or(|value| !(1..=3_600_000).contains(&value))
+                || inter_timeout.is_none_or(|value| !(1..=3_600_000).contains(&value))
+            {
+                return Err(MediaControlClientError::InvalidCommand(
+                    "processing_gather_payload_invalid",
+                ));
+            }
+        }
+        MediaControlAction::StopGather => validate_target_command_payload(payload)?,
+        _ => {}
+    }
+    Ok(())
+}
+
+fn validate_target_command_payload(
+    payload: &Map<String, Value>,
+) -> Result<(), MediaControlClientError> {
+    if !payload_has_exact_keys(payload, &["target_command_id"])
+        || payload
+            .get("target_command_id")
+            .and_then(Value::as_str)
+            .is_none_or(|value| valid_identifier(value, "target_command_id").is_err())
+    {
+        return Err(MediaControlClientError::InvalidCommand(
+            "processing_target_command_id_invalid",
+        ));
+    }
+    Ok(())
+}
+
+fn payload_has_exact_keys(payload: &Map<String, Value>, expected: &[&str]) -> bool {
+    payload.len() == expected.len() && expected.iter().all(|key| payload.contains_key(*key))
+}
+
+fn valid_dtmf_digit(value: &str) -> bool {
+    matches!(
+        value.as_bytes(),
+        [b'0'..=b'9'] | [b'*'] | [b'#'] | [b'A'..=b'D']
+    )
+}
+
 fn valid_error_code(value: &str) -> bool {
