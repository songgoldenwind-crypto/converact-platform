+    pub fn project_processing_terminal_event(
+        &mut self,
+        command_id: &str,
+        event: crate::call::domain::AppEvent,
+    ) -> crate::call::domain::AppEvent {
+        match event {
+            crate::call::domain::AppEvent::AudioComplete {
+                track_id,
+                interrupted,
+            } => {
+                let mapped = self
+                    .processing_playbacks
+                    .get(command_id)
+                    .filter(|operation| operation.prompt_id == track_id)
+                    .cloned();
+                if let Some(operation) = mapped {
+                    self.processing_playbacks.remove(command_id);
+                    if self.active_processing_playback.as_deref() == Some(command_id) {
+                        self.active_processing_playback = None;
+                    }
+                    crate::call::domain::AppEvent::AudioComplete {
+                        track_id: operation.track_id,
+                        interrupted,
+                    }
+                } else {
+                    crate::call::domain::AppEvent::AudioComplete {
+                        track_id,
+                        interrupted,
+                    }
+                }
+            }
+            event @ crate::call::domain::AppEvent::DtmfCollected { .. } => {
+                if self.processing_gathers.remove(command_id).is_some()
+                    && self.active_processing_gather.as_deref() == Some(command_id)
+                {
+                    self.active_processing_gather = None;
+                }
+                event
+            }
+            event => event,
+        }
+    }
