+pub(crate) fn materialize_derived_effect(
+    parent: &SipEffectRecord,
+    attempt: &SipEffectDerivedAttempt,
+) -> Result<PreparedSipEffect, SipEffectGateError> {
+    if attempt.kind != EgressDerivedEffectKind::ClientNon2xxInviteAck
+        || !matches!(
+            parent.state,
+            SipEffectState::SendAttempted
+                | SipEffectState::TransportAccepted
+                | SipEffectState::ProtocolObserved
+        )
+        || parent.identity.tenant_id.as_str() != attempt.parent.tenant_id.as_ref()
+        || parent.identity.protocol_effect_id.as_str() != attempt.parent.protocol_effect_id.as_ref()
+        || protocol_effect_identity_hash(&parent.identity)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?
+            != attempt.parent.effect_identity_hash.as_ref()
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+
+    let parent_message = SipMessage::try_from(parent.canonical_wire_bytes.as_slice())
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    let (parent_request, final_response, ack_request) =
+        match (&parent_message, &attempt.trigger_message, &attempt.message) {
+            (
+                SipMessage::Request(parent_request),
+                SipMessage::Response(final_response),
+                SipMessage::Request(ack_request),
+            ) if parent_request.method == rsipstack::sip::Method::Invite
+                && ack_request.method == rsipstack::sip::Method::Ack
+                && (300..=699).contains(&final_response.status_code.code()) =>
+            {
+                (parent_request, final_response, ack_request)
+            }
+            _ => return Err(SipEffectGateError::InvalidIntent),
+        };
+    let parent_branch = message_via_branch(&parent_message)?;
+    let trigger_branch = message_via_branch(&attempt.trigger_message)?;
+    let ack_branch = message_via_branch(&attempt.message)?;
+    if attempt.canonical_wire_bytes != attempt.message.to_bytes()
+        || TransactionKey::from_request(parent_request, TransactionRole::Client)
+            .ok()
+            .as_ref()
+            != Some(&attempt.transaction_key)
+        || TransactionKey::from_response(final_response, TransactionRole::Client)
+            .ok()
+            .as_ref()
+            != Some(&attempt.transaction_key)
+        || parent_request.uri != ack_request.uri
+        || parent_branch != trigger_branch
+        || parent_branch != ack_branch
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+
+    let parent_cseq = parent_request
