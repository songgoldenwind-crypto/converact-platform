+async fn prepare_for_send_locked(
+    transaction: &mut Transaction<'_, Postgres>,
+    effect: &PreparedSipEffect,
+) -> Result<SipEffectPrepareForSendOutcome, SipEffectStoreError> {
+    effect.validate()?;
+    let audit_retention_ms = audit_retention_millis(effect)?;
+    let effect_identity_hash = protocol_effect_identity_hash(&effect.identity)?;
+    let (prepared, schema) = prepare_locked(
+        transaction,
+        effect,
+        &effect_identity_hash,
+        audit_retention_ms,
+    )
+    .await?;
+    let mut record = prepared.record;
+    if record.state == SipEffectState::Prepared {
+        let receipt = prepare_stage_receipt(
+            &record,
+            "durable-decision",
+            SipEffectReceiptLevel::DurableDecision,
+        )?;
+        record = apply_locked(
+            transaction,
+            DecodedEffect {
+                record,
+                payload_retained: true,
+                schema,
+            },
+            receipt,
+            &effect_identity_hash,
+        )
+        .await?
+        .record;
+        flush_receipt_constraint(transaction).await?;
+    }
+    if record.state == SipEffectState::DurableDecision {
+        let receipt = prepare_stage_receipt(
+            &record,
+            "send-attempted",
+            SipEffectReceiptLevel::SendAttempted,
+        )?;
+        let sent = apply_locked(
+            transaction,
+            DecodedEffect {
+                record,
+                payload_retained: true,
+                schema,
+            },
+            receipt,
+            &effect_identity_hash,
+        )
+        .await?;
+        record = sent.record;
+        if sent.replayed {
+            return Ok(SipEffectPrepareForSendOutcome {
+                record,
+                send_attempt_replayed: true,
+            });
+        }
+    } else if record.state == SipEffectState::SendAttempted {
+        return Ok(SipEffectPrepareForSendOutcome {
+            record,
+            send_attempt_replayed: true,
+        });
+    } else {
+        return Err(SipEffectError::TransitionConflict.into());
+    }
+    if record.state != SipEffectState::SendAttempted {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    Ok(SipEffectPrepareForSendOutcome {
+        record,
+        send_attempt_replayed: false,
+    })
+}
