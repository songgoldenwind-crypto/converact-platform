+use crate::call::domain::{CallCommand, CallCommandRx};
+use crate::proxy::active_call_registry::{ActiveCallAdmissionLease, ActiveProxyCallRegistry};
+use crate::proxy::proxy_call::media_peer::MediaPeer;
+use std::sync::Arc;
+use std::time::Duration;
+use tracing::warn;
+
+const OUTBOUND_CALL_HARD_LIFETIME: Duration = Duration::from_secs(3_600);
+
+pub(crate) fn spawn_confirmed_outbound_owner(
+    call_id: String,
+    registry: Arc<ActiveProxyCallRegistry>,
+    active_call_lease: ActiveCallAdmissionLease,
+    dialog_guard: rsipstack::dialog::invitation::DialogGuard,
+    mut cmd_rx: CallCommandRx,
+    media_keepalive: Option<Arc<dyn MediaPeer>>,
+) {
+    crate::utils::spawn(async move {
+        let _active_call_lease = active_call_lease;
+        let _dialog_guard = dialog_guard;
+        let _media_keepalive = media_keepalive;
+        let deadline = tokio::time::sleep(OUTBOUND_CALL_HARD_LIFETIME);
+        tokio::pin!(deadline);
+
+        loop {
+            tokio::select! {
+                _ = &mut deadline => break,
+                command = cmd_rx.recv() => match command {
+                    Some(CallCommand::Hangup(_)) | None => break,
+                    Some(_) => {
+                        warn!(
+                            %call_id,
+                            "confirmed outbound owner rejected an unsupported command"
+                        );
+                    }
+                }
+            }
+        }
+        registry.remove(&call_id);
+    });
+}
