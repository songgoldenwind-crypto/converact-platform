+#[tokio::test]
+async fn transaction_local_gate_installs_after_trying_and_gates_the_first_final_effect() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+        reject_prepare: false,
+    });
+    let (mut transaction, peer) = udp_server_transaction(EndpointOption::default(), None).await;
+
+    transaction
+        .send_trying()
+        .await
+        .expect("send ungated Trying");
+    let trying = crate::sip::SipMessage::try_from(recv_udp_bytes(&peer).await.as_slice())
+        .expect("valid Trying");
+    assert!(matches!(
+        trying,
+        crate::sip::SipMessage::Response(response)
+            if response.status_code == crate::sip::StatusCode::Trying
+    ));
+
+    transaction
+        .install_egress_effect_gate(gate.clone())
+        .expect("install one transaction-local gate after 100 Trying");
+    transaction
+        .reply(crate::sip::StatusCode::ServiceUnavailable)
+        .await
+        .expect("send gated final response");
+    let final_response = recv_udp_bytes(&peer).await;
+
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.canonical_wire_images
+            .lock()
+            .expect("wire image lock")
+            .as_slice(),
+        [final_response]
+    );
+    assert!(
+        transaction.install_egress_effect_gate(gate).is_err(),
+        "a gate cannot be installed or replaced after a final attempt"
+    );
+}
