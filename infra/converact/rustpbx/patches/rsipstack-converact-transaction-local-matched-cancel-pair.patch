+#[tokio::test]
+async fn matched_cancel_authorizes_200_and_487_as_two_peer_derived_effects() {
+    let gate = Arc::new(RecordingPeerDerivedGate {
+        primary_prepare_calls: AtomicUsize::new(0),
+        peer_derived_calls: AtomicUsize::new(0),
+        trigger_and_response: std::sync::Mutex::new(Vec::new()),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+    });
+    let (mut transaction, peer) = udp_server_transaction(EndpointOption::default(), None).await;
+    transaction.send_trying().await.expect("send Trying");
+    let _trying = recv_udp_bytes(&peer).await;
+    transaction
+        .install_egress_effect_gate(gate.clone())
+        .expect("scope durable effects to the admitted INVITE");
+
+    let cancel = matching_cancel(&transaction);
+    transaction
+        .tu_sender
+        .send(peer_received(
+            cancel.into(),
+            transaction.connection.clone().expect("server connection"),
+        ))
+        .expect("matched CANCEL ingress");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(crate::sip::SipMessage::Request(request))
+            if request.method == crate::sip::Method::Cancel
+    ));
+    let cancel_ok = crate::sip::SipMessage::try_from(recv_udp_bytes(&peer).await.as_slice())
+        .expect("valid 200-to-CANCEL");
+    assert!(matches!(
+        cancel_ok,
+        crate::sip::SipMessage::Response(response)
+            if response.status_code == crate::sip::StatusCode::OK
+    ));
+
+    transaction
+        .reply(crate::sip::StatusCode::RequestTerminated)
+        .await
+        .expect("send peer-derived 487-to-INVITE");
+    let invite_terminated =
+        crate::sip::SipMessage::try_from(recv_udp_bytes(&peer).await.as_slice())
+            .expect("valid 487-to-INVITE");
+    assert!(matches!(
+        invite_terminated,
+        crate::sip::SipMessage::Response(response)
+            if response.status_code == crate::sip::StatusCode::RequestTerminated
+    ));
+    assert_eq!(gate.primary_prepare_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(gate.peer_derived_calls.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        gate.protocol_observations
+            .lock()
+            .expect("peer-derived protocol lock")
+            .as_slice(),
+        [EgressEffectProtocolObservation::TransportTerminal]
+    );
+
+    let mut ack = transaction.original.clone();
+    ack.method = crate::sip::Method::Ack;
+    ack.headers.unique_push(CSeq::new("1 ACK").into());
+    transaction
+        .tu_sender
+        .send(peer_received(
+            ack.into(),
+            transaction.connection.clone().expect("server connection"),
+        ))
+        .expect("matching ACK ingress");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(crate::sip::SipMessage::Request(request))
+            if request.method == crate::sip::Method::Ack
+    ));
+    assert_eq!(
+        gate.protocol_observations
+            .lock()
+            .expect("peer-derived protocol lock")
+            .as_slice(),
+        [
+            EgressEffectProtocolObservation::TransportTerminal,
+            EgressEffectProtocolObservation::Completed,
+        ]
+    );
+}
