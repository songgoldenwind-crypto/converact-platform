+
+fn extract_owner_call_ids(cmd: &RwiCommandPayload) -> Vec<&str> {
+    match cmd {
+        RwiCommandPayload::Bridge { leg_a, leg_b } => {
+            vec![leg_a.as_str(), leg_b.as_str()]
+        }
+        RwiCommandPayload::SetRingbackSource {
+            target_call_id,
+            source_call_id,
+        } => vec![target_call_id.as_str(), source_call_id.as_str()],
+        RwiCommandPayload::TransferComplete {
+            call_id,
+            consultation_call_id,
+        } => vec![call_id.as_str(), consultation_call_id.as_str()],
+        RwiCommandPayload::SupervisorListen {
+            supervisor_call_id,
+            target_call_id,
+        }
+        | RwiCommandPayload::SupervisorWhisper {
+            supervisor_call_id,
+            target_call_id,
+            ..
+        }
+        | RwiCommandPayload::SupervisorBarge {
+            supervisor_call_id,
+            target_call_id,
+            ..
+        }
+        | RwiCommandPayload::SupervisorTakeover {
+            supervisor_call_id,
+            target_call_id,
+        }
+        | RwiCommandPayload::SupervisorStop {
+            supervisor_call_id,
+            target_call_id,
+        } => vec![supervisor_call_id.as_str(), target_call_id.as_str()],
+        _ => extract_call_id(cmd).into_iter().collect(),
+    }
+}
