diff --git a/src/ivekit_owner.rs b/src/ivekit_owner.rs
new file mode 100644
index 0000000..84aa441
--- /dev/null
+++ b/src/ivekit_owner.rs
@@ -0,0 +1,429 @@
+use anyhow::{Result, anyhow};
+use async_trait::async_trait;
+use converact_component_hook::{
+    Authorization, AuthorizationRequest, Authorizer, Guard, Operation, Request,
+};
+use dashmap::DashMap;
+use serde::{Deserialize, Serialize};
+use std::error::Error as StdError;
+use std::sync::{Arc, OnceLock};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use crate::proxy::proxy_call::session_hooks::{CallSessionContext, CallSessionHook};
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct OwnerContract {
+    pub reservation_id: String,
+    pub interaction_id: String,
+    pub owner_epoch: String,
+}
+
+struct DisabledAuthorizer;
+
+impl Authorizer for DisabledAuthorizer {
+    fn authorize(
+        &self,
+        _request: AuthorizationRequest,
+    ) -> std::result::Result<Authorization, Box<dyn StdError + Send + Sync>> {
+        Err("ivekit owner uses the host async HTTP client".into())
+    }
+}
+
+struct OwnerEntry {
+    contract: OwnerContract,
+    guard: Guard<DisabledAuthorizer>,
+}
+
+#[derive(Clone)]
+struct OwnerConfig {
+    endpoint: reqwest::Url,
+    token: String,
+    node_id: String,
+    timeout: Duration,
+    refresh_interval: Duration,
+    client: reqwest::Client,
+}
+
+#[derive(Serialize)]
+struct WireAuthorizationRequest<'a> {
+    reservation_id: &'a str,
+    interaction_id: &'a str,
+    owner_epoch: &'a str,
+    operation: &'a str,
+}
+
+#[derive(Deserialize)]
+struct WireAuthorizationEnvelope {
+    data: WireAuthorization,
+}
+
+#[derive(Deserialize)]
+struct WireAuthorization {
+    allowed: bool,
+    component: String,
+    node_id: String,
+    cell_lease_epoch: u64,
+    owner_epoch: String,
+    state_sequence: u64,
+    lease_expires_at: String,
+}
+
+static CONFIG: OnceLock<std::result::Result<Option<OwnerConfig>, String>> = OnceLock::new();
+static OWNERS: OnceLock<DashMap<String, Arc<OwnerEntry>>> = OnceLock::new();
+
+pub async fn ensure_owner(provider_call_id: &str, contract: OwnerContract) -> Result<()> {
+    valid_provider_call_id(provider_call_id)?;
+    let Some(config) = config()? else {
+        return Ok(());
+    };
+    let owners = owners();
+    if let Some(existing) = owners.get(provider_call_id) {
+        if existing.contract.reservation_id != contract.reservation_id
+            || existing.contract.interaction_id != contract.interaction_id
+            || existing.contract.owner_epoch != contract.owner_epoch
+        {
+            return Err(anyhow!("owner contract conflict"));
+        }
+        existing
+            .guard
+            .assert_mutation(&contract.owner_epoch, now_unix_ms())
+            .map_err(|error| anyhow!("owner guard rejected: {error}"))?;
+        return Ok(());
+    }
+
+    let request = hook_request(&contract);
+    let authorization = authorize(config, &contract, Operation::Open).await?;
+    let guard = Guard::new(DisabledAuthorizer);
+    guard
+        .open_authorized(request, authorization, now_unix_ms())
+        .map_err(|error| anyhow!("owner open rejected: {error}"))?;
+    let entry = Arc::new(OwnerEntry {
+        contract: contract.clone(),
+        guard,
+    });
+    match owners.entry(provider_call_id.to_string()) {
+        dashmap::mapref::entry::Entry::Occupied(existing) => {
+            let current = existing.get();
+            if current.contract.reservation_id != contract.reservation_id
+                || current.contract.interaction_id != contract.interaction_id
+                || current.contract.owner_epoch != contract.owner_epoch
+            {
+                return Err(anyhow!("owner contract conflict"));
+            }
+        }
+        dashmap::mapref::entry::Entry::Vacant(vacant) => {
+            vacant.insert(entry);
+            start_refresh(provider_call_id.to_string());
+        }
+    }
+    Ok(())
+}
+
+pub fn assert_mutation(provider_call_id: &str, supplied_epoch: Option<&str>) -> Result<()> {
+    let Some(entry) = owners().get(provider_call_id) else {
+        return Ok(());
+    };
+    let supplied_epoch = supplied_epoch.ok_or_else(|| anyhow!("owner epoch is required"))?;
+    entry
+        .guard
+        .assert_mutation(supplied_epoch, now_unix_ms())
+        .map_err(|error| anyhow!("owner mutation rejected: {error}"))
+}
+
+pub fn session_hook() -> Result<Option<Arc<dyn CallSessionHook>>> {
+    Ok(config()?.map(|_| Arc::new(IveKitOwnerSessionHook) as Arc<dyn CallSessionHook>))
+}
+
+pub struct IveKitOwnerSessionHook;
+
+#[async_trait]
+impl CallSessionHook for IveKitOwnerSessionHook {
+    async fn on_call_ended(
+        &self,
+        context: &CallSessionContext,
+        _reason: Option<&crate::callrecord::CallRecordHangupReason>,
+        _duration_secs: u64,
+    ) {
+        close_owner(&context.session_id).await;
+    }
+}
+
+async fn close_owner(provider_call_id: &str) {
+    let Some((_, entry)) = owners().remove(provider_call_id) else {
+        return;
+    };
+    let Ok(config) = required_config() else {
+        return;
+    };
+    match authorize(config, &entry.contract, Operation::Close).await {
+        Ok(authorization) => {
+            if let Err(error) = entry.guard.close_authorized(authorization) {
+                tracing::warn!(
+                    %provider_call_id,
+                    error = %error,
+                    "iveKit owner close rejected"
+                );
+            }
+        }
+        Err(error) => {
+            tracing::warn!(
+                %provider_call_id,
+                error = %error,
+                "iveKit owner close authorization failed"
+            );
+        }
+    }
+}
+
+fn start_refresh(provider_call_id: String) {
+    crate::utils::spawn(async move {
+        loop {
+            let Ok(config) = required_config() else {
+                return;
+            };
+            tokio::time::sleep(config.refresh_interval).await;
+            let Some(entry) = owners().get(&provider_call_id).map(|value| value.clone()) else {
+                return;
+            };
+            match authorize(config, &entry.contract, Operation::Mutate).await {
+                Ok(authorization) => {
+                    if let Err(error) = entry.guard.refresh_authorized(authorization, now_unix_ms())
+                    {
+                        tracing::warn!(
+                            %provider_call_id,
+                            error = %error,
+                            "iveKit owner refresh rejected"
+                        );
+                    }
+                }
+                Err(error) => {
+                    tracing::warn!(
+                        %provider_call_id,
+                        error = %error,
+                        "iveKit owner refresh authorization failed"
+                    );
+                }
+            }
+        }
+    });
+}
+
+async fn authorize(
+    config: &OwnerConfig,
+    contract: &OwnerContract,
+    operation: Operation,
+) -> Result<Authorization> {
+    let operation = match operation {
+        Operation::Open => "open",
+        Operation::Mutate => "mutate",
+        Operation::Close => "close",
+    };
+    let request = config
+        .client
+        .post(config.endpoint.join("/v1/authorize")?)
+        .bearer_auth(&config.token)
+        .json(&WireAuthorizationRequest {
+            reservation_id: &contract.reservation_id,
+            interaction_id: &contract.interaction_id,
+            owner_epoch: &contract.owner_epoch,
+            operation,
+        })
+        .send();
+    let response = tokio::time::timeout(config.timeout, request)
+        .await
+        .map_err(|_| anyhow!("component authorization timed out"))??;
+    if !response.status().is_success() {
+        return Err(anyhow!("component authorization rejected"));
+    }
+    let wire = response.json::<WireAuthorizationEnvelope>().await?.data;
+    if !wire.allowed || wire.component != "rustpbx" || wire.node_id != config.node_id {
+        return Err(anyhow!("component authorization identity mismatch"));
+    }
+    let expires_at = chrono::DateTime::parse_from_rfc3339(&wire.lease_expires_at)
+        .map_err(|_| anyhow!("component authorization lease is invalid"))?;
+    let lease_expires_unix_ms = u64::try_from(expires_at.timestamp_millis())
+        .map_err(|_| anyhow!("component authorization lease is invalid"))?;
+    Ok(Authorization {
+        allowed: wire.allowed,
+        component: wire.component,
+        node_id: wire.node_id,
+        cell_lease_epoch: wire.cell_lease_epoch,
+        owner_epoch: wire.owner_epoch,
+        state_sequence: wire.state_sequence,
+        lease_expires_unix_ms,
+    })
+}
+
+fn hook_request(contract: &OwnerContract) -> Request {
+    Request {
+        reservation_id: contract.reservation_id.clone(),
+        interaction_id: contract.interaction_id.clone(),
+        owner_epoch: contract.owner_epoch.clone(),
+    }
+}
+
+fn required_config() -> Result<&'static OwnerConfig> {
+    config()?.ok_or_else(|| anyhow!("iveKit component owner is not configured"))
+}
+
+fn config() -> Result<Option<&'static OwnerConfig>> {
+    match CONFIG.get_or_init(load_config) {
+        Ok(Some(config)) => Ok(Some(config)),
+        Ok(None) => Ok(None),
+        Err(error) => Err(anyhow!(error.clone())),
+    }
+}
+
+fn load_config() -> std::result::Result<Option<OwnerConfig>, String> {
+    let enabled = match std::env::var("IVEKIT_RUSTPBX_COMPONENT_NODE_ENABLED") {
+        Ok(value) if matches!(value.as_str(), "true" | "1") => true,
+        Ok(value) if matches!(value.as_str(), "false" | "0") => false,
+        Ok(_) => return Err("component node enabled flag is invalid".to_string()),
+        Err(_) => false,
+    };
+    if !enabled {
+        return Ok(None);
+    }
+    let endpoint = std::env::var("IVEKIT_RUSTPBX_COMPONENT_NODE_URL").ok();
+    let token = std::env::var("IVEKIT_RUSTPBX_COMPONENT_NODE_TOKEN").ok();
+    let node_id = std::env::var("IVEKIT_RUSTPBX_OWNER_NODE_ID").ok();
+    let endpoint = reqwest::Url::parse(
+        endpoint
+            .as_deref()
+            .ok_or("component node URL is required")?,
+    )
+    .map_err(|_| "component node URL is invalid")?;
+    let loopback = matches!(endpoint.host_str(), Some("127.0.0.1" | "::1" | "localhost"));
+    if endpoint.scheme() != "http"
+        || !loopback
+        || !endpoint.username().is_empty()
+        || endpoint.password().is_some()
+    {
+        return Err("component node URL must use local HTTP".to_string());
+    }
+    let token = token.ok_or("component node token is required")?;
+    if token.len() < 24 || token.len() > 512 || token.bytes().any(|byte| byte.is_ascii_control()) {
+        return Err("component node token is invalid".to_string());
+    }
+    let node_id = node_id.ok_or("component owner node ID is required")?;
+    valid_node_identifier(&node_id).map_err(|_| "component owner node ID is invalid")?;
+    let timeout_ms = env_u64("IVEKIT_RUSTPBX_COMPONENT_NODE_TIMEOUT_MS", 500, 100, 30_000)?;
+    let refresh_ms = env_u64(
+        "IVEKIT_RUSTPBX_COMPONENT_NODE_REFRESH_MS",
+        3_000,
+        100,
+        60_000,
+    )?;
+    let client = reqwest::Client::builder()
+        .connect_timeout(Duration::from_millis(timeout_ms))
+        .timeout(Duration::from_millis(timeout_ms))
+        .pool_max_idle_per_host(4)
+        .build()
+        .map_err(|_| "component node HTTP client is invalid")?;
+    Ok(Some(OwnerConfig {
+        endpoint,
+        token,
+        node_id,
+        timeout: Duration::from_millis(timeout_ms),
+        refresh_interval: Duration::from_millis(refresh_ms),
+        client,
+    }))
+}
+
+fn env_u64(name: &str, fallback: u64, minimum: u64, maximum: u64) -> Result<u64, String> {
+    let parsed = match std::env::var(name) {
+        Ok(value) => value
+            .parse::<u64>()
+            .map_err(|_| format!("{name} is invalid"))?,
+        Err(_) => fallback,
+    };
+    if !(minimum..=maximum).contains(&parsed) {
+        return Err(format!("{name} is invalid"));
+    }
+    Ok(parsed)
+}
+
+fn valid_provider_call_id(value: &str) -> Result<()> {
+    let mut words = value.split('@');
+    let left = words.next().unwrap_or_default();
+    let right = words.next();
+    if value.len() > 255
+        || !valid_call_id_word(left)
+        || right.is_some_and(|word| !valid_call_id_word(word))
+        || words.next().is_some()
+    {
+        return Err(anyhow!("invalid SIP Call-ID"));
+    }
+    Ok(())
+}
+
+fn valid_call_id_word(value: &str) -> bool {
+    !value.is_empty()
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric()
+                || matches!(
+                    byte,
+                    b'-' | b'.' | b'!' | b'%' | b'*' | b'_' | b'+' | b'`' | b'\''
+                        | b'~' | b'(' | b')' | b'<' | b'>' | b':' | b'\\' | b'"' | b'/'
+                        | b'[' | b']' | b'?' | b'{' | b'}'
+                )
+        })
+}
+
+fn valid_node_identifier(value: &str) -> Result<()> {
+    if value.is_empty()
+        || value.len() > 255
+        || !value.chars().enumerate().all(|(index, character)| {
+            character.is_ascii_alphanumeric()
+                || (index > 0 && matches!(character, '.' | '_' | ':' | '-'))
+        })
+    {
+        return Err(anyhow!("invalid owner identifier"));
+    }
+    Ok(())
+}
+
+fn owners() -> &'static DashMap<String, Arc<OwnerEntry>> {
+    OWNERS.get_or_init(DashMap::new)
+}
+
+fn now_unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn owner_accepts_standard_sip_call_ids() {
+        assert!(valid_provider_call_id("1-24817@172.30.45.20").is_ok());
+        assert!(valid_provider_call_id("call_id:branch+one").is_ok());
+    }
+
+    #[test]
+    fn owner_rejects_malformed_or_unsafe_sip_call_ids() {
+        for value in [
+            "",
+            "@host",
+            "local@",
+            "local@host@extra",
+            "local host",
+            "local\nhost",
+            "本地@host",
+        ] {
+            assert!(valid_provider_call_id(value).is_err(), "{value:?}");
+        }
+    }
+
+    #[test]
+    fn component_node_identifier_remains_strict() {
+        assert!(valid_node_identifier("rustpbx-node-1").is_ok());
+        assert!(valid_node_identifier("rustpbx@node").is_err());
+    }
+}
