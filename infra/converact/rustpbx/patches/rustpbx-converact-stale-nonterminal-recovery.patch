+fn bounded_stale_nonterminal_millis(duration: Duration) -> Result<i64, SipEffectStoreError> {
+    let milliseconds = u64::try_from(duration.as_millis())
+        .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+    if duration < MIN_STALE_NONTERMINAL_AGE
+        || duration > MAX_STALE_NONTERMINAL_AGE
+        || Duration::from_millis(milliseconds) != duration
+    {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    i64::try_from(milliseconds).map_err(|_| SipEffectStoreError::InvalidConfiguration)
+}
+
+fn bounded_stale_nonterminal_batch_limit(limit: usize) -> Result<i64, SipEffectStoreError> {
+    if limit == 0 || limit > MAX_STALE_NONTERMINAL_BATCH_SIZE {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    i64::try_from(limit).map_err(|_| SipEffectStoreError::InvalidConfiguration)
+}
+
+fn bounded_stale_recovery_repair_delay(value: u32) -> Result<i32, SipEffectStoreError> {
+    if value > MAX_STALE_RECOVERY_REPAIR_DELAY_MS {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    i32::try_from(value).map_err(|_| SipEffectStoreError::InvalidConfiguration)
+}
