+    validate_sip_effect_identifier(protocol_session_id)?;
+    let generation = protocol_session_generation
+        .parse::<u64>()
+        .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+    if generation == 0
+        || generation.to_string() != protocol_session_generation
+        || successor_owner_epoch == 0
+    {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    Ok(())
+}
