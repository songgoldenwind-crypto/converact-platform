+pub struct PostgresSipEffectStore {
+    pool: PgPool,
+    admission: SipEffectAdmission,
+    wait_timeout: Duration,
+}
+
+impl PostgresSipEffectStore {
+    pub async fn connect(
+        database_url: &str,
+        options: PostgresSipEffectStoreOptions,
+    ) -> Result<Self, SipEffectStoreError> {
+        let options = options.validate()?;
+        let max_connections = u32::try_from(options.max_in_flight)
+            .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+        let pool = PgPoolOptions::new()
+            .max_connections(max_connections)
+            .acquire_timeout(options.wait_timeout)
+            .connect(database_url)
+            .await
+            .map_err(map_sqlx_error)?;
+        Self::from_pool(pool, options)
+    }
+
+    pub fn from_pool(
+        pool: PgPool,
+        options: PostgresSipEffectStoreOptions,
+    ) -> Result<Self, SipEffectStoreError> {
+        let options = options.validate()?;
+        Ok(Self {
+            pool,
+            admission: SipEffectAdmission::new(
+                options.max_in_flight,
+                options.max_queue_depth,
+                options.wait_timeout,
+            )?,
+            wait_timeout: options.wait_timeout,
+        })
+    }
+
+    pub fn admission_snapshot(&self) -> SipEffectAdmissionSnapshot {
+        self.admission.snapshot()
+    }
+
+    pub async fn prepare(
+        &self,
+        effect: PreparedSipEffect,
+    ) -> Result<SipEffectPrepareOutcome, SipEffectStoreError> {
+        effect.validate()?;
+        let effect_identity_hash = protocol_effect_identity_hash(&effect.identity)?;
+        let (_admission, mut transaction) = self
+            .begin_tenant_transaction(&effect.identity.tenant_id)
+            .await?;
+        let inserted = sqlx::query(PREPARE_INSERT_SQL)
+            .bind(&effect.identity.protocol_effect_id)
+            .bind(&effect.identity.tenant_id)
+            .bind(&effect.identity.protocol_session_id)
+            .bind(&effect.identity.protocol_session_generation)
+            .bind(&effect.identity.decision_id)
+            .bind(&effect.identity.idempotency_key)
+            .bind(&effect.identity.request_hash)
+            .bind(&effect.identity.command_id)
+            .bind(&effect.adapter_identity)
+            .bind(&effect.identity.adapter_identity_hash)
+            .bind(&effect.identity.wire_bytes_hash)
+            .bind(
+                i32::try_from(effect.identity.wire_length_bytes)
+                    .map_err(|_| SipEffectStoreError::InvalidConfiguration)?,
+            )
+            .bind(&effect.canonical_wire_bytes)
+            .bind(&effect.route_binding)
+            .bind(&effect.identity.route_binding_hash)
+            .bind(&effect.wire_attempt_facts)
+            .bind(&effect.identity.wire_attempt_facts_hash)
+            .bind(&effect.identity.wire_freeze_sha256)
+            .bind(&effect_identity_hash)
+            .bind(effect.identity.owner_epoch.to_string())
+            .bind(effect.identity.command_sequence.to_string())
+            .bind(SIP_EFFECT_SCHEMA_ID)
+            .bind(i32::from(SIP_EFFECT_SCHEMA_VERSION))
+            .bind(SIP_EFFECT_SCHEMA_HASH)
+            .bind(SIP_EFFECT_WRITER_IDENTITY)
+            .bind(effect.audit_until)
+            .bind(effect.prepared_at)
+            .fetch_optional(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+
+        let outcome = if let Some(row) = inserted {
+            SipEffectPrepareOutcome {
+                record: decode_effect(&row)?.record,
+                replayed: false,
+            }
+        } else {
+            let rows = sqlx::query(PREPARE_CONFLICT_SQL)
+                .bind(&effect.identity.tenant_id)
+                .bind(&effect.identity.protocol_effect_id)
+                .bind(&effect.identity.idempotency_key)
+                .fetch_all(&mut *transaction)
+                .await
+                .map_err(map_sqlx_error)?;
+            if rows.len() != 1 {
+                return Err(SipEffectError::IdempotencyConflict.into());
+            }
+            let existing = decode_effect(&rows[0])?;
+            if existing.record.identity != effect.identity
+                || (existing.payload_retained
+                    && existing.record.canonical_wire_bytes != effect.canonical_wire_bytes)
+            {
+                return Err(SipEffectError::IdempotencyConflict.into());
+            }
+            SipEffectPrepareOutcome {
+                record: existing.record,
+                replayed: true,
+            }
+        };
+        transaction.commit().await.map_err(map_sqlx_error)?;
+        Ok(outcome)
+    }
+
+    pub async fn query(
+        &self,
+        identity: &crate::call::domain::sip_effect::SipEffectIdentity,
+    ) -> Result<Option<SipEffectRecord>, SipEffectStoreError> {
+        let expected_identity_hash = protocol_effect_identity_hash(identity)?;
+        let (_admission, mut transaction) =
+            self.begin_tenant_transaction(&identity.tenant_id).await?;
+        let row = sqlx::query(QUERY_SQL)
+            .bind(&identity.tenant_id)
+            .bind(&identity.protocol_effect_id)
+            .fetch_optional(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        let record = if let Some(row) = row {
+            let decoded = decode_effect(&row)?;
+            if &decoded.record.identity != identity
+                || protocol_effect_identity_hash(&decoded.record.identity)?
+                    != expected_identity_hash
+            {
+                return Err(SipEffectError::IdentityConflict.into());
+            }
+            Some(decoded.record)
+        } else {
+            None
+        };
+        transaction.commit().await.map_err(map_sqlx_error)?;
+        Ok(record)
+    }
+
+    async fn begin_tenant_transaction(
+        &self,
+        tenant_id: &str,
+    ) -> Result<(SipEffectAdmissionLease, Transaction<'_, Postgres>), SipEffectStoreError> {
+        if tenant_id.is_empty() {
+            return Err(SipEffectError::InvalidInput.into());
+        }
+        let admission = self.admission.enter().await?;
+        let transaction = tokio::time::timeout(self.wait_timeout, self.pool.begin())
+            .await
+            .map_err(|_| SipEffectStoreError::PoolTimeout)?
+            .map_err(map_sqlx_error)?;
+        let mut transaction = transaction;
+        sqlx::query("SET LOCAL statement_timeout = '250ms'")
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SET LOCAL lock_timeout = '250ms'")
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SET LOCAL search_path = pg_catalog, public, pg_temp")
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SELECT set_config('app.current_tenant', $1, TRUE)")
+            .bind(tenant_id)
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SET LOCAL ROLE opc_sip_effect_executor")
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SELECT set_config('app.sip_effect_writer_identity', $1, TRUE)")
+            .bind(SIP_EFFECT_WRITER_IDENTITY)
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        sqlx::query("SELECT ivekit_assert_sip_effect_writer($1, $2, $3, $4)")
+            .bind(SIP_EFFECT_WRITER_IDENTITY)
+            .bind(SIP_EFFECT_SCHEMA_ID)
+            .bind(i32::from(SIP_EFFECT_SCHEMA_VERSION))
+            .bind(SIP_EFFECT_SCHEMA_HASH)
+            .execute(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
+        Ok((admission, transaction))
+    }
+}
+
+struct DecodedEffect {
+    record: SipEffectRecord,
+    payload_retained: bool,
+}
+
+fn decode_effect(row: &PgRow) -> Result<DecodedEffect, SipEffectStoreError> {
+    let schema_id: String = schema_field(row, "schema_id")?;
+    let schema_version: i32 = schema_field(row, "schema_version")?;
+    let schema_hash: String = schema_field(row, "schema_hash")?;
+    let writer_identity: String = schema_field(row, "writer_identity")?;
+    if schema_id != SIP_EFFECT_SCHEMA_ID
+        || schema_version != i32::from(SIP_EFFECT_SCHEMA_VERSION)
+        || schema_hash != SIP_EFFECT_SCHEMA_HASH
+        || writer_identity != SIP_EFFECT_WRITER_IDENTITY
+    {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+
+    let identity = crate::call::domain::sip_effect::SipEffectIdentity {
+        tenant_id: schema_field(row, "tenant_id")?,
+        protocol_effect_id: schema_field(row, "protocol_effect_id")?,
+        protocol_session_id: schema_field(row, "protocol_session_id")?,
+        protocol_session_generation: schema_field(row, "protocol_session_generation")?,
+        decision_id: schema_field(row, "decision_id")?,
+        idempotency_key: schema_field(row, "idempotency_key")?,
+        request_hash: schema_field(row, "request_hash")?,
+        command_id: schema_field(row, "command_id")?,
+        adapter_identity_hash: schema_field(row, "adapter_identity_hash")?,
+        wire_bytes_hash: schema_field(row, "wire_bytes_hash")?,
+        wire_length_bytes: positive_u32(schema_field::<i32>(row, "wire_length_bytes")?)?,
+        route_binding_hash: schema_field(row, "route_binding_hash")?,
+        wire_attempt_facts_hash: schema_field(row, "wire_attempt_facts_hash")?,
+        wire_freeze_sha256: schema_field(row, "wire_freeze_sha256")?,
+        owner_epoch: canonical_u64(&schema_field::<String>(row, "owner_epoch")?, true)?,
+        command_sequence: canonical_u64(&schema_field::<String>(row, "command_sequence")?, true)?,
+    };
+    let effect_identity_hash: String = schema_field(row, "effect_identity_hash")?;
+    if protocol_effect_identity_hash(&identity)? != effect_identity_hash {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+
+    let repair_owner_id: Option<String> = schema_field(row, "repair_owner_id")?;
+    let repair_owner_epoch: Option<String> = schema_field(row, "repair_owner_epoch")?;
+    let repair_claim_token: Option<String> = schema_field(row, "repair_claim_token")?;
+    let repair_claim_revision: Option<String> = schema_field(row, "repair_claim_revision")?;
+    let repair_claim = match (
+        repair_owner_id,
+        repair_owner_epoch,
+        repair_claim_token,
+        repair_claim_revision,
+    ) {
+        (None, None, None, None) => None,
+        (Some(owner_id), Some(owner_epoch), Some(claim_token), Some(claim_revision)) => {
+            Some(SipEffectRepairFence {
+                repair_owner_id: owner_id,
+                repair_owner_epoch: canonical_u64(&owner_epoch, true)?,
+                repair_claim_token: claim_token,
+                repair_claim_revision: canonical_u64(&claim_revision, true)?,
+            })
+        }
+        _ => return Err(SipEffectStoreError::SchemaIncompatible),
+    };
+    let canonical_wire_bytes: Vec<u8> = schema_field(row, "canonical_wire_bytes")?;
+    let adapter_identity: Value = schema_field(row, "adapter_identity")?;
+    let route_binding: Value = schema_field(row, "route_binding")?;
+    let wire_attempt_facts: Value = schema_field(row, "wire_attempt_facts")?;
+    let prepared_at: DateTime<Utc> = schema_field(row, "prepared_at")?;
+    let audit_until: DateTime<Utc> = schema_field(row, "audit_until")?;
+    let state = database_state(&schema_field::<String>(row, "state")?)?;
+    let payload_retained: bool = schema_field(row, "payload_retained")?;
+    let repair_delay = schema_field::<Option<i32>>(row, "last_receipt_repair_delay_ms")?
+        .map(positive_or_zero_u32)
+        .transpose()?;
+    let repair_attempts = u8::try_from(schema_field::<i16>(row, "repair_attempts")?)
+        .map_err(|_| SipEffectStoreError::SchemaIncompatible)?;
+    let record = SipEffectRecord {
+        identity,
+        canonical_wire_bytes,
+        adapter_identity,
+        route_binding,
+        wire_attempt_facts,
+        state,
+        revision: canonical_u64(&schema_field::<String>(row, "revision")?, true)?,
+        unknown_count: positive_or_zero_u32(schema_field::<i32>(row, "unknown_count")?)?,
+        last_receipt_id: schema_field(row, "last_receipt_id")?,
+        last_receipt_hash: schema_field(row, "last_receipt_hash")?,
+        failure_code: schema_field(row, "failure_code")?,
+        repair_delay_ms: repair_delay,
+        repair_epoch_high_watermark: canonical_u64(
+            &schema_field::<String>(row, "repair_epoch_high_watermark")?,
+            false,
+        )?,
+        repair_claim,
+        repair_attempts,
+        prepared_at,
+        audit_until,
+    };
+    if payload_retained {
+        PreparedSipEffect {
+            identity: record.identity.clone(),
+            canonical_wire_bytes: record.canonical_wire_bytes.clone(),
+            adapter_identity: record.adapter_identity.clone(),
+            route_binding: record.route_binding.clone(),
+            wire_attempt_facts: record.wire_attempt_facts.clone(),
+            prepared_at: record.prepared_at,
+            audit_until: record.audit_until,
+        }
+        .validate()
+        .map_err(|_| SipEffectStoreError::SchemaIncompatible)?;
+    } else if !record.canonical_wire_bytes.is_empty() || !record.state.is_terminal() {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    Ok(DecodedEffect {
+        record,
+        payload_retained,
+    })
+}
+
+fn schema_field<'r, T>(row: &'r PgRow, field: &str) -> Result<T, SipEffectStoreError>
+where
+    T: sqlx::Decode<'r, Postgres> + sqlx::Type<Postgres>,
+{
+    row.try_get(field)
+        .map_err(|_| SipEffectStoreError::SchemaIncompatible)
+}
+
+fn canonical_u64(value: &str, positive: bool) -> Result<u64, SipEffectStoreError> {
+    let parsed = value
+        .parse::<u64>()
+        .map_err(|_| SipEffectStoreError::SchemaIncompatible)?;
+    if parsed.to_string() != value || (positive && parsed == 0) {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    Ok(parsed)
+}
+
+fn positive_u32(value: i32) -> Result<u32, SipEffectStoreError> {
+    let parsed = u32::try_from(value).map_err(|_| SipEffectStoreError::SchemaIncompatible)?;
+    if parsed == 0 {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    Ok(parsed)
+}
+
+fn positive_or_zero_u32(value: i32) -> Result<u32, SipEffectStoreError> {
+    u32::try_from(value).map_err(|_| SipEffectStoreError::SchemaIncompatible)
+}
+
+fn database_state(value: &str) -> Result<SipEffectState, SipEffectStoreError> {
+    match value {
+        "prepared" => Ok(SipEffectState::Prepared),
+        "durable_decision" => Ok(SipEffectState::DurableDecision),
+        "send_attempted" => Ok(SipEffectState::SendAttempted),
+        "transport_accepted" => Ok(SipEffectState::TransportAccepted),
+        "protocol_observed" => Ok(SipEffectState::ProtocolObserved),
+        "failed" => Ok(SipEffectState::Failed),
+        "unknown" => Ok(SipEffectState::Unknown),
+        _ => Err(SipEffectStoreError::SchemaIncompatible),
+    }
+}
+
+fn map_sqlx_error(error: sqlx::Error) -> SipEffectStoreError {
+    match error {
+        sqlx::Error::PoolTimedOut => SipEffectStoreError::PoolTimeout,
+        sqlx::Error::PoolClosed => SipEffectStoreError::StoreUnavailable,
+        sqlx::Error::Database(database) => match database.code().as_deref() {
+            Some("42501" | "55000" | "42P01" | "42703" | "42883") => {
+                SipEffectStoreError::SchemaIncompatible
+            }
+            Some("57014") => SipEffectStoreError::PoolTimeout,
+            _ => SipEffectStoreError::StoreUnavailable,
+        },
+        _ => SipEffectStoreError::StoreUnavailable,
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectAdmissionSnapshot {
+    pub active: usize,
+    pub queued: usize,
+}
+
+#[derive(Debug)]
+struct SipEffectAdmission {
+    active: Arc<Semaphore>,
+    total: Arc<Semaphore>,
+    active_count: Arc<AtomicUsize>,
+    queued_count: Arc<AtomicUsize>,
+    wait_timeout: Duration,
+}
+
+impl SipEffectAdmission {
+    fn new(
+        max_in_flight: usize,
+        max_queue_depth: usize,
+        wait_timeout: Duration,
+    ) -> Result<Self, SipEffectStoreError> {
+        let total = validate_admission_limits(max_in_flight, max_queue_depth, wait_timeout)?;
+        Ok(Self {
+            active: Arc::new(Semaphore::new(max_in_flight)),
+            total: Arc::new(Semaphore::new(total)),
+            active_count: Arc::new(AtomicUsize::new(0)),
+            queued_count: Arc::new(AtomicUsize::new(0)),
+            wait_timeout,
+        })
+    }
+
+    async fn enter(&self) -> Result<SipEffectAdmissionLease, SipEffectStoreError> {
+        let total_permit = Arc::clone(&self.total)
+            .try_acquire_owned()
+            .map_err(|_| SipEffectStoreError::PoolExhausted)?;
+        if let Ok(active_permit) = Arc::clone(&self.active).try_acquire_owned() {
+            self.active_count.fetch_add(1, Ordering::AcqRel);
+            return Ok(SipEffectAdmissionLease {
+                _active_permit: active_permit,
+                _total_permit: total_permit,
+                active_count: Arc::clone(&self.active_count),
+            });
+        }
+
+        let queued = CounterGuard::new(Arc::clone(&self.queued_count));
+        let active_permit =
+            tokio::time::timeout(self.wait_timeout, Arc::clone(&self.active).acquire_owned())
+                .await
+                .map_err(|_| SipEffectStoreError::PoolTimeout)?
+                .map_err(|_| SipEffectStoreError::PoolExhausted)?;
+        drop(queued);
+        self.active_count.fetch_add(1, Ordering::AcqRel);
+        Ok(SipEffectAdmissionLease {
+            _active_permit: active_permit,
+            _total_permit: total_permit,
+            active_count: Arc::clone(&self.active_count),
+        })
+    }
+
+    fn snapshot(&self) -> SipEffectAdmissionSnapshot {
+        SipEffectAdmissionSnapshot {
+            active: self.active_count.load(Ordering::Acquire),
+            queued: self.queued_count.load(Ordering::Acquire),
+        }
+    }
+}
+
+fn validate_admission_limits(
+    max_in_flight: usize,
+    max_queue_depth: usize,
+    wait_timeout: Duration,
+) -> Result<usize, SipEffectStoreError> {
+    if max_in_flight == 0
+        || max_in_flight > MAX_STORE_IN_FLIGHT
+        || max_queue_depth == 0
+        || max_queue_depth > MAX_STORE_QUEUE_DEPTH
+        || wait_timeout.is_zero()
+        || wait_timeout > MAX_STORE_WAIT
+    {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    max_in_flight
+        .checked_add(max_queue_depth)
+        .ok_or(SipEffectStoreError::InvalidConfiguration)
+}
+
+#[derive(Debug)]
+struct CounterGuard {
+    counter: Arc<AtomicUsize>,
+}
+
+impl CounterGuard {
+    fn new(counter: Arc<AtomicUsize>) -> Self {
+        counter.fetch_add(1, Ordering::AcqRel);
+        Self { counter }
+    }
+}
+
+impl Drop for CounterGuard {
+    fn drop(&mut self) {
+        self.counter.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+#[derive(Debug)]
+struct SipEffectAdmissionLease {
+    _active_permit: OwnedSemaphorePermit,
+    _total_permit: OwnedSemaphorePermit,
+    active_count: Arc<AtomicUsize>,
+}
+
+impl Drop for SipEffectAdmissionLease {
+    fn drop(&mut self) {
+        self.active_count.fetch_sub(1, Ordering::AcqRel);
+    }
+}
