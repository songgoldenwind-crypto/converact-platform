+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::call::domain::sip_effect::{
+        SipEffectIdentity, canonical_json_sha256, sha256_lower_hex, sip_wire_freeze_sha256,
+    };
+    use chrono::{Duration as ChronoDuration, TimeZone};
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    #[test]
+    fn admission_limits_reject_zero_and_unbounded_configuration() {
+        assert_eq!(
+            SipEffectAdmission::new(0, 1, Duration::from_millis(1)).unwrap_err(),
+            SipEffectStoreError::InvalidConfiguration,
+        );
+        assert_eq!(
+            SipEffectAdmission::new(1, 1_025, Duration::from_millis(1)).unwrap_err(),
+            SipEffectStoreError::InvalidConfiguration,
+        );
+        assert_eq!(
+            SipEffectAdmission::new(1, 1, Duration::from_millis(251)).unwrap_err(),
+            SipEffectStoreError::InvalidConfiguration,
+        );
+    }
+
+    #[tokio::test]
+    async fn admission_bounds_active_and_queued_database_work() {
+        let admission = Arc::new(SipEffectAdmission::new(1, 1, Duration::from_millis(50)).unwrap());
+        let active = admission.enter().await.unwrap();
+        assert_eq!(
+            admission.snapshot(),
+            SipEffectAdmissionSnapshot {
+                active: 1,
+                queued: 0,
+            }
+        );
+
+        let mut queued = Box::pin(admission.enter());
+        assert!(
+            tokio::time::timeout(Duration::from_millis(5), &mut queued)
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            admission.snapshot(),
+            SipEffectAdmissionSnapshot {
+                active: 1,
+                queued: 1,
+            }
+        );
+        assert_eq!(
+            admission.enter().await.unwrap_err(),
+            SipEffectStoreError::PoolExhausted,
+        );
+
+        drop(active);
+        let queued = queued.await.unwrap();
+        assert_eq!(
+            admission.snapshot(),
+            SipEffectAdmissionSnapshot {
+                active: 1,
+                queued: 0,
+            }
+        );
+        drop(queued);
+        assert_eq!(
+            admission.snapshot(),
+            SipEffectAdmissionSnapshot {
+                active: 0,
+                queued: 0,
+            }
+        );
+    }
+
+    #[tokio::test]
+    async fn queued_database_work_times_out_without_growing_backlog() {
+        let admission = SipEffectAdmission::new(1, 1, Duration::from_millis(5)).unwrap();
+        let active = admission.enter().await.unwrap();
+        assert_eq!(
+            admission.enter().await.unwrap_err(),
+            SipEffectStoreError::PoolTimeout,
+        );
+        assert_eq!(
+            admission.snapshot(),
+            SipEffectAdmissionSnapshot {
+                active: 1,
+                queued: 0,
+            }
+        );
+        drop(active);
+    }
+
+    #[tokio::test]
+    #[ignore = "requires an isolated migrated PostgreSQL database"]
+    async fn postgres_prepare_replay_and_query_survive_pool_recreation() {
+        let database_url = std::env::var("CONVERACT_SIP_EFFECT_TEST_DATABASE_URL")
+            .expect("CONVERACT_SIP_EFFECT_TEST_DATABASE_URL must be set");
+        let run_id = std::env::var("CONVERACT_SIP_EFFECT_TEST_RUN_ID")
+            .expect("CONVERACT_SIP_EFFECT_TEST_RUN_ID must be set");
+        let effect = postgres_effect_fixture(&run_id);
+        let options = PostgresSipEffectStoreOptions {
+            max_in_flight: 2,
+            max_queue_depth: 2,
+            wait_timeout: Duration::from_millis(250),
+        };
+
+        let first_store = PostgresSipEffectStore::connect(&database_url, options)
+            .await
+            .unwrap();
+        let first = first_store.prepare(effect.clone()).await.unwrap();
+        assert!(!first.replayed);
+        let replay = first_store.prepare(effect.clone()).await.unwrap();
+        assert!(replay.replayed);
+        assert_eq!(replay.record, first.record);
+        first_store.pool.close().await;
+
+        let recovered_store = PostgresSipEffectStore::connect(&database_url, options)
+            .await
+            .unwrap();
+        let recovered = recovered_store
+            .query(&effect.identity)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(recovered, first.record);
+        let replay_after_reconnect = recovered_store.prepare(effect).await.unwrap();
+        assert!(replay_after_reconnect.replayed);
+        assert_eq!(replay_after_reconnect.record, recovered);
+        recovered_store.pool.close().await;
+    }
