+use crate::call::domain::sip_effect::{
+    PreparedSipEffect, SIP_EFFECT_SCHEMA_HASH, SIP_EFFECT_SCHEMA_ID, SIP_EFFECT_SCHEMA_VERSION,
+    SIP_EFFECT_WRITER_IDENTITY, SipEffectError, SipEffectPrepareOutcome, SipEffectRecord,
+    SipEffectRepairFence, SipEffectState, protocol_effect_identity_hash,
+};
+use chrono::{DateTime, Utc};
+use serde_json::Value;
+use sqlx::postgres::{PgPoolOptions, PgRow};
+use sqlx::{PgPool, Postgres, Row, Transaction};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+use tokio::sync::{OwnedSemaphorePermit, Semaphore};
+
+const MAX_STORE_IN_FLIGHT: usize = 256;
+const MAX_STORE_QUEUE_DEPTH: usize = 1_024;
+const MAX_STORE_WAIT: Duration = Duration::from_millis(250);
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum SipEffectStoreError {
+    #[error("SIP effect store configuration is invalid")]
+    InvalidConfiguration,
+    #[error("SIP effect store queue is exhausted")]
+    PoolExhausted,
+    #[error("SIP effect store admission timed out")]
+    PoolTimeout,
+    #[error("SIP effect store is unavailable")]
+    StoreUnavailable,
+    #[error("SIP effect store schema or writer election is incompatible")]
+    SchemaIncompatible,
+    #[error(transparent)]
+    Domain(#[from] SipEffectError),
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct PostgresSipEffectStoreOptions {
+    pub max_in_flight: usize,
+    pub max_queue_depth: usize,
+    pub wait_timeout: Duration,
+}
+
+impl Default for PostgresSipEffectStoreOptions {
+    fn default() -> Self {
+        Self {
+            max_in_flight: 32,
+            max_queue_depth: 128,
+            wait_timeout: MAX_STORE_WAIT,
+        }
+    }
+}
+
+impl PostgresSipEffectStoreOptions {
+    fn validate(self) -> Result<Self, SipEffectStoreError> {
+        validate_admission_limits(self.max_in_flight, self.max_queue_depth, self.wait_timeout)?;
+        Ok(self)
+    }
+}
