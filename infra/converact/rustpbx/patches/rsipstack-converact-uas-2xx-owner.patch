+/// Exact ACK correlation and immutable wire ownership for a successful
+/// server-INVITE response. The application authorizes the initial 2xx; this
+/// bounded owner only retransmits those same bytes and resolves that same
+/// durable permit from Endpoint-proven peer ingress.
+struct ServerInvite2xxOwner {
+    ack_dialog_id: DialogId,
+    ack_cseq: u32,
+    response: Arc<FrozenSipMessage>,
+    permit: Option<EgressEffectPermit>,
+}
+
+impl ServerInvite2xxOwner {
+    fn try_new(
+        key: &TransactionKey,
+        original: &Request,
+        response: Arc<FrozenSipMessage>,
+        permit: Option<EgressEffectPermit>,
+    ) -> Result<Self> {
+        let SipMessage::Response(response_message) = &response.message else {
+            return Err(Error::TransactionError(
+                "UAS 2xx owner requires a response".to_string(),
+                key.clone(),
+            ));
+        };
+        if !(200..=299).contains(&response_message.status_code.code()) {
+            return Err(Error::TransactionError(
+                "UAS 2xx owner requires a successful INVITE response".to_string(),
+                key.clone(),
+            ));
+        }
+        let original_cseq = original.cseq_header()?;
+        let response_cseq = response_message.cseq_header()?;
+        if original_cseq.method()? != Method::Invite
+            || response_cseq.method()? != Method::Invite
+            || original_cseq.seq()? != response_cseq.seq()?
+        {
+            return Err(Error::TransactionError(
+                "UAS 2xx response CSeq does not bind the original INVITE".to_string(),
+                key.clone(),
+            ));
+        }
+        Ok(Self {
+            ack_dialog_id: DialogId::try_from((response_message, TransactionRole::Server))?,
+            ack_cseq: original_cseq.seq()?,
+            response,
+            permit,
+        })
+    }
+
+    fn matches_ack(&self, request: &Request) -> bool {
+        if request.method != Method::Ack {
+            return false;
+        }
+        let Ok(cseq) = request.cseq_header() else {
+            return false;
+        };
+        if cseq.method().ok() != Some(Method::Ack) || cseq.seq().ok() != Some(self.ack_cseq) {
+            return false;
+        }
+        DialogId::try_from((request, TransactionRole::Server))
+            .map(|dialog_id| dialog_id == self.ack_dialog_id)
+            .unwrap_or(false)
+    }
+}
