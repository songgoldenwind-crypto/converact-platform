+    #[test]
+    fn local_backend_rejects_a_full_queue_without_allocating_more_backlog() {
+        let (sender, _receiver) = mpsc::channel(1);
+        let perf = PerfCounters::new_arc();
+        let backend = LocalBackend {
+            sender,
+            root: String::new(),
+            subdirs: SipFlowSubdirs::default(),
+            cancel_token: CancellationToken::new(),
+            perf: perf.clone(),
+        };
+
+        backend.record("call-a", item(1)).expect("first item fits");
+        assert!(backend.record("call-b", item(2)).is_err());
+        assert_eq!(perf.items_dropped.load(Ordering::Relaxed), 1);
+    }
