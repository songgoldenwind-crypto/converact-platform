+#[tokio::test]
+async fn cancelled_matched_cancel_send_is_unknown_and_cannot_prepare_again() {
+    let gate = Arc::new(RecordingPeerDerivedGate {
+        primary_prepare_calls: AtomicUsize::new(0),
+        peer_derived_calls: AtomicUsize::new(0),
+        trigger_and_response: std::sync::Mutex::new(Vec::new()),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+    });
+    let (_incoming_tx, incoming_rx) = crate::bounded::test_channel();
+    let (outgoing_tx, _outgoing_rx) = tokio::sync::mpsc::channel(1);
+    let channel_addr = SipAddr::from(
+        "127.0.0.1:5060"
+            .parse::<std::net::SocketAddr>()
+            .expect("channel address"),
+    );
+    let connection = ChannelConnection::create_connection_bounded(
+        incoming_rx,
+        outgoing_tx,
+        channel_addr.clone(),
+        None,
+    )
+    .await
+    .expect("bounded channel connection");
+    let request = invite_request("UDP", &channel_addr, "z9hG4bK-cancel-send-cancelled");
+    connection
+        .send(request.clone().into())
+        .await
+        .expect("fill bounded outgoing transport");
+    let endpoint = EndpointBuilder::new()
+        .with_user_agent("rsipstack-cancel-effect-cancellation-test")
+        .with_egress_effect_gate(gate.clone())
+        .build();
+    let key = crate::transaction::TransactionKey::from_request(
+        &request,
+        crate::transaction::key::TransactionRole::Server,
+    )
+    .expect("transaction key");
+    let sip_connection: SipConnection = connection.into();
+    let mut transaction = crate::transaction::transaction::Transaction::new_server(
+        key,
+        request,
+        endpoint.inner.clone(),
+        Some(sip_connection.clone()),
+    );
+    let cancel = matching_cancel(&transaction);
+    transaction
+        .tu_sender
+        .send(peer_received(cancel.clone().into(), sip_connection.clone()))
+        .expect("matched CANCEL ingress");
+
+    assert!(
+        timeout(Duration::from_millis(20), transaction.receive())
+            .await
+            .is_err(),
+        "the bounded 200-to-CANCEL send must remain pending until cancelled"
+    );
+    assert_eq!(gate.peer_derived_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.outcomes
+            .lock()
+            .expect("peer-derived outcome lock")
+            .as_slice(),
+        [EgressEffectOutcome::TransportUnknown]
+    );
+    assert!(gate
+        .protocol_observations
+        .lock()
+        .expect("peer-derived protocol lock")
+        .is_empty());
+    assert!(transaction.automatic_cancel_reconciliation_required());
+
+    transaction
+        .tu_sender
+        .send(peer_received(cancel.into(), sip_connection))
+        .expect("duplicate matched CANCEL ingress");
+    assert!(timeout(Duration::from_millis(20), transaction.receive())
+        .await
+        .is_err());
+    assert_eq!(
+        gate.peer_derived_calls.load(Ordering::SeqCst),
+        1,
+        "an ambiguous transport attempt must not prepare a second effect"
+    );
+    assert_eq!(
+        gate.outcomes
+            .lock()
+            .expect("peer-derived outcome lock")
+            .as_slice(),
+        [EgressEffectOutcome::TransportUnknown]
+    );
+}
