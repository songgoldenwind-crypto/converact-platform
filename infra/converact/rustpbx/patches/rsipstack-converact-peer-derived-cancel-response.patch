+struct RecordingPeerDerivedGate {
+    primary_prepare_calls: AtomicUsize,
+    peer_derived_calls: AtomicUsize,
+    trigger_and_response: std::sync::Mutex<Vec<(crate::sip::SipMessage, crate::sip::SipMessage)>>,
+    canonical_wire_images: std::sync::Mutex<Vec<Vec<u8>>>,
+    outcomes: std::sync::Mutex<Vec<EgressEffectOutcome>>,
+    protocol_observations: std::sync::Mutex<Vec<EgressEffectProtocolObservation>>,
+}
+
+#[async_trait::async_trait]
+impl EgressEffectGate for RecordingPeerDerivedGate {
+    async fn prepare(
+        &self,
+        _transaction_key: &crate::transaction::TransactionKey,
+        _message: &crate::sip::SipMessage,
+        _transport_binding: &EgressTransportBinding,
+        _canonical_wire_bytes: &[u8],
+    ) -> crate::Result<EgressEffectPermit> {
+        self.primary_prepare_calls.fetch_add(1, Ordering::SeqCst);
+        Err(crate::Error::EndpointError(
+            "ordinary application intent cannot authorize 200-to-CANCEL".to_string(),
+        ))
+    }
+
+    async fn prepare_peer_derived(
+        &self,
+        kind: EgressEffectPeerDerivedKind,
+        _transaction_key: &crate::transaction::TransactionKey,
+        trigger_message: &crate::sip::SipMessage,
+        message: &crate::sip::SipMessage,
+        _transport_binding: &EgressTransportBinding,
+        canonical_wire_bytes: &[u8],
+        _ingress_proof: PeerIngressProof,
+    ) -> crate::Result<EgressEffectPermit> {
+        assert_eq!(kind, EgressEffectPeerDerivedKind::ServerInviteCancelOk);
+        self.peer_derived_calls.fetch_add(1, Ordering::SeqCst);
+        self.trigger_and_response
+            .lock()
+            .expect("peer-derived pair lock")
+            .push((trigger_message.clone(), message.clone()));
+        self.canonical_wire_images
+            .lock()
+            .expect("peer-derived wire lock")
+            .push(canonical_wire_bytes.to_vec());
+        EgressEffectPermit::try_new("effect-peer-derived-cancel-ok")
+    }
+
+    fn observe_transport(&self, _permit: EgressEffectPermit, outcome: EgressEffectOutcome) {
+        self.outcomes
+            .lock()
+            .expect("peer-derived outcome lock")
+            .push(outcome);
+    }
+
+    fn observe_protocol(
+        &self,
+        _permit: EgressEffectPermit,
+        observation: EgressEffectProtocolObservation,
+    ) {
+        self.protocol_observations
+            .lock()
+            .expect("peer-derived protocol lock")
+            .push(observation);
+    }
+}
