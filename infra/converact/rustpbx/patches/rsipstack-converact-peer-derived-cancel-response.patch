+    transaction.send_trying().await.expect("send Trying");
+    let _trying = recv_udp_bytes(&peer).await;
+    let cancel = matching_cancel(&transaction);
+    transaction
+        .tu_sender
+        .send(peer_received(
+            cancel.into(),
+            transaction.connection.clone().expect("server connection"),
+        ))
+        .expect("matched CANCEL ingress");
+
+    assert!(timeout(Duration::from_millis(20), transaction.receive())
+        .await
+        .is_err());
+    assert!(timeout(Duration::from_millis(20), recv_udp_bytes(&peer))
+        .await
+        .is_err());
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 0);
+    assert!(transaction.automatic_cancel_reconciliation_required());
+    assert!(transaction.take_automatic_cancel_error().is_some());
+}
