+#[tokio::test]
+async fn matched_cancel_uses_one_peer_proven_effect_and_replays_frozen_200() {
+    let gate = Arc::new(RecordingPeerDerivedGate {
+        primary_prepare_calls: AtomicUsize::new(0),
+        peer_derived_calls: AtomicUsize::new(0),
+        trigger_and_response: std::sync::Mutex::new(Vec::new()),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+    });
+    let (mut transaction, peer, _endpoint) =
+        udp_server_transaction_with_effect_gate(gate.clone()).await;
+    transaction.send_trying().await.expect("send Trying");
+    let _trying = recv_udp_bytes(&peer).await;
+
+    let cancel = matching_cancel(&transaction);
+    transaction
+        .tu_sender
+        .send(peer_received(
+            cancel.clone().into(),
+            transaction.connection.clone().expect("server connection"),
+        ))
+        .expect("matched CANCEL ingress");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(crate::sip::SipMessage::Request(request)) if request.method == crate::sip::Method::Cancel
+    ));
+    let first_response = recv_udp_bytes(&peer).await;
+    let parsed = crate::sip::SipMessage::try_from(first_response.as_slice())
+        .expect("valid 200-to-CANCEL response");
+    assert!(matches!(
+        parsed,
+        crate::sip::SipMessage::Response(response)
+            if response.status_code == crate::sip::StatusCode::OK
+                && response.cseq_header().expect("response CSeq").value() == "1 CANCEL"
+                && response
+                    .to_header()
+                    .expect("response To")
+                    .tag()
+                    .expect("valid response To")
+                    .is_some()
+    ));
+    assert_eq!(gate.primary_prepare_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(gate.peer_derived_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.canonical_wire_images
+            .lock()
+            .expect("peer-derived wire lock")
+            .as_slice(),
+        [first_response.clone()]
+    );
+    assert_eq!(
+        gate.outcomes
+            .lock()
+            .expect("peer-derived outcome lock")
+            .as_slice(),
+        [EgressEffectOutcome::TransportAccepted]
+    );
+    assert_eq!(
+        gate.protocol_observations
+            .lock()
+            .expect("peer-derived protocol lock")
+            .as_slice(),
+        [EgressEffectProtocolObservation::TransportTerminal]
+    );
+
+    transaction
+        .tu_sender
+        .send(peer_received(
+            cancel.into(),
+            transaction.connection.clone().expect("server connection"),
+        ))
+        .expect("duplicate matched CANCEL ingress");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(crate::sip::SipMessage::Request(request)) if request.method == crate::sip::Method::Cancel
+    ));
+    assert_eq!(recv_udp_bytes(&peer).await, first_response);
+    assert_eq!(
+        gate.peer_derived_calls.load(Ordering::SeqCst),
+        1,
+        "duplicate CANCEL must reuse the frozen 200 response"
+    );
+}
