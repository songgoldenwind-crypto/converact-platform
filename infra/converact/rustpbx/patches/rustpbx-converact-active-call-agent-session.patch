+++ b/src/proxy/agent_session.rs
@@ -0,0 +1,33 @@
+use crate::call::domain::AgentSessionId;
+
+const CONVERACT_AGENT_SESSION_HEADER: &str = "X-Converact-Agent-Session";
+
+/// Builds the private header for an internal Channel Agent leg only.
+pub(crate) fn invite_headers(
+    session_id: Option<&AgentSessionId>,
+) -> Option<Vec<rsipstack::sip::Header>> {
+    session_id.map(|session_id| {
+        vec![rsipstack::sip::Header::Other(
+            CONVERACT_AGENT_SESSION_HEADER.to_string(),
+            session_id.as_str().to_string(),
+        )]
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn invite_header_is_exact_and_absent_without_an_agent_binding() {
+        let session_id = AgentSessionId::try_from("ac.session-001".to_string()).unwrap();
+        let headers = invite_headers(Some(&session_id)).unwrap();
+
+        assert!(matches!(
+            headers.as_slice(),
+            [rsipstack::sip::Header::Other(name, value)]
+                if name == "X-Converact-Agent-Session" && value == "ac.session-001"
+        ));
+        assert!(invite_headers(None).is_none());
+    }
+}
