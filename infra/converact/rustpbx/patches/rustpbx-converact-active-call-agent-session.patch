+const MAX_AGENT_SESSION_ID_BYTES: usize = 255;
+
+/// Validated binding between one internal SIP leg and one Channel Agent session.
+///
+/// The value is deliberately opaque to Call Core. It can only be constructed from the bounded
+/// identifier grammar accepted by the Converact RWI adapter, preventing SIP header injection at
+/// every `CallCommand` construction boundary.
+#[derive(Clone, Eq, PartialEq, Serialize)]
+#[serde(transparent)]
+pub struct AgentSessionId(Box<str>);
+
+impl AgentSessionId {
+    /// Returns the validated identifier for the internal Agent-leg SIP header.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Debug for AgentSessionId {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("AgentSessionId([REDACTED])")
+    }
+}
+
+impl TryFrom<String> for AgentSessionId {
+    type Error = &'static str;
+
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        let bytes = value.as_bytes();
+        let Some((&first, remainder)) = bytes.split_first() else {
+            return Err("agent_session_id_invalid");
+        };
+        if bytes.len() > MAX_AGENT_SESSION_ID_BYTES
+            || !first.is_ascii_alphanumeric()
+            || !remainder.iter().all(|byte| {
+                byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'-')
+            })
+        {
+            return Err("agent_session_id_invalid");
+        }
+        Ok(Self(value.into_boxed_str()))
+    }
+}
+
+impl<'de> Deserialize<'de> for AgentSessionId {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        Self::try_from(String::deserialize(deserializer)?).map_err(serde::de::Error::custom)
+    }
+}
