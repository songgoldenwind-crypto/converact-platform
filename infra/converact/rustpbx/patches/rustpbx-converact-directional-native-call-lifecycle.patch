+    #[test]
+    fn inbound_uas_and_outbound_uac_keep_ack_ownership_directional() {
+        let mut inbound = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let inbound_leg = leg("inbound-directional");
+        inbound
+            .add_leg(
+                &inbound.fence(),
+                inbound_leg.clone(),
+                ProviderCallId::parse("provider-inbound").unwrap(),
+                NativeLegDirection::Inbound,
+            )
+            .unwrap();
+        assert_eq!(
+            inbound
+                .register_fork_branch(
+                    &inbound.fence(),
+                    &inbound_leg,
+                    "inbound-fork",
+                    "inbound-fork-event",
+                    HASH_A,
+                )
+                .unwrap_err(),
+            NativeCallError::TransitionInvalid,
+        );
+
+        let before = inbound.snapshot();
+        assert_eq!(
+            inbound
+                .apply_leg_event(
+                    &inbound.fence(),
+                    &inbound_leg,
+                    "wrong-start",
+                    HASH_A,
+                    NativeLegEvent::StartInvite,
+                )
+                .unwrap_err(),
+            NativeCallError::TransitionInvalid,
+        );
+        assert_eq!(inbound.snapshot(), before);
+
+        for (event_id, event) in [
+            ("inbound-invite", NativeLegEvent::InboundInviteObserved),
+            ("inbound-answer", NativeLegEvent::Final2xx),
+        ] {
+            inbound
+                .apply_leg_event(&inbound.fence(), &inbound_leg, event_id, HASH_A, event)
+                .unwrap();
+        }
+        assert_eq!(
+            inbound.leg(&inbound_leg).unwrap().state,
+            NativeLegState::AwaitingAck,
+        );
+        let late_cancel = inbound
+            .apply_leg_event(
+                &inbound.fence(),
+                &inbound_leg,
+                "late-cancel",
+                HASH_A,
+                NativeLegEvent::RemoteCancelObserved,
+            )
+            .unwrap();
+        assert_eq!(late_cancel.state, NativeLegState::AwaitingAck);
+        assert_eq!(
+            late_cancel.required_effect,
+            NativeRequiredEffect::RespondCancel2xx,
+        );
+        let ack = inbound
+            .apply_leg_event(
+                &inbound.fence(),
+                &inbound_leg,
+                "ack-observed",
+                HASH_A,
+                NativeLegEvent::Invite2xxAckObserved,
+            )
+            .unwrap();
+        assert_eq!(ack.state, NativeLegState::Confirmed);
+        assert_eq!(ack.required_effect, NativeRequiredEffect::None);
+        let remote_bye = inbound
+            .apply_leg_event(
+                &inbound.fence(),
+                &inbound_leg,
+                "remote-bye",
+                HASH_A,
+                NativeLegEvent::RemoteByeObserved,
+            )
+            .unwrap();
+        assert_eq!(remote_bye.state, NativeLegState::Terminating);
+        assert_eq!(
+            remote_bye.required_effect,
+            NativeRequiredEffect::RespondBye2xx,
+        );
+
+        let mut outbound = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let outbound_leg = leg("outbound-directional");
+        outbound
+            .add_leg(
+                &outbound.fence(),
+                outbound_leg.clone(),
+                ProviderCallId::parse("provider-outbound").unwrap(),
+                NativeLegDirection::Outbound,
+            )
+            .unwrap();
+        outbound
+            .apply_leg_event(
+                &outbound.fence(),
+                &outbound_leg,
+                "outbound-start",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap();
+        let answer = outbound
+            .apply_leg_event(
+                &outbound.fence(),
+                &outbound_leg,
+                "outbound-answer",
+                HASH_A,
+                NativeLegEvent::Final2xx,
+            )
+            .unwrap();
+        assert_eq!(answer.state, NativeLegState::Confirmed);
+        assert_eq!(answer.required_effect, NativeRequiredEffect::Ack2xx);
+        assert_eq!(
+            outbound
+                .apply_leg_event(
+                    &outbound.fence(),
+                    &outbound_leg,
+                    "wrong-ack",
+                    HASH_A,
+                    NativeLegEvent::Invite2xxAckObserved,
+                )
+                .unwrap_err(),
+            NativeCallError::TransitionInvalid,
+        );
+    }
