+    #[test]
+    fn directional_final_cancel_and_deferred_bye_races_are_explicit() {
+        let mut inbound = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let inbound_leg = leg("inbound-cancel");
+        inbound
+            .add_leg(
+                &inbound.fence(),
+                inbound_leg.clone(),
+                ProviderCallId::parse("provider-inbound-cancel").unwrap(),
+                NativeLegDirection::Inbound,
+            )
+            .unwrap();
+        inbound
+            .apply_leg_event(
+                &inbound.fence(),
+                &inbound_leg,
+                "inbound-invite",
+                HASH_A,
+                NativeLegEvent::InboundInviteObserved,
+            )
+            .unwrap();
+        let cancel = inbound
+            .apply_leg_event(
+                &inbound.fence(),
+                &inbound_leg,
+                "remote-cancel",
+                HASH_A,
+                NativeLegEvent::RemoteCancelObserved,
+            )
+            .unwrap();
+        assert_eq!(cancel.state, NativeLegState::Terminating);
+        assert_eq!(
+            cancel.required_effect,
+            NativeRequiredEffect::RespondCancel2xxAndInvite487,
+        );
+
+        let mut outbound = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let outbound_leg = leg("outbound-final");
+        outbound
+            .add_leg(
+                &outbound.fence(),
+                outbound_leg.clone(),
+                ProviderCallId::parse("provider-outbound-final").unwrap(),
+                NativeLegDirection::Outbound,
+            )
+            .unwrap();
+        outbound
+            .apply_leg_event(
+                &outbound.fence(),
+                &outbound_leg,
+                "outbound-start",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap();
+        let failed = outbound
+            .apply_leg_event(
+                &outbound.fence(),
+                &outbound_leg,
+                "outbound-final",
+                HASH_A,
+                NativeLegEvent::FinalNon2xx,
+            )
+            .unwrap();
+        assert_eq!(failed.state, NativeLegState::Failed);
+        assert_eq!(failed.required_effect, NativeRequiredEffect::AckNon2xx);
+
+        let mut deferred = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let deferred_leg = leg("inbound-deferred-bye");
+        deferred
+            .add_leg(
+                &deferred.fence(),
+                deferred_leg.clone(),
+                ProviderCallId::parse("provider-inbound-deferred").unwrap(),
+                NativeLegDirection::Inbound,
+            )
+            .unwrap();
+        for (event_id, event) in [
+            ("deferred-invite", NativeLegEvent::InboundInviteObserved),
+            ("deferred-answer", NativeLegEvent::Final2xx),
+        ] {
+            deferred
+                .apply_leg_event(&deferred.fence(), &deferred_leg, event_id, HASH_A, event)
+                .unwrap();
+        }
+        let requested = deferred
+            .apply_leg_event(
+                &deferred.fence(),
+                &deferred_leg,
+                "deferred-bye",
+                HASH_A,
+                NativeLegEvent::ByeRequested,
+            )
+            .unwrap();
+        assert_eq!(requested.state, NativeLegState::AwaitingAckTerminate);
+        assert_eq!(
+            requested.required_effect,
+            NativeRequiredEffect::DeferByeUntilAck,
+        );
+        let after_ack = deferred
+            .apply_leg_event(
+                &deferred.fence(),
+                &deferred_leg,
+                "deferred-ack",
+                HASH_A,
+                NativeLegEvent::Invite2xxAckObserved,
+            )
+            .unwrap();
+        assert_eq!(after_ack.state, NativeLegState::Terminating);
+        assert_eq!(after_ack.required_effect, NativeRequiredEffect::SendBye);
+    }
