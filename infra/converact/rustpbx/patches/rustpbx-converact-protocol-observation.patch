+fn effect_completion_scope(message: &SipMessage) -> Result<&'static str, SipEffectGateError> {
+    match message {
+        SipMessage::Request(request) if request.method == rsipstack::sip::Method::Ack => {
+            Ok(COMPLETION_SCOPE_TRANSPORT_TERMINAL)
+        }
+        SipMessage::Request(_) => Ok(COMPLETION_SCOPE_TRANSACTION_PEER),
+        SipMessage::Response(response) => {
+            let method = response
+                .cseq_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .method()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?;
+            let status = response.status_code.code();
+            if method == rsipstack::sip::Method::Invite && (200..=299).contains(&status) {
+                Ok(COMPLETION_SCOPE_UAS_CORE_DEFERRED)
+            } else if method == rsipstack::sip::Method::Invite && (300..=699).contains(&status) {
+                Ok(COMPLETION_SCOPE_TRANSACTION_PEER)
+            } else {
+                Ok(COMPLETION_SCOPE_TRANSPORT_TERMINAL)
+            }
+        }
+    }
