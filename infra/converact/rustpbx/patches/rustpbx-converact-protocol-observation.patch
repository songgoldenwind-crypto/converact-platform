+    let route = validate_route_binding(route_binding)?;
+    let transport = exact_object(
+        route
+            .get("transport")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+        &["id", "protocol", "next_hop"],
+    )?;
+    let protocol = transport_protocol(transport_binding.protocol())?;
+    if string_field(transport, "protocol")? != protocol {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    let next_hop = exact_object(
+        transport
+            .get("next_hop")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+        &["address", "port"],
+    )?;
+    let remote = transport_binding.remote_addr();
+    if string_field(next_hop, "address")?
+        .parse::<std::net::IpAddr>()
+        .ok()
