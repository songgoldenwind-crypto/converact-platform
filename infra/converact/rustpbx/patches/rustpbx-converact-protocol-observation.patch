+fn durable_observation_is_satisfied(
+    state: SipEffectState,
+    observation: SipEffectDurableObservation,
+) -> bool {
+    match observation {
+        SipEffectDurableObservation::TransportAccepted => matches!(
+            state,
+            SipEffectState::TransportAccepted
+                | SipEffectState::TransportCompleted
+                | SipEffectState::ProtocolObserved
+                | SipEffectState::Failed
+                | SipEffectState::Unknown
+        ),
+        SipEffectDurableObservation::TransportUnknown
+        | SipEffectDurableObservation::ProtocolUnknown => {
+            state == SipEffectState::Unknown || state.is_terminal()
+        }
+        SipEffectDurableObservation::ProtocolObserved => state == SipEffectState::ProtocolObserved,
+        SipEffectDurableObservation::TransportCompleted => {
+            state == SipEffectState::TransportCompleted
+        }
+    }
+}
+
+fn observation_receipt(
+    current: &DecodedEffect,
+    observation: SipEffectDurableObservation,
+    unknown_repair_after_ms: u32,
+) -> Result<(&'static str, SipEffectReceiptLevel, Option<u32>), SipEffectStoreError> {
+    let state = current.record.state;
+    let scope = current
+        .record
+        .wire_attempt_facts
+        .get("completion_scope")
+        .and_then(Value::as_str);
+    match observation {
+        SipEffectDurableObservation::TransportAccepted
+            if state == SipEffectState::SendAttempted =>
+        {
+            Ok((
+                "transport-accepted",
+                SipEffectReceiptLevel::TransportAccepted,
+                None,
+            ))
+        }
+        SipEffectDurableObservation::TransportUnknown if state == SipEffectState::SendAttempted => {
+            Ok((
+                "transport-unknown",
+                SipEffectReceiptLevel::Unknown,
+                Some(unknown_repair_after_ms),
+            ))
+        }
+        SipEffectDurableObservation::ProtocolObserved
+            if matches!(
+                state,
+                SipEffectState::SendAttempted | SipEffectState::TransportAccepted
+            ) && (current.schema == SipEffectLedgerSchema::V1
+                || scope == Some("transaction_peer_observation")) =>
+        {
+            Ok((
+                "protocol-observed",
+                SipEffectReceiptLevel::ProtocolObserved,
+                None,
+            ))
+        }
+        SipEffectDurableObservation::ProtocolUnknown
+            if matches!(
+                state,
+                SipEffectState::SendAttempted | SipEffectState::TransportAccepted
+            ) =>
+        {
+            Ok((
+                "protocol-unknown",
+                SipEffectReceiptLevel::Unknown,
+                Some(unknown_repair_after_ms),
+            ))
+        }
+        SipEffectDurableObservation::TransportCompleted
+            if current.schema == SipEffectLedgerSchema::V2
+                && state == SipEffectState::TransportAccepted
+                && scope == Some("transport_accepted_terminal") =>
+        {
+            Ok((
+                "transport-terminal",
+                SipEffectReceiptLevel::TransportCompleted,
+                None,
+            ))
+        }
+        _ if state.is_terminal() => Err(SipEffectError::Terminal.into()),
+        _ => Err(SipEffectError::TransitionConflict.into()),
+    }
+}
+
+async fn prepare_locked(
+    transaction: &mut Transaction<'_, Postgres>,
+    effect: &PreparedSipEffect,
+    effect_identity_hash: &str,
+    audit_retention_ms: i64,
+) -> Result<(SipEffectPrepareOutcome, SipEffectLedgerSchema), SipEffectStoreError> {
+    let inserted = sqlx::query(PREPARE_INSERT_SQL)
+        .bind(&effect.identity.protocol_effect_id)
+        .bind(&effect.identity.tenant_id)
+        .bind(&effect.identity.protocol_session_id)
+        .bind(&effect.identity.protocol_session_generation)
+        .bind(&effect.identity.decision_id)
+        .bind(&effect.identity.idempotency_key)
+        .bind(&effect.identity.request_hash)
+        .bind(&effect.identity.command_id)
+        .bind(&effect.adapter_identity)
+        .bind(&effect.identity.adapter_identity_hash)
+        .bind(&effect.identity.wire_bytes_hash)
+        .bind(
+            i32::try_from(effect.identity.wire_length_bytes)
+                .map_err(|_| SipEffectStoreError::InvalidConfiguration)?,
+        )
+        .bind(&effect.canonical_wire_bytes)
+        .bind(&effect.route_binding)
+        .bind(&effect.identity.route_binding_hash)
+        .bind(&effect.wire_attempt_facts)
+        .bind(&effect.identity.wire_attempt_facts_hash)
+        .bind(&effect.identity.wire_freeze_sha256)
+        .bind(effect_identity_hash)
+        .bind(effect.identity.owner_epoch.to_string())
+        .bind(effect.identity.command_sequence.to_string())
+        .bind(SIP_EFFECT_SCHEMA_ID)
+        .bind(i32::from(SIP_EFFECT_SCHEMA_VERSION))
+        .bind(SIP_EFFECT_SCHEMA_HASH)
+        .bind(SIP_EFFECT_WRITER_IDENTITY)
+        .bind(audit_retention_ms)
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+
+    if let Some(row) = inserted {
+        let decoded = decode_effect(&row)?;
+        return Ok((
+            SipEffectPrepareOutcome {
+                record: decoded.record,
+                replayed: false,
+            },
+            decoded.schema,
+        ));
+    }
+
+    let rows = sqlx::query(PREPARE_CONFLICT_SQL)
+        .bind(&effect.identity.tenant_id)
+        .bind(&effect.identity.protocol_effect_id)
+        .bind(&effect.identity.idempotency_key)
+        .fetch_all(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+    if rows.len() != 1 {
+        return Err(SipEffectError::IdempotencyConflict.into());
+    }
+    let existing = decode_effect(&rows[0])?;
+    if existing.record.identity != effect.identity
+        || !existing.payload_retained
+        || existing.record.canonical_wire_bytes != effect.canonical_wire_bytes
+        || existing.record.adapter_identity != effect.adapter_identity
+        || existing.record.route_binding != effect.route_binding
+        || existing.record.wire_attempt_facts != effect.wire_attempt_facts
+    {
+        return Err(SipEffectError::IdempotencyConflict.into());
+    }
+    Ok((
+        SipEffectPrepareOutcome {
+            record: existing.record,
+            replayed: true,
+        },
+        existing.schema,
+    ))
+}
