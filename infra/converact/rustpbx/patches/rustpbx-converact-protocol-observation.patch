+
+fn audit_retention_millis(effect: &PreparedSipEffect) -> Result<i64, SipEffectStoreError> {
+    let retention = effect.audit_until.signed_duration_since(effect.prepared_at);
+    let milliseconds = retention.num_milliseconds();
+    if milliseconds <= 0
+        || milliseconds > MAX_AUDIT_RETENTION_MS
+        || effect.prepared_at + chrono::Duration::milliseconds(milliseconds) != effect.audit_until
+    {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    Ok(milliseconds)
+}
