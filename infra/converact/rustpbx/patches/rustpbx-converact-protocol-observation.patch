+            ("datagram_destination", Value::Null, Value::Null)
+        }
+        EgressTransportSelectionKind::ConnectedFlow => {
+            let flow_id = transport_binding
+                .flow_id()
+                .ok_or(SipEffectGateError::InvalidIntent)?;
