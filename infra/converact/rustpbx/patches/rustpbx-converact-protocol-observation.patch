+async fn flush_receipt_constraint(
+    transaction: &mut Transaction<'_, Postgres>,
+) -> Result<(), SipEffectStoreError> {
+    sqlx::query("SET CONSTRAINTS ivekit_sip_effect_receipt_applied IMMEDIATE")
+        .execute(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+    sqlx::query("SET CONSTRAINTS ivekit_sip_effect_receipt_applied DEFERRED")
+        .execute(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+    Ok(())
+}
