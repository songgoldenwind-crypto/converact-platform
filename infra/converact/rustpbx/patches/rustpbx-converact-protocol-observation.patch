+        rsipstack::sip::Transport::Tcp => Ok("tcp"),
+        rsipstack::sip::Transport::Tls => Ok("tls"),
+        rsipstack::sip::Transport::Ws => Ok("ws"),
+        rsipstack::sip::Transport::Wss => Ok("wss"),
+        _ => Err(SipEffectGateError::InvalidIntent),
+    }
