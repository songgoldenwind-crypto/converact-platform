+fn exact_object<'a>(
+    value: &'a Value,
+    keys: &[&str],
+) -> Result<&'a serde_json::Map<String, Value>, SipEffectGateError> {
+    let object = value.as_object().ok_or(SipEffectGateError::InvalidIntent)?;
+    if object.len() != keys.len() || keys.iter().any(|key| !object.contains_key(*key)) {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    Ok(object)
+}
+
+fn string_field<'a>(
+    object: &'a serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<&'a str, SipEffectGateError> {
+    object
+        .get(key)
+        .and_then(Value::as_str)
+        .ok_or(SipEffectGateError::InvalidIntent)
+}
+
+fn nullable_string<'a>(
+    object: &'a serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<Option<&'a str>, SipEffectGateError> {
+    match object.get(key) {
+        Some(Value::Null) => Ok(None),
+        Some(Value::String(value)) => Ok(Some(value)),
+        _ => Err(SipEffectGateError::InvalidIntent),
+    }
+}
+
+fn validate_identifier_field(
+    object: &serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<(), SipEffectGateError> {
+    validate_sip_effect_identifier(string_field(object, key)?)
+        .map_err(|_| SipEffectGateError::InvalidIntent)
+}
+
+fn validate_bounded_text(
+    object: &serde_json::Map<String, Value>,
+    key: &str,
+    maximum: usize,
+) -> Result<(), SipEffectGateError> {
+    validate_bounded_wire_value(
+        object.get(key).ok_or(SipEffectGateError::InvalidIntent)?,
+        maximum,
+    )
+}
+
+fn validate_bounded_wire_value(value: &Value, maximum: usize) -> Result<(), SipEffectGateError> {
+    if !value.as_str().is_some_and(|text| {
+        !text.is_empty()
+            && text.len() <= maximum
+            && !text
+                .bytes()
+                .any(|byte| matches!(byte, b'\0' | b'\r' | b'\n'))
+    }) {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    Ok(())
+}
+
+fn valid_host(value: &str) -> bool {
+    value.parse::<std::net::IpAddr>().is_ok() || valid_hostname(value)
+}
+
+fn valid_hostname(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 253
+        && value.split('.').all(|label| {
+            !label.is_empty()
+                && label.len() <= 63
+                && label
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+                && label
+                    .as_bytes()
+                    .first()
+                    .is_some_and(u8::is_ascii_alphanumeric)
+                && label
+                    .as_bytes()
+                    .last()
+                    .is_some_and(u8::is_ascii_alphanumeric)
+        })
+}
