+    #[test]
+    fn observer_restart_uses_one_atomic_lifecycle_claim() {
+        let registry = Arc::new(SipEffectIntentRegistry::try_new(8).unwrap());
+        let writer = Arc::new(InMemoryWriter::new());
+        let (gate, observers) = DurableRsipstackEgressGate::new_with_store(
+            registry,
+            writer,
+            SipEffectGateOptions {
+                observation_worker_shards: 1,
+                ..SipEffectGateOptions::default()
+            },
+        )
+        .unwrap();
+        drop(observers);
+
+        let contenders = 8;
+        let barrier = Arc::new(Barrier::new(contenders));
+        let mut threads = Vec::with_capacity(contenders);
+        for _ in 0..contenders {
+            let gate = gate.clone();
+            let barrier = barrier.clone();
+            threads.push(std::thread::spawn(move || {
+                barrier.wait();
+                gate.restart_observer(0)
+            }));
+        }
+        let results = threads
+            .into_iter()
+            .map(|thread| thread.join().expect("restart contender"))
+            .collect::<Vec<_>>();
+        assert_eq!(results.iter().filter(|result| result.is_ok()).count(), 1);
+        assert_eq!(
+            results
+                .iter()
+                .filter(|result| {
+                    matches!(result, Err(SipEffectGateError::ReconciliationRequired))
+                })
+                .count(),
+            contenders - 1
+        );
+    }
