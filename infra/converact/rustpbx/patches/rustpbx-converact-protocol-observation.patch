+async fn run_with_store_deadline<T>(
+    deadline: Duration,
+    operation: impl Future<Output = Result<T, SipEffectStoreError>>,
+) -> Result<T, SipEffectStoreError> {
+    tokio::time::timeout(deadline, operation)
+        .await
+        .map_err(|_| SipEffectStoreError::PoolTimeout)?
