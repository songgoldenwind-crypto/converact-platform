+fn prepare_stage_receipt(
+    record: &SipEffectRecord,
+    stage: &str,
+    level: SipEffectReceiptLevel,
+) -> Result<SipEffectReceipt, SipEffectStoreError> {
+    let receipt_id = sip_effect_stage_token("receipt", &record.identity.protocol_effect_id, stage);
+    SipEffectReceipt::new(record.fence(), &receipt_id, level, "", None).map_err(Into::into)
+}
