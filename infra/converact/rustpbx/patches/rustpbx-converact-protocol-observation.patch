+fn validate_route_binding(
+    value: &Value,
+) -> Result<&serde_json::Map<String, Value>, SipEffectGateError> {
+    let route_binding = exact_object(
+        value,
+        &[
+            "schema_id",
+            "schema_version",
+            "route",
+            "rfc3263_candidate",
+            "route_set",
+            "transport",
+            "local_endpoint",
+            "advertised_via_sent_by",
+            "tls_sni",
+            "authorization_identity",
+            "authorization_headers_sha256",
+        ],
+    )?;
+    if string_field(route_binding, "schema_id")? != "sip-foundation-route-binding-v1"
+        || string_field(route_binding, "schema_version")? != "1.0.0"
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    let route = exact_object(
+        route_binding
+            .get("route")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+        &["id", "revision"],
+    )?;
+    validate_identifier_field(route, "id")?;
+    if !matches!(route.get("revision").and_then(Value::as_u64), Some(1..)) {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    validate_bounded_text(route_binding, "rfc3263_candidate", 1_024)?;
+    let route_set = route_binding
+        .get("route_set")
+        .and_then(Value::as_array)
+        .filter(|entries| entries.len() <= 32)
+        .ok_or(SipEffectGateError::InvalidIntent)?;
+    for route in route_set {
+        validate_bounded_wire_value(route, 4_096)?;
+    }
+    let transport = exact_object(
+        route_binding
+            .get("transport")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+        &["id", "protocol", "next_hop"],
+    )?;
+    validate_identifier_field(transport, "id")?;
+    let protocol = string_field(transport, "protocol")?;
+    if !matches!(protocol, "udp" | "tcp" | "tls" | "ws" | "wss") {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    validate_ip_endpoint(
+        transport
+            .get("next_hop")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+    )?;
+    validate_ip_endpoint(
+        route_binding
+            .get("local_endpoint")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+    )?;
+    let advertised = exact_object(
+        route_binding
+            .get("advertised_via_sent_by")
+            .ok_or(SipEffectGateError::InvalidIntent)?,
+        &["host", "port"],
+    )?;
+    let host = string_field(advertised, "host")?;
+    if !valid_host(host)
+        || !matches!(
+            advertised.get("port").and_then(Value::as_u64),
+            Some(1..=65_535)
+        )
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    let tls_sni = nullable_string(route_binding, "tls_sni")?;
