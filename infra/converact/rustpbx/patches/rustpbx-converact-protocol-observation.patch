+    V2,
+}
+
+impl SipEffectLedgerSchema {
+    fn from_fields(version: i32, hash: &str) -> Result<Self, SipEffectStoreError> {
+        match (version, hash) {
+            (version, SIP_EFFECT_SCHEMA_V1_HASH)
+                if version == i32::from(SIP_EFFECT_SCHEMA_V1_VERSION) =>
+            {
+                Ok(Self::V1)
+            }
+            (version, SIP_EFFECT_SCHEMA_HASH)
+                if version == i32::from(SIP_EFFECT_SCHEMA_VERSION) =>
+            {
+                Ok(Self::V2)
+            }
+            _ => Err(SipEffectStoreError::SchemaIncompatible),
+        }
+    }
+
+    fn version(self) -> u16 {
+        match self {
+            Self::V1 => SIP_EFFECT_SCHEMA_V1_VERSION,
+            Self::V2 => SIP_EFFECT_SCHEMA_VERSION,
+        }
+    }
+
+    fn hash(self) -> &'static str {
+        match self {
+            Self::V1 => SIP_EFFECT_SCHEMA_V1_HASH,
+            Self::V2 => SIP_EFFECT_SCHEMA_HASH,
+        }
+    }
 }
 
