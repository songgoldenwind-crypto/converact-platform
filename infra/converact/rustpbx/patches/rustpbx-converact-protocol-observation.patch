+async fn apply_locked(
+    transaction: &mut Transaction<'_, Postgres>,
+    decoded_current: DecodedEffect,
+    receipt: SipEffectReceipt,
+    effect_identity_hash: &str,
+) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+    let current_schema = decoded_current.schema;
+    let current = decoded_current.record;
+    let identity = &receipt.fence.identity;
+    if current.identity != *identity {
+        return Err(SipEffectError::IdentityConflict.into());
+    }
+
+    if let Some(row) = sqlx::query(RECEIPT_REPLAY_SQL)
+        .bind(&identity.tenant_id)
+        .bind(&receipt.receipt_id)
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?
+    {
+        let semantic =
+            validate_receipt_replay(&row, &receipt, effect_identity_hash, current_schema)?;
+        return Ok(SipEffectApplyOutcome {
+            record: current,
+            semantic,
+            replayed: true,
+        });
+    }
+    if current.state.is_terminal() {
+        return Err(SipEffectError::Terminal.into());
+    }
+    if current.revision != receipt.fence.expected_revision {
+        return Err(SipEffectError::FenceLost.into());
+    }
+    let semantic = classify_receipt(current.state, receipt.level)?;
+    let repair_fence = receipt.repair_fence();
+    let clears_repair_claim = current.state == SipEffectState::Unknown;
+    if clears_repair_claim {
+        let repair_fence = repair_fence.ok_or(SipEffectError::RepairFenceRequired)?;
+        if current.repair_claim.as_ref() != Some(repair_fence)
+            || repair_fence.repair_claim_revision != current.revision
+        {
+            return Err(SipEffectError::FenceLost.into());
+        }
+    } else if repair_fence.is_some() {
+        return Err(SipEffectError::FenceLost.into());
+    }
+    let repair_delay_ms = receipt
+        .repair_delay_ms
+        .map(i32::try_from)
+        .transpose()
+        .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+
+    let inserted_receipt = sqlx::query(RECEIPT_INSERT_SQL)
+        .bind(&receipt.receipt_id)
+        .bind(&identity.tenant_id)
+        .bind(&identity.protocol_effect_id)
+        .bind(&identity.decision_id)
+        .bind(&identity.idempotency_key)
+        .bind(&identity.request_hash)
+        .bind(&identity.command_id)
+        .bind(&identity.wire_bytes_hash)
+        .bind(effect_identity_hash)
+        .bind(identity.owner_epoch.to_string())
+        .bind(identity.command_sequence.to_string())
+        .bind(&receipt.receipt_hash)
+        .bind(receipt.level.as_str())
+        .bind(current.state.as_str())
+        .bind(&receipt.failure_code)
+        .bind(repair_delay_ms)
+        .bind(SIP_EFFECT_SCHEMA_ID)
+        .bind(i32::from(current_schema.version()))
+        .bind(current_schema.hash())
+        .bind(SIP_EFFECT_WRITER_IDENTITY)
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+    if inserted_receipt.is_none() {
+        let replay = sqlx::query(RECEIPT_REPLAY_SQL)
+            .bind(&identity.tenant_id)
+            .bind(&receipt.receipt_id)
+            .fetch_optional(&mut **transaction)
+            .await
+            .map_err(map_sqlx_error)?
+            .ok_or(SipEffectError::ReceiptConflict)?;
+        let semantic =
+            validate_receipt_replay(&replay, &receipt, effect_identity_hash, current_schema)?;
+        return Ok(SipEffectApplyOutcome {
+            record: current,
+            semantic,
+            replayed: true,
+        });
+    }
+
+    let terminal = receipt.level.state().is_terminal();
+    let repair_owner_id = repair_fence
+        .map(|fence| fence.repair_owner_id.as_str())
+        .unwrap_or("");
+    let repair_owner_epoch = repair_fence
+        .map(|fence| fence.repair_owner_epoch.to_string())
+        .unwrap_or_else(|| "1".to_string());
+    let repair_claim_token = repair_fence
+        .map(|fence| fence.repair_claim_token.as_str())
+        .unwrap_or("");
+    let repair_claim_revision = repair_fence
+        .map(|fence| fence.repair_claim_revision.to_string())
+        .unwrap_or_else(|| "1".to_string());
+    let updated = sqlx::query(TRANSITION_UPDATE_SQL)
+        .bind(&identity.tenant_id)
+        .bind(&identity.protocol_effect_id)
+        .bind(&identity.decision_id)
+        .bind(&identity.idempotency_key)
+        .bind(&identity.request_hash)
+        .bind(&identity.command_id)
+        .bind(&identity.wire_bytes_hash)
+        .bind(identity.owner_epoch.to_string())
+        .bind(identity.command_sequence.to_string())
+        .bind(receipt.level.as_str())
+        .bind(&receipt.receipt_id)
+        .bind(&receipt.receipt_hash)
+        .bind(&receipt.failure_code)
+        .bind(repair_delay_ms)
+        .bind(clears_repair_claim)
+        .bind(terminal)
+        .bind(current.revision.to_string())
+        .bind(current.state.as_str())
+        .bind(repair_owner_id)
+        .bind(repair_owner_epoch)
+        .bind(repair_claim_token)
+        .bind(repair_claim_revision)
+        .bind(effect_identity_hash)
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?
+        .ok_or(SipEffectError::FenceLost)?;
+    let decoded_updated = decode_effect(&updated)?;
+    if decoded_updated.schema != current_schema {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    Ok(SipEffectApplyOutcome {
+        record: decoded_updated.record,
+        semantic,
+        replayed: false,
+    })
+}
