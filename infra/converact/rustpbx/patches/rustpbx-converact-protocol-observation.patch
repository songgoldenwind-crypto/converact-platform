+fn validate_wire_attempt_facts<'a>(
+    value: &'a Value,
+    schema_version: u16,
+    expected_attempt_id: &str,
+) -> Result<&'a str, SipEffectError> {
+    if schema_version == SIP_EFFECT_SCHEMA_V1_VERSION {
+        let facts = exact_json_object(
+            value,
+            &[
+                "schema_id",
+                "schema_version",
+                "attempt_id",
+                "transaction_lineage_id",
+                "semantic_intent_sha256",
+                "parent_attempt_id",
+                "lineage_reason",
+                "via_branch",
+            ],
+        )?;
+        let semantic_intent = validate_wire_attempt_lineage(facts, expected_attempt_id, true)?;
+        validate_via_branch(json_string(facts, "via_branch")?)?;
+        return Ok(semantic_intent);
+    }
+
+    let facts = exact_json_object(
+        value,
+        &[
+            "schema_id",
+            "schema_version",
+            "lineage",
+            "via_branch",
+            "canonical_destination",
+            "transaction_binding_sha256",
+            "completion_scope",
+        ],
+    )?;
+    if json_string(facts, "schema_id")? != "sip-foundation-effect-wire-attempt-v2"
+        || json_string(facts, "schema_version")? != "2.0.0"
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    let lineage = exact_json_object(
+        facts.get("lineage").ok_or(SipEffectError::InvalidInput)?,
+        &[
+            "schema_id",
+            "schema_version",
+            "attempt_id",
+            "transaction_lineage_id",
+            "semantic_intent_sha256",
+            "parent_attempt_id",
+            "lineage_reason",
+        ],
+    )?;
+    let semantic_intent = validate_wire_attempt_lineage(lineage, expected_attempt_id, false)?;
+    validate_via_branch(json_string(facts, "via_branch")?)?;
+    validate_canonical_destination(
+        facts
+            .get("canonical_destination")
+            .ok_or(SipEffectError::InvalidInput)?,
+    )?;
+    checked_hash(json_string(facts, "transaction_binding_sha256")?)?;
+    if !matches!(
+        json_string(facts, "completion_scope")?,
+        "transaction_peer_observation" | "transport_accepted_terminal" | "uas_core_deferred"
+    ) {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(semantic_intent)
+}
+
+fn validate_wire_attempt_lineage<'a>(
+    facts: &'a serde_json::Map<String, Value>,
+    expected_attempt_id: &str,
+    bound_v1: bool,
+) -> Result<&'a str, SipEffectError> {
+    if json_string(facts, "schema_id")? != "sip-foundation-wire-attempt-v1"
+        || json_string(facts, "schema_version")? != "1.0.0"
+        || json_string(facts, "attempt_id")? != expected_attempt_id
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    checked_identifier(json_string(facts, "attempt_id")?)?;
+    checked_identifier(json_string(facts, "transaction_lineage_id")?)?;
+    let semantic_intent = json_string(facts, "semantic_intent_sha256")?;
+    checked_hash(semantic_intent)?;
+    let parent = match facts.get("parent_attempt_id") {
+        Some(Value::Null) => None,
+        Some(Value::String(value)) => {
+            checked_identifier(value)?;
+            Some(value.as_str())
+        }
+        _ => return Err(SipEffectError::InvalidInput),
+    };
+    match (json_string(facts, "lineage_reason")?, parent) {
+        ("transaction_root", None)
+            if json_string(facts, "transaction_lineage_id")? == expected_attempt_id => {}
+        ("derived_attempt", Some(parent)) if parent != expected_attempt_id => {}
+        _ => return Err(SipEffectError::InvalidInput),
+    }
+    if bound_v1 != facts.contains_key("via_branch") {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(semantic_intent)
+}
+
+fn validate_canonical_destination(value: &Value) -> Result<(), SipEffectError> {
+    let destination = exact_json_object(
+        value,
+        &[
+            "transport_id",
+            "protocol",
+            "address",
+            "port",
+            "selection_kind",
+            "flow_id",
+            "flow_generation",
+        ],
+    )?;
+    checked_identifier(json_string(destination, "transport_id")?)?;
+    if !matches!(
+        json_string(destination, "protocol")?,
+        "udp" | "tcp" | "tls" | "ws" | "wss"
+    ) || json_string(destination, "address")?
+        .parse::<std::net::IpAddr>()
+        .is_err()
+        || !matches!(
+            destination.get("port").and_then(Value::as_u64),
+            Some(1..=65_535)
+        )
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    let flow_id = match destination.get("flow_id") {
+        Some(Value::Null) => None,
+        Some(Value::String(value)) => {
+            checked_identifier(value)?;
+            Some(value.as_str())
+        }
+        _ => return Err(SipEffectError::InvalidInput),
+    };
+    let flow_generation = match destination.get("flow_generation") {
+        Some(Value::Null) => None,
+        Some(Value::String(value)) => {
+            if value
+                .parse::<u64>()
+                .ok()
+                .filter(|generation| *generation > 0)
+                .map(|generation| generation.to_string())
+                != Some(value.clone())
+            {
+                return Err(SipEffectError::InvalidInput);
+            }
+            Some(value.as_str())
+        }
+        _ => return Err(SipEffectError::InvalidInput),
+    };
+    match (
+        json_string(destination, "selection_kind")?,
+        flow_id,
+        flow_generation,
+    ) {
+        ("route_candidate" | "datagram_destination", None, None)
+        | ("connected_flow", Some(_), Some(_)) => Ok(()),
+        _ => Err(SipEffectError::InvalidInput),
+    }
+}
+
+fn exact_json_object<'a>(
+    value: &'a Value,
+    keys: &[&str],
+) -> Result<&'a serde_json::Map<String, Value>, SipEffectError> {
+    let object = value.as_object().ok_or(SipEffectError::InvalidInput)?;
+    if object.len() != keys.len() || keys.iter().any(|key| !object.contains_key(*key)) {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(object)
+}
+
+fn json_string<'a>(
+    object: &'a serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<&'a str, SipEffectError> {
+    object
+        .get(key)
+        .and_then(Value::as_str)
+        .ok_or(SipEffectError::InvalidInput)
+}
+
+fn validate_via_branch(value: &str) -> Result<(), SipEffectError> {
+    if !value.starts_with("z9hG4bK")
+        || value.len() > 255
+        || value.len() <= "z9hG4bK".len()
+        || !value.bytes().all(|byte| (b'!'..=b'~').contains(&byte))
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(())
+}
