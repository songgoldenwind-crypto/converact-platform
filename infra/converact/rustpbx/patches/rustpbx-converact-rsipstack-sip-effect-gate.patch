+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectIntentRegistrySnapshot {
+    pub registered: usize,
+    pub maximum: usize,
+}
+
+#[derive(Clone)]
+pub struct SipEffectIntentRegistry {
+    inner: Arc<SipEffectIntentRegistryInner>,
+}
+
+struct SipEffectIntentRegistryInner {
+    intents: DashMap<String, RegisteredIntent>,
+    registered: AtomicUsize,
+    maximum: usize,
+    next_registration_id: AtomicU64,
+}
+
+#[derive(Clone)]
+struct RegisteredIntent {
+    registration_id: u64,
+    intent: SipEffectIntent,
+    claimed: bool,
+    lease_released: bool,
+}
+
+impl SipEffectIntentRegistry {
+    pub fn try_new(maximum: usize) -> Result<Self, SipEffectGateError> {
+        if maximum == 0 || maximum > INTENT_CAPACITY_HARD_CEILING {
+            return Err(SipEffectGateError::InvalidConfiguration);
+        }
+        Ok(Self {
+            inner: Arc::new(SipEffectIntentRegistryInner {
+                intents: DashMap::new(),
+                registered: AtomicUsize::new(0),
+                maximum,
+                next_registration_id: AtomicU64::new(1),
+            }),
+        })
+    }
+
+    pub fn register(
+        &self,
+        transaction_key: &TransactionKey,
+        message: &SipMessage,
+        intent: SipEffectIntent,
+    ) -> Result<SipEffectIntentLease, SipEffectGateError> {
+        intent.validate()?;
+        let binding_key = effect_binding_key(transaction_key, message)?;
+        self.inner
+            .registered
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |current| {
+                (current < self.inner.maximum).then_some(current + 1)
+            })
+            .map_err(|_| SipEffectGateError::IntentCapacityExhausted)?;
+        let registration_id = match self.inner.next_registration_id.fetch_update(
+            Ordering::AcqRel,
+            Ordering::Acquire,
+            |current| current.checked_add(1),
+        ) {
+            Ok(value) => value,
+            Err(_) => {
+                self.inner.registered.fetch_sub(1, Ordering::AcqRel);
+                return Err(SipEffectGateError::IntentCapacityExhausted);
+            }
+        };
+        use dashmap::mapref::entry::Entry;
+        match self.inner.intents.entry(binding_key.clone()) {
+            Entry::Occupied(_) => {
+                self.inner.registered.fetch_sub(1, Ordering::AcqRel);
+                Err(SipEffectGateError::IntentConflict)
+            }
+            Entry::Vacant(entry) => {
+                entry.insert(RegisteredIntent {
+                    registration_id,
+                    intent,
+                    claimed: false,
+                    lease_released: false,
+                });
+                Ok(SipEffectIntentLease {
+                    registry: Arc::downgrade(&self.inner),
+                    binding_key,
+                    registration_id,
+                })
+            }
+        }
+    }
+
+    pub fn snapshot(&self) -> SipEffectIntentRegistrySnapshot {
+        SipEffectIntentRegistrySnapshot {
+            registered: self.inner.registered.load(Ordering::Acquire),
+            maximum: self.inner.maximum,
+        }
+    }
+
+    fn claim(&self, binding_key: &str) -> Result<SipEffectIntentClaim, SipEffectGateError> {
+        let mut registered = self
+            .inner
+            .intents
+            .get_mut(binding_key)
+            .ok_or(SipEffectGateError::IntentMissing)?;
+        if registered.lease_released {
+            return Err(SipEffectGateError::IntentReleased);
+        }
+        if registered.claimed {
+            return Err(SipEffectGateError::IntentBusy);
+        }
+        registered.claimed = true;
+        Ok(SipEffectIntentClaim {
+            registry: Arc::downgrade(&self.inner),
+            binding_key: binding_key.to_string(),
+            registration_id: registered.registration_id,
+            intent: registered.intent.clone(),
+            finished: false,
+        })
+    }
+}
+
+#[must_use = "dropping the intent lease revokes an uncommitted SIP effect"]
+pub struct SipEffectIntentLease {
+    registry: Weak<SipEffectIntentRegistryInner>,
+    binding_key: String,
+    registration_id: u64,
+}
+
+impl Drop for SipEffectIntentLease {
+    fn drop(&mut self) {
+        let Some(registry) = self.registry.upgrade() else {
+            return;
+        };
+        if let Some(mut registered) = registry.intents.get_mut(&self.binding_key) {
+            if registered.registration_id != self.registration_id {
+                return;
+            }
+            if registered.claimed {
+                registered.lease_released = true;
+                return;
+            }
+            drop(registered);
+        }
+        remove_registered_intent(&registry, &self.binding_key, self.registration_id);
+    }
+}
+
+struct SipEffectIntentClaim {
+    registry: Weak<SipEffectIntentRegistryInner>,
+    binding_key: String,
+    registration_id: u64,
+    intent: SipEffectIntent,
+    finished: bool,
+}
+
+impl SipEffectIntentClaim {
+    fn released(&self) -> bool {
+        self.registry
+            .upgrade()
+            .and_then(|registry| {
+                registry.intents.get(&self.binding_key).map(|registered| {
+                    registered.registration_id != self.registration_id || registered.lease_released
+                })
+            })
+            .unwrap_or(true)
+    }
+
+    fn consume(&mut self) {
+        if self.finished {
+            return;
+        }
+        if let Some(registry) = self.registry.upgrade() {
+            remove_registered_intent(&registry, &self.binding_key, self.registration_id);
+        }
+        self.finished = true;
+    }
+}
+
+impl Drop for SipEffectIntentClaim {
+    fn drop(&mut self) {
+        if self.finished {
+            return;
+        }
+        let Some(registry) = self.registry.upgrade() else {
+            return;
+        };
+        let mut remove = false;
+        if let Some(mut registered) = registry.intents.get_mut(&self.binding_key)
+            && registered.registration_id == self.registration_id
+        {
+            if registered.lease_released {
+                remove = true;
+            } else {
+                registered.claimed = false;
+            }
+        }
+        if remove {
+            remove_registered_intent(&registry, &self.binding_key, self.registration_id);
+        }
+    }
+}
+
+fn remove_registered_intent(
+    registry: &SipEffectIntentRegistryInner,
+    binding_key: &str,
+    registration_id: u64,
+) {
+    if registry
+        .intents
+        .remove_if(binding_key, |_, registered| {
+            registered.registration_id == registration_id
+        })
+        .is_some()
+    {
+        let previous = registry.registered.fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+    }
+}
