+        let (gate, observer) = runtime(
+            registry.clone(),
+            writer.clone(),
+            SipEffectGateOptions::default(),
+        );
+        drop(observer);
+        let (key, message) = invite("call-closed@example.test", "z9hG4bK-closed");
+        let _lease = registry
+            .register(&key, &message, intent("effect-closed", "session-closed"))
+            .unwrap();
+        let permit = gate
+            .prepare(&key, &message, None, &message.to_bytes())
+            .await
+            .unwrap();
+        let prepared = writer.prepared.lock().unwrap()[0].clone();
+
+        gate.observe_transport(permit, EgressEffectOutcome::TransportAccepted);
+        assert_eq!(gate.snapshot().pending_observations, 0);
+        assert_eq!(gate.snapshot().observation_closed, 1);
+        assert_eq!(writer.state(&prepared).await, SipEffectState::SendAttempted);
+    }
+
+    #[tokio::test]
+    async fn unknown_transport_result_is_persisted_with_bounded_repair_delay() {
+        let registry = Arc::new(SipEffectIntentRegistry::try_new(8).unwrap());
+        let writer = Arc::new(InMemoryWriter::new());
+        let (gate, mut observer) = runtime(
+            registry.clone(),
+            writer.clone(),
+            SipEffectGateOptions {
+                unknown_repair_after_ms: 1_379,
+                ..SipEffectGateOptions::default()
+            },
+        );
+        let (key, message) = invite("call-unknown@example.test", "z9hG4bK-unknown");
+        let _lease = registry
+            .register(&key, &message, intent("effect-unknown", "session-unknown"))
+            .unwrap();
+        let permit = gate
+            .prepare(&key, &message, None, &message.to_bytes())
+            .await
+            .unwrap();
+        let prepared = writer.prepared.lock().unwrap()[0].clone();
+
+        gate.observe_transport(permit, EgressEffectOutcome::TransportUnknown);
+        assert!(observer.persist_next().await.unwrap());
+        let record = writer.record(&prepared).await;
+        assert_eq!(record.state, SipEffectState::Unknown);
+        assert_eq!(record.repair_delay_ms, Some(1_379));
+        assert_eq!(record.unknown_count, 1);
+    }
