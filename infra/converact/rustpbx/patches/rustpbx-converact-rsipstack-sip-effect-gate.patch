+#[async_trait]
+pub(crate) trait SipEffectStorePort: Send + Sync {
+    async fn prepare(
+        &self,
+        effect: PreparedSipEffect,
+    ) -> Result<SipEffectPrepareOutcome, SipEffectStoreError>;
+
+    async fn apply(
+        &self,
+        receipt: SipEffectReceipt,
+    ) -> Result<SipEffectApplyOutcome, SipEffectStoreError>;
+}
+
+#[async_trait]
+impl SipEffectStorePort for PostgresSipEffectStore {
+    async fn prepare(
+        &self,
+        effect: PreparedSipEffect,
+    ) -> Result<SipEffectPrepareOutcome, SipEffectStoreError> {
+        PostgresSipEffectStore::prepare(self, effect).await
+    }
+
+    async fn apply(
+        &self,
+        receipt: SipEffectReceipt,
+    ) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+        PostgresSipEffectStore::apply(self, receipt).await
+    }
+}
