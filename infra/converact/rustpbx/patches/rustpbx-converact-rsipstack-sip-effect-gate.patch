+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SipEffectIntent {
+    pub tenant_id: String,
+    pub protocol_effect_id: String,
+    pub protocol_session_id: String,
+    pub protocol_session_generation: String,
+    pub decision_id: String,
+    pub idempotency_key: String,
+    pub semantic_intent_sha256: String,
+    pub command_id: String,
+    pub adapter_identity: Value,
+    pub route_binding: Value,
+    pub wire_attempt_facts: Value,
+    pub owner_epoch: u64,
+    pub command_sequence: u64,
+    pub prepared_at: DateTime<Utc>,
+    pub audit_until: DateTime<Utc>,
+}
+
+impl SipEffectIntent {
+    fn validate(&self) -> Result<(), SipEffectGateError> {
+        for identifier in [
+            &self.tenant_id,
+            &self.protocol_effect_id,
+            &self.protocol_session_id,
+            &self.protocol_session_generation,
+            &self.decision_id,
+            &self.idempotency_key,
+            &self.command_id,
+        ] {
+            validate_sip_effect_identifier(identifier)
+                .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        }
+        if !is_sha256(&self.semantic_intent_sha256)
+            || self
+                .protocol_session_generation
+                .parse::<u64>()
+                .ok()
+                .filter(|generation| *generation > 0)
+                .is_none()
+            || self.owner_epoch == 0
+            || self.command_sequence == 0
+            || self.audit_until <= self.prepared_at
+            || !self.adapter_identity.is_object()
+            || !self.route_binding.is_object()
+            || !self.wire_attempt_facts.is_object()
+        {
+            return Err(SipEffectGateError::InvalidIntent);
+        }
+        canonical_json_sha256(&self.adapter_identity)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        canonical_json_sha256(&self.route_binding)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        canonical_json_sha256(&self.wire_attempt_facts)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let facts = self
+            .wire_attempt_facts
+            .as_object()
+            .ok_or(SipEffectGateError::InvalidIntent)?;
+        if facts.get("semantic_intent_sha256").and_then(Value::as_str)
+            != Some(self.semantic_intent_sha256.as_str())
+            || RESERVED_WIRE_FACT_KEYS
+                .iter()
+                .any(|key| facts.contains_key(*key))
+        {
+            return Err(SipEffectGateError::InvalidIntent);
+        }
+        Ok(())
+    }
+
+    fn prepare(
+        &self,
+        transaction_binding_sha256: &str,
+        destination: Option<&SipAddr>,
+        canonical_wire_bytes: &[u8],
+    ) -> Result<PreparedSipEffect, SipEffectGateError> {
+        self.validate()?;
+        if !is_sha256(transaction_binding_sha256) {
+            return Err(SipEffectGateError::InvalidIntent);
+        }
+        let wire_length_bytes = u32::try_from(canonical_wire_bytes.len())
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let mut wire_attempt_facts = self.wire_attempt_facts.clone();
+        let facts = wire_attempt_facts
+            .as_object_mut()
+            .ok_or(SipEffectGateError::InvalidIntent)?;
+        facts.insert(
+            "destination".to_string(),
+            destination
+                .map(ToString::to_string)
+                .map(Value::String)
+                .unwrap_or(Value::Null),
+        );
+        facts.insert(
+            "transaction_binding_sha256".to_string(),
+            Value::String(transaction_binding_sha256.to_string()),
+        );
+
+        let wire_bytes_hash = sha256_lower_hex(canonical_wire_bytes);
+        let adapter_identity_hash = canonical_json_sha256(&self.adapter_identity)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let route_binding_hash = canonical_json_sha256(&self.route_binding)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let wire_attempt_facts_hash = canonical_json_sha256(&wire_attempt_facts)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let wire_freeze_sha256 = sip_wire_freeze_sha256(
+            &route_binding_hash,
+            &wire_attempt_facts_hash,
+            &wire_bytes_hash,
+            wire_length_bytes,
+        )
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let effect = PreparedSipEffect {
+            identity: SipEffectIdentity {
+                tenant_id: self.tenant_id.clone(),
+                protocol_effect_id: self.protocol_effect_id.clone(),
+                protocol_session_id: self.protocol_session_id.clone(),
+                protocol_session_generation: self.protocol_session_generation.clone(),
+                decision_id: self.decision_id.clone(),
+                idempotency_key: self.idempotency_key.clone(),
+                request_hash: self.semantic_intent_sha256.clone(),
+                command_id: self.command_id.clone(),
+                adapter_identity_hash,
+                wire_bytes_hash,
+                wire_length_bytes,
+                route_binding_hash,
+                wire_attempt_facts_hash,
+                wire_freeze_sha256,
+                owner_epoch: self.owner_epoch,
+                command_sequence: self.command_sequence,
+            },
+            canonical_wire_bytes: canonical_wire_bytes.to_vec(),
+            adapter_identity: self.adapter_identity.clone(),
+            route_binding: self.route_binding.clone(),
+            wire_attempt_facts,
+            prepared_at: self.prepared_at,
+            audit_until: self.audit_until,
+        };
+        effect
+            .validate()
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        Ok(effect)
+    }
+}
