+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectGateSnapshot {
+    pub pending_observations: usize,
+    pub observation_overflow: usize,
+    pub observation_closed: usize,
+    pub orphan_observations: usize,
+    pub observations_persisted: usize,
+    pub observation_persist_failures: usize,
+}
+
+struct SipEffectGateMetrics {
+    pending_observations: AtomicUsize,
+    observation_overflow: AtomicUsize,
+    observation_closed: AtomicUsize,
+    orphan_observations: AtomicUsize,
+    observations_persisted: AtomicUsize,
+    observation_persist_failures: AtomicUsize,
+}
+
+struct PendingTransportObservation {
+    record: SipEffectRecord,
+    observation_shard: usize,
+    _capacity: OwnedSemaphorePermit,
+}
+
+struct TransportObservationWork {
+    pending: PendingTransportObservation,
+    outcome: EgressEffectOutcome,
+}
+
+pub struct DurableRsipstackEgressGate {
+    intents: Arc<SipEffectIntentRegistry>,
+    store: Arc<dyn SipEffectStorePort>,
+    pending: DashMap<String, PendingTransportObservation>,
+    pending_capacity: Arc<Semaphore>,
+    observation_txs: Vec<mpsc::Sender<TransportObservationWork>>,
+    metrics: Arc<SipEffectGateMetrics>,
+}
+
+impl DurableRsipstackEgressGate {
+    pub fn new_postgres(
+        intents: Arc<SipEffectIntentRegistry>,
+        store: Arc<PostgresSipEffectStore>,
+        options: SipEffectGateOptions,
+    ) -> Result<(Arc<Self>, Vec<SipEffectTransportObserver>), SipEffectGateError> {
+        Self::new_with_store(intents, store, options)
+    }
+
+    fn new_with_store<T>(
+        intents: Arc<SipEffectIntentRegistry>,
+        store: Arc<T>,
+        options: SipEffectGateOptions,
+    ) -> Result<(Arc<Self>, Vec<SipEffectTransportObserver>), SipEffectGateError>
+    where
+        T: SipEffectStorePort + 'static,
+    {
+        let options = options.validate()?;
+        let store: Arc<dyn SipEffectStorePort> = store;
+        let metrics = Arc::new(SipEffectGateMetrics {
+            pending_observations: AtomicUsize::new(0),
+            observation_overflow: AtomicUsize::new(0),
+            observation_closed: AtomicUsize::new(0),
+            orphan_observations: AtomicUsize::new(0),
+            observations_persisted: AtomicUsize::new(0),
+            observation_persist_failures: AtomicUsize::new(0),
+        });
+        let mut observation_txs = Vec::with_capacity(options.observation_worker_shards);
+        let mut observers = Vec::with_capacity(options.observation_worker_shards);
+        let base_capacity = options.observation_queue_capacity / options.observation_worker_shards;
+        let capacity_remainder =
+            options.observation_queue_capacity % options.observation_worker_shards;
+        for shard in 0..options.observation_worker_shards {
+            let shard_capacity = base_capacity + usize::from(shard < capacity_remainder);
+            let (observation_tx, observation_rx) = mpsc::channel(shard_capacity);
+            observation_txs.push(observation_tx);
+            observers.push(SipEffectTransportObserver {
+                store: store.clone(),
+                observation_rx,
+                unknown_repair_after_ms: options.unknown_repair_after_ms,
+                metrics: metrics.clone(),
+            });
+        }
+        let gate = Arc::new(Self {
+            intents,
+            store,
+            pending: DashMap::new(),
+            pending_capacity: Arc::new(Semaphore::new(options.max_pending_observations)),
+            observation_txs,
+            metrics: metrics.clone(),
+        });
+        Ok((gate, observers))
+    }
+
+    pub fn snapshot(&self) -> SipEffectGateSnapshot {
+        SipEffectGateSnapshot {
+            pending_observations: self.metrics.pending_observations.load(Ordering::Acquire),
+            observation_overflow: self.metrics.observation_overflow.load(Ordering::Acquire),
+            observation_closed: self.metrics.observation_closed.load(Ordering::Acquire),
+            orphan_observations: self.metrics.orphan_observations.load(Ordering::Acquire),
+            observations_persisted: self.metrics.observations_persisted.load(Ordering::Acquire),
+            observation_persist_failures: self
+                .metrics
+                .observation_persist_failures
+                .load(Ordering::Acquire),
+        }
+    }
+
+    async fn prepare_inner(
+        &self,
+        transaction_key: &TransactionKey,
+        message: &SipMessage,
+        destination: Option<&SipAddr>,
+        canonical_wire_bytes: &[u8],
+    ) -> Result<EgressEffectPermit, SipEffectGateError> {
+        let binding_key = effect_binding_key(transaction_key, message)?;
+        let mut intent = self.intents.claim(&binding_key)?;
+        let pending_capacity = self
+            .pending_capacity
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| SipEffectGateError::ObservationCapacityExhausted)?;
+        let effect = intent
+            .intent
+            .prepare(&binding_key, destination, canonical_wire_bytes)?;
+        let prepared = self
+            .store
+            .prepare(effect)
+            .await
+            .map_err(|_| SipEffectGateError::StoreUnavailable)?;
+        let mut record = prepared.record;
+
+        match record.state {
+            SipEffectState::Prepared => {
+                if intent.released() {
+                    return Err(SipEffectGateError::IntentReleased);
+                }
+                record = self
+                    .store
+                    .apply(stage_receipt(
+                        &record,
+                        "durable-decision",
+                        SipEffectReceiptLevel::DurableDecision,
+                        None,
+                    )?)
+                    .await
+                    .map_err(|_| SipEffectGateError::StoreUnavailable)?
+                    .record;
+            }
+            SipEffectState::DurableDecision => {}
+            _ => {
+                intent.consume();
+                return Err(SipEffectGateError::ReconciliationRequired);
+            }
+        }
+        if record.state != SipEffectState::DurableDecision {
+            intent.consume();
+            return Err(SipEffectGateError::ReconciliationRequired);
+        }
+        if intent.released() {
+            return Err(SipEffectGateError::IntentReleased);
+        }
+
+        let send_attempt = match self
+            .store
+            .apply(stage_receipt(
+                &record,
+                "send-attempted",
+                SipEffectReceiptLevel::SendAttempted,
+                None,
+            )?)
+            .await
+        {
+            Ok(outcome) => outcome,
+            Err(_) => {
+                // The transaction commit may have succeeded even when its
+                // acknowledgement was lost. Consume the intent and require a
+                // query/reconcile cycle instead of issuing a blind send.
+                intent.consume();
+                return Err(SipEffectGateError::ReconciliationRequired);
+            }
+        };
+        if send_attempt.replayed || send_attempt.record.state != SipEffectState::SendAttempted {
+            intent.consume();
+            return Err(SipEffectGateError::ReconciliationRequired);
+        }
+        if intent.released() {
+            intent.consume();
+            return Err(SipEffectGateError::ReconciliationRequired);
+        }
+        record = send_attempt.record;
+        let permit_token = permit_token(&record)?;
+        let permit = EgressEffectPermit::try_new(&permit_token)
+            .map_err(|_| SipEffectGateError::InvalidConfiguration)?;
+        let observation_shard = observation_shard(&permit_token, self.observation_txs.len());
+
+        use dashmap::mapref::entry::Entry;
+        match self.pending.entry(permit_token) {
+            Entry::Occupied(_) => {
+                intent.consume();
+                return Err(SipEffectGateError::ReconciliationRequired);
+            }
+            Entry::Vacant(entry) => {
+                entry.insert(PendingTransportObservation {
+                    record,
+                    observation_shard,
+                    _capacity: pending_capacity,
+                });
+                self.metrics
+                    .pending_observations
+                    .fetch_add(1, Ordering::AcqRel);
+            }
+        }
+        intent.consume();
+        Ok(permit)
+    }
+}
+
+#[async_trait]
+impl EgressEffectGate for DurableRsipstackEgressGate {
+    async fn prepare(
+        &self,
+        transaction_key: &TransactionKey,
+        message: &SipMessage,
+        destination: Option<&SipAddr>,
+        canonical_wire_bytes: &[u8],
+    ) -> rsipstack::Result<EgressEffectPermit> {
+        self.prepare_inner(transaction_key, message, destination, canonical_wire_bytes)
+            .await
+            .map_err(|error| rsipstack::Error::EndpointError(error.to_string()))
+    }
+
+    fn observe_transport(&self, permit: EgressEffectPermit, outcome: EgressEffectOutcome) {
+        let Some((_, pending)) = self.pending.remove(permit.token()) else {
+            self.metrics
+                .orphan_observations
+                .fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+        let previous = self
+            .metrics
+            .pending_observations
+            .fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+        let observation_shard = pending.observation_shard;
+        match self.observation_txs[observation_shard]
+            .try_send(TransportObservationWork { pending, outcome })
+        {
+            Ok(()) => {}
+            Err(mpsc::error::TrySendError::Full(_)) => {
+                self.metrics
+                    .observation_overflow
+                    .fetch_add(1, Ordering::Relaxed);
+            }
+            Err(mpsc::error::TrySendError::Closed(_)) => {
+                self.metrics
+                    .observation_closed
+                    .fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+}
+
+pub struct SipEffectTransportObserver {
+    store: Arc<dyn SipEffectStorePort>,
+    observation_rx: mpsc::Receiver<TransportObservationWork>,
+    unknown_repair_after_ms: u32,
+    metrics: Arc<SipEffectGateMetrics>,
+}
+
+impl SipEffectTransportObserver {
+    pub async fn persist_next(&mut self) -> Result<bool, SipEffectGateError> {
+        let Some(work) = self.observation_rx.recv().await else {
+            return Ok(false);
+        };
+        let (suffix, level, repair_after_ms) = match work.outcome {
+            EgressEffectOutcome::TransportAccepted => (
+                "transport-accepted",
+                SipEffectReceiptLevel::TransportAccepted,
+                None,
+            ),
+            EgressEffectOutcome::TransportUnknown => (
+                "transport-unknown",
+                SipEffectReceiptLevel::Unknown,
+                Some(self.unknown_repair_after_ms),
+            ),
+        };
+        let receipt = stage_receipt(&work.pending.record, suffix, level, repair_after_ms)?;
+        if self.store.apply(receipt).await.is_err() {
+            self.metrics
+                .observation_persist_failures
+                .fetch_add(1, Ordering::Relaxed);
+            return Err(SipEffectGateError::StoreUnavailable);
+        }
+        self.metrics
+            .observations_persisted
+            .fetch_add(1, Ordering::Relaxed);
+        Ok(true)
+    }
+}
+
+fn stage_receipt(
+    record: &SipEffectRecord,
+    stage: &str,
+    level: SipEffectReceiptLevel,
+    repair_after_ms: Option<u32>,
+) -> Result<SipEffectReceipt, SipEffectGateError> {
+    let receipt_id = deterministic_token("receipt", &record.identity.protocol_effect_id, stage);
+    SipEffectReceipt::new(record.fence(), &receipt_id, level, "", repair_after_ms)
+        .map_err(|_| SipEffectGateError::InvalidIntent)
+}
+
+fn permit_token(record: &SipEffectRecord) -> Result<String, SipEffectGateError> {
+    let identity_hash = protocol_effect_identity_hash(&record.identity)
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    Ok(deterministic_token(
+        "permit",
+        &identity_hash,
+        &record.revision.to_string(),
+    ))
+}
+
+fn deterministic_token(prefix: &str, identity: &str, stage: &str) -> String {
+    let mut hasher = Sha256::new();
+    update_length_prefixed(&mut hasher, identity.as_bytes());
+    update_length_prefixed(&mut hasher, stage.as_bytes());
+    format!("{prefix}-{}", lower_hex(&hasher.finalize()))
+}
+
+fn observation_shard(permit_token: &str, shard_count: usize) -> usize {
+    let hash_prefix = permit_token
+        .strip_prefix("permit-")
+        .and_then(|hash| hash.get(..16))
+        .and_then(|prefix| u64::from_str_radix(prefix, 16).ok())
+        .unwrap_or(0);
+    (hash_prefix as usize) % shard_count
+}
+
+fn effect_binding_key(
+    transaction_key: &TransactionKey,
+    message: &SipMessage,
+) -> Result<String, SipEffectGateError> {
+    let transaction_key = transaction_key.to_string();
+    let (kind, code, target, call_id, cseq, from, to, body) = match message {
+        SipMessage::Request(request) => (
+            "request",
+            request.method.to_string(),
+            request.uri.to_string(),
+            request
+                .call_id_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            request
+                .cseq_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            request
+                .from_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            request
+                .to_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            request.body.as_slice(),
+        ),
+        SipMessage::Response(response) => (
+            "response",
+            response.status_code.code().to_string(),
+            String::new(),
+            response
+                .call_id_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            response
+                .cseq_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            response
+                .from_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            response
+                .to_header()
+                .map_err(|_| SipEffectGateError::InvalidIntent)?
+                .value(),
+            response.body.as_slice(),
+        ),
+    };
+    let mut hasher = Sha256::new();
+    update_length_prefixed(&mut hasher, transaction_key.as_bytes());
+    update_length_prefixed(&mut hasher, kind.as_bytes());
+    update_length_prefixed(&mut hasher, code.as_bytes());
+    update_length_prefixed(&mut hasher, target.as_bytes());
+    update_length_prefixed(&mut hasher, call_id.as_bytes());
+    update_length_prefixed(&mut hasher, cseq.as_bytes());
+    update_length_prefixed(&mut hasher, from.as_bytes());
+    update_length_prefixed(&mut hasher, to.as_bytes());
+    update_length_prefixed(&mut hasher, body);
+    Ok(lower_hex(&hasher.finalize()))
+}
+
+fn update_length_prefixed(hasher: &mut Sha256, value: &[u8]) {
+    hasher.update((value.len() as u64).to_be_bytes());
+    hasher.update(value);
+}
+
+fn lower_hex(value: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut encoded = String::with_capacity(value.len() * 2);
+    for byte in value {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
+
+fn is_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
