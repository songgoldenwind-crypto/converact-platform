+    #[async_trait]
+    impl SipEffectStorePort for InMemoryWriter {
+        async fn prepare(
+            &self,
+            effect: PreparedSipEffect,
+        ) -> Result<SipEffectPrepareOutcome, SipEffectStoreError> {
+            self.prepared.lock().unwrap().push(effect.clone());
+            self.ledger
+                .lock()
+                .await
+                .prepare(effect)
+                .map_err(SipEffectStoreError::from)
+        }
+
+        async fn apply(
+            &self,
+            receipt: SipEffectReceipt,
+        ) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+            self.apply_calls.fetch_add(1, Ordering::SeqCst);
+            let fail_after_commit = receipt.level == SipEffectReceiptLevel::SendAttempted
+                && self
+                    .fail_send_attempt_after_commit
+                    .swap(false, Ordering::SeqCst);
+            let outcome = self
+                .ledger
+                .lock()
+                .await
+                .apply(receipt)
+                .map_err(SipEffectStoreError::from)?;
+            if fail_after_commit {
+                return Err(SipEffectStoreError::StoreUnavailable);
+            }
+            Ok(outcome)
+        }
+    }
