+
+const INTENT_CAPACITY_HARD_CEILING: usize = 1_000_000;
+const PENDING_OBSERVATION_HARD_CEILING: usize = 1_000_000;
+const OBSERVATION_QUEUE_HARD_CEILING: usize = 65_536;
+const OBSERVATION_SHARDS_HARD_CEILING: usize = 256;
+const UNKNOWN_REPAIR_AFTER_MS_HARD_CEILING: u32 = 86_400_000;
+const RESERVED_WIRE_FACT_KEYS: [&str; 2] = ["destination", "transaction_binding_sha256"];
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum SipEffectGateError {
+    #[error("durable SIP effect gate configuration is invalid")]
+    InvalidConfiguration,
+    #[error("durable SIP effect intent is invalid")]
+    InvalidIntent,
+    #[error("durable SIP effect intent capacity is exhausted")]
+    IntentCapacityExhausted,
+    #[error("durable SIP effect intent conflicts with an existing registration")]
+    IntentConflict,
+    #[error("durable SIP effect intent is not registered")]
+    IntentMissing,
+    #[error("durable SIP effect intent is already being committed")]
+    IntentBusy,
+    #[error("durable SIP effect intent owner was released")]
+    IntentReleased,
+    #[error("durable SIP effect observation capacity is exhausted")]
+    ObservationCapacityExhausted,
+    #[error("durable SIP effect state is ambiguous and requires reconciliation")]
+    ReconciliationRequired,
+    #[error("durable SIP effect store is unavailable")]
+    StoreUnavailable,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectGateOptions {
+    pub max_pending_observations: usize,
+    pub observation_queue_capacity: usize,
+    pub observation_worker_shards: usize,
+    pub unknown_repair_after_ms: u32,
+}
+
+impl Default for SipEffectGateOptions {
+    fn default() -> Self {
+        Self {
+            max_pending_observations: 1_024,
+            observation_queue_capacity: 1_024,
+            observation_worker_shards: 16,
+            unknown_repair_after_ms: 1_000,
+        }
+    }
+}
+
+impl SipEffectGateOptions {
+    fn validate(self) -> Result<Self, SipEffectGateError> {
+        if self.max_pending_observations == 0
+            || self.max_pending_observations > PENDING_OBSERVATION_HARD_CEILING
+            || self.observation_queue_capacity == 0
+            || self.observation_queue_capacity > OBSERVATION_QUEUE_HARD_CEILING
+            || self.observation_worker_shards == 0
+            || self.observation_worker_shards > OBSERVATION_SHARDS_HARD_CEILING
+            || self.observation_worker_shards > self.observation_queue_capacity
+            || self.unknown_repair_after_ms == 0
+            || self.unknown_repair_after_ms > UNKNOWN_REPAIR_AFTER_MS_HARD_CEILING
+        {
+            return Err(SipEffectGateError::InvalidConfiguration);
+        }
+        Ok(self)
+    }
+}
