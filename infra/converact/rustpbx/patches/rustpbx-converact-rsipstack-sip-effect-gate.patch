+        let registry = Arc::new(SipEffectIntentRegistry::try_new(8).unwrap());
+        let writer = Arc::new(InMemoryWriter::new());
+        writer
+            .fail_send_attempt_after_commit
+            .store(true, Ordering::SeqCst);
+        let (gate, _observer) = runtime(
+            registry.clone(),
+            writer.clone(),
+            SipEffectGateOptions::default(),
+        );
+        let (key, message) = invite("call-a@example.test", "z9hG4bK-a");
+        let _lease = registry
+            .register(&key, &message, intent("effect-a", "session-a"))
+            .unwrap();
+        let wire = message.to_bytes();
+        assert!(gate.prepare(&key, &message, None, &wire).await.is_err());
+        assert_eq!(registry.snapshot().registered, 0);
+
+        let _retry_lease = registry
+            .register(&key, &message, intent("effect-a", "session-a"))
+            .unwrap();
+        assert!(gate.prepare(&key, &message, None, &wire).await.is_err());
+        assert_eq!(gate.snapshot().pending_observations, 0);
+        assert_eq!(registry.snapshot().registered, 0);
