+    #[test]
+    fn live_standalone_registration_uses_native_identity_and_admission_authority() {
+        let registry = ActiveProxyCallRegistry::with_limits(4, 16);
+        let session = "standalone-provider-call@example.test";
+        let handle = make_handle(session);
+
+        assert!(
+            registry
+                .register_handle(session.to_string(), handle)
+                .unwrap()
+        );
+        let identity = registry
+            .get_identity(session)
+            .expect("live registration must always resolve one native identity");
+        assert_ne!(identity.call_id().as_str(), session);
+        let admitted = registry
+            .native_call_snapshot(identity.call_id())
+            .unwrap()
+            .expect("live registration must publish one native Call");
+        assert_eq!(admitted.legs.len(), 1);
+        assert_eq!(admitted.legs[0].state, NativeLegState::Planned);
+
+        registry.update(session, |entry| {
+            entry.answered_at = Some(Utc::now());
+            entry.status = ActiveProxyCallStatus::Talking;
+        });
+        let unchanged = registry
+            .native_call_snapshot(identity.call_id())
+            .unwrap()
+            .unwrap();
+        assert_eq!(unchanged.revision, admitted.revision);
+        assert_eq!(unchanged.legs[0].state, NativeLegState::Planned);
+    }
+
