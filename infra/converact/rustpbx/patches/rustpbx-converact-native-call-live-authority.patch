+                make_handle(session),
+                "invalid dialog".to_string(),
+            )
+            .unwrap_err();
+
+        assert_eq!(error, ActiveCallRegistryError::InvalidDialogIdentifier);
+        assert!(registry.get_identity(session).is_none());
+        assert!(registry.is_empty());
+    }
