+fn validate_receipt_replay(
+    row: &PgRow,
+    receipt: &SipEffectReceipt,
+    effect_identity_hash: &str,
+) -> Result<crate::call::domain::sip_effect::SipEffectReceiptSemantic, SipEffectStoreError> {
+    let schema_id: String = schema_field(row, "schema_id")?;
+    let schema_version: i32 = schema_field(row, "schema_version")?;
+    let schema_hash: String = schema_field(row, "schema_hash")?;
+    let writer_identity: String = schema_field(row, "writer_identity")?;
+    if schema_id != SIP_EFFECT_SCHEMA_ID
+        || schema_version != i32::from(SIP_EFFECT_SCHEMA_VERSION)
+        || schema_hash != SIP_EFFECT_SCHEMA_HASH
+        || writer_identity != SIP_EFFECT_WRITER_IDENTITY
+    {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    let stored_level = database_receipt_level(&schema_field::<String>(row, "level")?)?;
+    let from_state = database_state(&schema_field::<String>(row, "from_state")?)?;
+    let stored_delay = schema_field::<Option<i32>>(row, "repair_delay_ms")?
+        .map(positive_or_zero_u32)
+        .transpose()?;
+    if schema_field::<String>(row, "protocol_effect_id")?
+        != receipt.fence.identity.protocol_effect_id
+        || schema_field::<String>(row, "effect_identity_hash")? != effect_identity_hash
+        || schema_field::<String>(row, "receipt_hash")? != receipt.receipt_hash
+        || stored_level != receipt.level
+        || schema_field::<String>(row, "failure_code")? != receipt.failure_code
+        || stored_delay != receipt.repair_delay_ms
+    {
+        return Err(SipEffectError::ReceiptConflict.into());
+    }
+    Ok(classify_receipt(from_state, stored_level)?)
+}
