+        let updated = decode_effect(&updated)?.record;
+        transaction.commit().await.map_err(map_sqlx_error)?;
+        Ok(SipEffectApplyOutcome {
+            record: updated,
+            semantic,
+            replayed: false,
+        })
+    }
