+        successor_owner_epoch: request.successor_owner_epoch,
+        successor_generation: request.successor_generation,
+        successor_revision: request.successor_revision,
+        predecessor_effect_ids,
+        request_sha256: request_sha256.into_boxed_str(),
+    })
+}
+
+fn effect_session_fence_matches(
+    stored_owner_epoch: u64,
+    stored_generation: u64,
+    expected_owner_epoch: u64,
+    expected_generation: &str,
+) -> Result<bool, SipEffectStoreError> {
+    let expected_generation = canonical_u64(expected_generation, true)?;
+    Ok(stored_owner_epoch == expected_owner_epoch && stored_generation == expected_generation)
+}
+
+fn capability_recovery_state_is_visible_or_ambiguous(state: SipEffectState) -> bool {
+    !matches!(
+        state,
+        SipEffectState::Prepared | SipEffectState::DurableDecision
+    )
+}
+
+fn capability_recovery_receipt_sha256(
+    request: &FrozenSipCapabilityRecoveryFenceRequest,
+    outcome: &str,
+) -> Result<String, SipEffectStoreError> {
+    if !matches!(outcome, "no_visible_effect" | "visible_or_ambiguous") {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    canonical_json_sha256(&serde_json::json!({
+        "schema_id": "converact.sip-capability-recovery-receipt",
+        "schema_version": "1.0.0",
+        "recovery_request_sha256": request.request_sha256.as_ref(),
+        "tenant_id": request.tenant_id.as_ref(),
+        "protocol_session_id": request.protocol_session_id.as_ref(),
+        "provider_call_id": request.provider_call_id.as_ref(),
+        "predecessor_binding_sha256": request.predecessor_binding_sha256.as_ref(),
+        "transaction_key_sha256": request.transaction_key_sha256.as_ref(),
+        "previous_owner_epoch": request.previous_owner_epoch.to_string(),
+        "previous_generation": request.previous_generation.to_string(),
+        "previous_revision": request.previous_revision.to_string(),
+        "successor_owner_epoch": request.successor_owner_epoch.to_string(),
+        "successor_generation": request.successor_generation.to_string(),
+        "successor_revision": request.successor_revision.to_string(),
+        "predecessor_effect_ids": &request.predecessor_effect_ids,
+        "outcome": outcome,
+    }))
+    .map_err(Into::into)
+}
+
+fn capability_recovery_outcome(
+    outcome: &str,
+    receipt_sha256: &str,
+) -> Result<SipCapabilityRecoveryFenceOutcome, SipEffectStoreError> {
+    if !is_sha256_lower_hex(receipt_sha256) {
+        return Err(SipEffectStoreError::SchemaIncompatible);
+    }
+    match outcome {
+        "no_visible_effect" => Ok(SipCapabilityRecoveryFenceOutcome::NoVisibleEffect {
+            successor_fence_receipt_sha256: receipt_sha256.into(),
+        }),
+        "visible_or_ambiguous" => Ok(SipCapabilityRecoveryFenceOutcome::VisibleOrAmbiguous),
+        _ => Err(SipEffectStoreError::SchemaIncompatible),
+    }
+}
+
+async fn select_capability_recovery_receipt(
+    transaction: &mut Transaction<'_, Postgres>,
+    request: &FrozenSipCapabilityRecoveryFenceRequest,
+) -> Result<Option<PgRow>, SipEffectStoreError> {
+    sqlx::query(CAPABILITY_RECOVERY_RECEIPT_SELECT_SQL)
+        .bind(request.tenant_id.as_ref())
+        .bind(request.request_sha256.as_ref())
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)
+}
+
+fn decode_capability_recovery_receipt(
+    row: &PgRow,
+    request: &FrozenSipCapabilityRecoveryFenceRequest,
+) -> Result<SipCapabilityRecoveryFenceOutcome, SipEffectStoreError> {
+    let outcome: String = schema_field(row, "outcome")?;
+    let receipt_sha256: String = schema_field(row, "successor_fence_receipt_sha256")?;
+    let stored_effect_ids = [
+        schema_field::<String>(row, "cancel_ok_effect_id")?,
+        schema_field::<String>(row, "invite_terminated_effect_id")?,
+    ];
+    let stored_matches = schema_field::<String>(row, "tenant_id")? == request.tenant_id.as_ref()
+        && schema_field::<String>(row, "protocol_session_id")?
+            == request.protocol_session_id.as_ref()
+        && schema_field::<String>(row, "provider_call_id")? == request.provider_call_id.as_ref()
+        && schema_field::<String>(row, "predecessor_binding_sha256")?
+            == request.predecessor_binding_sha256.as_ref()
+        && schema_field::<String>(row, "transaction_key_sha256")?
+            == request.transaction_key_sha256.as_ref()
+        && canonical_u64(&schema_field::<String>(row, "previous_owner_epoch")?, true)?
+            == request.previous_owner_epoch
+        && canonical_u64(&schema_field::<String>(row, "previous_generation")?, true)?
+            == request.previous_generation
+        && canonical_u64(&schema_field::<String>(row, "previous_revision")?, true)?
+            == request.previous_revision
+        && canonical_u64(&schema_field::<String>(row, "successor_owner_epoch")?, true)?
+            == request.successor_owner_epoch
+        && canonical_u64(&schema_field::<String>(row, "successor_generation")?, true)?
+            == request.successor_generation
+        && canonical_u64(&schema_field::<String>(row, "successor_revision")?, true)?
+            == request.successor_revision
+        && stored_effect_ids == request.predecessor_effect_ids;
+    let expected_receipt_sha256 = capability_recovery_receipt_sha256(request, &outcome)?;
+    if !stored_matches || receipt_sha256 != expected_receipt_sha256 {
+        return Err(SipEffectError::ReceiptConflict.into());
+    }
+    capability_recovery_outcome(&outcome, &receipt_sha256)
+}
+
+fn is_sha256_lower_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
