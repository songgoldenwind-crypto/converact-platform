+            let effect_id: String = schema_field(row, "protocol_effect_id")?;
+            let session_id: String = schema_field(row, "protocol_session_id")?;
+            let owner_epoch = canonical_u64(&schema_field::<String>(row, "owner_epoch")?, true)?;
