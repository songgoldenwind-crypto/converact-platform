+    async fn fence_predecessor_and_probe_capabilities_inner(
+        &self,
+        request: SipCapabilityRecoveryFenceRequest<'_>,
+    ) -> Result<SipCapabilityRecoveryFenceOutcome, SipEffectStoreError> {
+        let request = freeze_capability_recovery_request(&request)?;
+        let (_admission, mut transaction) =
+            self.begin_tenant_transaction(&request.tenant_id).await?;
+        seed_effect_session_fence(
+            &mut transaction,
+            &request.tenant_id,
+            &request.protocol_session_id,
+            request.previous_owner_epoch,
+            request.previous_generation,
+        )
+        .await?;
+        let fence = lock_effect_session_fence(
+            &mut transaction,
+            &request.tenant_id,
+            &request.protocol_session_id,
+        )
+        .await?;
+
+        if let Some(row) = select_capability_recovery_receipt(&mut transaction, &request).await? {
+            if !capability_recovery_replay_fence_matches(
+                fence,
+                request.successor_owner_epoch,
+                request.successor_generation,
+                request.successor_revision,
+            ) {
+                return Err(SipEffectError::FenceLost.into());
+            }
+            let replay = decode_capability_recovery_receipt(&row, &request)?;
+            transaction.commit().await.map_err(map_sqlx_error)?;
+            return Ok(replay);
+        }
+        if fence.owner_epoch != request.previous_owner_epoch
+            || fence.generation != request.previous_generation
+            || fence
+                .revision
+                .is_some_and(|value| value != request.previous_revision)
+        {
+            return Err(SipEffectError::FenceLost.into());
+        }
+
+        let effect_rows = sqlx::query(CAPABILITY_RECOVERY_EFFECT_VISIBILITY_SQL)
+            .bind(request.tenant_id.as_ref())
+            .bind(&request.predecessor_effect_ids[..])
+            .fetch_all(&mut *transaction)
+            .await
+            .map_err(map_sqlx_error)?;
