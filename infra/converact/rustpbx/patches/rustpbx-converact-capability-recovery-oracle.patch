+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct EffectSessionFence {
+    owner_epoch: u64,
+    generation: u64,
+    revision: Option<u64>,
+}
+
+fn capability_recovery_replay_fence_matches(
+    fence: EffectSessionFence,
+    successor_owner_epoch: u64,
+    successor_generation: u64,
+    successor_revision: u64,
+) -> bool {
+    fence.owner_epoch == successor_owner_epoch
+        && fence.generation == successor_generation
+        && fence.revision == Some(successor_revision)
+}
+
+async fn ensure_effect_session_fence_locked(
+    transaction: &mut Transaction<'_, Postgres>,
+    identity: &crate::call::domain::sip_effect::SipEffectIdentity,
+) -> Result<(), SipEffectStoreError> {
+    let generation = canonical_u64(&identity.protocol_session_generation, true)?;
+    seed_effect_session_fence(
+        transaction,
+        &identity.tenant_id,
+        &identity.protocol_session_id,
+        identity.owner_epoch,
+        generation,
+    )
+    .await?;
+    let fence = lock_effect_session_fence(
+        transaction,
+        &identity.tenant_id,
+        &identity.protocol_session_id,
+    )
+    .await?;
+    if !effect_session_fence_matches(
+        fence.owner_epoch,
+        fence.generation,
+        identity.owner_epoch,
+        &identity.protocol_session_generation,
+    )? {
+        return Err(SipEffectError::FenceLost.into());
+    }
+    Ok(())
+}
+
+async fn seed_effect_session_fence(
+    transaction: &mut Transaction<'_, Postgres>,
+    tenant_id: &str,
+    protocol_session_id: &str,
+    owner_epoch: u64,
+    generation: u64,
+) -> Result<(), SipEffectStoreError> {
+    if owner_epoch == 0 || generation == 0 {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    sqlx::query(SIP_EFFECT_SESSION_FENCE_SEED_SQL)
+        .bind(tenant_id)
+        .bind(protocol_session_id)
+        .bind(owner_epoch.to_string())
+        .bind(generation.to_string())
+        .execute(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?;
+    Ok(())
+}
+
+async fn lock_effect_session_fence(
+    transaction: &mut Transaction<'_, Postgres>,
+    tenant_id: &str,
+    protocol_session_id: &str,
+) -> Result<EffectSessionFence, SipEffectStoreError> {
+    let row = sqlx::query(SIP_EFFECT_SESSION_FENCE_LOCK_SQL)
+        .bind(tenant_id)
+        .bind(protocol_session_id)
+        .fetch_optional(&mut **transaction)
+        .await
+        .map_err(map_sqlx_error)?
+        .ok_or(SipEffectStoreError::SchemaIncompatible)?;
+    decode_effect_session_fence(&row)
+}
+
+fn decode_effect_session_fence(row: &PgRow) -> Result<EffectSessionFence, SipEffectStoreError> {
+    Ok(EffectSessionFence {
+        owner_epoch: canonical_u64(
+            &schema_field::<String>(row, "owner_epoch_high_watermark")?,
+            true,
+        )?,
+        generation: canonical_u64(
+            &schema_field::<String>(row, "generation_high_watermark")?,
+            true,
+        )?,
+        revision: schema_field::<Option<String>>(row, "revision_high_watermark")?
+            .map(|value| canonical_u64(&value, true))
+            .transpose()?,
+    })
+}
