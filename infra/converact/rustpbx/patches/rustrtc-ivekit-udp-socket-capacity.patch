+#[tokio::test]
+async fn configured_udp_buffers_are_applied_to_rtp_sockets() -> Result<()> {
+    let requested = 512 * 1024;
+    let config = RtcConfiguration {
+        udp_receive_buffer_size: Some(requested),
+        udp_send_buffer_size: Some(requested),
+        ..Default::default()
+    };
+    let socket = super::bind_configured_udp_socket(&config, "127.0.0.1:0".parse().unwrap())?;
+    let socket = socket2::SockRef::from(&socket);
+
+    assert!(socket.recv_buffer_size()? >= requested);
+    assert!(socket.send_buffer_size()? >= requested);
+    Ok(())
+}
