+#[derive(Clone, Copy)]
+struct UdpSocketBufferSizes {
+    receive: Option<usize>,
+    send: Option<usize>,
+}
+
+fn udp_socket_buffer_sizes(config: &RtcConfiguration) -> Result<UdpSocketBufferSizes> {
+    Ok(UdpSocketBufferSizes {
+        receive: configured_udp_socket_buffer(
+            config.udp_receive_buffer_size,
+            "RUSTRTC_UDP_RECEIVE_BUFFER_BYTES",
+            &UDP_RECEIVE_BUFFER_FROM_ENV,
+        )?,
+        send: configured_udp_socket_buffer(
+            config.udp_send_buffer_size,
+            "RUSTRTC_UDP_SEND_BUFFER_BYTES",
+            &UDP_SEND_BUFFER_FROM_ENV,
+        )?,
+    })
+}
+
+fn configured_udp_socket_buffer(
+    configured: Option<usize>,
+    environment_name: &'static str,
+    cache: &'static OnceLock<std::result::Result<Option<usize>, String>>,
+) -> Result<Option<usize>> {
+    let value = match configured {
+        Some(value) => Some(value),
+        None => cache
+            .get_or_init(|| {
+                let raw = match std::env::var(environment_name) {
+                    Ok(value) => value,
+                    Err(std::env::VarError::NotPresent) => return Ok(None),
+                    Err(error) => return Err(format!("{environment_name}: {error}")),
+                };
+                raw.parse::<usize>()
+                    .map(Some)
+                    .map_err(|_| format!("{environment_name} must be an integer"))
+            })
+            .clone()
+            .map_err(|error| anyhow!(error))?,
+    };
+    if let Some(value) = value
+        && !(MIN_UDP_SOCKET_BUFFER_BYTES..=MAX_UDP_SOCKET_BUFFER_BYTES).contains(&value)
+    {
+        bail!(
+            "{environment_name} must be between {} and {} bytes",
+            MIN_UDP_SOCKET_BUFFER_BYTES,
+            MAX_UDP_SOCKET_BUFFER_BYTES
+        );
+    }
+    Ok(value)
+}
+
+fn bind_configured_udp_socket(config: &RtcConfiguration, address: SocketAddr) -> Result<UdpSocket> {
+    let buffers = udp_socket_buffer_sizes(config)?;
+    let socket = Socket::new(
+        Domain::for_address(address),
+        Type::DGRAM,
+        Some(Protocol::UDP),
+    )?;
+    socket.set_nonblocking(true)?;
+    if let Some(bytes) = buffers.receive {
+        socket.set_recv_buffer_size(bytes)?;
+    }
+    if let Some(bytes) = buffers.send {
+        socket.set_send_buffer_size(bytes)?;
+    }
+    socket.bind(&address.into())?;
+    UdpSocket::from_std(socket.into()).map_err(Into::into)
+}
