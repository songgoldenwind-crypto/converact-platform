+const MAX_UDP_SOCKET_BUFFER_BYTES: usize = 16 * 1024 * 1024;
+static UDP_RECEIVE_BUFFER_FROM_ENV: OnceLock<std::result::Result<Option<usize>, String>> =
+    OnceLock::new();
