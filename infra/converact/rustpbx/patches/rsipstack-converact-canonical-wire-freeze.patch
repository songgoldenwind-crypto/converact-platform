+#[tokio::test]
+async fn client_cancel_retry_reuses_the_frozen_wire_image() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        fail_on_prepare_call: Some(2),
+        messages: Mutex::new(Vec::new()),
+        canonical_wire_images: Mutex::new(Vec::new()),
+        outcomes: Mutex::new(Vec::new()),
+    });
+    let inspector_calls = Arc::new(AtomicUsize::new(0));
+    let (mut transaction, peer) = udp_client_transaction_with_effect_gate_and_inspector(
+        gate.clone(),
+        Some(Box::new(CountingRequestInspector {
+            calls: inspector_calls.clone(),
+        })),
+    )
+    .await;
+    transaction.send().await.expect("send INVITE");
+    let _invite = recv_udp_bytes(&peer).await;
+    let mut cancel = transaction.original.clone();
+    cancel.method = crate::sip::Method::Cancel;
+    cancel.headers.unique_push(CSeq::new("1 CANCEL").into());
+
+    assert!(transaction.send_cancel(cancel.clone()).await.is_err());
+    let mut buffer = [0_u8; 2048];
+    assert!(
+        timeout(Duration::from_millis(25), peer.recv_raw(&mut buffer))
+            .await
+            .is_err(),
+        "failed prepare must emit no CANCEL bytes"
+    );
+    transaction
+        .send_cancel(cancel)
+        .await
+        .expect("retry frozen CANCEL");
+    let cancel_wire = recv_udp_bytes(&peer).await;
+    assert!(matches!(
+        SipMessage::try_from(cancel_wire.as_slice()).expect("valid CANCEL"),
+        SipMessage::Request(request) if request.method == crate::sip::Method::Cancel
+    ));
+
+    let wire_images = gate.canonical_wire_images.lock().expect("wire image lock");
+    assert_eq!(wire_images[1], wire_images[2]);
+    assert_eq!(inspector_calls.load(Ordering::SeqCst), 2);
+}
