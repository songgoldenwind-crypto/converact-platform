+        SipMessage::Request(request) if request.method == crate::sip::Method::Invite
+    ));
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Received(
+            busy_response().into(),
+            transaction.connection.clone().expect("client connection"),
+        ))
+        .expect("final response event");
+
+    assert!(matches!(
+        transaction.receive().await,
+        Some(SipMessage::Response(response))
+            if response.status_code == crate::sip::StatusCode::BusyHere
+    ));
+    assert!(matches!(
+        recv_udp_message(&peer).await,
+        SipMessage::Request(request) if request.method == crate::sip::Method::Ack
+    ));
+    assert_eq!(transaction.state, TransactionState::Terminated);
+    assert_eq!(gate.ordinary_ack_prepares.load(Ordering::SeqCst), 0);
+    assert_eq!(gate.derived_ack_prepares.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.observations
+            .lock()
+            .expect("protocol observation lock")
+            .as_slice(),
+        [
+            (
+                "client-parent-invite".to_string(),
+                EgressEffectProtocolObservation::Completed,
+            ),
+            (
+                "client-derived-ack".to_string(),
+                EgressEffectProtocolObservation::TransportTerminal,
+            )
