+/// Ensures a real peer observation is published even if preparing or sending
+/// its protocol-mandated child effect is cancelled.
+struct EgressProtocolObservationAttempt {
+    gate: Option<Arc<dyn EgressEffectGate>>,
+    permit: Option<EgressEffectPermit>,
+    observation: EgressEffectProtocolObservation,
+}
+
+impl EgressProtocolObservationAttempt {
+    fn new(
+        gate: Option<Arc<dyn EgressEffectGate>>,
+        permit: Option<EgressEffectPermit>,
+        observation: EgressEffectProtocolObservation,
+    ) -> Self {
+        Self {
+            gate,
+            permit,
+            observation,
+        }
+    }
+
+    fn permit(&self) -> Option<&EgressEffectPermit> {
+        self.permit.as_ref()
+    }
+
+    fn observe(mut self) {
+        if let (Some(gate), Some(permit)) = (self.gate.as_ref(), self.permit.take()) {
+            gate.observe_protocol(permit, self.observation);
+        }
+    }
+}
+
+impl Drop for EgressProtocolObservationAttempt {
+    fn drop(&mut self) {
+        if let (Some(gate), Some(permit)) = (self.gate.as_ref(), self.permit.take()) {
+            gate.observe_protocol(permit, self.observation);
+        }
+    }
+}
