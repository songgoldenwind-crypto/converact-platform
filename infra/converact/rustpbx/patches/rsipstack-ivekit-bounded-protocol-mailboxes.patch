diff --git a/src/bounded.rs b/src/bounded.rs
new file mode 100644
index 0000000..e277e48
--- /dev/null
+++ b/src/bounded.rs
@@ -0,0 +1,197 @@
+use std::sync::atomic::{AtomicU64, Ordering};
+use tokio::sync::mpsc;
+
+pub const TRANSACTION_EVENT_QUEUE_CAPACITY: usize = 8;
+pub const DIALOG_STATE_QUEUE_CAPACITY: usize = 16;
+pub const TRANSPORT_EVENT_QUEUE_CAPACITY: usize = 8_192;
+pub const TRANSPORT_CONNECTION_EVENT_QUEUE_CAPACITY: usize = 256;
+
+#[derive(Debug)]
+pub(crate) struct MailboxRejections {
+    full: AtomicU64,
+    closed: AtomicU64,
+}
+
+impl MailboxRejections {
+    const fn new() -> Self {
+        Self {
+            full: AtomicU64::new(0),
+            closed: AtomicU64::new(0),
+        }
+    }
+
+    fn record<T>(&self, error: &mpsc::error::TrySendError<T>) {
+        match error {
+            mpsc::error::TrySendError::Full(_) => {
+                self.full.fetch_add(1, Ordering::Relaxed);
+            }
+            mpsc::error::TrySendError::Closed(_) => {
+                self.closed.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    fn snapshot(&self) -> MailboxRejectionStats {
+        MailboxRejectionStats {
+            full_rejections_total: self.full.load(Ordering::Relaxed),
+            closed_rejections_total: self.closed.load(Ordering::Relaxed),
+        }
+    }
+}
+
+static TRANSACTION_EVENT_REJECTIONS: MailboxRejections = MailboxRejections::new();
+static DIALOG_STATE_REJECTIONS: MailboxRejections = MailboxRejections::new();
+static TRANSPORT_EVENT_REJECTIONS: MailboxRejections = MailboxRejections::new();
+
+pub struct BoundedSender<T> {
+    inner: mpsc::Sender<T>,
+    rejections: &'static MailboxRejections,
+}
+
+impl<T> Clone for BoundedSender<T> {
+    fn clone(&self) -> Self {
+        Self {
+            inner: self.inner.clone(),
+            rejections: self.rejections,
+        }
+    }
+}
+
+impl<T> std::fmt::Debug for BoundedSender<T> {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("BoundedSender")
+            .field("capacity", &self.inner.capacity())
+            .field("max_capacity", &self.inner.max_capacity())
+            .field("closed", &self.inner.is_closed())
+            .finish()
+    }
+}
+
+impl<T> BoundedSender<T> {
+    pub fn send(&self, value: T) -> Result<(), mpsc::error::TrySendError<T>> {
+        self.try_send(value)
+    }
+
+    pub fn try_send(&self, value: T) -> Result<(), mpsc::error::TrySendError<T>> {
+        self.inner.try_send(value).inspect_err(|error| {
+            self.rejections.record(error);
+        })
+    }
+
+    pub fn capacity(&self) -> usize {
+        self.inner.capacity()
+    }
+
+    pub fn max_capacity(&self) -> usize {
+        self.inner.max_capacity()
+    }
+
+    pub fn is_closed(&self) -> bool {
+        self.inner.is_closed()
+    }
+}
+
+pub type BoundedReceiver<T> = mpsc::Receiver<T>;
+
+fn bounded_channel<T>(
+    capacity: usize,
+    rejections: &'static MailboxRejections,
+) -> (BoundedSender<T>, BoundedReceiver<T>) {
+    assert!(capacity > 0, "protocol mailbox capacity must be positive");
+    let (inner, receiver) = mpsc::channel(capacity);
+    (BoundedSender { inner, rejections }, receiver)
+}
+
+pub(crate) fn transaction_event_channel<T>() -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(
+        TRANSACTION_EVENT_QUEUE_CAPACITY,
+        &TRANSACTION_EVENT_REJECTIONS,
+    )
+}
+
+pub(crate) fn dialog_state_channel<T>() -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(DIALOG_STATE_QUEUE_CAPACITY, &DIALOG_STATE_REJECTIONS)
+}
+
+pub(crate) fn transport_event_channel<T>() -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(TRANSPORT_EVENT_QUEUE_CAPACITY, &TRANSPORT_EVENT_REJECTIONS)
+}
+
+pub(crate) fn transport_connection_event_channel<T>() -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(
+        TRANSPORT_CONNECTION_EVENT_QUEUE_CAPACITY,
+        &TRANSPORT_EVENT_REJECTIONS,
+    )
+}
+
+#[cfg(test)]
+static TEST_MAILBOX_REJECTIONS: MailboxRejections = MailboxRejections::new();
+
+#[cfg(test)]
+pub(crate) fn test_channel<T>() -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(64, &TEST_MAILBOX_REJECTIONS)
+}
+
+#[cfg(test)]
+pub(crate) fn test_channel_with_capacity<T>(
+    capacity: usize,
+) -> (BoundedSender<T>, BoundedReceiver<T>) {
+    bounded_channel(capacity, &TEST_MAILBOX_REJECTIONS)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct MailboxRejectionStats {
+    pub full_rejections_total: u64,
+    pub closed_rejections_total: u64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ProtocolMailboxStats {
+    pub transaction_event: MailboxRejectionStats,
+    pub dialog_state: MailboxRejectionStats,
+    pub transport_event: MailboxRejectionStats,
+}
+
+pub fn protocol_mailbox_stats() -> ProtocolMailboxStats {
+    ProtocolMailboxStats {
+        transaction_event: TRANSACTION_EVENT_REJECTIONS.snapshot(),
+        dialog_state: DIALOG_STATE_REJECTIONS.snapshot(),
+        transport_event: TRANSPORT_EVENT_REJECTIONS.snapshot(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    static BOUNDARY_TEST_REJECTIONS: MailboxRejections = MailboxRejections::new();
+
+    #[tokio::test]
+    async fn bounded_sender_rejects_full_and_closed_mailboxes() {
+        let before = BOUNDARY_TEST_REJECTIONS.snapshot();
+        let (sender, mut receiver) = bounded_channel(1, &BOUNDARY_TEST_REJECTIONS);
+
+        assert!(sender.send(1).is_ok());
+        assert!(matches!(
+            sender.send(2),
+            Err(mpsc::error::TrySendError::Full(2))
+        ));
+        assert_eq!(receiver.recv().await, Some(1));
+        drop(receiver);
+        assert!(matches!(
+            sender.send(3),
+            Err(mpsc::error::TrySendError::Closed(3))
+        ));
+
+        let after = BOUNDARY_TEST_REJECTIONS.snapshot();
+        assert_eq!(
+            after.full_rejections_total,
+            before.full_rejections_total + 1
+        );
+        assert_eq!(
+            after.closed_rejections_total,
+            before.closed_rejections_total + 1
+        );
+    }
+}
