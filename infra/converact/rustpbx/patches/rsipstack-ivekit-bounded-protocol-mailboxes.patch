+#[tokio::test]
+async fn test_udp_ingress_survives_a_full_transport_mailbox() -> Result<()> {
+    let receiver = UdpConnection::create_connection("127.0.0.1:0".parse()?, None, None).await?;
+    let sender = UdpConnection::create_connection("127.0.0.1:0".parse()?, None, None).await?;
+    let (event_tx, mut event_rx) = test_channel_with_capacity(1);
+
+    let message = |cseq: usize| {
+        format!(
+            "OPTIONS sip:bob@example.com SIP/2.0\r\n\
+Via: SIP/2.0/UDP 127.0.0.1:5061;branch=z9hG4bK{cseq}\r\n\
+CSeq: {cseq} OPTIONS\r\n\r\n"
+        )
+    };
+
+    let drive = async {
+        sender
+            .send_raw(message(1).as_bytes(), receiver.get_addr())
+            .await?;
+        sleep(Duration::from_millis(20)).await;
+        sender
+            .send_raw(message(2).as_bytes(), receiver.get_addr())
+            .await?;
+        sleep(Duration::from_millis(20)).await;
+
+        let first = event_rx.recv().await.expect("first message must be queued");
+        assert!(matches!(first, TransportEvent::Incoming(_, _, _)));
+
+        sender
+            .send_raw(message(3).as_bytes(), receiver.get_addr())
+            .await?;
+        let third = tokio::time::timeout(Duration::from_millis(200), event_rx.recv())
+            .await
+            .expect("UDP receive loop must continue after shedding one message")
+            .expect("transport mailbox must remain open");
+        assert!(matches!(third, TransportEvent::Incoming(_, _, _)));
+
+        Result::<()>::Ok(())
+    };
+
+    select! {
+        result = receiver.serve_loop(event_tx) => {
+            panic!("shared UDP receive loop exited during mailbox overload: {result:?}");
+        }
+        result = drive => result?,
+        _ = sleep(Duration::from_secs(1)) => {
+            panic!("timed out exercising UDP mailbox overload");
+        }
+    }
+
+    Ok(())
+}
