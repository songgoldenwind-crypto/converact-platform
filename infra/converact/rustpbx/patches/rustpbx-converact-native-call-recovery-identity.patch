+fn canonical_positive_u64(value: &str) -> Result<u64, FoundationIdentityError> {
+    if value.is_empty()
+        || (value.len() > 1 && value.starts_with('0'))
+        || !value.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return Err(FoundationIdentityError::InvalidFence);
+    }
+    value
+        .parse::<u64>()
+        .ok()
+        .filter(|value| *value > 0)
+        .ok_or(FoundationIdentityError::InvalidFence)
+}
