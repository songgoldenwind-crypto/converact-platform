+fn bounded_repair_lease_millis(duration: Duration) -> Result<i32, SipEffectStoreError> {
+    let milliseconds = u32::try_from(duration.as_millis())
+        .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+    if duration.is_zero()
+        || duration > MAX_REPAIR_LEASE
+        || Duration::from_millis(u64::from(milliseconds)) != duration
+    {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    i32::try_from(milliseconds).map_err(|_| SipEffectStoreError::InvalidConfiguration)
+}
