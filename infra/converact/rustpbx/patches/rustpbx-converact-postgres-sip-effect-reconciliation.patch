+    pub async fn reconcile(
+        &self,
+        identity: &crate::call::domain::sip_effect::SipEffectIdentity,
+        repair_fence: &SipEffectRepairFence,
+        receipt_id: &str,
+        outcome: SipEffectReconcileOutcome,
+    ) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+        repair_fence.validate()?;
+        let record = self
+            .query(identity)
+            .await?
+            .ok_or(SipEffectError::IdentityConflict)?;
+        if record.state != SipEffectState::Unknown
+            || record.repair_claim.as_ref() != Some(repair_fence)
+            || record.revision != repair_fence.repair_claim_revision
+        {
+            return Err(SipEffectError::FenceLost.into());
+        }
+        let (level, failure_code, repair_delay_ms) = match outcome {
+            SipEffectReconcileOutcome::ProtocolObserved => {
+                (SipEffectReceiptLevel::ProtocolObserved, "", None)
+            }
+            SipEffectReconcileOutcome::Failed => {
+                (SipEffectReceiptLevel::Failed, "reconciliation_failed", None)
+            }
+            SipEffectReconcileOutcome::Unknown { repair_after_ms } => {
+                (SipEffectReceiptLevel::Unknown, "", Some(repair_after_ms))
+            }
+        };
+        let receipt = SipEffectReceipt::new(
+            record.fence(),
+            receipt_id,
+            level,
+            failure_code,
+            repair_delay_ms,
+        )?
+        .with_repair_fence(repair_fence.clone())?;
+        self.apply(receipt).await
+    }
