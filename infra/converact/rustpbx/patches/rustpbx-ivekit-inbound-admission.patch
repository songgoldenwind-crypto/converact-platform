+
+fn snapshot_admission_config_from_env() -> Option<HttpSnapshotAdmissionConfig> {
+    let url = std::env::var("IVEKIT_RUSTPBX_INBOUND_ADMISSION_URL")
+        .ok()
+        .filter(|value| !value.trim().is_empty())?;
+    let parsed = reqwest::Url::parse(&url).ok()?;
+    if !matches!(parsed.scheme(), "http" | "https")
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || !parsed.path().ends_with("/inbound-admission")
+    {
+        return None;
+    }
+    let service_key =
+        std::env::var("IVEKIT_RUSTPBX_INBOUND_ADMISSION_SERVICE_KEY").ok()?;
+    if service_key.len() < 16
+        || service_key.len() > 512
+        || service_key.bytes().any(|byte| byte.is_ascii_control())
+    {
+        return None;
+    }
+    let cell_id = std::env::var("IVEKIT_RUSTPBX_CELL_ID").ok()?;
+    let owner_node_id = std::env::var("IVEKIT_RUSTPBX_OWNER_NODE_ID").ok()?;
+    if !valid_snapshot_identifier(&cell_id) || !valid_snapshot_identifier(&owner_node_id) {
+        return None;
+    }
+    let timeout_ms = std::env::var("IVEKIT_RUSTPBX_INBOUND_ADMISSION_TIMEOUT_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(250)
+        .clamp(20, 2_000);
+    Some(HttpSnapshotAdmissionConfig {
+        url,
+        service_key,
+        cell_id,
+        owner_node_id,
+        timeout_ms,
+    })
+}
