+    async fn admit_snapshot_call(
+        &self,
+        call_id: &str,
+        destination: &str,
+        caller: &SipUser,
+    ) -> Result<(), RouteError> {
+        let config = self.snapshot_admission.as_ref().ok_or_else(|| RouteError {
+            error: anyhow!("snapshot inbound admission is not configured"),
+            status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+            extensions: None,
+        })?;
+        let from = caller
+            .from
+            .as_ref()
+            .map(ToString::to_string)
+            .unwrap_or_else(|| "sip:anonymous@invalid.local".to_string());
+        let payload = HttpSnapshotAdmissionPayload {
+            call_id,
+            from: &from,
+            to: destination,
+            source_addr: "rustpbx-snapshot",
+            direction: "inbound",
+            method: "INVITE",
+            uri: destination,
+            ivekit_cell_id: &config.cell_id,
+            ivekit_owner_node_id: &config.owner_node_id,
+        };
+        let request = self
+            .client
+            .post(&config.url)
+            .header("x-pbx-key", &config.service_key)
+            .json(&payload)
+            .send();
+        let response = tokio::time::timeout(
+            Duration::from_millis(config.timeout_ms),
+            request,
+        )
+        .await
+        .map_err(|_| RouteError {
+            error: anyhow!("snapshot inbound admission timed out"),
+            status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+            extensions: None,
+        })?
+        .map_err(|error| RouteError {
+            error: anyhow!("snapshot inbound admission failed: {error}"),
+            status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+            extensions: None,
+        })?;
+        let status = response.status();
+        if !status.is_success() {
+            warn!(%call_id, %status, "snapshot inbound admission rejected");
+            return Err(RouteError {
+                error: anyhow!("snapshot inbound admission rejected"),
+                status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+                extensions: None,
+            });
+        }
+        let admitted = response
+            .json::<HttpSnapshotAdmissionEnvelope>()
+            .await
+            .map_err(|_| RouteError {
+                error: anyhow!("snapshot inbound admission response is invalid"),
+                status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+                extensions: None,
+            })?;
+        if !admitted.data.accepted {
+            return Err(RouteError {
+                error: anyhow!("snapshot inbound admission rejected"),
+                status: Some(rsipstack::sip::StatusCode::ServiceUnavailable),
+                extensions: None,
+            });
+        }
+        Ok(())
+    }
 }
 
