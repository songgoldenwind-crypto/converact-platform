+#[tokio::test]
+async fn test_reject_with_headers_preserves_retry_after_and_reason() -> crate::Result<()> {
+    let dialog_id = DialogId {
+        call_id: "test-call-id-retry-after".to_string(),
+        local_tag: "bob-tag-789".to_string(),
+        remote_tag: "alice-tag-456".to_string(),
+    };
+    let endpoint = create_test_endpoint().await?;
+    let (tu_sender, mut tu_receiver) = unbounded_channel();
+    let (state_sender, _state_receiver) = unbounded_channel();
+    let invite_req = create_invite_request(&dialog_id.remote_tag, "", "test-call-id-retry-after");
+    let dialog_inner = DialogInner::new(
+        TransactionRole::Server,
+        dialog_id,
+        invite_req,
+        endpoint.inner.clone(),
+        state_sender,
+        None,
+        None,
+        tu_sender,
+    )
+    .expect("Failed to create dialog inner");
+    let server_dialog = ServerInviteDialog {
+        inner: Arc::new(dialog_inner),
+    };
+
+    server_dialog.reject_with_headers(
+        Some(crate::sip::StatusCode::ServiceUnavailable),
+        Some("Media relay unavailable".to_string()),
+        Some(vec![crate::sip::Header::RetryAfter(
+            crate::sip::headers::RetryAfter::new("1"),
+        )]),
+    )?;
+
+    match tu_receiver
+        .recv()
+        .await
+        .expect("Should receive transaction event")
+    {
+        TransactionEvent::Respond(response) => {
+            assert_eq!(
+                response.status_code,
+                crate::sip::StatusCode::ServiceUnavailable
+            );
+            assert!(response.headers.iter().any(|header| {
+                matches!(header, crate::sip::Header::RetryAfter(value) if value.value() == "1")
+            }));
+            assert!(response.headers.iter().any(|header| {
+                matches!(header, crate::sip::Header::Reason(value)
+                    if value.value() == "Media relay unavailable")
+            }));
+        }
+        _ => panic!("Expected TransactionEvent::Respond"),
+    }
+
+    Ok(())
+}
