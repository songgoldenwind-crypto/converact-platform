+struct CountingRequestInspector {
+    calls: Arc<AtomicUsize>,
+}
+
+impl MessageInspector for CountingRequestInspector {
+    fn before_send(&self, mut message: SipMessage, _destination: Option<&SipAddr>) -> SipMessage {
+        let call = self.calls.fetch_add(1, Ordering::SeqCst) + 1;
+        if let SipMessage::Request(request) = &mut message {
+            request.body = b"payload".to_vec();
+            request
+                .headers
+                .unique_push(ContentLength::from(0_u32).into());
+            request
+                .headers
+                .push(Header::Other("X-Wire-Generation".into(), call.to_string()));
+        }
+        message
+    }
+
+    fn after_received(&self, message: SipMessage, _source: Option<&SipAddr>) -> SipMessage {
+        message
+    }
+}
