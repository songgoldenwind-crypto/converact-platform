+const EGRESS_EFFECT_TOKEN_HARD_CEILING: usize = 256;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct EgressEffectPermit {
+    token: String,
+}
+
+impl EgressEffectPermit {
+    pub fn try_new(token: &str) -> Result<Self> {
+        if token.is_empty()
+            || token.len() > EGRESS_EFFECT_TOKEN_HARD_CEILING
+            || !token.is_ascii()
+            || token
+                .bytes()
+                .any(|byte| byte.is_ascii_control() || byte.is_ascii_whitespace())
+        {
+            return Err(Error::EndpointError(
+                "SIP egress effect permit is invalid".to_string(),
+            ));
+        }
+        Ok(Self {
+            token: token.to_string(),
+        })
+    }
+
+    pub fn token(&self) -> &str {
+        &self.token
+    }
+}
+
