+#[tokio::test]
+async fn client_initial_cancel_and_ack_each_require_one_egress_effect_decision() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        fail_on_prepare_call: None,
+        messages: Mutex::new(Vec::new()),
+        outcomes: Mutex::new(Vec::new()),
+    });
+    let (mut transaction, peer) = udp_client_transaction_with_effect_gate(gate.clone()).await;
+
+    transaction.send().await.expect("send INVITE");
+    assert!(
+        matches!(recv_udp_message(&peer).await, SipMessage::Request(request) if request.method == crate::sip::Method::Invite)
+    );
+
+    let mut cancel = transaction.original.clone();
+    cancel.method = crate::sip::Method::Cancel;
+    cancel.headers.unique_push(CSeq::new("1 CANCEL").into());
+    transaction.send_cancel(cancel).await.expect("send CANCEL");
+    assert!(
+        matches!(recv_udp_message(&peer).await, SipMessage::Request(request) if request.method == crate::sip::Method::Cancel)
+    );
+
+    transaction.state = TransactionState::Completed;
+    transaction.last_response = Some(busy_response());
+    transaction
+        .send_ack(transaction.connection.clone())
+        .await
+        .expect("send ACK");
+    assert!(
+        matches!(recv_udp_message(&peer).await, SipMessage::Request(request) if request.method == crate::sip::Method::Ack)
+    );
+
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 3);
+    let methods: Vec<_> = gate
+        .messages
+        .lock()
+        .expect("message lock")
+        .iter()
+        .filter_map(|message| match message {
+            SipMessage::Request(request) => Some(request.method.clone()),
+            SipMessage::Response(_) => None,
+        })
+        .collect();
+    assert_eq!(
+        methods,
+        [
+            crate::sip::Method::Invite,
+            crate::sip::Method::Cancel,
+            crate::sip::Method::Ack,
+        ]
+    );
+    assert_eq!(
+        gate.outcomes.lock().expect("outcome lock").as_slice(),
+        [
+            EgressEffectOutcome::TransportAccepted,
+            EgressEffectOutcome::TransportAccepted,
+            EgressEffectOutcome::TransportAccepted,
+        ]
+    );
+}
