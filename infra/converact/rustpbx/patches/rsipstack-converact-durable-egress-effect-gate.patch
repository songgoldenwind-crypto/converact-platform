 use tracing::info;
 
+struct RecordingEgressEffectGate {
+    prepare_calls: AtomicUsize,
+    fail_on_prepare_call: Option<usize>,
+    messages: Mutex<Vec<SipMessage>>,
+    outcomes: Mutex<Vec<EgressEffectOutcome>>,
+}
+
+#[async_trait::async_trait]
+impl EgressEffectGate for RecordingEgressEffectGate {
+    async fn prepare(
+        &self,
+        _transaction_key: &TransactionKey,
+        message: &SipMessage,
+        _destination: Option<&SipAddr>,
+    ) -> crate::Result<EgressEffectPermit> {
+        let call = self.prepare_calls.fetch_add(1, Ordering::SeqCst) + 1;
+        self.messages
+            .lock()
+            .expect("message lock")
+            .push(message.clone());
+        if self.fail_on_prepare_call == Some(call) {
+            return Err(crate::Error::EndpointError(
+                "durable egress decision unavailable".to_string(),
+            ));
+        }
+        EgressEffectPermit::try_new(&format!("client-effect-{call}"))
+    }
+
+    fn observe_transport(&self, _permit: EgressEffectPermit, outcome: EgressEffectOutcome) {
+        self.outcomes.lock().expect("outcome lock").push(outcome);
+    }
+}
