+#[tokio::test]
+async fn client_duplicate_final_retries_ack_after_durable_prepare_recovers() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        fail_on_prepare_call: Some(2),
+        messages: Mutex::new(Vec::new()),
+        outcomes: Mutex::new(Vec::new()),
+    });
+    let (mut transaction, peer) = udp_client_transaction_with_effect_gate(gate.clone()).await;
+
+    transaction.send().await.expect("send INVITE");
+    assert!(matches!(
+        recv_udp_message(&peer).await,
+        SipMessage::Request(request) if request.method == crate::sip::Method::Invite
+    ));
+
+    let final_response = busy_response();
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Received(
+            final_response.clone().into(),
+            transaction.connection.clone(),
+        ))
+        .expect("first final response");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(SipMessage::Response(response)) if response.status_code == crate::sip::StatusCode::BusyHere
+    ));
+    assert_eq!(transaction.state, TransactionState::Completed);
+    let mut buffer = [0_u8; 2048];
+    assert!(
+        timeout(Duration::from_millis(25), peer.recv_raw(&mut buffer))
+            .await
+            .is_err(),
+        "a rejected ACK durable decision must emit no bytes"
+    );
+
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Received(
+            final_response.into(),
+            transaction.connection.clone(),
+        ))
+        .expect("duplicate final response");
+    assert!(matches!(
+        timeout(Duration::from_millis(25), transaction.receive()).await,
+        Ok(None)
+    ));
+    assert!(matches!(
+        recv_udp_message(&peer).await,
+        SipMessage::Request(request) if request.method == crate::sip::Method::Ack
+    ));
+    assert_eq!(transaction.state, TransactionState::Terminated);
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 3);
+    assert_eq!(
+        gate.outcomes.lock().expect("outcome lock").as_slice(),
+        [
+            EgressEffectOutcome::TransportAccepted,
+            EgressEffectOutcome::TransportAccepted,
+        ]
+    );
+}
