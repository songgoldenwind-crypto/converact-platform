+async fn client_timer_retransmission_reuses_frozen_bytes_without_new_effect_decision() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        fail_on_prepare_call: None,
+        messages: Mutex::new(Vec::new()),
+        outcomes: Mutex::new(Vec::new()),
+    });
+    let inspector_calls = Arc::new(AtomicUsize::new(0));
+    let (mut transaction, peer) = udp_client_transaction_with_effect_gate_and_inspector(
+        gate.clone(),
+        Some(Box::new(CountingRequestInspector {
+            calls: inspector_calls.clone(),
+        })),
+    )
+    .await;
+
+    transaction.send().await.expect("initial INVITE");
+    let initial = recv_udp_bytes(&peer).await;
+    assert!(
+        String::from_utf8_lossy(&initial).contains("Content-Length: 7\r\n"),
+        "Content-Length must be finalized after the inspector"
+    );
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Timer(TransactionTimer::TimerA(
+            transaction.key.clone(),
+            Duration::from_millis(10),
+        )))
+        .expect("Timer A event");
+    assert!(
+        timeout(Duration::from_millis(20), transaction.receive())
+            .await
+            .is_err(),
+        "Timer A must not deliver a transaction-user message"
+    );
+    let replay = recv_udp_bytes(&peer).await;
+
+    assert_eq!(replay, initial, "Timer A must replay exact frozen bytes");
+    assert_eq!(inspector_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.prepare_calls.load(Ordering::SeqCst),
+        1,
+        "protocol retransmission must reuse the durable decision"
+    );
+}
