+#[tokio::test]
+async fn initial_2xx_send_failure_does_not_commit_response_and_terminates() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+        reject_prepare: false,
+    });
+    let (_incoming_tx, incoming_rx) = crate::bounded::test_channel();
+    let (outgoing_tx, outgoing_rx) = crate::bounded::test_channel();
+    drop(outgoing_rx);
+    let channel_addr = SipAddr::from(
+        "127.0.0.1:5060"
+            .parse::<std::net::SocketAddr>()
+            .expect("channel address"),
+    );
+    let connection =
+        ChannelConnection::create_connection(incoming_rx, outgoing_tx, channel_addr.clone(), None)
+            .await
+            .expect("channel connection");
+    let endpoint = EndpointBuilder::new()
+        .with_user_agent("rsipstack-test")
+        .with_egress_effect_gate(gate.clone())
+        .build();
+    let request = invite_request("UDP", &channel_addr, "z9hG4bK-2xx-send-failure");
+    let key = crate::transaction::TransactionKey::from_request(
+        &request,
+        crate::transaction::key::TransactionRole::Server,
+    )
+    .expect("transaction key");
+    let mut transaction = crate::transaction::transaction::Transaction::new_server(
+        key,
+        request,
+        endpoint.inner.clone(),
+        Some(connection.into()),
+    );
+
+    assert!(transaction.reply(crate::sip::StatusCode::OK).await.is_err());
+    assert_eq!(transaction.state, TransactionState::Terminated);
+    assert!(transaction.last_response.is_none());
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 1);
+    assert_eq!(
+        gate.outcomes.lock().expect("outcome lock").as_slice(),
+        [EgressEffectOutcome::TransportUnknown]
+    );
+    assert_eq!(
+        transaction
+            .drain_non_2xx_server_invite()
+            .await
+            .expect("typed 2xx transport failure"),
         Some(ServerInviteTermination::TransportError)
     );
 }
