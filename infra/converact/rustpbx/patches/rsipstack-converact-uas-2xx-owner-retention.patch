 #[tokio::test]
+async fn server_invite_2xx_drain_retains_owner_until_deadline() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        canonical_wire_images: std::sync::Mutex::new(Vec::new()),
+        outcomes: std::sync::Mutex::new(Vec::new()),
+        protocol_observations: std::sync::Mutex::new(Vec::new()),
+        reject_prepare: false,
+    });
+    let (mut transaction, peer, _endpoint) = udp_server_transaction_with_effect_gate(gate).await;
+
+    transaction
+        .reply(crate::sip::StatusCode::OK)
+        .await
+        .expect("send 2xx response");
+    let _response = recv_udp_bytes(&peer).await;
+
+    assert!(
+        timeout(Duration::from_millis(20), transaction.drain_server_invite(),)
+            .await
+            .is_err(),
+        "active UAS 2xx ownership must not return before ACK or deadline"
+    );
+
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Timer(
+            TransactionTimer::TimerUas2xxDeadline(transaction.key.clone()),
+        ))
+        .expect("UAS 2xx deadline event");
+    assert_eq!(
+        transaction
+            .drain_server_invite()
+            .await
+            .expect("drain UAS 2xx deadline"),
+        Some(ServerInviteTermination::Uas2xxDeadlineExpired)
+    );
+}
