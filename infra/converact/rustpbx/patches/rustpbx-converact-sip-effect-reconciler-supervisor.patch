+        async fn claim_targets(
+            &self,
+            grant: &SipEffectRepairGrant,
+            execution_lease: Duration,
+        ) -> Result<SipEffectExactRepairBatch, SipEffectStoreError> {
+            self.claim_leases.lock().unwrap().push(execution_lease);
+            self.claim_calls.lock().unwrap().push(ClaimCall {
+                grant_id: grant.grant_id().to_string(),
+                tenant_id: grant.tenant_id().to_string(),
+                protocol_session_id: grant.protocol_session_id().to_string(),
+                protocol_session_generation: grant.protocol_session_generation().to_string(),
+                repair_owner_id: grant.repair_owner_id().to_string(),
+                repair_owner_epoch: grant.repair_owner_epoch(),
+                targets: grant
+                    .targets()
+                    .iter()
+                    .map(|target| {
+                        (
+                            target.protocol_effect_id.clone(),
+                            target.expected_revision,
+                            target.expected_effect_identity_hash.clone(),
+                        )
+                    })
+                    .collect(),
+            });
+            self.claim_started.notify_one();
+            if self.panic_claim_once.swap(false, Ordering::SeqCst) {
+                panic!("injected claim panic");
+            }
+            if self.block_claim.load(Ordering::SeqCst) {
+                self.claim_release.notified().await;
+            }
+            if let Some(error) = self.claim_error.lock().unwrap().take() {
+                return Err(error);
+            }
+            let effect_count = self.effect_count.load(Ordering::SeqCst);
+            let effects = (0..effect_count.min(grant.targets().len()))
+                .map(|index| claimed_record(grant, index))
+                .collect();
+            Ok(SipEffectExactRepairBatch {
+                effects,
+                exhausted_effect_ids: self.exhausted_effect_ids.lock().unwrap().clone(),
+            })
+        }
+
+        async fn reconcile(
+            &self,
+            effect: &SipEffectRecord,
+            repair_fence: &SipEffectRepairFence,
+            _receipt_id: &str,
+            outcome: SipEffectReconcileOutcome,
+        ) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+            self.reconcile_calls.lock().unwrap().push((
+                effect.identity.protocol_effect_id.clone(),
+                repair_fence.repair_owner_epoch,
+                outcome,
+            ));
+            let attempt = self.reconcile_attempts.fetch_add(1, Ordering::SeqCst) + 1;
+            if self.panic_reconcile_at.load(Ordering::SeqCst) == attempt {
+                panic!("injected reconcile panic");
+            }
+            if self.block_reconcile_at.load(Ordering::SeqCst) == attempt {
+                self.reconcile_release.notified().await;
+            }
+            if let Some(result) = self.reconcile_results.lock().unwrap().pop_front() {
+                result?;
+            }
+            let mut record = effect.clone();
+            record.repair_claim = None;
+            record.state = match outcome {
+                SipEffectReconcileOutcome::ProtocolObserved => SipEffectState::ProtocolObserved,
+                SipEffectReconcileOutcome::Failed => SipEffectState::Failed,
+                SipEffectReconcileOutcome::Unknown { .. } => SipEffectState::Unknown,
+            };
+            Ok(SipEffectApplyOutcome {
+                record,
+                semantic: SipEffectReceiptSemantic::StateObserved,
+                replayed: false,
+            })
+        }
+    }
