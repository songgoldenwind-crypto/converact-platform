+#[async_trait]
+pub(crate) trait SipEffectReconcileStorePort: Send + Sync {
+    async fn claim_targets(
+        &self,
+        grant: &SipEffectRepairGrant,
+        execution_lease: Duration,
+    ) -> Result<SipEffectExactRepairBatch, SipEffectStoreError>;
+
+    async fn reconcile(
+        &self,
+        effect: &SipEffectRecord,
+        repair_fence: &SipEffectRepairFence,
+        receipt_id: &str,
+        outcome: SipEffectReconcileOutcome,
+    ) -> Result<SipEffectApplyOutcome, SipEffectStoreError>;
+}
+
+#[async_trait]
+impl SipEffectReconcileStorePort for PostgresSipEffectStore {
+    async fn claim_targets(
+        &self,
+        grant: &SipEffectRepairGrant,
+        execution_lease: Duration,
+    ) -> Result<SipEffectExactRepairBatch, SipEffectStoreError> {
+        let targets = grant
+            .targets()
+            .iter()
+            .map(|target| SipEffectRepairTargetClaim {
+                protocol_effect_id: &target.protocol_effect_id,
+                expected_revision: target.expected_revision,
+                expected_effect_identity_hash: &target.expected_effect_identity_hash,
+            })
+            .collect::<Vec<_>>();
+        self.claim_unknown_targets(SipEffectRepairGrantClaim {
+            tenant_id: grant.tenant_id(),
+            protocol_session_id: grant.protocol_session_id(),
+            protocol_session_generation: grant.protocol_session_generation(),
+            repair_owner_id: grant.repair_owner_id(),
+            repair_owner_epoch: grant.repair_owner_epoch(),
+            claim_token_prefix: grant.grant_id(),
+            lease_duration: execution_lease,
+            targets: &targets,
+        })
+        .await
+    }
+
+    async fn reconcile(
+        &self,
+        effect: &SipEffectRecord,
+        repair_fence: &SipEffectRepairFence,
+        receipt_id: &str,
+        outcome: SipEffectReconcileOutcome,
+    ) -> Result<SipEffectApplyOutcome, SipEffectStoreError> {
+        PostgresSipEffectStore::reconcile(self, &effect.identity, repair_fence, receipt_id, outcome)
+            .await
+    }
+}
