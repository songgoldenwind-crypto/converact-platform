+use super::postgres_sip_effect::{
+    PostgresSipEffectStore, SipEffectExactRepairBatch, SipEffectRepairGrantClaim,
+    SipEffectRepairTargetClaim, SipEffectStoreError,
+};
+use crate::call::domain::sip_effect::{
+    SIP_EFFECT_REPAIR_ATTEMPT_CEILING, SipEffectApplyOutcome, SipEffectError,
+    SipEffectReconcileOutcome, SipEffectRecord, SipEffectRepairFence, SipEffectState,
+    protocol_effect_identity_hash, sip_effect_stage_token, validate_sip_effect_identifier,
+};
+use async_trait::async_trait;
+use futures::FutureExt;
+use std::collections::HashMap;
+use std::panic::AssertUnwindSafe;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+use tokio::sync::{Mutex as AsyncMutex, mpsc};
+use tokio::task::JoinHandle;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+use tracing::{error, warn};
+
+const MAX_RECONCILER_WORKERS: usize = 64;
+const MAX_RECONCILER_QUEUE_CAPACITY: usize = 4_096;
+const MAX_RECONCILER_BATCH_SIZE: usize = 100;
+const MAX_RECONCILER_GRANT_TIMEOUT: Duration = Duration::from_secs(29);
+const MAX_REPAIR_LEASE: Duration = Duration::from_secs(30);
+const REPAIR_LEASE_SAFETY_MARGIN: Duration = Duration::from_millis(500);
+const MAX_GRANT_ID_BYTES: usize = 128;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub(crate) enum SipEffectReconcilerError {
+    #[error("SIP effect reconciler is disabled")]
+    Disabled,
+    #[error("SIP effect reconciler configuration is invalid")]
+    InvalidConfiguration,
+    #[error("SIP effect repair grant is invalid")]
+    InvalidGrant,
+    #[error("SIP effect repair grant lease does not cover the shared deadline")]
+    LeaseWindowTooShort,
+    #[error("SIP effect repair grant exceeds the fixed worker batch")]
+    TargetBatchTooLarge,
+    #[error("SIP effect repair grant queue is full")]
+    QueueFull,
+    #[error("SIP effect reconciler has stopped")]
+    Stopped,
+    #[error("SIP effect reconciler worker join failed")]
+    JoinFailed,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub(crate) enum SipEffectReconcileOracleError {
+    #[error("authoritative SIP effect observation is temporarily unavailable")]
+    Unavailable,
+    #[error("authoritative SIP effect observation failed permanently")]
+    Permanent,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct SipEffectReconcilerOptions {
+    pub enabled: bool,
+    pub worker_count: usize,
+    pub queue_capacity: usize,
+    pub batch_size: usize,
+    pub grant_timeout: Duration,
+}
+
+impl Default for SipEffectReconcilerOptions {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            worker_count: 4,
+            queue_capacity: 64,
+            batch_size: 32,
+            grant_timeout: Duration::from_secs(5),
+        }
+    }
+}
+
+impl SipEffectReconcilerOptions {
+    fn validate(self) -> Result<Self, SipEffectReconcilerError> {
+        let minimum_grant_lease = self
+            .grant_timeout
+            .checked_add(REPAIR_LEASE_SAFETY_MARGIN)
+            .ok_or(SipEffectReconcilerError::InvalidConfiguration)?;
+        if self.worker_count == 0
+            || self.worker_count > MAX_RECONCILER_WORKERS
+            || self.queue_capacity == 0
+            || self.queue_capacity > MAX_RECONCILER_QUEUE_CAPACITY
+            || self.batch_size == 0
+            || self.batch_size > MAX_RECONCILER_BATCH_SIZE
+            || self.grant_timeout.is_zero()
+            || self.grant_timeout > MAX_RECONCILER_GRANT_TIMEOUT
+            || minimum_grant_lease >= MAX_REPAIR_LEASE
+        {
+            return Err(SipEffectReconcilerError::InvalidConfiguration);
+        }
+        Ok(self)
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct SipEffectRepairTarget {
+    protocol_effect_id: String,
+    expected_revision: u64,
+    expected_effect_identity_hash: String,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct SipEffectRepairGrantSpec {
+    grant_id: String,
+    tenant_id: String,
+    protocol_session_id: String,
+    protocol_session_generation: String,
+    repair_owner_id: String,
+    repair_owner_epoch: u64,
+    lease_duration: Duration,
+    targets: Vec<SipEffectRepairTarget>,
+}
+
+/// A one-shot capability issued by the external Call authority. It is
+/// deliberately not `Clone`; submission transfers the grant to one fixed
+/// reconciler worker. The worker never creates or increments owner epochs.
+#[derive(Debug, Eq, PartialEq)]
+pub(crate) struct SipEffectRepairGrant {
+    grant_id: String,
+    tenant_id: String,
+    protocol_session_id: String,
+    protocol_session_generation: String,
+    repair_owner_id: String,
+    repair_owner_epoch: u64,
+    expires_at: Instant,
+    targets: Vec<SipEffectRepairTarget>,
+}
+
+impl TryFrom<SipEffectRepairGrantSpec> for SipEffectRepairGrant {
+    type Error = SipEffectReconcilerError;
+
+    fn try_from(spec: SipEffectRepairGrantSpec) -> Result<Self, Self::Error> {
+        for identifier in [
+            &spec.tenant_id,
+            &spec.protocol_session_id,
+            &spec.repair_owner_id,
+        ] {
+            validate_sip_effect_identifier(identifier)
+                .map_err(|_| SipEffectReconcilerError::InvalidGrant)?;
+        }
+        let generation = spec
+            .protocol_session_generation
+            .parse::<u64>()
+            .map_err(|_| SipEffectReconcilerError::InvalidGrant)?;
+        let lease_millis = u64::try_from(spec.lease_duration.as_millis())
+            .map_err(|_| SipEffectReconcilerError::InvalidGrant)?;
+        if spec.targets.is_empty() || spec.targets.len() > MAX_RECONCILER_BATCH_SIZE {
+            return Err(SipEffectReconcilerError::InvalidGrant);
+        }
+        let mut previous_effect_id = None;
+        for target in &spec.targets {
+            validate_sip_effect_identifier(&target.protocol_effect_id)
+                .map_err(|_| SipEffectReconcilerError::InvalidGrant)?;
+            if target.expected_revision == 0
+                || !is_sha256_lower_hex(&target.expected_effect_identity_hash)
+                || previous_effect_id
+                    .is_some_and(|previous| previous >= target.protocol_effect_id.as_str())
+            {
+                return Err(SipEffectReconcilerError::InvalidGrant);
+            }
+            previous_effect_id = Some(target.protocol_effect_id.as_str());
+        }
+        if spec.grant_id.is_empty()
+            || spec.grant_id.len() > MAX_GRANT_ID_BYTES
+            || !spec
+                .grant_id
+                .bytes()
+                .all(|byte| (b'!'..=b'~').contains(&byte))
+            || generation == 0
+            || generation.to_string() != spec.protocol_session_generation
+            || spec.repair_owner_epoch == 0
+            || spec.lease_duration.is_zero()
+            || spec.lease_duration > MAX_REPAIR_LEASE
+            || Duration::from_millis(lease_millis) != spec.lease_duration
+        {
+            return Err(SipEffectReconcilerError::InvalidGrant);
+        }
+        let expires_at = Instant::now()
+            .checked_add(spec.lease_duration)
+            .ok_or(SipEffectReconcilerError::InvalidGrant)?;
+        Ok(Self {
+            grant_id: spec.grant_id,
+            tenant_id: spec.tenant_id,
+            protocol_session_id: spec.protocol_session_id,
+            protocol_session_generation: spec.protocol_session_generation,
+            repair_owner_id: spec.repair_owner_id,
+            repair_owner_epoch: spec.repair_owner_epoch,
+            expires_at,
+            targets: spec.targets,
+        })
+    }
+}
+
+impl SipEffectRepairGrant {
+    pub(crate) fn grant_id(&self) -> &str {
+        &self.grant_id
+    }
+
+    pub(crate) fn tenant_id(&self) -> &str {
+        &self.tenant_id
+    }
+
+    pub(crate) fn protocol_session_id(&self) -> &str {
+        &self.protocol_session_id
+    }
+
+    pub(crate) fn protocol_session_generation(&self) -> &str {
+        &self.protocol_session_generation
+    }
+
+    pub(crate) fn repair_owner_id(&self) -> &str {
+        &self.repair_owner_id
+    }
+
+    pub(crate) fn repair_owner_epoch(&self) -> u64 {
+        self.repair_owner_epoch
+    }
+
+    fn remaining_lease(&self) -> Option<Duration> {
+        self.expires_at.checked_duration_since(Instant::now())
+    }
+
+    fn freeze_execution_lease(&self, minimum: Duration) -> Option<Duration> {
+        let milliseconds = u64::try_from(self.remaining_lease()?.as_millis()).ok()?;
+        let execution_lease = Duration::from_millis(milliseconds);
+        (execution_lease > minimum).then_some(execution_lease)
+    }
+
+    fn targets(&self) -> &[SipEffectRepairTarget] {
+        &self.targets
+    }
+}
+
+fn is_sha256_lower_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
