+
+fn validate_exact_repair_targets(
+    targets: &[SipEffectRepairTargetClaim<'_>],
+) -> Result<(), SipEffectStoreError> {
+    if targets.is_empty() || targets.len() > MAX_REPAIR_BATCH_SIZE {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    let mut previous_effect_id = None;
+    for target in targets {
+        validate_sip_effect_identifier(target.protocol_effect_id)
+            .map_err(|_| SipEffectStoreError::InvalidConfiguration)?;
+        if target.expected_revision == 0
+            || target.expected_effect_identity_hash.len() != 64
+            || !target
+                .expected_effect_identity_hash
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+            || previous_effect_id.is_some_and(|previous| previous >= target.protocol_effect_id)
+        {
+            return Err(SipEffectStoreError::InvalidConfiguration);
+        }
+        previous_effect_id = Some(target.protocol_effect_id);
+    }
+    Ok(())
+}
