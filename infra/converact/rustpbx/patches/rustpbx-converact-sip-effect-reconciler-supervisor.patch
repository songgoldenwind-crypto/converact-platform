+pub(crate) struct SipEffectReconcilerSupervisor {
+    cancel: CancellationToken,
+    sender: Option<mpsc::Sender<SipEffectRepairGrant>>,
+    workers: Vec<JoinHandle<()>>,
+    metrics: Arc<SipEffectReconcilerMetrics>,
+    minimum_grant_lease: Duration,
+    maximum_grant_targets: usize,
+}
+
+impl SipEffectReconcilerSupervisor {
+    pub(crate) fn start(
+        store: Arc<dyn SipEffectReconcileStorePort>,
+        oracle: Arc<dyn SipEffectReconcileOracle>,
+        parent_cancel: CancellationToken,
+        options: SipEffectReconcilerOptions,
+    ) -> Result<Self, SipEffectReconcilerError> {
+        let options = options.validate()?;
+        if !options.enabled {
+            return Err(SipEffectReconcilerError::Disabled);
+        }
+        if tokio::runtime::Handle::try_current().is_err() {
+            return Err(SipEffectReconcilerError::InvalidConfiguration);
+        }
+
+        let cancel = parent_cancel.child_token();
+        let minimum_grant_lease = options
+            .grant_timeout
+            .checked_add(REPAIR_LEASE_SAFETY_MARGIN)
+            .ok_or(SipEffectReconcilerError::InvalidConfiguration)?;
+        let metrics = Arc::new(SipEffectReconcilerMetrics::new(options.worker_count));
+        let (sender, receiver) = mpsc::channel(options.queue_capacity);
+        let receiver = Arc::new(AsyncMutex::new(receiver));
+        let mut workers = Vec::with_capacity(options.worker_count);
+        for worker_index in 0..options.worker_count {
+            workers.push(crate::utils::spawn(run_worker(
+                worker_index,
+                store.clone(),
+                oracle.clone(),
+                receiver.clone(),
+                cancel.clone(),
+                options,
+                metrics.clone(),
+            )));
+        }
+        Ok(Self {
+            cancel,
+            sender: Some(sender),
+            workers,
+            metrics,
+            minimum_grant_lease,
+            maximum_grant_targets: options.batch_size,
+        })
+    }
+
+    pub(crate) fn try_submit(
+        &self,
+        grant: SipEffectRepairGrant,
+    ) -> Result<(), SipEffectReconcilerError> {
+        if self.cancel.is_cancelled() {
+            return Err(SipEffectReconcilerError::Stopped);
+        }
+        if grant
+            .freeze_execution_lease(self.minimum_grant_lease)
+            .is_none()
+        {
+            return Err(SipEffectReconcilerError::LeaseWindowTooShort);
+        }
+        if grant.targets().len() > self.maximum_grant_targets {
+            return Err(SipEffectReconcilerError::TargetBatchTooLarge);
+        }
+        let sender = self
+            .sender
+            .as_ref()
+            .ok_or(SipEffectReconcilerError::Stopped)?;
+        self.metrics.queued_grants.fetch_add(1, Ordering::AcqRel);
+        match sender.try_send(grant) {
+            Ok(()) => Ok(()),
+            Err(mpsc::error::TrySendError::Full(_)) => {
+                self.metrics.queued_grants.fetch_sub(1, Ordering::AcqRel);
+                Err(SipEffectReconcilerError::QueueFull)
+            }
+            Err(mpsc::error::TrySendError::Closed(_)) => {
+                self.metrics.queued_grants.fetch_sub(1, Ordering::AcqRel);
+                Err(SipEffectReconcilerError::Stopped)
+            }
+        }
+    }
+
+    pub(crate) fn snapshot(&self) -> SipEffectReconcilerSnapshot {
+        self.metrics.snapshot()
+    }
+
+    pub(crate) async fn shutdown(
+        mut self,
+    ) -> Result<SipEffectReconcilerSnapshot, SipEffectReconcilerError> {
+        self.cancel.cancel();
+        self.sender.take();
+        let mut join_failed = false;
+        for worker in self.workers.drain(..) {
+            if worker.await.is_err() {
+                join_failed = true;
+            }
+        }
+        let queued = self.metrics.queued_grants.swap(0, Ordering::AcqRel);
+        self.metrics
+            .cancelled_grants
+            .fetch_add(queued, Ordering::Relaxed);
+        if join_failed {
+            Err(SipEffectReconcilerError::JoinFailed)
+        } else {
+            Ok(self.metrics.snapshot())
+        }
+    }
+}
+
+impl Drop for SipEffectReconcilerSupervisor {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+    }
+}
+
+struct RunningWorkerGuard<'a>(&'a AtomicUsize);
+
+impl Drop for RunningWorkerGuard<'_> {
+    fn drop(&mut self) {
+        let previous = self.0.fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+    }
+}
+
+struct ActiveGrantGuard<'a>(&'a AtomicUsize);
+
+impl Drop for ActiveGrantGuard<'_> {
+    fn drop(&mut self) {
+        let previous = self.0.fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum GrantFailure {
+    Transient,
+    Superseded,
+    Permanent,
+}
+
+async fn run_worker(
+    worker_index: usize,
+    store: Arc<dyn SipEffectReconcileStorePort>,
+    oracle: Arc<dyn SipEffectReconcileOracle>,
+    receiver: Arc<AsyncMutex<mpsc::Receiver<SipEffectRepairGrant>>>,
+    cancel: CancellationToken,
+    options: SipEffectReconcilerOptions,
+    metrics: Arc<SipEffectReconcilerMetrics>,
+) {
+    metrics.running_workers.fetch_add(1, Ordering::AcqRel);
+    let _running = RunningWorkerGuard(&metrics.running_workers);
+    loop {
+        let grant = tokio::select! {
+            biased;
+            _ = cancel.cancelled() => return,
+            grant = receive_grant(&receiver) => grant,
+        };
+        let Some(grant) = grant else {
+            return;
+        };
+        let previous = metrics.queued_grants.fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+        let minimum_remaining = options
+            .grant_timeout
+            .checked_add(REPAIR_LEASE_SAFETY_MARGIN)
+            .expect("validated reconciler deadline");
+        let Some(execution_lease) = grant.freeze_execution_lease(minimum_remaining) else {
+            metrics.timed_out_grants.fetch_add(1, Ordering::Relaxed);
+            warn!(
+                worker_index,
+                grant_id = grant.grant_id(),
+                "SIP effect repair grant expired before store claim"
+            );
+            continue;
+        };
+        metrics.active_grants.fetch_add(1, Ordering::AcqRel);
+        let _active = ActiveGrantGuard(&metrics.active_grants);
+        let grant_id = grant.grant_id().to_string();
+        let operation = AssertUnwindSafe(process_grant(
+            store.as_ref(),
+            oracle.as_ref(),
+            &grant,
+            execution_lease,
+            metrics.as_ref(),
+        ))
+        .catch_unwind();
+        let result = tokio::select! {
+            biased;
+            result = tokio::time::timeout(options.grant_timeout, operation) => result,
+            _ = cancel.cancelled() => {
+                metrics.cancelled_grants.fetch_add(1, Ordering::Relaxed);
+                return;
+            }
+        };
+
+        match result {
+            Ok(Ok(Ok(()))) => {
+                metrics.completed_grants.fetch_add(1, Ordering::Relaxed);
+            }
+            Ok(Ok(Err(GrantFailure::Transient))) => {
+                metrics.transient_failures.fetch_add(1, Ordering::Relaxed);
+                warn!(
+                    worker_index,
+                    grant_id, "SIP effect repair grant failed transiently"
+                );
+            }
+            Ok(Ok(Err(GrantFailure::Superseded))) => {
+                metrics.superseded_grants.fetch_add(1, Ordering::Relaxed);
+                warn!(
+                    worker_index,
+                    grant_id, "SIP effect repair grant was superseded"
+                );
+            }
+            Ok(Ok(Err(GrantFailure::Permanent))) => {
+                metrics.permanent_failures.fetch_add(1, Ordering::Relaxed);
+                metrics.quarantined_workers.fetch_add(1, Ordering::Relaxed);
+                error!(
+                    worker_index,
+                    grant_id, "SIP effect repair worker quarantined"
+                );
+                return;
+            }
+            Ok(Err(_)) => {
+                metrics.panic_failures.fetch_add(1, Ordering::Relaxed);
+                metrics.permanent_failures.fetch_add(1, Ordering::Relaxed);
+                metrics.quarantined_workers.fetch_add(1, Ordering::Relaxed);
+                cancel.cancel();
+                error!(
+                    worker_index,
+                    grant_id, "SIP effect repair worker panicked and was quarantined"
+                );
+                return;
+            }
+            Err(_) => {
+                metrics.timed_out_grants.fetch_add(1, Ordering::Relaxed);
+                warn!(
+                    worker_index,
+                    grant_id, "SIP effect repair grant timed out fail-closed"
+                );
+            }
+        }
+    }
+}
+
+async fn receive_grant(
+    receiver: &AsyncMutex<mpsc::Receiver<SipEffectRepairGrant>>,
+) -> Option<SipEffectRepairGrant> {
+    receiver.lock().await.recv().await
+}
+
+async fn process_grant(
+    store: &dyn SipEffectReconcileStorePort,
+    oracle: &dyn SipEffectReconcileOracle,
+    grant: &SipEffectRepairGrant,
+    execution_lease: Duration,
+    metrics: &SipEffectReconcilerMetrics,
+) -> Result<(), GrantFailure> {
+    let batch = store
+        .claim_targets(grant, execution_lease)
+        .await
+        .map_err(classify_store_error)?;
+    let mut targets = grant
+        .targets()
+        .iter()
+        .map(|target| (target.protocol_effect_id.as_str(), target))
+        .collect::<HashMap<_, _>>();
+    for effect in &batch.effects {
+        let target = targets
+            .remove(effect.identity.protocol_effect_id.as_str())
+            .ok_or(GrantFailure::Permanent)?;
+        validate_claimed_effect(grant, target, effect)?;
+    }
+    for exhausted_effect_id in &batch.exhausted_effect_ids {
+        if targets.remove(exhausted_effect_id.as_str()).is_none() {
+            return Err(GrantFailure::Permanent);
+        }
+    }
+    if !targets.is_empty() {
+        return Err(GrantFailure::Permanent);
+    }
+    metrics
+        .exhausted_effects
+        .fetch_add(batch.exhausted_effect_ids.len(), Ordering::Relaxed);
+
+    for effect in &batch.effects {
+        let outcome = oracle
+            .query_authoritative_outcome(effect)
+            .await
+            .map_err(classify_oracle_error)?;
+        let repair_fence = effect
+            .repair_claim
+            .as_ref()
+            .ok_or(GrantFailure::Permanent)?;
+        let stage = format!(
+            "repair-{}-{}-{}",
+            grant.grant_id(),
+            grant.repair_owner_epoch(),
+            repair_fence.repair_claim_revision,
+        );
+        let receipt_id =
+            sip_effect_stage_token("receipt", &effect.identity.protocol_effect_id, &stage);
+        store
+            .reconcile(effect, repair_fence, &receipt_id, outcome)
+            .await
+            .map_err(classify_store_error)?;
+        metrics.reconciled_effects.fetch_add(1, Ordering::Relaxed);
+    }
+    Ok(())
+}
+
+fn validate_claimed_effect(
+    grant: &SipEffectRepairGrant,
+    target: &SipEffectRepairTarget,
+    effect: &SipEffectRecord,
+) -> Result<(), GrantFailure> {
+    effect
+        .identity
+        .validate()
+        .map_err(|_| GrantFailure::Permanent)?;
+    let repair_fence = effect
+        .repair_claim
+        .as_ref()
+        .ok_or(GrantFailure::Permanent)?;
+    repair_fence
+        .validate()
+        .map_err(|_| GrantFailure::Permanent)?;
+    let expected_claim_token = format!(
+        "{}:{}:{}:{}",
+        grant.grant_id(),
+        effect.identity.protocol_effect_id,
+        grant.repair_owner_epoch(),
+        repair_fence.repair_claim_revision,
+    );
+    let expected_revision = target
+        .expected_revision
+        .checked_add(1)
+        .ok_or(GrantFailure::Permanent)?;
+    if effect.identity.tenant_id != grant.tenant_id()
+        || effect.identity.protocol_session_id != grant.protocol_session_id()
+        || effect.identity.protocol_session_generation != grant.protocol_session_generation()
+        || effect.identity.protocol_effect_id != target.protocol_effect_id
+        || effect.revision != expected_revision
+        || protocol_effect_identity_hash(&effect.identity).map_err(|_| GrantFailure::Permanent)?
+            != target.expected_effect_identity_hash
+        || effect.state != SipEffectState::Unknown
+        || effect.revision != repair_fence.repair_claim_revision
+        || effect.repair_epoch_high_watermark != grant.repair_owner_epoch()
+        || effect.repair_attempts == 0
+        || effect.repair_attempts > SIP_EFFECT_REPAIR_ATTEMPT_CEILING
+        || effect.operator_attention_required
+        || repair_fence.repair_owner_id != grant.repair_owner_id()
+        || repair_fence.repair_owner_epoch != grant.repair_owner_epoch()
+        || repair_fence.repair_claim_token != expected_claim_token
+    {
+        return Err(GrantFailure::Permanent);
+    }
+    Ok(())
+}
+
+fn classify_store_error(error: SipEffectStoreError) -> GrantFailure {
+    match error {
+        SipEffectStoreError::PoolExhausted
+        | SipEffectStoreError::PoolTimeout
+        | SipEffectStoreError::StoreUnavailable => GrantFailure::Transient,
+        SipEffectStoreError::Domain(SipEffectError::FenceLost | SipEffectError::Terminal) => {
+            GrantFailure::Superseded
+        }
+        SipEffectStoreError::InvalidConfiguration
+        | SipEffectStoreError::SchemaIncompatible
+        | SipEffectStoreError::Domain(_) => GrantFailure::Permanent,
+    }
+}
+
+fn classify_oracle_error(error: SipEffectReconcileOracleError) -> GrantFailure {
+    match error {
+        SipEffectReconcileOracleError::Unavailable => GrantFailure::Transient,
+        SipEffectReconcileOracleError::Permanent => GrantFailure::Permanent,
+    }
+}
