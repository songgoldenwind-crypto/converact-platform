+    #[test]
+    fn stale_authority_and_dedupe_pressure_fail_without_mutation() {
+        let bounds = NativeCallBounds {
+            dedupe_receipts_per_call: 1,
+            ..NativeCallBounds::default()
+        };
+        let mut call = NativeCall::new(identity(), bounds).unwrap();
+        let leg_id = leg("leg-a");
+        call.add_leg(
+            &call.fence(),
+            leg_id.clone(),
+            ProviderCallId::parse("provider-a").unwrap(),
+            NativeLegDirection::Outbound,
+        )
+        .unwrap();
+
+        let mut stale_owner = call.fence();
+        stale_owner.owner_epoch -= 1;
+        assert_eq!(
+            call.apply_leg_event(
+                &stale_owner,
+                &leg_id,
+                "stale-owner",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap_err(),
+            NativeCallError::StaleOwner,
+        );
+        let mut stale_generation = call.fence();
+        stale_generation.generation += 1;
+        assert_eq!(
+            call.apply_leg_event(
+                &stale_generation,
+                &leg_id,
+                "stale-generation",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap_err(),
+            NativeCallError::StaleGeneration,
+        );
+
+        call.apply_leg_event(
+            &call.fence(),
+            &leg_id,
+            "start",
+            HASH_A,
+            NativeLegEvent::StartInvite,
+        )
+        .unwrap();
+        let before = call.snapshot();
+        assert_eq!(
+            call.apply_leg_event(
+                &call.fence(),
+                &leg_id,
+                "provisional",
+                HASH_B,
+                NativeLegEvent::Provisional,
+            )
+            .unwrap_err(),
+            NativeCallError::CapacityExhausted,
+        );
+        assert_eq!(call.snapshot(), before);
+    }
