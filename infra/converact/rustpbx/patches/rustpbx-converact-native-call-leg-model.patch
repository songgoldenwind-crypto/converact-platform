+    #[test]
+    fn revision_overflow_and_invalid_bounds_never_partially_mutate() {
+        let defaults = NativeCallBounds::default();
+        assert_eq!(defaults.legs_per_call, 32);
+        assert_eq!(defaults.mailbox_per_call, 256);
+        assert!(matches!(
+            NativeCall::new(
+                identity(),
+                NativeCallBounds {
+                    timers_per_call: 0,
+                    ..defaults
+                },
+            ),
+            Err(NativeCallError::InvalidInput),
+        ));
+
+        let max_revision_identity = NativeCallIdentity::from_canonical(
+            "tenant-a",
+            derive_call_id("tenant-a", &["projection-overflow"]).unwrap(),
+            derive_interaction_id("tenant-a", &["interaction-overflow"]).unwrap(),
+            ProviderCallId::parse("provider-overflow").unwrap(),
+            7,
+            11,
+            u64::MAX,
+        )
+        .unwrap();
+        let mut call = NativeCall::new(max_revision_identity, defaults).unwrap();
+        assert_eq!(
+            call.add_leg(
+                &call.fence(),
+                leg("overflow-leg"),
+                ProviderCallId::parse("provider-overflow").unwrap(),
+                NativeLegDirection::Outbound,
+            )
+            .unwrap_err(),
+            NativeCallError::CapacityExhausted,
+        );
+        assert_eq!(call.snapshot().revision, u64::MAX);
+        assert!(call.snapshot().legs.is_empty());
+    }
