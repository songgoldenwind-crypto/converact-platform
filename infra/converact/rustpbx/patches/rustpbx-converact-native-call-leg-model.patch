+pub struct NativeCall {
+    tenant_id: String,
+    call_id: CallId,
+    interaction_id: InteractionId,
+    owner_epoch: u64,
+    generation: u64,
+    revision: u64,
+    selected_leg_id: Option<LegId>,
+    legs: HashMap<LegId, NativeLeg>,
+    dialogs: HashMap<ProtocolDialogId, LegId>,
+    fork_attempts: HashMap<String, NativeForkAttempt>,
+    fork_attempt_by_leg: HashMap<LegId, String>,
+    dedupe: HashMap<String, DedupeEntry>,
+    mailbox: VecDeque<NativeCallWorkItem>,
+    mailbox_work_ids: HashSet<String>,
+    timers: HashSet<String>,
+    bounds: NativeCallBounds,
+}
+
+impl NativeCall {
+    pub fn new(
+        identity: NativeCallIdentity,
+        bounds: NativeCallBounds,
+    ) -> Result<Self, NativeCallError> {
+        let bounds = bounds.validate()?;
+        Ok(Self {
+            tenant_id: identity.tenant_id().to_string(),
+            call_id: identity.call_id().clone(),
+            interaction_id: identity.interaction_id().clone(),
+            owner_epoch: identity.owner_epoch(),
+            generation: identity.generation(),
+            revision: identity.revision(),
+            selected_leg_id: None,
+            legs: HashMap::with_capacity(bounds.legs_per_call.min(8)),
+            dialogs: HashMap::new(),
+            fork_attempts: HashMap::new(),
+            fork_attempt_by_leg: HashMap::new(),
+            dedupe: HashMap::with_capacity(bounds.dedupe_receipts_per_call.min(32)),
+            mailbox: VecDeque::with_capacity(bounds.mailbox_per_call.min(32)),
+            mailbox_work_ids: HashSet::with_capacity(bounds.mailbox_per_call.min(32)),
+            timers: HashSet::with_capacity(bounds.timers_per_call.min(16)),
+            bounds,
+        })
+    }
+
+    pub fn fence(&self) -> NativeCallFence {
+        NativeCallFence {
+            tenant_id: self.tenant_id.clone(),
+            call_id: self.call_id.clone(),
+            owner_epoch: self.owner_epoch,
+            generation: self.generation,
+            expected_revision: self.revision,
+        }
+    }
+
+    pub fn snapshot(&self) -> NativeCallSnapshot {
+        let mut legs: Vec<_> = self.legs.values().map(NativeLeg::snapshot).collect();
+        legs.sort_by(|left, right| left.leg_id.cmp(&right.leg_id));
+        NativeCallSnapshot {
+            tenant_id: self.tenant_id.clone(),
+            call_id: self.call_id.clone(),
+            interaction_id: self.interaction_id.clone(),
+            owner_epoch: self.owner_epoch,
+            generation: self.generation,
+            revision: self.revision,
+            selected_leg_id: self.selected_leg_id.clone(),
+            legs,
+            mailbox_depth: self.mailbox.len(),
+            timer_count: self.timers.len(),
+        }
+    }
+
+    pub fn leg(&self, leg_id: &LegId) -> Result<NativeLegSnapshot, NativeCallError> {
+        self.legs
+            .get(leg_id)
+            .map(NativeLeg::snapshot)
+            .ok_or(NativeCallError::LegNotFound)
+    }
+
+    pub fn add_leg(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: LegId,
+        provider_call_id: ProviderCallId,
+        direction: NativeLegDirection,
+    ) -> Result<NativeLegSnapshot, NativeCallError> {
+        self.resolve_fence(fence, None)?;
+        if self.legs.contains_key(&leg_id) {
+            return Err(NativeCallError::LegConflict);
+        }
+        if self.legs.len() >= self.bounds.legs_per_call {
+            return Err(NativeCallError::CapacityExhausted);
+        }
+        let revision = self.next_revision()?;
+        let leg = NativeLeg {
+            leg_id: leg_id.clone(),
+            provider_call_id,
+            direction,
+            generation: fence.generation,
+            negotiation_generation: 1,
+            state: NativeLegState::Planned,
+            transfer_return_state: None,
+            active_protocol_dialog_id: None,
+            protocol_dialog_history: Vec::with_capacity(
+                self.bounds.protocol_dialog_history_per_leg.min(4),
+            ),
+        };
+        let snapshot = leg.snapshot();
+        self.legs.insert(leg_id, leg);
+        self.revision = revision;
+        Ok(snapshot)
+    }
+
+    pub fn apply_leg_event(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        event_id: &str,
+        event_hash: &str,
+        event: NativeLegEvent,
+    ) -> Result<NativeLegMutationReceipt, NativeCallError> {
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation = format!("leg-event:{}", event.as_str());
+        if let Some(stored) = self.find_replay(fence, leg_id, &event_id, &event_hash, &operation)? {
+            return match stored {
+                StoredReceipt::Leg(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(leg_id))?;
+        self.reserve_dedupe()?;
+
+        let leg = self.legs.get(leg_id).ok_or(NativeCallError::LegNotFound)?;
+        let (mut next_state, required_effect) =
+            transition(leg.state, event).ok_or(NativeCallError::TransitionInvalid)?;
+        if event == NativeLegEvent::TransferAbort {
+            next_state = leg
+                .transfer_return_state
+                .ok_or(NativeCallError::TransitionInvalid)?;
+        }
+        let revision = self.next_revision()?;
+        let leg = self
+            .legs
+            .get_mut(leg_id)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if event == NativeLegEvent::TransferPrepare {
+            leg.transfer_return_state = Some(leg.state);
+        } else if matches!(
+            event,
+            NativeLegEvent::TransferAbort | NativeLegEvent::ProtocolFailure
+        ) {
+            leg.transfer_return_state = None;
+        }
+        leg.state = next_state;
+        self.revision = revision;
+        let receipt = NativeLegMutationReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            leg_id: leg_id.clone(),
+            revision,
+            state: next_state,
+            required_effect,
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            leg_id.clone(),
+            StoredReceipt::Leg(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    pub fn bind_protocol_dialog(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        protocol_dialog_id: ProtocolDialogId,
+        event_id: &str,
+        event_hash: &str,
+    ) -> Result<NativeLegMutationReceipt, NativeCallError> {
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation = format!("bind-dialog:{protocol_dialog_id}");
+        if let Some(stored) = self.find_replay(fence, leg_id, &event_id, &event_hash, &operation)? {
+            return match stored {
+                StoredReceipt::Leg(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(leg_id))?;
+        self.reserve_dedupe()?;
+        if self
+            .dialogs
+            .get(&protocol_dialog_id)
+            .is_some_and(|owner| owner != leg_id)
+        {
+            return Err(NativeCallError::DialogConflict);
+        }
+        let leg = self.legs.get(leg_id).ok_or(NativeCallError::LegNotFound)?;
+        let already_bound = leg
+            .protocol_dialog_history
+            .iter()
+            .any(|value| value == &protocol_dialog_id);
+        if !already_bound
+            && leg.protocol_dialog_history.len() >= self.bounds.protocol_dialog_history_per_leg
+        {
+            return Err(NativeCallError::CapacityExhausted);
+        }
+        let revision = self.next_revision()?;
+        let leg = self
+            .legs
+            .get_mut(leg_id)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if !already_bound {
+            leg.protocol_dialog_history.push(protocol_dialog_id.clone());
+            self.dialogs
+                .insert(protocol_dialog_id.clone(), leg_id.clone());
+        }
+        leg.active_protocol_dialog_id = Some(protocol_dialog_id);
+        let state = leg.state;
+        self.revision = revision;
+        let receipt = NativeLegMutationReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            leg_id: leg_id.clone(),
+            revision,
+            state,
+            required_effect: NativeRequiredEffect::None,
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            leg_id.clone(),
+            StoredReceipt::Leg(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    pub fn register_fork_branch(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        fork_attempt_id: &str,
+        event_id: &str,
+        event_hash: &str,
+    ) -> Result<NativeForkBranchReceipt, NativeCallError> {
+        let fork_attempt_id = checked_identifier(fork_attempt_id)?;
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation = format!("fork-branch-registration:{fork_attempt_id}");
+        if let Some(stored) = self.find_replay(fence, leg_id, &event_id, &event_hash, &operation)? {
+            return match stored {
+                StoredReceipt::Branch(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(leg_id))?;
+        self.reserve_dedupe()?;
+        if self
+            .legs
+            .get(leg_id)
+            .is_none_or(|leg| leg.state != NativeLegState::Planned)
+        {
+            return Err(NativeCallError::TransitionInvalid);
+        }
+        if self.fork_attempt_by_leg.contains_key(leg_id) {
+            return Err(NativeCallError::EventConflict);
+        }
+        if let Some(attempt) = self.fork_attempts.get(&fork_attempt_id) {
+            if attempt.winner.is_some() {
+                return Err(NativeCallError::EventConflict);
+            }
+            if attempt.branches.len() >= self.bounds.fork_branches_per_attempt {
+                return Err(NativeCallError::CapacityExhausted);
+            }
+        }
+        let revision = self.next_revision()?;
+        let attempt = self
+            .fork_attempts
+            .entry(fork_attempt_id.clone())
+            .or_insert_with(|| NativeForkAttempt {
+                branches: Vec::with_capacity(self.bounds.fork_branches_per_attempt.min(4)),
+                winner: None,
+            });
+        attempt.branches.push(leg_id.clone());
+        self.fork_attempt_by_leg
+            .insert(leg_id.clone(), fork_attempt_id.clone());
+        self.revision = revision;
+        let receipt = NativeForkBranchReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            leg_id: leg_id.clone(),
+            fork_attempt_id,
+            revision,
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            leg_id.clone(),
+            StoredReceipt::Branch(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn observe_fork_winner(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        fork_attempt_id: &str,
+        sip_status: u16,
+        event_id: &str,
+        event_hash: &str,
+    ) -> Result<NativeForkSelectionReceipt, NativeCallError> {
+        if !(200..=299).contains(&sip_status) {
+            return Err(NativeCallError::InvalidInput);
+        }
+        let fork_attempt_id = checked_identifier(fork_attempt_id)?;
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation = format!("durable-fork-selection:{fork_attempt_id}");
+        if let Some(stored) = self.find_replay(fence, leg_id, &event_id, &event_hash, &operation)? {
+            return match stored {
+                StoredReceipt::Fork(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(leg_id))?;
+        self.reserve_dedupe()?;
+        let attempt = self
+            .fork_attempts
+            .get(&fork_attempt_id)
+            .ok_or(NativeCallError::TransitionInvalid)?;
+        if !attempt.branches.iter().any(|value| value == leg_id)
+            || self.fork_attempt_by_leg.get(leg_id) != Some(&fork_attempt_id)
+        {
+            return Err(NativeCallError::TransitionInvalid);
+        }
+        let branches = attempt.branches.clone();
+        let existing_winner = attempt.winner.clone();
+        let leg_state = self
+            .legs
+            .get(leg_id)
+            .map(|leg| leg.state)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if !matches!(
+            leg_state,
+            NativeLegState::Inviting
+                | NativeLegState::Early
+                | NativeLegState::Confirmed
+                | NativeLegState::Terminating
+        ) {
+            return Err(NativeCallError::TransitionInvalid);
+        }
+        let selected_leg_id = existing_winner
+            .clone()
+            .or_else(|| self.selected_leg_id.clone())
+            .unwrap_or_else(|| leg_id.clone());
+        let is_winner = &selected_leg_id == leg_id;
+        let required_effect = if is_winner {
+            match leg_state {
+                NativeLegState::Terminating => NativeRequiredEffect::AckThenBye,
+                NativeLegState::Confirmed => NativeRequiredEffect::None,
+                _ => NativeRequiredEffect::Ack2xx,
+            }
+        } else if leg_state == NativeLegState::Confirmed {
+            NativeRequiredEffect::SendByeNonWinnerAfterAck
+        } else {
+            NativeRequiredEffect::AckThenByeNonWinner
+        };
+        let revision = self.next_revision()?;
+        let mut branch_effects = Vec::with_capacity(branches.len().saturating_sub(1));
+        if existing_winner.is_none() && is_winner {
+            for branch_id in &branches {
+                if branch_id == leg_id {
+                    continue;
+                }
+                let branch = self
+                    .legs
+                    .get(branch_id)
+                    .ok_or(NativeCallError::LegNotFound)?;
+                if let Some(effect) = fork_cancellation_effect(branch.state) {
+                    branch_effects.push(NativeForkBranchEffect {
+                        leg_id: branch_id.clone(),
+                        required_effect: effect,
+                    });
+                }
+            }
+            for effect in &branch_effects {
+                self.legs
+                    .get_mut(&effect.leg_id)
+                    .ok_or(NativeCallError::LegNotFound)?
+                    .state = NativeLegState::Terminating;
+            }
+            self.fork_attempts
+                .get_mut(&fork_attempt_id)
+                .ok_or(NativeCallError::TransitionInvalid)?
+                .winner = Some(leg_id.clone());
+        }
+        self.selected_leg_id = Some(selected_leg_id.clone());
+        self.legs
+            .get_mut(leg_id)
+            .ok_or(NativeCallError::LegNotFound)?
+            .state = if is_winner && leg_state != NativeLegState::Terminating {
+            NativeLegState::Confirmed
+        } else {
+            NativeLegState::Terminating
+        };
+        self.revision = revision;
+        let receipt = NativeForkSelectionReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            leg_id: leg_id.clone(),
+            revision,
+            selected_leg_id,
+            required_effect,
+            branch_effects,
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            leg_id.clone(),
+            StoredReceipt::Fork(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn commit_transfer_selection(
+        &mut self,
+        fence: &NativeCallFence,
+        old_leg_id: &LegId,
+        old_leg_generation: u64,
+        new_leg_id: &LegId,
+        event_id: &str,
+        event_hash: &str,
+    ) -> Result<NativeTransferSelectionReceipt, NativeCallError> {
+        if old_leg_id == new_leg_id {
+            return Err(NativeCallError::InvalidInput);
+        }
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation =
+            format!("transfer-selection:{old_leg_id}:{old_leg_generation}:{new_leg_id}");
+        if let Some(stored) =
+            self.find_replay(fence, new_leg_id, &event_id, &event_hash, &operation)?
+        {
+            return match stored {
+                StoredReceipt::Transfer(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(new_leg_id))?;
+        self.reserve_dedupe()?;
+        let old_leg = self
+            .legs
+            .get(old_leg_id)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if old_leg.generation != old_leg_generation {
+            return Err(NativeCallError::StaleGeneration);
+        }
+        let new_state = self
+            .legs
+            .get(new_leg_id)
+            .map(|leg| leg.state)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if self.selected_leg_id.as_ref() != Some(old_leg_id)
+            || old_leg.state != NativeLegState::Transferring
+            || new_state != NativeLegState::Confirmed
+        {
+            return Err(NativeCallError::TransitionInvalid);
+        }
+        let revision = self.next_revision()?;
+        let old_leg = self
+            .legs
+            .get_mut(old_leg_id)
+            .ok_or(NativeCallError::LegNotFound)?;
+        old_leg.state = NativeLegState::Terminating;
+        old_leg.transfer_return_state = None;
+        self.selected_leg_id = Some(new_leg_id.clone());
+        self.revision = revision;
+        let receipt = NativeTransferSelectionReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            old_leg_id: old_leg_id.clone(),
+            new_leg_id: new_leg_id.clone(),
+            revision,
+            selected_leg_id: new_leg_id.clone(),
+            required_effect: NativeRequiredEffect::ByeOldSelectedLeg,
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            new_leg_id.clone(),
+            StoredReceipt::Transfer(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    pub fn advance_negotiation(
+        &mut self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        event_id: &str,
+        event_hash: &str,
+        glare: bool,
+    ) -> Result<NativeNegotiationReceipt, NativeCallError> {
+        let event_id = checked_identifier(event_id)?;
+        let event_hash = checked_hash(event_hash)?;
+        let operation = format!(
+            "advance-negotiation:{}",
+            if glare { "glare" } else { "accepted" }
+        );
+        if let Some(stored) = self.find_replay(fence, leg_id, &event_id, &event_hash, &operation)? {
+            return match stored {
+                StoredReceipt::Negotiation(receipt) => Ok(receipt),
+                _ => Err(NativeCallError::EventConflict),
+            };
+        }
+        self.resolve_fence(fence, Some(leg_id))?;
+        self.reserve_dedupe()?;
+        let leg = self.legs.get(leg_id).ok_or(NativeCallError::LegNotFound)?;
+        if !matches!(leg.state, NativeLegState::Confirmed | NativeLegState::Held) {
+            return Err(NativeCallError::TransitionInvalid);
+        }
+        let negotiation_generation = if glare {
+            leg.negotiation_generation
+        } else {
+            leg.negotiation_generation
+                .checked_add(1)
+                .ok_or(NativeCallError::CapacityExhausted)?
+        };
+        let revision = self.next_revision()?;
+        let leg = self
+            .legs
+            .get_mut(leg_id)
+            .ok_or(NativeCallError::LegNotFound)?;
+        if !glare {
+            leg.negotiation_generation = negotiation_generation;
+        }
+        self.revision = revision;
+        let receipt = NativeNegotiationReceipt {
+            event_id: event_id.clone(),
+            event_hash: event_hash.clone(),
+            leg_id: leg_id.clone(),
+            revision,
+            negotiation_generation,
+            required_effect: if glare {
+                NativeRequiredEffect::Retry491Bounded
+            } else {
+                NativeRequiredEffect::None
+            },
+            replayed: false,
+        };
+        self.remember(
+            event_id,
+            event_hash,
+            operation,
+            leg_id.clone(),
+            StoredReceipt::Negotiation(receipt.clone()),
+        );
+        Ok(receipt)
+    }
+
+    pub fn enqueue_work(
+        &mut self,
+        fence: &NativeCallFence,
+        work_id: &str,
+        kind: &str,
+    ) -> Result<(), NativeCallError> {
+        self.resolve_fence(fence, None)?;
+        let work_id = checked_identifier(work_id)?;
+        let kind = checked_identifier(kind)?;
+        if self.mailbox_work_ids.contains(&work_id) {
+            return Err(NativeCallError::EventConflict);
+        }
+        if self.mailbox.len() >= self.bounds.mailbox_per_call {
+            return Err(NativeCallError::CapacityExhausted);
+        }
+        let revision = self.next_revision()?;
+        self.mailbox.push_back(NativeCallWorkItem {
+            work_id: work_id.clone(),
+            kind,
+        });
+        self.mailbox_work_ids.insert(work_id);
+        self.revision = revision;
+        Ok(())
+    }
+
+    pub fn dequeue_work(
+        &mut self,
+        fence: &NativeCallFence,
+    ) -> Result<Option<NativeCallWorkItem>, NativeCallError> {
+        self.resolve_fence(fence, None)?;
+        let Some(front) = self.mailbox.front() else {
+            return Ok(None);
+        };
+        let work_id = front.work_id.clone();
+        let revision = self.next_revision()?;
+        let item = self.mailbox.pop_front();
+        if item.is_some() {
+            self.mailbox_work_ids.remove(&work_id);
+            self.revision = revision;
+        }
+        Ok(item)
+    }
+
+    pub fn register_timer(
+        &mut self,
+        fence: &NativeCallFence,
+        timer_id: &str,
+    ) -> Result<(), NativeCallError> {
+        self.resolve_fence(fence, None)?;
+        let timer_id = checked_identifier(timer_id)?;
+        if self.timers.contains(&timer_id) {
+            return Ok(());
+        }
+        if self.timers.len() >= self.bounds.timers_per_call {
+            return Err(NativeCallError::CapacityExhausted);
+        }
+        let revision = self.next_revision()?;
+        self.timers.insert(timer_id);
+        self.revision = revision;
+        Ok(())
+    }
+
+    pub fn release_timer(
+        &mut self,
+        fence: &NativeCallFence,
+        timer_id: &str,
+    ) -> Result<bool, NativeCallError> {
+        self.resolve_fence(fence, None)?;
+        let timer_id = checked_identifier(timer_id)?;
+        if !self.timers.contains(&timer_id) {
+            return Ok(false);
+        }
+        let revision = self.next_revision()?;
+        self.timers.remove(&timer_id);
+        self.revision = revision;
+        Ok(true)
+    }
+
+    fn resolve_authority(&self, fence: &NativeCallFence) -> Result<(), NativeCallError> {
+        if fence.tenant_id != self.tenant_id || fence.call_id != self.call_id {
+            return Err(NativeCallError::AuthorityConflict);
+        }
+        if fence.owner_epoch != self.owner_epoch {
+            return Err(NativeCallError::StaleOwner);
+        }
+        if fence.generation != self.generation {
+            return Err(NativeCallError::StaleGeneration);
+        }
+        Ok(())
+    }
+
+    fn resolve_fence(
+        &self,
+        fence: &NativeCallFence,
+        leg_id: Option<&LegId>,
+    ) -> Result<(), NativeCallError> {
+        self.resolve_authority(fence)?;
+        if fence.expected_revision != self.revision {
+            return Err(NativeCallError::RevisionConflict);
+        }
+        if let Some(leg_id) = leg_id {
+            let leg = self.legs.get(leg_id).ok_or(NativeCallError::LegNotFound)?;
+            if leg.generation != fence.generation {
+                return Err(NativeCallError::StaleGeneration);
+            }
+        }
+        Ok(())
+    }
+
+    fn find_replay(
+        &self,
+        fence: &NativeCallFence,
+        leg_id: &LegId,
+        event_id: &str,
+        event_hash: &str,
+        operation: &str,
+    ) -> Result<Option<StoredReceipt>, NativeCallError> {
+        self.resolve_authority(fence)?;
+        let leg = self.legs.get(leg_id).ok_or(NativeCallError::LegNotFound)?;
+        if leg.generation != fence.generation {
+            return Err(NativeCallError::StaleGeneration);
+        }
+        let Some(stored) = self.dedupe.get(event_id) else {
+            return Ok(None);
+        };
+        if stored.event_hash != event_hash
+            || stored.operation != operation
+            || &stored.leg_id != leg_id
+        {
+            return Err(NativeCallError::EventConflict);
+        }
+        Ok(Some(stored.receipt.clone().replayed()))
+    }
+
+    fn reserve_dedupe(&self) -> Result<(), NativeCallError> {
+        if self.dedupe.len() >= self.bounds.dedupe_receipts_per_call {
+            return Err(NativeCallError::CapacityExhausted);
+        }
+        Ok(())
+    }
+
+    fn remember(
+        &mut self,
+        event_id: String,
+        event_hash: String,
+        operation: String,
+        leg_id: LegId,
+        receipt: StoredReceipt,
+    ) {
+        self.dedupe.insert(
+            event_id,
+            DedupeEntry {
+                event_hash,
+                operation,
+                leg_id,
+                receipt,
+            },
+        );
+    }
+
+    fn next_revision(&self) -> Result<u64, NativeCallError> {
+        self.revision
+            .checked_add(1)
+            .ok_or(NativeCallError::CapacityExhausted)
+    }
+}
+
+fn transition(
+    state: NativeLegState,
+    event: NativeLegEvent,
+) -> Option<(NativeLegState, NativeRequiredEffect)> {
+    use NativeLegEvent as Event;
+    use NativeLegState as State;
+    use NativeRequiredEffect as Effect;
+    match (state, event) {
+        (State::Planned, Event::StartInvite) => Some((State::Inviting, Effect::None)),
+        (State::Inviting, Event::Provisional) => Some((State::Early, Effect::None)),
+        (State::Inviting | State::Early, Event::Final2xx) => {
+            Some((State::Confirmed, Effect::Ack2xx))
+        }
+        (State::Planned, Event::CancelRequested) => {
+            Some((State::Terminating, Effect::CancelIfInviteExists))
+        }
+        (State::Inviting | State::Early, Event::CancelRequested) => {
+            Some((State::Terminating, Effect::SendCancel))
+        }
+        (State::Terminating, Event::LateFinal2xx) => Some((State::Terminating, Effect::AckThenBye)),
+        (State::Confirmed, Event::HoldCommitted) => Some((State::Held, Effect::None)),
+        (State::Held, Event::ResumeCommitted) => Some((State::Confirmed, Effect::None)),
+        (State::Confirmed | State::Held, Event::TransferPrepare) => {
+            Some((State::Transferring, Effect::None))
+        }
+        (State::Transferring, Event::TransferAbort) => Some((State::Confirmed, Effect::None)),
+        (State::Confirmed | State::Held, Event::ByeRequested) => {
+            Some((State::Terminating, Effect::SendBye))
+        }
+        (State::Terminating, Event::TerminationObserved) => Some((State::Terminated, Effect::None)),
+        (
+            State::Planned
+            | State::Inviting
+            | State::Early
+            | State::Confirmed
+            | State::Held
+            | State::Transferring
+            | State::Terminating,
+            Event::ProtocolFailure,
+        ) => Some((State::Failed, Effect::None)),
+        _ => None,
+    }
+}
+
+fn fork_cancellation_effect(state: NativeLegState) -> Option<NativeRequiredEffect> {
+    match state {
+        NativeLegState::Planned => Some(NativeRequiredEffect::CancelIfInviteExists),
+        NativeLegState::Inviting | NativeLegState::Early => Some(NativeRequiredEffect::SendCancel),
+        NativeLegState::Confirmed => Some(NativeRequiredEffect::SendByeNonWinnerAfterAck),
+        _ => None,
+    }
+}
+
+fn checked_identifier(value: &str) -> Result<String, NativeCallError> {
+    if value.is_empty()
+        || value.len() > IDENTIFIER_HARD_CEILING
+        || !value.is_ascii()
+        || !value.bytes().enumerate().all(|(index, byte)| {
+            byte.is_ascii_alphanumeric()
+                || (index > 0 && matches!(byte, b'.' | b'_' | b':' | b'@' | b'/' | b'-'))
+        })
+    {
+        return Err(NativeCallError::InvalidInput);
+    }
+    Ok(value.to_string())
+}
+
+fn checked_hash(value: &str) -> Result<String, NativeCallError> {
+    if value.len() != 64
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(NativeCallError::InvalidInput);
+    }
+    Ok(value.to_string())
+}
