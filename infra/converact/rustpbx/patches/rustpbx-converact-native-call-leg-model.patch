+#[derive(Clone, Debug)]
+enum StoredReceipt {
+    Leg(NativeLegMutationReceipt),
+    Fork(NativeForkSelectionReceipt),
+    Branch(NativeForkBranchReceipt),
+    Transfer(NativeTransferSelectionReceipt),
+    Negotiation(NativeNegotiationReceipt),
+}
+
+impl StoredReceipt {
+    fn replayed(mut self) -> Self {
+        match &mut self {
+            Self::Leg(value) => value.replayed = true,
+            Self::Fork(value) => value.replayed = true,
+            Self::Branch(value) => value.replayed = true,
+            Self::Transfer(value) => value.replayed = true,
+            Self::Negotiation(value) => value.replayed = true,
+        }
+        self
+    }
+}
