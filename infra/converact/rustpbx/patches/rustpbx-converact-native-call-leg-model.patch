+    #[test]
+    fn transitions_are_fenced_and_identical_events_replay_without_mutation() {
+        let mut call = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let leg_id = leg("leg-a");
+        call.add_leg(
+            &call.fence(),
+            leg_id.clone(),
+            ProviderCallId::parse("provider-a").unwrap(),
+            NativeLegDirection::Outbound,
+        )
+        .unwrap();
+
+        let invite_fence = call.fence();
+        let receipt = call
+            .apply_leg_event(
+                &invite_fence,
+                &leg_id,
+                "event-start",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap();
+        assert_eq!(receipt.state, NativeLegState::Inviting);
+        assert_eq!(receipt.required_effect, NativeRequiredEffect::None);
+        assert!(!receipt.replayed);
+
+        let replay = call
+            .apply_leg_event(
+                &invite_fence,
+                &leg_id,
+                "event-start",
+                HASH_A,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap();
+        assert!(replay.replayed);
+        assert_eq!(replay.revision, receipt.revision);
+        assert_eq!(call.snapshot().revision, receipt.revision);
+
+        assert_eq!(
+            call.apply_leg_event(
+                &invite_fence,
+                &leg_id,
+                "event-start",
+                HASH_B,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap_err(),
+            NativeCallError::EventConflict,
+        );
+        assert_eq!(
+            call.apply_leg_event(
+                &invite_fence,
+                &leg_id,
+                "event-final",
+                HASH_B,
+                NativeLegEvent::Final2xx,
+            )
+            .unwrap_err(),
+            NativeCallError::RevisionConflict,
+        );
+
+        let final_receipt = call
+            .apply_leg_event(
+                &call.fence(),
+                &leg_id,
+                "event-final",
+                HASH_B,
+                NativeLegEvent::Final2xx,
+            )
+            .unwrap();
+        assert_eq!(final_receipt.state, NativeLegState::Confirmed);
+        assert_eq!(final_receipt.required_effect, NativeRequiredEffect::Ack2xx);
+    }
