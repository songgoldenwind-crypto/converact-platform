+    #[test]
+    fn transfer_selection_and_negotiation_preserve_one_selected_leg() {
+        let mut call = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let old_leg = leg("old-leg");
+        let new_leg = leg("new-leg");
+        for (leg_id, provider) in [(&old_leg, "provider-a"), (&new_leg, "provider-b")] {
+            call.add_leg(
+                &call.fence(),
+                leg_id.clone(),
+                ProviderCallId::parse(provider).unwrap(),
+                NativeLegDirection::Outbound,
+            )
+            .unwrap();
+        }
+        call.register_fork_branch(
+            &call.fence(),
+            &old_leg,
+            "initial-attempt",
+            "register-old",
+            HASH_A,
+        )
+        .unwrap();
+        call.apply_leg_event(
+            &call.fence(),
+            &old_leg,
+            "start-old",
+            HASH_A,
+            NativeLegEvent::StartInvite,
+        )
+        .unwrap();
+        call.apply_leg_event(
+            &call.fence(),
+            &old_leg,
+            "answer-old",
+            HASH_A,
+            NativeLegEvent::Final2xx,
+        )
+        .unwrap();
+        call.observe_fork_winner(
+            &call.fence(),
+            &old_leg,
+            "initial-attempt",
+            200,
+            "select-old",
+            HASH_A,
+        )
+        .unwrap();
+        call.apply_leg_event(
+            &call.fence(),
+            &old_leg,
+            "prepare-transfer",
+            HASH_A,
+            NativeLegEvent::TransferPrepare,
+        )
+        .unwrap();
+        call.apply_leg_event(
+            &call.fence(),
+            &new_leg,
+            "start-new",
+            HASH_A,
+            NativeLegEvent::StartInvite,
+        )
+        .unwrap();
+        call.apply_leg_event(
+            &call.fence(),
+            &new_leg,
+            "answer-new",
+            HASH_A,
+            NativeLegEvent::Final2xx,
+        )
+        .unwrap();
+
+        let transfer_fence = call.fence();
+        let transfer = call
+            .commit_transfer_selection(
+                &transfer_fence,
+                &old_leg,
+                11,
+                &new_leg,
+                "commit-transfer",
+                HASH_B,
+            )
+            .unwrap();
+        assert_eq!(transfer.selected_leg_id, new_leg);
+        assert_eq!(
+            transfer.required_effect,
+            NativeRequiredEffect::ByeOldSelectedLeg,
+        );
+        assert_eq!(
+            call.leg(&old_leg).unwrap().state,
+            NativeLegState::Terminating,
+        );
+        assert_eq!(call.snapshot().selected_leg_id, Some(new_leg.clone()),);
+        assert!(
+            call.commit_transfer_selection(
+                &transfer_fence,
+                &old_leg,
+                11,
+                &new_leg,
+                "commit-transfer",
+                HASH_B,
+            )
+            .unwrap()
+            .replayed,
+        );
+
+        let accepted = call
+            .advance_negotiation(&call.fence(), &new_leg, "reinvite-accepted", HASH_A, false)
+            .unwrap();
+        assert_eq!(accepted.negotiation_generation, 2);
+        let glare = call
+            .advance_negotiation(&call.fence(), &new_leg, "reinvite-glare", HASH_B, true)
+            .unwrap();
+        assert_eq!(glare.negotiation_generation, 2);
+        assert_eq!(glare.required_effect, NativeRequiredEffect::Retry491Bounded,);
+        assert_eq!(call.snapshot().legs.len(), 2);
+    }
