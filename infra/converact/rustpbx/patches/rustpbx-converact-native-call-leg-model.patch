+            .unwrap();
+        assert_eq!(
+            call.bind_protocol_dialog(&call.fence(), &leg_a, dialog_c, "bind-c", HASH_A,)
+                .unwrap_err(),
+            NativeCallError::CapacityExhausted,
+        );
+        assert_eq!(
+            call.bind_protocol_dialog(&call.fence(), &leg_b, dialog_a, "bind-conflict", HASH_B,)
+                .unwrap_err(),
+            NativeCallError::DialogConflict,
+        );
+    }
