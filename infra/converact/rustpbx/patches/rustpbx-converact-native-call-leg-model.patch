+    #[test]
+    fn durable_fork_winner_cancels_siblings_and_late_non_winner_is_acked_then_ended() {
+        let mut call = NativeCall::new(identity(), NativeCallBounds::default()).unwrap();
+        let winner = leg("winner");
+        let loser = leg("loser");
+        for (leg_id, provider) in [(&winner, "provider-a"), (&loser, "provider-b")] {
+            call.add_leg(
+                &call.fence(),
+                leg_id.clone(),
+                ProviderCallId::parse(provider).unwrap(),
+                NativeLegDirection::Outbound,
+            )
+            .unwrap();
+            call.register_fork_branch(
+                &call.fence(),
+                leg_id,
+                "fork-a",
+                &format!("register-{provider}"),
+                HASH_A,
+            )
+            .unwrap();
+            call.apply_leg_event(
+                &call.fence(),
+                leg_id,
+                &format!("start-{provider}"),
+                HASH_B,
+                NativeLegEvent::StartInvite,
+            )
+            .unwrap();
+        }
+
+        let selected = call
+            .observe_fork_winner(&call.fence(), &winner, "fork-a", 200, "winner-2xx", HASH_A)
+            .unwrap();
+        assert_eq!(selected.selected_leg_id, winner);
+        assert_eq!(selected.required_effect, NativeRequiredEffect::Ack2xx);
+        assert_eq!(selected.branch_effects.len(), 1);
+        assert_eq!(selected.branch_effects[0].leg_id, loser);
+        assert_eq!(
+            selected.branch_effects[0].required_effect,
+            NativeRequiredEffect::SendCancel,
+        );
+
+        call.apply_leg_event(
+            &call.fence(),
+            &winner,
+            "winner-bye",
+            HASH_B,
+            NativeLegEvent::ByeRequested,
+        )
+        .unwrap();
+        let winner_retransmit = call
+            .observe_fork_winner(
+                &call.fence(),
+                &winner,
+                "fork-a",
+                200,
+                "winner-2xx-retransmit",
+                HASH_A,
+            )
+            .unwrap();
+        assert_eq!(
+            winner_retransmit.required_effect,
+            NativeRequiredEffect::AckThenBye,
+        );
+        assert_eq!(
+            call.leg(&winner).unwrap().state,
+            NativeLegState::Terminating,
+        );
+
+        let late = call
+            .observe_fork_winner(&call.fence(), &loser, "fork-a", 200, "loser-2xx", HASH_B)
+            .unwrap();
+        assert_eq!(
+            late.required_effect,
+            NativeRequiredEffect::AckThenByeNonWinner,
+        );
+        assert_eq!(call.leg(&loser).unwrap().state, NativeLegState::Terminating);
+    }
