+use crate::call::domain::foundation_identity::{
+    CallId, InteractionId, LegId, NativeCallIdentity, ProtocolDialogId, ProviderCallId,
+};
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet, VecDeque};
+
+const ACTIVE_CALLS_HARD_CEILING: usize = 1_000_000;
+const LEGS_PER_CALL_DEFAULT: usize = 32;
+const LEGS_PER_CALL_HARD_CEILING: usize = 256;
+const FORK_BRANCHES_PER_ATTEMPT_HARD_CEILING: usize = 32;
+const DIALOG_HISTORY_PER_LEG_HARD_CEILING: usize = 16;
+const MAILBOX_PER_CALL_HARD_CEILING: usize = 1_024;
+const MAILBOX_PER_CALL_DEFAULT: usize = 256;
+const DEDUPE_RECEIPTS_PER_CALL_HARD_CEILING: usize = 2_048;
+const TIMERS_PER_CALL_HARD_CEILING: usize = 128;
+const IDENTIFIER_HARD_CEILING: usize = 128;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum NativeCallError {
+    #[error("native Call input is invalid")]
+    InvalidInput,
+    #[error("native Call authority does not match")]
+    AuthorityConflict,
+    #[error("native Call owner is stale")]
+    StaleOwner,
+    #[error("native Call generation is stale")]
+    StaleGeneration,
+    #[error("native Call revision conflicts")]
+    RevisionConflict,
+    #[error("native Call Leg does not exist")]
+    LegNotFound,
+    #[error("native Call Leg already exists")]
+    LegConflict,
+    #[error("native Call Dialog already belongs to another Leg")]
+    DialogConflict,
+    #[error("native Call event conflicts with an earlier event")]
+    EventConflict,
+    #[error("native Call Leg transition is invalid")]
+    TransitionInvalid,
+    #[error("native Call bounded capacity is exhausted")]
+    CapacityExhausted,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeCallBounds {
+    pub active_calls: usize,
+    pub legs_per_call: usize,
+    pub fork_branches_per_attempt: usize,
+    pub protocol_dialog_history_per_leg: usize,
+    pub mailbox_per_call: usize,
+    pub dedupe_receipts_per_call: usize,
+    pub timers_per_call: usize,
+}
+
+impl Default for NativeCallBounds {
+    fn default() -> Self {
+        Self {
+            active_calls: ACTIVE_CALLS_HARD_CEILING,
+            legs_per_call: LEGS_PER_CALL_DEFAULT,
+            fork_branches_per_attempt: FORK_BRANCHES_PER_ATTEMPT_HARD_CEILING,
+            protocol_dialog_history_per_leg: DIALOG_HISTORY_PER_LEG_HARD_CEILING,
+            mailbox_per_call: MAILBOX_PER_CALL_DEFAULT,
+            dedupe_receipts_per_call: DEDUPE_RECEIPTS_PER_CALL_HARD_CEILING,
+            timers_per_call: TIMERS_PER_CALL_HARD_CEILING,
+        }
+    }
+}
+
+impl NativeCallBounds {
+    fn validate(self) -> Result<Self, NativeCallError> {
+        for (value, maximum) in [
+            (self.active_calls, ACTIVE_CALLS_HARD_CEILING),
+            (self.legs_per_call, LEGS_PER_CALL_HARD_CEILING),
+            (
+                self.fork_branches_per_attempt,
+                FORK_BRANCHES_PER_ATTEMPT_HARD_CEILING,
+            ),
+            (
+                self.protocol_dialog_history_per_leg,
+                DIALOG_HISTORY_PER_LEG_HARD_CEILING,
+            ),
+            (self.mailbox_per_call, MAILBOX_PER_CALL_HARD_CEILING),
+            (
+                self.dedupe_receipts_per_call,
+                DEDUPE_RECEIPTS_PER_CALL_HARD_CEILING,
+            ),
+            (self.timers_per_call, TIMERS_PER_CALL_HARD_CEILING),
+        ] {
+            if value == 0 || value > maximum {
+                return Err(NativeCallError::InvalidInput);
+            }
+        }
+        Ok(self)
+    }
+}
