+pub fn assert_admission_ready(availability_profile: &str) -> Result<()> {
+    let config = config()?.ok_or_else(|| anyhow!("iveKit CDR durable spool is not configured"))?;
+    if !SPOOL_HEALTHY.load(Ordering::Acquire) || !ADMISSION_HEALTHY.load(Ordering::Acquire) {
+        return Err(anyhow!("iveKit CDR durable spool is unhealthy"));
+    }
+    if availability_profile == PROFILE_T1
+        && (!REGION_COMMIT_HEALTHY.load(Ordering::Acquire)
+            || config.region_commit_slots.available_permits() == 0)
+    {
+        return Err(anyhow!("iveKit CDR Region commit capacity is unavailable"));
+    }
+    ensure_spool_directory(&config.spool_dir)?;
+    if let Err(error) = spool_writer(config) {
+        SPOOL_HEALTHY.store(false, Ordering::Release);
+        return Err(error);
+    }
+    Ok(())
+}
+
+pub async fn emit_terminal_cdr(input: TerminalCdrInput) -> Result<()> {
+    let config = config()?.ok_or_else(|| anyhow!("iveKit CDR durable spool is not configured"))?;
+    let requires_region_commit = input.availability_profile == PROFILE_T1;
+    let payload = payload(input, &config.region_id)?;
+    let bytes = serde_json::to_vec(&payload)?;
+    if bytes.len() > MAX_CDR_BYTES {
+        return Err(anyhow!("iveKit CDR exceeds the bounded spool record size"));
+    }
+    let payload_hash = payload_hash(&payload)?;
+    let record_extension = if requires_region_commit {
+        REGION_UPLOAD_CLAIM_EXTENSION
+    } else {
+        SPOOL_RECORD_EXTENSION
+    };
+    let path = persist_terminal_cdr(config, payload, bytes, payload_hash, record_extension).await?;
+    metrics::counter!(
+        "rustpbx_ivekit_cdr_spool_total",
+        "result" => "persisted"
+    )
+    .increment(1);
+    let region_result = if !requires_region_commit {
+        Ok(())
+    } else {
+        let permit = Arc::clone(&config.region_commit_slots)
+            .try_acquire_owned()
+            .map_err(|_| anyhow!("iveKit CDR Region commit capacity is exhausted"));
+        match permit {
+            Ok(permit) => {
+                let result = upload_exact_record(config, &path).await;
+                drop(permit);
+                if result.is_err() {
+                    REGION_COMMIT_HEALTHY.store(false, Ordering::Release);
+                    release_region_upload_claim(&config.spool_dir, &path).await?;
+                }
+                result
+            }
+            Err(error) => {
+                release_region_upload_claim(&config.spool_dir, &path).await?;
+                Err(error)
+            }
+        }
+    };
+    start_uploader()?;
+    region_result
+}
