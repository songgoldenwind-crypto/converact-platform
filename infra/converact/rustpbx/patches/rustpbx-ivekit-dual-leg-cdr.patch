+pub fn stable_cdr_identity_hash(scope: &str, values: &[&str]) -> String {
+    let mut digest = Sha256::new();
+    digest.update((scope.len() as u64).to_be_bytes());
+    digest.update(scope.as_bytes());
+    for value in values {
+        digest.update((value.len() as u64).to_be_bytes());
+        digest.update(value.as_bytes());
+    }
+    lower_hex(&digest.finalize())
+}
+
+fn payload(input: TerminalCdrInput, expected_region_id: &str) -> Result<DualLegCdrEnvelope> {
+    if !valid_identifier(&input.interaction_id)
+        || !valid_provider_call_id(&input.provider_call_id)
+        || !valid_identifier(&input.cell_id)
+        || !valid_identifier(&input.owner_node_id)
+        || !valid_identifier(expected_region_id)
+        || !matches!(
+            input.availability_profile.as_str(),
+            "VOICE-ORDINARY" | "VOICE-HA-T1"
+        )
+        || input.cdr_sequence == 0
+        || input.cdr_sequence > MAX_SAFE_DECIMAL
+        || input.owner_epoch == 0
+        || input.owner_epoch > MAX_SAFE_DECIMAL
+        || (input.availability_profile == "VOICE-HA-T1" && input.owner_epoch > MAX_T1_OWNER_EPOCH)
+        || input.route_snapshot_revision == 0
+        || input.route_snapshot_revision > MAX_SAFE_DECIMAL
+        || input.transfer_chain_hashes.len() > 32
+        || input
+            .transfer_chain_hashes
+            .iter()
+            .any(|value| !valid_hash(value))
+        || input
+            .winning_branch_hash
+            .as_ref()
+            .is_some_and(|value| !valid_hash(value))
+    {
+        return Err(anyhow!("iveKit CDR identity is invalid"));
+    }
+    if !valid_timestamp_range(
+        &input.started_at,
+        input.answered_at.as_deref(),
+        &input.ended_at,
+    ) {
+        return Err(anyhow!("iveKit CDR call timestamps are invalid"));
+    }
+    let owner_epoch = input.owner_epoch.to_string();
+    let route_snapshot_revision = input.route_snapshot_revision.to_string();
+    let caller = leg_summary(
+        "caller",
+        input.caller,
+        &owner_epoch,
+        &route_snapshot_revision,
+    )?;
+    let callee = leg_summary(
+        "callee",
+        input.callee,
+        &owner_epoch,
+        &route_snapshot_revision,
+    )?;
+    Ok(DualLegCdrEnvelope {
+        schema_version: "1.0.0".to_string(),
+        state: "pending_unacknowledged".to_string(),
+        interaction_id: input.interaction_id,
+        provider_call_id: input.provider_call_id,
+        cell_id: input.cell_id,
+        owner_node_id: input.owner_node_id,
+        expected_region_id: expected_region_id.to_string(),
+        availability_profile: input.availability_profile,
+        owner_epoch,
+        sequence: input.cdr_sequence.to_string(),
+        call: CallSummary {
+            winning_branch_hash: input.winning_branch_hash,
+            early_media: input.early_media,
+            transfer_chain_hashes: input.transfer_chain_hashes,
+            media_timeout: input.media_timeout,
+            started_at: input.started_at,
+            answered_at: input.answered_at,
+            ended_at: input.ended_at,
+        },
+        legs: vec![caller, callee],
+    })
+}
+
+fn leg_summary(
+    role: &str,
+    input: TerminalCdrLegInput,
+    owner_epoch: &str,
+    route_snapshot_revision: &str,
+) -> Result<LegSummary> {
+    let expected_direction = if role == "caller" {
+        "inbound"
+    } else {
+        "outbound"
+    };
+    if !valid_hash(&input.dialog_id_hash)
+        || input.direction != expected_direction
+        || (input.sip_final_code != 0 && !(100..=699).contains(&input.sip_final_code))
+        || !valid_timestamp_range(
+            input.answered_at.as_deref().unwrap_or(&input.ended_at),
+            input.answered_at.as_deref(),
+            &input.ended_at,
+        )
+        || (!input.reservation_ref.is_empty() && !valid_identifier(&input.reservation_ref))
+    {
+        return Err(anyhow!("iveKit CDR leg is invalid"));
+    }
+    let media_result = match input.media_result.as_str() {
+        "not_started" | "relayed" | "bypassed" | "transcoded" | "timeout" | "failed" => {
+            input.media_result
+        }
+        _ => return Err(anyhow!("iveKit CDR media result is invalid")),
+    };
+    Ok(LegSummary {
+        role: role.to_string(),
+        dialog_id_hash: input.dialog_id_hash,
+        direction: input.direction,
+        sip_final_code: input.sip_final_code,
+        hangup_cause: token(&input.hangup_cause),
+        answered_at: input.answered_at,
+        ended_at: input.ended_at,
+        media_result,
+        reservation_ref: (!input.reservation_ref.is_empty()).then_some(input.reservation_ref),
+        owner_epoch: owner_epoch.to_string(),
+        route_snapshot_revision: route_snapshot_revision.to_string(),
+    })
+}
+
+fn write_atomic(
+    directory: &Path,
+    payload: &DualLegCdrEnvelope,
+    bytes: &[u8],
+    payload_hash: &str,
+    record_extension: &str,
+) -> Result<()> {
+    ensure_spool_directory(directory)?;
+    if write_atomic_record(directory, payload, bytes, payload_hash, record_extension)? {
+        File::open(directory)?.sync_all()?;
+    }
+    Ok(())
+}
+
+fn write_atomic_record(
+    directory: &Path,
+    payload: &DualLegCdrEnvelope,
+    bytes: &[u8],
+    payload_hash: &str,
+    record_extension: &str,
+) -> Result<bool> {
+    let final_path = spool_record_path(directory, payload, payload_hash, record_extension);
+    if final_path.exists() {
+        return Ok(false);
+    }
+    let temporary = temporary_path(directory, &payload.sequence, payload_hash);
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    drop(file);
+    match std::fs::rename(&temporary, &final_path) {
+        Ok(()) => {}
+        Err(error) if final_path.exists() => {
+            let _ = std::fs::remove_file(&temporary);
+            if error.kind() != std::io::ErrorKind::AlreadyExists {
+                tracing::debug!(error = %error, "iveKit CDR spool replay already exists");
+            }
+        }
+        Err(error) => {
+            let _ = std::fs::remove_file(&temporary);
+            return Err(error.into());
+        }
+    }
+    Ok(true)
+}
+
+fn spool_record_path(
+    directory: &Path,
+    payload: &DualLegCdrEnvelope,
+    payload_hash: &str,
+    record_extension: &str,
+) -> PathBuf {
+    directory.join(format!(
+        "{}.{}.{}",
+        payload.sequence, payload_hash, record_extension
+    ))
+}
+
+fn ensure_spool_directory(directory: &Path) -> Result<()> {
+    std::fs::create_dir_all(directory)?;
+    let metadata = std::fs::symlink_metadata(directory)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(anyhow!("iveKit CDR spool directory is invalid"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(directory, std::fs::Permissions::from_mode(0o700))?;
+    }
+    Ok(())
+}
+
+fn remove_stale_temporary_files(directory: &Path) -> Result<()> {
+    for entry in std::fs::read_dir(directory)? {
+        let path = entry?.path();
+        if path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .is_some_and(|value| {
+                value.starts_with('.')
+                    && value.ends_with(".tmp")
+                    && !temporary_file_belongs_to_current_process(value)
+            })
+        {
+            std::fs::remove_file(path)?;
+        }
+    }
+    File::open(directory)?.sync_all()?;
+    Ok(())
+}
+
+fn recover_region_upload_claims(directory: &Path) -> Result<()> {
+    let claims = std::fs::read_dir(directory)?
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .filter(|path| {
+            path.extension()
+                .is_some_and(|extension| extension == REGION_UPLOAD_CLAIM_EXTENSION)
+        })
+        .collect::<Vec<_>>();
+    for claim in claims {
+        release_region_upload_claim_sync(directory, &claim)?;
+    }
+    Ok(())
+}
+
+async fn release_region_upload_claim(directory: &Path, claim: &Path) -> Result<PathBuf> {
+    let directory = directory.to_path_buf();
+    let claim = claim.to_path_buf();
+    tokio::task::spawn_blocking(move || release_region_upload_claim_sync(&directory, &claim))
+        .await
+        .map_err(|error| anyhow!("iveKit CDR Region claim recovery task failed: {error}"))?
+}
+
+fn release_region_upload_claim_sync(directory: &Path, claim: &Path) -> Result<PathBuf> {
+    if claim.parent() != Some(directory)
+        || claim
+            .extension()
+            .is_none_or(|extension| extension != REGION_UPLOAD_CLAIM_EXTENSION)
+    {
+        return Err(anyhow!("iveKit CDR Region upload claim is invalid"));
+    }
+    let pending = claim.with_extension(SPOOL_RECORD_EXTENSION);
+    if pending.exists() {
+        let claimed_bytes = read_bounded(claim, MAX_CDR_BYTES)?;
+        let pending_bytes = read_bounded(&pending, MAX_CDR_BYTES)?;
+        if claimed_bytes != pending_bytes {
+            return Err(anyhow!(
+                "iveKit CDR Region upload claim conflicts with pending data"
+            ));
+        }
+        std::fs::remove_file(claim)?;
+    } else {
+        std::fs::rename(claim, &pending)?;
+    }
+    File::open(directory)?.sync_all()?;
+    Ok(pending)
+}
+
+fn temporary_file_belongs_to_current_process(name: &str) -> bool {
+    let parts = name.split('.').collect::<Vec<_>>();
+    parts.len() == 6 && parts[3] == process_nonce()
+}
+
+fn temporary_path(directory: &Path, sequence: &str, payload_hash: &str) -> PathBuf {
+    let attempt = TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    directory.join(format!(
+        ".{sequence}.{payload_hash}.{}.{}.tmp",
+        process_nonce(),
+        attempt
+    ))
+}
+
+fn process_nonce() -> &'static str {
+    PROCESS_NONCE.get_or_init(|| {
+        let started = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_nanos();
+        format!("{}-{started:x}", std::process::id())
+    })
+}
+
+async fn persist_terminal_cdr(
+    config: &CdrConfig,
+    payload: DualLegCdrEnvelope,
+    bytes: Vec<u8>,
+    payload_hash: String,
+    record_extension: &'static str,
+) -> Result<PathBuf> {
+    let writer = spool_writer(config)?;
+    persist_with_writer(
+        writer,
+        &config.spool_dir,
+        payload,
+        bytes,
+        payload_hash,
+        record_extension,
+    )
+    .await
+}
+
+fn spool_writer(config: &CdrConfig) -> Result<&'static mpsc::Sender<SpoolWriteRequest>> {
+    match SPOOL_WRITER.get_or_init(|| {
+        spawn_spool_writer(config.spool_dir.clone()).map_err(|error| error.to_string())
+    }) {
+        Ok(writer) => Ok(writer),
+        Err(error) => Err(anyhow!(error.clone())),
+    }
+}
+
+fn spawn_spool_writer(directory: PathBuf) -> Result<mpsc::Sender<SpoolWriteRequest>> {
+    ensure_spool_directory(&directory)?;
+    let (sender, receiver) = mpsc::channel(MAX_SPOOL_WRITER_QUEUE);
+    std::thread::Builder::new()
+        .name("ivekit-cdr-spool".to_string())
+        .spawn(move || spool_writer_loop(directory, receiver))
+        .map_err(|error| anyhow!("iveKit CDR spool writer could not start: {error}"))?;
+    Ok(sender)
+}
+
+async fn persist_with_writer(
+    writer: &mpsc::Sender<SpoolWriteRequest>,
+    directory: &Path,
+    payload: DualLegCdrEnvelope,
+    bytes: Vec<u8>,
+    payload_hash: String,
+    record_extension: &'static str,
+) -> Result<PathBuf> {
+    let path = spool_record_path(directory, &payload, &payload_hash, record_extension);
+    let (acknowledgement, receipt) = oneshot::channel();
+    let request = SpoolWriteRequest {
+        payload,
+        bytes,
+        payload_hash,
+        record_extension,
+        acknowledgement,
+    };
+    match writer.try_send(request) {
+        Ok(()) => {}
+        Err(TrySendError::Full(request)) => {
+            ADMISSION_HEALTHY.store(false, Ordering::Release);
+            metrics::counter!(
+                "rustpbx_ivekit_cdr_spool_total",
+                "result" => "writer_overload_backpressure"
+            )
+            .increment(1);
+            if let Err(error) = writer.send(request).await {
+                return write_direct_fallback(directory, error.0, true).await;
+            }
+        }
+        Err(TrySendError::Closed(request)) => {
+            metrics::counter!(
+                "rustpbx_ivekit_cdr_spool_total",
+                "result" => "writer_disconnected_fallback"
+            )
+            .increment(1);
+            return write_direct_fallback(directory, request, true).await;
+        }
+    }
+    let result = receipt
+        .await
+        .map_err(|_| anyhow!("iveKit CDR spool writer acknowledgement was lost"))
+        .and_then(|result| result.map_err(anyhow::Error::msg));
+    if result.is_err() {
+        SPOOL_HEALTHY.store(false, Ordering::Release);
+    } else {
+        ADMISSION_HEALTHY.store(true, Ordering::Release);
+    }
+    result.map(|()| path)
+}
+
+async fn write_direct_fallback(
+    directory: &Path,
+    request: SpoolWriteRequest,
+    fence_future_admissions: bool,
+) -> Result<PathBuf> {
+    let _guard = EMERGENCY_WRITE_LOCK.lock().await;
+    let directory = directory.to_path_buf();
+    tokio::task::spawn_blocking(move || {
+        write_direct_fallback_blocking(&directory, request, fence_future_admissions)
+    })
+    .await
+    .map_err(|error| anyhow!("iveKit CDR emergency writer task failed: {error}"))?
+}
+
+fn write_direct_fallback_blocking(
+    directory: &Path,
+    request: SpoolWriteRequest,
+    fence_future_admissions: bool,
+) -> Result<PathBuf> {
+    if fence_future_admissions {
+        SPOOL_HEALTHY.store(false, Ordering::Release);
+    }
+    let mut retry_streak = 0_u32;
+    loop {
+        match write_atomic(
+            directory,
+            &request.payload,
+            &request.bytes,
+            &request.payload_hash,
+            request.record_extension,
+        ) {
+            Ok(()) => {
+                ADMISSION_HEALTHY.store(true, Ordering::Release);
+                return Ok(spool_record_path(
+                    directory,
+                    &request.payload,
+                    &request.payload_hash,
+                    request.record_extension,
+                ));
+            }
+            Err(error) => {
+                SPOOL_HEALTHY.store(false, Ordering::Release);
+                retry_streak = retry_streak.saturating_add(1);
+                metrics::counter!(
+                    "rustpbx_ivekit_cdr_spool_total",
+                    "result" => "emergency_retry"
+                )
+                .increment(1);
+                tracing::warn!(
+                    retry_streak,
+                    error = %error,
+                    "iveKit CDR emergency writer is retaining the terminal record"
+                );
+                std::thread::sleep(spool_write_retry_delay(retry_streak));
+            }
+        }
+    }
+}
+
+fn spool_writer_loop(directory: PathBuf, mut receiver: mpsc::Receiver<SpoolWriteRequest>) {
+    while let Some(first) = receiver.blocking_recv() {
+        let mut batch = Vec::with_capacity(MAX_SPOOL_WRITE_BATCH);
+        batch.push(first);
+        while batch.len() < MAX_SPOOL_WRITE_BATCH {
+            match receiver.try_recv() {
+                Ok(request) => batch.push(request),
+                Err(TryRecvError::Empty | TryRecvError::Disconnected) => break,
+            }
+        }
+        let mut pending = batch;
+        let mut retry_streak = 0_u32;
+        while !pending.is_empty() {
+            let mut retry = Vec::new();
+            for (request, result) in write_spool_batch(&directory, pending) {
+                match result {
+                    Ok(()) => {
+                        let _ = request.acknowledgement.send(Ok(()));
+                    }
+                    Err(error) => {
+                        tracing::warn!(
+                            error,
+                            "iveKit CDR spool writer is retaining a failed terminal record"
+                        );
+                        retry.push(request);
+                    }
+                }
+            }
+            if retry.is_empty() {
+                SPOOL_HEALTHY.store(true, Ordering::Release);
+                ADMISSION_HEALTHY.store(true, Ordering::Release);
+                break;
+            }
+            SPOOL_HEALTHY.store(false, Ordering::Release);
+            retry_streak = retry_streak.saturating_add(1);
+            metrics::counter!(
+                "rustpbx_ivekit_cdr_spool_total",
+                "result" => "writer_retry"
+            )
+            .increment(retry.len() as u64);
+            pending = retry;
+            std::thread::sleep(spool_write_retry_delay(retry_streak));
+        }
+    }
+}
+
+fn write_spool_batch(
+    directory: &Path,
+    batch: Vec<SpoolWriteRequest>,
+) -> Vec<(SpoolWriteRequest, std::result::Result<(), String>)> {
+    let mut results = Vec::with_capacity(batch.len());
+    let mut directory_sync_required = false;
+    for request in batch {
+        let result = write_atomic_record(
+            directory,
+            &request.payload,
+            &request.bytes,
+            &request.payload_hash,
+            request.record_extension,
+        )
+        .map(|_| ())
+        .map_err(|error| error.to_string());
+        if result.is_ok() {
+            directory_sync_required = true;
+        }
+        results.push((request, result));
+    }
+    let directory_result = if directory_sync_required {
+        File::open(directory)
+            .and_then(|file| file.sync_all())
+            .map_err(|error| error.to_string())
+    } else {
+        Ok(())
+    };
+    results
+        .into_iter()
+        .map(|(request, result)| {
+            let result = result.and_then(|()| directory_result.clone());
+            (request, result)
+        })
+        .collect()
+}
+
+fn spool_write_retry_delay(retry_streak: u32) -> Duration {
+    let exponent = retry_streak.saturating_sub(1).min(6);
+    Duration::from_millis(
+        25_u64
+            .saturating_mul(1_u64 << exponent)
+            .min(MAX_SPOOL_WRITE_RETRY_MS),
+    )
+}
+
+#[derive(Debug)]
+enum UploadFailure {
+    Retryable(anyhow::Error),
+    Permanent(anyhow::Error),
+}
+
+async fn upload_pending(config: &CdrConfig) -> Result<usize> {
+    let now = SystemTime::now();
+    let service_key_path = config.service_key_path.clone();
+    let spool_dir = config.spool_dir.clone();
+    let scanner = Arc::clone(&config.spool_scanner);
+    let (service_key, scan) = tokio::task::spawn_blocking(move || {
+        let service_key = read_secret(&service_key_path).map_err(anyhow::Error::msg)?;
+        let scan = scan_spool_batch(&spool_dir, &scanner, now, MAX_SCAN_FILES)?;
+        Ok::<_, anyhow::Error>((service_key, scan))
+    })
+    .await
+    .map_err(|error| anyhow!("iveKit CDR spool scan task failed: {error}"))??;
+    metrics::gauge!("rustpbx_ivekit_cdr_spool_backlog").set(scan.backlog as f64);
+    let service_key = service_key.as_str();
+    let results = stream::iter(scan.paths)
+        .map(|path| async move {
+            let result = upload_one(config, service_key, &path).await;
+            (path, result)
+        })
+        .buffer_unordered(MAX_UPLOAD_CONCURRENCY)
+        .collect::<Vec<_>>()
+        .await;
+    let mut retryable_failures = 0;
+    for (path, result) in results {
+        match result {
+            Ok(()) => {}
+            Err(UploadFailure::Retryable(error)) => {
+                retryable_failures += 1;
+                let retry_path = path.clone();
+                tokio::task::spawn_blocking(move || schedule_retry(&retry_path, now))
+                    .await
+                    .map_err(|error| anyhow!("iveKit CDR retry task failed: {error}"))??;
+                tracing::debug!(error = %error, "iveKit CDR upload remains pending");
+            }
+            Err(UploadFailure::Permanent(error)) => {
+                let quarantine_directory = config.spool_dir.clone();
+                let quarantine_path = path.clone();
+                let quarantine = tokio::task::spawn_blocking(move || {
+                    quarantine_permanent_failure(&quarantine_directory, &quarantine_path)
+                })
+                .await
+                .map_err(|join_error| anyhow!("iveKit CDR quarantine task failed: {join_error}"))?;
+                if let Err(quarantine_error) = quarantine {
+                    retryable_failures += 1;
+                    tracing::warn!(
+                        error = %quarantine_error,
+                        "iveKit CDR permanent failure could not be quarantined"
+                    );
+                } else {
+                    metrics::counter!(
+                        "rustpbx_ivekit_cdr_upload_total",
+                        "result" => "quarantined"
+                    )
+                    .increment(1);
+                    tracing::error!(
+                        error = %error,
+                        "iveKit CDR record quarantined after permanent failure"
+                    );
+                }
+            }
+        }
+    }
+    Ok(retryable_failures)
+}
+
+async fn upload_exact_record(config: &CdrConfig, path: &Path) -> Result<()> {
+    let service_key_path = config.service_key_path.clone();
+    let service_key = tokio::task::spawn_blocking(move || read_secret(&service_key_path))
+        .await
+        .map_err(|error| anyhow!("iveKit CDR service-key task failed: {error}"))?
+        .map_err(anyhow::Error::msg)?;
+    match upload_one(config, &service_key, path).await {
+        Ok(()) => Ok(()),
+        Err(UploadFailure::Retryable(error) | UploadFailure::Permanent(error)) => Err(error),
+    }
+}
+
+fn scan_spool_batch(
+    spool_dir: &Path,
+    scanner: &Mutex<SpoolScanner>,
+    now: SystemTime,
+    max_entries: usize,
+) -> Result<SpoolScanBatch> {
+    let mut scanner = scanner
+        .lock()
+        .map_err(|_| anyhow!("iveKit CDR spool scanner lock is poisoned"))?;
+    if scanner.entries.is_none() {
+        scanner.entries = Some(std::fs::read_dir(spool_dir)?);
+        scanner.cycle_backlog = 0;
+    }
+    let mut paths = Vec::with_capacity(max_entries);
+    for _ in 0..max_entries {
+        let next = scanner
+            .entries
+            .as_mut()
+            .expect("spool scanner is initialized")
+            .next();
+        let Some(entry) = next else {
+            scanner.entries = None;
+            scanner.last_complete_backlog = scanner.cycle_backlog;
+            scanner.cycle_backlog = 0;
+            return Ok(SpoolScanBatch {
+                paths,
+                backlog: scanner.last_complete_backlog,
+            });
+        };
+        let path = entry?.path();
+        if path.extension().is_none_or(|extension| extension != "json") {
+            continue;
+        }
+        scanner.cycle_backlog = scanner.cycle_backlog.saturating_add(1);
+        match retry_ready(&path, now) {
+            Ok(true) => paths.push(path),
+            Ok(false) => {}
+            Err(error) => {
+                tracing::warn!(
+                    path = %path.display(),
+                    error = %error,
+                    "iveKit CDR retry metadata is invalid; retrying the record"
+                );
+                let _ = std::fs::remove_file(retry_metadata_path(&path));
+                paths.push(path);
+            }
+        }
+    }
+    Ok(SpoolScanBatch {
+        paths,
+        backlog: scanner.last_complete_backlog.max(scanner.cycle_backlog),
+    })
+}
+
+async fn upload_one(
+    config: &CdrConfig,
+    service_key: &str,
+    path: &Path,
+) -> std::result::Result<(), UploadFailure> {
+    let read_path = path.to_path_buf();
+    let (bytes, payload, expected_hash) = tokio::task::spawn_blocking(move || {
+        let bytes = read_bounded(&read_path, MAX_CDR_BYTES)?;
+        let payload: DualLegCdrEnvelope = serde_json::from_slice(&bytes)?;
+        let expected_hash = payload_hash(&payload)?;
+        Ok::<_, anyhow::Error>((bytes, payload, expected_hash))
+    })
+    .await
+    .map_err(|error| UploadFailure::Retryable(anyhow!("iveKit CDR read task failed: {error}")))?
+    .map_err(UploadFailure::Permanent)?;
+    let response = config
+        .client
+        .post(config.endpoint.clone())
+        .header("x-pbx-key", service_key)
+        .header("content-type", "application/json")
+        .body(bytes)
+        .send()
+        .await
+        .map_err(|error| UploadFailure::Retryable(error.into()))?;
+    if response.status() != reqwest::StatusCode::OK {
+        let error = anyhow!("iveKit CDR endpoint returned {}", response.status());
+        return if retryable_status(response.status()) {
+            Err(UploadFailure::Retryable(error))
+        } else {
+            Err(UploadFailure::Permanent(error))
+        };
+    }
+    let receipt_bytes = bounded_response(response, MAX_RECEIPT_BYTES)
+        .await
+        .map_err(UploadFailure::Permanent)?;
+    let envelope: Value = serde_json::from_slice(&receipt_bytes)
+        .map_err(|error| UploadFailure::Permanent(error.into()))?;
+    let receipt_data = envelope.get("data").cloned().ok_or_else(|| {
+        UploadFailure::Permanent(anyhow!("iveKit CDR receipt envelope is invalid"))
+    })?;
+    let receipt: DurableReceipt = serde_json::from_value(receipt_data)
+        .map_err(|error| UploadFailure::Permanent(error.into()))?;
+    validate_receipt(&payload, &expected_hash, &config.region_id, &receipt)
+        .map_err(UploadFailure::Permanent)?;
+    let committed_path = path.to_path_buf();
+    let spool_dir = config.spool_dir.clone();
+    tokio::task::spawn_blocking(move || finalize_uploaded_record(&spool_dir, &committed_path))
+        .await
+        .map_err(|error| {
+            UploadFailure::Retryable(anyhow!("iveKit CDR finalize task failed: {error}"))
+        })?
+        .map_err(UploadFailure::Retryable)?;
+    metrics::counter!(
+        "rustpbx_ivekit_cdr_upload_total",
+        "result" => "committed"
+    )
+    .increment(1);
+    REGION_COMMIT_HEALTHY.store(true, Ordering::Release);
+    Ok(())
+}
+
+fn finalize_uploaded_record(spool_dir: &Path, path: &Path) -> Result<()> {
+    std::fs::remove_file(path)?;
+    let retry_metadata = retry_metadata_path(path);
+    if retry_metadata.exists() {
+        std::fs::remove_file(retry_metadata)?;
+    }
+    File::open(spool_dir)?.sync_all()?;
+    Ok(())
+}
+
+fn retry_metadata_path(path: &Path) -> PathBuf {
+    let name = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .unwrap_or("invalid");
+    path.with_file_name(format!(".{name}.retry"))
+}
+
+fn retry_ready(path: &Path, now: SystemTime) -> Result<bool> {
+    let metadata_path = retry_metadata_path(path);
+    if !metadata_path.exists() {
+        return Ok(true);
+    }
+    let bytes = read_bounded(&metadata_path, MAX_RETRY_METADATA_BYTES)?;
+    let schedule: RetrySchedule = serde_json::from_slice(&bytes)?;
+    Ok(unix_millis(now) >= schedule.next_attempt_unix_ms)
+}
+
+fn schedule_retry(path: &Path, now: SystemTime) -> Result<()> {
+    let metadata_path = retry_metadata_path(path);
+    let previous = if metadata_path.exists() {
+        read_bounded(&metadata_path, MAX_RETRY_METADATA_BYTES)
+            .ok()
+            .and_then(|bytes| serde_json::from_slice::<RetrySchedule>(&bytes).ok())
+    } else {
+        None
+    };
+    let attempts = previous
+        .map(|schedule| schedule.attempts)
+        .unwrap_or(0)
+        .saturating_add(1);
+    let delay = retry_record_delay(path, attempts);
+    let schedule = RetrySchedule {
+        attempts,
+        next_attempt_unix_ms: unix_millis(now)
+            .saturating_add(u64::try_from(delay.as_millis()).unwrap_or(u64::MAX)),
+    };
+    write_private_atomic(&metadata_path, &serde_json::to_vec(&schedule)?)
+}
+
+fn retry_record_delay(path: &Path, attempts: u32) -> Duration {
+    let multiplier = 1_u64 << attempts.min(7);
+    let base_ms = 500_u64.saturating_mul(multiplier);
+    let mut digest = Sha256::new();
+    digest.update(path.as_os_str().as_encoded_bytes());
+    digest.update(attempts.to_be_bytes());
+    let hash = digest.finalize();
+    let jitter_ms = u16::from_be_bytes([hash[0], hash[1]]) as u64 % 251;
+    Duration::from_millis(base_ms.saturating_add(jitter_ms).min(60_000))
+}
+
+fn unix_millis(time: SystemTime) -> u64 {
+    u64::try_from(
+        time.duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis(),
+    )
+    .unwrap_or(u64::MAX)
+}
+
+fn write_private_atomic(destination: &Path, bytes: &[u8]) -> Result<()> {
+    if bytes.len() > MAX_RETRY_METADATA_BYTES {
+        return Err(anyhow!("iveKit CDR retry metadata exceeds the limit"));
+    }
+    let parent = destination
+        .parent()
+        .ok_or_else(|| anyhow!("iveKit CDR retry metadata path is invalid"))?;
+    let name = destination
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| anyhow!("iveKit CDR retry metadata path is invalid"))?;
+    let temporary = parent.join(format!(
+        ".{name}.{}.{}.tmp",
+        process_nonce(),
+        TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed)
+    ));
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temporary)?;
+    let write_result = (|| -> Result<()> {
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        drop(file);
+        std::fs::rename(&temporary, destination)?;
+        File::open(parent)?.sync_all()?;
+        Ok(())
+    })();
+    if write_result.is_err() {
+        let _ = std::fs::remove_file(temporary);
+    }
+    write_result
+}
+
+fn retryable_status(status: reqwest::StatusCode) -> bool {
+    status.is_server_error()
+        || matches!(
+            status,
+            reqwest::StatusCode::ACCEPTED
+                | reqwest::StatusCode::UNAUTHORIZED
+                | reqwest::StatusCode::FORBIDDEN
+                | reqwest::StatusCode::NOT_FOUND
+                | reqwest::StatusCode::REQUEST_TIMEOUT
+                | reqwest::StatusCode::TOO_EARLY
+                | reqwest::StatusCode::TOO_MANY_REQUESTS
+        )
+}
+
+fn quarantine_permanent_failure(directory: &Path, path: &Path) -> Result<()> {
+    let quarantine = directory.join("quarantine");
+    ensure_spool_directory(&quarantine)?;
+    let name = path
+        .file_name()
+        .ok_or_else(|| anyhow!("iveKit CDR quarantine source is invalid"))?;
+    let destination = quarantine.join(name);
+    if destination.exists() {
+        std::fs::remove_file(path)?;
+    } else {
+        std::fs::rename(path, destination)?;
+    }
+    let retry_metadata = retry_metadata_path(path);
+    if retry_metadata.exists() {
+        std::fs::remove_file(retry_metadata)?;
+    }
+    File::open(directory)?.sync_all()?;
+    File::open(&quarantine)?.sync_all()?;
+    Ok(())
+}
+
+fn retry_delay(poll_interval: Duration, retry_streak: u32) -> Duration {
+    if retry_streak == 0 {
+        return poll_interval;
+    }
+    let multiplier = 1_u32 << retry_streak.min(6);
+    let base = poll_interval.saturating_mul(multiplier);
+    let jitter = Duration::from_millis(TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed) % 251);
+    base.saturating_add(jitter).min(Duration::from_secs(60))
+}
+
+fn validate_receipt(
+    payload: &DualLegCdrEnvelope,
+    expected_hash: &str,
+    expected_region_id: &str,
+    receipt: &DurableReceipt,
+) -> Result<()> {
+    let committed_sequence = receipt
+        .committed_sequence
+        .as_deref()
+        .ok_or_else(|| anyhow!("iveKit CDR committed sequence is missing"))?
+        .parse::<u64>()
+        .map_err(|_| anyhow!("iveKit CDR committed sequence is invalid"))?;
+    if receipt.schema_version != "1.0.0"
+        || receipt.state != "committed"
+        || receipt.receipt_id.as_deref().is_none_or(str::is_empty)
+        || receipt.interaction_id != payload.interaction_id
+        || receipt.provider_call_id != payload.provider_call_id
+        || receipt.acknowledged_sequence != payload.sequence
+        || receipt.acknowledged_payload_hash != expected_hash
+        || committed_sequence
+            < payload
+                .sequence
+                .parse::<u64>()
+                .map_err(|_| anyhow!("iveKit CDR sequence is invalid"))?
+        || receipt.region_id.as_deref() != Some(expected_region_id)
+        || receipt
+            .durability_contract_id
+            .as_deref()
+            .is_none_or(str::is_empty)
+        || receipt.committed_at.as_deref().is_none_or(str::is_empty)
+    {
+        return Err(anyhow!("iveKit CDR durable receipt validation failed"));
+    }
+    let _ = receipt.replayed;
+    Ok(())
+}
+
+fn config() -> Result<Option<&'static CdrConfig>> {
+    match CONFIG.get_or_init(load_config) {
+        Ok(value) => Ok(value.as_ref()),
+        Err(error) => Err(anyhow!(error.clone())),
+    }
+}
+
+fn load_config() -> std::result::Result<Option<CdrConfig>, String> {
+    let spool = std::env::var("IVEKIT_RUSTPBX_CDR_SPOOL_DIR").ok();
+    let endpoint = std::env::var("IVEKIT_RUSTPBX_CDR_ENDPOINT").ok();
+    let service_key_file = std::env::var("IVEKIT_RUSTPBX_CDR_SERVICE_KEY_FILE").ok();
+    let region_id = std::env::var("IVEKIT_RUSTPBX_CDR_REGION_ID").ok();
+    if spool.is_none() && endpoint.is_none() && service_key_file.is_none() && region_id.is_none() {
+        return Ok(None);
+    }
+    let spool_dir = PathBuf::from(required(spool, "IVEKIT_RUSTPBX_CDR_SPOOL_DIR")?.as_str());
+    if !spool_dir.is_absolute() || spool_dir.components().any(|part| part.as_os_str() == "..") {
+        return Err("iveKit CDR spool path is invalid".to_string());
+    }
+    let endpoint = Url::parse(&required(endpoint, "IVEKIT_RUSTPBX_CDR_ENDPOINT")?)
+        .map_err(|_| "iveKit CDR endpoint is invalid".to_string())?;
+    if endpoint.scheme() != "https"
+        && std::env::var("RUSTPBX_ENV")
+            .map(|value| value == "production")
+            .unwrap_or(false)
+    {
+        return Err("iveKit CDR endpoint must use HTTPS in production".to_string());
+    }
+    let service_key_path = PathBuf::from(required(
+        service_key_file,
+        "IVEKIT_RUSTPBX_CDR_SERVICE_KEY_FILE",
+    )?);
+    read_secret(&service_key_path)?;
+    let cell_id = required(
+        std::env::var("IVEKIT_RUSTPBX_CELL_ID").ok(),
+        "IVEKIT_RUSTPBX_CELL_ID",
+    )?;
+    let owner_node_id = required(
+        std::env::var("IVEKIT_RUSTPBX_OWNER_NODE_ID").ok(),
+        "IVEKIT_RUSTPBX_OWNER_NODE_ID",
+    )?;
+    let region_id = required(region_id, "IVEKIT_RUSTPBX_CDR_REGION_ID")?;
+    if !valid_identifier(&cell_id)
+        || !valid_identifier(&owner_node_id)
+        || !valid_identifier(&region_id)
+    {
+        return Err("iveKit CDR node identity is invalid".to_string());
+    }
+    let poll_ms = std::env::var("IVEKIT_RUSTPBX_CDR_POLL_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(500)
+        .clamp(100, 60_000);
+    let client = reqwest::Client::builder()
+        .connect_timeout(Duration::from_secs(2))
+        .timeout(Duration::from_secs(5))
+        .redirect(reqwest::redirect::Policy::none())
+        .no_gzip()
+        .build()
+        .map_err(|error| format!("iveKit CDR HTTP client failed: {error}"))?;
+    Ok(Some(CdrConfig {
+        spool_dir,
+        endpoint,
+        service_key_path,
+        region_id,
+        cell_id,
+        owner_node_id,
+        client,
+        poll_interval: Duration::from_millis(poll_ms),
+        spool_scanner: Arc::new(Mutex::new(SpoolScanner::default())),
+        region_commit_slots: Arc::new(Semaphore::new(REGION_COMMIT_MAX_CONCURRENT)),
+    }))
+}
+
+fn read_secret(path: &Path) -> std::result::Result<String, String> {
+    let link_metadata = std::fs::symlink_metadata(path)
+        .map_err(|_| "iveKit CDR service key file is unavailable".to_string())?;
+    let metadata = std::fs::metadata(path)
+        .map_err(|_| "iveKit CDR service key file is unavailable".to_string())?;
+    if !metadata.is_file() {
+        return Err("iveKit CDR service key file is invalid".to_string());
+    }
+    if link_metadata.file_type().is_symlink() {
+        let parent = path
+            .parent()
+            .ok_or_else(|| "iveKit CDR service key file is invalid".to_string())?;
+        let canonical_parent = std::fs::canonicalize(parent)
+            .map_err(|_| "iveKit CDR service key file is invalid".to_string())?;
+        let canonical_target = std::fs::canonicalize(path)
+            .map_err(|_| "iveKit CDR service key file is invalid".to_string())?;
+        if !canonical_target.starts_with(canonical_parent) {
+            return Err("iveKit CDR service key file is invalid".to_string());
+        }
+    } else if !link_metadata.is_file() {
+        return Err("iveKit CDR service key file is invalid".to_string());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode = metadata.permissions().mode() & 0o777;
+        if mode & 0o137 != 0 || mode & 0o400 == 0 {
+            return Err("iveKit CDR service key file permissions are too broad".to_string());
+        }
+    }
+    let mut value = String::new();
+    File::open(path)
+        .and_then(|file| file.take(4097).read_to_string(&mut value))
+        .map_err(|_| "iveKit CDR service key file cannot be read".to_string())?;
+    let value = value.trim();
+    if !(32..=4096).contains(&value.len()) || value.chars().any(char::is_control) {
+        return Err("iveKit CDR service key is invalid".to_string());
+    }
+    Ok(value.to_string())
+}
+
+fn payload_hash(payload: &DualLegCdrEnvelope) -> Result<String> {
+    let value = serde_json::to_value(payload)?;
+    Ok(lower_hex(&Sha256::digest(
+        canonical_json(&value)?.as_bytes(),
+    )))
+}
+
+fn canonical_json(value: &Value) -> Result<String> {
+    match value {
+        Value::Null | Value::Bool(_) | Value::Number(_) | Value::String(_) => {
+            Ok(serde_json::to_string(value)?)
+        }
+        Value::Array(values) => {
+            let encoded = values
+                .iter()
+                .map(canonical_json)
+                .collect::<Result<Vec<_>>>()?;
+            Ok(format!("[{}]", encoded.join(",")))
+        }
+        Value::Object(values) => {
+            let ordered = values
+                .iter()
+                .map(|(key, value)| Ok((key, canonical_json(value)?)))
+                .collect::<Result<BTreeMap<_, _>>>()?;
+            let encoded = ordered
+                .into_iter()
+                .map(|(key, value)| Ok(format!("{}:{value}", serde_json::to_string(key)?)))
+                .collect::<Result<Vec<_>>>()?;
+            Ok(format!("{{{}}}", encoded.join(",")))
+        }
+    }
+}
+
+async fn bounded_response(mut response: reqwest::Response, maximum: usize) -> Result<Vec<u8>> {
+    if response
+        .content_length()
+        .is_some_and(|length| length > maximum as u64)
+    {
+        return Err(anyhow!("iveKit CDR receipt exceeds the response limit"));
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await? {
+        if bytes.len().saturating_add(chunk.len()) > maximum {
+            return Err(anyhow!("iveKit CDR receipt exceeds the response limit"));
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(bytes)
+}
+
+fn read_bounded(path: &Path, maximum: usize) -> Result<Vec<u8>> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_file() || metadata.len() > maximum as u64 {
+        return Err(anyhow!("iveKit CDR spool record is invalid"));
+    }
+    let mut bytes = Vec::with_capacity(metadata.len() as usize);
+    File::open(path)?
+        .take(maximum as u64 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > maximum {
+        return Err(anyhow!("iveKit CDR spool record exceeds the limit"));
+    }
+    Ok(bytes)
+}
+
+fn required(value: Option<String>, name: &str) -> std::result::Result<String, String> {
+    value
+        .filter(|value| !value.trim().is_empty())
+        .ok_or_else(|| format!("{name} is required when iveKit CDR is configured"))
+}
+
+fn valid_identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"_.:/-".contains(&byte))
+}
+
+fn valid_provider_call_id(value: &str) -> bool {
+    !value.is_empty() && value.len() <= 256 && !value.bytes().any(|byte| byte.is_ascii_control())
+}
+
+fn valid_hash(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn valid_timestamp_range(started_at: &str, answered_at: Option<&str>, ended_at: &str) -> bool {
+    let Ok(started) = chrono::DateTime::parse_from_rfc3339(started_at) else {
+        return false;
+    };
+    let Ok(ended) = chrono::DateTime::parse_from_rfc3339(ended_at) else {
+        return false;
+    };
+    if ended < started {
+        return false;
+    }
+    answered_at.is_none_or(|value| {
+        chrono::DateTime::parse_from_rfc3339(value)
+            .is_ok_and(|answered| answered >= started && answered <= ended)
+    })
+}
+
+fn token(value: &str) -> String {
+    let mut result = String::with_capacity(value.len().min(64));
+    for character in value.chars() {
+        if result.len() >= 64 {
+            break;
+        }
+        let character = character.to_ascii_lowercase();
+        if character.is_ascii_alphanumeric() {
+            result.push(character);
+        } else if !result.ends_with('_') {
+            result.push('_');
+        }
+    }
+    let result = result.trim_matches('_');
+    if result.is_empty() {
+        "unknown".to_string()
+    } else {
+        result.to_string()
+    }
+}
+
+fn lower_hex(bytes: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let mut value = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        value.push(HEX[(byte >> 4) as usize] as char);
+        value.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    value
+}
