+pub async fn emit_recovered_terminal_cdr(
+    payloads: &[crate::ivekit_dialog_shadow::DialogRecoveryCapsulePayload],
+    owner_epoch: u64,
+    reason: &str,
+    cdr_sequence: u64,
+    ended_at: &str,
+) -> Result<()> {
+    if payloads.len() != 2 || cdr_sequence == 0 {
+        return Err(anyhow!("recovered CDR requires exactly two dialog legs"));
+    }
+    let caller = payloads
+        .iter()
+        .find(|payload| payload.leg == "caller")
+        .ok_or_else(|| anyhow!("recovered caller CDR leg is missing"))?;
+    let callee = payloads
+        .iter()
+        .find(|payload| payload.leg == "callee")
+        .ok_or_else(|| anyhow!("recovered callee CDR leg is missing"))?;
+    if caller.interaction_id != callee.interaction_id
+        || caller.call_session_ref != callee.call_session_ref
+        || caller.route_snapshot_revision != callee.route_snapshot_revision
+        || caller.started_at != callee.started_at
+        || caller.answered_at != callee.answered_at
+    {
+        return Err(anyhow!("recovered CDR leg binding mismatch"));
+    }
+    let ended_at = chrono::DateTime::parse_from_rfc3339(ended_at)
+        .map_err(|_| anyhow!("recovered CDR ended_at is invalid"))?
+        .to_utc()
+        .to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+    let started_at = caller
+        .started_at
+        .clone()
+        .unwrap_or_else(|| ended_at.clone());
+    let (cell_id, owner_node_id) = node_identity()?;
+    let cause = token(reason);
+    emit_terminal_cdr(TerminalCdrInput {
+        cell_id,
+        owner_node_id,
+        availability_profile: PROFILE_T1.to_string(),
+        interaction_id: caller.interaction_id.clone(),
+        provider_call_id: caller.call_session_ref.clone(),
+        cdr_sequence,
+        started_at,
+        answered_at: caller.answered_at.clone(),
+        ended_at: ended_at.clone(),
+        caller: TerminalCdrLegInput {
+            dialog_id_hash: caller.dialog_id.clone(),
+            direction: "inbound".to_string(),
+            sip_final_code: 200,
+            hangup_cause: cause.clone(),
+            answered_at: caller.answered_at.clone(),
+            ended_at: ended_at.clone(),
+            media_result: "relayed".to_string(),
+            reservation_ref: recovered_leg_reservation(&caller.media_reservation_id, "caller"),
+        },
+        callee: TerminalCdrLegInput {
+            dialog_id_hash: callee.dialog_id.clone(),
+            direction: "outbound".to_string(),
+            sip_final_code: 200,
+            hangup_cause: cause,
+            answered_at: callee.answered_at.clone(),
+            ended_at,
+            media_result: "relayed".to_string(),
+            reservation_ref: recovered_leg_reservation(&callee.media_reservation_id, "callee"),
+        },
+        owner_epoch,
+        route_snapshot_revision: caller.route_snapshot_revision,
+        winning_branch_hash: Some(callee.dialog_id.clone()),
+        early_media: false,
+        transfer_chain_hashes: Vec::new(),
+        media_timeout: reason.to_ascii_lowercase().contains("timeout"),
+    })
+    .await
+}
