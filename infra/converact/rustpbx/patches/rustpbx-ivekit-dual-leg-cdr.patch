+    pub async fn begin_termination_pair(
+        &mut self,
+        reason: &str,
+    ) -> Result<Option<DialogShadowPairCommitProof>, DialogShadowError> {
+        if reason.is_empty() || reason.len() > 4096 {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        let mut events = match self {
+            Self::Disabled => return Ok(None),
+            Self::FailClosed { .. } => return Err(DialogShadowError::Unavailable),
+            Self::Ready { dialogs, .. } => dialogs
+                .values()
+                .filter_map(|lifecycle| lifecycle.termination_event(reason))
+                .collect::<Vec<_>>(),
+        };
+        if events.is_empty() {
+            return Ok(None);
+        }
+        if events.len() != 2 {
+            return Err(DialogShadowError::ReconcileRequired);
+        }
+        self.commit_pair([events.remove(0), events.remove(0)]).await
+    }
 }
 
