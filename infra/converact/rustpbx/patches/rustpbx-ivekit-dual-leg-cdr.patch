+#[allow(clippy::too_many_arguments)]
+async fn finalize_recovered_dialog_pair(
+    config: &DialogShadowRuntimeConfig,
+    tenant_id: &str,
+    cell_id: &str,
+    owner_node_id: &str,
+    owner_fault_domain: &str,
+    claim: &DialogOwnerTakeoverClaimResponse,
+    call_session_ref: &str,
+    interaction_id: &str,
+    auth_context_ref: &str,
+    payloads: &[DialogRecoveryCapsulePayload],
+) -> Result<(), DialogShadowError> {
+    commit_recovered_shadow_pair(
+        config,
+        tenant_id,
+        cell_id,
+        owner_node_id,
+        owner_fault_domain,
+        claim.owner_epoch,
+        &claim.takeover_id,
+        call_session_ref,
+        auth_context_ref,
+        payloads,
+        DialogShadowState::Terminating,
+    )
+    .await?;
+    let consume_request = DialogOwnerTakeoverConsumeRequest {
+        tenant_id: tenant_id.to_string(),
+        cell_id: cell_id.to_string(),
+        call_session_ref: call_session_ref.to_string(),
+        takeover_id: claim.takeover_id.clone(),
+        owner_epoch: claim.owner_epoch,
+        takeover_token: claim.takeover_token.clone(),
+    };
+    let consumed = config
+        .executor
+        .consume_takeover(&consume_request, owner_node_id)
+        .await;
+    let authority_active = if consumed.is_ok() {
+        true
+    } else {
+        config
+            .executor
+            .check_authority(
+                &DialogOwnerAuthorityRequest {
+                    tenant_id: tenant_id.to_string(),
+                    cell_id: cell_id.to_string(),
+                    call_session_ref: call_session_ref.to_string(),
+                    owner_epoch: claim.owner_epoch,
+                },
+                owner_node_id,
+            )
+            .await
+            .is_ok_and(|authority| authority.status == "active")
+    };
+    if !authority_active {
+        return Err(DialogShadowError::OutcomeUnknown);
+    }
+    let callee = payloads
+        .iter()
+        .find(|payload| payload.leg == "callee")
+        .ok_or(DialogShadowError::InvalidRecord)?;
+    let reservation_id = callee
+        .media_reservation_id
+        .strip_suffix("/callee")
+        .ok_or(DialogShadowError::InvalidRecord)?
+        .to_string();
+    if crate::ivekit_owner::ensure_owner(
+        call_session_ref,
+        crate::ivekit_owner::OwnerContract {
+            reservation_id,
+            interaction_id: interaction_id.to_string(),
+            owner_epoch: claim.owner_epoch.to_string(),
+            route_snapshot_revision: callee.route_snapshot_revision,
+            availability_profile: PROFILE_T1.to_string(),
+            auth_context_ref: Some(auth_context_ref.to_string()),
+        },
+    )
+    .await
+    .is_err()
+    {
+        return Err(DialogShadowError::Unavailable);
+    }
+    let previous_sequence = payloads
+        .iter()
+        .map(|payload| payload.cdr_sequence)
+        .max()
+        .unwrap_or_default();
+    let cdr_sequence =
+        crate::ivekit_dual_leg_cdr::fenced_recovered_sequence(previous_sequence, claim.owner_epoch);
+    if cdr_sequence > 9_007_199_254_740_991 {
+        return Err(DialogShadowError::SequenceExhausted);
+    }
+    let mut final_payloads = payloads.to_vec();
+    for payload in &mut final_payloads {
+        payload.cdr_sequence = cdr_sequence;
+    }
+    let context = RecoveredShadowPairContext {
+        tenant_id: tenant_id.to_string(),
+        cell_id: cell_id.to_string(),
+        owner_node_id: owner_node_id.to_string(),
+        owner_fault_domain: owner_fault_domain.to_string(),
+        owner_epoch: claim.owner_epoch,
+        takeover_id: claim.takeover_id.clone(),
+        call_session_ref: call_session_ref.to_string(),
+        auth_context_ref: auth_context_ref.to_string(),
+    };
+    let terminal_request = recovered_shadow_pair_request(
+        &context,
+        &config.recovery_codec,
+        &final_payloads,
+        DialogShadowState::Terminated,
+        2,
+        Some("recovered_termination_finalize"),
+        None,
+        None,
+    )?;
+    let ended_at = chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+    let cdr_committed = crate::ivekit_dual_leg_cdr::emit_recovered_terminal_cdr(
+        &final_payloads,
+        context.owner_epoch,
+        "recovered_termination_finalize",
+        cdr_sequence,
+        &ended_at,
+    )
+    .await
+    .is_ok();
+    if cdr_committed {
+        match config.executor.commit_pair(&terminal_request).await {
+            Ok(_) => crate::ivekit_owner::close_owner(call_session_ref).await,
+            Err(error) => {
+                tracing::warn!(
+                    %call_session_ref,
+                    error = %error,
+                    "recovered terminal shadow remains pending; background shadow retry started"
+                );
+                spawn_recovered_terminal_shadow_retry(
+                    Arc::clone(&config.executor),
+                    terminal_request,
+                    call_session_ref.to_string(),
+                );
+            }
+        }
+    } else {
+        tracing::warn!(
+            %call_session_ref,
+            "recovered terminal CDR remains pending; background exact CDR retry started"
+        );
+        spawn_recovered_cdr_then_shadow_retry(
+            Arc::clone(&config.executor),
+            terminal_request,
+            final_payloads,
+            context.owner_epoch,
+            cdr_sequence,
+            ended_at,
+            call_session_ref.to_string(),
+        );
+    }
+    Ok(())
+}
+
+fn spawn_recovered_terminal_shadow_retry(
+    executor: Arc<DialogShadowHttpClient>,
+    request: DialogShadowCommitPairRequest,
+    call_session_ref: String,
+) {
+    crate::utils::spawn(async move {
+        retry_recovered_terminal_shadow(&executor, &request, &call_session_ref).await;
+    });
+}
+
+fn spawn_recovered_cdr_then_shadow_retry(
+    executor: Arc<DialogShadowHttpClient>,
+    request: DialogShadowCommitPairRequest,
+    payloads: Vec<DialogRecoveryCapsulePayload>,
+    owner_epoch: u64,
+    cdr_sequence: u64,
+    ended_at: String,
+    call_session_ref: String,
+) {
+    crate::utils::spawn(async move {
+        let mut retry_streak = 0_u32;
+        loop {
+            retry_streak = retry_streak.saturating_add(1);
+            retry_delay(retry_streak).await;
+            match crate::ivekit_dual_leg_cdr::emit_recovered_terminal_cdr(
+                &payloads,
+                owner_epoch,
+                "recovered_termination_finalize",
+                cdr_sequence,
+                &ended_at,
+            )
+            .await
+            {
+                Ok(()) => break,
+                Err(error) => tracing::warn!(
+                    %call_session_ref,
+                    retry_streak,
+                    error = %error,
+                    "recovered exact terminal CDR retry remains pending"
+                ),
+            }
+        }
+        retry_recovered_terminal_shadow(&executor, &request, &call_session_ref).await;
+    });
+}
+
+async fn retry_recovered_terminal_shadow(
+    executor: &DialogShadowHttpClient,
+    request: &DialogShadowCommitPairRequest,
+    call_session_ref: &str,
+) {
+    let mut retry_streak = 0_u32;
+    loop {
+        retry_streak = retry_streak.saturating_add(1);
+        retry_delay(retry_streak).await;
+        match executor.commit_pair(request).await {
+            Ok(_) => {
+                crate::ivekit_owner::close_owner(call_session_ref).await;
+                break;
+            }
+            Err(error) => tracing::warn!(
+                %call_session_ref,
+                retry_streak,
+                error = %error,
+                "recovered terminal shadow retry remains pending"
+            ),
+        }
+    }
+}
+
+async fn retry_delay(retry_streak: u32) {
+    let exponent = retry_streak.min(6);
+    tokio::time::sleep(Duration::from_millis(
+        250_u64.saturating_mul(1_u64 << exponent),
+    ))
+    .await;
+}
