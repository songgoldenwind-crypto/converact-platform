+pub fn start_uploader() -> Result<()> {
+    let Some(config) = config()?.cloned() else {
+        return Ok(());
+    };
+    ensure_spool_directory(&config.spool_dir)?;
+    remove_stale_temporary_files(&config.spool_dir)?;
+    recover_region_upload_claims(&config.spool_dir)?;
+    if let Err(error) = spool_writer(&config) {
+        SPOOL_HEALTHY.store(false, Ordering::Release);
+        return Err(error);
+    }
+    if UPLOADER.set(()).is_err() {
+        return Ok(());
+    }
+    let handle = tokio::runtime::Handle::try_current()
+        .map_err(|_| anyhow!("iveKit CDR uploader requires a Tokio runtime"))?;
+    handle.spawn(async move {
+        let mut retry_streak = 0_u32;
+        loop {
+            let pass_failed = match upload_pending(&config).await {
+                Ok(retryable_failures) => {
+                    if retryable_failures > 0 {
+                        metrics::counter!(
+                            "rustpbx_ivekit_cdr_upload_total",
+                            "result" => "retryable_failure"
+                        )
+                        .increment(retryable_failures as u64);
+                    }
+                    false
+                }
+                Err(error) => {
+                    tracing::warn!(error = %error, "iveKit CDR upload pass failed");
+                    true
+                }
+            };
+            if pass_failed {
+                retry_streak = retry_streak.saturating_add(1);
+            } else {
+                retry_streak = 0;
+            }
+            tokio::time::sleep(retry_delay(config.poll_interval, retry_streak)).await;
+        }
+    });
+    Ok(())
+}
