+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn saturated_spool_writer_backpressure_does_not_block_os_threads() {
+        let directory = std::env::temp_dir().join(format!(
+            "ivekit-cdr-writer-backpressure-{}-{}",
+            std::process::id(),
+            TEMP_SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        ensure_spool_directory(&directory).expect("create spool");
+        let cdr = payload(terminal_input(), "region-a").expect("valid CDR");
+        let bytes = serde_json::to_vec(&cdr).expect("encode CDR");
+        let hash = payload_hash(&cdr).expect("hash CDR");
+        let (writer, mut receiver) = mpsc::channel(1);
+        let (block_acknowledgement, _block_receipt) = oneshot::channel();
+        assert!(
+            writer
+                .try_send(SpoolWriteRequest {
+                    payload: cdr.clone(),
+                    bytes: bytes.clone(),
+                    payload_hash: hash.clone(),
+                    record_extension: SPOOL_RECORD_EXTENSION,
+                    acknowledgement: block_acknowledgement,
+                })
+                .is_ok(),
+            "fill writer queue"
+        );
+        let writer_directory = directory.clone();
+        let writer_task = tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            let first = receiver.recv().await.expect("receive queued record");
+            let _ = first.acknowledgement.send(Ok(()));
+            let request = receiver.recv().await.expect("receive backpressured record");
+            let result = write_atomic(
+                &writer_directory,
+                &request.payload,
+                &request.bytes,
+                &request.payload_hash,
+                request.record_extension,
+            )
+            .map_err(|error| error.to_string());
+            let _ = request.acknowledgement.send(result);
+        });
+
+        let pending = persist_with_writer(
+            &writer,
+            &directory,
+            cdr,
+            bytes,
+            hash.clone(),
+            SPOOL_RECORD_EXTENSION,
+        );
+        tokio::pin!(pending);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(10), &mut pending)
+                .await
+                .is_err(),
+            "full writer queue must apply asynchronous backpressure"
+        );
+        pending.await.expect("durable bounded writer");
+
+        assert!(directory.join(format!("1.{hash}.json")).exists());
+        writer_task.await.expect("writer task");
+        SPOOL_HEALTHY.store(true, Ordering::Release);
+        std::fs::remove_dir_all(&directory).expect("remove spool");
+    }
