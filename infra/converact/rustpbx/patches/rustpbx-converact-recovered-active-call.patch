+fn recovered_active_call_error(
+    error: crate::proxy::active_call_registry::ActiveCallRegistryError,
+) -> DialogShadowError {
+    use crate::proxy::active_call_registry::ActiveCallRegistryError;
+
+    match error {
+        ActiveCallRegistryError::InvalidProviderIdentifier
+        | ActiveCallRegistryError::HandleMismatch
+        | ActiveCallRegistryError::InvalidDialogIdentifier
+        | ActiveCallRegistryError::InvalidDirection => DialogShadowError::InvalidRecord,
+        ActiveCallRegistryError::CapacityExhausted
+        | ActiveCallRegistryError::LegCapacityExhausted
+        | ActiveCallRegistryError::DialogCapacityExhausted => DialogShadowError::Unavailable,
+        ActiveCallRegistryError::ProviderAlreadyRegistered
+        | ActiveCallRegistryError::AuthorityConflict
+        | ActiveCallRegistryError::SessionNotRegistered
+        | ActiveCallRegistryError::DialogAuthorityConflict
+        | ActiveCallRegistryError::NativeCallStateConflict
+        | ActiveCallRegistryError::NativeCallUnavailable => DialogShadowError::ReconcileRequired,
+    }
