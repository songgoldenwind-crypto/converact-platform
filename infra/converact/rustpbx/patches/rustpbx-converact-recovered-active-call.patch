+                    session_id: recovered.to_string(),
+                    caller: Some("sip:caller@example.test".to_string()),
+                    callee: Some("sip:callee@example.test".to_string()),
+                    direction: "inbound".to_string(),
+                    started_at: Utc::now(),
+                    answered_at: Some(Utc::now()),
+                    status: ActiveProxyCallStatus::Talking,
+                },
+                make_handle(recovered),
+                recovered_identity.clone(),
+                ["dialog-a".to_string(), "dialog-c".to_string()],
