+    pub(crate) fn register_recovered_call(
+        &self,
+        entry: ActiveProxyCallEntry,
+        handle: SipSessionHandle,
+        identity: NativeCallIdentity,
+        dialog_ids: [String; 2],
+    ) -> Result<NativeCallCleanupFence, ActiveCallRegistryError> {
+        if dialog_ids[0] == dialog_ids[1] {
+            return Err(ActiveCallRegistryError::InvalidDialogIdentifier);
+        }
+        let session_id = entry.session_id.clone();
+        self.try_upsert_authoritative(entry, handle.clone(), identity.clone())?;
+        let cleanup_fence = self.cleanup_fence_for_identity(&session_id, &identity)?;
+        if let Err(error) = self.restore_recovered_native_call_confirmed(&session_id, &identity) {
+            cleanup_fence.remove_original(self);
+            return Err(error);
+        }
+        for dialog_id in dialog_ids {
+            if let Err(error) = self.try_register_dialog(dialog_id, handle.clone()) {
+                cleanup_fence.remove_original(self);
+                return Err(error);
+            }
+        }
+        Ok(cleanup_fence)
+    }
+
+    fn restore_recovered_native_call_confirmed(
+        &self,
+        provider_call_id: &str,
+        expected_identity: &NativeCallIdentity,
+    ) -> Result<(), ActiveCallRegistryError> {
+        let binding = {
+            let slot = self
+                .slots
+                .get(provider_call_id)
+                .ok_or(ActiveCallRegistryError::SessionNotRegistered)?;
+            if slot.identity.as_ref() != Some(expected_identity) {
+                return Err(ActiveCallRegistryError::AuthorityConflict);
+            }
+            slot.native_binding
+                .clone()
+                .ok_or(ActiveCallRegistryError::NativeCallUnavailable)?
+        };
+        if binding.direction != NativeLegDirection::Inbound {
+            return Err(ActiveCallRegistryError::InvalidDirection);
+        }
+        let mut state = binding
+            .cell
+            .state
+            .lock()
+            .map_err(|_| ActiveCallRegistryError::NativeCallUnavailable)?;
+        if state.closed || !state.call.matches_authority(expected_identity) {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+        let recovery_hash = sha256_lower_hex(
+            format!(
+                "recovered-confirmed-call\0{}\0{}\0{}\0{}\0{}",
+                expected_identity.tenant_id(),
+                expected_identity.call_id(),
+                expected_identity.provider_call_id(),
+                expected_identity.owner_epoch(),
+                expected_identity.generation(),
+            )
+            .as_bytes(),
+        );
+        for (suffix, event) in [
+            ("invite", NativeLegEvent::InboundInviteObserved),
+            ("answer", NativeLegEvent::Final2xx),
+            ("ack", NativeLegEvent::Invite2xxAckObserved),
+        ] {
+            let event_hash = sha256_lower_hex(format!("{recovery_hash}\0{suffix}").as_bytes());
+            let fence = state.call.fence();
+            let receipt = state
+                .call
+                .apply_leg_event(
+                    &fence,
+                    &binding.leg_id,
+                    &format!("recovered-{suffix}-{recovery_hash}"),
+                    &event_hash,
+                    event,
+                )
+                .map_err(map_native_leg_registration_error)?;
+            if receipt.required_effect != NativeRequiredEffect::None {
+                return Err(ActiveCallRegistryError::NativeCallStateConflict);
+            }
+        }
+        if state
+            .call
+            .leg(&binding.leg_id)
+            .map_err(map_native_leg_registration_error)?
+            .state
+            != NativeLegState::Confirmed
+        {
+            return Err(ActiveCallRegistryError::NativeCallStateConflict);
+        }
+        Ok(())
+    }
