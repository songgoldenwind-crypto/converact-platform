+#[cfg(test)]
+mod tests {
+    use super::SipEffectObservationSupervisorOptions;
+    use crate::call::adapters::rsipstack_sip_effect_gate::SipEffectGateError;
+    use std::time::Duration;
+
+    #[test]
+    fn retry_backoff_must_be_nonzero_ordered_and_bounded() {
+        for options in [
+            SipEffectObservationSupervisorOptions {
+                initial_retry_backoff: Duration::ZERO,
+                max_retry_backoff: Duration::from_secs(1),
+            },
+            SipEffectObservationSupervisorOptions {
+                initial_retry_backoff: Duration::from_secs(2),
+                max_retry_backoff: Duration::from_secs(1),
+            },
+            SipEffectObservationSupervisorOptions {
+                initial_retry_backoff: Duration::from_secs(1),
+                max_retry_backoff: Duration::from_secs(61),
+            },
+        ] {
+            assert_eq!(
+                options.validate(),
+                Err(SipEffectGateError::InvalidConfiguration)
+            );
+        }
+        assert_eq!(
+            SipEffectObservationSupervisorOptions::default()
+                .validate()
+                .unwrap(),
+            SipEffectObservationSupervisorOptions::default()
+        );
+    }
+}
