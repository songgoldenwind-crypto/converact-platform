@@ -0,0 +1,309 @@
+use super::rsipstack_sip_effect_gate::{
+    DurableRsipstackEgressGate, SipEffectGateError, SipEffectTransportObserver,
+};
+use futures::FutureExt;
+use std::panic::AssertUnwindSafe;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+use tokio::task::JoinHandle;
+use tokio::time::sleep;
+use tokio_util::sync::CancellationToken;
+use tracing::{error, warn};
+
+const MAX_RETRY_BACKOFF: Duration = Duration::from_secs(60);
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectObservationSupervisorOptions {
+    pub initial_retry_backoff: Duration,
+    pub max_retry_backoff: Duration,
+}
+
+impl Default for SipEffectObservationSupervisorOptions {
+    fn default() -> Self {
+        Self {
+            initial_retry_backoff: Duration::from_millis(10),
+            max_retry_backoff: Duration::from_secs(1),
+        }
+    }
+}
+
+impl SipEffectObservationSupervisorOptions {
+    fn validate(self) -> Result<Self, SipEffectGateError> {
+        if self.initial_retry_backoff.is_zero()
+            || self.initial_retry_backoff > self.max_retry_backoff
+            || self.max_retry_backoff > MAX_RETRY_BACKOFF
+        {
+            return Err(SipEffectGateError::InvalidConfiguration);
+        }
+        Ok(self)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SipEffectObservationSupervisorSnapshot {
+    pub configured_shards: usize,
+    pub running_shards: usize,
+    pub retryable_failures: usize,
+    pub panic_restarts: usize,
+    pub restart_failures: usize,
+    pub quarantined_shards: usize,
+    pub unexpected_stops: usize,
+}
+
+struct SipEffectObservationSupervisorMetrics {
+    configured_shards: usize,
+    running_shards: AtomicUsize,
+    retryable_failures: AtomicUsize,
+    panic_restarts: AtomicUsize,
+    restart_failures: AtomicUsize,
+    quarantined_shards: AtomicUsize,
+    unexpected_stops: AtomicUsize,
+}
+
+impl SipEffectObservationSupervisorMetrics {
+    fn snapshot(&self) -> SipEffectObservationSupervisorSnapshot {
+        SipEffectObservationSupervisorSnapshot {
+            configured_shards: self.configured_shards,
+            running_shards: self.running_shards.load(Ordering::Acquire),
+            retryable_failures: self.retryable_failures.load(Ordering::Acquire),
+            panic_restarts: self.panic_restarts.load(Ordering::Acquire),
+            restart_failures: self.restart_failures.load(Ordering::Acquire),
+            quarantined_shards: self.quarantined_shards.load(Ordering::Acquire),
+            unexpected_stops: self.unexpected_stops.load(Ordering::Acquire),
+        }
+    }
+}
+
+pub struct SipEffectObservationSupervisor {
+    cancel: CancellationToken,
+    workers: Vec<JoinHandle<()>>,
+    metrics: Arc<SipEffectObservationSupervisorMetrics>,
+}
+
+impl SipEffectObservationSupervisor {
+    pub fn start(
+        gate: Arc<DurableRsipstackEgressGate>,
+        observers: Vec<SipEffectTransportObserver>,
+        parent_cancel: CancellationToken,
+        options: SipEffectObservationSupervisorOptions,
+    ) -> Result<Self, SipEffectGateError> {
+        let options = options.validate()?;
+        let configured_shards = gate.observation_worker_shards();
+        if observers.len() != configured_shards || tokio::runtime::Handle::try_current().is_err() {
+            return Err(SipEffectGateError::InvalidConfiguration);
+        }
+        let mut claimed = vec![false; configured_shards];
+        for observer in &observers {
+            let shard_index = observer.shard_index();
+            if shard_index >= configured_shards || claimed[shard_index] {
+                return Err(SipEffectGateError::InvalidConfiguration);
+            }
+            claimed[shard_index] = true;
+        }
+
+        let cancel = parent_cancel.child_token();
+        let metrics = Arc::new(SipEffectObservationSupervisorMetrics {
+            configured_shards,
+            running_shards: AtomicUsize::new(0),
+            retryable_failures: AtomicUsize::new(0),
+            panic_restarts: AtomicUsize::new(0),
+            restart_failures: AtomicUsize::new(0),
+            quarantined_shards: AtomicUsize::new(0),
+            unexpected_stops: AtomicUsize::new(0),
+        });
+        let mut workers = Vec::with_capacity(configured_shards);
+        for observer in observers {
+            workers.push(crate::utils::spawn(supervise_shard(
+                gate.clone(),
+                observer,
+                cancel.clone(),
+                options,
+                metrics.clone(),
+            )));
+        }
+        Ok(Self {
+            cancel,
+            workers,
+            metrics,
+        })
+    }
+
+    pub fn snapshot(&self) -> SipEffectObservationSupervisorSnapshot {
+        self.metrics.snapshot()
+    }
+
+    pub async fn shutdown(mut self) -> Result<(), SipEffectGateError> {
+        self.cancel.cancel();
+        let mut join_failed = false;
+        for worker in self.workers.drain(..) {
+            if worker.await.is_err() {
+                join_failed = true;
+            }
+        }
+        if join_failed {
+            Err(SipEffectGateError::StoreUnavailable)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl Drop for SipEffectObservationSupervisor {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+    }
+}
+
+struct RunningShardGuard<'a>(&'a AtomicUsize);
+
+impl Drop for RunningShardGuard<'_> {
+    fn drop(&mut self) {
+        let previous = self.0.fetch_sub(1, Ordering::AcqRel);
+        debug_assert!(previous > 0);
+    }
+}
+
+async fn supervise_shard(
+    gate: Arc<DurableRsipstackEgressGate>,
+    mut observer: SipEffectTransportObserver,
+    cancel: CancellationToken,
+    options: SipEffectObservationSupervisorOptions,
+    metrics: Arc<SipEffectObservationSupervisorMetrics>,
+) {
+    let shard_index = observer.shard_index();
+    metrics.running_shards.fetch_add(1, Ordering::AcqRel);
+    let _running = RunningShardGuard(&metrics.running_shards);
+    let mut retry_backoff = options.initial_retry_backoff;
+
+    loop {
+        let persist = AssertUnwindSafe(observer.persist_next()).catch_unwind();
+        let result = tokio::select! {
+            biased;
+            _ = cancel.cancelled() => return,
+            result = persist => result,
+        };
+        match result {
+            Ok(Ok(true)) => retry_backoff = options.initial_retry_backoff,
+            Ok(Ok(false)) => {
+                metrics.unexpected_stops.fetch_add(1, Ordering::Relaxed);
+                error!(
+                    shard_index,
+                    "durable SIP observation channel closed unexpectedly"
+                );
+                return;
+            }
+            Ok(Err(SipEffectGateError::StoreUnavailable)) => {
+                metrics.retryable_failures.fetch_add(1, Ordering::Relaxed);
+                warn!(
+                    shard_index,
+                    ?retry_backoff,
+                    "retrying durable SIP observation"
+                );
+                if wait_or_cancel(&cancel, retry_backoff).await {
+                    return;
+                }
+                retry_backoff = retry_backoff
+                    .saturating_mul(2)
+                    .min(options.max_retry_backoff);
+            }
+            Ok(Err(SipEffectGateError::ObservationQuarantined)) => {
+                metrics.quarantined_shards.fetch_add(1, Ordering::Relaxed);
+                error!(shard_index, "durable SIP observation shard quarantined");
+                return;
+            }
+            Ok(Err(error)) => {
+                metrics.unexpected_stops.fetch_add(1, Ordering::Relaxed);
+                error!(
+                    shard_index,
+                    ?error,
+                    "durable SIP observation shard stopped fail-closed"
+                );
+                return;
+            }
+            Err(_) => {
+                error!(
+                    shard_index,
+                    "durable SIP observation persist future panicked"
+                );
+                drop(observer);
+                if wait_or_cancel(&cancel, retry_backoff).await {
+                    return;
+                }
+                loop {
+                    match gate.restart_observer(shard_index) {
+                        Ok(restarted) => {
+                            observer = restarted;
+                            metrics.panic_restarts.fetch_add(1, Ordering::Relaxed);
+                            retry_backoff = options.initial_retry_backoff;
+                            break;
+                        }
+                        Err(SipEffectGateError::ObservationQuarantined) => {
+                            metrics.quarantined_shards.fetch_add(1, Ordering::Relaxed);
+                            return;
+                        }
+                        Err(error) => {
+                            metrics.restart_failures.fetch_add(1, Ordering::Relaxed);
+                            warn!(
+                                shard_index,
+                                ?error,
+                                ?retry_backoff,
+                                "retrying durable SIP observer restart"
+                            );
+                            if wait_or_cancel(&cancel, retry_backoff).await {
+                                return;
+                            }
+                            retry_backoff = retry_backoff
+                                .saturating_mul(2)
+                                .min(options.max_retry_backoff);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+async fn wait_or_cancel(cancel: &CancellationToken, duration: Duration) -> bool {
+    tokio::select! {
+        biased;
+        _ = cancel.cancelled() => true,
+        _ = sleep(duration) => false,
+    }
+}
