+#[tokio::test]
+async fn failed_send_trying_can_retry_on_replacement_connection() {
+    let (_failed_incoming_tx, failed_incoming_rx) = tokio::sync::mpsc::unbounded_channel();
+    let (failed_outgoing_tx, failed_outgoing_rx) = tokio::sync::mpsc::unbounded_channel();
+    drop(failed_outgoing_rx);
+    let channel_addr = SipAddr::from(
+        "127.0.0.1:5060"
+            .parse::<std::net::SocketAddr>()
+            .expect("channel address"),
+    );
+    let failed_connection = ChannelConnection::create_connection(
+        failed_incoming_rx,
+        failed_outgoing_tx,
+        channel_addr.clone(),
+        None,
+    )
+    .await
+    .expect("failed channel connection");
+    let endpoint = EndpointBuilder::new()
+        .with_user_agent("rsipstack-test")
+        .build();
+    let request = crate::sip::Request {
+        method: crate::sip::Method::Invite,
+        uri: crate::sip::Uri::try_from("sip:bob@example.test").expect("request URI"),
+        headers: vec![
+            Via::new("SIP/2.0/UDP example.test:5060;branch=z9hG4bK-trying-retry").into(),
+            CSeq::new("1 INVITE").into(),
+            From::new("Alice <sip:alice@example.test>;tag=trying-retry").into(),
+            To::new("Bob <sip:bob@example.test>").into(),
+            CallId::new("trying-retry@example.test").into(),
+        ]
+        .into(),
+        version: crate::sip::Version::V2,
+        body: Default::default(),
+    };
+    let key = crate::transaction::TransactionKey::from_request(
+        &request,
+        crate::transaction::key::TransactionRole::Server,
+    )
+    .expect("transaction key");
+    let mut transaction = crate::transaction::Transaction::new_server(
+        key,
+        request,
+        endpoint.inner.clone(),
+        Some(failed_connection.into()),
+    );
+
+    assert!(transaction.send_trying().await.is_err());
+
+    let (_retry_incoming_tx, retry_incoming_rx) = tokio::sync::mpsc::unbounded_channel();
+    let (retry_outgoing_tx, mut retry_outgoing_rx) = tokio::sync::mpsc::unbounded_channel();
+    let retry_connection = ChannelConnection::create_connection(
+        retry_incoming_rx,
+        retry_outgoing_tx,
+        channel_addr,
+        None,
+    )
+    .await
+    .expect("retry channel connection");
+    transaction.connection = Some(retry_connection.into());
+    transaction
+        .send_trying()
+        .await
+        .expect("replacement connection sends 100 Trying");
+
+    assert!(matches!(
+        retry_outgoing_rx.recv().await,
+        Some(TransportEvent::Incoming(
+            crate::sip::SipMessage::Response(crate::sip::Response {
+                status_code: crate::sip::StatusCode::Trying,
+                ..
+            }),
+            _,
+            _
+        ))
+    ));
+    assert!(matches!(
+        retry_outgoing_rx.try_recv(),
+        Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+    ));
+}
