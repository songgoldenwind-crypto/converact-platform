+async fn repeated_send_trying_emits_one_initial_response() {
+    let (_incoming_tx, incoming_rx) = tokio::sync::mpsc::unbounded_channel();
+    let (outgoing_tx, mut outgoing_rx) = tokio::sync::mpsc::unbounded_channel();
+    let channel_addr = SipAddr::from(
+        "127.0.0.1:5060"
+            .parse::<std::net::SocketAddr>()
+            .expect("channel address"),
+    );
+    let connection =
+        ChannelConnection::create_connection(incoming_rx, outgoing_tx, channel_addr, None)
+            .await
+            .expect("channel connection");
+    let endpoint = EndpointBuilder::new()
+        .with_user_agent("rsipstack-test")
+        .build();
+    let request = crate::sip::Request {
+        method: crate::sip::Method::Invite,
+        uri: crate::sip::Uri::try_from("sip:bob@example.test").expect("request URI"),
+        headers: vec![
+            Via::new("SIP/2.0/UDP example.test:5060;branch=z9hG4bK-single-trying").into(),
+            CSeq::new("1 INVITE").into(),
+            From::new("Alice <sip:alice@example.test>;tag=single-trying").into(),
+            To::new("Bob <sip:bob@example.test>").into(),
+            CallId::new("single-trying@example.test").into(),
+        ]
+        .into(),
+        version: crate::sip::Version::V2,
+        body: Default::default(),
+    };
+    let key = crate::transaction::TransactionKey::from_request(
+        &request,
+        crate::transaction::key::TransactionRole::Server,
+    )
+    .expect("transaction key");
+    let mut transaction = crate::transaction::Transaction::new_server(
+        key,
+        request,
+        endpoint.inner.clone(),
+        Some(connection.into()),
+    );
+
+    transaction.send_trying().await.expect("first 100 Trying");
+    transaction
+        .send_trying()
+        .await
+        .expect("duplicate owner is a no-op");
+
+    let first = outgoing_rx.recv().await.expect("first response");
+    assert!(matches!(
+        first,
+        TransportEvent::Incoming(
+            crate::sip::SipMessage::Response(crate::sip::Response {
+                status_code: crate::sip::StatusCode::Trying,
+                ..
+            }),
+            _,
+            _
+        )
+    ));
+    assert!(
+        matches!(
+            outgoing_rx.try_recv(),
+            Err(tokio::sync::mpsc::error::TryRecvError::Empty)
+        ),
+        "the second application owner must not emit another 100 Trying"
+    );
+}
