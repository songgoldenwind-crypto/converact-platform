+use super::rsipstack_sip_effect_gate::{
+    DurableRsipstackEgressGate, SipEffectGateError, SipEffectIntent, SipEffectIntentLease,
+    SipEffectIntentRegistry,
+};
+use crate::proxy::active_call_registry::{
+    ActiveCallRegistryError, ActiveProxyCallRegistry, NativeMatchedCancelCapabilityFacts,
+};
+use chrono::{Duration, Utc};
+use rsipstack::sip::{SipMessage, StatusCode, Transport};
+use rsipstack::transaction::endpoint::{EgressEffectGate, EgressEffectPeerDerivedKind};
+use rsipstack::transaction::transaction::Transaction;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::sync::Arc;
+
+#[allow(
+    dead_code,
+    reason = "construction stays unreachable until the default-disabled runtime activation gate"
+)]
+const MAX_AUDIT_RETENTION_DAYS: i64 = 365;
+const PINNED_RSIPSTACK_SOURCE_COMMIT: &str = "8318e97b1170de4e5245b120afec1cdf53e3d716";
+
+#[derive(Debug, thiserror::Error)]
+pub(crate) enum NativeSipEffectCapabilityError {
+    #[error("native Call authority rejected SIP effect capability issuance")]
+    ActiveCall(#[from] ActiveCallRegistryError),
+    #[error("durable SIP effect capability registration failed")]
+    Gate(#[from] SipEffectGateError),
+    #[error("native SIP effect runtime configuration is invalid")]
+    InvalidConfiguration,
+    #[error("native SIP effect transport binding is unavailable")]
+    TransportBinding,
+    #[error("native SIP effect transport requires a frozen TLS authority binding")]
+    UnsupportedSecureTransport,
+    #[error("transaction-local durable SIP effect gate installation failed")]
+    TransactionGate(#[source] rsipstack::Error),
+}
+
+pub(crate) struct NativeSipEffectRuntime {
+    gate: Arc<DurableRsipstackEgressGate>,
+    intents: Arc<SipEffectIntentRegistry>,
+    adapter_identity: Value,
+    audit_retention: Duration,
+}
+
+impl NativeSipEffectRuntime {
+    #[allow(
+        dead_code,
+        reason = "construction stays unreachable until the default-disabled runtime activation gate"
+    )]
+    pub(crate) fn try_new(
+        gate: Arc<DurableRsipstackEgressGate>,
+        intents: Arc<SipEffectIntentRegistry>,
+        adapter_identity: Value,
+        audit_retention: Duration,
+    ) -> Result<Self, NativeSipEffectCapabilityError> {
+        let identity = adapter_identity
+            .as_object()
+            .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        let source_commit = identity
+            .get("source_commit")
+            .and_then(Value::as_str)
+            .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        if identity.len() != 2
+            || identity.get("adapter_id").and_then(Value::as_str) != Some("rsipstack")
+            || source_commit != PINNED_RSIPSTACK_SOURCE_COMMIT
+            || audit_retention <= Duration::zero()
+            || audit_retention > Duration::days(MAX_AUDIT_RETENTION_DAYS)
+            || !gate.uses_intent_registry(&intents)
+        {
+            return Err(NativeSipEffectCapabilityError::InvalidConfiguration);
+        }
+        Ok(Self {
+            gate,
+            intents,
+            adapter_identity,
+            audit_retention,
+        })
+    }
+
+    pub(crate) fn gate(&self) -> Arc<dyn EgressEffectGate> {
+        self.gate.clone()
+    }
+
+    pub(crate) fn register_matched_cancel_capabilities(
+        &self,
+        active_calls: &Arc<ActiveProxyCallRegistry>,
+        provider_call_id: &str,
+        transaction: &Transaction,
+    ) -> Result<NativeMatchedCancelCapabilityHolder, NativeSipEffectCapabilityError> {
+        let reservation =
+            active_calls.reserve_matched_cancel_capabilities(provider_call_id, transaction)?;
+        let registration = (|| {
+            let facts = reservation.facts();
+            let route_binding = route_binding(transaction, facts)?;
+            let pair = matched_cancel_intents(
+                facts,
+                route_binding,
+                self.adapter_identity.clone(),
+                self.audit_retention,
+            )?;
+            let cancel_ok = self.intents.register_peer_derived(
+                &transaction.key,
+                EgressEffectPeerDerivedKind::ServerInviteCancelOk,
+                pair.cancel_ok,
+            )?;
+            let invite_terminated = self.intents.register_peer_derived(
+                &transaction.key,
+                EgressEffectPeerDerivedKind::ServerInviteRequestTerminated,
+                pair.invite_terminated,
+            )?;
+            Ok(NativeMatchedCancelCapabilityHolder {
+                _cancel_ok: cancel_ok,
+                _invite_terminated: invite_terminated,
+            })
+        })();
+        match registration {
+            Ok(holder) => {
+                reservation.commit();
+                Ok(holder)
+            }
+            Err(error) => {
+                drop(reservation);
+                active_calls.remove(provider_call_id);
+                Err(error)
+            }
+        }
+    }
+}
+
+pub(crate) struct NativeMatchedCancelCapabilityHolder {
+    _cancel_ok: SipEffectIntentLease,
+    _invite_terminated: SipEffectIntentLease,
+}
+
+pub(crate) fn install_for_admitted_native_call(
+    runtime: Option<&NativeSipEffectRuntime>,
+    active_calls: &Arc<ActiveProxyCallRegistry>,
+    provider_call_id: &str,
+    transaction: &mut Transaction,
+) -> Result<Option<NativeMatchedCancelCapabilityHolder>, NativeSipEffectCapabilityError> {
+    let Some(runtime) = runtime else {
+        return Ok(None);
+    };
+    let holder = runtime.register_matched_cancel_capabilities(
+        active_calls,
+        provider_call_id,
+        transaction,
+    )?;
+    if let Err(error) = transaction.install_egress_effect_gate(runtime.gate()) {
+        drop(holder);
+        active_calls.remove(provider_call_id);
+        return Err(NativeSipEffectCapabilityError::TransactionGate(error));
+    }
+    Ok(Some(holder))
+}
+
+struct MatchedCancelIntents {
+    cancel_ok: SipEffectIntent,
+    invite_terminated: SipEffectIntent,
+}
+
+fn matched_cancel_intents(
+    facts: &NativeMatchedCancelCapabilityFacts,
+    route_binding: Value,
+    adapter_identity: Value,
+    audit_retention: Duration,
+) -> Result<MatchedCancelIntents, NativeSipEffectCapabilityError> {
+    let identity = facts.identity();
+    let pair_hash = facts.pair_binding_sha256();
+    let semantic_intent_sha256 = sha256_lower_hex(
+        format!(
+            "matched-cancel-effects\0{}\0{}\0{}\0{}",
+            identity.tenant_id(),
+            identity.call_id(),
+            identity.generation(),
+            facts.transaction_key(),
+        )
+        .as_bytes(),
+    );
+    let cancel_ok_effect_id = format!("sip-cancel-ok-{pair_hash}");
+    let invite_terminated_effect_id = format!("sip-invite-487-{pair_hash}");
+    let decision_id = format!("sip-cancel-decision-{pair_hash}");
+    let prepared_at = Utc::now();
+    let audit_until = prepared_at
+        .checked_add_signed(audit_retention)
+        .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+
+    let common = |effect_id: &str,
+                  command_kind: &str,
+                  command_sequence: u64,
+                  parent_attempt_id: Option<&str>|
+     -> SipEffectIntent {
+        SipEffectIntent {
+            tenant_id: identity.tenant_id().to_string(),
+            protocol_effect_id: effect_id.to_string(),
+            protocol_session_id: identity.call_id().as_str().to_string(),
+            protocol_session_generation: identity.generation().to_string(),
+            decision_id: decision_id.clone(),
+            idempotency_key: format!("sip-{command_kind}-idempotency-{pair_hash}"),
+            semantic_intent_sha256: semantic_intent_sha256.clone(),
+            command_id: format!("sip-{command_kind}-command-{pair_hash}"),
+            adapter_identity: adapter_identity.clone(),
+            route_binding: route_binding.clone(),
+            wire_attempt_facts: serde_json::json!({
+                "schema_id": "sip-foundation-wire-attempt-v1",
+                "schema_version": "1.0.0",
+                "attempt_id": effect_id,
+                "transaction_lineage_id": cancel_ok_effect_id,
+                "semantic_intent_sha256": semantic_intent_sha256,
+                "parent_attempt_id": parent_attempt_id,
+                "lineage_reason": if parent_attempt_id.is_some() {
+                    "derived_attempt"
+                } else {
+                    "transaction_root"
+                },
+            }),
+            owner_epoch: identity.owner_epoch(),
+            command_sequence,
+            prepared_at,
+            audit_until,
+        }
+    };
+
+    Ok(MatchedCancelIntents {
+        cancel_ok: common(
+            &cancel_ok_effect_id,
+            "cancel-ok",
+            facts.cancel_ok_command_sequence(),
+            None,
+        ),
+        invite_terminated: common(
+            &invite_terminated_effect_id,
+            "invite-487",
+            facts.invite_terminated_command_sequence(),
+            Some(&cancel_ok_effect_id),
+        ),
+    })
+}
+
+fn route_binding(
+    transaction: &Transaction,
+    facts: &NativeMatchedCancelCapabilityFacts,
+) -> Result<Value, NativeSipEffectCapabilityError> {
+    let connection = transaction
+        .connection
+        .as_ref()
+        .ok_or(NativeSipEffectCapabilityError::TransportBinding)?;
+    let response = transaction.endpoint_inner.make_response(
+        &transaction.original,
+        StatusCode::RequestTerminated,
+        None,
+    );
+    let transport_binding = connection
+        .egress_transport_binding(
+            &SipMessage::Response(response),
+            transaction.destination.as_ref(),
+        )
+        .map_err(|_| NativeSipEffectCapabilityError::TransportBinding)?;
+    let protocol = match transport_binding.protocol() {
+        Transport::Udp => "udp",
+        Transport::Tcp => "tcp",
+        Transport::Ws => "ws",
+        Transport::Tls | Transport::Wss => {
+            return Err(NativeSipEffectCapabilityError::UnsupportedSecureTransport);
+        }
+        _ => return Err(NativeSipEffectCapabilityError::TransportBinding),
+    };
+    let local = connection
+        .get_addr()
+        .get_socketaddr()
+        .map_err(|_| NativeSipEffectCapabilityError::TransportBinding)?;
+    let remote = transport_binding.remote_addr();
+    let transport_hash = sha256_lower_hex(
+        format!(
+            "{}\0{}\0{}\0{}\0{}",
+            protocol,
+            local,
+            remote,
+            transport_binding.flow_id().unwrap_or("datagram"),
+            transport_binding.flow_generation().unwrap_or(0),
+        )
+        .as_bytes(),
+    );
+    Ok(serde_json::json!({
+        "schema_id": "sip-foundation-route-binding-v1",
+        "schema_version": "1.0.0",
+        "route": {
+            "id": format!("sip-route-{}", facts.pair_binding_sha256()),
+            "revision": facts.native_call_revision(),
+        },
+        "rfc3263_candidate": format!("{remote}/{protocol}"),
+        "route_set": [],
+        "transport": {
+            "id": format!("sip-transport-{transport_hash}"),
+            "protocol": protocol,
+            "next_hop": {"address": remote.ip().to_string(), "port": remote.port()},
+        },
+        "local_endpoint": {"address": local.ip().to_string(), "port": local.port()},
+        "advertised_via_sent_by": {"host": local.ip().to_string(), "port": local.port()},
+        "tls_sni": null,
+        "authorization_identity": null,
+        "authorization_headers_sha256": [],
+    }))
+}
+
+fn sha256_lower_hex(value: &[u8]) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let digest = Sha256::digest(value);
+    let mut encoded = String::with_capacity(64);
+    for byte in digest {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
