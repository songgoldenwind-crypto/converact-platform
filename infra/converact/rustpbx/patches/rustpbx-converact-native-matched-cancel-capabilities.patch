+    #[tokio::test]
+    async fn admitted_native_call_registers_exactly_two_cancel_capabilities_once() {
+        let session_id = "native-cancel-call@example.test";
+        let registry = Arc::new(ActiveProxyCallRegistry::new());
+        registry
+            .try_upsert_authoritative(
+                entry(session_id),
+                handle(session_id),
+                NativeCallIdentity::standalone(session_id).unwrap(),
+            )
+            .unwrap();
+        let transaction = transaction(session_id).await;
+        let (runtime, intents) = runtime();
+
+        let holder = runtime
+            .register_matched_cancel_capabilities(&registry, session_id, &transaction)
+            .expect("Native Call authority registers the pair");
+        assert_eq!(intents.snapshot().registered, 2);
+        assert!(
+            runtime
+                .register_matched_cancel_capabilities(&registry, session_id, &transaction)
+                .is_err()
+        );
+        assert_eq!(intents.snapshot().registered, 2);
+
+        drop(holder);
+        assert_eq!(
+            intents.snapshot().registered,
+            0,
+            "unconsumed capabilities follow the admitted call holder lifetime"
+        );
+    }
