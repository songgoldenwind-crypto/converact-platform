+    }
+
+    async fn transaction(session_id: &str) -> Transaction {
+        let server = UdpConnection::create_connection(
+            "127.0.0.1:0".parse().expect("server address"),
+            None,
+            None,
+        )
+        .await
+        .expect("server UDP");
+        let peer = UdpConnection::create_connection(
+            "127.0.0.1:0".parse().expect("peer address"),
+            None,
+            None,
+        )
+        .await
+        .expect("peer UDP");
+        let request = Request {
+            method: Method::Invite,
+            uri: Uri::try_from("sip:bob@example.test").expect("request URI"),
+            headers: vec![
+                Via::new(&format!(
+                    "SIP/2.0/UDP {};branch=z9hG4bK-native-cancel",
+                    peer.get_addr().addr
+                ))
+                .into(),
+                CSeq::new("1 INVITE").into(),
+                From::new("Alice <sip:alice@example.test>;tag=native-cancel").into(),
+                To::new("Bob <sip:bob@example.test>").into(),
+                CallId::new(session_id).into(),
+            ]
+            .into(),
+            version: Version::V2,
+            body: Default::default(),
+        };
+        let key = TransactionKey::from_request(&request, TransactionRole::Server)
+            .expect("transaction key");
+        let endpoint = EndpointBuilder::new()
+            .with_user_agent("native-cancel-capability-test")
+            .build();
+        Transaction::new_server(key, request, endpoint.inner, Some(server.into()))
+    }
