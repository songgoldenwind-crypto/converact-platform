+    pub(crate) fn reserve_matched_cancel_capabilities(
+        self: &Arc<Self>,
+        provider_call_id: &str,
+        transaction: &rsipstack::transaction::transaction::Transaction,
+    ) -> Result<NativeMatchedCancelCapabilityReservation, ActiveCallRegistryError> {
+        use rsipstack::sip::prelude::HeadersExt;
+
+        if transaction.transaction_type != rsipstack::transaction::TransactionType::ServerInvite
+            || transaction.original.method != rsipstack::sip::Method::Invite
+            || transaction
+                .original
+                .call_id_header()
+                .ok()
+                .map(|header| header.value())
+                != Some(provider_call_id)
+            || rsipstack::transaction::key::TransactionKey::from_request(
+                &transaction.original,
+                rsipstack::transaction::key::TransactionRole::Server,
+            )
+            .ok()
+            .as_ref()
+                != Some(&transaction.key)
+        {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+
+        let (identity, binding) = {
+            let slot = self
+                .slots
+                .get(provider_call_id)
+                .ok_or(ActiveCallRegistryError::SessionNotRegistered)?;
+            let identity = slot
+                .identity
+                .clone()
+                .ok_or(ActiveCallRegistryError::NativeCallUnavailable)?;
+            let binding = slot
+                .native_binding
+                .clone()
+                .ok_or(ActiveCallRegistryError::NativeCallUnavailable)?;
+            (identity, binding)
+        };
+        if identity.provider_call_id().as_str() != provider_call_id
+            || binding.direction != NativeLegDirection::Inbound
+        {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+
+        let transaction_key = transaction.key.to_string();
+        let pair_binding_sha256 = sha256_lower_hex(
+            format!(
+                "matched-cancel-capability\0{}\0{}\0{}\0{}",
+                identity.tenant_id(),
+                identity.call_id(),
+                identity.generation(),
+                transaction_key,
+            )
+            .as_bytes(),
+        );
+        let mut state = binding
+            .cell
+            .state
+            .lock()
+            .map_err(|_| ActiveCallRegistryError::NativeCallUnavailable)?;
+        if state.closed || !state.call.matches_authority(&identity) {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+        if state.sip_effect_transactions.contains(&transaction_key) {
+            return Err(ActiveCallRegistryError::NativeCallStateConflict);
+        }
+        if state.sip_effect_transactions.len() >= SIP_EFFECT_TRANSACTION_CAPABILITIES_HARD_CEILING {
+            return Err(ActiveCallRegistryError::CapacityExhausted);
+        }
+
+        let leg = state
+            .call
+            .leg(&binding.leg_id)
+            .map_err(map_native_leg_registration_error)?;
+        match leg.state {
+            NativeLegState::Planned => {
+                let event_id = format!("sip-invite-observed-{pair_binding_sha256}");
+                let fence = state.call.fence();
+                let receipt = state
+                    .call
+                    .apply_leg_event(
+                        &fence,
+                        &binding.leg_id,
+                        &event_id,
+                        &pair_binding_sha256,
+                        NativeLegEvent::InboundInviteObserved,
+                    )
+                    .map_err(map_native_leg_registration_error)?;
+                if receipt.required_effect != NativeRequiredEffect::None {
+                    return Err(ActiveCallRegistryError::NativeCallStateConflict);
+                }
+            }
+            NativeLegState::Inviting | NativeLegState::Early => {}
+            _ => return Err(ActiveCallRegistryError::NativeCallStateConflict),
+        }
+
+        let cancel_ok_command_sequence = state.next_sip_effect_command_sequence;
+        let invite_terminated_command_sequence = cancel_ok_command_sequence
+            .checked_add(1)
+            .ok_or(ActiveCallRegistryError::CapacityExhausted)?;
+        let next_sequence = invite_terminated_command_sequence
+            .checked_add(1)
+            .ok_or(ActiveCallRegistryError::CapacityExhausted)?;
+        state.next_sip_effect_command_sequence = next_sequence;
+        state
+            .sip_effect_transactions
+            .insert(transaction_key.clone());
+        let native_call_revision = state.call.snapshot().revision;
+        drop(state);
+
+        Ok(NativeMatchedCancelCapabilityReservation {
+            cell: binding.cell,
+            facts: NativeMatchedCancelCapabilityFacts {
+                identity,
+                transaction_key,
+                pair_binding_sha256,
+                native_call_revision,
+                cancel_ok_command_sequence,
+                invite_terminated_command_sequence,
+            },
+            committed: false,
+        })
+    }
