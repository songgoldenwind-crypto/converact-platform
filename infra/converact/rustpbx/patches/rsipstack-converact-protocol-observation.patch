+/// Owns a prepared durable permit across every cancellation point in the
+/// transport send. Dropping an armed attempt is an ambiguous send result, so
+/// the synchronous gate callback must observe `TransportUnknown` exactly once.
+struct EgressTransportAttempt {
+    gate: Option<Arc<dyn EgressEffectGate>>,
+    permit: Option<EgressEffectPermit>,
+}
+
+impl EgressTransportAttempt {
+    fn new(gate: Option<Arc<dyn EgressEffectGate>>, permit: Option<EgressEffectPermit>) -> Self {
+        Self { gate, permit }
+    }
+
+    fn observe(mut self, outcome: EgressEffectOutcome) -> Option<EgressEffectPermit> {
+        let permit = self.permit.take();
+        if let (Some(gate), Some(permit)) = (self.gate.as_ref(), permit.as_ref()) {
+            gate.observe_transport(permit.clone(), outcome);
+        }
+        permit
+    }
+
+    fn is_armed(&self) -> bool {
+        self.permit.is_some()
+    }
+}
+
+impl Drop for EgressTransportAttempt {
+    fn drop(&mut self) {
+        if let (Some(gate), Some(permit)) = (self.gate.as_ref(), self.permit.take()) {
+            gate.observe_transport(permit, EgressEffectOutcome::TransportUnknown);
+        }
+    }
+}
