+#[tokio::test]
+async fn client_request_is_protocol_completed_only_after_a_final_response() {
+    let gate = Arc::new(ProtocolRecordingGate {
+        observations: Mutex::new(Vec::new()),
+    });
+    let (mut transaction, peer) = udp_client_transaction_with_effect_gate(gate.clone()).await;
+
+    transaction.send().await.expect("send INVITE");
+    let _invite = recv_udp_message(&peer).await;
+    assert!(transaction.send().await.is_err());
+    let mut duplicate = [0_u8; 2_048];
+    assert!(
+        timeout(Duration::from_millis(20), peer.recv_raw(&mut duplicate))
+            .await
+            .is_err(),
+        "the primary request API must not create a second effect"
+    );
+    assert!(gate
+        .observations
+        .lock()
+        .expect("protocol observation lock")
+        .is_empty());
+
+    let mut wrong_response = busy_response();
+    *wrong_response.cseq_header_mut().expect("wrong CSeq") = CSeq::new("2 INVITE");
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Received(
+            wrong_response.into(),
+            transaction.connection.clone().expect("client connection"),
+        ))
+        .expect("wrong final response event");
+    assert!(timeout(Duration::from_millis(20), transaction.receive())
+        .await
+        .is_err());
+    assert_eq!(transaction.state, TransactionState::Calling);
+    assert!(gate
+        .observations
+        .lock()
+        .expect("protocol observation lock")
+        .is_empty());
+
+    transaction
+        .tu_sender
+        .send(TransactionEvent::Received(
+            busy_response().into(),
+            transaction.connection.clone().expect("client connection"),
+        ))
+        .expect("final response event");
+    assert!(matches!(
+        transaction.receive().await,
+        Some(SipMessage::Response(response))
+            if response.status_code == crate::sip::StatusCode::BusyHere
+    ));
+    assert_eq!(
+        gate.observations
+            .lock()
+            .expect("protocol observation lock")
+            .as_slice(),
+        [
+            (
+                "client-invite".to_string(),
+                EgressEffectProtocolObservation::Completed,
+            ),
+            (
+                "client-ack".to_string(),
+                EgressEffectProtocolObservation::TransportTerminal,
+            ),
+        ]
+    );
+}
