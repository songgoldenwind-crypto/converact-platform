+#[tokio::test]
+async fn cancelled_primary_transport_send_reports_unknown_exactly_once() {
+    let gate = Arc::new(RecordingEgressEffectGate {
+        prepare_calls: AtomicUsize::new(0),
+        fail_on_prepare_call: None,
+        messages: Mutex::new(Vec::new()),
+        canonical_wire_images: Mutex::new(Vec::new()),
+        outcomes: Mutex::new(Vec::new()),
+    });
+    let (mut transaction, _outgoing_rx) =
+        bounded_client_transaction_with_effect_gate(gate.clone()).await;
+    fill_bounded_client_connection(&transaction).await;
+
+    assert!(
+        timeout(Duration::from_millis(20), transaction.send())
+            .await
+            .is_err(),
+        "the bounded transport send must remain pending until cancelled"
+    );
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 1);
