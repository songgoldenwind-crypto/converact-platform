+
+impl ConnectedFlowIdentity {
+    pub(crate) fn new() -> Self {
+        static PROCESS_FLOW_ID: OnceLock<Arc<str>> = OnceLock::new();
+        static NEXT_FLOW_GENERATION: AtomicU64 = AtomicU64::new(1);
+
+        let flow_id = PROCESS_FLOW_ID
+            .get_or_init(|| Arc::from(format!("rsipstack-{:032x}", rand::random::<u128>())))
+            .clone();
+        let generation = NEXT_FLOW_GENERATION
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |current| {
+                current.checked_add(1)
+            })
+            .expect("connected SIP flow generation exhausted");
+        Self {
+            flow_id,
+            generation,
+        }
+    }
+
+    pub(crate) fn flow_id(&self) -> Arc<str> {
+        self.flow_id.clone()
+    }
+
