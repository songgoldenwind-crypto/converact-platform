+    let (mut transaction, _outgoing_rx) =
+        bounded_client_transaction_with_effect_gate(gate.clone()).await;
+    transaction.send().await.expect("send initial INVITE");
+    let mut cancel = transaction.original.clone();
+    cancel.method = crate::sip::Method::Cancel;
+    *cancel.cseq_header_mut().expect("CANCEL CSeq") = CSeq::new("1 CANCEL");
+
+    assert!(
+        timeout(
+            Duration::from_millis(20),
+            transaction.send_cancel(cancel.clone()),
+        )
+        .await
+        .is_err(),
+        "the full bounded transport must keep CANCEL pending until cancelled"
+    );
+    assert_eq!(gate.prepare_calls.load(Ordering::SeqCst), 2);
+    assert_eq!(
+        gate.outcomes.lock().expect("outcome lock").as_slice(),
+        [
+            EgressEffectOutcome::TransportAccepted,
+            EgressEffectOutcome::TransportUnknown,
+        ]
+    );
+    assert!(matches!(
+        timeout(Duration::from_millis(20), transaction.send_cancel(cancel)).await,
+        Ok(Err(_))
+    ));
+    assert_eq!(
+        gate.prepare_calls.load(Ordering::SeqCst),
+        2,
+        "ambiguous CANCEL transport must not prepare a second effect"
+    );
+}
