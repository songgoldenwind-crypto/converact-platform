+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum SipEffectError {
+    #[error("SIP effect input is invalid")]
+    InvalidInput,
+    #[error("SIP effect capacity is exhausted")]
+    CapacityExhausted,
+    #[error("SIP effect idempotency identity conflicts")]
+    IdempotencyConflict,
+    #[error("SIP effect identity conflicts")]
+    IdentityConflict,
+    #[error("SIP effect receipt conflicts")]
+    ReceiptConflict,
+    #[error("SIP effect transition conflicts")]
+    TransitionConflict,
+    #[error("SIP effect fence is stale")]
+    FenceLost,
+    #[error("SIP effect is terminal")]
+    Terminal,
+    #[error("SIP effect reconciliation requires a repair fence")]
+    RepairFenceRequired,
+    #[error("SIP effect repair attempts are exhausted")]
+    RepairExhausted,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SipEffectState {
+    Prepared,
+    DurableDecision,
+    SendAttempted,
+    TransportAccepted,
+    ProtocolObserved,
+    Failed,
+    Unknown,
+}
+
+impl SipEffectState {
+    pub fn is_terminal(self) -> bool {
+        matches!(self, Self::ProtocolObserved | Self::Failed)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SipEffectReceiptLevel {
+    DurableDecision,
+    SendAttempted,
+    TransportAccepted,
+    ProtocolObserved,
+    Failed,
+    Unknown,
+}
+
+impl SipEffectReceiptLevel {
+    #[cfg(test)]
+    fn state(self) -> SipEffectState {
+        match self {
+            Self::DurableDecision => SipEffectState::DurableDecision,
+            Self::SendAttempted => SipEffectState::SendAttempted,
+            Self::TransportAccepted => SipEffectState::TransportAccepted,
+            Self::ProtocolObserved => SipEffectState::ProtocolObserved,
+            Self::Failed => SipEffectState::Failed,
+            Self::Unknown => SipEffectState::Unknown,
+        }
+    }
+
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::DurableDecision => "durable_decision",
+            Self::SendAttempted => "send_attempted",
+            Self::TransportAccepted => "transport_accepted",
+            Self::ProtocolObserved => "protocol_observed",
+            Self::Failed => "failed",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SipEffectReceiptSemantic {
+    DurableDecision,
+    SendAttempted,
+    Accepted,
+    Completed,
+    StateObserved,
+    Unknown,
+    Failed,
+}
+
+pub fn classify_receipt(
+    from: SipEffectState,
+    level: SipEffectReceiptLevel,
+) -> Result<SipEffectReceiptSemantic, SipEffectError> {
+    use SipEffectReceiptLevel as Level;
+    use SipEffectReceiptSemantic as Semantic;
+    use SipEffectState as State;
+    match (from, level) {
+        (State::Prepared, Level::DurableDecision) => Ok(Semantic::DurableDecision),
+        (State::DurableDecision, Level::SendAttempted) => Ok(Semantic::SendAttempted),
+        (State::SendAttempted, Level::TransportAccepted) => Ok(Semantic::Accepted),
+        (State::SendAttempted | State::TransportAccepted, Level::ProtocolObserved) => {
+            Ok(Semantic::Completed)
+        }
+        (State::Unknown, Level::ProtocolObserved) => Ok(Semantic::StateObserved),
+        (State::SendAttempted | State::TransportAccepted | State::Unknown, Level::Unknown) => {
+            Ok(Semantic::Unknown)
+        }
+        (
+            State::Prepared
+            | State::DurableDecision
+            | State::SendAttempted
+            | State::TransportAccepted
+            | State::Unknown,
+            Level::Failed,
+        ) => Ok(Semantic::Failed),
+        _ => Err(SipEffectError::TransitionConflict),
+    }
+}
