+
+/// Test-only conformance oracle. Production has no in-memory fallback: a
+/// durable writer must be explicitly configured and pass its schema guard.
+#[cfg(test)]
+pub struct InMemorySipEffectLedger {
+    effects: HashMap<(String, String), InMemoryEffect>,
+    idempotency: HashMap<(String, String), String>,
+    maximum_effects: usize,
+}
+
+#[cfg(test)]
+impl InMemorySipEffectLedger {
+    pub fn new(maximum_effects: usize) -> Result<Self, SipEffectError> {
+        if maximum_effects == 0 || maximum_effects > EFFECTS_HARD_CEILING {
+            return Err(SipEffectError::InvalidInput);
+        }
+        Ok(Self {
+            effects: HashMap::with_capacity(maximum_effects.min(64)),
+            idempotency: HashMap::with_capacity(maximum_effects.min(64)),
+            maximum_effects,
+        })
+    }
+
+    pub fn prepare(
+        &mut self,
+        effect: PreparedSipEffect,
+    ) -> Result<SipEffectPrepareOutcome, SipEffectError> {
+        effect.validate()?;
+        let key = (
+            effect.identity.tenant_id.clone(),
+            effect.identity.protocol_effect_id.clone(),
+        );
+        let idempotency_key = (
+            effect.identity.tenant_id.clone(),
+            effect.identity.idempotency_key.clone(),
+        );
+        let by_effect = self.effects.get(&key);
+        let by_idempotency = self
+            .idempotency
+            .get(&idempotency_key)
+            .and_then(|effect_id| {
+                self.effects
+                    .get(&(effect.identity.tenant_id.clone(), effect_id.clone()))
+            });
+        if let Some(existing) = by_effect.or(by_idempotency) {
+            if existing.prepared.identity != effect.identity
+                || existing.prepared.canonical_wire_bytes != effect.canonical_wire_bytes
+            {
+                return Err(SipEffectError::IdempotencyConflict);
+            }
+            return Ok(SipEffectPrepareOutcome {
+                record: existing.record.clone(),
+                replayed: true,
+            });
+        }
+        if self.effects.len() >= self.maximum_effects {
+            return Err(SipEffectError::CapacityExhausted);
+        }
+        let record = SipEffectRecord {
+            identity: effect.identity.clone(),
+            canonical_wire_bytes: effect.canonical_wire_bytes.clone(),
+            adapter_identity: effect.adapter_identity.clone(),
+            route_binding: effect.route_binding.clone(),
+            wire_attempt_facts: effect.wire_attempt_facts.clone(),
+            state: SipEffectState::Prepared,
+            revision: 1,
+            unknown_count: 0,
+            last_receipt_id: None,
+            last_receipt_hash: None,
+            failure_code: String::new(),
+            repair_delay_ms: None,
+            repair_epoch_high_watermark: 0,
+            repair_claim: None,
+            repair_attempts: 0,
+            prepared_at: effect.prepared_at,
+            audit_until: effect.audit_until,
+        };
+        self.idempotency
+            .insert(idempotency_key, effect.identity.protocol_effect_id.clone());
+        self.effects.insert(
+            key,
+            InMemoryEffect {
+                prepared: effect,
+                record: record.clone(),
+                receipts: HashMap::new(),
+            },
+        );
+        Ok(SipEffectPrepareOutcome {
+            record,
+            replayed: false,
+        })
+    }
+
+    pub fn query(
+        &self,
+        identity: &SipEffectIdentity,
+    ) -> Result<Option<SipEffectRecord>, SipEffectError> {
+        identity.validate()?;
+        let key = (
+            identity.tenant_id.clone(),
+            identity.protocol_effect_id.clone(),
+        );
+        let Some(effect) = self.effects.get(&key) else {
+            return Ok(None);
+        };
+        if &effect.record.identity != identity {
+            return Err(SipEffectError::IdentityConflict);
+        }
+        Ok(Some(effect.record.clone()))
+    }
+
+    pub fn apply(
+        &mut self,
+        receipt: SipEffectReceipt,
+    ) -> Result<SipEffectApplyOutcome, SipEffectError> {
+        self.apply_inner(receipt)
+    }
+
+    fn apply_inner(
+        &mut self,
+        receipt: SipEffectReceipt,
+    ) -> Result<SipEffectApplyOutcome, SipEffectError> {
+        receipt.fence.identity.validate()?;
+        checked_identifier(&receipt.receipt_id)?;
+        checked_hash(&receipt.receipt_hash)?;
+        validate_receipt_details(
+            receipt.level,
+            &receipt.failure_code,
+            receipt.repair_delay_ms,
+        )?;
+        if receipt.receipt_hash
+            != receipt_hash(
+                &receipt.fence,
+                &receipt.receipt_id,
+                receipt.level,
+                &receipt.failure_code,
+                receipt.repair_delay_ms,
+            )?
+        {
+            return Err(SipEffectError::InvalidInput);
+        }
+        let key = (
+            receipt.fence.identity.tenant_id.clone(),
+            receipt.fence.identity.protocol_effect_id.clone(),
+        );
+        let effect = self
+            .effects
+            .get_mut(&key)
+            .ok_or(SipEffectError::IdentityConflict)?;
+        if effect.record.identity != receipt.fence.identity {
+            return Err(SipEffectError::IdentityConflict);
+        }
+        if let Some(stored) = effect.receipts.get(&receipt.receipt_id) {
+            if stored.receipt_hash != receipt.receipt_hash || stored.level != receipt.level {
+                return Err(SipEffectError::ReceiptConflict);
+            }
+            return Ok(SipEffectApplyOutcome {
+                record: effect.record.clone(),
+                semantic: stored.semantic,
+                replayed: true,
+            });
+        }
+        if effect.record.state.is_terminal() {
+            return Err(SipEffectError::Terminal);
+        }
+        if effect.record.revision != receipt.fence.expected_revision {
+            return Err(SipEffectError::FenceLost);
+        }
+        let semantic = classify_receipt(effect.record.state, receipt.level)?;
+        if effect.record.state == SipEffectState::Unknown {
+            let repair_fence = receipt
+                .repair_fence
+                .as_ref()
+                .ok_or(SipEffectError::RepairFenceRequired)?;
+            if effect.record.repair_claim.as_ref() != Some(repair_fence)
+                || repair_fence.repair_claim_revision != effect.record.revision
+            {
+                return Err(SipEffectError::FenceLost);
+            }
+        } else if receipt.repair_fence.is_some() {
+            return Err(SipEffectError::FenceLost);
+        }
+        if effect.receipts.len() >= RECEIPTS_PER_EFFECT_HARD_CEILING {
+            return Err(SipEffectError::CapacityExhausted);
+        }
+        let next_revision = effect
+            .record
+            .revision
+            .checked_add(1)
+            .ok_or(SipEffectError::CapacityExhausted)?;
+        let next_unknown_count = if receipt.level == SipEffectReceiptLevel::Unknown {
+            effect
+                .record
+                .unknown_count
+                .checked_add(1)
+                .ok_or(SipEffectError::CapacityExhausted)?
+        } else {
+            effect.record.unknown_count
+        };
+        effect.record.state = receipt.level.state();
+        effect.record.revision = next_revision;
+        effect.record.last_receipt_id = Some(receipt.receipt_id.clone());
+        effect.record.last_receipt_hash = Some(receipt.receipt_hash.clone());
+        effect.record.failure_code = receipt.failure_code.clone();
+        effect.record.repair_delay_ms = receipt.repair_delay_ms;
+        effect.record.repair_claim = None;
+        effect.record.unknown_count = next_unknown_count;
+        effect.receipts.insert(
+            receipt.receipt_id,
+            StoredReceipt {
+                receipt_hash: receipt.receipt_hash,
+                level: receipt.level,
+                semantic,
+            },
+        );
+        Ok(SipEffectApplyOutcome {
+            record: effect.record.clone(),
+            semantic,
+            replayed: false,
+        })
+    }
+
+    pub fn claim_unknown(
+        &mut self,
+        identity: &SipEffectIdentity,
+        repair_owner_id: &str,
+        repair_owner_epoch: u64,
+        repair_claim_token: &str,
+    ) -> Result<SipEffectRepairFence, SipEffectError> {
+        identity.validate()?;
+        checked_identifier(repair_owner_id)?;
+        checked_identifier(repair_claim_token)?;
+        if repair_owner_epoch == 0 {
+            return Err(SipEffectError::InvalidInput);
+        }
+        let key = (
+            identity.tenant_id.clone(),
+            identity.protocol_effect_id.clone(),
+        );
+        let effect = self
+            .effects
+            .get_mut(&key)
+            .ok_or(SipEffectError::IdentityConflict)?;
+        if &effect.record.identity != identity {
+            return Err(SipEffectError::IdentityConflict);
+        }
+        if effect.record.state != SipEffectState::Unknown
+            || effect.record.repair_claim.is_some()
+            || repair_owner_epoch <= effect.record.repair_epoch_high_watermark
+        {
+            return Err(SipEffectError::FenceLost);
+        }
+        if effect.record.repair_attempts >= REPAIR_ATTEMPTS_HARD_CEILING {
+            return Err(SipEffectError::RepairExhausted);
+        }
+        let claim_revision = effect
+            .record
+            .revision
+            .checked_add(1)
+            .ok_or(SipEffectError::CapacityExhausted)?;
+        let fence = SipEffectRepairFence {
+            repair_owner_id: repair_owner_id.to_string(),
+            repair_owner_epoch,
+            repair_claim_token: repair_claim_token.to_string(),
+            repair_claim_revision: claim_revision,
+        };
+        effect.record.revision = claim_revision;
+        effect.record.repair_epoch_high_watermark = repair_owner_epoch;
+        effect.record.repair_attempts += 1;
+        effect.record.repair_claim = Some(fence.clone());
+        Ok(fence)
+    }
+
+    pub fn reconcile(
+        &mut self,
+        identity: &SipEffectIdentity,
+        repair_fence: &SipEffectRepairFence,
+        receipt_id: &str,
+        outcome: SipEffectReconcileOutcome,
+    ) -> Result<SipEffectApplyOutcome, SipEffectError> {
+        let record = self
+            .query(identity)?
+            .ok_or(SipEffectError::IdentityConflict)?;
+        if record.repair_claim.as_ref() != Some(repair_fence)
+            || record.revision != repair_fence.repair_claim_revision
+        {
+            return Err(SipEffectError::FenceLost);
+        }
+        let (level, failure_code, repair_delay_ms) = match outcome {
+            SipEffectReconcileOutcome::ProtocolObserved => {
+                (SipEffectReceiptLevel::ProtocolObserved, "", None)
+            }
+            SipEffectReconcileOutcome::Failed => {
+                (SipEffectReceiptLevel::Failed, "reconciliation_failed", None)
+            }
+            SipEffectReconcileOutcome::Unknown { repair_after_ms } => {
+                (SipEffectReceiptLevel::Unknown, "", Some(repair_after_ms))
+            }
+        };
+        let mut receipt = SipEffectReceipt::new(
+            record.fence(),
+            receipt_id,
+            level,
+            failure_code,
+            repair_delay_ms,
+        )?;
+        receipt.repair_fence = Some(repair_fence.clone());
+        self.apply_inner(receipt)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SipEffectReconcileOutcome {
+    ProtocolObserved,
+    Failed,
+    Unknown { repair_after_ms: u32 },
+}
+
+pub fn retry_after_seconds(
+    pool_wait_ms: u32,
+    queue_depth: u32,
+    retry_attempt: u8,
+) -> Result<u8, SipEffectError> {
+    if pool_wait_ms > STORE_POOL_WAIT_MS_HARD_CEILING
+        || queue_depth > STORE_QUEUE_DEPTH_HARD_CEILING
+        || retry_attempt > STORE_RETRY_ATTEMPT_HARD_CEILING
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    let seconds =
+        1_u32 + pool_wait_ms.div_ceil(1_000) + queue_depth.div_ceil(256) + u32::from(retry_attempt);
+    Ok(seconds.clamp(1, 30) as u8)
+}
+
+pub fn sha256_lower_hex(value: &[u8]) -> String {
+    let digest = Sha256::digest(value);
+    let mut encoded = String::with_capacity(64);
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    for byte in digest {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
+
+pub fn canonical_json_sha256(value: &Value) -> Result<String, SipEffectError> {
+    let mut canonical = String::new();
+    write_canonical_json(value, 0, &mut canonical)?;
+    if canonical.len() > JSON_BYTES_HARD_CEILING {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(sha256_lower_hex(canonical.as_bytes()))
+}
+
+fn write_canonical_json(
+    value: &Value,
+    depth: usize,
+    output: &mut String,
+) -> Result<(), SipEffectError> {
+    if depth > 16 || output.len() > JSON_BYTES_HARD_CEILING {
+        return Err(SipEffectError::InvalidInput);
+    }
+    match value {
+        Value::Null => output.push_str("null"),
+        Value::Bool(value) => output.push_str(if *value { "true" } else { "false" }),
+        Value::Number(value) => {
+            if let Some(unsigned) = value.as_u64() {
+                if unsigned > JSON_SAFE_INTEGER_HARD_CEILING {
+                    return Err(SipEffectError::InvalidInput);
+                }
+                output.push_str(&unsigned.to_string());
+            } else if let Some(signed) = value.as_i64() {
+                if signed.unsigned_abs() > JSON_SAFE_INTEGER_HARD_CEILING {
+                    return Err(SipEffectError::InvalidInput);
+                }
+                output.push_str(&signed.to_string());
+            } else {
+                // The shared TypeScript canonicalizer receives IEEE-754 numbers.
+                // Reject fractional/exponent inputs here instead of risking a
+                // silently different Rust rendering (for example 1.0 vs 1).
+                return Err(SipEffectError::InvalidInput);
+            }
+        }
+        Value::String(value) => output
+            .push_str(&serde_json::to_string(value).map_err(|_| SipEffectError::InvalidInput)?),
+        Value::Array(values) => {
+            output.push('[');
+            for (index, value) in values.iter().enumerate() {
+                if index > 0 {
+                    output.push(',');
+                }
+                write_canonical_json(value, depth + 1, output)?;
+            }
+            output.push(']');
+        }
+        Value::Object(values) => {
+            output.push('{');
+            let mut keys: Vec<_> = values.keys().collect();
+            // JavaScript Array#sort compares UTF-16 code units. Match that
+            // ordering exactly rather than Rust's UTF-8 byte ordering.
+            keys.sort_unstable_by(|left, right| left.encode_utf16().cmp(right.encode_utf16()));
+            for (index, key) in keys.into_iter().enumerate() {
+                if index > 0 {
+                    output.push(',');
+                }
+                output.push_str(
+                    &serde_json::to_string(key).map_err(|_| SipEffectError::InvalidInput)?,
+                );
+                output.push(':');
+                write_canonical_json(
+                    values.get(key).ok_or(SipEffectError::InvalidInput)?,
+                    depth + 1,
+                    output,
+                )?;
+            }
+            output.push('}');
+        }
+    }
+    if output.len() > JSON_BYTES_HARD_CEILING {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(())
+}
+
+fn receipt_hash(
+    fence: &SipEffectFence,
+    receipt_id: &str,
+    level: SipEffectReceiptLevel,
+    failure_code: &str,
+    repair_delay_ms: Option<u32>,
+) -> Result<String, SipEffectError> {
+    canonical_json_sha256(&serde_json::json!({
+        "identity": protocol_effect_identity_json(&fence.identity),
+        "receipt_id": receipt_id,
+        "level": level.as_str(),
+        "failure_code": failure_code,
+        "repair_delay_ms": repair_delay_ms,
+    }))
+}
+
+pub fn protocol_effect_identity_hash(
+    identity: &SipEffectIdentity,
+) -> Result<String, SipEffectError> {
+    identity.validate()?;
+    canonical_json_sha256(&protocol_effect_identity_json(identity))
+}
+
+pub fn sip_wire_freeze_sha256(
+    route_binding_sha256: &str,
+    wire_attempt_facts_sha256: &str,
+    wire_sha256: &str,
+    wire_length_bytes: u32,
+) -> Result<String, SipEffectError> {
+    checked_hash(route_binding_sha256)?;
+    checked_hash(wire_attempt_facts_sha256)?;
+    checked_hash(wire_sha256)?;
+    if wire_length_bytes == 0 || wire_length_bytes as usize > WIRE_BYTES_HARD_CEILING {
+        return Err(SipEffectError::InvalidInput);
+    }
+    canonical_json_sha256(&serde_json::json!({
+        "route_binding_sha256": route_binding_sha256,
+        "wire_attempt_facts_sha256": wire_attempt_facts_sha256,
+        "wire_sha256": wire_sha256,
+        "wire_length_bytes": wire_length_bytes,
+    }))
+}
+
+fn protocol_effect_identity_json(identity: &SipEffectIdentity) -> Value {
+    serde_json::json!({
+        "tenant_id": identity.tenant_id,
+        "protocol_effect_id": identity.protocol_effect_id,
+        "protocol_session_id": identity.protocol_session_id,
+        "protocol_session_generation": identity.protocol_session_generation,
+        "decision_id": identity.decision_id,
+        "idempotency_key": identity.idempotency_key,
+        "request_hash": identity.request_hash,
+        "command_id": identity.command_id,
+        "adapter_identity_hash": identity.adapter_identity_hash,
+        "wire_bytes_hash": identity.wire_bytes_hash,
+        "wire_length_bytes": identity.wire_length_bytes,
+        "route_binding_hash": identity.route_binding_hash,
+        "wire_attempt_facts_hash": identity.wire_attempt_facts_hash,
+        "wire_freeze_sha256": identity.wire_freeze_sha256,
+        "owner_epoch": identity.owner_epoch.to_string(),
+        "command_sequence": identity.command_sequence.to_string(),
+    })
+}
+
+fn checked_identifier(value: &str) -> Result<(), SipEffectError> {
+    if value.is_empty()
+        || value.len() > IDENTIFIER_HARD_CEILING
+        || !value.bytes().all(|byte| (b'!'..=b'~').contains(&byte))
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(())
+}
+
+fn checked_hash(value: &str) -> Result<(), SipEffectError> {
+    if value.len() != 64
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(SipEffectError::InvalidInput);
+    }
+    Ok(())
+}
+
+fn validate_receipt_details(
+    level: SipEffectReceiptLevel,
+    failure_code: &str,
+    repair_delay_ms: Option<u32>,
+) -> Result<(), SipEffectError> {
+    match level {
+        SipEffectReceiptLevel::Unknown => {
+            if !failure_code.is_empty()
+                || repair_delay_ms.is_none()
+                || repair_delay_ms.is_some_and(|value| value > REPAIR_DELAY_MS_HARD_CEILING)
+            {
+                return Err(SipEffectError::InvalidInput);
+            }
+        }
+        SipEffectReceiptLevel::Failed => {
+            if failure_code.is_empty()
+                || failure_code.encode_utf16().count() > FAILURE_CODE_HARD_CEILING
+                || failure_code.contains(['\0', '\r', '\n'])
+                || repair_delay_ms.is_some()
+            {
+                return Err(SipEffectError::InvalidInput);
+            }
+        }
+        _ => {
+            if !failure_code.is_empty() || repair_delay_ms.is_some() {
+                return Err(SipEffectError::InvalidInput);
+            }
+        }
+    }
+    Ok(())
+}
