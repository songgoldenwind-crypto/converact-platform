+pub const SIP_EFFECT_SCHEMA_VERSION: u16 = 1;
+pub const SIP_EFFECT_SCHEMA_HASH: &str =
+    "ae27a73dac95c90686f8020c2fb5e92dd016cc1712216d03b227ec3a6d6ca5ba";
