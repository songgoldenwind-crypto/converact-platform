+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct SipEffectIdentity {
+    pub tenant_id: String,
+    pub protocol_effect_id: String,
+    pub protocol_session_id: String,
+    pub protocol_session_generation: String,
+    pub decision_id: String,
+    pub idempotency_key: String,
+    pub request_hash: String,
+    pub command_id: String,
+    pub adapter_identity_hash: String,
+    pub wire_bytes_hash: String,
+    pub wire_length_bytes: u32,
+    pub route_binding_hash: String,
+    pub wire_attempt_facts_hash: String,
+    pub wire_freeze_sha256: String,
+    pub owner_epoch: u64,
+    pub command_sequence: u64,
+}
+
+impl SipEffectIdentity {
+    pub(crate) fn validate(&self) -> Result<(), SipEffectError> {
+        for identifier in [
+            &self.tenant_id,
+            &self.protocol_effect_id,
+            &self.protocol_session_id,
+            &self.protocol_session_generation,
+            &self.decision_id,
+            &self.idempotency_key,
+            &self.command_id,
+        ] {
+            checked_identifier(identifier)?;
+        }
+        for hash in [
+            &self.request_hash,
+            &self.adapter_identity_hash,
+            &self.wire_bytes_hash,
+            &self.route_binding_hash,
+            &self.wire_attempt_facts_hash,
+            &self.wire_freeze_sha256,
+        ] {
+            checked_hash(hash)?;
+        }
+        if self.owner_epoch == 0 || self.command_sequence == 0 {
+            return Err(SipEffectError::InvalidInput);
+        }
+        if self.wire_length_bytes == 0 || self.wire_length_bytes as usize > WIRE_BYTES_HARD_CEILING
+        {
+            return Err(SipEffectError::InvalidInput);
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PreparedSipEffect {
+    pub identity: SipEffectIdentity,
+    pub canonical_wire_bytes: Vec<u8>,
+    pub adapter_identity: Value,
+    pub route_binding: Value,
+    pub wire_attempt_facts: Value,
+    pub prepared_at: DateTime<Utc>,
+    pub audit_until: DateTime<Utc>,
+}
+
+impl PreparedSipEffect {
+    pub fn validate(&self) -> Result<(), SipEffectError> {
+        self.identity.validate()?;
+        if self.canonical_wire_bytes.is_empty()
+            || self.canonical_wire_bytes.len() > WIRE_BYTES_HARD_CEILING
+            || sha256_lower_hex(&self.canonical_wire_bytes) != self.identity.wire_bytes_hash
+            || self.canonical_wire_bytes.len() != self.identity.wire_length_bytes as usize
+            || self.audit_until <= self.prepared_at
+        {
+            return Err(SipEffectError::InvalidInput);
+        }
+        for (value, expected_hash) in [
+            (&self.adapter_identity, &self.identity.adapter_identity_hash),
+            (&self.route_binding, &self.identity.route_binding_hash),
+            (
+                &self.wire_attempt_facts,
+                &self.identity.wire_attempt_facts_hash,
+            ),
+        ] {
+            if !value.is_object() || canonical_json_sha256(value)? != expected_hash.as_str() {
+                return Err(SipEffectError::InvalidInput);
+            }
+        }
+        let semantic_intent = self
+            .wire_attempt_facts
+            .get("semantic_intent_sha256")
+            .and_then(Value::as_str)
+            .ok_or(SipEffectError::InvalidInput)?;
+        checked_hash(semantic_intent)?;
+        if semantic_intent != self.identity.request_hash
+            || sip_wire_freeze_sha256(
+                &self.identity.route_binding_hash,
+                &self.identity.wire_attempt_facts_hash,
+                &self.identity.wire_bytes_hash,
+                self.identity.wire_length_bytes,
+            )? != self.identity.wire_freeze_sha256
+        {
+            return Err(SipEffectError::InvalidInput);
+        }
+        Ok(())
+    }
+}
