+                    &format!("receipt-unknown-{attempt}"),
+                    SipEffectReconcileOutcome::Unknown { repair_after_ms: 0 },
+                )
+                .unwrap()
+                .record;
+        }
+        assert_eq!(unknown.repair_attempts, 8);
+        assert_eq!(
+            ledger
+                .claim_unknown(&identity, "repair-worker", 9, "claim-9")
+                .unwrap_err(),
+            SipEffectError::RepairExhausted,
+        );
+    }
+}
