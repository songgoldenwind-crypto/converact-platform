+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SipEffectReceipt {
+    pub fence: SipEffectFence,
+    pub receipt_id: String,
+    pub receipt_hash: String,
+    pub level: SipEffectReceiptLevel,
+    pub failure_code: String,
+    pub repair_delay_ms: Option<u32>,
+    repair_fence: Option<SipEffectRepairFence>,
+}
+
+impl SipEffectReceipt {
+    pub fn new(
+        fence: SipEffectFence,
+        receipt_id: &str,
+        level: SipEffectReceiptLevel,
+        failure_code: &str,
+        repair_delay_ms: Option<u32>,
+    ) -> Result<Self, SipEffectError> {
+        fence.identity.validate()?;
+        checked_identifier(receipt_id)?;
+        validate_receipt_details(level, failure_code, repair_delay_ms)?;
+        let receipt_hash = receipt_hash(&fence, receipt_id, level, failure_code, repair_delay_ms)?;
+        Ok(Self {
+            fence,
+            receipt_id: receipt_id.to_string(),
+            receipt_hash,
+            level,
+            failure_code: failure_code.to_string(),
+            repair_delay_ms,
+            repair_fence: None,
+        })
+    }
+}
