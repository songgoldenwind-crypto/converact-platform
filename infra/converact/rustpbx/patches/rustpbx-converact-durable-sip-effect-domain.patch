+const IDENTIFIER_HARD_CEILING: usize = 200;
+const FAILURE_CODE_HARD_CEILING: usize = 128;
+const WIRE_BYTES_HARD_CEILING: usize = 65_535;
+const JSON_BYTES_HARD_CEILING: usize = 65_536;
+#[cfg(test)]
+const EFFECTS_HARD_CEILING: usize = 1_000_000;
+#[cfg(test)]
+const RECEIPTS_PER_EFFECT_HARD_CEILING: usize = 32;
+#[cfg(test)]
+const REPAIR_ATTEMPTS_HARD_CEILING: u8 = 8;
+const REPAIR_DELAY_MS_HARD_CEILING: u32 = 86_400_000;
+const STORE_POOL_WAIT_MS_HARD_CEILING: u32 = 250;
+const STORE_QUEUE_DEPTH_HARD_CEILING: u32 = 1_024;
+const STORE_RETRY_ATTEMPT_HARD_CEILING: u8 = 3;
+const JSON_SAFE_INTEGER_HARD_CEILING: u64 = 9_007_199_254_740_991;
