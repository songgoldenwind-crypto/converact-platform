+
+struct RecordingLifecycleExecutor {
+    sender: crossbeam_channel::Sender<RecordingLifecycleTask>,
+    _workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl RecordingLifecycleExecutor {
+    fn new() -> Self {
+        let (sender, receiver) = crossbeam_channel::bounded::<RecordingLifecycleTask>(
+            DEFAULT_RECORDING_LIFECYCLE_QUEUE_CAPACITY,
+        );
+        let mut workers = Vec::with_capacity(DEFAULT_RECORDING_LIFECYCLE_WORKERS);
+        for worker_index in 0..DEFAULT_RECORDING_LIFECYCLE_WORKERS {
+            let receiver = receiver.clone();
+            let worker = std::thread::Builder::new()
+                .name(format!("rustpbx-recording-lifecycle-{worker_index}"))
+                .spawn(move || {
+                    while let Ok(task) = receiver.recv() {
+                        task.run();
+                    }
+                })
+                .expect("recording lifecycle worker must start");
+            workers.push(worker);
+        }
+        Self {
+            sender,
+            _workers: workers,
+        }
+    }
+
+    fn submit(&self, task: RecordingLifecycleTask) -> bool {
+        match self.sender.try_send(task) {
+            Ok(()) => true,
+            Err(error) => {
+                let task = error.into_inner();
+                let session_id = task.session_id().to_string();
+                task.reset_finalization();
+                warn!(session_id = %session_id, "Recording lifecycle queue unavailable");
+                recording_failed(
+                    task.event_tx(),
+                    session_id,
+                    "recording_lifecycle_queue_unavailable",
+                );
+                false
+            }
+        }
+    }
+}
+
+fn recording_lifecycle_executor() -> &'static RecordingLifecycleExecutor {
+    RECORDING_LIFECYCLE_EXECUTOR.get_or_init(RecordingLifecycleExecutor::new)
+}
+
+fn recording_failed(
+    event_tx: &broadcast::Sender<MediaEvent>,
+    session_id: String,
+    failure_code: &'static str,
+) {
+    let _ = event_tx.send(MediaEvent::RecordingFailed {
+        session_id,
+        failure_code: failure_code.to_string(),
+    });
+}
+
+fn spawn_recording_finalizer(task: RecordingLifecycleTask) -> bool {
+    recording_lifecycle_executor().submit(task)
+}

