+
+impl RecordingLifecycleTask {
+    fn session_id(&self) -> &str {
+        match self {
+            Self::Start { session_id, .. } | Self::Finalize { session_id, .. } => session_id,
+        }
+    }
+
+    fn event_tx(&self) -> &broadcast::Sender<MediaEvent> {
+        match self {
+            Self::Start { event_tx, .. } | Self::Finalize { event_tx, .. } => event_tx,
+        }
+    }
+
+    fn reset_finalization(&self) {
