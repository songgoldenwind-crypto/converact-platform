+            }
+            Self::Finalize {
+                session_id,
+                recorder,
+                capture,
+                recording_finalization_started,
+                duration_secs,
+                reply,
+                event_tx,
+            } => {
+                if let Some(capture) = capture.as_ref()
+                    && !capture.wait_until_drained(Duration::from_millis(100))
+                {
+                    capture.disable();
+                    if !capture.wait_until_drained(Duration::from_millis(100)) {
+                        recording_finalization_started.store(false, Ordering::Release);
+                        recording_failed(&event_tx, session_id, "recording_capture_drain_timeout");
+                        return;
+                    }
+                }
+                let Some(mut guard) = recorder.try_write() else {
+                    recording_finalization_started.store(false, Ordering::Release);
+                    recording_failed(&event_tx, session_id, "recording_finalize_lock_unavailable");
+                    return;
+                };
+                let recorder = guard.take();
+                drop(guard);
+                let Some(mut recorder) = recorder else {
+                    return;
+                };
+                if let Some(capture) = capture.as_ref() {
+                    capture.register_drop_counter(&mut recorder);
+                }
+                let path = recorder.path.clone();
+                if let Err(error) = recorder.finalize() {
+                    warn!(session_id = %session_id, error = %error, "Recording finalization failed");
+                    recording_failed(&event_tx, session_id, "recording_finalize_failed");
+                    return;
+                }
+                let file_size = std::fs::metadata(&path)
+                    .map(|metadata| metadata.len())
+                    .unwrap_or(0);
