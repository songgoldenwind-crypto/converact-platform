+            recording_finalization_started.store(false, Ordering::Release);
+        }
+    }
+
+    fn run(self) {
+        match self {
+            Self::Start {
+                session_id,
+                config,
+                caller_profile,
+                callee_profile,
+                recorder,
+                recording_paused,
+                recording_finalization_started,
+                reply,
+                event_tx,
+            } => {
+                if recording_finalization_started.load(Ordering::Acquire) {
+                    recording_failed(&event_tx, session_id, "recording_start_cancelled");
+                    return;
+                }
+                let recorder_codec = caller_profile
+                    .as_ref()
+                    .or(callee_profile.as_ref())
+                    .and_then(|profile| profile.audio.as_ref())
+                    .map(|codec| codec.codec)
+                    .unwrap_or(audio_codec::CodecType::PCMU);
+                let path = config.path;
+                let mut created = match crate::media::recorder::Recorder::new_with_spool(
+                    &path,
+                    recorder_codec,
+                    config.ivekit_spool,
+                ) {
+                    Ok(created) => created,
+                    Err(error) => {
+                        warn!(session_id = %session_id, error = %error, "Recording start failed");
+                        recording_failed(&event_tx, session_id, "recording_storage_unavailable");
+                        return;
+                    }
+                };
+                if let Some(profile) = caller_profile {
+                    created.set_leg_profile(crate::media::recorder::Leg::A, profile);
+                }
+                if let Some(profile) = callee_profile {
+                    created.set_leg_profile(crate::media::recorder::Leg::B, profile);
+                }
+                if recording_finalization_started.load(Ordering::Acquire) {
+                    let _ = created.finalize();
+                    recording_failed(&event_tx, session_id, "recording_start_cancelled");
+                    return;
+                }
+                let mut guard = recorder.write();
+                if guard.is_some() || recording_finalization_started.load(Ordering::Acquire) {
