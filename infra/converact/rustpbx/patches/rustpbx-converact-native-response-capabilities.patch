+struct NativeResponseTransactionBinding {
+    call_id: Box<str>,
+    cseq_sequence: u32,
+    from: Box<str>,
+    via: Box<str>,
+    to_base: Box<str>,
+    local_to_tag: Box<str>,
+}
+
+impl NativeResponseTransactionBinding {
+    fn freeze(transaction: &mut Transaction) -> Result<Self, NativeSipEffectCapabilityError> {
+        let cseq = transaction
+            .original
+            .cseq_header()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        let to = transaction
+            .original
+            .to_header()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        if cseq.method().ok() != Some(rsipstack::sip::Method::Invite)
+            || to
+                .tag()
+                .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+                .is_some()
+        {
+            return Err(NativeSipEffectCapabilityError::InvalidConfiguration);
+        }
+        let tagged_to = to.clone().with_tag(make_tag());
+        let local_to_tag = tagged_to
+            .tag()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+            .map(|tag| tag.to_string())
+            .filter(|tag| !tag.is_empty())
+            .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        let mut to = tagged_to
+            .typed()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        to.params
+            .retain(|param| !matches!(param, rsipstack::sip::Param::Tag(_)));
+        let binding = Self {
+            call_id: transaction
+                .original
+                .call_id_header()
+                .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+                .value()
+                .into(),
+            cseq_sequence: cseq
+                .seq()
+                .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?,
+            from: transaction
+                .original
+                .from_header()
+                .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+                .value()
+                .into(),
+            via: transaction
+                .original
+                .top_via_header()
+                .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+                .value()
+                .into(),
+            to_base: to.to_string().into(),
+            local_to_tag: local_to_tag.into(),
+        };
+        transaction.original.headers.unique_push(tagged_to.into());
+        Ok(binding)
+    }
+
+    fn validate(&self, message: &SipMessage) -> Result<(), NativeSipEffectCapabilityError> {
+        let SipMessage::Response(response) = message else {
+            return Err(NativeSipEffectCapabilityError::InvalidConfiguration);
+        };
+        let status = response.status_code.code();
+        let cseq = response
+            .cseq_header()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        let mut to = response
+            .to_header()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?
+            .typed()
+            .map_err(|_| NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        let local_tag = to
+            .tag()
+            .map(ToString::to_string)
+            .filter(|tag| !tag.is_empty())
+            .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+        to.params
+            .retain(|param| !matches!(param, rsipstack::sip::Param::Tag(_)));
+        if !(101..=699).contains(&status)
+            || cseq.method().ok() != Some(rsipstack::sip::Method::Invite)
+            || cseq.seq().ok() != Some(self.cseq_sequence)
+            || !response
+                .call_id_header()
+                .ok()
+                .is_some_and(|header| header.value() == self.call_id.as_ref())
+            || !response
+                .from_header()
+                .ok()
+                .is_some_and(|header| header.value() == self.from.as_ref())
+            || !response
+                .top_via_header()
+                .ok()
+                .is_some_and(|header| header.value() == self.via.as_ref())
+            || to.to_string() != self.to_base.as_ref()
+        {
+            return Err(NativeSipEffectCapabilityError::InvalidConfiguration);
+        }
+        if self.local_to_tag.as_ref() != local_tag {
+            return Err(NativeSipEffectCapabilityError::InvalidConfiguration);
+        }
+        Ok(())
+    }
+}
