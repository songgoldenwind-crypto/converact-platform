+#[async_trait]
+impl EgressEffectGate for NativeCallEgressGate {
+    async fn prepare(
+        &self,
+        transaction_key: &TransactionKey,
+        message: &SipMessage,
+        transport_binding: &EgressTransportBinding,
+        canonical_wire_bytes: &[u8],
+    ) -> rsipstack::Result<EgressEffectPermit> {
+        if transaction_key != &self.transaction_key {
+            return Err(rsipstack_gate_error(
+                NativeSipEffectCapabilityError::InvalidConfiguration,
+            ));
+        }
+        self.response_transaction
+            .validate(message)
+            .map_err(rsipstack_gate_error)?;
+        let mut reservation = self
+            .active_calls
+            .reserve_ordinary_response_capability(
+                &self.provider_call_id,
+                transaction_key,
+                message,
+                canonical_wire_bytes,
+            )
+            .map_err(|error| rsipstack_gate_error(error.into()))?;
+        let intent = ordinary_response_intent(
+            reservation.facts(),
+            self.route_binding.clone(),
+            self.adapter_identity.clone(),
+            self.audit_retention,
+        )
+        .map_err(rsipstack_gate_error)?;
+        let _intent_lease = self
+            .intents
+            .register(transaction_key, message, intent)
+            .map_err(|error| rsipstack_gate_error(error.into()))?;
+
+        // Once the durable store future starts, cancellation or panic can no
+        // longer prove that no row was committed. Retain the exact Native Call
+        // binding by default and release it only for a typed, unambiguous
+        // pre-send failure.
+        reservation.arm_for_durable_prepare();
+        let prepare_result = self
+            .durable
+            .prepare_registered(
+                transaction_key,
+                message,
+                transport_binding,
+                canonical_wire_bytes,
+            )
+            .await;
+        match prepare_result {
+            Ok(permit) => {
+                if let Err(error) = reservation.commit_after_durable_prepare() {
+                    self.durable
+                        .observe_transport(permit, EgressEffectOutcome::TransportUnknown);
+                    return Err(rsipstack_gate_error(error.into()));
+                }
+                Ok(permit)
+            }
+            Err(SipEffectGateError::ReconciliationRequired) => {
+                drop(reservation);
+                Err(rsipstack_gate_error(
+                    SipEffectGateError::ReconciliationRequired.into(),
+                ))
+            }
+            Err(error) => {
+                reservation.release_after_unambiguous_failure();
+                Err(rsipstack_gate_error(error.into()))
+            }
+        }
+    }
+
+    async fn prepare_derived(
+        &self,
+        parent_permit: &EgressEffectPermit,
+        kind: EgressDerivedEffectKind,
+        transaction_key: &TransactionKey,
+        trigger_message: &SipMessage,
+        message: &SipMessage,
+        transport_binding: &EgressTransportBinding,
+        canonical_wire_bytes: &[u8],
+    ) -> rsipstack::Result<EgressEffectPermit> {
+        self.durable
+            .prepare_derived(
+                parent_permit,
+                kind,
+                transaction_key,
+                trigger_message,
+                message,
+                transport_binding,
+                canonical_wire_bytes,
+            )
+            .await
+    }
+
+    async fn prepare_peer_derived(
+        &self,
+        kind: EgressEffectPeerDerivedKind,
+        transaction_key: &TransactionKey,
+        trigger_message: &SipMessage,
+        message: &SipMessage,
+        transport_binding: &EgressTransportBinding,
+        canonical_wire_bytes: &[u8],
+        ingress_proof: PeerIngressProof,
+    ) -> rsipstack::Result<EgressEffectPermit> {
+        self.durable
+            .prepare_peer_derived(
+                kind,
+                transaction_key,
+                trigger_message,
+                message,
+                transport_binding,
+                canonical_wire_bytes,
+                ingress_proof,
+            )
+            .await
+    }
+
+    fn observe_transport(&self, permit: EgressEffectPermit, outcome: EgressEffectOutcome) {
+        self.durable.observe_transport(permit, outcome);
+    }
+
+    fn observe_protocol(
+        &self,
+        permit: EgressEffectPermit,
+        observation: EgressEffectProtocolObservation,
+    ) {
+        self.durable.observe_protocol(permit, observation);
+    }
+}
