+    pub(crate) fn reserve_ordinary_response_capability(
+        self: &Arc<Self>,
+        provider_call_id: &str,
+        transaction_key: &rsipstack::transaction::key::TransactionKey,
+        message: &rsipstack::sip::SipMessage,
+        canonical_wire_bytes: &[u8],
+    ) -> Result<NativeOrdinaryResponseCapabilityReservation, ActiveCallRegistryError> {
+        use rsipstack::sip::prelude::HeadersExt;
+
+        let response = match message {
+            rsipstack::sip::SipMessage::Response(response) => response,
+            rsipstack::sip::SipMessage::Request(_) => {
+                return Err(ActiveCallRegistryError::AuthorityConflict);
+            }
+        };
+        let status = response.status_code.code();
+        let event = match status {
+            101..=199 => NativeLegEvent::Provisional,
+            200..=299 => NativeLegEvent::Final2xx,
+            300..=699 => NativeLegEvent::FinalNon2xx,
+            _ => return Err(ActiveCallRegistryError::AuthorityConflict),
+        };
+        let cseq = response
+            .cseq_header()
+            .map_err(|_| ActiveCallRegistryError::AuthorityConflict)?;
+        if canonical_wire_bytes != message.to_bytes()
+            || cseq.method().ok() != Some(rsipstack::sip::Method::Invite)
+            || response.call_id_header().ok().map(|header| header.value()) != Some(provider_call_id)
+            || rsipstack::transaction::key::TransactionKey::from_response(
+                response,
+                rsipstack::transaction::key::TransactionRole::Server,
+            )
+            .ok()
+            .as_ref()
+                != Some(transaction_key)
+        {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+
+        let (identity, binding) = {
+            let slot = self
+                .slots
+                .get(provider_call_id)
+                .ok_or(ActiveCallRegistryError::SessionNotRegistered)?;
+            let identity = slot
+                .identity
+                .clone()
+                .ok_or(ActiveCallRegistryError::NativeCallUnavailable)?;
+            let binding = slot
+                .native_binding
+                .clone()
+                .ok_or(ActiveCallRegistryError::NativeCallUnavailable)?;
+            (identity, binding)
+        };
+        if identity.provider_call_id().as_str() != provider_call_id
+            || binding.direction != NativeLegDirection::Inbound
+        {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+
+        let transaction_key_text = transaction_key.to_string();
+        let wire_sha256 = sha256_lower_hex(canonical_wire_bytes);
+        let response_binding_sha256 = sha256_lower_hex(
+            format!(
+                "ordinary-invite-response-capability\0{}\0{}\0{}\0{}\0{}",
+                identity.tenant_id(),
+                identity.call_id(),
+                identity.generation(),
+                transaction_key_text,
+                wire_sha256,
+            )
+            .as_bytes(),
+        );
+        let binding_key = format!("ordinary-response:{response_binding_sha256}");
+        let mut state = binding
+            .cell
+            .state
+            .lock()
+            .map_err(|_| ActiveCallRegistryError::NativeCallUnavailable)?;
+        if state.closed || !state.call.matches_authority(&identity) {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+
+        let leg = state
+            .call
+            .leg(&binding.leg_id)
+            .map_err(map_native_leg_registration_error)?;
+        if leg.state == NativeLegState::Planned {
+            let event_id = format!("sip-invite-observed-{response_binding_sha256}");
+            let fence = state.call.fence();
+            let receipt = state
+                .call
+                .apply_leg_event(
+                    &fence,
+                    &binding.leg_id,
+                    &event_id,
+                    &response_binding_sha256,
+                    NativeLegEvent::InboundInviteObserved,
+                )
+                .map_err(map_native_leg_registration_error)?;
+            if receipt.required_effect != NativeRequiredEffect::None {
+                return Err(ActiveCallRegistryError::NativeCallStateConflict);
+            }
+        }
+        let leg = state
+            .call
+            .leg(&binding.leg_id)
+            .map_err(map_native_leg_registration_error)?;
+        if !matches!(leg.state, NativeLegState::Inviting | NativeLegState::Early)
+            || state.sip_effect_transactions.contains(&binding_key)
+        {
+            return Err(ActiveCallRegistryError::NativeCallStateConflict);
+        }
+        if state.sip_effect_transactions.len() >= SIP_EFFECT_TRANSACTION_CAPABILITIES_HARD_CEILING {
+            return Err(ActiveCallRegistryError::CapacityExhausted);
+        }
+
+        let command_sequence = state.next_sip_effect_command_sequence;
+        state.next_sip_effect_command_sequence = command_sequence
+            .checked_add(1)
+            .ok_or(ActiveCallRegistryError::CapacityExhausted)?;
+        state.sip_effect_transactions.insert(binding_key.clone());
+        let native_call_revision = state.call.snapshot().revision;
+        drop(state);
+
+        Ok(NativeOrdinaryResponseCapabilityReservation {
+            cell: binding.cell,
+            leg_id: binding.leg_id,
+            binding_key,
+            facts: NativeOrdinaryResponseCapabilityFacts {
+                identity,
+                transaction_key: transaction_key_text,
+                response_binding_sha256,
+                native_call_revision,
+                command_sequence,
+                event,
+            },
+            retained: false,
+        })
+    }
