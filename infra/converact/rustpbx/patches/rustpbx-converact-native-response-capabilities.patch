+#[must_use = "an uncommitted SIP response capability reservation revokes its exact binding"]
+pub(crate) struct NativeOrdinaryResponseCapabilityReservation {
+    cell: Arc<NativeCallCell>,
+    leg_id: LegId,
+    binding_key: String,
+    facts: NativeOrdinaryResponseCapabilityFacts,
+    retained: bool,
+}
+
+impl NativeOrdinaryResponseCapabilityReservation {
+    pub(crate) fn facts(&self) -> &NativeOrdinaryResponseCapabilityFacts {
+        &self.facts
+    }
+
+    pub(crate) fn commit_after_durable_prepare(mut self) -> Result<(), ActiveCallRegistryError> {
+        // A durable send-attempt may already exist. Keep the exact binding even
+        // when the concurrent Native Call revision moved; reconciliation must
+        // resolve that ambiguity instead of minting another effect identity.
+        self.retained = true;
+        let mut state = self
+            .cell
+            .state
+            .lock()
+            .map_err(|_| ActiveCallRegistryError::NativeCallUnavailable)?;
+        if state.closed
+            || !state.call.matches_authority(&self.facts.identity)
+            || state.call.snapshot().revision != self.facts.native_call_revision
+        {
+            return Err(ActiveCallRegistryError::AuthorityConflict);
+        }
+        let fence = state.call.fence();
+        let receipt = state
+            .call
+            .apply_leg_event(
+                &fence,
+                &self.leg_id,
+                &format!("sip-response-state-{}", self.facts.response_binding_sha256),
+                &self.facts.response_binding_sha256,
+                self.facts.event,
+            )
+            .map_err(map_native_leg_registration_error)?;
+        if receipt.required_effect != NativeRequiredEffect::None {
+            return Err(ActiveCallRegistryError::NativeCallStateConflict);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn arm_for_durable_prepare(&mut self) {
+        self.retained = true;
+    }
+
+    pub(crate) fn release_after_unambiguous_failure(mut self) {
+        self.retained = false;
+    }
+}
+
+impl Drop for NativeOrdinaryResponseCapabilityReservation {
+    fn drop(&mut self) {
+        if self.retained {
+            return;
+        }
+        if let Ok(mut state) = self.cell.state.lock() {
+            state.sip_effect_transactions.remove(&self.binding_key);
+        }
+    }
+}
