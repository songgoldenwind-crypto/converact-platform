+            .unwrap();
+        let mut transaction = transaction(session_id).await;
+        let transaction_key = transaction.key.clone();
+        let writer = Arc::new(TestWriter::new());
+        writer.block_prepare.store(true, Ordering::SeqCst);
+        let (runtime, _intents, mut observers) = runtime_with_writer(writer.clone());
+        let _holder = install_for_admitted_native_call(
+            Some(&runtime),
+            &registry,
+            session_id,
+            &mut transaction,
+        )
+        .expect("the Native Call gate installs")
+        .expect("the enabled runtime owns its capabilities");
+        let first = transaction.endpoint_inner.make_response(
+            &transaction.original,
+            StatusCode::Ringing,
+            None,
+        );
+        let second = transaction.endpoint_inner.make_response(
+            &transaction.original,
+            StatusCode::SessionProgress,
+            None,
+        );
+
+        let response_task = tokio::spawn(async move {
+            let result = transaction.respond(first.clone()).await;
+            (transaction, first, result)
+        });
+        writer.prepare_started.notified().await;
+        let second_message = SipMessage::Response(second);
+        registry
+            .reserve_ordinary_response_capability(
+                session_id,
+                &transaction_key,
+                &second_message,
+                &second_message.to_bytes(),
+            )
+            .expect("a distinct response reserves against the same Native Call revision")
+            .commit_after_durable_prepare()
+            .expect("the competing response advances the Native Call");
+        writer.release_prepare.notify_waiters();
+
+        let (mut transaction, first, result) = response_task.await.unwrap();
+        assert!(result.is_err());
+        assert!(observers[0].persist_next().await.unwrap());
+        assert_eq!(
+            writer.observations.lock().unwrap().as_slice(),
+            &[SipEffectDurableObservation::TransportUnknown],
+        );
+        assert!(transaction.respond(first).await.is_err());
+        assert_eq!(writer.prepared.load(Ordering::SeqCst), 1);
+    }
