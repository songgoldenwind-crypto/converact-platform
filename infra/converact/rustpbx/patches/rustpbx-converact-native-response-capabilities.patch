+fn ordinary_response_intent(
+    facts: &NativeOrdinaryResponseCapabilityFacts,
+    route_binding: Value,
+    adapter_identity: Value,
+    audit_retention: Duration,
+) -> Result<SipEffectIntent, NativeSipEffectCapabilityError> {
+    let identity = facts.identity();
+    let response_hash = facts.response_binding_sha256();
+    let event = match facts.event() {
+        crate::call::domain::native_call::NativeLegEvent::Provisional => "provisional",
+        crate::call::domain::native_call::NativeLegEvent::Final2xx => "final-2xx",
+        crate::call::domain::native_call::NativeLegEvent::FinalNon2xx => "final-non-2xx",
+        _ => return Err(NativeSipEffectCapabilityError::InvalidConfiguration),
+    };
+    let semantic_intent_sha256 = sha256_lower_hex(
+        format!(
+            "ordinary-invite-response\0{}\0{}\0{}\0{}\0{}\0{}",
+            identity.tenant_id(),
+            identity.call_id(),
+            identity.generation(),
+            facts.transaction_key(),
+            facts.native_call_revision(),
+            event,
+        )
+        .as_bytes(),
+    );
+    let effect_id = format!("sip-response-{response_hash}");
+    let prepared_at = Utc::now();
+    let audit_until = prepared_at
+        .checked_add_signed(audit_retention)
+        .ok_or(NativeSipEffectCapabilityError::InvalidConfiguration)?;
+
+    Ok(SipEffectIntent {
+        tenant_id: identity.tenant_id().to_string(),
+        protocol_effect_id: effect_id.clone(),
+        protocol_session_id: identity.call_id().as_str().to_string(),
+        protocol_session_generation: identity.generation().to_string(),
+        decision_id: format!("sip-response-decision-{response_hash}"),
+        idempotency_key: format!("sip-response-idempotency-{response_hash}"),
+        semantic_intent_sha256: semantic_intent_sha256.clone(),
+        command_id: format!("sip-response-command-{response_hash}"),
+        adapter_identity,
+        route_binding,
+        wire_attempt_facts: serde_json::json!({
+            "schema_id": "sip-foundation-wire-attempt-v1",
+            "schema_version": "1.0.0",
+            "attempt_id": effect_id.clone(),
+            "transaction_lineage_id": effect_id,
+            "semantic_intent_sha256": semantic_intent_sha256,
+            "parent_attempt_id": null,
+            "lineage_reason": "transaction_root",
+        }),
+        owner_epoch: identity.owner_epoch(),
+        command_sequence: facts.command_sequence(),
+        prepared_at,
+        audit_until,
+    })
+}
