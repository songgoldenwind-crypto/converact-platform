+        fn new(outcome: NativeSipRecoveryProbeOutcome) -> Self {
+            Self {
+                outcome: std::sync::Mutex::new(outcome),
+                requests: std::sync::Mutex::new(Vec::new()),
+                calls: AtomicUsize::new(0),
+                block: AtomicBool::new(false),
