+fn validate_recovery_transaction(
+    binding: &NativeCallRecoveryBinding,
+    provider_call_id: &str,
+    transaction: &Transaction,
+    successor_identity: &NativeCallIdentity,
+    expected_successor: &NativeCallIdentity,
+) -> Result<(), NativeSipEffectCapabilityError> {
+    if binding.provider_call_id.as_str() != provider_call_id
+        || successor_identity != expected_successor
+        || successor_identity.provider_call_id().as_str() != provider_call_id
+        || transaction.transaction_type != rsipstack::transaction::TransactionType::ServerInvite
+        || transaction.original.method != rsipstack::sip::Method::Invite
+        || transaction
+            .original
+            .call_id_header()
+            .ok()
+            .map(|header| header.value())
+            != Some(provider_call_id)
+        || TransactionKey::from_request(
+            &transaction.original,
+            rsipstack::transaction::key::TransactionRole::Server,
+        )
+        .ok()
+        .as_ref()
+            != Some(&transaction.key)
+    {
+        return Err(ActiveCallRegistryError::AuthorityConflict.into());
+    }
+    Ok(())
 }
 
+fn is_sha256_lower_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
