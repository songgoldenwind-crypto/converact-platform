+    #[async_trait]
+    impl NativeSipCapabilityRecoveryOracle for TestRecoveryOracle {
+        async fn fence_predecessor_and_probe(
+            &self,
+            request: NativeSipRecoveryProbeRequest,
+        ) -> Result<NativeSipRecoveryProbeOutcome, NativeSipEffectCapabilityError> {
+            self.calls.fetch_add(1, Ordering::AcqRel);
+            self.requests.lock().unwrap().push(request);
+            self.started.notify_waiters();
+            if self.block.load(Ordering::Acquire) {
+                self.release.notified().await;
+            }
+            Ok(self.outcome.lock().unwrap().clone())
+        }
+    }
