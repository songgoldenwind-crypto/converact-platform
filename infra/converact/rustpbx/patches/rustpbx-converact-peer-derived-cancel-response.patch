+    async fn prepare_peer_derived_inner(
+        &self,
+        kind: EgressEffectPeerDerivedKind,
+        transaction_key: &TransactionKey,
+        trigger_message: &SipMessage,
+        message: &SipMessage,
+        transport_binding: &EgressTransportBinding,
+        canonical_wire_bytes: &[u8],
+    ) -> Result<EgressEffectPermit, SipEffectGateError> {
+        let binding_key = peer_derived_binding_key(transaction_key, kind);
+        let observation_shard = observation_shard(&binding_key, self.observation_txs.len());
+        if self.observation_txs[observation_shard].is_closed()
+            || matches!(
+                self.observation_shards[observation_shard]
+                    .lifecycle
+                    .load(Ordering::Acquire),
+                0 | OBSERVATION_SHARD_QUARANTINED
+            )
+        {
+            return Err(SipEffectGateError::StoreUnavailable);
+        }
+        let pending_transport_capacity = self.pending_transport_capacity[observation_shard]
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| SipEffectGateError::ObservationCapacityExhausted)?;
+        let pending_protocol_capacity = self.pending_protocol_capacity[observation_shard]
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| SipEffectGateError::ObservationCapacityExhausted)?;
+        let transport_work_permit = self.reserve_observation_slot(observation_shard)?;
+        let protocol_work_permit = self.reserve_observation_slot(observation_shard)?;
+        if matches!(
+            self.observation_shards[observation_shard]
+                .lifecycle
+                .load(Ordering::Acquire),
+            0 | OBSERVATION_SHARD_QUARANTINED
+        ) {
+            return Err(SipEffectGateError::StoreUnavailable);
+        }
+
+        let mut intent = self.intents.claim(&binding_key)?;
+        let effect = materialize_peer_derived_effect(
+            &intent.intent,
+            &SipEffectPeerDerivedAttempt {
+                kind,
+                transaction_key: transaction_key.clone(),
+                trigger_message: trigger_message.clone(),
+                message: message.clone(),
+                transport_binding: transport_binding.clone(),
+                canonical_wire_bytes: canonical_wire_bytes.to_vec(),
+            },
+        )?;
+        let send_attempt = match self.store.prepare_for_send(effect).await {
+            Ok(outcome) => outcome,
+            Err(_) => {
+                intent.consume();
+                return Err(SipEffectGateError::ReconciliationRequired);
+            }
+        };
+        if send_attempt.send_attempt_replayed
+            || send_attempt.record.state != SipEffectState::SendAttempted
+            || intent.released()
+        {
+            intent.consume();
+            return Err(SipEffectGateError::ReconciliationRequired);
+        }
+        let record = send_attempt.record;
+        let effect_identity_hash = protocol_effect_identity_hash(&record.identity)
+            .map_err(|_| SipEffectGateError::InvalidIntent)?;
+        let protocol_locator =
+            SipEffectObservationLocator::from_record(&record, effect_identity_hash.clone());
+        let permit_token = permit_token(&effect_identity_hash, record.revision);
+        let permit = EgressEffectPermit::try_new(&permit_token)
+            .map_err(|_| SipEffectGateError::InvalidConfiguration)?;
+
+        use dashmap::mapref::entry::Entry;
+        match self.pending_transport.entry(permit_token) {
+            Entry::Occupied(_) => {
+                intent.consume();
+                return Err(SipEffectGateError::ReconciliationRequired);
+            }
+            Entry::Vacant(entry) => {
+                entry.insert(PendingTransportObservation {
+                    protocol_locator,
+                    transport_work_permit,
+                    protocol_work_permit,
+                    _transport_capacity: pending_transport_capacity,
+                    protocol_capacity: pending_protocol_capacity,
+                });
+                self.metrics
+                    .pending_transport_observations
+                    .fetch_add(1, Ordering::AcqRel);
+            }
+        }
+        intent.consume();
+        Ok(permit)
+    }
