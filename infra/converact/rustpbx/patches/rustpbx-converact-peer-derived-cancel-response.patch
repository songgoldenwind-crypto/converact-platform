+    update_length_prefixed(&mut hasher, b"sip-peer-derived-intent-v1");
+    update_length_prefixed(&mut hasher, transaction_key.to_string().as_bytes());
+    update_length_prefixed(&mut hasher, kind.as_bytes());
+    lower_hex(&hasher.finalize())
+}
