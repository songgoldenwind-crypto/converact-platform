+
+pub(crate) fn materialize_peer_derived_effect(
+    intent: &SipEffectIntent,
+    attempt: &SipEffectPeerDerivedAttempt,
+) -> Result<PreparedSipEffect, SipEffectGateError> {
+    if attempt.kind != EgressEffectPeerDerivedKind::ServerInviteCancelOk
+        || attempt.canonical_wire_bytes != attempt.message.to_bytes()
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+    let (cancel, response) = match (&attempt.trigger_message, &attempt.message) {
+        (SipMessage::Request(cancel), SipMessage::Response(response))
+            if cancel.method == rsipstack::sip::Method::Cancel
+                && response.status_code == rsipstack::sip::StatusCode::OK
+                && cancel.body.is_empty()
+                && response.body.is_empty() =>
+        {
+            (cancel, response)
+        }
+        _ => return Err(SipEffectGateError::InvalidIntent),
+    };
+    if TransactionKey::from_request(cancel, TransactionRole::Server)
+        .ok()
+        .as_ref()
+        != Some(&attempt.transaction_key)
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+
+    let cancel_cseq = cancel
+        .cseq_header()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    let response_cseq = response
+        .cseq_header()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    let cancel_sequence = cancel_cseq
+        .seq()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    let cancel_to = cancel
+        .to_header()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?
+        .typed()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    let response_to = response
+        .to_header()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?
+        .typed()
+        .map_err(|_| SipEffectGateError::InvalidIntent)?;
+    if response_cseq.seq().ok() != Some(cancel_sequence)
+        || cancel_cseq.method().ok() != Some(rsipstack::sip::Method::Cancel)
+        || response_cseq.method().ok() != Some(rsipstack::sip::Method::Cancel)
+        || cancel.call_id_header().ok().map(|header| header.value())
+            != response.call_id_header().ok().map(|header| header.value())
+        || cancel.from_header().ok().map(|header| header.value())
+            != response.from_header().ok().map(|header| header.value())
+        || cancel.via_header().ok().map(|header| header.value())
+            != response.via_header().ok().map(|header| header.value())
+        || cancel_to.uri != response_to.uri
+        || response_to.tag().is_none()
+        || cancel_to
+            .tag()
+            .is_some_and(|tag| response_to.tag() != Some(tag))
+    {
+        return Err(SipEffectGateError::InvalidIntent);
+    }
+
+    intent.prepare(
+        &attempt.message,
+        &attempt.transport_binding,
+        &attempt.canonical_wire_bytes,
+        COMPLETION_SCOPE_TRANSPORT_TERMINAL,
+    )
+}
