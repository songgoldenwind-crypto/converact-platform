+#[derive(Clone)]
+pub(crate) struct SipEffectPeerDerivedAttempt {
+    pub(crate) kind: EgressEffectPeerDerivedKind,
+    pub(crate) transaction_key: TransactionKey,
+    pub(crate) trigger_message: SipMessage,
