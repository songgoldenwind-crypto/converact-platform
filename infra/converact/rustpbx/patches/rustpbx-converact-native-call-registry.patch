+        let original = make_handle(session);
+        registry
+            .try_insert(make_entry(session), original.clone())
+            .unwrap();
+
+        assert!(
+            registry
+                .try_insert(make_entry(session), make_handle(session))
+                .is_err()
+        );
+        assert_eq!(
+            registry.get_handle(session).unwrap().session_id(),
+            original.session_id()
+        );
+        assert_eq!(registry.count(), 1);
+    }
+
+    #[test]
+    fn one_business_call_indexes_multiple_provider_legs_and_removes_them_independently() {
+        let registry = ActiveProxyCallRegistry::with_limits(4, 16);
+        let first = native_identity("vcall_a", "provider-call-a");
+        let second = native_identity("vcall_a", "provider-call-b");
+        let call_id = first.call_id().clone();
+        registry
+            .try_upsert_authoritative(
+                make_entry("provider-call-a"),
+                make_handle("provider-call-a"),
+                first,
+            )
+            .unwrap();
+        registry
+            .try_upsert_authoritative(
+                make_entry("provider-call-b"),
+                make_handle("provider-call-b"),
+                second,
+            )
+            .unwrap();
+
+        assert_eq!(registry.get_by_call_id(&call_id).len(), 2);
+        registry.remove("provider-call-a");
+        assert_eq!(registry.get_by_call_id(&call_id).len(), 1);
+        registry.remove("provider-call-b");
+        assert!(registry.get_by_call_id(&call_id).is_empty());
+        assert!(registry.is_empty());
+    }
 }
