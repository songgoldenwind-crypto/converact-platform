+    fn concurrent_capacity_admission_never_exceeds_the_hard_ceiling() {
+        let registry = std::sync::Arc::new(ActiveProxyCallRegistry::with_limits(1, 16));
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(3));
+        let workers: Vec<_> = ["provider-call-a", "provider-call-b"]
+            .into_iter()
+            .map(|session| {
+                let registry = registry.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    barrier.wait();
+                    registry
+                        .try_insert(make_entry(session), make_handle(session))
+                        .is_ok()
+                })
+            })
+            .collect();
+        barrier.wait();
+        let accepted = workers
+            .into_iter()
+            .map(|worker| worker.join().unwrap())
+            .filter(|accepted| *accepted)
+            .count();
+
+        assert_eq!(accepted, 1);
+        assert_eq!(registry.count(), 1);
+    }
