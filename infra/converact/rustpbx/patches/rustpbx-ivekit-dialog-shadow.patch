+#[tokio::test]
+async fn http_client_sends_bounded_authenticated_commit() {
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let token_path = temporary_token_file();
+    std::fs::write(&token_path, "shadow-service-token-aa").unwrap();
+
+    let server = tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut received = Vec::new();
+        let mut buffer = [0_u8; 4096];
+        let mut expected_bytes;
+        loop {
+            let read = stream.read(&mut buffer).await.unwrap();
+            assert!(read > 0);
+            received.extend_from_slice(&buffer[..read]);
+            let Some(header_end) = received.windows(4).position(|part| part == b"\r\n\r\n") else {
+                continue;
+            };
+            let headers = String::from_utf8_lossy(&received[..header_end]);
+            assert!(headers.starts_with("POST /internal/ivekit/v1/dialog-shadow/commit HTTP/1.1"));
+            assert!(
+                headers
+                    .to_ascii_lowercase()
+                    .contains("authorization: bearer shadow-service-token-aa")
+            );
+            let content_length = headers
+                .lines()
+                .find_map(|line| {
+                    line.to_ascii_lowercase()
+                        .strip_prefix("content-length:")
+                        .map(str::trim)
+                        .and_then(|value| value.parse::<usize>().ok())
+                })
+                .unwrap();
+            expected_bytes = header_end + 4 + content_length;
+            if received.len() >= expected_bytes {
+                break;
+            }
+        }
+        let header_end = received
+            .windows(4)
+            .position(|part| part == b"\r\n\r\n")
+            .unwrap();
+        let request: DialogShadowCommitRequest =
+            serde_json::from_slice(&received[header_end + 4..expected_bytes]).unwrap();
+        let body = serde_json::to_vec(&proof(&request)).unwrap();
+        let response = format!(
+            "HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n",
+            body.len()
+        );
+        stream.write_all(response.as_bytes()).await.unwrap();
+        stream.write_all(&body).await.unwrap();
+        stream.shutdown().await.unwrap();
+    });
+
+    let client = DialogShadowHttpClient::new(DialogShadowHttpClientConfig {
+        endpoint: format!("http://{address}").parse().unwrap(),
+        service_token_file: token_path.clone(),
+        tls_identity_file: None,
+        tls_ca_file: None,
+        production: false,
+        max_inflight: 8,
+        request_timeout: Duration::from_millis(500),
+        max_response_bytes: 16 * 1024,
+    })
+    .unwrap();
+    let executor = Arc::new(ScriptedExecutor::default());
+    let mut lifecycle = DialogShadowLifecycle::new(binding(), executor);
+    let request = lifecycle
+        .preview_request(&event(DialogShadowState::Early))
+        .unwrap();
+    let committed = client.commit(&request).await.unwrap();
+    assert_eq!(committed, proof(&request));
+
+    server.await.unwrap();
+    std::fs::remove_file(token_path).unwrap();
+}
+
+fn temporary_token_file() -> PathBuf {
+    std::env::temp_dir().join(format!(
+        "ivekit-dialog-shadow-token-{}-{}",
+        std::process::id(),
+        rand::random::<u64>()
+    ))
+}
