+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DialogShadowBinding {
+    tenant_id: String,
+    cell_id: String,
+    owner_node_id: String,
+    owner_fault_domain: String,
+    interaction_id: String,
+    owner_epoch: u64,
+    auth_context_ref: String,
+}
+
+impl DialogShadowBinding {
+    pub fn new(
+        tenant_id: &str,
+        cell_id: &str,
+        owner_node_id: &str,
+        owner_fault_domain: &str,
+        interaction_id: &str,
+        owner_epoch: u64,
+        auth_context_ref: &str,
+    ) -> Result<Self, DialogShadowError> {
+        for value in [
+            tenant_id,
+            cell_id,
+            owner_node_id,
+            owner_fault_domain,
+            interaction_id,
+            auth_context_ref,
+        ] {
+            if !valid_identifier(value) {
+                return Err(DialogShadowError::InvalidBinding);
+            }
+        }
+        if owner_epoch == 0 {
+            return Err(DialogShadowError::InvalidBinding);
+        }
+        Ok(Self {
+            tenant_id: tenant_id.to_string(),
+            cell_id: cell_id.to_string(),
+            owner_node_id: owner_node_id.to_string(),
+            owner_fault_domain: owner_fault_domain.to_string(),
+            interaction_id: interaction_id.to_string(),
+            owner_epoch,
+            auth_context_ref: auth_context_ref.to_string(),
+        })
+    }
+}
