+use async_trait::async_trait;
+use rustpbx::ivekit_dialog_shadow::{
+    DialogShadowAdmissionProof, DialogShadowBinding, DialogShadowCommitExecutor,
+    DialogShadowCommitProof, DialogShadowCommitRequest, DialogShadowError, DialogShadowEvent,
+    DialogShadowHttpClient, DialogShadowHttpClientConfig, DialogShadowLifecycle, DialogShadowState,
+};
+use std::collections::VecDeque;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+
+#[derive(Default)]
+struct ScriptedExecutor {
+    requests: Mutex<Vec<DialogShadowCommitRequest>>,
+    results: Mutex<VecDeque<Result<DialogShadowCommitProof, DialogShadowError>>>,
+    admissions: Mutex<VecDeque<Result<DialogShadowAdmissionProof, DialogShadowError>>>,
+}
+
+#[async_trait]
+impl DialogShadowCommitExecutor for ScriptedExecutor {
+    async fn assert_admission(&self) -> Result<DialogShadowAdmissionProof, DialogShadowError> {
+        self.admissions
+            .lock()
+            .unwrap()
+            .pop_front()
+            .unwrap_or(Err(DialogShadowError::Unavailable))
+            .and_then(DialogShadowAdmissionProof::validate)
+    }
+
+    async fn commit(
+        &self,
+        request: &DialogShadowCommitRequest,
+    ) -> Result<DialogShadowCommitProof, DialogShadowError> {
+        self.requests.lock().unwrap().push(request.clone());
+        self.results
+            .lock()
+            .unwrap()
+            .pop_front()
+            .unwrap_or(Err(DialogShadowError::Unavailable))
+    }
+}
+
+#[tokio::test]
+async fn t1_admission_requires_two_fault_domains() {
+    let executor = ScriptedExecutor::default();
+    executor
+        .admissions
+        .lock()
+        .unwrap()
+        .push_back(Ok(DialogShadowAdmissionProof {
+            status: "ready".into(),
+            fault_domains: vec!["zone-a-rack-1".into()],
+        }));
+    assert_eq!(
+        executor.assert_admission().await.unwrap_err(),
+        DialogShadowError::Unavailable
+    );
+}
+
+fn binding() -> DialogShadowBinding {
+    DialogShadowBinding::new(
+        "tenant-a",
+        "cell-a",
+        "rustpbx-a",
+        "zone-a-rack-1",
+        "interaction-a",
+        7,
+        "auth-context-a",
+    )
+    .unwrap()
+}
+
+fn event(state: DialogShadowState) -> DialogShadowEvent {
+    DialogShadowEvent {
+        state,
+        raw_call_id: "call-with-private-number@example.invalid".into(),
+        dialog_id: "dialog-a".into(),
+        local_tag: "caller-tag".into(),
+        remote_tag: Some("callee-tag".into()),
+        route_set: vec!["sip:edge-a.internal:5061;transport=tls;lr".into()],
+        local_cseq: 1,
+        remote_cseq: 1,
+        raw_branch_identity: "branch-with-private-number".into(),
+        final_response_identity: None,
+        logical_offer_sdp: Some("v=0\r\na=offer\r\n".into()),
+        logical_answer_sdp: None,
+        media_reservation_id: Some("reservation-a-caller".into()),
+        provider_session_ref: None,
+        cdr_sequence: 1,
+        terminal: false,
+    }
+}
+
+fn proof(request: &DialogShadowCommitRequest) -> DialogShadowCommitProof {
+    DialogShadowCommitProof {
+        status: "committed".into(),
+        record_hash: request.record_hash().unwrap(),
+        fault_domains: vec!["zone-a-rack-1".into(), "zone-b-rack-1".into()],
+        owner_epoch: request.record.owner_epoch,
+        sequence: request.record.sequence,
+    }
+}
+
+#[tokio::test]
+async fn shadow_records_hash_sensitive_dialog_material() {
+    let executor = Arc::new(ScriptedExecutor::default());
+    let mut lifecycle = DialogShadowLifecycle::new(binding(), executor.clone());
+    let preview = lifecycle
+        .preview_request(&event(DialogShadowState::Early))
+        .unwrap();
+    executor
+        .results
+        .lock()
+        .unwrap()
+        .push_back(Ok(proof(&preview)));
+
+    lifecycle
+        .commit(event(DialogShadowState::Early))
+        .await
+        .unwrap();
+
+    let request = executor.requests.lock().unwrap()[0].clone();
+    let encoded = serde_json::to_string(&request).unwrap();
+    assert!(!encoded.contains("private-number"));
+    assert!(!encoded.contains("v=0"));
+    assert_eq!(request.record.call_id_hash.len(), 64);
+    assert_eq!(request.record.branch_hash.len(), 64);
+    assert_eq!(
+        request.record.logical_offer_hash.as_ref().unwrap().len(),
+        64
+    );
+    assert!(request.record.route_set[0].starts_with("sip:edge-a.internal"));
+}
