+#[derive(Clone, Debug)]
+pub struct DialogShadowHttpClientConfig {
+    pub endpoint: reqwest::Url,
+    pub service_token_file: PathBuf,
+    pub tls_identity_file: Option<PathBuf>,
+    pub tls_ca_file: Option<PathBuf>,
+    pub production: bool,
+    pub max_inflight: usize,
+    pub request_timeout: Duration,
+    pub max_response_bytes: usize,
+}
+
+pub struct DialogShadowHttpClient {
+    endpoint: reqwest::Url,
+    service_token: String,
+    client: reqwest::Client,
+    capacity: Semaphore,
+    request_timeout: Duration,
+    max_response_bytes: usize,
+}
+
+impl DialogShadowHttpClient {
+    pub fn new(config: DialogShadowHttpClientConfig) -> Result<Self, DialogShadowError> {
+        validate_http_config(&config)?;
+        let service_token = read_service_token(&config.service_token_file, config.production)?;
+        let mut builder = reqwest::Client::builder()
+            .https_only(config.production)
+            .use_rustls_tls()
+            .pool_idle_timeout(Duration::from_secs(30))
+            .pool_max_idle_per_host(config.max_inflight.min(1024));
+        if config.production {
+            let identity = std::fs::read(
+                config
+                    .tls_identity_file
+                    .as_ref()
+                    .ok_or(DialogShadowError::InvalidBinding)?,
+            )
+            .map_err(|_| DialogShadowError::InvalidBinding)
+            .and_then(|pem| {
+                reqwest::Identity::from_pem(&pem).map_err(|_| DialogShadowError::InvalidBinding)
+            })?;
+            let ca = std::fs::read(
+                config
+                    .tls_ca_file
+                    .as_ref()
+                    .ok_or(DialogShadowError::InvalidBinding)?,
+            )
+            .map_err(|_| DialogShadowError::InvalidBinding)
+            .and_then(|pem| {
+                reqwest::Certificate::from_pem(&pem).map_err(|_| DialogShadowError::InvalidBinding)
+            })?;
+            builder = builder.identity(identity).add_root_certificate(ca);
+        }
+        let client = builder
+            .build()
+            .map_err(|_| DialogShadowError::InvalidBinding)?;
+        Ok(Self {
+            endpoint: config.endpoint,
+            service_token,
+            client,
+            capacity: Semaphore::new(config.max_inflight),
+            request_timeout: config.request_timeout,
+            max_response_bytes: config.max_response_bytes,
+        })
+    }
+
+    async fn post_json<T: Serialize + ?Sized, R: DeserializeOwned>(
+        &self,
+        path: &str,
+        request: &T,
+    ) -> Result<R, DialogShadowError> {
+        let _permit = self
+            .capacity
+            .acquire()
+            .await
+            .map_err(|_| DialogShadowError::Unavailable)?;
+        let endpoint = self
+            .endpoint
+            .join(path)
+            .map_err(|_| DialogShadowError::InvalidBinding)?;
+        let response = tokio::time::timeout(
+            self.request_timeout,
+            self.client
+                .post(endpoint)
+                .bearer_auth(&self.service_token)
+                .json(request)
+                .send(),
+        )
+        .await
+        .map_err(|_| DialogShadowError::OutcomeUnknown)?
+        .map_err(|_| DialogShadowError::OutcomeUnknown)?;
+        if !response.status().is_success() {
+            return Err(DialogShadowError::Unavailable);
+        }
+        if response
+            .content_length()
+            .is_some_and(|size| size > self.max_response_bytes as u64)
+        {
+            return Err(DialogShadowError::OutcomeUnknown);
+        }
+        let mut response = response;
+        let mut body = Vec::new();
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|_| DialogShadowError::OutcomeUnknown)?
+        {
+            if body.len().saturating_add(chunk.len()) > self.max_response_bytes {
+                return Err(DialogShadowError::OutcomeUnknown);
+            }
+            body.extend_from_slice(&chunk);
+        }
+        serde_json::from_slice::<R>(&body).map_err(|_| DialogShadowError::OutcomeUnknown)
+    }
+}
+
+#[async_trait]
+impl DialogShadowCommitExecutor for DialogShadowHttpClient {
+    async fn assert_admission(&self) -> Result<DialogShadowAdmissionProof, DialogShadowError> {
+        #[derive(Serialize)]
+        struct AdmissionRequest {
+            profile: &'static str,
+        }
+        self.post_json::<_, DialogShadowAdmissionProof>(
+            "/internal/ivekit/v1/dialog-shadow/admission",
+            &AdmissionRequest {
+                profile: PROFILE_T1,
+            },
+        )
+        .await
+        .map_err(|_| DialogShadowError::Unavailable)?
+        .validate()
+    }
+
+    async fn commit(
+        &self,
+        request: &DialogShadowCommitRequest,
+    ) -> Result<DialogShadowCommitProof, DialogShadowError> {
+        self.post_json("/internal/ivekit/v1/dialog-shadow/commit", request)
+            .await
+    }
+}
+
+pub struct DialogShadowLifecycle {
+    binding: DialogShadowBinding,
+    executor: Arc<dyn DialogShadowCommitExecutor>,
+    next_sequence: u32,
+    pending: Option<(DialogShadowEvent, DialogShadowCommitRequest)>,
+}
+
+struct DialogShadowRuntimeConfig {
+    executor: Arc<DialogShadowHttpClient>,
+}
+
+static DIALOG_SHADOW_RUNTIME: OnceLock<
+    Result<Option<Arc<DialogShadowRuntimeConfig>>, &'static str>,
+> = OnceLock::new();
+
+pub enum IveKitDialogShadowRuntime {
+    Disabled,
+    Ready {
+        binding: DialogShadowBinding,
+        executor: Arc<DialogShadowHttpClient>,
+        dialogs: HashMap<String, DialogShadowLifecycle>,
+    },
+    FailClosed {
+        error_code: &'static str,
+    },
+}
+
+impl IveKitDialogShadowRuntime {
+    pub fn bootstrap(session_id: &str) -> Self {
+        let Some(owner) = crate::ivekit_owner::owner_contract(session_id) else {
+            return Self::Disabled;
+        };
+        match owner.availability_profile.as_str() {
+            "VOICE-ORDINARY" => return Self::Disabled,
+            PROFILE_T1 => {}
+            _ => {
+                return Self::FailClosed {
+                    error_code: "dialog_shadow_profile_invalid",
+                };
+            }
+        }
+        let config = match dialog_shadow_runtime_config() {
+            Ok(Some(config)) => config,
+            Ok(None) => {
+                return Self::FailClosed {
+                    error_code: "dialog_shadow_not_configured",
+                };
+            }
+            Err(error_code) => return Self::FailClosed { error_code },
+        };
+        let auth_context_ref = match owner.auth_context_ref.as_deref() {
+            Some(value) => value,
+            None => {
+                return Self::FailClosed {
+                    error_code: "dialog_shadow_auth_context_missing",
+                };
+            }
+        };
+        let owner_epoch = match owner.owner_epoch.parse::<u64>() {
+            Ok(value) if value > 0 => value,
+            _ => {
+                return Self::FailClosed {
+                    error_code: "dialog_shadow_owner_epoch_invalid",
+                };
+            }
+        };
+        let binding = match DialogShadowBinding::new(
+            required_env("IVEKIT_RUSTPBX_ROUTE_TENANT_ID")
+                .as_deref()
+                .unwrap_or_default(),
+            required_env("IVEKIT_RUSTPBX_CELL_ID")
+                .as_deref()
+                .unwrap_or_default(),
+            required_env("IVEKIT_RUSTPBX_OWNER_NODE_ID")
+                .as_deref()
+                .unwrap_or_default(),
+            required_env("IVEKIT_RUSTPBX_FAULT_DOMAIN")
+                .as_deref()
+                .unwrap_or_default(),
+            &owner.interaction_id,
+            owner_epoch,
+            auth_context_ref,
+        ) {
+            Ok(binding) => binding,
+            Err(_) => {
+                return Self::FailClosed {
+                    error_code: "dialog_shadow_binding_invalid",
+                };
+            }
+        };
+        Self::Ready {
+            binding,
+            executor: config.executor.clone(),
+            dialogs: HashMap::new(),
+        }
+    }
+
+    pub fn is_required(&self) -> bool {
+        !matches!(self, Self::Disabled)
+    }
+
+    pub fn failure_code(&self) -> Option<&'static str> {
+        match self {
+            Self::FailClosed { error_code } => Some(*error_code),
+            Self::Disabled | Self::Ready { .. } => None,
+        }
+    }
+
+    pub async fn assert_admission(&self) -> Result<(), DialogShadowError> {
+        match self {
+            Self::Disabled => Ok(()),
+            Self::Ready { executor, .. } => executor.assert_admission().await.map(|_| ()),
+            Self::FailClosed { .. } => Err(DialogShadowError::Unavailable),
+        }
+    }
+
+    pub async fn commit(
+        &mut self,
+        event: DialogShadowEvent,
+    ) -> Result<Option<DialogShadowCommitProof>, DialogShadowError> {
+        match self {
+            Self::Disabled => Ok(None),
+            Self::Ready {
+                binding,
+                executor,
+                dialogs,
+            } => {
+                let lifecycle = dialogs.entry(event.dialog_id.clone()).or_insert_with(|| {
+                    DialogShadowLifecycle::new(binding.clone(), executor.clone())
+                });
+                lifecycle.commit(event).await.map(Some)
+            }
+            Self::FailClosed { .. } => Err(DialogShadowError::Unavailable),
+        }
+    }
+}
+
+impl DialogShadowLifecycle {
+    pub fn new(
+        binding: DialogShadowBinding,
+        executor: Arc<dyn DialogShadowCommitExecutor>,
+    ) -> Self {
+        Self {
+            binding,
+            executor,
+            next_sequence: 1,
+            pending: None,
+        }
+    }
+
+    pub fn preview_request(
+        &mut self,
+        event: &DialogShadowEvent,
+    ) -> Result<DialogShadowCommitRequest, DialogShadowError> {
+        self.reserve(event)
+    }
+
+    pub async fn commit(
+        &mut self,
+        event: DialogShadowEvent,
+    ) -> Result<DialogShadowCommitProof, DialogShadowError> {
+        let request = self.reserve(&event)?;
+        match self.executor.commit(&request).await {
+            Ok(proof) if valid_proof(&request, &proof) => {
+                self.pending = None;
+                self.next_sequence = self
+                    .next_sequence
+                    .checked_add(1)
+                    .ok_or(DialogShadowError::SequenceExhausted)?;
+                Ok(proof)
+            }
+            Ok(_) => Err(DialogShadowError::OutcomeUnknown),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub fn next_sequence(&self) -> u32 {
+        self.next_sequence
+    }
+
+    pub fn has_pending_commit(&self) -> bool {
+        self.pending.is_some()
+    }
+
+    fn reserve(
+        &mut self,
+        event: &DialogShadowEvent,
+    ) -> Result<DialogShadowCommitRequest, DialogShadowError> {
+        if let Some((pending_event, request)) = &self.pending {
+            return if pending_event == event {
+                Ok(request.clone())
+            } else {
+                Err(DialogShadowError::ReconcileRequired)
+            };
+        }
+        let request = self.build_request(event)?;
+        self.pending = Some((event.clone(), request.clone()));
+        Ok(request)
+    }
+
+    fn build_request(
+        &self,
+        event: &DialogShadowEvent,
+    ) -> Result<DialogShadowCommitRequest, DialogShadowError> {
+        validate_event(event)?;
+        let record = DialogShadowRecord {
+            schema_version: 1,
+            tenant_id: self.binding.tenant_id.clone(),
+            cell_id: self.binding.cell_id.clone(),
+            dialog_id: event.dialog_id.clone(),
+            call_id_hash: sha256(&event.raw_call_id),
+            owner_node_id: self.binding.owner_node_id.clone(),
+            owner_fault_domain: self.binding.owner_fault_domain.clone(),
+            owner_epoch: self.binding.owner_epoch,
+            sequence: self.next_sequence,
+            state: event.state,
+            local_tag: event.local_tag.clone(),
+            remote_tag: event.remote_tag.clone(),
+            route_set: event.route_set.clone(),
+            local_cseq: event.local_cseq,
+            remote_cseq: event.remote_cseq,
+            branch_hash: sha256(&event.raw_branch_identity),
+            final_response_hash: event.final_response_identity.as_deref().map(sha256),
+            auth_context_ref: self.binding.auth_context_ref.clone(),
+            logical_offer_hash: event.logical_offer_sdp.as_deref().map(sha256),
+            logical_answer_hash: event.logical_answer_sdp.as_deref().map(sha256),
+            media_reservation_id: event.media_reservation_id.clone(),
+            provider_session_ref: event.provider_session_ref.clone(),
+            cdr_sequence: event.cdr_sequence,
+            recorded_at: chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true),
+            terminal: event.terminal,
+        };
+        let request = DialogShadowCommitRequest {
+            profile: PROFILE_T1.to_string(),
+            record,
+        };
+        if serde_json::to_vec(&request)
+            .map_err(|_| DialogShadowError::InvalidRecord)?
+            .len()
+            > MAX_RECORD_BYTES
+        {
+            return Err(DialogShadowError::InvalidRecord);
+        }
+        Ok(request)
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum DialogShadowError {
+    #[error("dialog_shadow_invalid_binding")]
+    InvalidBinding,
+    #[error("dialog_shadow_invalid_record")]
+    InvalidRecord,
+    #[error("dialog_shadow_reconcile_required")]
+    ReconcileRequired,
+    #[error("dialog_shadow_outcome_unknown")]
+    OutcomeUnknown,
+    #[error("dialog_shadow_unavailable")]
+    Unavailable,
+    #[error("dialog_shadow_sequence_exhausted")]
+    SequenceExhausted,
+}
+
+fn valid_proof(request: &DialogShadowCommitRequest, proof: &DialogShadowCommitProof) -> bool {
+    let Ok(expected_hash) = request.record_hash() else {
+        return false;
+    };
+    let domains = proof
+        .fault_domains
+        .iter()
+        .filter(|domain| valid_identifier(domain))
+        .collect::<HashSet<_>>();
+    proof.status == "committed"
+        && proof.record_hash == expected_hash
+        && proof.owner_epoch == request.record.owner_epoch
+        && proof.sequence == request.record.sequence
+        && domains.len() >= 2
+}
+
+fn validate_event(event: &DialogShadowEvent) -> Result<(), DialogShadowError> {
+    if event.raw_call_id.is_empty()
+        || event.raw_call_id.len() > 1024
+        || !valid_identifier(&event.dialog_id)
+        || !valid_sip_tag(&event.local_tag)
+        || event
+            .remote_tag
+            .as_deref()
+            .is_some_and(|tag| !valid_sip_tag(tag))
+        || event.raw_branch_identity.is_empty()
+        || event.raw_branch_identity.len() > 2048
+        || event
+            .final_response_identity
+            .as_deref()
+            .is_some_and(|value| value.len() > 4096)
+        || event
+            .logical_offer_sdp
+            .as_deref()
+            .is_some_and(|value| value.len() > 64 * 1024)
+        || event
+            .logical_answer_sdp
+            .as_deref()
+            .is_some_and(|value| value.len() > 64 * 1024)
+        || event.route_set.len() > MAX_ROUTE_SET
+        || event.route_set.iter().any(|route| !valid_route(route))
+        || event
+            .media_reservation_id
+            .as_deref()
+            .is_some_and(|value| !valid_identifier(value))
+        || event
+            .provider_session_ref
+            .as_deref()
+            .is_some_and(|value| !valid_identifier(value))
+        || event.terminal != (event.state == DialogShadowState::Terminated)
+    {
+        return Err(DialogShadowError::InvalidRecord);
+    }
+    Ok(())
+}
+
+fn valid_identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value.bytes().enumerate().all(|(index, byte)| match byte {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' => true,
+            b'.' | b'_' | b':' | b'-' if index > 0 => true,
+            _ => false,
+        })
+}
+
+fn valid_sip_tag(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 256
+        && value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric()
+                || matches!(
+                    byte,
+                    b'.' | b'!' | b'%' | b'*' | b'_' | b'+' | b'`' | b'\'' | b'~' | b'-'
+                )
+        })
+}
+
+fn valid_route(value: &str) -> bool {
+    if value.is_empty()
+        || value.len() > MAX_ROUTE_BYTES
+        || value.contains('@')
+        || !(value.starts_with("sip:") || value.starts_with("sips:"))
+    {
+        return false;
+    }
+    value.bytes().all(|byte| {
+        byte.is_ascii_alphanumeric()
+            || matches!(
+                byte,
+                b'.' | b'-'
+                    | b':'
+                    | b';'
+                    | b'='
+                    | b'_'
+                    | b'~'
+                    | b'!'
+                    | b'$'
+                    | b'&'
+                    | b'\''
+                    | b'('
+                    | b')'
+                    | b'*'
+                    | b'+'
+                    | b','
+                    | b'%'
+            )
+    })
+}
+
+fn hash_json<T: Serialize>(value: &T) -> Result<String, DialogShadowError> {
+    let encoded = serde_json::to_vec(value).map_err(|_| DialogShadowError::InvalidRecord)?;
+    Ok(hex_sha256(Sha256::digest(encoded)))
+}
+
+fn sha256(value: &str) -> String {
+    hex_sha256(Sha256::digest(value.as_bytes()))
+}
+
+pub fn stable_dialog_shadow_id(raw_call_id: &str, local_tag: &str, remote_tag: &str) -> String {
+    sha256(&format!("{raw_call_id}\0{local_tag}\0{remote_tag}"))
+}
+
+fn hex_sha256(digest: impl AsRef<[u8]>) -> String {
+    const HEX: &[u8; 16] = b"0123456789abcdef";
+    let bytes = digest.as_ref();
+    let mut encoded = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        encoded.push(HEX[(byte >> 4) as usize] as char);
+        encoded.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+    encoded
+}
+
+fn validate_http_config(config: &DialogShadowHttpClientConfig) -> Result<(), DialogShadowError> {
+    let loopback = config
+        .endpoint
+        .host_str()
+        .is_some_and(|host| matches!(host, "localhost" | "127.0.0.1" | "::1"));
+    let endpoint_allowed = if config.production {
+        config.endpoint.scheme() == "https"
+    } else {
+        config.endpoint.scheme() == "https" || (config.endpoint.scheme() == "http" && loopback)
+    };
+    if config.endpoint.username() != ""
+        || config.endpoint.password().is_some()
+        || config.endpoint.query().is_some()
+        || config.endpoint.fragment().is_some()
+        || !endpoint_allowed
+        || config.max_inflight == 0
+        || config.max_inflight > 1_000_000
+        || config.request_timeout < Duration::from_millis(50)
+        || config.request_timeout > Duration::from_secs(10)
+        || !(1024..=1024 * 1024).contains(&config.max_response_bytes)
+        || (config.production
+            && (config.tls_identity_file.is_none() || config.tls_ca_file.is_none()))
+    {
+        return Err(DialogShadowError::InvalidBinding);
+    }
+    Ok(())
+}
+
+fn read_service_token(path: &PathBuf, production: bool) -> Result<String, DialogShadowError> {
+    if production {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let mode = std::fs::metadata(path)
+                .map_err(|_| DialogShadowError::InvalidBinding)?
+                .permissions()
+                .mode();
+            if mode & 0o077 != 0 {
+                return Err(DialogShadowError::InvalidBinding);
+            }
+        }
+    }
+    let raw = std::fs::read_to_string(path).map_err(|_| DialogShadowError::InvalidBinding)?;
+    let token = raw.trim_end_matches(['\r', '\n']);
+    if !(16..=4096).contains(&token.len())
+        || token.chars().any(char::is_control)
+        || token.trim() != token
+    {
+        return Err(DialogShadowError::InvalidBinding);
+    }
+    Ok(token.to_string())
+}
+
+fn dialog_shadow_runtime_config()
+-> Result<Option<&'static Arc<DialogShadowRuntimeConfig>>, &'static str> {
+    match DIALOG_SHADOW_RUNTIME.get_or_init(build_dialog_shadow_runtime_config) {
+        Ok(Some(config)) => Ok(Some(config)),
+        Ok(None) => Ok(None),
+        Err(error) => Err(*error),
+    }
+}
+
+fn build_dialog_shadow_runtime_config()
+-> Result<Option<Arc<DialogShadowRuntimeConfig>>, &'static str> {
+    let Some(endpoint) = required_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_ENDPOINT") else {
+        return Ok(None);
+    };
+    let endpoint = reqwest::Url::parse(&endpoint).map_err(|_| "dialog_shadow_endpoint_invalid")?;
+    let service_token_file = required_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_TOKEN_FILE")
+        .ok_or("dialog_shadow_token_file_missing")?;
+    let production = parsed_bool_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_PRODUCTION", true)?;
+    let max_inflight = parsed_usize_env(
+        "IVEKIT_RUSTPBX_DIALOG_SHADOW_MAX_INFLIGHT",
+        2_048,
+        1,
+        1_000_000,
+    )?;
+    let request_timeout_ms =
+        parsed_u64_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_TIMEOUT_MS", 500, 50, 10_000)?;
+    let max_response_bytes = parsed_usize_env(
+        "IVEKIT_RUSTPBX_DIALOG_SHADOW_MAX_RESPONSE_BYTES",
+        16 * 1024,
+        1_024,
+        1024 * 1024,
+    )?;
+    for name in [
+        "IVEKIT_RUSTPBX_ROUTE_TENANT_ID",
+        "IVEKIT_RUSTPBX_CELL_ID",
+        "IVEKIT_RUSTPBX_OWNER_NODE_ID",
+        "IVEKIT_RUSTPBX_FAULT_DOMAIN",
+    ] {
+        if !required_env(name).as_deref().is_some_and(valid_identifier) {
+            return Err("dialog_shadow_binding_config_invalid");
+        }
+    }
+    let executor = DialogShadowHttpClient::new(DialogShadowHttpClientConfig {
+        endpoint,
+        service_token_file: PathBuf::from(service_token_file),
+        tls_identity_file: required_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_TLS_IDENTITY_FILE")
+            .map(PathBuf::from),
+        tls_ca_file: required_env("IVEKIT_RUSTPBX_DIALOG_SHADOW_TLS_CA_FILE").map(PathBuf::from),
+        production,
+        max_inflight,
+        request_timeout: Duration::from_millis(request_timeout_ms),
+        max_response_bytes,
+    })
+    .map_err(|_| "dialog_shadow_client_invalid")?;
+    Ok(Some(Arc::new(DialogShadowRuntimeConfig {
+        executor: Arc::new(executor),
+    })))
+}
+
+fn required_env(name: &str) -> Option<String> {
+    std::env::var(name)
+        .ok()
+        .filter(|value| !value.trim().is_empty() && value.trim() == value)
+}
+
+fn parsed_bool_env(name: &str, default: bool) -> Result<bool, &'static str> {
+    match required_env(name).as_deref() {
+        None => Ok(default),
+        Some("true") => Ok(true),
+        Some("false") => Ok(false),
+        Some(_) => Err("dialog_shadow_boolean_invalid"),
+    }
+}
+
+fn parsed_usize_env(
+    name: &str,
+    default: usize,
+    minimum: usize,
+    maximum: usize,
+) -> Result<usize, &'static str> {
+    let value = required_env(name)
+        .map(|value| {
+            value
+                .parse::<usize>()
+                .map_err(|_| "dialog_shadow_integer_invalid")
+        })
+        .transpose()?
+        .unwrap_or(default);
+    if !(minimum..=maximum).contains(&value) {
+        return Err("dialog_shadow_integer_invalid");
+    }
+    Ok(value)
+}
+
+fn parsed_u64_env(
+    name: &str,
+    default: u64,
+    minimum: u64,
+    maximum: u64,
+) -> Result<u64, &'static str> {
+    let value = required_env(name)
+        .map(|value| {
+            value
+                .parse::<u64>()
+                .map_err(|_| "dialog_shadow_integer_invalid")
+        })
+        .transpose()?
+        .unwrap_or(default);
+    if !(minimum..=maximum).contains(&value) {
+        return Err("dialog_shadow_integer_invalid");
+    }
+    Ok(value)
+}
