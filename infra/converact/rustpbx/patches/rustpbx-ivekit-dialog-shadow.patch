     let trimmed = token.trim();
     if trimmed.len() != token.len()
         || !(32..=2048).contains(&token.len())
         || token.chars().any(|character| character.is_control())
     {
         warn!("snapshot admission returned an invalid audio tap token");
         return None;
     }
     Some(token)
 }
 
