+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct DialogShadowCommitProof {
+    pub status: String,
+    pub record_hash: String,
+    pub fault_domains: Vec<String>,
+    pub owner_epoch: u64,
+    pub sequence: u32,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct DialogShadowAdmissionProof {
+    pub status: String,
+    pub fault_domains: Vec<String>,
+}
+
+impl DialogShadowAdmissionProof {
+    pub fn validate(mut self) -> Result<Self, DialogShadowError> {
+        if self.status != "ready"
+            || self.fault_domains.len() < 2
+            || self.fault_domains.len() > 16
+            || self
+                .fault_domains
+                .iter()
+                .any(|value| !valid_identifier(value))
+        {
+            return Err(DialogShadowError::Unavailable);
+        }
+        self.fault_domains.sort();
+        self.fault_domains.dedup();
+        if self.fault_domains.len() < 2 {
+            return Err(DialogShadowError::Unavailable);
+        }
+        Ok(self)
+    }
+}
+
+#[async_trait]
+pub trait DialogShadowCommitExecutor: Send + Sync {
+    async fn assert_admission(&self) -> Result<DialogShadowAdmissionProof, DialogShadowError>;
+
+    async fn commit(
+        &self,
+        request: &DialogShadowCommitRequest,
+    ) -> Result<DialogShadowCommitProof, DialogShadowError>;
+}
