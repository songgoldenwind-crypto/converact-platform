+#[tokio::test]
+async fn committed_states_advance_monotonically() {
+    let executor = Arc::new(ScriptedExecutor::default());
+    let mut lifecycle = DialogShadowLifecycle::new(binding(), executor.clone());
+    for (index, state) in [
+        DialogShadowState::Early,
+        DialogShadowState::Confirmed,
+        DialogShadowState::Updating,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut value = event(state);
+        value.local_cseq = index as u32 + 1;
+        value.remote_cseq = index as u32 + 1;
+        value.cdr_sequence = index as u64 + 1;
+        let preview = lifecycle.preview_request(&value).unwrap();
+        executor
+            .results
+            .lock()
+            .unwrap()
+            .push_back(Ok(proof(&preview)));
+        lifecycle.commit(value).await.unwrap();
+    }
+    let requests = executor.requests.lock().unwrap();
+    assert_eq!(
+        requests
+            .iter()
+            .map(|request| request.record.sequence)
+            .collect::<Vec<_>>(),
+        vec![1, 2, 3]
+    );
+}
