+const PROFILE_T1: &str = "VOICE-HA-T1";
+const MAX_RECORD_BYTES: usize = 32 * 1024;
+const MAX_ROUTE_SET: usize = 16;
+const MAX_ROUTE_BYTES: usize = 512;
