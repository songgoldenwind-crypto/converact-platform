+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub struct DialogShadowCommitRequest {
+    pub profile: String,
+    pub record: DialogShadowRecord,
+}
+
+impl DialogShadowCommitRequest {
+    pub fn record_hash(&self) -> Result<String, DialogShadowError> {
+        hash_json(&self.record)
+    }
+}
