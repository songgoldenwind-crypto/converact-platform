+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum NativeCallOwnerProof {
+    LegacyUnspecified,
+    Fresh,
+    Recovered(crate::call::domain::foundation_identity::NativeCallRecoveryBinding),
+}
+
+impl NativeCallOwnerProof {
+    pub(crate) fn recovery_binding_for_runtime(
+        &self,
+        runtime_enabled: bool,
+    ) -> Result<Option<&crate::call::domain::foundation_identity::NativeCallRecoveryBinding>> {
+        match self {
+            Self::LegacyUnspecified if runtime_enabled => Err(anyhow!(
+                "durable native call admission requires explicit fresh or recovered proof"
+            )),
+            Self::LegacyUnspecified | Self::Fresh => Ok(None),
+            Self::Recovered(binding) => Ok(Some(binding)),
+        }
+    }
+}
+
 struct OwnerEntry {
