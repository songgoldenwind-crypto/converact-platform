+#[derive(Clone)]
+pub(crate) struct NativeCallOwnerAdmission {
+    pub(crate) identity: crate::call::domain::foundation_identity::NativeCallIdentity,
+    pub(crate) proof: NativeCallOwnerProof,
+    entry: Arc<OwnerEntry>,
+}
+
+impl NativeCallOwnerAdmission {
+    pub(crate) fn recovery_binding_for_runtime(
+        &self,
+        runtime_enabled: bool,
+    ) -> Result<Option<&crate::call::domain::foundation_identity::NativeCallRecoveryBinding>> {
+        self.proof.recovery_binding_for_runtime(runtime_enabled)
+    }
+
+    pub(crate) fn assert_current(&self, provider_call_id: &str) -> Result<()> {
+        let current = owners()
+            .get(provider_call_id)
+            .ok_or_else(|| anyhow!("native call owner admission is no longer current"))?;
+        if !Arc::ptr_eq(current.value(), &self.entry)
+            || current.native_identity.as_ref() != Some(&self.identity)
+            || current.native_call_proof != self.proof
+        {
+            return Err(anyhow!(
+                "native call owner admission was replaced during admission"
+            ));
+        }
+        current
+            .guard
+            .assert_mutation(&current.contract.owner_epoch, now_unix_ms())
+            .map_err(|error| anyhow!("native call owner admission rejected: {error}"))
+    }
+
+    pub(crate) async fn close_if_current(&self, provider_call_id: &str) -> bool {
+        let removed = match owners().entry(provider_call_id.to_string()) {
+            dashmap::mapref::entry::Entry::Occupied(entry)
+                if Arc::ptr_eq(entry.get(), &self.entry) =>
+            {
+                Some(entry.remove())
+            }
+            _ => None,
+        };
+        let Some(entry) = removed else {
+            return false;
+        };
+        close_owner_entry(provider_call_id, entry).await;
+        true
+    }
+}
+
+pub(crate) fn native_call_recovery_binding_for_runtime(
+    admission: Option<&NativeCallOwnerAdmission>,
+    runtime_enabled: bool,
+) -> Result<Option<&crate::call::domain::foundation_identity::NativeCallRecoveryBinding>> {
+    match admission {
+        Some(admission) => admission.recovery_binding_for_runtime(runtime_enabled),
+        None if runtime_enabled => Err(anyhow!(
+            "durable native call admission requires an authenticated owner proof"
+        )),
+        None => Ok(None),
+    }
+}
