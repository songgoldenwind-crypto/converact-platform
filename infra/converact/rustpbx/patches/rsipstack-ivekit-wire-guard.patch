+fn validate_request_uri_percent_encoding(start_line: &[u8]) -> Result<(), Error> {
+    if start_line.starts_with(b"SIP/") {
+        return Ok(());
+    }
+    let method_end = memchr(b' ', start_line)
+        .or_else(|| memchr(b'\t', start_line))
+        .ok_or_else(|| Error::ParseError("SIP request line is invalid".into()))?;
+    let uri_start = start_line[method_end..]
+        .iter()
+        .position(|byte| *byte != b' ' && *byte != b'\t')
+        .map(|relative| method_end + relative)
+        .ok_or_else(|| Error::ParseError("SIP request URI is missing".into()))?;
+    let uri_end = start_line[uri_start..]
+        .iter()
+        .position(|byte| *byte == b' ' || *byte == b'\t')
+        .map(|relative| uri_start + relative)
+        .ok_or_else(|| Error::ParseError("SIP request version is missing".into()))?;
+    let uri = &start_line[uri_start..uri_end];
+    let mut index = 0;
+    while index < uri.len() {
+        if uri[index] == b'%'
+            && (index + 2 >= uri.len()
+                || !uri[index + 1].is_ascii_hexdigit()
+                || !uri[index + 2].is_ascii_hexdigit())
+        {
+            return Err(Error::ParseError(
+                "SIP request URI contains an invalid escape".into(),
+            ));
+        }
+        index += if uri[index] == b'%' { 3 } else { 1 };
+    }
+    Ok(())
+}
