+fn parse_content_length(value: &[u8]) -> Result<usize, Error> {
+    if value.is_empty() || !value.iter().all(u8::is_ascii_digit) {
+        return Err(Error::ParseError("SIP Content-Length is invalid".into()));
+    }
+    value.iter().try_fold(0_usize, |length, byte| {
+        length
+            .checked_mul(10)
+            .and_then(|current| current.checked_add(usize::from(byte - b'0')))
+            .filter(|current| *current <= MAX_SIP_BODY_BYTES)
+            .ok_or_else(|| Error::ParseError("SIP Content-Length exceeds wire limit".into()))
+    })
+}
+
+fn trim_ascii_whitespace(mut value: &[u8]) -> &[u8] {
+    while matches!(value.first(), Some(b' ' | b'\t')) {
+        value = &value[1..];
+    }
+    while matches!(value.last(), Some(b' ' | b'\t')) {
+        value = &value[..value.len() - 1];
+    }
+    value
+}
