+fn singleton_header_bit(name: &[u8]) -> Option<u64> {
+    let bit = if name.eq_ignore_ascii_case(b"from") || name.eq_ignore_ascii_case(b"f") {
+        0
+    } else if name.eq_ignore_ascii_case(b"to") || name.eq_ignore_ascii_case(b"t") {
+        1
+    } else if name.eq_ignore_ascii_case(b"call-id") || name.eq_ignore_ascii_case(b"i") {
+        2
+    } else if name.eq_ignore_ascii_case(b"cseq") {
+        3
+    } else if name.eq_ignore_ascii_case(b"max-forwards") {
+        4
+    } else if name.eq_ignore_ascii_case(b"content-type") || name.eq_ignore_ascii_case(b"c") {
+        5
+    } else if name.eq_ignore_ascii_case(b"content-disposition") {
+        6
+    } else if name.eq_ignore_ascii_case(b"expires") {
+        7
+    } else if name.eq_ignore_ascii_case(b"event") || name.eq_ignore_ascii_case(b"o") {
+        8
+    } else if name.eq_ignore_ascii_case(b"subscription-state") {
+        9
+    } else if name.eq_ignore_ascii_case(b"refer-to") || name.eq_ignore_ascii_case(b"r") {
+        10
+    } else if name.eq_ignore_ascii_case(b"referred-by") || name.eq_ignore_ascii_case(b"b") {
+        11
+    } else if name.eq_ignore_ascii_case(b"rseq") {
+        12
+    } else if name.eq_ignore_ascii_case(b"rack") {
+        13
+    } else {
+        return None;
+    };
+    Some(1_u64 << bit)
+}
