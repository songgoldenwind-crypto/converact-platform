+fn validate_message_boundaries(data: &[u8], separator: usize) -> Result<(), Error> {
+    if separator > MAX_SIP_HEADER_BYTES {
+        return Err(Error::ParseError(
+            "SIP header section exceeds wire limit".into(),
+        ));
+    }
+    let body_length = data.len() - separator - 4;
+    if body_length > MAX_SIP_BODY_BYTES {
+        return Err(Error::ParseError("SIP body exceeds wire limit".into()));
+    }
+
+    let header_section = &data[..separator];
+    let mut offset = 0;
+    let mut line_index = 0;
+    let mut header_count = 0;
+    let mut content_length = None;
+    let mut singleton_headers = 0_u64;
+
+    loop {
+        let line_end = memmem::find(&header_section[offset..], b"\r\n")
+            .map(|relative| offset + relative)
+            .unwrap_or(header_section.len());
+        let line = &header_section[offset..line_end];
+        if line.is_empty() || line.len() > MAX_SIP_HEADER_LINE_BYTES {
+            return Err(Error::ParseError(
+                "SIP header line violates wire limit".into(),
+            ));
+        }
+        if memchr(b'\r', line).is_some() || memchr(b'\n', line).is_some() {
+            return Err(Error::ParseError(
+                "SIP header contains a bare line ending".into(),
+            ));
+        }
+
+        if line_index == 0 {
+            validate_request_uri_percent_encoding(line)?;
+        } else {
+            header_count += 1;
+            if header_count > MAX_SIP_HEADERS {
+                return Err(Error::ParseError(
+                    "SIP header count exceeds wire limit".into(),
+                ));
+            }
+            if matches!(line.first(), Some(b' ' | b'\t')) {
+                return Err(Error::ParseError(
+                    "obsolete SIP header folding is forbidden".into(),
+                ));
+            }
+            let colon = memchr(b':', line)
+                .ok_or_else(|| Error::ParseError("SIP header is missing a colon".into()))?;
+            let header_name = &line[..colon];
+            if header_name.is_empty() || !header_name.iter().all(|byte| is_sip_token(*byte)) {
+                return Err(Error::ParseError("SIP header name is invalid".into()));
+            }
+            let header_value = trim_ascii_whitespace(&line[colon + 1..]);
+            if header_name.eq_ignore_ascii_case(b"content-length")
+                || header_name.eq_ignore_ascii_case(b"l")
+            {
+                if content_length.is_some() {
+                    return Err(Error::ParseError(
+                        "duplicate SIP Content-Length is forbidden".into(),
+                    ));
+                }
+                content_length = Some(parse_content_length(header_value)?);
+            }
+            if let Some(bit) = singleton_header_bit(header_name) {
+                if singleton_headers & bit != 0 {
+                    return Err(Error::ParseError(
+                        "duplicate singleton SIP header is forbidden".into(),
+                    ));
+                }
+                singleton_headers |= bit;
+            }
+        }
+
+        line_index += 1;
+        if line_end == header_section.len() {
+            break;
+        }
+        offset = line_end + 2;
+    }
+
+    if content_length.unwrap_or(0) != body_length {
+        return Err(Error::ParseError(
+            "SIP Content-Length does not match the framed body".into(),
+        ));
+    }
+    Ok(())
+}
