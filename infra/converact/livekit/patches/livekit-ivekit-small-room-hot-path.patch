diff --git a/pkg/sfu/utils/downtrackspreader_ivekit_test.go b/pkg/sfu/utils/downtrackspreader_ivekit_test.go
new file mode 100644
index 0000000..7a645bb
--- /dev/null
+++ b/pkg/sfu/utils/downtrackspreader_ivekit_test.go
@@ -0,0 +1,119 @@
+package utils
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/livekit/protocol/livekit"
+)
+
+type ivekitTestSender struct {
+	id livekit.ParticipantID
+}
+
+var ivekitBenchmarkSnapshot []ivekitTestSender
+
+func (s ivekitTestSender) SubscriberID() livekit.ParticipantID {
+	return s.id
+}
+
+func TestDownTrackSpreaderPublishesImmutableSnapshots(t *testing.T) {
+	spreader := NewDownTrackSpreader[ivekitTestSender](DownTrackSpreaderParams{
+		Threshold: 3,
+	})
+	first := ivekitTestSender{id: "first"}
+	second := ivekitTestSender{id: "second"}
+
+	spreader.Store(first)
+	firstSnapshot := spreader.GetDownTracks()
+	spreader.Store(second)
+
+	if len(firstSnapshot) != 1 || firstSnapshot[0].SubscriberID() != first.id {
+		t.Fatalf("published snapshot mutated after Store: %#v", firstSnapshot)
+	}
+	if got := len(spreader.GetDownTracks()); got != 2 {
+		t.Fatalf("current snapshot length = %d, want 2", got)
+	}
+
+	spreader.Free(first.id)
+	if got := spreader.GetDownTracks(); len(got) != 1 || got[0].SubscriberID() != second.id {
+		t.Fatalf("snapshot after Free = %#v, want only second sender", got)
+	}
+}
+
+func TestDownTrackSpreaderParallelThreshold(t *testing.T) {
+	spreader := NewDownTrackSpreader[ivekitTestSender](DownTrackSpreaderParams{
+		Threshold: 3,
+	})
+
+	if spreader.ShouldParallel(1) {
+		t.Fatal("one subscriber must use the serial fast path")
+	}
+	if spreader.ShouldParallel(2) {
+		t.Fatal("subscriber count below threshold must use the serial fast path")
+	}
+	if !spreader.ShouldParallel(3) {
+		t.Fatal("subscriber count at threshold must use parallel broadcast")
+	}
+
+	spreader.SetThreshold(5)
+	if spreader.ShouldParallel(3) {
+		t.Fatal("updated threshold must immediately return small rooms to the serial path")
+	}
+	if !spreader.ShouldParallel(5) {
+		t.Fatal("updated threshold must preserve parallel fanout at the new boundary")
+	}
+}
+
+func TestDownTrackSpreaderZeroThresholdDisablesParallelBroadcast(t *testing.T) {
+	spreader := NewDownTrackSpreader[ivekitTestSender](DownTrackSpreaderParams{})
+	if spreader.ShouldParallel(999999) {
+		t.Fatal("zero threshold must preserve the upstream effectively-disabled behavior")
+	}
+}
+
+func TestDownTrackSpreaderConcurrentSnapshotReads(t *testing.T) {
+	spreader := NewDownTrackSpreader[ivekitTestSender](DownTrackSpreaderParams{
+		Threshold: 20,
+	})
+	spreader.Store(ivekitTestSender{id: "seed"})
+
+	var readers sync.WaitGroup
+	for reader := 0; reader < 8; reader++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for iteration := 0; iteration < 5000; iteration++ {
+				for _, sender := range spreader.GetDownTracks() {
+					if sender.SubscriberID() == "" {
+						t.Error("published snapshot contains an empty subscriber ID")
+						return
+					}
+				}
+			}
+		}()
+	}
+
+	for iteration := 0; iteration < 1000; iteration++ {
+		id := livekit.ParticipantID(fmt.Sprintf("participant-%d", iteration%16))
+		spreader.Store(ivekitTestSender{id: id})
+		if iteration%2 == 0 {
+			spreader.Free(id)
+		}
+	}
+	readers.Wait()
+}
+
+func BenchmarkDownTrackSpreaderSnapshotRead(b *testing.B) {
+	spreader := NewDownTrackSpreader[ivekitTestSender](DownTrackSpreaderParams{
+		Threshold: 20,
+	})
+	spreader.Store(ivekitTestSender{id: "subscriber"})
+	b.ReportAllocs()
+	b.ResetTimer()
+
+	for iteration := 0; iteration < b.N; iteration++ {
+		ivekitBenchmarkSnapshot = spreader.GetDownTracks()
+	}
+}
