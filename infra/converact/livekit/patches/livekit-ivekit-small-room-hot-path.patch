+package sfu
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"github.com/pion/webrtc/v4"
+
+	"github.com/livekit/protocol/livekit"
+
+	"github.com/livekit/livekit-server/pkg/sfu/buffer"
+	sfuutils "github.com/livekit/livekit-server/pkg/sfu/utils"
+)
+
+type ivekitCountingTrackSender struct {
+	id     livekit.ParticipantID
+	writes *atomic.Int32
+}
+
+func (s *ivekitCountingTrackSender) UpTrackLayersChange() {}
+
+func (s *ivekitCountingTrackSender) UpTrackBitrateAvailabilityChange() {}
+
+func (s *ivekitCountingTrackSender) UpTrackMaxPublishedLayerChange(int32) {}
+
+func (s *ivekitCountingTrackSender) UpTrackMaxTemporalLayerSeenChange(int32) {}
+
+func (s *ivekitCountingTrackSender) UpTrackBitrateReport([]int32, Bitrates) {}
+
+func (s *ivekitCountingTrackSender) WriteRTP(*buffer.ExtPacket, int32) int32 {
+	s.writes.Add(1)
+	return 1
+}
+
+func (s *ivekitCountingTrackSender) Close() {}
+
+func (s *ivekitCountingTrackSender) IsClosed() bool { return false }
+
+func (s *ivekitCountingTrackSender) ID() string { return string(s.id) }
+
+func (s *ivekitCountingTrackSender) SubscriberID() livekit.ParticipantID { return s.id }
+
+func (s *ivekitCountingTrackSender) HandleRTCPSenderReportData(
+	webrtc.PayloadType,
+	int32,
+	*livekit.RTCPSenderReportState,
+) error {
+	return nil
+}
+
+func (s *ivekitCountingTrackSender) Resync() {}
+
+func (s *ivekitCountingTrackSender) SetReceiver(TrackReceiver) {}
+
+func (s *ivekitCountingTrackSender) ReceiverRestart(TrackReceiver) {}
+
+func TestWriteRTPToDownTracksUsesSerialSmallRoomPath(t *testing.T) {
+	spreader := sfuutils.NewDownTrackSpreader[TrackSender](sfuutils.DownTrackSpreaderParams{
+		Threshold: 20,
+	})
+	var writes atomic.Int32
+	spreader.Store(&ivekitCountingTrackSender{id: "subscriber", writes: &writes})
+
+	if got := writeRTPToDownTracks(spreader, nil, 0); got != 1 {
+		t.Fatalf("write count = %d, want 1", got)
+	}
+	if got := writes.Load(); got != 1 {
+		t.Fatalf("downtrack writes = %d, want 1", got)
+	}
+}
+
+func TestWriteRTPToDownTracksPreservesParallelLargeRoomPath(t *testing.T) {
+	spreader := sfuutils.NewDownTrackSpreader[TrackSender](sfuutils.DownTrackSpreaderParams{
+		Threshold: 2,
+	})
+	var writes atomic.Int32
+	for index := 0; index < 3; index++ {
+		id := livekit.ParticipantID(rune('a' + index))
+		spreader.Store(&ivekitCountingTrackSender{id: id, writes: &writes})
+	}
+
+	if got := writeRTPToDownTracks(spreader, nil, 0); got != 3 {
+		t.Fatalf("write count = %d, want 3", got)
+	}
+	if got := writes.Load(); got != 3 {
+		t.Fatalf("downtrack writes = %d, want 3", got)
+	}
+}
