# syntax=docker/dockerfile:1

ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE
ARG CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT
ARG CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID
ARG TARGETARCH

FROM ${CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE} AS source-base

WORKDIR /workspace/source
COPY source/ ./

FROM source-base AS relay-build

ARG CONVERACT_FABRIC_RTPENGINE_BUILD_JOBS=1

RUN make -C daemon -j"${CONVERACT_FABRIC_RTPENGINE_BUILD_JOBS}" rtpengine \
    && strip -o /workspace/rtpengine daemon/rtpengine

FROM source-base AS recording-build

ARG CONVERACT_FABRIC_RTPENGINE_BUILD_JOBS=1

RUN make -C recording-daemon -j"${CONVERACT_FABRIC_RTPENGINE_BUILD_JOBS}" rtpengine-recording \
    && strip -o /workspace/rtpengine-recording \
      recording-daemon/rtpengine-recording

FROM scratch AS userspace

ARG CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT
ARG CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID
ARG TARGETARCH

LABEL org.opencontainers.image.source="https://github.com/songgoldenwind-crypto/converact-platform"
LABEL org.opencontainers.image.description="Converact Fabric RTPengine userspace media relay"
LABEL io.ivekit.rtpengine.source-commit="${CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT}"
LABEL io.ivekit.rtpengine.archive-sha256="${CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256}"
LABEL io.ivekit.rtpengine.patch-set-sha256="${CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256}"
LABEL io.ivekit.toolchain.image-id="${CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID}"
LABEL io.ivekit.target-architecture="${TARGETARCH}"
LABEL io.ivekit.runtime-mode="userspace"

COPY --from=source-base /opt/converact-runtime-rootfs/ /
COPY --from=relay-build /workspace/rtpengine /usr/local/bin/rtpengine
COPY entrypoint.sh /usr/local/bin/converact-rtpengine-entrypoint
COPY converact-env-compat.sh /usr/local/lib/converact-env-compat.sh
COPY rtpengine.conf.template /etc/converact/rtpengine.conf.template

ENV CONVERACT_FABRIC_RTPENGINE_RUNTIME_MODE=userspace
ENV CONVERACT_FABRIC_RTPENGINE_CONFIG_TEMPLATE=/etc/converact/rtpengine.conf.template
ENV CONVERACT_FABRIC_RTPENGINE_CONFIG_PATH=/run/converact-rtpengine/rtpengine.conf

USER 10001:10001
VOLUME ["/rec", "/run/converact-rtpengine", "/var/lib/converact-rtpengine"]
EXPOSE 22222/tcp 22222/udp 8080/tcp 23000-32768/udp
ENTRYPOINT ["/usr/local/bin/converact-rtpengine-entrypoint"]

FROM scratch AS recording

ARG CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT
ARG CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID
ARG TARGETARCH

LABEL org.opencontainers.image.source="https://github.com/songgoldenwind-crypto/converact-platform"
LABEL org.opencontainers.image.description="Converact Fabric RTPengine recording daemon"
LABEL io.ivekit.rtpengine.source-commit="${CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT}"
LABEL io.ivekit.rtpengine.archive-sha256="${CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256}"
LABEL io.ivekit.rtpengine.patch-set-sha256="${CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256}"
LABEL io.ivekit.toolchain.image-id="${CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID}"
LABEL io.ivekit.target-architecture="${TARGETARCH}"
LABEL io.ivekit.runtime-mode="recording"

COPY --from=source-base /opt/converact-runtime-rootfs/ /
COPY --from=recording-build /workspace/rtpengine-recording /usr/local/bin/rtpengine-recording

USER 10001:10001
VOLUME ["/rec", "/run/converact-rtpengine", "/var/lib/converact-rtpengine"]
ENTRYPOINT ["/usr/local/bin/rtpengine-recording"]

FROM source-base AS kernel-build

ARG CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE

COPY kernel-headers/ /opt/converact-kernel-headers/

RUN test -n "${CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE}" \
    && test -f /opt/converact-kernel-headers/Makefile \
    && make -C kernel-module \
      KSRC=/opt/converact-kernel-headers \
      KERNELRELEASE="${CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE}" \
      modules \
    && install -D -m 0644 kernel-module/nft_rtpengine.ko \
      /workspace/kernel/nft_rtpengine.ko \
    && module_sha256="$(sha256sum /workspace/kernel/nft_rtpengine.ko | cut -d' ' -f1)" \
    && module_srcversion="$(modinfo -F srcversion /workspace/kernel/nft_rtpengine.ko)" \
    && test -n "${module_srcversion}" \
    && printf '%s\n' "${module_srcversion}" \
      > /workspace/kernel/module-srcversion \
    && printf '%s\n' \
      '{' \
      "  \"kernel_release\": \"${CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE}\"," \
      "  \"module_sha256\": \"${module_sha256}\"," \
      "  \"module_srcversion\": \"${module_srcversion}\"" \
      '}' \
      > /workspace/kernel/module-identity.json

FROM scratch AS kernel-artifact

ARG CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT
ARG CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID
ARG CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE
ARG TARGETARCH

LABEL org.opencontainers.image.source="https://github.com/songgoldenwind-crypto/converact-platform"
LABEL org.opencontainers.image.description="Converact Fabric RTPengine nftables kernel artifact"
LABEL io.ivekit.rtpengine.source-commit="${CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT}"
LABEL io.ivekit.rtpengine.archive-sha256="${CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256}"
LABEL io.ivekit.rtpengine.patch-set-sha256="${CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256}"
LABEL io.ivekit.toolchain.image-id="${CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID}"
LABEL io.ivekit.target-architecture="${TARGETARCH}"
LABEL io.ivekit.runtime-mode="kernel-artifact"
LABEL io.ivekit.kernel-release="${CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE}"

COPY --from=kernel-build /workspace/kernel/ /

FROM kernel-build AS kernel-runtime-identity

ARG CONVERACT_FABRIC_RTPENGINE_KERNEL_SRCVERSION

RUN test -n "${CONVERACT_FABRIC_RTPENGINE_KERNEL_SRCVERSION}" \
    && test "$(cat /workspace/kernel/module-srcversion)" \
      = "${CONVERACT_FABRIC_RTPENGINE_KERNEL_SRCVERSION}"

FROM scratch AS kernel-runtime

ARG CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT
ARG CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256
ARG CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID
ARG CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE
ARG CONVERACT_FABRIC_RTPENGINE_KERNEL_SRCVERSION
ARG TARGETARCH

LABEL org.opencontainers.image.source="https://github.com/songgoldenwind-crypto/converact-platform"
LABEL org.opencontainers.image.description="Converact Fabric RTPengine kernel-mode media relay"
LABEL io.ivekit.rtpengine.source-commit="${CONVERACT_FABRIC_RTPENGINE_SOURCE_COMMIT}"
LABEL io.ivekit.rtpengine.archive-sha256="${CONVERACT_FABRIC_RTPENGINE_ARCHIVE_SHA256}"
LABEL io.ivekit.rtpengine.patch-set-sha256="${CONVERACT_FABRIC_RTPENGINE_PATCH_SET_SHA256}"
LABEL io.ivekit.toolchain.image-id="${CONVERACT_FABRIC_RTPENGINE_TOOLCHAIN_IMAGE_ID}"
LABEL io.ivekit.target-architecture="${TARGETARCH}"
LABEL io.ivekit.runtime-mode="kernel"
LABEL io.ivekit.kernel-release="${CONVERACT_FABRIC_RTPENGINE_KERNEL_RELEASE}"
LABEL io.ivekit.kernel-srcversion="${CONVERACT_FABRIC_RTPENGINE_KERNEL_SRCVERSION}"

COPY --from=source-base /opt/converact-runtime-rootfs/ /
COPY --from=relay-build /workspace/rtpengine /usr/local/bin/rtpengine
COPY entrypoint.sh /usr/local/bin/converact-rtpengine-entrypoint
COPY converact-env-compat.sh /usr/local/lib/converact-env-compat.sh
COPY rtpengine.conf.template /etc/converact/rtpengine.conf.template
COPY --from=kernel-runtime-identity /workspace/kernel/module-srcversion \
  /usr/share/converact-rtpengine/kernel/module-srcversion

ENV CONVERACT_FABRIC_RTPENGINE_RUNTIME_MODE=kernel
ENV CONVERACT_FABRIC_RTPENGINE_CONFIG_TEMPLATE=/etc/converact/rtpengine.conf.template
ENV CONVERACT_FABRIC_RTPENGINE_CONFIG_PATH=/run/converact-rtpengine/rtpengine.conf

USER 10001:10001
VOLUME ["/rec", "/run/converact-rtpengine", "/var/lib/converact-rtpengine"]
EXPOSE 22222/tcp 22222/udp 8080/tcp 23000-32768/udp
ENTRYPOINT ["/usr/local/bin/converact-rtpengine-entrypoint"]
