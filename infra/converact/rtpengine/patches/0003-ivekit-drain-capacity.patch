+static uint64_t ivekit_guard_env_uint(const char *name, uint64_t fallback,
+		uint64_t minimum, uint64_t maximum)
+{
+	const char *value = g_getenv(name);
+	if (!value || !*value)
+		return fallback;
+	if (*value == '0')
+		die("Invalid %s: expected an integer between %" PRIu64 " and %" PRIu64,
+				name, minimum, maximum);
+	errno = 0;
+	char *end = NULL;
+	guint64 parsed = g_ascii_strtoull(value, &end, 10);
+	if (errno == ERANGE || !end || *end || parsed < minimum || parsed > maximum)
+		die("Invalid %s: expected an integer between %" PRIu64 " and %" PRIu64,
+				name, minimum, maximum);
