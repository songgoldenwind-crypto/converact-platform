 type Usage = (usize, usize, usize, usize);
 
+#[derive(Default)]
+struct UsageCounters {
+    sequence: AtomicUsize,
+    elapsed: AtomicUsize,
+    total: AtomicUsize,
+    highest: AtomicUsize,
+    speed: AtomicUsize,
+}
+
+impl UsageCounters {
+    fn update(&self, elapsed: usize, total: usize, highest: usize, speed: usize) {
+        self.sequence.fetch_add(1, Ordering::Relaxed);
+        self.elapsed.store(elapsed, Ordering::Relaxed);
+        self.total.store(total, Ordering::Relaxed);
+        self.highest.store(highest, Ordering::Relaxed);
+        self.speed.store(speed, Ordering::Relaxed);
+        self.sequence.fetch_add(1, Ordering::Release);
+    }
+
+    fn snapshot(&self) -> Usage {
+        loop {
+            let sequence = self.sequence.load(Ordering::Acquire);
+            if sequence % 2 != 0 {
+                std::hint::spin_loop();
+                continue;
+            }
+            let snapshot = (
+                self.elapsed.load(Ordering::Relaxed),
+                self.total.load(Ordering::Relaxed),
+                self.highest.load(Ordering::Relaxed),
+                self.speed.load(Ordering::Relaxed),
+            );
+            if self.sequence.load(Ordering::Acquire) == sequence {
+                return snapshot;
+            }
+        }
+    }
+}
+
+enum RelayFrame {
+    Raw(Bytes),
+    WebSocket(Vec<u8>),
+}
+
+impl RelayFrame {
+    fn len(&self) -> usize {
+        self.as_ref().len()
+    }
+
+    fn is_empty(&self) -> bool {
+        self.as_ref().is_empty()
+    }
+
+    fn into_raw(self) -> Bytes {
+        match self {
+            Self::Raw(bytes) => bytes,
+            Self::WebSocket(bytes) => Bytes::from(bytes),
+        }
+    }
+
+    fn into_websocket(self) -> Vec<u8> {
+        match self {
+            Self::Raw(bytes) => bytes.to_vec(),
+            Self::WebSocket(bytes) => bytes,
+        }
+    }
+}
+
+impl AsRef<[u8]> for RelayFrame {
+    fn as_ref(&self) -> &[u8] {
+        match self {
+            Self::Raw(bytes) => bytes.as_ref(),
+            Self::WebSocket(bytes) => bytes.as_slice(),
+        }
+    }
+}
