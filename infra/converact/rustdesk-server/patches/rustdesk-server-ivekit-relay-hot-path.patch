+#[cfg(test)]
+mod ivekit_hot_path_tests {
+    use super::*;
+
+    #[test]
+    fn same_protocol_frames_keep_their_allocations() {
+        let websocket = vec![1, 2, 3, 4];
+        let websocket_ptr = websocket.as_ptr();
+        let websocket = RelayFrame::WebSocket(websocket).into_websocket();
+        assert_eq!(websocket.as_ptr(), websocket_ptr);
+
+        let raw = Bytes::from(vec![5, 6, 7, 8]);
+        let raw_ptr = raw.as_ptr();
+        let raw = RelayFrame::Raw(raw).into_raw();
+        assert_eq!(raw.as_ptr(), raw_ptr);
+    }
+
+    #[test]
+    fn usage_updates_do_not_require_the_global_session_map() {
+        let usage = UsageCounters::default();
+        usage.update(1_000, 8_192, 16, 8);
+        assert_eq!(usage.snapshot(), (1_000, 8_192, 16, 8));
+    }
+}
