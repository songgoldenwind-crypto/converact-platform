# Operator-only backup/restore. The image contains pg_dump, pg_restore and psql.
# The host backup directory must be writable by uid/gid 1000 before Compose backup runs.
CONVERACT_FABRIC_BACKUP_HOST_DIR=./backups
CONVERACT_FABRIC_BACKUP_ROOT=/backups
CONVERACT_FABRIC_BACKUP_OBJECT_PREFIX=
# Optional dependent databases. When set, they are included in the same signed manifest.
CONVERACT_FABRIC_TINODE_ADMIN_DATABASE_URL=
CONVERACT_FABRIC_RUSTPBX_ADMIN_DATABASE_URL=
CONVERACT_FABRIC_PG_DUMP_BIN=pg_dump
CONVERACT_FABRIC_PG_RESTORE_BIN=pg_restore
CONVERACT_FABRIC_PSQL_BIN=psql
# Restore remains a validation-only dry run unless --execute and both guards are supplied.
IVEKIT_RESTORE_CONFIRM=
IVEKIT_RESTORE_TARGET_EMPTY=0

# Secure file scanning. Use clamd or HTTP in production; controlled is test-only.
CLAMAV_IMAGE=clamav/clamav:1.5.2_base@sha256:3aa0c6d6a966dc062899e070fb13f87485acf0cbb710fccaae9a848cd5f5b09a
CONVERACT_SECURE_FILE_UPLOAD_MAX_BYTES=67108864
CONVERACT_FILE_SECURITY_SCANNER_MODE=disabled
