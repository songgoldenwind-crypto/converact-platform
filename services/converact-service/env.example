CONVERACT_FILE_SECURITY_SCANNER_ENDPOINT=/v1/scan
CONVERACT_FILE_SECURITY_SCANNER_TOKEN=
CONVERACT_FILE_SECURITY_SCANNER_TIMEOUT_MS=30000

