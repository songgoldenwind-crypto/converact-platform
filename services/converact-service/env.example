# V5 intelligence provider profiles. Capabilities are ocr, asr, quality_review,
# translation, realtime_speech, tts, and model_gateway. Each profile may set adapter,
# provider_version, data_region, requests_per_minute,
# requests_per_day, max_concurrency, failure_threshold, open_cooldown_ms and
# reservation_ttl_ms. realtime_speech may also set max_buffered_audio_ms and
# max_session_seconds. Ordered tenant routes live in the intelligence policy;
# no fallback is inferred from profile declaration order.
# Example profile object (keep real endpoints and tokens out of Git):
# {"id":"ocr-primary","capability":"ocr","mode":"self_hosted","base_url":"http://ocr:8080","requests_per_minute":600,"requests_per_day":100000,"max_concurrency":20,"failure_threshold":3,"open_cooldown_ms":30000,"reservation_ttl_ms":35000}
# {"id":"speech-primary","capability":"realtime_speech","mode":"third_party","base_url":"https://speech.example.invalid","adapter":"ivekit_realtime_speech_v1","token_env":"CONVERACT_FABRIC_REALTIME_SPEECH_TOKEN","max_concurrency":100,"max_buffered_audio_ms":1000,"max_session_seconds":14400,"reservation_ttl_ms":35000}
CONVERACT_FABRIC_PROVIDER_PROFILES_JSON=[]
CONVERACT_FABRIC_OCR_TOKEN=
