IVEKIT_SERVICE_IMAGE=ivekit-service:local
IVEKIT_POSTGRES_IMAGE_TAG=16-alpine
IVEKIT_HTTP_PORT=8300

POSTGRES_PASSWORD=replace-with-random-admin-password
OPC_RUNTIME_DB_PASSWORD=replace-with-distinct-random-runtime-password

# Optional providers. Leave workers disabled until their matching provider is configured.
REDIS_URL=
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPC_API_KEY=
OPC_JWT_SECRET=
OPC_RUSTDESK_REQUIRE_PHYSICAL_DISCONNECT=0
OPC_RUSTDESK_EDGE_TOKEN_SECRET=
OPC_IVEKIT_ALLOWED_ORIGINS=
OPC_IVEKIT_EVENT_REPLAY_ENABLED=1
OPC_IVEKIT_EVENT_RETENTION_MS=86400000
OPC_IVEKIT_EVENT_MAX_PAYLOAD_BYTES=65536
OPC_IVEKIT_WS_REPLAY_MAX_EVENTS=500
OPC_IVEKIT_EVENT_RETENTION_WORKER_ENABLED=1
OPC_IVEKIT_EVENT_RETENTION_INTERVAL_MS=60000
OPC_IVEKIT_EVENT_RETENTION_TENANT_LIMIT=100
OPC_IVEKIT_EVENT_RETENTION_BATCH_SIZE=1000
TINODE_BASE_URL=
TINODE_WS_URL=
TINODE_PUBLIC_BASE_URL=
TINODE_PUBLIC_WS_URL=
TINODE_API_KEY=
TINODE_AUTH_TOKEN=
TINODE_BASIC_USER=
TINODE_BASIC_PASSWORD=
TINODE_USER_PASSWORD_SECRET=
TINODE_REQUEST_TIMEOUT_MS=5000
OPC_TINODE_DELIVERY_WORKER_ENABLED=0
OPC_TINODE_INBOUND_WORKER_ENABLED=0
OPC_TINODE_INBOUND_INTERVAL_MS=5000
OPC_TINODE_INBOUND_TENANT_LIMIT=100
OPC_TINODE_INBOUND_PULL_LIMIT=100
OPC_TINODE_INBOUND_CLAIM_LEASE_MS=60000
OPC_TINODE_INBOUND_RETRY_DELAY_MS=10000
OPC_TINODE_INBOUND_DEAD_LETTER_MAX_ATTEMPTS=3
OPC_TINODE_ATTACHMENT_ALLOWED_HOSTS=
OPC_CHAT_MESSAGE_MUTATION_WINDOW_MS=900000

# Object storage used for chat attachments and OCR/ASR source bytes.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# V3 intelligence provider profiles. token_env values in the JSON may reference only the token variables below.
OPC_IVEKIT_PROVIDER_PROFILES_JSON=[]
OPC_IVEKIT_OCR_TOKEN=
OPC_IVEKIT_ASR_TOKEN=
OPC_IVEKIT_QUALITY_TOKEN=
OPC_IVEKIT_TRANSLATION_TOKEN=
OPC_ATTACHMENT_PROCESSING_WORKER_ENABLED=0
OPC_ATTACHMENT_PROCESSING_INTERVAL_MS=5000
OPC_ATTACHMENT_PROCESSING_BATCH_SIZE=25
OPC_ATTACHMENT_PROCESSING_MAX_ATTEMPTS=3
OPC_ATTACHMENT_PROCESSING_CLAIM_LEASE_MS=120000
OPC_ATTACHMENT_PROCESSING_RETRY_DELAYS_MS=5000,30000
OPC_QUALITY_REVIEW_AUTO_ENQUEUE=0
OPC_QUALITY_REVIEW_WORKER_ENABLED=0
OPC_QUALITY_REVIEW_INTERVAL_MS=5000
OPC_QUALITY_REVIEW_BATCH_SIZE=25
OPC_QUALITY_REVIEW_MAX_ATTEMPTS=3
OPC_QUALITY_REVIEW_CLAIM_LEASE_MS=120000
OPC_QUALITY_REVIEW_RETRY_DELAYS_MS=5000,30000
OPC_TRANSLATION_WORKER_ENABLED=0
OPC_TRANSLATION_INTERVAL_MS=5000
OPC_TRANSLATION_BATCH_SIZE=25
OPC_TRANSLATION_MAX_ATTEMPTS=3
OPC_TRANSLATION_CLAIM_LEASE_MS=120000
OPC_TRANSLATION_RETRY_DELAYS_MS=5000,30000
OPC_MEDIA_CALL_TIMEOUT_WORKER_ENABLED=0

# iveKit Voice workers and RustPBX adapter secrets. Keep disabled until profiles exist.
OPC_IVEKIT_VOICE_WORKERS_ENABLED=0
OPC_IVEKIT_VOICE_COMMAND_INTERVAL_MS=1000
OPC_IVEKIT_VOICE_COMMAND_BATCH_SIZE=25
OPC_IVEKIT_VOICE_COMMAND_LEASE_MS=30000
OPC_IVEKIT_VOICE_COMMAND_MAX_ATTEMPTS=5
OPC_IVEKIT_VOICE_COMMAND_RETRY_DELAYS_MS=1000,5000,30000
OPC_IVEKIT_VOICE_EVENT_INTERVAL_MS=1000
OPC_IVEKIT_VOICE_EVENT_BATCH_SIZE=25
OPC_IVEKIT_VOICE_EVENT_LEASE_MS=30000
OPC_IVEKIT_VOICE_RECONCILIATION_INTERVAL_MS=5000
OPC_IVEKIT_VOICE_RECONCILIATION_MAX_AGE_MS=900000
OPC_IVEKIT_VOICE_PROVIDER_TIMEOUT_MS=10000
OPC_IVEKIT_VOICE_ADDRESS_KEY=
OPC_IVEKIT_VOICE_ADDRESS_HMAC_KEY=
OPC_IVEKIT_VOICE_SECRET_ENV_NAMES=RUSTPBX_MANAGEMENT_TOKEN,RUSTPBX_RWI_TOKEN
OPC_IVEKIT_VOICE_WEBHOOK_SECRET_ENV_NAMES=RUSTPBX_WEBHOOK_TOKEN
RUSTPBX_MANAGEMENT_TOKEN=
RUSTPBX_RWI_TOKEN=
RUSTPBX_WEBHOOK_TOKEN=
