IVEKIT_SERVICE_IMAGE=ivekit-service:local
IVEKIT_POSTGRES_IMAGE_TAG=16-alpine
IVEKIT_HTTP_PORT=8300

POSTGRES_PASSWORD=replace-with-random-admin-password
OPC_RUNTIME_DB_PASSWORD=replace-with-distinct-random-runtime-password

# Optional providers. Leave workers disabled until their matching provider is configured.
REDIS_URL=
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPC_API_KEY=
OPC_JWT_SECRET=
OPC_IVEKIT_ALLOWED_ORIGINS=
TINODE_BASE_URL=
TINODE_WS_URL=
TINODE_API_KEY=
TINODE_AUTH_TOKEN=
TINODE_BASIC_USER=
TINODE_BASIC_PASSWORD=
OPC_TINODE_DELIVERY_WORKER_ENABLED=0
OPC_TINODE_INBOUND_WORKER_ENABLED=0
OPC_TINODE_INBOUND_INTERVAL_MS=5000
OPC_TINODE_INBOUND_TENANT_LIMIT=100
OPC_TINODE_INBOUND_PULL_LIMIT=100
OPC_TINODE_INBOUND_CLAIM_LEASE_MS=60000
OPC_TINODE_INBOUND_RETRY_DELAY_MS=10000
OPC_TINODE_INBOUND_DEAD_LETTER_MAX_ATTEMPTS=3
OPC_TINODE_ATTACHMENT_ALLOWED_HOSTS=
OPC_ATTACHMENT_PROCESSING_WORKER_ENABLED=0
OPC_QUALITY_REVIEW_WORKER_ENABLED=0
OPC_MEDIA_CALL_TIMEOUT_WORKER_ENABLED=0
