      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test./tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "zero_port_is_rejected",
      "issuer": "https://auth.example.test:0/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test:0/tenant/.well-known/jwks.json",
      "target_expected": "denied"
