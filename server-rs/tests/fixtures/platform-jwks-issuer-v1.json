    },
    {
      "name": "loopback_http_requires_explicit_policy",
      "issuer": "http://127.0.0.1:8080/identity",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "http://127.0.0.1:8080/identity/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "ipv6_loopback_supported_when_explicit",
