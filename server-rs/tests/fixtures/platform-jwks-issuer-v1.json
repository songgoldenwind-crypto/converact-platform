  "cases": [
    {
      "name": "https_root",
      "issuer": "https://auth.example.test",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/.well-known/jwks.json"
    },
    {
      "name": "https_root_trailing_slash",
      "issuer": "https://auth.example.test/",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/.well-known/jwks.json"
    },
    {
      "name": "https_tenant_path",
      "issuer": "https://auth.example.test/realms/tenant-a",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/realms/tenant-a/.well-known/jwks.json"
    },
    {
      "name": "https_tenant_path_trailing_slash",
      "issuer": "https://auth.example.test/realms/tenant-a/",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/realms/tenant-a/.well-known/jwks.json"
    },
    {
      "name": "default_https_port_canonicalized",
      "issuer": "https://auth.example.test:443/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/tenant/.well-known/jwks.json"
    },
    {
      "name": "nondefault_https_port_preserved",
      "issuer": "https://auth.example.test:8443/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test:8443/tenant/.well-known/jwks.json"
    },
    {
      "name": "unicode_domain_canonicalized",
      "issuer": "https://例子.测试/realm",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://xn--fsqu00a.xn--0zwm56d/realm/.well-known/jwks.json"
    },
    {
      "name": "query_and_fragment_are_not_authority",
      "issuer": "https://auth.example.test/tenant?source=a#fragment",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "credentials_are_not_authority",
      "issuer": "https://user:password@auth.example.test/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://user:password@auth.example.test/tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "empty_userinfo_is_not_authority",
      "issuer": "https://@auth.example.test/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "leading_whitespace_is_rejected",
      "issuer": " https://auth.example.test/tenant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
      "name": "embedded_ascii_whitespace_is_rejected",
      "issuer": "https://auth.example.test/ten\tant",
      "target_policy": "https_only",
      "expected": "allowed",
      "expected_jwks_url": "https://auth.example.test/tenant/.well-known/jwks.json",
      "target_expected": "denied"
    },
    {
