{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.local/schemas/goal-gate-amendment-v1.schema.json",
  "title": "Converact Goal Gate Amendment V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "amendment_id",
    "version",
    "authorized_at",
    "authorization_basis",
    "scope",
    "frozen_inputs",
    "development_gate",
    "production_gate",
    "effective_dependency",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "const": "./goal-gate-amendment-v1.schema.json"
    },
    "amendment_id": {
      "const": "GATE-AMENDMENT-G02-G03-2026-08-02-V1"
    },
    "version": {
      "const": 1
    },
    "authorized_at": {
      "const": "2026-08-02"
    },
    "authorization_basis": {
      "const": "user_authorized_split_then_start_g03"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "does_not_change"],
      "properties": {
        "changes": {
          "const": ["G03_dependency_gate_only"]
        },
        "does_not_change": {
          "const": [
            "G02_binding_objective_or_hash",
            "G03_binding_objective_or_hash",
            "domain_authorities",
            "technical_acceptance_gates",
            "evidence_statuses",
            "production_eligibility"
          ]
        }
      }
    },
    "frozen_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "goal_02_path",
        "goal_02_sha256",
        "goal_03_path",
        "goal_03_sha256"
      ],
      "properties": {
        "manifest_path": { "const": "goals/manifest.json" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "goal_02_path": { "const": "goals/goal-02-platform-foundation-security-observability.md" },
        "goal_02_sha256": { "const": "742e194e6b2d3e2b6fe9390bbabe96a6bbe0f40bdf99d8ed4ae4060a711a87f9" },
        "goal_03_path": { "const": "goals/goal-03-sip-call-durable-foundation.md" },
        "goal_03_sha256": { "const": "05ce7f940782ab0efcd013d413220d068a7d3be1bab981f2c2c4f6a6f2a217af" }
      }
    },
    "development_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "closure_commit",
        "evidence_uris",
        "review_findings",
        "production_eligible"
      ],
      "properties": {
        "gate_id": { "const": "G02_PLATFORM_FOUNDATION_GATE" },
        "status": { "const": "completed" },
        "closure_commit": { "const": "16ab4af98c5f3b453ad3d9bdd1ae5fe959a37720" },
        "evidence_uris": {
          "const": [
            "architecture-foundation/execution/goal-02/evidence-index-v1.json",
            "architecture-foundation/execution/goal-02/independent-review.md"
          ]
        },
        "review_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["critical", "high", "important", "minor"],
          "properties": {
            "critical": { "const": 0 },
            "high": { "const": 0 },
            "important": { "const": 0 },
            "minor": { "const": 0 }
          }
        },
        "production_eligible": { "const": false }
      }
    },
    "production_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "not_run_evidence_ids", "production_eligible"],
      "properties": {
        "gate_id": { "const": "G02_PRODUCTION_EVIDENCE_GATE" },
        "status": { "const": "blocked_external" },
        "not_run_evidence_ids": {
          "const": [
            "G02-E09-DEPENDENCY",
            "G02-E12-LONG-MEDIA",
            "G02-E14-REGION",
            "G02-E15-NATIVE"
          ]
        },
        "production_eligible": { "const": false }
      }
    },
    "effective_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependent_goal",
        "prerequisite_goal",
        "original_gate",
        "effective_gate",
        "amendment_precedence"
      ],
      "properties": {
        "dependent_goal": { "const": "G03" },
        "prerequisite_goal": { "const": "G02" },
        "original_gate": { "const": "completed" },
        "effective_gate": { "const": "platform_foundation_gate_completed" },
        "amendment_precedence": { "const": "later_user_authorized_gate_only" }
      }
    },
    "invariants": {
      "const": [
        "anything_unproved_remains_not_run",
        "production_eligibility_remains_false",
        "G03_does_not_inherit_G02_external_evidence",
        "G03_must_satisfy_its_own_full_objective",
        "no_production_or_server_mutation_authorized"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
