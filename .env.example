OPC_CUSTOMER_BROWSER_SMOKE_TIMEOUT_MS=30000
OPC_CUSTOMER_BROWSER_SMOKE_EXPECT_REMOTE=0
OPC_CUSTOMER_BROWSER_SMOKE_EXPECT_SCREEN_SHARE=0
# Web Assist browser smoke/readiness. Use a signed /remote-assist/session link from a granted session.
OPC_WEB_ASSIST_CUSTOMER_URL=
OPC_REMOTE_ASSIST_CUSTOMER_URL=
OPC_WEB_ASSIST_REMOTE_SESSION_ID=
OPC_WEB_ASSIST_TENANT_ID=tenant_demo
OPC_WEB_ASSIST_ENGINEER_TOKEN=
