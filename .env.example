TINODE_BASIC_USER=
TINODE_BASIC_PASSWORD=
TINODE_USER_PASSWORD_SECRET=
TINODE_REQUEST_TIMEOUT_MS=5000
OPC_CHAT_MESSAGE_MUTATION_WINDOW_MS=900000
OPC_TINODE_DELIVERY_WORKER_ENABLED=1
OPC_TINODE_DELIVERY_INTERVAL_MS=5000
OPC_TINODE_DELIVERY_BATCH_SIZE=50
OPC_TINODE_DELIVERY_MAX_ATTEMPTS=3
OPC_TINODE_DELIVERY_CLAIM_LEASE_MS=30000
OPC_TINODE_DELIVERY_RETRY_DELAYS_MS=2000,10000
TINODE_CHAT_SMOKE_TENANT_ID=tenant_demo
TINODE_CHAT_SMOKE_SESSION_ID=
TINODE_CHAT_SMOKE_TITLE=Tinode smoke
TINODE_CHAT_SMOKE_SENDER_IDENTITY=agent_tinode_smoke
TINODE_CHAT_SMOKE_PARTICIPANT_IDENTITY=
TINODE_CHAT_SMOKE_PARTICIPANT_USER_ID=
TINODE_CHAT_SMOKE_BODY=hello from OPC Tinode smoke
TINODE_CHAT_SMOKE_TIMEOUT_MS=5000
OPC_TINODE_PREFLIGHT_ENV_CHECKLIST_FILE=
OPC_TINODE_PREFLIGHT_REPORT_FILE=
# Collaboration attachment OCR/ASR. MODE accepts self_hosted or third_party.
OPC_COLLABORATION_ATTACHMENT_MAX_BYTES=26214400
OPC_OCR_PROVIDER_MODE=self_hosted
OPC_OCR_PROVIDER_NAME=
OPC_OCR_BASE_URL=
OPC_OCR_ENDPOINT=/v1/ocr
OPC_OCR_TOKEN=
OPC_OCR_TIMEOUT_MS=30000
OPC_ASR_PROVIDER_MODE=self_hosted
OPC_ASR_PROVIDER_NAME=
OPC_ASR_BASE_URL=
OPC_ASR_ENDPOINT=/v1/asr
OPC_ASR_TOKEN=
OPC_ASR_TIMEOUT_MS=30000
OPC_ATTACHMENT_PROCESSING_WORKER_ENABLED=1
OPC_ATTACHMENT_PROCESSING_INTERVAL_MS=5000
OPC_ATTACHMENT_PROCESSING_BATCH_SIZE=25
OPC_ATTACHMENT_PROCESSING_MAX_ATTEMPTS=3
OPC_ATTACHMENT_PROCESSING_CLAIM_LEASE_MS=60000
OPC_ATTACHMENT_PROCESSING_RETRY_DELAYS_MS=2000,10000
# Collaboration AI quality review. Provider mode accepts self_hosted or third_party.
OPC_QUALITY_REVIEW_PROVIDER_MODE=self_hosted
OPC_QUALITY_REVIEW_PROVIDER_NAME=
OPC_QUALITY_REVIEW_BASE_URL=
OPC_QUALITY_REVIEW_ENDPOINT=/v1/quality-review
OPC_QUALITY_REVIEW_TOKEN=
OPC_QUALITY_REVIEW_TIMEOUT_MS=30000
OPC_QUALITY_REVIEW_AUTO_ENQUEUE=1
OPC_QUALITY_REVIEW_WORKER_ENABLED=1
OPC_QUALITY_REVIEW_INTERVAL_MS=5000
OPC_QUALITY_REVIEW_BATCH_SIZE=25
OPC_QUALITY_REVIEW_MAX_ATTEMPTS=3
OPC_QUALITY_REVIEW_CLAIM_LEASE_MS=120000
OPC_QUALITY_REVIEW_RETRY_DELAYS_MS=5000,30000
RUSTPBX_WEBHOOK_KEY=dev-pbx-key
RUSTPBX_RWI_URL=ws://localhost:8080/rwi/v1
RUSTPBX_RWI_TOKEN=dev-rwi-token
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=recordings
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Media Core recording lifecycle. Production storage reads only allow configured HTTP origins.
OPC_MEDIA_RECORDING_RETENTION_DAYS=90
OPC_RECORDING_EXPORT_MAX_BYTES=67108864
OPC_MEDIA_CALL_TIMEOUT_WORKER_ENABLED=1
OPC_MEDIA_CALL_TIMEOUT_INTERVAL_MS=1000
OPC_MEDIA_CALL_TIMEOUT_BATCH_SIZE=50
OPC_MEDIA_CALL_TIMEOUT_TENANT_LIMIT=100
OPC_RECORDING_HTTP_ALLOWED_ORIGINS=http://localhost:9000
OPC_RECORDING_HTTP_TIMEOUT_MS=15000
# Optional local mount for LiveKit Egress outputs; used to compute recording evidence checksums when objects are not HTTP/S3 readable.
OPC_RECORDING_OBJECT_DIR=

# AI Agent — LLM dual-stack (primary 27B + DeepSeek fallback)
# Primary — Qwen3.6-27B（必须同时设置 KEY + URL）
LLM_API_KEY=Qwen3.6-27B
LLM_BASE_URL=http://localhost:9997/v1
LLM_MODEL=Qwen3.6-27B
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Fallback — DeepSeek（27B 传输失败时）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# AI Agent — cloud speech fallbacks (optional if using self-hosted below)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# AI Agent — self-hosted Chinese speech (Mac host, see services/speech-host/README.md)
SPEECH_ASR_PROVIDER=funasr
SPEECH_TTS_PROVIDER=cosyvoice
FUNASR_URL=http://127.0.0.1:8899
COSYVOICE_URL=http://127.0.0.1:50000
COSYVOICE_SPK_ID=中文女

# ===== Stripe Billing =====
# Leave empty to use mock checkout URLs (dev/test).
# Production: create products in Stripe Dashboard, copy price IDs here.
# See docs/billing/stripe-setup.md for step-by-step guide.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ===== Dialer =====
OPC_DISABLE_DIALER=0
OPC_DIALER_INTERVAL_MS=3000
OPC_DIALER_IGNORE_WINDOW=0
OPC_DIALER_AGENT_JOIN_TIMEOUT_MS=10000
OPC_DIALER_ANSWER_TIMEOUT_MS=30000
OPC_DIALER_CUSTOMER_JOIN_TIMEOUT_MS=120000
MAX_CONCURRENT_OUTBOUND=20
MAX_CONCURRENT_OUTBOUND_PER_TENANT=5
RUSTPBX_DEFAULT_TRUNK=twilio-japan
CUSTOMER_H5_BASE_URL=http://localhost:5173
SMS_PROVIDER=log

# 可选：JSON 覆盖默认 registry.channels（不含密钥）
# OPC_PROSPECT_OUTREACH_CHANNEL_PROVIDER_REGISTRY_JSON={"channels":{"wechat":{"provider":"opc-wechat-http"}}}
