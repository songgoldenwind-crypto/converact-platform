# OPC AI 通信平台 — 环境配置示例
# 复制为 .env 后填入真实值；勿提交含密钥的 .env
NODE_ENV=development

# ===== Database =====
# DATABASE_URL 必填；运行服务只使用 PostgreSQL。SQLite 仅用于内存单元测试。
# Migration 自动跑（migrations/005_full_schema.sql，168 表）
DATABASE_URL=postgres://user:password@localhost:5432/opc

# ===== Call Center (RustPBX + LiveKit) =====
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
OPC_LIVEKIT_DEPLOYMENT_MODE=bundled-dev
LIVEKIT_SERVER_IMAGE_TAG=v1.13.3
LIVEKIT_EGRESS_IMAGE_TAG=v1.13.0
LIVEKIT_SIP_IMAGE_TAG=v1.6.0
LIVEKIT_CADDYL4_IMAGE_TAG=v2.11.3
LIVEKIT_SIGNAL_DOMAIN=
LIVEKIT_TURN_DOMAIN=
LIVEKIT_ACME_EMAIL=
OPC_BASE_URL=http://localhost:3000
OPC_FRONTEND_URL=http://localhost:5173
OPC_API_KEY=dev-opc-key
# Protects reusable /api/media/livekit management endpoints when set.
OPC_MEDIA_API_TOKEN=dev-media-token
# Signs customer H5 video invitation links when set.
OPC_MEDIA_INVITE_SECRET=dev-media-invite-secret
OPC_MEDIA_INVITE_TTL_MS=86400000
LIVEKIT_SIP_BRIDGE_TARGET=sip:livekit-bridge@127.0.0.1:5061
RUSTPBX_LIVEKIT_TRUNK=livekit-bridge
# Set to 1 for production readiness when SIP/VoLTE must be active, not just planned.
OPC_SIP_VOLTE_REQUIRE_ACTIVE=0
# Optional runtime health endpoint for livekit-sip/RustPBX bridge activation checks.
OPC_SIP_VOLTE_GATEWAY_STATUS_URL=
OPC_SIP_VOLTE_GATEWAY_STATUS_TOKEN=
# Full video readiness suite. Empty targets = media,avatar,ai-callback,agent-browser,customer-browser,collaboration,sip-volte.
# Add web-assist-browser when a signed Web Assist session is ready for real browser validation.
OPC_VIDEO_READINESS_TARGETS=
OPC_VIDEO_READINESS_CONTINUE_ON_FAILURE=0
# Secret-safe readiness artifact. Stores hashes and statuses, never raw smoke stdout.
OPC_VIDEO_READINESS_REPORT_FILE=
OPC_LIVEKIT_PREFLIGHT_ENV_CHECKLIST_FILE=
OPC_LIVEKIT_PREFLIGHT_REPORT_FILE=
# Server-side DNS/TLS/health/TCP/UDP-send evidence. UDP send is not an ICE/TURN handshake.
OPC_LIVEKIT_SERVER_EVIDENCE_FILE=
OPC_LIVEKIT_SERVER_EVIDENCE_SIGNAL_TLS_PORT=443
OPC_LIVEKIT_SERVER_EVIDENCE_TURN_TLS_PORT=443
OPC_LIVEKIT_SERVER_EVIDENCE_RTC_TCP_PORT=7881
OPC_LIVEKIT_SERVER_EVIDENCE_TURN_UDP_PORT=3478
OPC_LIVEKIT_SERVER_EVIDENCE_RTC_UDP_PORTS=
OPC_LIVEKIT_SERVER_EVIDENCE_TIMEOUT_MS=1500
OPC_LIVEKIT_SERVER_EVIDENCE_MIN_CERT_VALIDITY_DAYS=7
# Initializes a secret-safe handoff bundle. Real evidence files are never fabricated by this command.
OPC_LIVEKIT_ACCEPTANCE_BUNDLE_DIR=
OPC_LIVEKIT_ACCEPTANCE_BUNDLE_TITLE=LiveKit Acceptance Bundle
OPC_LIVEKIT_ACCEPTANCE_RUN_ID=
OPC_LIVEKIT_ACCEPTANCE_STARTED_AT=
OPC_LIVEKIT_ACCEPTANCE_TEMPLATE_FILE=
OPC_LIVEKIT_ACCEPTANCE_RUNBOOK_FILE=
OPC_LIVEKIT_ACCEPTANCE_REPORT_FILE=
OPC_LIVEKIT_ACCEPTANCE_OUTPUT_FILE=
OPC_LIVEKIT_ACCEPTANCE_ENVIRONMENT_ID=
OPC_LIVEKIT_ACCEPTANCE_DEPLOYMENT_MODE=standalone-vm
OPC_LIVEKIT_ACCEPTANCE_DEPLOYED_COMMIT=
OPC_LIVEKIT_ACCEPTANCE_DEPLOYMENT_FINGERPRINT=
OPC_LIVEKIT_ACCEPTANCE_OPERATOR=
OPC_LIVEKIT_ACCEPTANCE_CHECKED_AT=
OPC_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FILE=
OPC_LIVEKIT_ACCEPTANCE_QA_PUBLIC_KEY_FINGERPRINT=
OPC_LIVEKIT_ACCEPTANCE_PREFLIGHT_REPORT_FILE=
OPC_LIVEKIT_ACCEPTANCE_SERVER_EVIDENCE_FILE=
OPC_LIVEKIT_ACCEPTANCE_READINESS_REPORT_FILE=
# Final metadata-only evidence index. It hashes artifacts but never embeds raw reports or tokens.
OPC_LIVEKIT_EVIDENCE_PACK_FILE=
OPC_LIVEKIT_EVIDENCE_TITLE=LiveKit Evidence Pack
OPC_LIVEKIT_EVIDENCE_ENV_CHECKLIST_FILE=
OPC_LIVEKIT_EVIDENCE_PREFLIGHT_REPORT_FILE=
OPC_LIVEKIT_EVIDENCE_SERVER_EVIDENCE_FILE=
