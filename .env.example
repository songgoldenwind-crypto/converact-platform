CONVERACT_RUSTDESK_EDGE_BUSINESS_REF_ID=
CONVERACT_RUSTDESK_EDGE_RUSTDESK_ID=
CONVERACT_RUSTDESK_EDGE_RUSTDESK_ID_FILE=
CONVERACT_RUSTDESK_EDGE_DEVICE_DISPLAY_NAME=
CONVERACT_RUSTDESK_EDGE_ACTOR_IDENTITY=rustdesk-edge-agent
CONVERACT_RUSTDESK_EDGE_INSTANCE_ID=
# Allowed: online or offline. Invalid values fail at startup.
CONVERACT_RUSTDESK_EDGE_RUNTIME_STATUS=online
CONVERACT_RUSTDESK_EDGE_METADATA_JSON=
CONVERACT_RUSTDESK_EDGE_CLIENT_VERSION=
CONVERACT_RUSTDESK_EDGE_OS=
CONVERACT_RUSTDESK_EDGE_HEARTBEAT_INTERVAL_MS=60000
CONVERACT_RUSTDESK_EDGE_COMMAND_POLL_INTERVAL_MS=2000
CONVERACT_RUSTDESK_EDGE_COMMAND_LEASE_MS=40000
CONVERACT_RUSTDESK_EDGE_COMMAND_TIMEOUT_MS=15000
CONVERACT_RUSTDESK_EDGE_DISCONNECT_EXECUTABLE=
CONVERACT_RUSTDESK_EDGE_DISCONNECT_ARGS_JSON=[]
CONVERACT_RUSTDESK_EDGE_RESTART_EXECUTABLE=
CONVERACT_RUSTDESK_EDGE_RESTART_ARGS_JSON=[]
# Durable command result spool. Required when a disconnect/restart adapter is configured.
CONVERACT_RUSTDESK_EDGE_SPOOL_DIR=
CONVERACT_RUSTDESK_EDGE_SPOOL_MAX_BYTES=65536
CONVERACT_RUSTDESK_EDGE_SPOOL_MAX_AGE_MS=604800000
CONVERACT_RUSTDESK_EDGE_SPOOL_MAX_QUARANTINE_RECORDS=100
# Device-side operation inbox and durable upload spool. Configure both or neither.
CONVERACT_RUSTDESK_EDGE_OBSERVATION_INPUT_DIR=
CONVERACT_RUSTDESK_EDGE_OBSERVATION_SPOOL_DIR=
CONVERACT_RUSTDESK_EDGE_OBSERVATION_POLL_INTERVAL_MS=2000
CONVERACT_RUSTDESK_EDGE_OBSERVATION_BATCH_SIZE=20
CONVERACT_RUSTDESK_EDGE_OBSERVATION_RETRY_DELAY_MS=5000
CONVERACT_RUSTDESK_EDGE_OBSERVATION_MAX_ATTEMPTS=10
CONVERACT_RUSTDESK_EDGE_OBSERVATION_MAX_INPUT_BYTES=65536
CONVERACT_RUSTDESK_EDGE_OBSERVATION_MAX_QUARANTINE_RECORDS=100
CONVERACT_RUSTDESK_EDGE_EVIDENCE_INPUT_DIR=
CONVERACT_RUSTDESK_EDGE_EVIDENCE_SPOOL_DIR=
CONVERACT_RUSTDESK_EDGE_EVIDENCE_POLL_INTERVAL_MS=2000
CONVERACT_RUSTDESK_EDGE_EVIDENCE_SINGLE_UPLOAD_MAX_BYTES=67108864
CONVERACT_RUSTDESK_EDGE_EVIDENCE_PART_SIZE_BYTES=8388608
CONVERACT_RUSTDESK_EDGE_EVIDENCE_RETRY_DELAY_MS=5000
CONVERACT_RUSTDESK_EDGE_EVIDENCE_MAX_ATTEMPTS=10
CONVERACT_RUSTDESK_EDGE_EVIDENCE_MAX_FILE_BYTES=10737418240
CONVERACT_RUSTDESK_EDGE_EVIDENCE_MAX_QUARANTINE_RECORDS=100
CONVERACT_RUSTDESK_EDGE_EVIDENCE_MAX_TERMINAL_RECORDS=2000
CONVERACT_RUSTDESK_EDGE_EVIDENCE_DEAD_LETTER_RETENTION_MS=604800000
# Custom RustDesk native producer -> authorization correlator -> evidence watcher.
# Candidate, event, and spool directories must be configured together.
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_CANDIDATE_DIR=
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_EVENT_DIR=
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_SPOOL_DIR=
CONVERACT_RUSTDESK_NATIVE_FILE_ROOTS_JSON=[]
CONVERACT_RUSTDESK_NATIVE_RECORDING_ROOTS_JSON=[]
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_STABLE_MS=2000
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_MAX_EVENT_BYTES=65536
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_MAX_CANDIDATE_BYTES=65536
CONVERACT_RUSTDESK_NATIVE_EVIDENCE_MAX_PENDING_MS=900000
# Local-only wrapper settings. The server cannot override these values.
CONVERACT_RUSTDESK_SESSION_DISCONNECT_HOOK=
CONVERACT_RUSTDESK_SERVICE_NAME=
CONVERACT_RUSTDESK_LAUNCHD_LABEL=
CONVERACT_RUSTDESK_EDGE_ONCE=0
CONVERACT_RUSTDESK_EDGE_OFFLINE_ON_EXIT=1
# RustDesk handoff pack. Generates a no-network Markdown runbook for deployment/LED/QA.
CONVERACT_RUSTDESK_HANDOFF_FILE=
CONVERACT_RUSTDESK_HANDOFF_TITLE=RustDesk Integration Handoff
CONVERACT_RUSTDESK_HANDOFF_AUDIENCE=OPC, LED, deployment, and QA teams
# RustDesk deployment command runbook. Generates Docker Compose or K8s commands without executing them.
CONVERACT_RUSTDESK_DEPLOYMENT_COMMANDS_FILE=
CONVERACT_RUSTDESK_DEPLOYMENT_MODE=compose
CONVERACT_RUSTDESK_DEPLOYMENT_COMPOSE_FILE=docker-compose.callcenter.yml
CONVERACT_RUSTDESK_DEPLOYMENT_K8S_NAMESPACE=opc
CONVERACT_RUSTDESK_DEPLOYMENT_HELM_RELEASE=opc
CONVERACT_RUSTDESK_DEPLOYMENT_HELM_CHART=infra/k8s
CONVERACT_RUSTDESK_DEPLOYMENT_HELM_VALUES_FILE=
CONVERACT_RUSTDESK_DEPLOYMENT_OPC_DEPLOYMENT=opc-opc
CONVERACT_RUSTDESK_DEPLOYMENT_RUSTDESK_DEPLOYMENT=opc-rustdesk
# RustDesk acceptance bundle. Generates handoff artifacts into one directory without network access.
CONVERACT_RUSTDESK_ACCEPTANCE_BUNDLE_DIR=
CONVERACT_RUSTDESK_ACCEPTANCE_BUNDLE_TITLE=RustDesk Acceptance Bundle
