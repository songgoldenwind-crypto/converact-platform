CONVERACT_FABRIC_VOICE_ACCEPTANCE_DEPLOYMENT_MODE=standalone-compose
CONVERACT_FABRIC_VOICE_ACCEPTANCE_DEPLOYED_COMMIT=
CONVERACT_FABRIC_VOICE_ACCEPTANCE_DEPLOYMENT_FINGERPRINT=
CONVERACT_FABRIC_VOICE_ACCEPTANCE_OPERATOR=
CONVERACT_FABRIC_VOICE_ACCEPTANCE_QA_APPROVER=
CONVERACT_FABRIC_VOICE_ACCEPTANCE_RUN_STARTED_AT=
CONVERACT_FABRIC_VOICE_ACCEPTANCE_CHECKED_AT=

# AI Agent — LLM dual-stack (primary 27B + DeepSeek fallback)
# Primary — Qwen3.6-27B（必须同时设置 KEY + URL）
LLM_API_KEY=Qwen3.6-27B
LLM_BASE_URL=http://localhost:9997/v1
LLM_MODEL=Qwen3.6-27B
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_FALLBACK_PROVIDERS=deepseek

# Fallback — DeepSeek（27B 传输失败时）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# AI Agent — cloud speech fallbacks (optional if using self-hosted below)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# AI Agent — self-hosted Chinese speech (Mac host, see services/speech-host/README.md)
SPEECH_ASR_PROVIDER=funasr
SPEECH_ASR_FALLBACK_PROVIDERS=deepgram,openai
SPEECH_TTS_PROVIDER=cosyvoice
SPEECH_TTS_FALLBACK_PROVIDERS=cartesia,openai
FUNASR_URL=http://127.0.0.1:8899
COSYVOICE_URL=http://127.0.0.1:50000
AI_AGENT_STT_ATTEMPT_TIMEOUT_MS=2000
AI_AGENT_LLM_ATTEMPT_TIMEOUT_MS=1200
AI_AGENT_TTS_ATTEMPT_TIMEOUT_MS=1500
AI_AGENT_MAX_UNRECOVERABLE_PROVIDER_ERRORS=3
AI_AGENT_PROMETHEUS_PORT=9090
AI_AGENT_VOICE_METRICS_UDP_HOST=127.0.0.1
AI_AGENT_VOICE_METRICS_UDP_PORT=9125
COSYVOICE_SPK_ID=中文女

# ===== Stripe Billing =====
# Leave empty to use mock checkout URLs (dev/test).
# Production: create products in Stripe Dashboard, copy price IDs here.
# See docs/billing/stripe-setup.md for step-by-step guide.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ===== Dialer =====
CONVERACT_DISABLE_DIALER=0
CONVERACT_DIALER_INTERVAL_MS=3000
CONVERACT_DIALER_IGNORE_WINDOW=0
CONVERACT_DIALER_AGENT_JOIN_TIMEOUT_MS=10000
CONVERACT_DIALER_ANSWER_TIMEOUT_MS=30000
CONVERACT_DIALER_CUSTOMER_JOIN_TIMEOUT_MS=120000
MAX_CONCURRENT_OUTBOUND=20
MAX_CONCURRENT_OUTBOUND_PER_TENANT=5
RUSTPBX_DEFAULT_TRUNK=twilio-japan
CUSTOMER_H5_BASE_URL=http://localhost:5173
SMS_PROVIDER=log

# 可选：JSON 覆盖默认 registry.channels（不含密钥）
# CONVERACT_PROSPECT_OUTREACH_CHANNEL_PROVIDER_REGISTRY_JSON={"channels":{"wechat":{"provider":"opc-wechat-http"}}}
