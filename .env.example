CONVERACT_RUSTDESK_WINDOWS_WINSW_SHA256=
# RustDesk device-side edge agent. Run on the customer/LED device with `npm run rustdesk:edge-agent`.
CONVERACT_RUSTDESK_EDGE_BASE_URL=
# Preferred Windows companion credential. Do not combine with legacy API/command credentials.
CONVERACT_RUSTDESK_EDGE_DEVICE_TOKEN_FILE=
CONVERACT_RUSTDESK_EDGE_API_KEY=
CONVERACT_RUSTDESK_EDGE_COMMAND_TOKEN=
CONVERACT_RUSTDESK_EDGE_COMMAND_TOKEN_FILE=
CONVERACT_RUSTDESK_EDGE_TENANT_ID=
