OPC_MEDIA_SMOKE_TENANT_ID=tenant_demo
OPC_MEDIA_SMOKE_ROOM_NAME=opc-media-smoke
OPC_MEDIA_SMOKE_REQUIRE_CONFIGURED_LIVEKIT=0
OPC_MEDIA_SMOKE_VERIFY_RECORDING_OBJECT=0
OPC_MEDIA_SMOKE_RECORDING_OBJECT_TIMEOUT_MS=60000
OPC_MEDIA_SMOKE_RECORDING_OBJECT_POLL_INTERVAL_MS=2000
# Set automatically by smoke:media:readiness when customer-browser consumes the media smoke link.
OPC_MEDIA_SMOKE_KEEP_ROOM_OPEN=0
# AI avatar LiveKit publication smoke/readiness.
OPC_AVATAR_SMOKE_ROOM_NAME=opc-avatar-smoke
OPC_AVATAR_SMOKE_IDENTITY=opc-avatar-smoke-bot
OPC_AVATAR_SMOKE_SAMPLE_CHUNKS=3
OPC_AVATAR_SMOKE_SETTLE_SECONDS=0.5
# AI agent -> OPC business callback smoke/readiness.
OPC_AI_CALLBACK_SMOKE_TENANT_ID=tenant_demo
OPC_AI_CALLBACK_SMOKE_ROOM_NAME=opc-ai-callback-smoke
# Agent browser smoke/readiness. Fill tokens from two real signed-in agents before running it.
OPC_BROWSER_SMOKE_TENANT_ID=tenant_demo
OPC_BROWSER_SMOKE_AGENT_A_TOKEN=
OPC_BROWSER_SMOKE_AGENT_A_USER_ID=agent_a
