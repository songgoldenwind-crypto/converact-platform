OPC_BROWSER_SMOKE_HEADLESS=1
OPC_BROWSER_SMOKE_SCREEN_SHARE=0
OPC_BROWSER_SMOKE_TIMEOUT_MS=30000
# Customer H5 browser smoke. You can provide OPC_CUSTOMER_VIDEO_URL or OPC_CUSTOMER_BROWSER_SMOKE_URL instead.
OPC_CUSTOMER_VIDEO_URL=
OPC_CUSTOMER_BROWSER_SMOKE_URL=
