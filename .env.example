CONVERACT_RUSTDESK_EDGE_TOKEN_OUTPUT_FILE=
CONVERACT_RUSTDESK_DEVICE_ONLINE_TTL_MS=300000
CONVERACT_RUSTDESK_CHECK_DEVICE_ONLINE=0
CONVERACT_RUSTDESK_CHECK_OPERATION_AUDIT=1
CONVERACT_RUSTDESK_API_TOKEN=
CONVERACT_RUSTDESK_CHECK_SERVER_PORTS=0
CONVERACT_RUSTDESK_CHECK_HOST=
CONVERACT_RUSTDESK_CHECK_TCP_PORTS=21115,21116,21117,21118,21119
CONVERACT_RUSTDESK_CHECK_UDP_PORTS=21116
CONVERACT_RUSTDESK_CHECK_TIMEOUT_MS=1500
CONVERACT_RUSTDESK_READINESS_CHECK_DEVICE_ONLINE=1
CONVERACT_RUSTDESK_READINESS_CHECK_OPERATION_AUDIT=1
CONVERACT_RUSTDESK_READINESS_CHECK_SERVER_PORTS=1
CONVERACT_RUSTDESK_READINESS_REQUIRE_PROTOCOL_URL=1
CONVERACT_RUSTDESK_READINESS_CHECK_LAUNCH_URL=1
CONVERACT_RUSTDESK_READINESS_REQUIRE_HTTPS_LAUNCH_URL=0
CONVERACT_RUSTDESK_READINESS_CHECK_PHYSICAL_DISCONNECT=0
CONVERACT_RUSTDESK_SERVER_EVIDENCE_FILE=
CONVERACT_RUSTDESK_SERVER_EVIDENCE_HBBS_TCP_PORTS=21115,21116,21118
CONVERACT_RUSTDESK_SERVER_EVIDENCE_HBBR_TCP_PORTS=21117,21119
CONVERACT_RUSTDESK_SERVER_EVIDENCE_UDP_PORTS=21116
CONVERACT_RUSTDESK_SERVER_EVIDENCE_TIMEOUT_MS=1500
# RustDesk client install/config handoff. Pulls iveKit client-config and optional launch plan.
CONVERACT_RUSTDESK_CLIENT_CONFIG_PACK_FILE=
CONVERACT_RUSTDESK_CLIENT_CONFIG_PACK_TITLE=RustDesk Client Config Pack
CONVERACT_RUSTDESK_CLIENT_CONFIG_BASE_URL=
CONVERACT_RUSTDESK_CLIENT_CONFIG_API_KEY=
CONVERACT_RUSTDESK_CLIENT_CONFIG_TENANT_ID=
CONVERACT_RUSTDESK_CLIENT_CONFIG_USER_ID=
CONVERACT_RUSTDESK_CLIENT_CONFIG_EXTERNAL_ID=
CONVERACT_RUSTDESK_CLIENT_CONFIG_TARGET_RUSTDESK_ID=
# Pinned RustDesk client distribution metadata. JSON only; no downloader or installer is invoked.
CONVERACT_RUSTDESK_CLIENT_ARTIFACTS_JSON=
CONVERACT_RUSTDESK_CLIENT_VERSION=1.4.9
CONVERACT_RUSTDESK_CLIENT_PROFILE_TTL_SECONDS=900
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_FILE=
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_TITLE=RustDesk Client Distribution Profile
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_BASE_URL=
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_API_KEY=
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_TENANT_ID=
CONVERACT_RUSTDESK_CLIENT_PROFILE_PACK_USER_ID=
CONVERACT_RUSTDESK_CLIENT_PROFILE_EXPECTED_SERVER_VERSION=1.1.16
CONVERACT_RUSTDESK_CLIENT_PROFILE_EXPECTED_FINGERPRINT=
# Fixed-version Windows x64 package. Generate the profile above first, then run
# `npm run rustdesk:windows-package`. The package contains no device token.
CONVERACT_RUSTDESK_WINDOWS_PACKAGE_DIR=
CONVERACT_RUSTDESK_WINDOWS_PROFILE_FILE=
CONVERACT_RUSTDESK_WINDOWS_NETWORK_CONFIG_FILE=
CONVERACT_RUSTDESK_WINDOWS_SOURCE_COMMIT=
