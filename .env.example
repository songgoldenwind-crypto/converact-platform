OPC_WEB_ASSIST_BROWSER_SMOKE_HEADLESS=1
OPC_WEB_ASSIST_BROWSER_SMOKE_TIMEOUT_MS=30000
# Collaboration / remote assistance smoke.
OPC_COLLAB_SMOKE_TENANT_ID=tenant_demo
