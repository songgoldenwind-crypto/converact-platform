{
  "name": "opc-growth-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:ivekit": "tsx src/ivekit-server.ts",
    "test:ivekit:foundation": "node --import tsx --test test/ivekit-standalone-http.test.ts test/ivekit-media-hooks.test.ts test/ivekit-application.test.ts test/ivekit-server-entrypoint.test.ts test/ivekit-sdk-package.test.ts test/livekit-standalone-deployment.test.ts",
    "test:ivekit:delivery": "node --import tsx --test test/ivekit-delivery-bundle.test.ts",
    "test:ivekit:standalone-context": "node --import tsx --test test/ivekit-standalone-source-graph.test.ts test/ivekit-standalone-build-context.test.ts",
    "build:ivekit-sdk": "npm --prefix sdk/ivekit run build",
    "pack:ivekit-sdk": "npm pack ./sdk/ivekit --dry-run",
    "ivekit:delivery-bundle": "tsx scripts/ivekit-delivery-bundle.ts",
    "ivekit:standalone:graph": "node --import tsx scripts/ivekit-standalone-source-graph.ts",
    "ivekit:standalone:context": "node --import tsx scripts/ivekit-standalone-build-context.ts",
    "verify:ivekit:standalone-context": "node --import tsx scripts/verify-ivekit-standalone-context.ts",
    "verify:ivekit:foundation": "npm run test:ivekit:foundation && npm run build:ivekit-sdk && npm run pack:ivekit-sdk",
    "test:e2e:ivekit": "npm --prefix clients/ivekit-reference run test:e2e",
    "test:e2e:ivekit-im": "npm --prefix clients/ivekit-reference run test:e2e -- e2e/chat.spec.ts",
    "test:e2e:ivekit-media": "npm --prefix clients/ivekit-reference run test:e2e -- e2e/media.spec.ts",
    "test:e2e:ivekit-rustdesk": "npm --prefix clients/ivekit-reference run test:e2e -- e2e/rustdesk.spec.ts",
    "ivekit:im-client-acceptance": "tsx scripts/ivekit-im-client-acceptance.ts",
    "verify:ivekit:im-client": "npm --prefix clients/ivekit-reference test && npm --prefix clients/ivekit-reference run build && node --import tsx --test test/ivekit-im-client-acceptance.test.ts",
    "verify:ivekit:media-client": "npm --prefix clients/ivekit-reference test && npm --prefix clients/ivekit-reference run build && npm run test:e2e:ivekit-media && node --import tsx --test test/livekit-client-acceptance.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:fast": "node --import tsx --test test/business-tool-registration.test.ts test/harness.test.ts test/dag-engine.test.ts test/sprint8-campaign.test.ts test/sprint9-omni.test.ts test/sprint10-platform.test.ts test/sprint11-compliance.test.ts test/sprint12-differentiation.test.ts test/db-pg-tenant.test.ts test/db-rls-integration.test.ts test/ivr-real-io-integration.test.ts test/ivr-transfer-production-bridge.test.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run check:sidecars",
    "dev:provider-gateway": "cd services/provider-gateway-go && go run .",
    "build:provider-gateway": "tsx scripts/check-sidecars.ts provider-gateway",
    "dev:ai-worker": "python3 services/ai-worker-py/server.py",
    "check:ai-worker": "tsx scripts/check-sidecars.ts ai-worker",
    "dev:voice-media": "cargo run --manifest-path services/voice-media-rs/Cargo.toml",
    "check:voice-media": "tsx scripts/check-sidecars.ts voice-media",
    "check:sidecars": "node --import tsx scripts/check-sidecars.ts all",
    "render:media-configs": "node --import tsx scripts/render-media-configs.ts",
    "render:livekit-edge": "node --import tsx scripts/render-media-configs.ts --edge",
    "livekit:edge:config": "docker compose --env-file infra/livekit/env.example -f infra/livekit/docker-compose.yml config",
    "livekit:edge:storage:config": "docker compose --env-file infra/livekit/env.example -f infra/livekit/docker-compose.yml -f infra/livekit/docker-compose.storage.yml config",
    "db:migrate": "node --import tsx scripts/run-postgres-migrations.ts",
    "dev:callcenter": "COMPOSE_DISABLE_ENV_FILE=1 docker compose --env-file .env.example -f docker-compose.callcenter.yml up",
    "dev:callcenter:detach": "COMPOSE_DISABLE_ENV_FILE=1 docker compose --env-file .env.example -f docker-compose.callcenter.yml up -d",
    "test:phase0": "node --import tsx --test test/call-center-phase0.test.ts test/call-center-phase0-http.test.ts test/rwi-client.test.ts",
    "test:phase1": "node --import tsx --test test/outbound-dialer.test.ts test/call-center-phase1-http.test.ts test/call-center-voice-agent-spec.test.ts test/call-center-voice-agent-generate-http.test.ts test/voice-agent-spec-generator.test.ts test/voice-agent-navigation.test.ts test/voice-agent-navigation-session.test.ts test/call-center-voice-agent-navigation-http.test.ts test/call-center-intent-navigation-flow.test.ts test/call-center-phase0.test.ts test/rwi-client.test.ts",
    "test:ai-agent": "bash scripts/test-ai-agent.sh",
    "smoke:media": "tsx scripts/livekit-media-smoke.ts",
    "smoke:media:browser": "tsx scripts/livekit-browser-smoke.ts",
    "smoke:media:customer-browser": "tsx scripts/livekit-customer-browser-smoke.ts",
    "smoke:media:web-assist-browser": "tsx scripts/web-assist-browser-smoke.ts",
    "smoke:media:avatar": "python3 services/ai-agent-py/scripts/avatar_livekit_smoke.py",
    "smoke:media:ai-callback": "tsx scripts/ai-agent-opc-callback-smoke.ts",
    "smoke:media:sip-volte": "tsx scripts/sip-volte-readiness.ts",
    "smoke:media:readiness": "tsx scripts/video-readiness-suite.ts",
    "livekit:deployment-preflight": "tsx scripts/livekit-deployment-preflight.ts",
    "livekit:server-evidence": "tsx scripts/livekit-server-evidence.ts",
    "livekit:client-acceptance": "tsx scripts/livekit-client-acceptance.ts",
    "livekit:evidence-pack": "tsx scripts/livekit-evidence-pack.ts",
    "livekit:acceptance-bundle": "tsx scripts/livekit-acceptance-bundle.ts",
    "smoke:collaboration": "node --import tsx scripts/collaboration-smoke.ts",
    "smoke:chat:tinode": "tsx scripts/tinode-chat-smoke.ts",
    "tinode:deployment-preflight": "tsx scripts/tinode-deployment-preflight.ts",
    "attachment:deployment-preflight": "tsx scripts/attachment-processing-preflight.ts",
    "quality:deployment-preflight": "tsx scripts/quality-review-preflight.ts",
    "ivekit:intelligence-preflight": "tsx scripts/ivekit-intelligence-preflight.ts",
    "ivekit:controlled-provider": "tsx scripts/ivekit-controlled-provider.ts",
    "ivekit:led-example": "tsx scripts/ivekit-led-integration-example.ts",
    "smoke:remote-gateway": "tsx scripts/remote-gateway-smoke.ts",
    "rustdesk:edge-agent": "tsx scripts/rustdesk-edge-agent.ts",
    "rustdesk:edge-token": "tsx scripts/rustdesk-edge-token.ts",
    "rustdesk:event-forwarder": "tsx scripts/rustdesk-event-forwarder.ts",
    "rustdesk:operation-observer": "tsx scripts/rustdesk-operation-observer.ts",
    "rustdesk:ivekit-smoke": "tsx scripts/rustdesk-ivekit-smoke.ts",
    "rustdesk:led-example": "tsx scripts/ivekit-rustdesk-led-example.ts",
    "rustdesk:acceptance-bundle": "tsx scripts/rustdesk-acceptance-bundle.ts",
    "rustdesk:audit-export": "tsx scripts/rustdesk-audit-export.ts",
    "rustdesk:audit-coverage": "tsx scripts/rustdesk-audit-coverage.ts",
    "rustdesk:client-config-pack": "tsx scripts/rustdesk-client-config-pack.ts",
    "rustdesk:client-profile-pack": "tsx scripts/rustdesk-client-profile-pack.ts",
    "rustdesk:client-acceptance": "tsx scripts/rustdesk-client-acceptance.ts",
    "rustdesk:deployment-commands": "tsx scripts/rustdesk-deployment-commands.ts",
    "rustdesk:deployment-preflight": "tsx scripts/rustdesk-deployment-preflight.ts",
    "rustdesk:evidence-pack": "tsx scripts/rustdesk-evidence-pack.ts",
    "rustdesk:handoff-pack": "tsx scripts/rustdesk-handoff-pack.ts",
    "rustdesk:readiness": "tsx scripts/rustdesk-readiness.ts",
    "rustdesk:server-evidence": "tsx scripts/rustdesk-server-evidence.ts",
    "test:callcenter": "npm run typecheck && npm run test:phase1 && npm run test:ai-agent",
    "test:call-center-s8-s9": "OPC_USE_MEMORY_REDIS=1 node --import tsx --test test/sprint8-campaign.test.ts test/sprint9-omni.test.ts test/integration-gaps.test.ts test/gap-completion.test.ts",
    "test:call-center-s10": "OPC_USE_MEMORY_REDIS=1 node --import tsx --test test/sprint10-platform.test.ts",
    "test:call-center-s11": "OPC_USE_MEMORY_REDIS=1 node --import tsx --test test/sprint11-compliance.test.ts",
    "test:call-center-s12": "OPC_USE_MEMORY_REDIS=1 node --import tsx --test test/sprint12-differentiation.test.ts",
    "test:phase3-platform": "OPC_USE_MEMORY_REDIS=1 node --import tsx --test test/phase3-platform.test.ts"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.15.4",
    "nats": "^2.29.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "stripe": "^22.2.2",
    "ws": "^8.21.0"
  }
