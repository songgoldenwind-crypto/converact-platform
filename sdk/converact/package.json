{
  "name": "@converact/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for iveKit media, IM, remote assistance, Voice, and IVR capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sip-webphone": {
      "types": "./dist/sip-webphone.d.ts",
      "import": "./dist/sip-webphone.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sip.js": "^0.21.2"
  }
}
