{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.local/schemas/server-runtime-migration-contract-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_id",
    "version",
    "frozen_at",
    "source",
    "target",
    "allowed_non_rust",
    "cell",
    "migration_state_machine",
    "hard_invariants",
    "completion",
    "repository_runtime_implementation_authorized",
    "running_server_change_authorized",
    "performance_claim_authorized",
    "production_eligible"
  ],
  "properties": {
    "$schema": { "const": "./server-runtime-migration-contract-v1.schema.json" },
    "contract_id": { "const": "CONVERACT-RUST-SERVER-RUNTIME-MIGRATION-V1" },
    "version": { "const": 1 },
    "frozen_at": { "const": "2026-08-14" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "canonical_root", "branch", "baseline_commit"],
      "properties": {
        "repository": { "const": "songgoldenwind-crypto/opc-platform" },
        "canonical_root": { "const": "/Users/songjinfeng/Projects/converact-worktrees/platform" },
        "branch": { "const": "codex/converact-platform-rename" },
        "baseline_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_online_runtime_language", "architecture", "workspace", "migration", "writer_policy", "cross_region_policy", "performance_policy"],
      "properties": {
        "owned_online_runtime_language": { "const": "rust" },
        "architecture": { "const": "multi_region_cell_based" },
        "workspace": { "const": "one_cargo_workspace_multiple_fault_isolated_binaries" },
        "migration": { "const": "vertical_authority_slices" },
        "writer_policy": { "const": "one_cell_one_owner_generation_one_writer" },
        "cross_region_policy": { "const": "asynchronous_projection_no_synchronous_hot_path_dependency" },
        "performance_policy": { "const": "functional_closure_first_structural_boundedness_always_final_capacity_later" }
      }
    },
    "allowed_non_rust": { "$ref": "#/$defs/stringArrays" },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_fields", "resource_pools", "global_hot_path_dependency", "synchronous_cross_region_database", "active_multi_writer"],
      "properties": {
        "identity_fields": { "$ref": "#/$defs/nonEmptyStrings" },
        "resource_pools": { "$ref": "#/$defs/nonEmptyStrings" },
        "global_hot_path_dependency": { "const": "forbidden" },
        "synchronous_cross_region_database": { "const": "forbidden" },
        "active_multi_writer": { "const": "forbidden" }
      }
    },
    "migration_state_machine": {
      "const": ["inventory", "contract_frozen", "rust_shadow_read", "rust_pure_replay_equal", "prepare_writer_fence", "commit_new_generation", "route_new_work_to_rust", "drain_typescript_generation", "reconcile_unknown", "active_zero", "delete_typescript_runtime", "retire_compatibility_schema"]
    },
    "hard_invariants": { "$ref": "#/$defs/nonEmptyStrings" },
    "completion": { "$ref": "#/$defs/nonEmptyStrings" },
    "repository_runtime_implementation_authorized": { "const": true },
    "running_server_change_authorized": { "const": false },
    "performance_claim_authorized": { "const": false },
    "production_eligible": { "const": false }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "stringArrays": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonEmptyStrings" },
      "minProperties": 1
    }
  }
}
