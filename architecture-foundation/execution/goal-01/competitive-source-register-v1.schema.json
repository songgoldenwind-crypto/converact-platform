{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.example/contracts/g01/competitive-source-register-v1.schema.json",
  "title": "G01 Competitive Source and Claim Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "register_id", "version", "generated_at", "fact_policy", "sources", "claims"],
  "properties": {
    "$schema": { "const": "./competitive-source-register-v1.schema.json" },
    "register_id": { "const": "g01-competitive-source-register-v1" },
    "version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "pattern": "^2026-08-01T" },
    "fact_policy": { "type": "string", "minLength": 40 },
    "sources": {
      "type": "array",
      "minItems": 14,
      "items": { "$ref": "#/$defs/source" }
    },
    "claims": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "subject", "url", "source_tier", "captured_at", "reviewed_sections", "usage_limit", "used_as_converact_performance_evidence"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC:[A-Z0-9_:]+$" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": "string", "pattern": "^https://" },
        "source_tier": { "const": "official_primary" },
        "captured_at": { "type": "string", "pattern": "^2026-08-01T" },
        "reviewed_sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "usage_limit": { "type": "string", "minLength": 20 },
        "used_as_converact_performance_evidence": { "const": false },
        "repository_url": { "type": "string", "pattern": "^https://github.com/" },
        "immutable_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "declared_license": { "type": "string", "minLength": 1 },
        "license_body_status": { "enum": ["present_at_revision", "missing_at_revision", "not_applicable", "not_run"] },
        "source_hash_status": { "enum": ["verified", "not_run"] },
        "integration_status": { "enum": ["verified", "not_run"] },
        "performance_status": { "enum": ["verified", "not_run"] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "layer", "subject", "claim_type", "statement", "source_ids", "inference_basis", "proven", "status", "required_evidence", "usage_limit"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^CLAIM:[A-Z0-9_:]+$" },
        "layer": { "enum": ["platform_market", "resolve_market", "component"] },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "claim_type": { "enum": ["public_fact", "converact_inference", "converact_test_requirement"] },
        "statement": { "type": "string", "minLength": 20 },
        "source_ids": { "$ref": "#/$defs/stringArray" },
        "inference_basis": { "type": "string" },
        "proven": { "type": "boolean" },
        "status": { "enum": ["publicly_documented", "not_run"] },
        "required_evidence": { "$ref": "#/$defs/stringArray" },
        "usage_limit": { "type": "string", "minLength": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "claim_type": { "const": "public_fact" } }, "required": ["claim_type"] },
          "then": {
            "properties": {
              "source_ids": { "type": "array", "minItems": 1 },
              "proven": { "const": true },
              "status": { "const": "publicly_documented" }
            }
          }
        },
        {
          "if": { "properties": { "claim_type": { "const": "converact_inference" } }, "required": ["claim_type"] },
          "then": {
            "properties": {
              "inference_basis": { "type": "string", "minLength": 20 },
              "proven": { "const": false },
              "status": { "const": "not_run" }
            }
          }
        },
        {
          "if": { "properties": { "claim_type": { "const": "converact_test_requirement" } }, "required": ["claim_type"] },
          "then": {
            "properties": {
              "source_ids": { "type": "array", "maxItems": 0 },
              "proven": { "const": false },
              "status": { "const": "not_run" },
              "required_evidence": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
