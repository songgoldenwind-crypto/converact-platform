{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.example/contracts/g01/interview-and-demand-evidence-register.schema.json",
  "title": "Resolve Interview and Demand Evidence Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "register_id", "version", "generated_at", "scope", "synthetic_data_allowed", "privacy_contract", "qualification_thresholds", "interviews", "paid_commitments", "summary", "market_gate"],
  "properties": {
    "$schema": { "const": "./interview-and-demand-evidence-register.schema.json" },
    "register_id": { "const": "resolve-market-evidence-v1" },
    "version": { "const": "1.0.0" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "offer_id", "product_family_id", "flow_id", "flow_version", "icp", "same_flow_required"],
      "properties": {
        "profile_id": { "const": "converact-resolve-v1" },
        "offer_id": { "const": "resolve-assist-pilot-a-b1-v1" },
        "product_family_id": { "const": "led-display-system-v1" },
        "flow_id": { "const": "remote-installation-commissioning-v1" },
        "flow_version": { "const": "1.0.0" },
        "icp": { "type": "string", "minLength": 20 },
        "same_flow_required": { "const": true }
      }
    },
    "synthetic_data_allowed": { "const": false },
    "privacy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_content", "controlled_store_required", "prohibited_in_git", "integrity"],
      "properties": {
        "git_content": { "type": "string", "minLength": 20 },
        "controlled_store_required": { "const": true },
        "prohibited_in_git": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "integrity": { "type": "string", "minLength": 20 }
      }
    },
    "qualification_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualifying_interviews", "signed_usd_20000_pilots", "additional_time_bound_paid_commitments", "distinct_organizations"],
      "properties": {
        "qualifying_interviews": { "const": 20 },
        "signed_usd_20000_pilots": { "const": 1 },
        "additional_time_bound_paid_commitments": { "const": 2 },
        "distinct_organizations": { "const": 3 }
      }
    },
    "interviews": { "type": "array", "items": { "$ref": "#/$defs/interview" } },
    "paid_commitments": { "type": "array", "items": { "$ref": "#/$defs/commitment" } },
    "summary": { "$ref": "#/$defs/summary" },
    "market_gate": { "$ref": "#/$defs/marketGate" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^20(?:(?:00|0[48]|[2468][048]|[13579][26])-02-29|[0-9]{2}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$" },
    "controlledUri": { "type": "string", "pattern": "^controlled://[A-Za-z0-9._~/-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "organizationPseudonym": { "type": "string", "pattern": "^ORG-[A-Z0-9]{4,}$" },
    "intervieweePseudonym": { "type": "string", "pattern": "^SUBJ-[A-Z0-9]{4,}$" },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REV-[A-Z0-9]+$" }
    },
    "interview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "organization_pseudonym", "interviewee_pseudonym", "role_class", "interviewed_at", "controlled_uri", "sha256", "product_family_id", "flow_id", "flow_version", "value_pool_observed", "budget_observed", "data_availability_observed", "reviewer_pseudonyms", "review_status"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^INT:[A-Z0-9_-]+$" },
        "organization_pseudonym": { "$ref": "#/$defs/organizationPseudonym" },
        "interviewee_pseudonym": { "$ref": "#/$defs/intervieweePseudonym" },
        "role_class": { "enum": ["budget_owner", "champion"] },
        "interviewed_at": { "$ref": "#/$defs/timestamp" },
        "controlled_uri": { "$ref": "#/$defs/controlledUri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "product_family_id": { "const": "led-display-system-v1" },
        "flow_id": { "const": "remote-installation-commissioning-v1" },
        "flow_version": { "const": "1.0.0" },
        "value_pool_observed": { "type": "boolean" },
        "budget_observed": { "type": "boolean" },
        "data_availability_observed": { "type": "boolean" },
        "reviewer_pseudonyms": { "$ref": "#/$defs/reviewers" },
        "review_status": { "enum": ["pending", "qualified", "rejected", "disputed"] }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "organization_pseudonym", "linked_interview_evidence_ids", "commitment_type", "offer_id", "product_family_id", "flow_id", "flow_version", "amount_usd", "currency", "payment_percentages", "scope_milestones", "written_commitment", "signed", "written_at", "expires_at", "controlled_uri", "sha256", "same_flow", "value_pool_observed", "budget_observed", "data_availability_observed", "reviewer_pseudonyms", "review_status"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^COM:[A-Z0-9_-]+$" },
        "organization_pseudonym": { "$ref": "#/$defs/organizationPseudonym" },
        "linked_interview_evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^INT:[A-Z0-9_-]+$" } },
        "commitment_type": { "enum": ["signed_pilot_contract", "time_bound_paid_commitment"] },
        "offer_id": { "const": "resolve-assist-pilot-a-b1-v1" },
        "product_family_id": { "const": "led-display-system-v1" },
        "flow_id": { "const": "remote-installation-commissioning-v1" },
        "flow_version": { "const": "1.0.0" },
        "amount_usd": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "const": "USD" },
        "payment_percentages": {
          "type": "array",
          "prefixItems": [{ "const": 50 }, { "const": 25 }, { "const": 25 }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "scope_milestones": {
          "type": "array",
          "prefixItems": [{ "const": "A" }, { "const": "B1" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "written_commitment": { "const": true },
        "signed": { "type": "boolean" },
        "written_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "controlled_uri": { "$ref": "#/$defs/controlledUri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "same_flow": { "const": true },
        "value_pool_observed": { "type": "boolean" },
        "budget_observed": { "type": "boolean" },
        "data_availability_observed": { "type": "boolean" },
        "reviewer_pseudonyms": { "$ref": "#/$defs/reviewers" },
        "review_status": { "enum": ["pending", "qualified", "rejected", "expired", "disputed"] }
      },
      "allOf": [
        {
          "if": { "properties": { "commitment_type": { "const": "signed_pilot_contract" } }, "required": ["commitment_type"] },
          "then": { "properties": { "amount_usd": { "const": 20000 }, "signed": { "const": true } } }
        },
        {
          "if": { "properties": { "review_status": { "const": "qualified" } }, "required": ["review_status"] },
          "then": {
            "properties": {
              "same_flow": { "const": true },
              "value_pool_observed": { "const": true },
              "budget_observed": { "const": true },
              "data_availability_observed": { "const": true }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualifying_interviews", "distinct_interview_organizations", "signed_usd_20000_pilots", "time_bound_paid_commitments", "distinct_paid_organizations", "same_flow_organizations", "auditable_value_pool_organizations", "auditable_budget_organizations", "auditable_data_availability_organizations"],
      "properties": {
        "qualifying_interviews": { "$ref": "#/$defs/count" },
        "distinct_interview_organizations": { "$ref": "#/$defs/count" },
        "signed_usd_20000_pilots": { "$ref": "#/$defs/count" },
        "time_bound_paid_commitments": { "$ref": "#/$defs/count" },
        "distinct_paid_organizations": { "$ref": "#/$defs/count" },
        "same_flow_organizations": { "$ref": "#/$defs/count" },
        "auditable_value_pool_organizations": { "$ref": "#/$defs/count" },
        "auditable_budget_organizations": { "$ref": "#/$defs/count" },
        "auditable_data_availability_organizations": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "marketGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_satisfied", "satisfied", "missing", "permitted_next_actions", "forbidden_unlocks"],
      "properties": {
        "status": { "enum": ["not_run", "candidate_qualified"] },
        "candidate_satisfied": { "type": "boolean" },
        "satisfied": { "const": false },
        "missing": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "permitted_next_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "forbidden_unlocks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "allOf": [
        {
          "if": { "properties": { "candidate_satisfied": { "const": true } }, "required": ["candidate_satisfied"] },
          "then": {
            "properties": {
              "status": { "const": "candidate_qualified" },
              "satisfied": { "const": false },
              "missing": { "type": "array", "minItems": 1 },
              "permitted_next_actions": { "type": "array", "minItems": 1 },
              "forbidden_unlocks": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "status": { "const": "not_run" },
              "satisfied": { "const": false },
              "missing": { "type": "array", "minItems": 1 },
              "permitted_next_actions": { "type": "array", "minItems": 1 },
              "forbidden_unlocks": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
