+    use std::sync::Arc;
+
+    let timer = Arc::new(Timer::new());
+    timer.timeout(Duration::from_secs(5), "head");
+    tokio::time::timeout(Duration::from_millis(50), timer.notify.notified())
+        .await
+        .expect("consume initial head notification");
+
+    let worker = Arc::clone(&timer);
+    let mut wait_handle = tokio::spawn(async move { worker.wait_for_ready().await });
+    tokio::task::yield_now().await;
+
+    timer.timeout(Duration::from_secs(10), "non-head");
+    assert!(
+        tokio::time::timeout(Duration::from_millis(30), &mut wait_handle)
+            .await
+            .is_err(),
