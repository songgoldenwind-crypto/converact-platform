+    );
+
+    timer.timeout(Duration::from_millis(20), "earlier");
+    let ready = tokio::time::timeout(Duration::from_secs(1), wait_handle)
+        .await
+        .expect("earlier deadline did not wake timer worker")
+        .expect("timer worker panicked");
+    assert_eq!(ready, vec!["earlier"]);
+}
