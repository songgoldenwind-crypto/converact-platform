+impl TransportCapacityState {
+    fn new(max_connections: usize) -> Result<Self> {
+        if max_connections == 0 {
+            return Err(crate::Error::EndpointError(
+                "SIP transport connection limit must be greater than zero".to_string(),
+            ));
+        }
+        Ok(Self {
+            active_connections: AtomicUsize::new(0),
+            max_connections: AtomicUsize::new(max_connections),
+            connection_limit_rejections_total: AtomicU64::new(0),
+        })
+    }
+
+    fn set_limit(&self, max_connections: usize) -> Result<()> {
+        if max_connections == 0 {
+            return Err(crate::Error::EndpointError(
+                "SIP transport connection limit must be greater than zero".to_string(),
+            ));
+        }
+        let active = self.active_connections.load(Ordering::Acquire);
+        if active > max_connections {
+            return Err(crate::Error::EndpointError(format!(
+                "SIP transport connection limit {max_connections} is below {active} active connections"
+            )));
+        }
+        self.max_connections
+            .store(max_connections, Ordering::Release);
+        Ok(())
+    }
+
+    fn try_acquire_connection(&self) -> bool {
+        let mut current = self.active_connections.load(Ordering::Acquire);
+        loop {
+            let limit = self.max_connections.load(Ordering::Acquire);
+            if current >= limit {
+                self.connection_limit_rejections_total
+                    .fetch_add(1, Ordering::Relaxed);
+                return false;
+            }
+            match self.active_connections.compare_exchange_weak(
+                current,
+                current + 1,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => return true,
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn release_connection(&self) {
+        let mut current = self.active_connections.load(Ordering::Acquire);
+        loop {
+            if current == 0 {
+                debug_assert!(false, "SIP transport capacity counter release underflow");
+                return;
+            }
+            match self.active_connections.compare_exchange_weak(
+                current,
+                current - 1,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => return,
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn snapshot(&self) -> TransportCapacityStats {
+        TransportCapacityStats {
+            active_connections: self.active_connections.load(Ordering::Acquire),
+            max_connections: self.max_connections.load(Ordering::Acquire),
+            connection_limit_rejections_total: self
+                .connection_limit_rejections_total
+                .load(Ordering::Relaxed),
+        }
+    }
+}
