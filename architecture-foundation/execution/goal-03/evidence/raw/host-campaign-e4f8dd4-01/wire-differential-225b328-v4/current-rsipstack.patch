+    pub max_connections: usize,
+    pub connection_limit_rejections_total: u64,
+}
+
+struct TransportCapacityState {
+    active_connections: AtomicUsize,
+    max_connections: AtomicUsize,
+    connection_limit_rejections_total: AtomicU64,
+}
