+                .expect("host and port")
+                .into(),
+            ..Default::default()
+        },
+        headers: vec![
+            Via::new(&format!(
+                "SIP/2.0/UDP {};branch=z9hG4bK-ivekit-detach",
+                client.get_addr().addr
+            ))
+            .into(),
+            CSeq::new("1 REGISTER").into(),
+            From::new("iveKit <sip:ivekit@example.test>;tag=detach-race").into(),
+            CallId::new("ivekit-detach-race@example.test").into(),
+        ]
+        .into(),
+        version: crate::sip::Version::V2,
+        body: Default::default(),
+    };
+
+    client
+        .send(request.clone().into(), Some(&server_addr))
+        .await
+        .expect("send initial request");
+    let mut transaction = timeout(Duration::from_secs(1), incoming.recv())
+        .await
+        .expect("initial transaction timeout")
+        .expect("initial transaction");
+    let response = crate::sip::Response {
+        status_code: crate::sip::StatusCode::OK,
+        version: crate::sip::Version::V2,
+        headers: transaction.original.headers.clone(),
+        ..Default::default()
+    };
+    let send_duplicate = client.send(request.into(), Some(&server_addr));
