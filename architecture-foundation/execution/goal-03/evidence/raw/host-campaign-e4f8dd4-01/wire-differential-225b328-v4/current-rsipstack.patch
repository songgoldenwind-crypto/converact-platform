+
+    let client = UdpConnection::create_connection(
+        "127.0.0.1:0".parse().expect("client address"),
+        None,
+        None,
+    )
+    .await
+    .expect("client connection");
+    let client: SipConnection = client.into();
+    let request = crate::sip::message::Request {
+        method: crate::sip::method::Method::Register,
+        uri: crate::sip::Uri {
