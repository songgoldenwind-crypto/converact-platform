+
+const CLAIM_UNKNOWN_BATCH_UPDATE_SQL: &str = concat!(
+    r#"
+    UPDATE ivekit_sip_protocol_effects AS effect
+    SET repair_owner_id = $5,
+        repair_owner_epoch = $6::numeric,
+        repair_epoch_high_watermark = $6::numeric,
+        repair_claim_token = candidate.claim_token,
+        repair_claim_revision = effect.revision + 1,
+        repair_lease_until = statement_timestamp() +
