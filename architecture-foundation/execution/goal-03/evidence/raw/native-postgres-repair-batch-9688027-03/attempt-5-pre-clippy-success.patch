+fn bounded_repair_batch_limit(limit: usize) -> Result<i64, SipEffectStoreError> {
+    if limit == 0 || limit > MAX_REPAIR_BATCH_SIZE {
+        return Err(SipEffectStoreError::InvalidConfiguration);
+    }
+    i64::try_from(limit).map_err(|_| SipEffectStoreError::InvalidConfiguration)
+}
+
+fn validate_repair_batch_identity(
+    tenant_id: &str,
+    repair_owner_id: &str,
+    repair_owner_epoch: u64,
+    claim_token_prefix: &str,
+) -> Result<(), SipEffectStoreError> {
+    validate_sip_effect_identifier(tenant_id)?;
+    if claim_token_prefix.is_empty()
+        || claim_token_prefix.len() > MAX_REPAIR_TOKEN_PREFIX_BYTES
+        || !claim_token_prefix
+            .bytes()
+            .all(|byte| (b'!'..=b'~').contains(&byte))
+    {
+        return Err(SipEffectError::InvalidInput.into());
+    }
+    SipEffectRepairFence {
+        repair_owner_id: repair_owner_id.to_string(),
+        repair_owner_epoch,
+        repair_claim_token: claim_token_prefix.to_string(),
+        repair_claim_revision: 1,
+    }
+    .validate()?;
+    Ok(())
+}
