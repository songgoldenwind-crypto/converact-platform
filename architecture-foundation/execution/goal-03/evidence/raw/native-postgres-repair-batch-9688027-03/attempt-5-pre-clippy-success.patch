+             claim_token
+      FROM unnest($1::text[], $2::text[], $3::text[])
+        AS candidate(candidate_effect_id, expected_revision, claim_token)
+    ) AS candidate
+    WHERE effect.tenant_id = $4
+      AND effect.protocol_effect_id = candidate.candidate_effect_id
+      AND effect.revision = candidate.expected_revision
+      AND effect.state = 'unknown'
+      AND effect.operator_attention_required = FALSE
+      AND effect.repair_due_at <= statement_timestamp()
+      AND (
+        effect.repair_lease_until IS NULL OR
