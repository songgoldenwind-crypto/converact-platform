{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fault-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_id",
    "version",
    "generated_at",
    "binding_goal",
    "status",
    "dependencies",
    "acceptance",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "binding_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "goals/goal-02-platform-foundation-security-observability.md"
        },
        "sha256": {
          "type": "string",
          "const": "742e194e6b2d3e2b6fe9390bbabe96a6bbe0f40bdf99d8ed4ae4060a711a87f9"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "runtime",
        "production_eligible"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "target_contract",
            "verified_contract"
          ]
        },
        "runtime": {
          "type": "string",
          "enum": [
            "not_run",
            "verified_local",
            "verified_controlled",
            "failed"
          ]
        },
        "production_eligible": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency",
          "failure_modes",
          "established_human_media",
          "new_work",
          "optional_attachment",
          "recovery",
          "hot_path_dependency",
          "evidence"
        ],
        "properties": {
          "dependency": {
            "type": "string"
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "established_human_media": {
            "type": "string",
            "enum": [
              "continue",
              "continue_if_external_edge_owner"
            ]
          },
          "new_work": {
            "type": "string"
          },
          "optional_attachment": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          },
          "hot_path_dependency": {
            "type": "boolean",
            "const": false
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "production_eligible",
              "evidence_uris"
            ],
            "properties": {
              "status": {
                "type": "string",
                "const": "not_run"
              },
              "production_eligible": {
                "type": "boolean",
                "const": false
              },
              "evidence_uris": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "minItems": 12,
      "maxItems": 12
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_campaigns",
        "mock_or_loopback_production_evidence",
        "historical_evidence_inheritance",
        "any_unproved_item"
      ],
      "properties": {
        "required_campaigns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mock_or_loopback_production_evidence": {
          "type": "string"
        },
        "historical_evidence_inheritance": {
          "type": "string"
        },
        "any_unproved_item": {
          "type": "string",
          "const": "not_run"
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
