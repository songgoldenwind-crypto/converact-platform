{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fault-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_id",
    "version",
    "generated_at",
    "binding_goal",
    "status",
    "dependencies",
    "acceptance",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "binding_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "goals/goal-02-platform-foundation-security-observability.md"
        },
        "sha256": {
          "type": "string",
          "const": "742e194e6b2d3e2b6fe9390bbabe96a6bbe0f40bdf99d8ed4ae4060a711a87f9"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "runtime",
        "production_eligible"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "target_contract",
            "verified_contract"
          ]
        },
        "runtime": {
          "type": "string",
          "enum": [
            "not_run",
            "verified_local",
            "verified_controlled",
            "failed"
          ]
        },
        "production_eligible": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency",
          "failure_modes",
          "established_human_media",
          "new_work",
          "optional_attachment",
          "recovery",
          "hot_path_dependency",
          "evidence"
        ],
        "properties": {
          "dependency": {
            "type": "string"
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "established_human_media": {
            "type": "string",
            "enum": [
              "continue",
              "continue_if_external_edge_owner"
            ]
          },
          "new_work": {
            "type": "string"
          },
          "optional_attachment": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          },
          "hot_path_dependency": {
            "type": "boolean",
            "const": false
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "production_eligible",
              "evidence_uris"
            ],
            "properties": {
              "status": {
                "type": "string",
                "const": "not_run"
              },
              "production_eligible": {
                "type": "boolean",
                "const": false
              },
              "evidence_uris": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "minItems": 12,
      "maxItems": 12,
      "const": [
        {
          "dependency": "database",
          "failure_modes": [
            "timeout",
            "partition",
            "pool_exhaustion",
            "restart"
          ],
          "established_human_media": "continue",
          "new_work": "reject_durable_new_work",
          "optional_attachment": "degrade_or_bounded_spool",
          "recovery": "reconnect_query_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "event_system",
          "failure_modes": [
            "timeout",
            "partition",
            "duplicate",
            "reorder"
          ],
          "established_human_media": "continue",
          "new_work": "commit_domain_state_and_bound_outbox_or_reject",
          "optional_attachment": "degrade",
          "recovery": "replay_inbox_query_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "object_store",
          "failure_modes": [
            "timeout",
            "partition",
            "partial_write",
            "stale_read"
          ],
          "established_human_media": "continue",
          "new_work": "reject_object_required_work",
          "optional_attachment": "bounded_spool_or_detach",
          "recovery": "checksum_query_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "pki_kms",
          "failure_modes": [
            "timeout",
            "partition",
            "revoked_key",
            "expired_cert"
          ],
          "established_human_media": "continue",
          "new_work": "reject_new_secure_session_or_effect",
          "optional_attachment": "detach_at_lease_expiry",
          "recovery": "rotate_reauthorize_no_plaintext_downgrade",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "dns",
          "failure_modes": [
            "timeout",
            "nxdomain",
            "stale_answer",
            "poisoned_answer"
          ],
          "established_human_media": "continue",
          "new_work": "reject_or_use_unexpired_signed_snapshot",
          "optional_attachment": "keep_pinned_generation",
          "recovery": "new_generation_after_resolution",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "configuration",
          "failure_modes": [
            "missing",
            "invalid",
            "stale",
            "conflicting_revision"
          ],
          "established_human_media": "continue",
          "new_work": "reject_new_admission",
          "optional_attachment": "keep_pinned_generation",
          "recovery": "load_signed_revision_then_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "wall_clock",
          "failure_modes": [
            "backward_jump",
            "forward_jump",
            "cross_node_skew",
            "quality_unknown"
          ],
          "established_human_media": "continue",
          "new_work": "reject_new_lease_when_skew_exceeds_policy",
          "optional_attachment": "monotonic_deadline_continues",
          "recovery": "resync_then_reissue_lease",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "ai_gpu",
          "failure_modes": [
            "timeout",
            "oom",
            "process_crash",
            "capacity_exhaustion"
          ],
          "established_human_media": "continue",
          "new_work": "defer_or_reject_ai_work",
          "optional_attachment": "detach_ai_keep_human_media",
          "recovery": "fenced_worker_restart",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "recording_upload",
          "failure_modes": [
            "timeout",
            "partition",
            "checksum_mismatch",
            "capacity_exhaustion"
          ],
          "established_human_media": "continue",
          "new_work": "reject_or_degrade_new_recording",
          "optional_attachment": "bounded_capture_spool_or_detach",
          "recovery": "owner_epoch_checksum_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "provider",
          "failure_modes": [
            "timeout",
            "duplicate",
            "reorder",
            "unknown_effect"
          ],
          "established_human_media": "continue",
          "new_work": "reject_or_mark_unknown",
          "optional_attachment": "degrade_provider_feature",
          "recovery": "query_reconcile_compensate",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "observability",
          "failure_modes": [
            "collector_down",
            "exporter_timeout",
            "queue_full"
          ],
          "established_human_media": "continue",
          "new_work": "continue",
          "optional_attachment": "drop_bounded_telemetry",
          "recovery": "resume_without_unbounded_replay",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        },
        {
          "dependency": "node_crash",
          "failure_modes": [
            "process_abort",
            "oom",
            "host_loss"
          ],
          "established_human_media": "continue_if_external_edge_owner",
          "new_work": "reroute_new_admission",
          "optional_attachment": "interrupt_only_process_owned_edges",
          "recovery": "owner_epoch_takeover_and_reconcile",
          "hot_path_dependency": false,
          "evidence": {
            "status": "not_run",
            "production_eligible": false,
            "evidence_uris": []
          }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_campaigns",
        "mock_or_loopback_production_evidence",
        "historical_evidence_inheritance",
        "any_unproved_item"
      ],
      "properties": {
        "required_campaigns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mock_or_loopback_production_evidence": {
          "type": "string"
        },
        "historical_evidence_inheritance": {
          "type": "string"
        },
        "any_unproved_item": {
          "type": "string",
          "const": "not_run"
        }
      },
      "const": {
        "required_campaigns": [
          "local_deterministic",
          "real_dependency",
          "rolling_schema",
          "key_rotation",
          "backup_restore",
          "node_loss",
          "region_recovery",
          "long_media_fault",
          "bounded_overload_capacity",
          "independent_security_review"
        ],
        "mock_or_loopback_production_evidence": "forbidden",
        "historical_evidence_inheritance": "forbidden",
        "any_unproved_item": "not_run"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "const": [
        "ordinary_media_bypasses_all_platform_dependencies",
        "optional_failure_never_sends_call_termination",
        "stale_generation_or_owner_epoch_never_writes",
        "unknown_effect_requires_query_reconcile",
        "capacity_exhaustion_rejects_new_optional_work_before_human_media"
      ]
    }
  }
}
