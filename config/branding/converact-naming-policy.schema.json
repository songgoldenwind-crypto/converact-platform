{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converact.dev/schemas/converact-naming-policy.schema.json",
  "title": "Converact naming policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand",
    "repository",
    "environment",
    "classifications"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "brand": {
      "$ref": "#/$defs/identity"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "historical", "external"],
      "properties": {
        "compatibility": {
          "$ref": "#/$defs/rules"
        },
        "historical": {
          "$ref": "#/$defs/rules"
        },
        "external": {
          "$ref": "#/$defs/rules"
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy", "current"],
      "properties": {
        "legacy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy", "current"],
      "properties": {
        "legacy": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyPrefixes", "currentPrefixes"],
      "properties": {
        "legacyPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*_$"
          }
        },
        "currentPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*_$"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path_globs",
        "tokens",
        "reason",
        "owner",
        "removal_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "removal_condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
