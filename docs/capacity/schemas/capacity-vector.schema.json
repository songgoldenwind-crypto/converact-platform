{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivekit.local/schemas/capacity/capacity-vector-v1.schema.json",
  "title": "iveKit Capacity Vector v1",
  "description": "Capacity, utilization, reservation, and admission state for an iveKit node, Cell, Zone, or Region under one workload profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "sequence",
    "observed_at",
    "expires_at",
    "scope",
    "profile_id",
    "component",
    "admission",
    "dimensions",
    "resources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "sample_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}-v[1-9][0-9]*$"
    },
    "component": {
      "enum": [
        "mixed",
        "sip_edge",
        "rustpbx",
        "livekit_sfu",
        "livekit_turn",
        "livekit_egress",
        "tinode",
        "ivekit_api",
        "ivekit_ws",
        "ivekit_worker",
        "rustdesk_hbbs",
        "rustdesk_hbbr",
        "postgresql",
        "redis",
        "nats_jetstream",
        "object_storage",
        "provider"
      ]
    },
    "fork_release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "admission": {
      "$ref": "#/$defs/admission"
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["target", "not_run", "failed", "verified"]
        },
        "evidence_bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "workload_profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}-v[1-9][0-9]*$"
        },
        "bridge_included": {
          "type": "boolean"
        },
        "results_inheritable": {
          "type": "boolean"
        },
        "forbidden_inheritance_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ordinary_rtp",
              "livekit_only",
              "optional_bridge_excluded",
              "another_path"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["dimensions"],
        "properties": {
          "dimensions": {
            "type": "object",
            "required": ["voice_livekit_bridge"]
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["evidence"],
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          },
          "profile_id": {
            "const": "voice-livekit-bridge-v1"
          },
          "evidence": {
            "type": "object",
            "required": [
              "workload_profile_id",
              "bridge_included",
              "results_inheritable",
              "forbidden_inheritance_sources"
            ],
            "properties": {
              "workload_profile_id": {
                "const": "voice-livekit-bridge-v1"
              },
              "bridge_included": {
                "const": true
              },
              "results_inheritable": {
                "const": false
              },
              "forbidden_inheritance_sources": {
                "const": [
                  "ordinary_rtp",
                  "livekit_only",
                  "optional_bridge_excluded",
                  "another_path"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["dimensions", "evidence"],
        "properties": {
          "dimensions": {
            "type": "object",
            "required": ["voice_livekit_bridge"]
          },
          "evidence": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "object",
            "required": ["evidence_bundle_id", "verified_at"]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["dimensions", "evidence"],
        "properties": {
          "dimensions": {
            "type": "object",
            "required": ["voice_livekit_bridge"]
          },
          "evidence": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["target", "not_run", "failed"]
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "admission": {
            "type": "object",
            "properties": {
              "accepts_new_interactions": {
                "const": false
              }
            }
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "voice_livekit_bridge": {
                "$ref": "#/$defs/unverifiedBridgeCapacity"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "region_id"],
      "properties": {
        "type": {
          "enum": ["node", "cell", "zone", "region"]
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "zone_id": {
          "type": "string",
          "minLength": 1
        },
        "cell_id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "node" } } },
          "then": { "required": ["zone_id", "cell_id", "node_id", "owner_epoch"] }
        },
        {
          "if": { "properties": { "type": { "const": "cell" } } },
          "then": { "required": ["zone_id", "cell_id"] }
        },
        {
          "if": { "properties": { "type": { "const": "zone" } } },
          "then": { "required": ["zone_id"] }
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accepts_new_interactions", "accepts_existing_owner_traffic", "limiting_dimensions"],
      "properties": {
        "state": {
          "enum": ["accepting", "degraded", "draining", "rejecting", "offline"]
        },
        "accepts_new_interactions": {
          "type": "boolean"
        },
        "accepts_existing_owner_traffic": {
          "type": "boolean"
        },
        "limiting_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{2,127}$"
          }
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "capacity_exhausted",
              "profile_not_supported",
              "stale_heartbeat",
              "planned_drain",
              "node_failure",
              "zone_failure",
              "dependency_unavailable",
              "provider_quota",
              "recording_capacity",
              "turn_capacity",
              "operator_override"
            ]
          }
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "drain_started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sip": { "$ref": "#/$defs/sipDimensions" },
        "voice": { "$ref": "#/$defs/voiceDimensions" },
        "livekit": { "$ref": "#/$defs/liveKitDimensions" },
        "voice_livekit_bridge": {
          "$ref": "#/$defs/voiceLiveKitBridgeDimensions"
        },
        "im": { "$ref": "#/$defs/imDimensions" },
        "events": { "$ref": "#/$defs/eventDimensions" },
        "remote": { "$ref": "#/$defs/remoteDimensions" },
        "workers": { "$ref": "#/$defs/workerDimensions" },
        "data": { "$ref": "#/$defs/dataDimensions" }
      }
    },
    "capacityDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "safe_capacity", "used", "reserved", "confidence", "source"],
      "properties": {
        "unit": {
          "enum": [
            "count",
            "per_second",
            "mbps",
            "packet_ops_per_second",
            "milliseconds",
            "packets",
            "bytes_per_second",
            "seconds_per_second",
            "characters_per_second",
            "tokens_per_second"
          ]
        },
        "safe_capacity": {
          "type": "number",
          "minimum": 0
        },
        "hard_limit": {
          "type": "number",
          "minimum": 0
        },
        "used": {
          "type": "number",
          "minimum": 0
        },
        "reserved": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "enum": ["verified", "target", "unknown"]
        },
        "source": {
          "enum": ["benchmark", "static_limit", "provider_quota", "aggregate", "unknown"]
        }
      }
    },
    "countCapacityDimension": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDimension"
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "count"
            }
          }
        }
      ]
    },
    "perSecondCapacityDimension": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDimension"
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "per_second"
            }
          }
        }
      ]
    },
    "millisecondsCapacityDimension": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDimension"
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "milliseconds"
            }
          }
        }
      ]
    },
    "packetsCapacityDimension": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDimension"
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "packets"
            }
          }
        }
      ]
    },
    "sipDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "invite_cps": { "$ref": "#/$defs/capacityDimension" },
        "active_dialogs": { "$ref": "#/$defs/capacityDimension" },
        "registrations": { "$ref": "#/$defs/capacityDimension" },
        "registration_updates_per_second": { "$ref": "#/$defs/capacityDimension" },
        "sip_websocket_connections": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "voiceDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "calls_v1": { "$ref": "#/$defs/capacityDimension" },
        "calls_v2": { "$ref": "#/$defs/capacityDimension" },
        "calls_v3": { "$ref": "#/$defs/capacityDimension" },
        "weighted_calls": { "$ref": "#/$defs/capacityDimension" },
        "rtp_legs": { "$ref": "#/$defs/capacityDimension" },
        "rtp_rx_pps": { "$ref": "#/$defs/capacityDimension" },
        "rtp_tx_pps": { "$ref": "#/$defs/capacityDimension" },
        "media_ingress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "media_egress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "recording_slots": { "$ref": "#/$defs/capacityDimension" },
        "transcode_slots": { "$ref": "#/$defs/capacityDimension" },
        "supervisor_slots": { "$ref": "#/$defs/capacityDimension" },
        "realtime_asr_streams": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "liveKitDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "rooms": { "$ref": "#/$defs/capacityDimension" },
        "participants": { "$ref": "#/$defs/capacityDimension" },
        "published_audio_tracks": { "$ref": "#/$defs/capacityDimension" },
        "published_video_tracks": { "$ref": "#/$defs/capacityDimension" },
        "published_screen_tracks": { "$ref": "#/$defs/capacityDimension" },
        "subscribed_tracks": { "$ref": "#/$defs/capacityDimension" },
        "media_ingress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "media_egress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "packet_ops_per_second": { "$ref": "#/$defs/capacityDimension" },
        "turn_relay_mbps": { "$ref": "#/$defs/capacityDimension" },
        "track_egress_jobs": { "$ref": "#/$defs/capacityDimension" },
        "room_composite_jobs": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "voiceLiveKitBridgeDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_generations",
        "directed_bridge_edges",
        "livekit_sip_participants",
        "bridge_cps",
        "switch_attempts",
        "switch_gap_p99_ms",
        "switch_loss_packets_p99",
        "decode_slots",
        "encode_slots",
        "resample_slots",
        "transcode_slots",
        "recording_roles",
        "handoff_reconciliation_cps"
      ],
      "properties": {
        "bridge_generations": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "directed_bridge_edges": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "livekit_sip_participants": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "bridge_cps": {
          "$ref": "#/$defs/perSecondCapacityDimension"
        },
        "switch_attempts": {
          "$ref": "#/$defs/perSecondCapacityDimension"
        },
        "switch_gap_p99_ms": {
          "$ref": "#/$defs/millisecondsCapacityDimension"
        },
        "switch_loss_packets_p99": {
          "$ref": "#/$defs/packetsCapacityDimension"
        },
        "decode_slots": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "encode_slots": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "resample_slots": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "transcode_slots": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "recording_roles": {
          "$ref": "#/$defs/countCapacityDimension"
        },
        "handoff_reconciliation_cps": {
          "$ref": "#/$defs/perSecondCapacityDimension"
        }
      }
    },
    "unverifiedBridgeCapacity": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["safe_capacity", "confidence"],
        "properties": {
          "safe_capacity": {
            "const": 0
          },
          "confidence": {
            "enum": ["target", "unknown"]
          }
        }
      }
    },
    "imDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "websocket_connections": { "$ref": "#/$defs/capacityDimension" },
        "active_topics": { "$ref": "#/$defs/capacityDimension" },
        "business_messages_per_second": { "$ref": "#/$defs/capacityDimension" },
        "fanout_deliveries_per_second": { "$ref": "#/$defs/capacityDimension" },
        "receipts_per_second": { "$ref": "#/$defs/capacityDimension" },
        "presence_updates_per_second": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "eventDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "websocket_connections": { "$ref": "#/$defs/capacityDimension" },
        "events_per_second": { "$ref": "#/$defs/capacityDimension" },
        "webhook_deliveries_per_second": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "remoteDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sessions": { "$ref": "#/$defs/capacityDimension" },
        "relay_sessions": { "$ref": "#/$defs/capacityDimension" },
        "relay_ingress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "relay_egress_mbps": { "$ref": "#/$defs/capacityDimension" },
        "recording_uploads": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "workerDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ready_jobs": { "$ref": "#/$defs/capacityDimension" },
        "claims_per_second": { "$ref": "#/$defs/capacityDimension" },
        "provider_concurrency": { "$ref": "#/$defs/capacityDimension" },
        "audio_seconds_per_second": { "$ref": "#/$defs/capacityDimension" },
        "images_per_second": { "$ref": "#/$defs/capacityDimension" },
        "characters_per_second": { "$ref": "#/$defs/capacityDimension" },
        "tokens_per_second": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "dataDimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "transactions_per_second": { "$ref": "#/$defs/capacityDimension" },
        "wal_bytes_per_second": { "$ref": "#/$defs/capacityDimension" },
        "redis_ops_per_second": { "$ref": "#/$defs/capacityDimension" },
        "nats_messages_per_second": { "$ref": "#/$defs/capacityDimension" },
        "nats_bytes_per_second": { "$ref": "#/$defs/capacityDimension" },
        "object_write_bytes_per_second": { "$ref": "#/$defs/capacityDimension" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_cores", "cpu_utilization_ratio", "memory_bytes", "memory_utilization_ratio", "nic_ingress_mbps", "nic_egress_mbps", "open_file_descriptors"],
      "properties": {
        "cpu_cores": { "type": "number", "exclusiveMinimum": 0 },
        "cpu_utilization_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "memory_utilization_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "nic_ingress_mbps": { "type": "number", "minimum": 0 },
        "nic_egress_mbps": { "type": "number", "minimum": 0 },
        "open_file_descriptors": { "type": "integer", "minimum": 0 },
        "event_loop_lag_p99_ms": { "type": "number", "minimum": 0 },
        "db_pool_wait_p99_ms": { "type": "number", "minimum": 0 },
        "gc_pause_p99_ms": { "type": "number", "minimum": 0 },
        "disk_read_bytes_per_second": { "type": "number", "minimum": 0 },
        "disk_write_bytes_per_second": { "type": "number", "minimum": 0 }
      }
    }
  },
  "x-ivekit-invariants": [
    "expires_at > observed_at",
    "newer sequence supersedes older samples for the same scope and component",
    "used + reserved <= safe_capacity is required for accepting state",
    "hard_limit >= safe_capacity when hard_limit is present",
    "confidence=verified requires evidence.status=verified",
    "node scope requires a monotonically fenced owner_epoch",
    "unknown or target dimensions cannot be used to advertise production safe capacity",
    "schema 1.1.0 readers accept 1.0.0 producer vectors, but 1.0.0 readers do not accept 1.1.0 writers",
    "the oldest_live_reader_first gate keeps writers at 1.0.0 until every live reader supports 1.1.0",
    "voice_livekit_bridge is optional for 1.0.0 producers; absence advertises no bridge support and zero bridge capacity",
    "voice_livekit_bridge requires schema 1.1.0, all 13 dimensions, its own bridge-included evidence, and cannot inherit ordinary voice or optional_bridge_excluded results",
    "target, not_run, and failed bridge evidence force rejecting admission and zero advertised bridge safe capacity"
  ]
}
