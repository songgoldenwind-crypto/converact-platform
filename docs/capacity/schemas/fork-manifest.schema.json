{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivekit.local/schemas/fork-manifest.schema.json",
  "title": "iveKit Open Source Fork Manifest",
  "description": "Records exact upstream identities, local modifications, build provenance, verification state, and release gates for capacity-critical open-source components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "revision",
    "status",
    "generated_at",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "superseded"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "x-ivekit-invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "verification_status": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "not_run",
        "not_applicable"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "name",
        "role",
        "lifecycle",
        "integration_mode",
        "source_modification_allowed",
        "upstream",
        "verification",
        "release_gate",
        "upgrade_policy"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "active_engineering",
            "planned",
            "production",
            "retiring"
          ]
        },
        "integration_mode": {
          "enum": [
            "upstream_image",
            "pinned_source",
            "patch_queue",
            "overlay",
            "maintained_fork"
          ]
        },
        "source_modification_allowed": {
          "const": true
        },
        "upstream": {
          "$ref": "#/$defs/upstream"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "runtime_artifact": {
          "$ref": "#/$defs/runtime_artifact"
        },
        "patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patch"
          }
        },
        "protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocol"
          }
        },
        "implemented_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "planned_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "release_gate": {
          "$ref": "#/$defs/release_gate"
        },
        "upgrade_policy": {
          "$ref": "#/$defs/upgrade_policy"
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "pin_kind"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "pin_kind": {
          "enum": [
            "exact_commit",
            "exact_tag",
            "image_digest",
            "tag_and_digest",
            "planned_unresolved"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_ref": {
          "type": "string",
          "minLength": 1
        },
        "image_repository": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_identity_complete": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pin_kind": {
                "const": "exact_commit"
              }
            },
            "required": [
              "pin_kind"
            ]
          },
          "then": {
            "required": [
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pin_kind": {
                "const": "exact_tag"
              }
            },
            "required": [
              "pin_kind"
            ]
          },
          "then": {
            "required": [
              "release_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pin_kind": {
                "enum": [
                  "image_digest",
                  "tag_and_digest"
                ]
              }
            },
            "required": [
              "pin_kind"
            ]
          },
          "then": {
            "required": [
              "image_repository",
              "image_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pin_kind": {
                "const": "tag_and_digest"
              }
            },
            "required": [
              "pin_kind"
            ]
          },
          "then": {
            "required": [
              "release_ref"
            ]
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproducible",
        "lockfile_enforced"
      ],
      "properties": {
        "reproducible": {
          "type": "boolean"
        },
        "lockfile_enforced": {
          "type": "boolean"
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "builder_image": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "output_image": {
          "type": "string",
          "minLength": 1
        },
        "output_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "runtime_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "kind",
        "contains_declared_modifications"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "upstream_baseline",
            "custom_candidate",
            "custom_production"
          ]
        },
        "contains_declared_modifications": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "applies_to"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "applies_to": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "visibility"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "component_internal",
            "ivekit_internal",
            "public_contract"
          ]
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "summary",
        "acceptance_evidence"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "capacity_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "patch_apply",
        "compile",
        "unit",
        "integration",
        "benchmark",
        "real_environment"
      ],
      "properties": {
        "source_identity": {
          "$ref": "#/$defs/verification_status"
        },
        "patch_apply": {
          "$ref": "#/$defs/verification_status"
        },
        "compile": {
          "$ref": "#/$defs/verification_status"
        },
        "unit": {
          "$ref": "#/$defs/verification_status"
        },
        "integration": {
          "$ref": "#/$defs/verification_status"
        },
        "benchmark": {
          "$ref": "#/$defs/verification_status"
        },
        "real_environment": {
          "$ref": "#/$defs/verification_status"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_eligible",
        "blocking_reasons"
      ],
      "properties": {
        "production_eligible": {
          "type": "boolean"
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "upgrade_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_cadence_days",
        "critical_security_fix_sla_days",
        "merge_strategy",
        "compatibility_policy",
        "rollback_identity_required"
      ],
      "properties": {
        "review_cadence_days": {
          "type": "integer",
          "minimum": 1
        },
        "critical_security_fix_sla_days": {
          "type": "integer",
          "minimum": 0
        },
        "merge_strategy": {
          "enum": [
            "rebase_patch_queue",
            "merge_upstream_release",
            "replace_overlay_base",
            "track_upstream_image"
          ]
        },
        "compatibility_policy": {
          "type": "string",
          "minLength": 1
        },
        "rollback_identity_required": {
          "const": true
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_license": {
          "type": "string",
          "minLength": 1
        },
        "notice_recorded": {
          "type": "boolean"
        },
        "sbom_status": {
          "$ref": "#/$defs/verification_status"
        },
        "provenance_status": {
          "$ref": "#/$defs/verification_status"
        }
      }
    }
  }
}
