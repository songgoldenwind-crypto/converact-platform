{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.local/schemas/voice-media-goal4.schema.json",
  "title": "iveKit media processing and transcoding Goal 4 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "revision",
    "status",
    "generated_at",
    "sources",
    "authority",
    "codec_slices",
    "feature_slices",
    "processing_runtime",
    "failure_matrix",
    "metrics",
    "profile_path",
    "verification",
    "claim"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "const": "voice-media-goal4-v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["target", "implemented", "functional_pass", "retired"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustpbx",
        "rustrtc",
        "rtpengine",
        "audio_codec",
        "processing_service",
        "rvoip_g729_candidate"
      ],
      "properties": {
        "rustpbx": { "$ref": "#/$defs/gitSource" },
        "rustrtc": { "$ref": "#/$defs/gitSource" },
        "rtpengine": { "$ref": "#/$defs/gitSource" },
        "audio_codec": {
          "const": {
            "crate": "audio-codec",
            "version": "0.3.40",
            "integration": "local_path_fork",
            "path": "services/voice-media-rs/vendor/audio-codec-g711-opus",
            "upstream_repository": "https://github.com/restsend/audio-codec",
            "upstream_commit": "b074337d37be797771b258daacafb87aa833c015",
            "upstream_crate_sha256": "c1affd3ba1faa8ae5c47c98f6c5e36eb321f4cb4567d7a7e1a8f3452fe40d57a",
            "upstream_crate_bytes": 24377,
            "license": "MIT",
            "retained_modules": ["pcmu", "pcma", "opus", "resampler"],
            "removed_modules": ["g722", "g729", "telephone_event"],
            "g729_source_authority": "rvoip_g729_candidate_only",
            "g729_runtime_enabled": false
          }
        },
        "processing_service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version"],
          "properties": {
            "path": { "const": "services/voice-media-rs" },
            "version": { "const": "0.2.0" }
          }
        },
        "rvoip_g729_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "candidate_id", "repository", "commit", "tree", "archive_sha256", "archive_bytes", "source_set_sha256"],
          "properties": {
            "manifest": { "const": "docs/capacity/forks/rvoip-g729-source-candidate-v1.json" },
            "candidate_id": { "const": "rvoip-g729-codec-core-v1" },
            "repository": { "const": "https://github.com/eisenzopf/rvoip" },
            "commit": { "const": "4ced02b7f6e73041c848f1765dc2bcf7588796f0" },
            "tree": { "const": "74dabd314841d99e1a87dbdaca6050fc4e8ed923" },
            "archive_sha256": { "const": "16caf07273a1cd04fa126af242ad54892580818b5e7fa3c10d010e4917be437e" },
            "archive_bytes": { "const": 8594565 },
            "source_set_sha256": { "const": "bbc645b365a3b0d86fd2c05881d7911d65b880b695b1483dba856903bae223ad" }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_dialog_owner",
        "logical_media_graph_owner",
        "fast_path_owner",
        "processing_owner",
        "command_authority",
        "reservation_authority",
        "packet_path_remote_dependency",
        "ordinary_relay_enters_processing_pool"
      ],
      "properties": {
        "call_dialog_owner": { "const": "rustpbx" },
        "logical_media_graph_owner": { "const": "rustpbx" },
        "fast_path_owner": { "const": "rtpengine" },
        "processing_owner": { "const": "voice-media-rs" },
        "command_authority": { "const": "media_control_agent" },
        "reservation_authority": { "const": "component_node_admission" },
        "packet_path_remote_dependency": { "const": false },
        "ordinary_relay_enters_processing_pool": { "const": false }
      }
    },
    "codec_slices": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/g729Slice" },
          { "$ref": "#/$defs/codecSlice" }
        ]
      },
      "contains": { "$ref": "#/$defs/g729Slice" },
      "minContains": 1,
      "maxContains": 1
    },
    "feature_slices": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "features", "verification"],
        "properties": {
          "slice_id": {
            "enum": ["ivr-v1", "conference-v1"]
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "playback",
                "gather",
                "barge_in",
                "rfc4733",
                "sip_info",
                "in_band_dtmf",
                "mix",
                "mute",
                "volume",
                "active_speaker"
              ]
            }
          },
          "verification": { "$ref": "#/$defs/verificationStatus" }
        }
      }
    },
    "processing_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec_pair_slots_bounded",
        "rtp_receive_queue_bounded",
        "jitter_buffer_bounded",
        "playback_queue_bounded",
        "event_queue_bounded",
        "unknown_codec_fail_closed",
        "cross_pair_slot_borrowing",
        "control_plane_failure_established_media",
        "owner_epoch_fenced",
        "command_sequence_fenced",
        "idempotent_replay",
        "database_in_packet_path",
        "provider_in_packet_path",
        "object_storage_in_packet_path"
      ],
      "properties": {
        "codec_pair_slots_bounded": { "const": true },
        "rtp_receive_queue_bounded": { "const": true },
        "jitter_buffer_bounded": { "const": true },
        "playback_queue_bounded": { "const": true },
        "event_queue_bounded": { "const": true },
        "unknown_codec_fail_closed": { "const": true },
        "cross_pair_slot_borrowing": { "const": false },
        "control_plane_failure_established_media": { "const": "continue" },
        "owner_epoch_fenced": { "const": true },
        "command_sequence_fenced": { "const": true },
        "idempotent_replay": { "const": true },
        "database_in_packet_path": { "const": false },
        "provider_in_packet_path": { "const": false },
        "object_storage_in_packet_path": { "const": false }
      }
    },
    "failure_matrix": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "established_processing",
          "new_processing_admission",
          "ordinary_relay",
          "required_evidence"
        ],
        "properties": {
          "failure_id": {
            "enum": [
              "processing-capacity-exhausted",
              "processing-control-unavailable",
              "processing-worker-restart",
              "postgres-unavailable",
              "nats-unavailable",
              "recorder-unavailable",
              "object-storage-unavailable"
            ]
          },
          "established_processing": {
            "enum": ["continue", "interrupt_visible", "degrade_evidence_only"]
          },
          "new_processing_admission": {
            "enum": ["continue", "reject", "reject_profile"]
          },
          "ordinary_relay": { "const": "continue" },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_labels", "forbidden_labels", "required_metrics"],
      "properties": {
        "allowed_labels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "codec_pair" },
            { "const": "direction" },
            { "const": "profile" },
            { "const": "result" },
            { "const": "failure_stage" },
            { "const": "runtime_mode" }
          ],
          "items": false
        },
        "forbidden_labels": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tenant_id",
              "call_id",
              "leg_id",
              "reservation_id",
              "phone_number",
              "ssrc"
            ]
          }
        },
        "required_metrics": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ivekit_voice_processing_[a-z0-9_]+$"
          }
        }
      }
    },
    "profile_path": {
      "const": "docs/capacity/profiles/vos-eq-v3-g711-opus-1k-v1.json"
    },
    "verification": {
      "const": {
        "schema": "not_run",
        "rust_unit": "not_run",
        "exact_source_compile": "not_run",
        "real_rtp": "not_run",
        "quality": "not_run",
        "failure_isolation": "not_run",
        "capacity": "not_run",
        "supply_chain": "not_run"
      }
    },
    "claim": {
      "const": {
        "functional": "not_run",
        "production": "not_run",
        "benchmark": "not_run",
        "capacity_claim": "none",
        "production_eligible": false
      }
    }
  },
  "$defs": {
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "g729Slice": {
      "const": {
        "slice_id": "g729-v1",
        "codecs": ["PCMU", "PCMA", "OPUS", "G729A", "G729AB"],
        "codec_pairs": [
          "PCMU_TO_G729A",
          "G729A_TO_PCMU",
          "PCMA_TO_G729A",
          "G729A_TO_PCMA",
          "OPUS_TO_G729A",
          "G729A_TO_OPUS",
          "PCMU_TO_G729AB",
          "G729AB_TO_PCMU",
          "PCMA_TO_G729AB",
          "G729AB_TO_PCMA",
          "OPUS_TO_G729AB",
          "G729AB_TO_OPUS"
        ],
        "codec_modes": [
          {
            "mode_id": "G729A",
            "annex_b_mode": false,
            "codec_pairs": [
              { "pair_id": "PCMU_TO_G729A", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729A_TO_PCMU", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "PCMA_TO_G729A", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729A_TO_PCMA", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "OPUS_TO_G729A", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729A_TO_OPUS", "capacity_profile_id": null, "verification": "not_run" }
            ],
            "independent_peer": { "status": "not_run", "identity": null },
            "reference_vector_artifact": { "status": "not_run", "artifact": null },
            "quality_profile": { "status": "not_run", "profile_id": null },
            "performance_profile": { "status": "not_run", "profile_id": null },
            "verification": "not_run"
          },
          {
            "mode_id": "G729AB",
            "annex_b_mode": true,
            "codec_pairs": [
              { "pair_id": "PCMU_TO_G729AB", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729AB_TO_PCMU", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "PCMA_TO_G729AB", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729AB_TO_PCMA", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "OPUS_TO_G729AB", "capacity_profile_id": null, "verification": "not_run" },
              { "pair_id": "G729AB_TO_OPUS", "capacity_profile_id": null, "verification": "not_run" }
            ],
            "independent_peer": { "status": "not_run", "identity": null },
            "reference_vector_artifact": { "status": "not_run", "artifact": null },
            "quality_profile": { "status": "not_run", "profile_id": null },
            "performance_profile": { "status": "not_run", "profile_id": null },
            "verification": "not_run"
          }
        ],
        "sample_rate_hz": 8000,
        "frame_ms": 10,
        "samples_per_frame": 80,
        "packetization_ms": [10, 20],
        "annex_b_fmtp_negotiation": {
          "status": "not_run",
          "parameter": "annexb",
          "g729a_expected_value": "no",
          "g729ab_expected_value": "yes"
        },
        "capacity_profile_id": null,
        "verification": "not_run",
        "runtime_enabled": false,
        "legal_boundary": {
          "status": "not_run",
          "blocks": [
            "production_distribution",
            "runtime_enablement",
            "production_eligibility"
          ],
          "does_not_block": [
            "engineering_implementation",
            "source_extraction",
            "testing"
          ],
          "external_legal_conclusion_required": true
        },
        "acceptance_gates": {
          "license_review": "not_run",
          "patent_legal_review": "not_run",
          "extraction": "not_run",
          "dependency_closure": "not_run",
          "annex_a": "not_run",
          "annex_b_vad_dtx_cng": "not_run",
          "annex_b_fmtp_negotiation": "not_run",
          "packetization_10ms": "not_run",
          "packetization_20ms": "not_run",
          "sid_no_data": "not_run",
          "plc": "not_run",
          "reference_vectors": "not_run",
          "g711_pairs": "not_run",
          "opus_pairs": "not_run",
          "interoperability": "not_run",
          "quality": "not_run",
          "allocation": "not_run",
          "latency": "not_run",
          "sessions_per_core": "not_run",
          "supply_chain": "not_run",
          "production_eligibility": "not_run"
        }
      }
    },
    "codecSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "codecs",
        "codec_pairs",
        "packetization_ms",
        "capacity_profile_id",
        "verification"
      ],
      "properties": {
        "slice_id": {
          "enum": ["g711-opus-v1", "amr-v1", "t38-v1"]
        },
        "codecs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PCMU",
              "PCMA",
              "OPUS",
              "AMR_NB",
              "AMR_WB",
              "T38"
            ]
          }
        },
        "codec_pairs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+_TO_[A-Z0-9_]+$"
          }
        },
        "packetization_ms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60
          }
        },
        "capacity_profile_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]{2,127}-v[1-9][0-9]*$"
        },
        "verification": { "$ref": "#/$defs/verificationStatus" }
      }
    },
    "verificationStatus": {
      "enum": ["not_run", "controlled_pass", "failed", "production_pass"]
    },
    "claimStatus": {
      "enum": ["not_run", "failed", "functional_pass", "production_pass"]
    }
  }
}
