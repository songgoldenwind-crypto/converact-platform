        "slice_id",
        "codecs",
        "codec_pairs",
        "packetization_ms",
        "capacity_profile_id",
        "verification"
      ],
      "properties": {
        "slice_id": {
          "enum": ["g711-opus-v1", "amr-v1", "t38-v1"]
        },
        "codecs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PCMU",
              "PCMA",
              "OPUS",
              "AMR_NB",
              "AMR_WB",
              "T38"
            ]
          }
        },
        "codec_pairs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+_TO_[A-Z0-9_]+$"
          }
        },
        "packetization_ms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60
          }
        },
        "capacity_profile_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]{2,127}-v[1-9][0-9]*$"
        },
        "verification": { "$ref": "#/$defs/verificationStatus" }
      }
    },
    "verificationStatus": {
      "enum": ["not_run", "controlled_pass", "failed", "production_pass"]
    },
    "claimStatus": {
      "enum": ["not_run", "failed", "functional_pass", "production_pass"]
    }
  }
}
