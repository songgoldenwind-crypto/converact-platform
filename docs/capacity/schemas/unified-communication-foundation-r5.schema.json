          "const": "opc_ai_native_orchestrator"
        },
        "tool_result_binding": {
          "const": "same_interaction_agent_run_context_revision_response_generation_and_fence"
        },
        "hf_performance_status": {
          "const": "not_run"
        },
        "production_eligible": {
          "const": false
        }
      }
    },
    "ai_native": {
      "$ref": "#/$defs/aiNativeContract"
    },
    "multimodal_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_component_state_machine",
        "replacement_state_machine",
        "prepared_blocked_external_effects_allowed",
        "first_production_strategy",
        "stable_facts",
        "livekit_sip_scope",
        "future_vilte_backend",
        "agent_browser_video_path",
        "vilte_production_topology",
        "vilte_split_topology",
        "livekit_gateway_client",
        "crypto_segments",
        "vilte_audio_codecs",
        "h264_rtp_contract",
        "sip_av_state_machine",
        "room_to_carrier_selection",
        "required_paths",
        "results_inheritable_across_paths",
        "video_failure_default",
        "production_eligible"
      ],
      "properties": {
        "new_component_state_machine": {
          "const": [
            "prepare_local_resources",
            "prepared_blocked",
            "commit",
            "join_connect_enable_new_writer",
            "observe_output",
            "reconcile"
          ]
        },
        "replacement_state_machine": {
          "const": [
            "prepare_new_local_resources_blocked",
            "durable_revoke_old",
            "invalidate_old_fence_all_output_gates",
            "old_zero_output_ack",
            "commit_new_generation",
            "join_connect_enable_new_writer",
            "observe_output",
            "release_old_generation",
            "reconcile"
          ]
        },
        "prepared_blocked_external_effects_allowed": {
          "const": false
        },
        "first_production_strategy": {
          "const": "break_before_make"
        },
        "stable_facts": {
