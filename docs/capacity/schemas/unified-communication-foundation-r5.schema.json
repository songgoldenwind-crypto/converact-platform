  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "unified-communication-foundation-r5-v1"
    },
    "revision": {
      "const": 5
    },
    "status": {
      "const": "target"
    },
    "inherited_r4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inheritance_policy",
        "objective",
        "machine_contract",
        "traceability",
        "superseded_r4_statements",
        "preserved_r4_authorities"
      ],
      "properties": {
        "inheritance_policy": {
          "const": "all_r4_requirements_and_statuses_remain_binding_unless_explicitly_superseded_by_r5_delta"
        },
        "objective": {
          "$ref": "#/$defs/artifactBinding"
        },
        "machine_contract": {
          "$ref": "#/$defs/artifactBinding"
        },
        "traceability": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactBinding"
            },
            {
              "type": "object",
              "required": [
                "row_count"
              ],
              "properties": {
                "row_count": {
                  "const": 362
                }
              }
            }
          ]
        },
        "superseded_r4_statements": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        },
        "preserved_r4_authorities": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "design",
        "agent_speech_adr",
        "vilte_gateway_adr",
        "implementation_plan",
        "domain_language",
        "design_navigation"
      ],
      "properties": {
        "objective": {
          "$ref": "#/$defs/artifactBinding"
        },
        "design": {
          "$ref": "#/$defs/artifactBinding"
        },
        "agent_speech_adr": {
          "$ref": "#/$defs/artifactBinding"
        },
        "vilte_gateway_adr": {
          "$ref": "#/$defs/artifactBinding"
        },
        "implementation_plan": {
          "$ref": "#/$defs/artifactBinding"
        },
        "domain_language": {
          "$ref": "#/$defs/artifactBinding"
        },
        "design_navigation": {
          "$ref": "#/$defs/artifactBinding"
        }
      }
    },
