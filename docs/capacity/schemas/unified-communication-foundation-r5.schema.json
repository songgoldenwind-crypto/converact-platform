{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.local/schemas/unified-communication-foundation-r5.schema.json",
  "title": "OPC Unified Communication Foundation Revision 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_id",
    "revision",
    "status",
    "inherited_r4",
    "artifacts",
    "claim_boundary",
    "architecture_profile",
    "authority_matrix",
    "runtime_fault_domains",
    "rvoip_adoption",
    "media_plane",
    "channel_agents",
    "speech_runtime",
