        },
        "future_vilte_backend": {
          "const": "vilte_livekit_av_gateway"
        },
        "agent_browser_video_path": {
          "const": "livekit_only"
        },
        "vilte_production_topology": {
          "const": "one_gateway_participant_peerconnection_combined_audio_video"
        },
        "vilte_split_topology": {
          "const": "research_only_not_production_eligible"
        },
        "livekit_gateway_client": {
          "const": "official_livekit_rust_realtime_sdk_exact_source"
        },
        "crypto_segments": {
          "$ref": "#/$defs/cryptoSegmentsContract"
        },
        "vilte_audio_codecs": {
          "$ref": "#/$defs/vilteAudioCodecsContract"
        },
        "h264_rtp_contract": {
          "$ref": "#/$defs/h264RtpContract"
        },
        "sip_av_state_machine": {
          "$ref": "#/$defs/sipAvStateMachineContract"
        },
        "room_to_carrier_selection": {
