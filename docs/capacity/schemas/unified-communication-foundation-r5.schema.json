  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueNonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "singleWriterAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "writer_count"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "writer_count": {
          "const": 1
        }
      }
    },
    "telephonyAgentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "adapter_mode",
        "preserve",
        "action_classes",
        "forbid"
      ],
      "properties": {
        "runtime": {
          "const": "active_call_capability_adapter"
        },
        "adapter_mode": {
          "const": "pure_pcm_and_canonical_event_no_sip_rtp_executor"
        },
        "preserve": {
          "const": [
            "telephony_playbook_pure_local_state",
            "canonical_dtmf_event_consumption",
            "refer_and_call_action_proposal_semantics",
            "interruption",
            "agc",
            "denoise"
          ]
        },
        "action_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pure_local_allowlist",
            "communication_actions",
            "business_and_http_actions",
            "direct_arbitrary_http_or_secret_url"
          ],
          "properties": {
            "pure_local_allowlist": {
              "const": "scene_goto_local_variable_prompt_condition"
            },
            "communication_actions": {
              "const": "typed_proposal_to_rustpbx"
            },
            "business_and_http_actions": {
              "const": "typed_proposal_to_opc_tool_broker"
            },
            "direct_arbitrary_http_or_secret_url": {
              "const": "forbidden_in_production"
            }
          }
        },
        "forbid": {
          "const": [
            "direct_carrier_pbx_authority",
            "main_rtp_authority",
            "active_call_sip_rtp_executor_in_production",
            "second_cdr_writer",
            "direct_business_or_communication_effect",
            "cross_channel_task_authority"
          ]
        }
      }
    },
    "livekitRoomAgentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "preserve",
        "forbid"
      ],
      "properties": {
        "runtime": {
          "const": "livekit_agents_adapter"
        },
        "preserve": {
          "const": [
            "room_participant_tracks",
            "agent_session",
            "multimodal_audio_video_text_vision",
            "tasks_workflows_tools_handoff",
            "job_dispatch_load_balance_drain"
          ]
        },
        "forbid": {
          "const": [
            "cross_channel_durable_task_authority",
            "telephone_ai_mandatory_hairpin",
            "direct_business_tool_effect"
          ]
        }
      }
    },
    "aiNativeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "owned_facts",
        "response_lease_required",
        "response_lease_protocol",
        "context_revision",
        "tool_call_semantics",
        "provider_or_model_is_business_authority"
      ],
      "properties": {
        "authority": {
          "const": "opc_ai_native_orchestrator"
        },
        "owned_facts": {
          "const": [
            "durable_agent_run",
            "task_dag",
            "memory_revision",
            "canonical_context_revision",
            "orchestrator_signed_response_plan",
            "tool_catalog_and_capability_digest",
            "policy_guardrail_approval",
            "action_ledger",
            "channel_and_human_handoff",
            "evaluation_and_cost"
          ]
        },
        "response_lease_required": {
          "const": true
        },
        "response_lease_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "key",
            "mutation",
            "durable_expiry_clock",
            "executor_expiry_clock",
            "output_gates",
            "communication_action_validation_points",
            "hot_path_check",
            "loss_behavior",
            "first_production_handoff"
          ],
          "properties": {
            "issuer": {
              "const": "opc_interaction_lease_store"
            },
            "key": {
              "const": "interaction_id"
            },
            "mutation": {
              "const": "durable_cas_with_monotonic_fence"
            },
            "durable_expiry_clock": {
              "const": "wall_clock"
            },
            "executor_expiry_clock": {
              "const": "local_monotonic_deadline_derived_from_receipt"
            },
            "output_gates": {
              "const": [
