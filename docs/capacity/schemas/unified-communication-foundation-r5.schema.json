            "livekit_video_to_audio",
            "sip_audio_to_livekit_audio",
            "livekit_audio_to_sip_audio",
            "sip_audio_to_livekit_video_context",
            "vilte_inbound_new_av",
            "vilte_outbound_new_av",
            "vilte_active_voice_to_video",
            "vilte_active_video_to_voice",
            "vilte_repeated_toggle",
            "vilte_video_failure_to_negotiated_audio",
            "av_to_rtpengine_audio"
          ]
        },
        "results_inheritable_across_paths": {
          "const": false
        },
        "video_failure_default": {
          "const": "explicit_audio_only_degrade_when_policy_allows"
        },
        "production_eligible": {
          "const": false
        }
      }
    },
    "capacity_demand": {
      "$ref": "#/$defs/capacityDemandContract"
    },
    "server_freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containers_mutable",
        "documentation_authorizes_deploy",
        "git_commit_authorizes_deploy",
        "code_test_authorizes_feature_flag",
        "old_server_results_authorize_r5",
        "future_change_requires_explicit_user_authorization"
      ],
      "properties": {
        "containers_mutable": {
          "const": false
        },
        "documentation_authorizes_deploy": {
          "const": false
        },
        "git_commit_authorizes_deploy": {
          "const": false
