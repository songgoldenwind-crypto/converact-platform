        },
        "logical_media_graph": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "media_plan_and_edge_fence": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "room_webrtc_sfu": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "bridge_orchestration": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "recording_intent": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "recording_manifest": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "billing_rating": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "channel_agent_turn": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "speech_session": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "ai_task_tool_memory_policy": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "tool_effect": {
          "$ref": "#/$defs/singleWriterAuthority"
        },
        "executor_roles": {
          "$ref": "#/$defs/nonEmptyObject"
        }
      }
    },
    "runtime_fault_domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "domains",
        "hot_path_invariants"
      ],
      "properties": {
        "policy": {
          "const": "one_authority_does_not_require_one_os_address_space"
        },
        "domains": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/faultDomain"
          },
          "allOf": [
            { "contains": { "properties": { "id": { "const": "sip_call_core" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "ordinary_media" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "decoded_media" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "native_unsafe" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "recording_capture" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "recording_upload" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "telephony_agent" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "room_agent" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "speech_runtime" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "av_gateway" } }, "required": ["id"] } },
            { "contains": { "properties": { "id": { "const": "video_transcode" } }, "required": ["id"] } }
