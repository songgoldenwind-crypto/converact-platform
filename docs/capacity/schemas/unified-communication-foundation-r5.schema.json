        "required_lifecycle": {
          "const": [
            "prepare",
            "commit",
            "try_write_audio",
            "commit_turn",
            "create_response",
            "submit_tool_result",
            "subscribe_events",
            "renew_response_lease",
            "revoke_response_lease",
            "cancel_response",
            "close",
            "query",
            "reconcile"
          ]
        },
        "mutating_commands_require_current_fence": {
          "const": true
        },
        "mutation_fence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_mutations_require",
            "output_affecting_mutations_also_require",
            "prepare_semantics",
            "stale_control_or_response_fence"
          ],
          "properties": {
            "all_mutations_require": {
              "const": "speech_control_fence"
            },
            "output_affecting_mutations_also_require": {
              "const": "response_fence"
