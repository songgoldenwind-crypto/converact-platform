      "properties": {
        "contract_owner": {
          "const": "opc"
        },
        "primary_target": {
          "const": "huggingface_speech_to_speech"
        },
        "native_baselines": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        },
        "replace_only_overlap": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        },
        "must_not_replace": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
