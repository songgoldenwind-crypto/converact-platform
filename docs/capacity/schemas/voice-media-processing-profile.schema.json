{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.local/schemas/voice-media-processing-profile.schema.json",
  "title": "iveKit voice media processing capacity profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "status",
    "description",
    "source_identity",
    "primary_sut",
    "generator",
    "workload",
    "phases",
    "thresholds",
    "quality",
    "finalizer",
    "external_dependencies",
    "claim"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "const": "vos-eq-v3-g711-opus-1k-v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["target", "verified", "retired"] },
    "description": { "type": "string", "minLength": 20 },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "component_id",
        "service_version",
        "rustrtc_commit",
        "audio_codec_version"
      ],
      "properties": {
        "contract_path": {
          "const": "docs/capacity/contracts/voice-media-goal4-v1.json"
        },
        "component_id": { "const": "voice-media-rs" },
        "service_version": { "const": "0.2.0" },
        "rustrtc_commit": {
          "const": "166c6d22984429eb6b509920c14fcd69f974f0b3"
        },
        "audio_codec_version": { "const": "0.3.40" }
      }
    },
    "primary_sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "component_id", "node_count", "hardware"],
      "properties": {
        "role": { "const": "processing" },
        "component_id": { "const": "voice-media-rs" },
        "node_count": { "const": 1 },
        "hardware": { "$ref": "#/$defs/hardware" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "separate_from_sut",
        "minimum_nodes",
        "maximum_cpu_utilization_ratio",
        "clock_offset_max_ms"
      ],
      "properties": {
        "component_id": { "const": "sipp-rtp-processing-fleet" },
        "separate_from_sut": { "const": true },
        "minimum_nodes": { "type": "integer", "minimum": 2 },
        "maximum_cpu_utilization_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.7
        },
        "clock_offset_max_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traffic_model",
        "media_path",
        "transport",
        "codec_pairs",
        "packetization_ms",
        "transcoding",
        "recording",
        "active_processing_sessions",
        "rtp_legs",
        "aggregate_pps",
        "steady_cps",
        "burst_cps",
        "mean_hold_seconds"
      ],
      "properties": {
        "traffic_model": { "const": "bidirectional_two_leg_processing" },
        "media_path": { "const": "processing_inserted" },
        "transport": { "enum": ["RTP_UDP", "SRTP_UDP"] },
        "codec_pairs": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PCMU_TO_PCMA",
              "PCMA_TO_PCMU",
              "PCMU_TO_OPUS",
              "OPUS_TO_PCMU",
              "PCMA_TO_OPUS",
              "OPUS_TO_PCMA"
            ]
          }
        },
        "packetization_ms": { "const": 20 },
        "transcoding": { "const": true },
        "recording": { "const": "none" },
        "active_processing_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "rtp_legs": { "type": "integer", "minimum": 2 },
        "aggregate_pps": { "type": "integer", "minimum": 2 },
        "steady_cps": { "type": "integer", "minimum": 1 },
        "burst_cps": { "type": "integer", "minimum": 1 },
        "mean_hold_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "duration_seconds", "load_ratio"],
        "properties": {
          "phase_id": {
            "enum": ["warmup", "staircase", "steady", "frontier", "endurance"]
          },
          "duration_seconds": { "type": "integer", "minimum": 1 },
          "load_ratio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1.25
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_success_ratio",
        "server_packet_loss_ratio",
        "processing_latency_p99_ms",
        "steady_cpu_utilization_ratio",
        "burst_cpu_utilization_ratio",
        "reconciliation_delta",
        "unexpected_process_restart_count",
        "unexpected_ordinary_relay_termination_count"
      ],
      "properties": {
        "setup_success_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "server_packet_loss_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processing_latency_p99_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steady_cpu_utilization_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "burst_cpu_utilization_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "reconciliation_delta": { "const": 0 },
        "unexpected_process_restart_count": { "const": 0 },
        "unexpected_ordinary_relay_termination_count": { "const": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_pesq",
        "minimum_mos_lqo",
        "maximum_consecutive_plc_frames",
        "weak_network_profiles"
      ],
      "properties": {
        "minimum_pesq": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "minimum_mos_lqo": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "maximum_consecutive_plc_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "weak_network_profiles": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reorder",
              "duplicate",
              "loss_1_percent",
              "loss_3_percent",
              "loss_5_percent",
              "burst_loss",
              "jitter_20ms",
              "jitter_40ms"
            ]
          }
        }
      }
    },
    "finalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "adapter_status",
        "minimum_repetitions",
        "invalidate_on_generator_failure",
        "preserve_all_attempts"
      ],
      "properties": {
        "entrypoint": {
          "const": "scripts/ivekit-voice-media-goal4-finalize.ts"
        },
        "adapter_status": { "const": "skeleton" },
        "minimum_repetitions": { "type": "integer", "minimum": 3 },
        "invalidate_on_generator_failure": { "const": true },
        "preserve_all_attempts": { "const": true }
      }
    },
    "external_dependencies": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "status",
          "required_for_verified_claim"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,127}$"
          },
          "status": { "const": "not_run" },
          "required_for_verified_claim": { "type": "boolean" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "capacity_claim",
        "verified_at",
        "evidence_manifest"
      ],
      "properties": {
        "status": { "const": "target" },
        "capacity_claim": { "const": "none" },
        "verified_at": { "const": null },
        "evidence_manifest": { "const": null }
      }
    }
  },
  "$defs": {
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "deployment_model",
        "cpu_architecture",
        "physical_cores",
        "logical_cpus",
        "memory_bytes",
        "nic_bps",
        "numa_nodes"
      ],
      "properties": {
        "qualification": { "const": "required_exact" },
        "deployment_model": { "const": "bare_metal" },
        "cpu_architecture": { "const": "x86_64" },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_cpus": { "type": "integer", "minimum": 1 },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1073741824
        },
        "nic_bps": { "type": "integer", "minimum": 1000000000 },
        "numa_nodes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
