{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivekit.local/schemas/capacity/source-capability-spike-v1.schema.json",
  "title": "iveKit Exact-Source Capability Spike v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spike_id",
    "status",
    "reviewed_at",
    "upstream",
    "dependency_inventory",
    "capabilities",
    "constraints",
    "open_gaps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "spike_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "status": {
      "const": "source_reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "release_ref",
        "commit",
        "archive_url",
        "archive_sha256",
        "archive_size_bytes",
        "license"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "release_ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive_url": {
          "type": "string",
          "format": "uri"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "build_system",
        "required_families",
        "optional_families"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "build_system": {
          "type": "string",
          "minLength": 1
        },
        "required_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "open_gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "status",
        "evidence"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "source_confirmed",
            "not_confirmed",
            "needs_runtime"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "assertion"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "effect",
        "evidence",
        "required_action"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "effect": {
          "enum": [
            "separate_profile_required",
            "fail_closed_required",
            "runtime_validation_required",
            "platform_constraint"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
