{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opc.local/schemas/unified-voice-foundation-r4-traceability.schema.json",
  "title": "Unified voice foundation Revision 4 row-level traceability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "revision",
    "status",
    "source_identity",
    "summary",
    "claim_boundary",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "unified-voice-foundation-r4-traceability-v1"
    },
    "revision": {
      "const": 4
    },
    "status": {
      "const": "target"
    },
    "source_identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "claim_boundary": {
      "const": {
        "capacity_claim": "none",
        "source_status_is_r4_evidence": false,
        "future_targets_are_evidence": false,
        "upstream_result_authorizes_ivekit": false,
        "borrowed_evidence_allowed": false,
        "production_eligible": false
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceabilityRow"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "archivedSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "archive_path",
        "source_sha256",
        "archive_sha256"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "archive_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract_id", "revision"],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "projectedContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contract_id",
        "revision",
        "digest_projection",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contract_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest_projection": {
          "const": "rfc8785_jcs_without_top_level_authority_binding"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rvoipContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contract_id",
        "revision",
        "digest_projection",
        "content_sha256",
        "capability_count",
        "replacement_gate_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contract_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest_projection": {
          "const": "rfc8785_jcs_without_top_level_authority_binding"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability_count": {
          "type": "integer",
          "minimum": 1
        },
        "replacement_gate_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "adr8Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "decision_id", "verification_status"],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_id": {
          "const": "voice-livekit-bridge-handoff-r1"
        },
        "verification_status": {
          "const": "not_run"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_head",
        "branch",
        "binding_objective",
        "historical_objective",
        "baseline_review",
        "blocking_review",
        "implementation_plan",
        "historical_goal_plan",
        "r4_contract",
        "r4_design",
        "adr7",
        "goal4_plan",
        "goal4_contract",
        "rvoip_contract",
        "adr8"
      ],
      "properties": {
        "repository_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "binding_objective": {
          "$ref": "#/$defs/archivedSourceBinding"
        },
        "historical_objective": {
          "$ref": "#/$defs/archivedSourceBinding"
        },
        "baseline_review": {
          "$ref": "#/$defs/archivedSourceBinding"
        },
        "blocking_review": {
          "$ref": "#/$defs/archivedSourceBinding"
        },
        "implementation_plan": {
          "$ref": "#/$defs/artifactBinding"
        },
        "historical_goal_plan": {
          "$ref": "#/$defs/artifactBinding"
        },
        "r4_contract": {
          "$ref": "#/$defs/contractBinding"
        },
        "r4_design": {
          "$ref": "#/$defs/artifactBinding"
        },
        "adr7": {
          "$ref": "#/$defs/artifactBinding"
        },
        "goal4_plan": {
          "$ref": "#/$defs/artifactBinding"
        },
        "goal4_contract": {
          "$ref": "#/$defs/projectedContractBinding"
        },
        "rvoip_contract": {
          "$ref": "#/$defs/rvoipContractBinding"
        },
        "adr8": {
          "$ref": "#/$defs/adr8Binding"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_goal_membership_count",
        "optional_track_membership_count",
        "goal_0_11_gate_count",
        "goal_3l_gate_count",
        "optional_track_gate_count",
        "review_c_count",
        "review_i_count",
        "supplemental_review_count",
        "baseline_review_count",
        "historical_objective_count",
        "rvoip_capability_count",
        "rvoip_replacement_gate_count",
        "voice_livekit_count",
        "kind_counts",
        "row_count"
      ],
      "properties": {
        "historical_goal_membership_count": {
          "type": "integer",
          "minimum": 1
        },
        "optional_track_membership_count": {
          "type": "integer",
          "minimum": 1
        },
        "goal_0_11_gate_count": {
          "type": "integer",
          "minimum": 1
        },
        "goal_3l_gate_count": {
          "const": 14
        },
        "optional_track_gate_count": {
          "type": "integer",
          "minimum": 1
        },
        "review_c_count": {
          "type": "integer",
          "minimum": 1
        },
        "review_i_count": {
          "type": "integer",
          "minimum": 1
        },
        "supplemental_review_count": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_review_count": {
          "const": 10
        },
        "historical_objective_count": {
          "const": 1
        },
        "rvoip_capability_count": {
          "type": "integer",
          "minimum": 1
        },
        "rvoip_replacement_gate_count": {
          "type": "integer",
          "minimum": 1
        },
        "voice_livekit_count": {
          "type": "integer",
          "minimum": 1
        },
        "kind_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "historical_goal_gate",
            "optional_track_gate",
            "review",
            "supplemental_review",
            "baseline_review",
            "historical_objective",
            "rvoip_capability",
            "rvoip_replacement_gate",
            "voice_livekit"
          ],
          "properties": {
            "historical_goal_gate": {
              "const": 102
            },
            "optional_track_gate": {
              "type": "integer",
              "minimum": 1
            },
            "review": {
              "type": "integer",
              "minimum": 1
            },
            "supplemental_review": {
              "type": "integer",
              "minimum": 1
            },
            "baseline_review": {
              "const": 10
            },
            "historical_objective": {
              "const": 1
            },
            "rvoip_capability": {
              "type": "integer",
              "minimum": 1
            },
            "rvoip_replacement_gate": {
              "type": "integer",
              "minimum": 1
            },
            "voice_livekit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "row_count": {
          "const": 362
        }
      }
    },
    "traceabilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "kind",
        "source_path",
        "source_pointer",
        "source_id",
        "source_membership",
        "requirement",
        "owner_phase",
        "contract_sections",
        "canonical_artifacts",
        "source_status",
        "disposition",
        "rationale",
        "prerequisites",
        "evidence_targets",
        "evidence_status",
        "r4_verification_status",
        "production_eligible"
      ],
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "historical_goal_gate",
            "optional_track_gate",
            "review",
            "supplemental_review",
            "baseline_review",
            "historical_objective",
            "rvoip_capability",
            "rvoip_replacement_gate",
            "voice_livekit"
          ]
        },
        "source_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_pointer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_membership": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner_phase": {
          "enum": ["D0", "U1", "U2", "U3", "U4", "U5", "U6", "U7", "U8", "U9"]
        },
        "contract_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "canonical_artifacts": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "source_status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "disposition": {
          "enum": [
            "inherited",
            "satisfied_with_evidence",
            "superseded_with_rationale",
            "deferred_with_prerequisite",
            "not_run"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prerequisites": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "evidence_targets": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "evidence_status": {
          "enum": ["not_run", "verified", "failed", "invalid"]
        },
        "r4_verification_status": {
          "enum": ["not_run", "verified", "failed", "invalid"]
        },
        "production_eligible": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "deferred_with_prerequisite"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "prerequisites": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "r4_verification_status": {
                "const": "verified"
              }
            },
            "required": ["r4_verification_status"]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "satisfied_with_evidence"
              },
              "evidence_status": {
                "const": "verified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "satisfied_with_evidence"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "r4_verification_status": {
                "const": "verified"
              },
              "evidence_status": {
                "const": "verified"
              },
              "evidence_targets": {
                "contains": {
                  "type": "string",
                  "pattern": "^(?!future:).+"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "verified"
              }
            },
            "required": ["evidence_status"]
          },
          "then": {
            "properties": {
              "evidence_targets": {
                "contains": {
                  "type": "string",
                  "pattern": "^(?!future:).+"
                }
              }
            }
          }
        }
      ]
    }
  }
}
